    <CheatEntry>
      <ID>2424</ID>
      <Description>"[ Activate First (Car Cheat Won't Activate Otherwise-Also Don't Use With Easy Kills Cheat)] {{Invulnerable/Indestructible Vehicle + Nitrous (ACTIVATE THE BOX TO THE LEFT &amp; EXPAND -+SIGN) THEN ENABLE THE BOX TO THE RIGHT OF I.V.H (Under Value) BELOW &amp; The One Under}}"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1"/>
      <LastState/>
      <Color>808000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(get_playerVehicle,JustCause4.exe,4D 89 A7 F8 00 00 00 49)
aobscanmodule(get_playerAddr,JustCause4.exe,48 8B 06 48 89 F1 0F B7) //UNUSED
alloc(newmem,$1000,"JustCause4.exe"+568E6F)
label(code)
label(code2)
label(return)
label(return2)
alloc(playerVehicle,8)
registersymbol(playerVehicle)
alloc(playerAddr,8)
registersymbol(playerAddr)

newmem:
push rax
mov rax,[r15+000000F8]
mov [playerVehicle],rax
pop rax

code:
mov [r15+000000F8],r12
jmp return

newmem2:
code2:
mov [playerAddr],rsi
mov rax,[rsi]
mov rcx,rsi
jmp return2

get_playerVehicle:
  jmp newmem
  nop 2
return:
registersymbol(get_playerVehicle)

get_playerAddr:
  jmp newmem2
  nop
return2:
registersymbol(get_playerAddr)

[DISABLE]
get_playerVehicle:
  db 4D 89 A7 F8 00 00 00

get_playerAddr:
  db 48 8B 06 48 89 F1

unregistersymbol(get_playerAddr)
unregistersymbol(get_playerVehicle)
dealloc(newmem)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>72</ID>
          <Description>"Infinite Vehicle Health Script {{(Activate Box To The Left) You Have To Combine 1 &amp; 2 Below In Order For The Vehicle Invincibility Cheat To Work}}"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(get_Health,JustCause4.exe,66 89 91 AC 03 00 00)
alloc(newmem,$1000,"JustCause4.exe"+6532D40)
label(code)
label(return)
label(isvalid)
label(isplayervehicle)
alloc(infVehicleHealth,1)
registersymbol(infVehicleHealth)

newmem:
{$try}
  push rax
  push rdi
  cmp rcx,[playerVehicle]
  je isplayervehicle
  mov rax,[rcx+A40]
  mov rdi,[rax+510]
  jmp isvalid
{$except}
  pop rdi
  pop rax
  jmp code

isplayervehicle:
  pop rdi
  pop rax
  cmp byte ptr [infVehicleHealth],00
  je code
  mov dx, word ptr [rcx+000003AA]
  jmp code

isvalid:
  cmp [rax+510],rcx
  pop rdi
  pop rax
  jne code
  mov dx, word ptr [rcx+000003AE]

code:
  mov [rcx+000003AC],dx
  jmp return

get_Health:
  jmp newmem
  nop 2
return:
registersymbol(get_Health)

[DISABLE]
get_Health:
  db 66 89 91 AC 03 00 00

unregistersymbol(get_Health)
dealloc(newmem)
</AssemblerScript>
