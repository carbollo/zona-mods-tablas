local nameIndex = showSelectionList("Select A Monster Name", "Select:", MonsterList, false)
if nameIndex == -1 then error("no selection") return end

local szName = MonsterList[nameIndex]

local p = allocateMemory(32)
executeCodeEx( 0, nil, FName_FName, p, {type=4,value=szName}, 1 )
local FMonsterID = readQword(p)

writeQword(Monster+0x270,FMonsterID)

writeQword(p,0)
executeCodeEx(0,nil,ProcessEvent,Monster,pClear,p)
showMessage("Done! re-load the savegame to see the effect")
deAlloc(p)


