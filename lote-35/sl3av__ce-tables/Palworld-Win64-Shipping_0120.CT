            <CheatEntry>
              <ID>88001</ID>
              <Description>"NoClip"</Description>
              <Options moHideChildren="1"/>
              <Color>FF8000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
globalalloc(NoClipThread,$1000,$process)

createthread(NoClipThread)

label(bStop)
registersymbol(bStop)
label(Start)
label(Ending)
label(KeyLoop)
label(LDisable)
label(fSpeed)
registersymbol(fSpeed)
NoClipThread:
//jmp NoClipThread
sub rsp,78
Start:
cmp [bStop],1
je Ending
mov rax,pLocalPlayer
mov rax,[rax]
mov rax,[rax+30]
test rax,rax
je Start
mov rsi,[rax+2D0] // Pawn
mov rdi,[rsi+320] // Movement
mov rbx,[rsi+198] // Root

//mov byte ptr[rdi+1A4],5

xor ecx,ecx
mov rdx,-1
mov r8,szGetActorForwardVector
mov r9d,1
call aobStaticFindObject
test rax,rax
je Start
mov [pForward],rax

xor ecx,ecx
mov rdx,-1
mov r8,szSetActorEnableCollision
mov r9d,1
call aobStaticFindObject
test rax,rax
je Start
mov [pActorCollision],rax

mov rcx,rsi
mov rdx,rax
lea r8,[rsp+20]
mov [rsp+20],0
call aobObjectProcessEvent

KeyLoop:
mov byte ptr[rdi+1A4],5
cmp [bStop],1
je LDisable
mov ecx,20
call GetAsyncKeyState
test eax,eax
je short @f
 // SPACE UP
 movsd xmm0,[rbx+270]
 movsd xmm1,[fSpeed]
 divsd xmm1,[fThousand]
 addsd xmm0,xmm1
 movsd [rbx+270],xmm0
@@:

mov ecx,10
call GetAsyncKeyState
test eax,eax
je short @f
 // SHIFT DOWN
 movsd xmm0,[rbx+270]
 movsd xmm1,[fSpeed]
 divsd xmm1,[fThousand]
 subsd xmm0,xmm1
 movsd [rbx+270],xmm0
@@:

mov ecx,57
call GetAsyncKeyState
test eax,eax
je short @f
 // W Forward
 mov rcx,rsi
 mov rdx,[pForward]
 lea r8,[rsp+20]
 call aobObjectProcessEvent
 movups xmm0,[rsp+20]
 movsd xmm2,[fSpeed]
 divsd xmm2,[fThousand]
 shufpd xmm2,xmm2,0
 mulpd xmm0,xmm2
 movups xmm1,[rbx+260]
 addpd xmm1,xmm0
 movups [rbx+260],xmm1
@@:
jmp KeyLoop


LDisable:
mov byte ptr[rdi+1A4],1

mov rcx,rsi
mov rdx,[pActorCollision]
lea r8,[rsp+20]
mov [rsp+20],1
call aobObjectProcessEvent

Ending:
add rsp,78
ret
bStop:
dd 0
pActorCollision:
dq 0
pForward:
dq 0
szGetActorForwardVector:
dw 'GetActorForwardVector'
dw 0
szSetActorEnableCollision:
dw 'SetActorEnableCollision'
dw 0
fSpeed:
dq (double)2 //0.002
fThousand:
dq (double)1000


 
[DISABLE]
bStop:
dd 1
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>88002</ID>
                  <Description>"Movement Speed:"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Double</VariableType>
                  <Address>fSpeed</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>88003</ID>
                  <Description>"[INFO] Space = Uo"</Description>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>88004</ID>
                  <Description>"[INFO] Shift = Down"</Description>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>88062</ID>
              <Description>"Save Player Position"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local LP = getAddress("[pLocalPlayer]")
local t = readPointer(LP+0x30)
t = readPointer(t+0x2D0)
local Root = readPointer(t+0x198)

PosX = readDouble(Root+0x260)
PosY = readDouble(Root+0x268)
PosZ = readDouble(Root+0x270)

 
 
[DISABLE]

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>88063</ID>
              <Description>"Load Player Position"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local LP = getAddress("[pLocalPlayer]")
local t = readPointer(LP+0x30)
t = readPointer(t+0x2D0)
local Root = readPointer(t+0x198)

if PosX == nil then print("Error: no position is saved") error("no saved pos") return end

writeDouble(Root+0x260,PosX)
writeDouble(Root+0x268,PosY)
writeDouble(Root+0x270,PosZ)

[DISABLE]

</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
