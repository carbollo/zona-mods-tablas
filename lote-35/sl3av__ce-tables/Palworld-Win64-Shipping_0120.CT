local ProcessEvent = getAddress("aobObjectProcessEvent")
local Find = getAddress("aobStaticFindObject")
local pClear = executeCodeEx(0,nil,Find,0,-1,{type = 4,value = "ClearEquipWaza"},1)

local Monster = getAddress("[pMonsterData]")
if Monster == 0 then print("error: no monster pointer data - did you hover over any?") error("nullptr") return end

local MonsterList = createStringList()
MonsterList.add("Gorilla")
