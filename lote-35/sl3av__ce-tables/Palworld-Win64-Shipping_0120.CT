code:
  cmp byte ptr[rcx+328],1 // player, alt: 0x1D8(IndividualActor) == (Player)Pawn
  je short IsPlayer
  cmp qword ptr[rcx+330],0 // player monster
  jne short IsPlayer
  @@:
  mov [rsp+10],rdx
  jmp return
