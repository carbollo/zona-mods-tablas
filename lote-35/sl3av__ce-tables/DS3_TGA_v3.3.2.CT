            <CheatEntry>
              <ID>1337080817</ID>
              <Description>"Cheats"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337183139</ID>
                  <Description>"Kill All Mobs"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Author: inuNorii
//Thanks to ametalon for current area entity pointer, advice and
//disablememrec update, as well as MajinCry for the ID list
[ENABLE]
alloc(KillAllMobs,$1000,DarkSoulsIII.exe)
createthread(KillAllMobs)

KillAllMobs:
mov rdx,[WorldChrMan]
mov rdx,[rdx+000001D0]
mov ebx,[rdx]
mov rdx,[rdx+08]
mov rsi,[SprjSessionManager]
lea r8,[KillList]
xor r9,r9
loopcode:
xor r10,r10
cmp dword ptr [rsi+0000016C],4
jnl short end
test ebx,ebx
je short end
dec ebx
imul eax,r9d,38
inc r9
mov rcx,[rax+rdx]
test rcx,rcx
je short end
mov rcx,[rcx+00001F90]
test rcx,rcx
je short end
mov rcx,[rcx+18]
test rcx,rcx
je short end
testcode:
mov rdi,[r8+r10*8]
test rdi,rdi
je short loopcode
inc r10
cmp [rcx+00000132],rdi
jne short testcode
mov dword ptr [rcx+000000D8],00000000
jmp short loopcode
end:
mov byte ptr [kill_all_mobs_finished],1
ret

KillList:
dw '1300' '1360' '1370' '1446' '1441' '2020' '2270' '2271' '1032' '1100' '2021'
dw '1105' '1280' '1282' '1240' '1200' '1230' '1260' '3090' '2110' '2280' '1440'
dw '1250' '1340' '2190' '1102' '3020' '5226' '5227' '5225' '1390' '1391' '1410'
dw '3220' '1170' '1070' '1180' '2130' '2030' '1350' '5240' '2100' '3070' '2132'
dw '1211' '1310' '3230' '2140' '1470' '1430' '2210' '1210' '3170' '1445' '5223'
dw '1281' '1190' '6000' '6090' '6050' '6060' '6100' '6080' '6040' '6130' '6081'
