                <CheatEntry>
                  <ID>1337080319</ID>
                  <Description>"Level Up Costs No Souls (PP2)"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Thanks to ametalon for finding the ID + relevant offsets
{$lua}
if syntaxcheck then return end
[ENABLE]
local LevelCost = CalcCorrectGraph:new("NoLevelUpCost",200)
LevelCost:init_inclination_soul(0)
LevelCost:adjustment_value(0)
LevelCost:boundry_inclination_soul(0)
LevelCost:boundry_value(0)

[DISABLE]
paramUtils:restore("NoLevelUpCost")
</AssemblerScript>
