                          <Description>"Rings"</Description>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
if not syntaxcheck then disableMemrec(memrec) end
local win = MIGForm:new()
Ring = Item:new()

function Ring:new(attributes)
  o = Item:new(attributes.id, attributes.typ, attributes.quantity, attributes.dlc, attributes.cutContent)
  setmetatable(o, self)
  self.__index = self
  return o
end

