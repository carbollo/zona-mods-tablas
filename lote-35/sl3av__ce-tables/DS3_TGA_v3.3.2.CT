"DarkSoulsIII.exe"+7A9BF6: E8 05 89 4B 00              -  call DarkSoulsIII.exe+C62500
"DarkSoulsIII.exe"+7A9BFB: 90                          -  nop
"DarkSoulsIII.exe"+7A9BFC: 48 89 75 C0                 -  mov [rbp-40],rsi
