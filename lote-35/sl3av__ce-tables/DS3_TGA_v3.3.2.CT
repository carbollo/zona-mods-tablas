end

local restrictIds = {
  1520, 1530, 3600, 3610, 3640, 3650, 12050, 16190,
  16323, 16325, 23100, 1420040, 1420050, 140000000
}
for i,id in ipairs(restrictIds) do
local restrict = SpEffectParam:new("PreventMaliciousEffects",id)
restrict:effectEndurance(1)
restrict:restrictFlags(4)
end

[DISABLE]
