                <CheatEntry>
                  <ID>1337019901</ID>
                  <Description>"Find address by ID in a param"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  Author: Igromanru
  Description: Searches for an address by ID in an param
}
[ENABLE]
{$lua}
if syntaxcheck then return end

local id =  --enter ID
local paramName = "" -- enter Param Name here
--------------------------------------------------------
local address = paramUtils:getIdAddressInParam(paramName, id)
if(address ~= nil and address &gt; 0) then
  print("Your address is "..address.." (0x"..paramUtils:toHex(address)..")")
else
  print("The address for ID "..id.." (0x"..paramUtils:toHex(id)..") couldn't be found in param "..paramName)
end

[DISABLE]
{$lua}
if syntaxcheck then return end
</AssemblerScript>
                </CheatEntry>
