    1337081742, 1337081743, 1337081744, 1337081745, 			-- spells
  }

  for _,id in ipairs(displayAsWeapon) do
    local memrec = getAddressList().getMemoryRecordByID(id)
    if memrec then
      memrec.OnGetDisplayValue = function(mr,value)
        local id = tonumber(value, mr.ShowAsHex and 16 or 10)
