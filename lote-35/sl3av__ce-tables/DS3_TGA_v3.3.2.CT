//code from here to '[DISABLE]' will be used to enable the cheat
define(canmove1,DarkSoulsIII.exe+9A35CB)
alloc(newmem, 128, canmove1)
label(return)

newmem:
or dword ptr [rbx+10],01
jmp return

canmove1+5:
jmp newmem
nop
nop
nop
return:

registersymbol(canmove1)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
