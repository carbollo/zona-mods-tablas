label(code)
label(return)
label(MesData)
registersymbol(MesData)

newmem:

code:
  lea rcx,[rbx+00000A60]
  mov [MesData],rcx
  movsxd  rcx,dword ptr [rbx+00000A60]
  jmp return
  MesData:

MessEditAOB:
  jmp code
  nop
  nop
return:
registersymbol(MessEditAOB)

