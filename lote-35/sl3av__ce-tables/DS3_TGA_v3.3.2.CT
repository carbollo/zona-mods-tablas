alloc(newmem,$1000,weapon)

label(code)
label(return)
label(weapon_ptr)

newmem:

code:
  mov rbx,weapon_ptr
  mov [rbx],rax
  movzx eax,word ptr [rax+000000BE]
  jmp return

weapon_ptr:
  dq 0

weapon:
  jmp code
  nop
  nop
return:
registersymbol(weapon)
registersymbol(weapon_ptr)

