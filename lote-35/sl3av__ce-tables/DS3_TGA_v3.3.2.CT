// ---------- INJECTING HERE ----------
"DarkSoulsIII.exe"+5837D0: 8B 41 0C                    -  mov eax,[rcx+0C]
"DarkSoulsIII.exe"+5837D3: 89 02                       -  mov [rdx],eax
// ---------- DONE INJECTING  ----------
"DarkSoulsIII.exe"+5837D5: 48 8B C2                    -  mov rax,rdx
"DarkSoulsIII.exe"+5837D8: C3                          -  ret
