                  <ID>1337098528</ID>
                  <Description>"SaveRequest"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Author: inuNorii
//Saves the game, but not from itself
[ENABLE]
