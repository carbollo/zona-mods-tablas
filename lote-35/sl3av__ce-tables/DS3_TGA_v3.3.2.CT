                  <Color>000080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(AllShopAOB,DarkSoulsIII.exe,8B 58 10 85 DB) // should be unique
alloc(newmem,32,AllShopAOB)

label(code)
label(return)

