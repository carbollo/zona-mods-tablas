repe movsd

pop rsi
push rsi
mov rdi, [test]
mov rdi, [rdi+7b8]
mov rdi, [rdi+c0]
add rdi, 38

mov rcx, 8
repe movsd

pop rsi
mov rdi, [test]
mov rdi, [rdi+7c0]
mov rdi, [rdi]
add rdi, 38

mov rcx, 8
repe movsd



code:
pop rcx
pop rdi
pop rsi
mov rcx,r8
repe movsb
jmp return

test:
dq 00

INJECT:
  jmp newmem
return:

[DISABLE]

INJECT:
  db 49 8B C8 F3 A4

unregistersymbol(test)
unregistersymbol(INJECT)
dealloc(newmem)
