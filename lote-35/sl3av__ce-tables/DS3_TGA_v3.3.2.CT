                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337190006</ID>
                              <Description>"Y"</Description>
                              <ShowAsSigned>0</ShowAsSigned>
                              <VariableType>Float</VariableType>
                              <Address>WorldChrManDbg</Address>
                              <Offsets>
                                <Offset>164</Offset>
                              </Offsets>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337190007</ID>
                              <Description>"Z"</Description>
                              <ShowAsSigned>0</ShowAsSigned>
                              <VariableType>Float</VariableType>
                              <Address>WorldChrManDbg</Address>
                              <Offsets>
                                <Offset>168</Offset>
                              </Offsets>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337190008</ID>
                              <Description>"Warp | ワープ実行"</Description>
                              <VariableType>Auto Assembler Script</VariableType>
                              <AssemblerScript>[ENABLE]
alloc(PositionedWarp,$100,DarkSoulsIII.exe)
createthread(PositionedWarp)

PositionedWarp:
mov rdx,[WorldChrManDbg]
mov rcx,[WorldChrMan]
mov rcx,[rcx+80]
mov rcx,[rcx+50]
mov byte ptr [rcx+0000018A],01
movaps xmm0,[rdx+160]
movdqa [rcx+00000190],xmm0
ret
{$lua}
if not syntaxcheck then disableMemrec(memrec) end
{$asm}
[DISABLE]
dealloc(PositionedWarp)
</AssemblerScript>
                            </CheatEntry>
                          </CheatEntries>
