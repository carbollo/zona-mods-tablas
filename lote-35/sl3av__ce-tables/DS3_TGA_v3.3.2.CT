Consumable = Item:new()
function Consumable:new(attributes)
  o = Item:new(attributes.id, attributes.typ, attributes.quantity, attributes.dlc, attributes.cutContent)
  o.unsafe = attributes.unsafe or false
  setmetatable(o, self)
  self.__index = self
  return o
end

