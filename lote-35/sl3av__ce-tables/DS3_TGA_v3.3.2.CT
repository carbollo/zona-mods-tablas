                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{cscript}
//Ported to C from script by: inuNorii
//Allow discarding any items
[ENABLE]
{$c}
#include &lt;tga/params.h&gt;
int on_enable() {
    ParamPatchBegin("discardable_items");
    ParamPatchAll(EquipParamWeapon, { param-&gt;IsDiscard = 1; });
    ParamPatchAll(EquipParamProtector, { param-&gt;IsDiscard = 1; });
    ParamPatchAll(EquipParamAccessory, { param-&gt;IsDiscard = 1; });
    ParamPatchAll(EquipParamGoods, { param-&gt;isDiscard = 1; });
    ParamPatchEnd();
    return 0;
}

int on_disable() {
    ParamRestore("discardable_items");
    return 0;
}

