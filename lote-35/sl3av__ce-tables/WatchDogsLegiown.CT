je code2
movss xmm3,[vXCord_Undo]
movss [r13+r15],xmm3
movss xmm3,[vYCord_Undo]
movss [r13+r15+08],xmm3
movss xmm3,[vZCord_Undo]
movss [r13+r15+04],xmm3
jmp code2

lSpeed:
