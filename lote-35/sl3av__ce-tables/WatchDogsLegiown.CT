pop rsi
cmp [vSaveCords],1
je vSave
cmp [vLoadCords],1
je vLoad
cmp [vLoadCords_Waypoint],1
je vWaypoint
cmp [vUndo_Teleport],1
je vUndo
cmp [Speed],1
je lSpeed
jmp code2

vSave:
mov [vSaveCords],0
movss xmm3,[r13+r15]
movss [vXCord],xmm3
movss xmm3,[r13+r15+08]
movss [vYCord],xmm3
movss xmm3,[r13+r15+04]
movss [vZCord],xmm3
