    <CheatEntry>
      <ID>26</ID>
      <Description>"Current Mission Perfect Stats"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(stats,Dishonored2.exe,48 8B 46 30 01 6C 90 04)
alloc(newmem,$1000,stats)

label(code)
label(return)
label(stats_ptr)

newmem:
  mov rax,[rsi+30]
  mov rcx,stats_ptr
  mov [rcx],rax
  cmp rdi,B // Kills
  je @f
  cmp rdi,C // Kills
  je @f
  cmp rdi,D // Kills on Knocked Out
  je @f
  cmp rdi,E // Civilian Kills
  je @f
  cmp rdi,F // Spotted by Enemies
  je @f
  cmp rdi,15 // Spotted by Enemies 2
  je @f
