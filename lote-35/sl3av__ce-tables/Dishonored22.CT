      <CheatEntries>
        <CheatEntry>
          <ID>362</ID>
          <Description>"Toggle Inventory Editor"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
UDF1.Show()
if INVENTORY_EDITOR then return end
INVENTORY_EDITOR = true
function CEComboBox1Change(sender)
  local item = UDF1.CEComboBox1.Text
  local inventory = readPointer("inventory_ptr")
  if inventory and inventory ~= 0 then
    local count = readInteger(inventory + 0x40)
    count = bAnd(count, 0xFFFFFF)
    local address = readPointer(inventory + 0x38)
    for i = 0, count do
      local name = readPointer(address)
      name = readPointer(name + 0x8)
      name = readString(name, 256, false)
      if item == name then
        address = address + 0x20
        UDF1.CEEdit1.Text = string.format("%X", address)
        UDF1.CEEdit2.Text = readInteger(address)
        UDF1.CEEdit3.Text = readInteger(address + 4)
        break
      end
      address = address + 0x38
    end
  end
end
function CEButton1Click(sender)
  local address = tonumber(UDF1.CEEdit1.Text, 16)
  local value = tonumber(UDF1.CEEdit2.Text)
  if value then
    writeInteger(address, value)
  end
end
function CEButton2Click(sender)
  local address = tonumber(UDF1.CEEdit1.Text, 16)
  UDF1.CEEdit2.Text = readInteger(address)
end
[DISABLE]
UDF1.Hide()
</AssemblerScript>
