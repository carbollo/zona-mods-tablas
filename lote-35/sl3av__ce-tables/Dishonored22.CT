      <CheatEntries>
        <CheatEntry>
          <ID>443</ID>
          <Description>"Unlock All Traits"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local all_traits = readPointer("traits_ptr")
if all_traits == 0 then
  showMessage("You must first open and close your journal in game.")
  return "assert(true)"
end
my_traits = readPointer("traits_ptr+8")
local size = readInteger("traits_ptr+10") - 1
autoAssemble([[
alloc(traits_list,2048)
registersymbol(traits_list)
]])

local traits_tbl = {}
for i = 0, size do
  local trait = all_traits + i * 0x40
  local category = readInteger(trait + 4)
  if category ~= 4294967295 then
    local category_tbl = traits_tbl[category]
    if category_tbl == nil then
      category_tbl = {}
      traits_tbl[category] = category_tbl
    end
    local value = readInteger(trait)
    table.insert(category_tbl, value)
  end
end
local sorted = {}
for i in pairs(traits_tbl) do
  table.insert(sorted, i)
end

local traits_list = getAddress("traits_list")
local count = 0
for i, v in ipairs(sorted) do
  for j, k in ipairs(traits_tbl[v]) do
    local address = traits_list + count * 8
    writeInteger(address, k)
    count = count + 1
  end
end
traits_backup = readQword(my_traits)
traits_count = readBytes(my_traits + 8, 1, false)
writeQword(my_traits, traits_list)
writeBytes(my_traits + 8, count)
[DISABLE]
if my_traits ~= 0 and my_traits ~= nil then
  writeQword(my_traits + 8, traits_count)
  writeQword(my_traits, traits_backup)
end
</AssemblerScript>
        </CheatEntry>
