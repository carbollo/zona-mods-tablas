  cmp r9d,0
  jne return
  push rcx
  mov rcx,traits_ptr
  mov [rcx],rdx
  mov [rcx+8],rdi
  mov [rcx+10],r8d
  pop rcx
  jmp return

traits_ptr:
  dq 0
  dq 0
  dq 0

traits:
