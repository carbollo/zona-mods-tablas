[ENABLE]

aobscanmodule(AttachCaseCurrentItemSelectedPointerAOB,re4.exe,8B 4E 34 48 85 C0) // should be unique
alloc(newmem,$1000,AttachCaseCurrentItemSelectedPointerAOB)
alloc(AttachCaseCurrentItemSelectedPointer,8)
