    <CheatEntry>
      <ID>14</ID>
      <Description>"Remove protection"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : re4.exe
  Version: ‎Sunday, ‎March ‎19, ‎2023 11:28:19 PM
  Date   : 2023-03-24
  Author : praydog

  This script says the N word.
}

[ENABLE]

aobscanmodule(RE8Func,re4.exe, 40 53 56 57 48 83 EC 20 48 8B 15 * * * * 48 ) // should be unique
aobscanmodule(conditional_jmp_block,re4.exe, 48 8B 8D D0 03 00 00 48 29 C1 75 ) // should be unique\

RE8Func:
db C3

conditional_jmp_block+A:
db EB

registersymbol(RE8Func)
registersymbol(conditional_jmp_block)

[DISABLE]
unregistersymbol(RE8Func)
unregistersymbol(conditional_jmp_block)

RE8Func:
db 40

conditional_jmp_block+A:
db 75
</AssemblerScript>
