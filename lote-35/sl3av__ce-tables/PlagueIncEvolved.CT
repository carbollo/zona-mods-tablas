    <CheatEntry>
      <ID>3</ID>
      <Description>"Script: EvoPoints (DiseaseData)"</Description>
      <LastState Activated="1"/>
      <Color>FF0000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : PlagueIncEvolved.exe
  Version: 
  Date   : 2018-04-11
  Author : Jason

  Injection is at SPDisease:get_evoPoints+13.  SPDiseaseData
  structure:

  000C: _evoPoints

  Use mono features, lot of good stuff here, about 300 properties with
  multipliers for infectiousness, vampire stuff, castles, zombies, etc.

}

[ENABLE]

globalalloc(globals,$100000)

aobscan(INJECT_EVOPOINTS,8B 40 0C C9 C3 55) // should be unique
alloc(newmem,$1000)

label(code)
label(skip_DisableCure)
label(skip_EvoPoints)
label(skip_HyperInfective)
label(return)

newmem:
  mov [globals+0004],eax

  cmp [globals+1000],1
  jne skip_DisableCure
  mov [eax+44],0 // globalCureResearch
  mov [eax+48],0 // globalCureResearchThisTurn
  mov [eax+4c],0 // cureCompletePercent
  mov [eax+f4],0 // _diseaseNoticed
  skip_DisableCure:

  cmp [globals+1004],1
  jne skip_EvoPoints
  cmp [eax+0c],500
  jge skip_EvoPoints
  mov [eax+0c],500
  skip_EvoPoints:

  cmp [globals+1008],1
  jne skip_HyperInfective
//  mov [eax+50],(float)10000 // globalAirRate - doesn't seem to do much
//  mov [eax+54],(float)10000 // globalSeaRate - doesn't seem to do much
//  mov [eax+58],(float)10000 // globalLandRate - doesn't seem to do much
  mov [eax+00f8],(float)10000 // wealthy
  mov [eax+00fc],(float)10000 // poverty
  mov [eax+0100],(float)10000 // urban
  mov [eax+0104],(float)10000 // rural
  mov [eax+0108],(float)10000 // hot
  mov [eax+010c],(float)10000 // cold
  mov [eax+0110],(float)10000 // humid
  mov [eax+0114],(float)10000 // arid
  mov [eax+0118],(float)10000 // landTransmission
  mov [eax+011c],(float)10000 // seaTransmission
  mov [eax+0120],(float)10000 // airTransmission
  mov [eax+0124],(float)10000 // corpseTransmission
  skip_HyperInfective:

code:
  mov eax,[eax+0C]
  leave 
  ret 
  jmp return

INJECT_EVOPOINTS:
  jmp newmem
return:
registersymbol(INJECT_EVOPOINTS)

[DISABLE]

INJECT_EVOPOINTS:
  db 8B 40 0C C9 C3

unregistersymbol(INJECT_EVOPOINTS)
