<CheatTable CheatEngineTableVersion="26">
  <CheatEntries>
    <CheatEntry>
      <ID>47</ID>
      <Description>"Script: Select Country"</Description>
      <LastState Activated="1"/>
      <Color>FF0000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : PlagueIncEvolved.exe
  Version: 
  Date   : 2018-04-12
  Author : Jason

  Called when you select a country.  This accesses the pointer in SPLocalDisease
  that points to SPLocalDiseaseData.  The actual offset is A4 and this accesse
  EDI+54 so EDI must point to +50 into the structure.  This seems to be one
  instance of SPLocalDisease with the pointer to SPLocalDiseaseData for whichever
  country is selected.

  globals+0200: pLocalDiseaseData
  globals+0204: pCHUDNecroaSubScreen
  globals+1100: flag 1 for cheat to infect country

  CHUDNecroaSubScreen is subclass of CHUDContextSubScreen

  1c: humanBar (HudBarObject)
  20: currentHumanBar (HudBarObject)
  24: humanText (HudTextObject)
  28: currentHumanText (HutTextObject)
  2c: contextTitleText (UILabel)
  58: _state (CHUDContextSubscreen.ContextState)
  44: abilitySubScreen (CHUDAbilitySubScreen)
  50: mpDisease (Disease)
  54: mpLocalDisease (LocalDisease) - selected country's disease data
      A4: mpLocalDiseaseData

}

[ENABLE]

globalalloc(globals,$100000)

aobscan(INJECT_SELECT_COUNTRY,89 85 58 ff ff ff 8B 47 54 83 EC 0C 50 39 00 E8) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  mov [globals+0204],edi // store pointer to CHUDNecroaSubScreen?  Base Class CHUDContextSubScreen
code:

  mov eax,[edi+54] // original code
  mov [globals+0200],eax // store pointer to SPLocalDisease

  push ebx
  mov ebx,[eax+a4] // mpDiseaseData
  test ebx,ebx
  jz skip

  cmp [globals+1100],1
  jne skip
  cmp [ebx+fc],0 // uninfectedPopulation high 32 bits
  ja doIt
  cmp [ebx+f8],0 // uninfectedPopulation low 32 bits
  ja doIt
  doIt:
  cmp [ebx+84],0 // infectedPopulationOverride
  ja skip
  mov [ebx+84],(float)100.0 // will cause the game to add this infected
  skip:

  pop ebx

  sub esp,0C       // original code
  jmp return

INJECT_SELECT_COUNTRY+6:
  jmp newmem
  nop
return:
registersymbol(INJECT_SELECT_COUNTRY)

[DISABLE]

INJECT_SELECT_COUNTRY+6:
  db 8B 47 54 83 EC 0C

unregistersymbol(INJECT_SELECT_COUNTRY)
dealloc(newmem)

