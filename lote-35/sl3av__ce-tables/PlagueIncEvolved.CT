    <CheatEntry>
      <ID>40</ID>
      <Description>"OLD Script: SelectedCountry"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : PlagueIncEvolved.exe
  Version: 
  Date   : 2018-04-12
  Author : Jason

  Called to access the _controlledInfected field of SPLocalDiseaseData.  This
  makes EDI actually point to offset 4 into the structure definition as
  reported by MonoDataCollector.  Offsets listed here are then 4 more than
  what EDI would be, so subtract 4 from EDI first...

  0010 - (int64) killedPopulation (Dead shown at bottom of screen)
  0018 - (int64) _controlledInfected (Infected shown at bottom of screen)
  0028 - (int64) uncontrolledInfected (?)
  0058 - (float) localCureResearch
  005C - (float) cureResearchAllocation
  0060 - (float) localPriorityCounter
  0064 - (float) localInfectiousness (101.43 for good non-cheat virus)
  0084 - (float) infectedPopulationOverride (can add here and game will increase infected)
  00F0 - (int64) originalPopulation
  00F8 - (int64) uninfectedPopulation

  USES:

    globals+0100 - pointer to selected country
    globals+1100 - flag for ensure selected country is infected
}

[ENABLE]

globalalloc(globals,$100000)

aobscanmodule(INJECT_SELECTED_COUNTRY,PlagueExternal.dll,8B 7D 0C 83 C4 18 8B 4F 20 03 4F 10 8B 57 24 13 57 14 83 FE 01 7d 07 BE * * 00 00 EB 73) // should be unique
alloc(newmem,$1000)

label(code)
label(skip_infectCountry)
label(do_infectCountry)
label(return)

newmem:
  mov edi,[ebp+0C]
  sub edi,4
  mov [globals+100],edi // store pointer to selected country

  cmp [globals+1100],1
  jne skip_infectCountry
  cmp [edi+FC],0 // uninfectedPopulation (high 32 bits)
  jne do_infectCountry
  cmp [edi+F8],0 // uninfectedPopulation
  je skip_infectCountry
  do_infectCountry:
  mov [edi+84],1 // infectedPopulationOverride
  skip_infectCountry:

code:
  mov edi,[ebp+0C]  // original code
  add esp,18        // original code
  jmp return

INJECT_SELECTED_COUNTRY:
  jmp newmem
  nop
return:
registersymbol(INJECT_SELECTED_COUNTRY)

[DISABLE]

INJECT_SELECTED_COUNTRY:
  db 8B 7D 0C 83 C4 18

unregistersymbol(INJECT_SELECTED_COUNTRY)
dealloc(newmem)

