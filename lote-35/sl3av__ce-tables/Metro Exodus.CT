[ENABLE]
aobscanmodule(InfAmmo,MetroExodus.exe,66 89 51 70 41 8B E8)
alloc(newmem,$1000,"MetroExodus.exe")
label(code)
label(return)
registersymbol(InfAmmo)

newmem:
  push rsi
  mov rsi,[rcx+58]
  cmp [rsi+1C],0101007A //Bolts
  je @f
  cmp [rsi+1C],0101007B //Explosive Bolts
  je @f
  cmp [rsi+1C],01010082 //Buckshot
  je @f
  cmp [rsi+1C],01010080 //Handgun Ammo
  je @f
  cmp [rsi+1C],0101007E //Sniper Rifle Ammo
  je @f
  cmp [rsi+1C],0101007C //Assault Rifle Ammo
  je @f
  cmp [rsi+1C],0101007F //Assault Rifle Incendiary Ammo
  je @f
  cmp [rsi+1C],01010084 //Steel Balls
  je @f
  cmp [rsi+1C],01010085 //Incendiary Capsules
  je @f
  cmp [rsi+1C],01010086 //Flamethrower Fuel
  je @f
  jmp code

@@:
  mov dx,#999
  jmp code

code:
  pop rsi
  mov [rcx+70],dx
  mov ebp,r8d
  jmp return

InfAmmo:
  jmp newmem
  nop 2
return:

