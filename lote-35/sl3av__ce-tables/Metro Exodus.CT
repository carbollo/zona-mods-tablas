registersymbol(YPos)
registersymbol(ZPos)
registersymbol(XUPos)
registersymbol(YUPos)
registersymbol(ZUPos)
registersymbol(SavePos)
registersymbol(LoadPos)
registersymbol(UndoPos)
registersymbol(LockUndoPos)
registersymbol(TeleportMode)

newmem1:
  cmp rax,[TMP]
  jne code1
  cmp [SavePos],1
  je SavePosition
  cmp [LoadPos],1
  je LoadPosition
  cmp [UndoPos],1
  je UndoPosition
  jmp code1

SavePosition:
  mov [SavePos],0
  fld [rax+10]
  fstp [XPos]
  fld [rax+18]
  fstp [YPos]
  fld [rax+14]
  fstp [ZPos]
  jmp code1

LoadPosition:
  mov [LoadPos],0
  cmp [LockUndoPos],0
  jne @f
  fld [rax+10]
  fstp [XUPos]
  fld [rax+18]
  fstp [YUPos]
  fld [rax+14]
  fstp [ZUPos]

@@:
  fld [XPos]
  fstp [rax+10]
