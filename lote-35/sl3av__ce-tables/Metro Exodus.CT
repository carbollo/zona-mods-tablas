[ENABLE]
aobscanmodule(PlayerPointer,MetroExodus.exe,F3 0F 10 87 88 03 00 00 45)
alloc(newmem,$1000,"MetroExodus.exe")
label(PP)
label(code)
label(return)
registersymbol(PP)
registersymbol(PlayerPointer)

newmem:
  mov [PP],rcx

code:
  movss xmm0,[rdi+00000388]
  jmp return

PP:
  dd 00

PlayerPointer:
  jmp newmem
  nop 3
return:

aobscanmodule(InfHealth,MetroExodus.exe,F3 0F 5C 52 14 F3)
alloc(newmem1,$1000,"MetroExodus.exe")
label(DMP)
label(code1)
label(return1)
registersymbol(DMP)
registersymbol(InfHealth)

newmem1:
  cmp rcx,[PP]
  je @f
  cmp [DMP],01
  jne code1
  fld [rdx+14]
  fmul [DMPValue]
  fstp [rdx+14]
  jmp code1

@@:
  movss xmm2,[Health]
  jmp code1+05

code1:
  subss xmm2,[rdx+14]
  jmp return1

DMP:
  dd 00

DMPValue:
  dd (float)9.0 //Damage Multiplier

Health:
  dd (float)1.0

InfHealth:
  jmp newmem1
return1:

aobscanmodule(DeathBypass,MetroExodus.exe,3C 01 0F 86 BB 00 00 00)
alloc(newmem2,$1000,"MetroExodus.exe")
label(code2)
label(return2)
registersymbol(DeathBypass)

newmem2:
  cmp rbx,[PP]
  je DeathBypass+C3

code2:
  cmp al,01
  jbe DeathBypass+C3
  jmp return2

DeathBypass:
  jmp newmem2
  nop 3
return2:

[DISABLE]
PlayerPointer:
  db F3 0F 10 87 88 03 00 00
unregistersymbol(PlayerPointer)
unregistersymbol(PP)
dealloc(newmem)

InfHealth:
  db F3 0F 5C 52 14
unregistersymbol(InfHealth)
unregistersymbol(DMP)
dealloc(newmem1)

DeathBypass:
  db 3C 01 0F 86 BB 00 00 00
unregistersymbol(DeathBypass)
dealloc(newmem2)

