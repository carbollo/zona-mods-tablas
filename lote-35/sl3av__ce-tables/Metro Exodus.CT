===============
Metro Exodus
===============
}
[ENABLE]
aobscanmodule(ChangeDifficulty,MetroExodus.exe,45 0F B6 B5 D6 01 00 00)
alloc(newmem,$1000,"MetroExodus.exe")
label(CHD)
label(code)
label(return)
registersymbol(CHD)
registersymbol(ChangeDifficulty)

newmem:
  mov [CHD],r13
  cmp [CHD+08],0
  jne @f
  push rax
  mov rax,[r13+1D7]
  mov [CHD+08],rax
  pop rax

@@:
  mov [r13+1D7],00 //00 - Easy, 01 - Normal, 03 - Hardcore Ranger

code:
  movzx r14d,byte ptr [r13+000001D6]
  jmp return

CHD:
  dd 00

ChangeDifficulty:
  jmp newmem
  nop 3
return:

[DISABLE]
ChangeDifficulty:
  db 45 0F B6 B5 D6 01 00 00
unregistersymbol(ChangeDifficulty)
unregistersymbol(CHD)
dealloc(newmem)
luaCall(writeInteger('[CHD]+1D7', readInteger('CHD+08')))

