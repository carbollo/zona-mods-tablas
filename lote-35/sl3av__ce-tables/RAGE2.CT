jge short lblInvItemCalcSkip
mov rsi,[g_Player]
lea rsi,[rsi+00000CD8]
cmp qword ptr [rsi],rcx
jne short lblInvItemCalcSkip
cmp dword ptr [bEnableInfiniteItems],1
jne short lblInvItemCalcSkip
xor r8,r8
lblInvItemCalcSkip:
//Alt: mov esi,r8d
//Alt: mov r13,rcx
//db 41 8B F0 4C 8B E9
