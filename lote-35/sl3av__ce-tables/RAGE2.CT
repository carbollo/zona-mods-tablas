aobscanmodule( ClipDecrease, RAGE2.exe, 8993??????004885FF74??488BCBE8 )
registersymbol( ClipDecrease )
label( ClipDecrease_o )
registersymbol( ClipDecrease_o )
alloc( Hook, 0x1000, RAGE2.exe )

Hook:
push rdx
mov rdx,[g_Player]
cmp [rbx+578],rdx            // is our player firing?
pop rdx
jne short @f
  //mov edx,[rbx+404]        // get ClipMax
  add edx,ebp                // give back subtracted unit
  push rax
  mov rax,[g_Player]
  or byte ptr [rax+2DC9],2
  pop rax
ClipDecrease_o:
readmem( ClipDecrease, 6 )   // original code will write 'edx'
jmp ClipDecrease+6

ClipDecrease:
jmp Hook
db 90

[DISABLE]

ClipDecrease:
readmem( ClipDecrease_o, 6 )

dealloc( Hook )
unregistersymbol( ClipDecrease_o )
unregistersymbol( ClipDecrease )
</AssemblerScript>
