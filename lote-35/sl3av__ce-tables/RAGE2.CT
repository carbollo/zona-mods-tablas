aobscanmodule( OverdriveMultiplierTimer, RAGE2.exe, F30F104F??F30F5C4F??F30F5D15????????F30F59CAF30F584F??F30F114F??EB )
registersymbol( OverdriveMultiplierTimer )
label( OverdriveMultiplierTimer_o )
registersymbol( OverdriveMultiplierTimer_o )
alloc( Hook, 0x1000, RAGE2.exe )

label( pOverdriveMultiplier )
registersymbol( pOverdriveMultiplier )

Hook:
cmp rsi,[g_Player]
jne short @f
  mov [pOverdriveMultiplier],rdi
  mov [rdi+44],(float)100.0 // change this to whichever amount you want
  mov ebx,A
  mov [rdi+58],ebx          // max level
  movd xmm2,ebx             // update it in MMX as well
  cvtdq2ps xmm2,xmm2
  divss xmm2,xmm0
OverdriveMultiplierTimer_o:
readmem( OverdriveMultiplierTimer, 5 )
jmp OverdriveMultiplierTimer+5

align 10 CC

pOverdriveMultiplier:
dq 0

OverdriveMultiplierTimer:
jmp Hook

[DISABLE]

[pOverdriveMultiplier]+44:
dd (float)2.0

OverdriveMultiplierTimer:
readmem( OverdriveMultiplierTimer_o, 5 )

unregistersymbol( pOverdriveMultiplier )
dealloc( Hook )
unregistersymbol( OverdriveMultiplierTimer_o )
unregistersymbol( OverdriveMultiplierTimer )
</AssemblerScript>
