            <CheatEntry>
              <ID>49</ID>
              <Description>"Read Resources"</Description>
              <Options moHideChildren="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">[ENABLE]

/*
aobscanmodule( ReadResources, RAGE2.exe, C74424??02000000C74424??E3157D61 )
registersymbol( ReadResources )
label( ReadResources_o )
registersymbol( ReadResources_o )
*/
//aobscanmodule( GetBase, RAGE2.exe, 4883EC28488B05????????4885C074??488B40??4885C074??48 )
//registersymbol( GetBase )
alloc( Hook, 0x1000, RAGE2.exe )
CreateThread( Hook )

label( pMoney )
registersymbol( pMoney )
label( pFeltrite )
registersymbol( pFeltrite )
label( pProjectPoints )
registersymbol( pProjectPoints )
label( pMutantBashTokens )
registersymbol( pMutantBashTokens )

label( FindPtr )
registersymbol( FindPtr )

Hook:
//call GetBase
//test rax,rax
//je short @f
//  mov rcx,[rax+50]   // GetPlayer
mov rcx,[g_Player]
lea rsi,[rcx+A38]
mov r8,[rsi+0x208]
mov rdx,617D15E3   // "CurrencyBase"
mov rcx,rsi
call short FindPtr
mov [pMoney],rax
mov r8,[rsi+0x1F8]
mov rdx,86A6BE6A   // "IngredientFeltriteBlue"
mov rcx,rsi
call short FindPtr
mov [pFeltrite],rax
mov r8,[rsi+0x208]
mov rdx,E9C1DB3D   // "CurrencyMetagameRewardPoint"
mov rcx,rsi
call short FindPtr
mov [pProjectPoints],rax
mov r8,[rsi+0x208] // "CurrencyMutantBashTokens"
mov rdx,6077B815
mov rcx,rsi
call short FindPtr
mov [pMutantBashTokens],rax
@@:
ret
/*
ReadResources_o:
readmem( ReadResources, 8 )
jmp ReadResources+8
*/

align 10 CC

FindPtr:
	mov rax,r8
	mov rcx,[r8+0x8]
	cmp byte ptr [rcx+0x19],0x0
	jne short @L00000004

@L00000001:
	cmp dword ptr [rcx+0x1C],edx
	jae short @L00000002
	mov rcx,[rcx+0x10]
	jmp short @L00000003

@L00000002:
	mov rax,rcx
	mov rcx,[rcx]

@L00000003:
	cmp byte ptr [rcx+0x19],0x0
	je short @L00000001
	cmp rax,r8
	je short @L00000004
	cmp edx,dword ptr [rax+0x1C]
	jae short @L00000005

@L00000004:
	mov rax,r8

@L00000005:
	cmp rax,r8
	je short @L00000006
	//mov eax,dword ptr [rax+0x20]
	ret

@L00000006:
	xor eax,eax
	ret

align 10 CC

pMoney:
dq 0
pFeltrite:
dq 0
pProjectPoints:
dq 0
pMutantBashTokens:
dq 0

/*
ReadResources:
jmp Hook
db 90 90 90
*/

[DISABLE]

/*
ReadResources:
readmem( ReadResources_o, 8 )
*/

unregistersymbol( FindPtr )

unregistersymbol( pMutantBashTokens )
unregistersymbol( pProjectPoints )
unregistersymbol( pFeltrite )
unregistersymbol( pMoney )
dealloc( Hook )

//unregistersymbol( GetBase )

/*
unregistersymbol( ReadResources_o )
unregistersymbol( ReadResources )
*/
</AssemblerScript>
