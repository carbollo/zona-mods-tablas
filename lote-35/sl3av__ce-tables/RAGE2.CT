readmem(aobInvItemCalc_i,6)

unregistersymbol(aobInvItemCalc_r)
unregistersymbol(aobInvItemCalc_i)

unregistersymbol(bEnableInfiniteItems)

dealloc(newmemInvItemCalc)

{
