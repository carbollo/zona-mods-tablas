<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>24238</ID>
      <Description>"INIT"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>0080FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local PROCESS_NAME = 'METAL GEAR SOLID3.exe'

strings_add(getAutoAttachList(), PROCESS_NAME)

function cls()
    GetLuaEngine().mOutput.Clear()
end

function hex(h)
  if h then
    return string.format('%X',h)
  end
  return '0'
end

function printhex(h,l)
  local s = hex(h)
  if string.len(s) &gt; 8 then l = l or 16 else l = l or 8 end
  for i=1,l do s = '0'..s end
  print( string.sub( s, -l ) )
end
registerLuaFunctionHighlight('cls')
registerLuaFunctionHighlight('hex')
registerLuaFunctionHighlight('printhex')
registerLuaFunctionHighlight('LaunchMonoDataCollector')
registerLuaFunctionHighlight('mono_symbolLookupCallback')
registerLuaFunctionHighlight('mono_findClass')
registerLuaFunctionHighlight('mono_class_getStaticFieldAddress')

function EnableMono(enable)
  if enable and not monopipe then
    LaunchMonoDataCollector()
  end
  if not enable and monopipe then
    local show = getLuaEngine().cbShowOnPrint.Checked
    getLuaEngine().cbShowOnPrint.Checked = false
    monopipe.OnTimeout()
    getLuaEngine().cbShowOnPrint.Checked = show
  end
end
registerLuaFunctionHighlight('EnableMono')

function Jit(symbol)
  return mono_symbolLookupCallback(symbol)
end
registerLuaFunctionHighlight('Jit')

function bNand(a,b)
  return bAnd(a,bNot(b))
end
registerLuaFunctionHighlight('bNand')

function bincmp(a,b)
  if bAnd(a,b)&gt;0 then return '1' else return '0' end
end
registerLuaFunctionHighlight('bincmp')

function printbin( by )
  if by == nil then return print('00000000') end
  local s = ''
  s = bincmp(by,0x01)..s
  s = bincmp(by,0x02)..s
  s = bincmp(by,0x04)..s
  s = bincmp(by,0x08)..s
  s = bincmp(by,0x10)..s
  s = bincmp(by,0x20)..s
  s = bincmp(by,0x40)..s
  s = bincmp(by,0x80)..s
  if by &gt; 0xFF then
    s = bincmp(by,0x0100)..' '..s
    s = bincmp(by,0x0200)..s
    s = bincmp(by,0x0400)..s
    s = bincmp(by,0x0800)..s
    s = bincmp(by,0x1000)..s
    s = bincmp(by,0x2000)..s
    s = bincmp(by,0x4000)..s
    s = bincmp(by,0x8000)..s
  end
  print( s )
end
registerLuaFunctionHighlight('printbin')

function getbyte(v,d)
  if not v then return 0 end
  return (v&gt;&gt;(8*d))&amp;0xFF
end

function aobScanEx( aob )
  -- thanks panraven for this function!
  -- https://forum.cheatengine.org/viewtopic.php?t=577536
  -- simplified for my needs
  local p, a, n, s, e = nil or '*X*W', nil or fsmNotAligned, nil or '0', getAddress( process ) or 0x0, ( getAddress( process ) + getModuleSize( process ) ) or 0xffffffffffffffff
  local ms = pb and createMemScan( pb ) or createMemScan()
  local fl = createFoundList( ms )
  ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
  ms.waitTillDone()
  fl.initialize()
  local result = nil
  if fl ~= nil and fl.getCount() &gt; 0 then
    result = createStringlist()
    for i = 1, fl.getCount() do result.add( fl.getAddress( i - 1 ) ) end
  end
  fl.destroy()
  ms.destroy()
  if result and result.Count &gt; 0 then return tonumber( result[0], 16 ) end
  return nil
end
registerLuaFunctionHighlight('aobScanEx')

function aobScan( index, aob )
  local p, a, n, s, e = nil or '*X*W', nil or fsmNotAligned, nil or '0', 0x0, 0xffffffffffffffff
  local ms = pb and createMemScan( pb ) or createMemScan()
  local fl = createFoundList( ms )
  ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
  ms.waitTillDone()
  fl.initialize()
  local result = nil
  if fl ~= nil and fl.getCount() &gt; 0 then
    result = createStringlist()
    for i = 1, fl.getCount() do result.add( fl.getAddress( i - 1 ) ) end
  end
  fl.destroy()
  ms.destroy()
  if result and result.Count &gt; 0 then return tonumber( result[index], 16 ) end
  return nil
end
registerLuaFunctionHighlight('aobScan')

function aobScanRange( startAddress, offset, aob )
  local p, a, n, s = nil or '*X*W', nil or fsmNotAligned, nil or '0', startAddress or 0x0
  local e = startAddress + (offset or 0x100000000)
  local ms = pb and createMemScan( pb ) or createMemScan()
  local fl = createFoundList( ms )
  ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
  ms.waitTillDone()
  fl.initialize()
  local result = nil
  if fl ~= nil and fl.getCount() &gt; 0 then
    result = createStringlist()
    for i = 1, fl.getCount() do result.add( fl.getAddress( i - 1 ) ) end
  end
  fl.destroy()
  ms.destroy()
  if result and result.Count &gt; 0 then return tonumber( result[0], 16 ) end
  return nil
end
registerLuaFunctionHighlight('aobScanRange')

function string.fromhex( s )
  return ( s:gsub( '..', function ( cc )
    return string.char( tonumber( cc, 16 ) )
  end ) )
end

function aobScanSmall( aob, s, e )
  local i = byteTableToString( readBytes( s, e, true ) ):find( string.fromhex( aob ), 1, true )
  if i == nil then i = 1 end
  return ( s + i - 1 )
end

function getStaticFieldValue( domain, class, field )
  local c = mono_findClass( domain, class )
  local v = mono_class_getVTable( c )
  local f = mono_class_enumFields( c )

  for i=1, #f do
    if f[i].isStatic and f[i].name == field then
      return mono_class_getStaticFieldValue( a, f[i].field )
    end
  end
end
registerLuaFunctionHighlight('getStaticFieldValue')

function split(s, delimiter)
    result = {}
    for match in (s .. delimiter):gmatch('(.-)' .. delimiter) do
        table.insert(result, match)
    end
    return result
end
registerLuaFunctionHighlight('split')

function getFormByName( pattern )
  local fc = getFormCount()
  for i = 0, fc-1 do
    local tf = getForm(i)
    local s = tf.caption
    local m = s:match(pattern) or ''
    if m &gt; '' then
      return tf
    end
  end
end
registerLuaFunctionHighlight('getFormByName')

local function allocSymbol(args, syntaxcheck)
    if ExitOnSyntaxCheck and syntaxcheck then return end
    args = split(args, ',')
    if args[1] == nil then
        return nil, translate('Incorrect parameters for "allocsymbol(name,[nearbyAddress])" custom AA command.')
    end
    if args[2] then
        local str = 'alloc(%s,8,%s)  registersymbol(%s)  %s:'
        return str:gsub('  ','\r\n'):format(args[1],args[2],args[1],args[1])
    end
    local str = 'alloc(%s,8)  registersymbol(%s)  %s:'
    return str:gsub('  ','\r\n'):format(args[1],args[1],args[1])
end

local function deallocSymbol(args, syntaxcheck)
    if ExitOnSyntaxCheck and syntaxcheck then return end
    if args == nil then
        return nil, translate('Wrong number of parameters for "deallocsymbol(name)" custom AA command.')
    end
    local str = '%s:  dq 0  dealloc(%s)  unregistersymbol(%s)'
    return str:gsub('  ','\r\n'):format(args,args,args)
end

registerAutoAssemblerCommand('allocsymbol', allocSymbol)
registerAutoAssemblerCommand('deallocsymbol', deallocSymbol)

function CreateRecord( parent, size, desc, addr )
  local mr = AddressList.createMemoryRecord()
  mr.DontSave = true
  mr.Color = 0x444444
  mr.description = desc
  mr.Type = size
  mr.Address = addr
  mr.appendToEntry(parent)
  return mr
end
registerLuaFunctionHighlight('CreateRecord')

function CreateDDRecord( parent, size, desc, addr, ref )
  local mr = AddressList.createMemoryRecord()
  mr.DontSave = true
  --mr.Color = 0x666666
  mr.DropDownLinked = true
  mr.DisplayAsDropDownListItem = true
  mr.description = desc
  mr.Type = size
  mr.Address = addr
  mr.DropDownLinkedMemrec = ref
  mr.appendToEntry(parent)
  return mr
end
registerLuaFunctionHighlight('CreateDDRecord')

local function cycleFullCompact(sender,force)
    local state = not(compactmenuitem.Caption == 'Compact View')
    if force~=nil then
      state = not force
    end
    compactmenuitem.Caption = state and 'Compact View' or 'Full View'
    getMainForm().Splitter1.Visible = state;
    getMainForm().Panel4.Visible    = state;
    getMainForm().Panel5.Visible    = state;
end

local function addCompactMenu()
    if compactmenualreadyexists then return end
    local parent = getMainForm().Menu.Items
    compactmenuitem = createMenuItem(parent)
    parent.add(compactmenuitem)
    compactmenuitem.Caption = 'Compact View'
    compactmenuitem.OnClick = cycleFullCompact
    compactmenualreadyexists = 'yes'
end

local function addAAMenu()
    if aamenualreadyexists then return end
    local parent = getMainForm().Menu.Items
    aamenuitem = createMenuItem(parent)
    parent.add(aamenuitem)
    aamenuitem.Caption = 'Lua Engine'
    aamenuitem.OnClick = getLuaEngine().Show
    aamenualreadyexists = true
end

local function convertToHWOffset()
    local mr = AddressList.getSelectedRecord()
    if not mr then return end
    local curr_addr = mr.CurrentAddress
    if not curr_addr and curr_addr &lt;= 0 then return end
    local hw_offset = curr_addr - getAddress( 'heap' )

    if hw_offset &gt; 0 then
       mr.address = 'heap + ' .. string.format( '%X', hw_offset )
    end
end

local function addHWOffsetMenu()
    if hwoffsetmenualreadyexists then return end;
    local parent = getMainForm().Menu.Items
    hwoffsetmenuitem = createMenuItem(parent)
    parent.add(hwoffsetmenuitem)
    hwoffsetmenuitem.Caption = 'Convert to HW Offset'
    hwoffsetmenuitem.OnClick = convertToHWOffset
    hwoffsetmenualreadyexists = 'yes'
end

local function addStructureDissect()
    if dissectalreadyexists then return end;
    local parent = getMainForm().Menu.Items
    dissectmenuitem = createMenuItem(parent)
    parent.add(dissectmenuitem)
    dissectmenuitem.Caption = 'Structure'
    dissectmenuitem.OnClick = createStructureForm
    dissectalreadyexists = 'yes'
end

local function autoAttachTimer_tick( timer )
  -- Keycombo to kill timer
  if ( isKeyPressed(VK_CONTROL) and isKeyPressed(VK_SHIFT) and isKeyPressed(VK_Z) ) then
    cls()
    print( 'timer destroyed' )
    timer.destroy()
    return
  end

  if processsymbol and cheatTick then
    cheatTick()
    return
  end

  if not processsymbol and readInteger( process ) then
    if not getAddressSafe( 'process' ) then
      unregisterSymbol( 'process' )
      main = getAddress( process )
      registerSymbol( 'process', main )
      return
    end

    if getAddressSafe( 'process' ) then
      processsymbol = true
    end
  end
end

autoAttachTimerInterval = 250
autoAttachTimer = nil

processsymbol = false

addCompactMenu()
--addStructureDissect()
--addHWOffsetMenu()
--addAAMenu()
cycleFullCompact(nil,true)

--autoAttachTimer = createTimer(MainForm)
--autoAttachTimer.Interval = autoAttachTimerInterval
--autoAttachTimer.OnTimer = autoAttachTimer_tick

[DISABLE]
if autoAttachTimer then autoAttachTimer.destroy() end
unregisterSymbol( 'process' )
processsymbol = false
