              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>87598</ID>
              <Description>"bGod2"</Description>
              <ShowAsSigned>1</ShowAsSigned>
              <VariableType>Byte</VariableType>
              <Address>g_goPlayer</Address>
