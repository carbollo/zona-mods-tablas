            <CheatEntry>
              <ID>1337193155</ID>
              <Description>"[X] &lt;== Materials Gained Multiplier (Must have at least one, Then will Multiply others when picked up)"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>800080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(gained_mat,eldenring.exe,41 8d 40 ? 89 87) // should be unique
alloc(newmem,$1000,gained_mat)

label(code)
label(return)
label(gained_matread)
registersymbol(gained_matread)
label(multiplied)
registersymbol(multiplied)

newmem:
   push r12
   mov r12, [multiplied]
   lea eax, [r12+r8]
   dec edx
   lea edx, [rdx+r12]
   readmem(gained_mat+4,6)
   pop r12
   jmp return
code:
  readmem(gained_mat,10)
  jmp return

gained_matread:
 readmem(gained_mat,10)

multiplied:
 dd #2

gained_mat:
  jmp newmem
  nop 5
return:
registersymbol(gained_mat)

[DISABLE]

gained_mat:
  readmem(gained_matread,10)

