defense_powercalctwo:
  jmp newmem1
return1:
registersymbol(defense_powercalctwo)

defense_neg_real:
  jmp newmem3
  nop 3
return3:
registersymbol(defense_neg_real)

defense_neg_viewed:
  jmp newmem4
  nop 2
return4:
registersymbol(defense_neg_viewed)

