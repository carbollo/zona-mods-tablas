          <AssemblerScript>{Author:inuNorii}
[ENABLE]
aobscanmodule(AddSoul_Call,eldenring.exe,44 8B 41 6C 45 33 D2 44 89 54 24 10 45 8D 0C 10 44 89 4C 24 08 45 85 C9)
alloc(AddSoul,$100,eldenring.exe)
registerSymbol(AddSoul)
label(AddSoulData)

AddSoul:
sub rsp,48
mov edi,[AddSoulData]
mov rcx,[WorldChrMan]
mov rcx,[rcx+0000B658]
mov rcx,[rcx]
mov rcx,[rcx+00000570]
mov edx,edi
call AddSoul_Call
add rsp,48
ret

AddSoulData:
registerSymbol(AddSoulData)
dd #500

[DISABLE]
dealloc(AddSoul)
unregisterSymbol(AddSoul)
unregisterSymbol(AddSoulData)
</AssemblerScript>
