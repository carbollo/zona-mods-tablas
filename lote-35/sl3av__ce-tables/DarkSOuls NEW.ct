              <AssemblerScript>[ENABLE]
aobscanmodule(aobGetFollowCam,eldenring.exe,F3 0F 10 93 60 01 00 00 F3 0F 10 9B) // should be unique
alloc(newmem,$500,aobGetFollowCam)

label(code)
label(return)
label(pCam)
registersymbol(pCam)
label(bNoClip)
registersymbol(bNoClip)
label(fSpeed)
registersymbol(fSpeed)

newmem:

code:
  mov [pCam],rbx
  movss xmm2,[rbx+00000160]
  jmp return
pCam:
dq 0
bNoClip:
db 0
fSpeed:
dd (float)1

aobGetFollowCam:
  jmp newmem
  nop 3
return:
registersymbol(aobGetFollowCam)

////

aobscanmodule(aobGetPlayerIns,eldenring.exe,48 8B 03 48 8D 94 24 83 00 00 00) // should be unique
alloc(newmem2,$500,aobGetPlayerIns)

label(code2)
label(return2)
label(pPlayerI)
registersymbol(pPlayerI)
newmem2:

code2:
  mov [pPlayerI],rbx
  mov rax,[rbx]
  lea rdx,[rsp+00000083]
  jmp return2
pPlayerI:
dq 0

aobGetPlayerIns:
  jmp newmem2
  nop 6
return2:
registersymbol(aobGetPlayerIns)


///////////

aobscanmodule(aobWriteVec,eldenring.exe,0F 11 43 70 C7 43 7C 00 00 80 3F) // should be unique
alloc(newmem3,$500,aobWriteVec)

label(code3)
label(return3)

newmem3:

code3:
  push rax
  mov rax,pPlayerI
  mov rax,[rax]
  test rax,rax
  je short @f
   mov rax,[rax+190]
   test rax,rax
   je short @f
    mov rax,[rax+68]
    cmp rax,rbx
     jne short @f
      mov rax,bNoClip
      cmp byte ptr[rax],0
      je short @f
       pop rax
       mov [rbx+7C],3F800000
       jmp return3
  @@:
  pop rax
  movups [rbx+70],xmm0
  mov [rbx+7C],3F800000
  jmp return3

aobWriteVec:
  jmp newmem3
  nop 6
return3:
registersymbol(aobWriteVec)
 
 
