{$lua}
local function IsValueInDropList(memrec,val)
    for i=0,memrec.DropDownCount-1 do
        if tonumber(memrec.DropDownValue[i])==val then
           return true
        end
    end
    return false
end

local ItemID=readInteger("itembuffer+24")
local ItemType=ItemID&gt;&gt;28
ItemID=ItemID&amp;0xFFFFFFF
if ItemType==15 then
   local addrlist=getAddressList()
   if IsValueInDropList(addrlist.getMemoryRecordByID(601301),ItemID) or IsValueInDropList(addrlist.getMemoryRecordByID(601305),ItemID) then--goods
      ItemID=ItemID|0x40000000
   elseif IsValueInDropList(addrlist.getMemoryRecordByID(601059),ItemID) then--ring
      ItemID=ItemID|0x20000000
   elseif IsValueInDropList(addrlist.getMemoryRecordByID(601250),ItemID) then--armor
      ItemID=ItemID|0x10000000
   elseif IsValueInDropList(addrlist.getMemoryRecordByID(83064),ItemID) then
      ItemID=ItemID|0x80000000
   end
   writeInteger("itembuffer+24",ItemID)
end
executeCode("itemgib",0)
createTimer(128,function(timer)
    getAddressList().getMemoryRecordByID(601067).Active=false
    if ItemType==15 then
       ItemID=ItemID|0xF0000000
       writeInteger("itembuffer+24",ItemID)
    end
end)
