  <CheatEntries>
    <CheatEntry>
      <ID>1337092247</ID>
      <Description>"Elden Ring All-in-One Table v0.6 - Game Vr. 1.02.3 - Team Hexinton"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : miyazaki
  Version:
  Date   : 2022-01-22
  Author : Team Hexinton

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$lua}
--Don't cheat online, make sure EAC is not running, we won't provide any help with using this table online
if getProcessIDFromProcessName('start_protected_game.exe') or getProcessIDFromProcessName('EasyAntiCheat_EOS.exe') then
    messageDialog('EAC is not disabled.Make sure you are running eldenring.exe instead of start_protected_game.exe',1)
    error('EAC is not disabled')
end
openProcess("eldenring.exe")
if not getProcessIDFromProcessName('eldenring.exe') then
    messageDialog('Game is not running.',1)
    error('Game is not running')
end

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,48 8B 05 ???????? 48 85 C0 74 0F 48 39 88 ???????? 75 06 89 B1 5C030000 0F28 05 ???????? 4C 8D 45 E7)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("WorldChrMan", addr, true)

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,48 8B 05 ?? ?? ?? ?? 48 85 C0 74 05 48 8B 40 58 C3 C3)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("GameDataMan", addr, true)

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,48 8B 0D ???????? C7 44 24 50 FF FF FF FF C7 45 A0 FF FF FF FF 48 85 C9 75 2E)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("MapItemMan", addr, true)

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,48 8B 0D ???????? 80 BB D7 00 00 00 00 0F 84 CE 00 00 00 48 85 C9 75 2E)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("CSFlipper", addr, true)

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,48 8B 05 ???????? 80 B8 3C0D0000 0D 0F94 C0 C3)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("GameMan", addr, true)

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,48 8B 05 ?? ?? ?? ?? 48 85 C0 74 ?? 41 BE 01 00 00 00 44 89 74)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 3) + 7
unregisterSymbol("Finder")
registerSymbol("CSLuaEventManager", addr, true)

if not guiswitchmenu then
  guiswitchmenu=createMenuItem(getMainForm().Menu.Items)
  guiswitchmenu.OnClick=function(sender,force)
      getMainForm().Splitter1.Visible=not getMainForm().Splitter1.Visible
      getMainForm().Panel4.Visible=not getMainForm().Panel4.Visible
      getMainForm().Panel5.Visible=not getMainForm().Panel5.Visible
      if getMainForm().Splitter1.Visible then
         sender.Caption="Hide UI"
      else
         sender.Caption="Show UI"
      end
  end
  getMainForm().Menu.Items.add(guiswitchmenu)
  guiswitchmenu.OnClick(guiswitchmenu,false)
end

[DISABLE]
