          <CheatEntries>
            <CheatEntry>
              <ID>1337193135</ID>
              <Description>"[X] &lt;== Movement Speed Change"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>5900B3</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(player_mov_speed,eldenring.exe,f3 0f 58 4b ? f3 0f 59 d8) // should be unique
alloc(newmem,$1000,player_mov_speed)

label(code)
label(return)
label(move_speed)
registersymbol(move_speed)
label(player_mov_speedread)
registersymbol(player_mov_speedread)

newmem:
  push rdx
  mov rdx, [rbx+8]
  test rdx, rdx
  je code
  cmp rdx, [playergod_cmp]      //player compare
  jne code
  mulss xmm1, [move_speed]
  mulss xmm3, [move_speed]
code:
  pop rdx
  readmem(player_mov_speed,5)
  jmp return

player_mov_speedread:
 readmem(player_mov_speed,5)

move_speed:
 dd (float)1.5

player_mov_speed:
  jmp newmem
return:
registersymbol(player_mov_speed)

[DISABLE]

player_mov_speed:
  readmem(player_mov_speedread,5)

