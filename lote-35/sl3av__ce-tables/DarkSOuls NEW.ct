aobscanmodule(InfJump,eldenring.exe,74 ? 48 81 c1 ? ? ? ? e8 ? ? ? ? 84 c0 75 ? b0 ? 48 83 c4 ? c3 32 c0 48 83 c4 ? c3 cc) // should be unique
