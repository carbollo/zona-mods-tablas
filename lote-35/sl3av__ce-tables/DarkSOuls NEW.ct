label(code)
label(return)
registersymbol(freeze_time_day)
label(freeze_time_day)
registersymbol(set_morning)
label(set_morning)

newmem:
  cvttss2si edx,xmm0
  cmp [freeze_time_day], 00000001
  jne @f
  xor edx, edx
@@:
  cmp [set_morning], 00000001          //run this just once when this is toggled
  jne code
  mov edx, #3000000
code:
  test edx,edx
  jmp return

freeze_time_day:
 dd 0
set_morning:
 dd 0

daylight:
  jmp newmem
  nop
return:
registersymbol(daylight)

[DISABLE]
