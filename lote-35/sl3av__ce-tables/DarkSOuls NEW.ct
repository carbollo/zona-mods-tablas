            <CheatEntry>
              <ID>1337192918</ID>
              <Description>"[X] &lt;== Infinite Jumps and Horse Jumps (Akira did Horse) (Must Move around on Horse in air to get height)"</Description>
              <LastState/>
              <Color>5900B3</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(horse_jump,eldenring.exe,88 87 ? ? ? ? 48 8b 83 ? ? ? ? 48 8b 48 ? 80 b9) // should be unique
alloc(newmem1,$100,horse_jump)
aobscanmodule(inf_horse_two,eldenring.exe,88 87 ? ? ? ? 48 8b 83 ? ? ? ? 48 8b 48 ? e8 ? ? ? ? 88 87) // should be unique
