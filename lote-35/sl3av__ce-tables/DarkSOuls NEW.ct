                  <AssemblerScript>[ENABLE]
{$asm}
aobScanModule(AttackAccessor,eldenring.exe,66 0F 6E C1 0F 5B C0 F3 0F 11 46 20 48 85 C0 74 06)
alloc(AttackHook,4096,AttackAccessor)
define(goback,AttackAccessor+7)
label(AttackLog)
label(loopstart)
label(inccount)
label(loopnext)
registersymbol(AttackLog)
AttackHook:
movd xmm0,ecx
cvtdq2ps xmm0,xmm0
test rax,rax
je goback
lea r8,[AttackLog]
lea r9,[AttackLog+FF0]
loopstart:
cmp qword ptr[r8],rax
je inccount
cmp qword ptr[r8],0
jne loopnext
mov [r8],rax
inccount:
inc [r8+8]
jmp goback
loopnext:
add r8,10
cmp r8,r9
jbe loopstart
jmp goback
align 8
AttackLog:
AttackAccessor:
jmp AttackHook
{$lua}
AttackLogForm.AttackList.OnKeyDown=function(sender,key)
    if key==67 and isKeyPressed(17) then
       CopyListView(sender)
    end
end

AttackLogForm.OnClose=function(sender)
    getAddressList().getMemoryRecordByID(601335).Active=false
end
AttackLogForm.OnResize=function(sender)
    sender.EditAttackID.Top=sender.ClientHeight-sender.EditAttackID.Height
    sender.EditAttackID.Width=sender.ClientWidth-sender.EditAttackID.Left
    sender.LabelAttackID.Top=sender.EditAttackID.Top+(sender.EditAttackID.Height-sender.LabelAttackID.Height)/4
    sender.AttackList.setSize(sender.ClientWidth,sender.EditAttackID.Top)
end
AttackLogForm.OnResize(AttackLogForm)
items=AttackLogForm.AttackList.getItems()

AttackLogForm.AttackList.OnSelectItem=function(sender)
    local item=sender.Selected
    if item then
        AttackLogForm.EditAttackID.Text=item.getCaption()
    end
end

AttackLogForm.AttackList.OnDblClick=function(sender)
    local item=sender.Selected
    if item then
        writeInteger(ParamID+4*8,tonumber(item.getCaption()))
    end
end

function UpdateAttackList()
    if not AttackLog then
       AttackLog=getAddressSafe("AttackLog")
    end
    local i,j
    j=0
    for i=0,4096/16-1 do
        local Attack_addr=readQword(AttackLog+i*16)
        if Attack_addr==0 then
           break
        end
        local Attack_id=AttackTableInverse[Attack_addr]
        if Attack_id then
            local item
            if j&lt;items.Count then
               item=items[j]
            else
               item=items.add()
            end
            local s=tostring(Attack_id)
            if s~=item.getCaption() then
               item.setCaption(s)
            end
            s=tostring(readInteger(AttackLog+i*16+8))
            if item.SubItems.Count&lt;1 then
                item.SubItems.add(s)
            elseif item.SubItems[0]~=s then
                item.SubItems[0]=s
            end
            j=j+1
        end
    end
end

AttackLogForm.OnResize(AttackLogForm)
items=AttackLogForm.AttackList.getItems()
AttackLogTimer=createTimer(nil,true)
AttackLogTimer.Interval=256
AttackLogTimer.OnTimer=function(timer)
UpdateAttackList()
    --if not pcall(UpdateAttackList) then
    --    getAddressList().getMemoryRecordByID(601335).Active=false
    --end
end

AttackLogForm.show()
[DISABLE]
{$lua}
AttackLog=nil
if AttackLogTimer then
   AttackLogTimer.destroy()
   AttackLogTimer=nil
end
AttackLogForm.hide()
AttackLogForm.EditAttackID.Text=""
if items then
   items.clear()
   items=nil
end
