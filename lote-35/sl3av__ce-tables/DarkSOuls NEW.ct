registersymbol(defense_neg_mult)

label(code4)
label(return4)

newmem:
  movss [rbx+10],xmm0
  movss xmm7,[defen_power_mult]
code:
  movss xmm11,[rbx+0]
  movss xmm12,[rbx+4]
  movss xmm13,[rbx+8]
  movss xmm14,[rbx+C]
  movss xmm15,[rbx+10]
  mulss xmm11,xmm7
  mulss xmm12,xmm7
  mulss xmm13,xmm7
  mulss xmm14,xmm7
  mulss xmm15,xmm7
  movss [rbx+0],xmm11
  movss [rbx+4],xmm12
  movss [rbx+8],xmm13
  movss [rbx+C],xmm14
  movss [rbx+10],xmm15
  xorps xmm7,xmm7
  xorps xmm11,xmm11
  xorps xmm12,xmm12
  xorps xmm13,xmm13
  xorps xmm14,xmm14
  xorps xmm15,xmm15
  jmp return

defen_power_mult:
 dd (float)1

newmem1:
 movss [rcx+10],xmm3
 movss xmm7,[defen_power_mult]
code1:
  movss xmm11,[rcx+0]
  movss xmm12,[rcx+4]
  movss xmm13,[rcx+8]
  movss xmm14,[rcx+C]
  movss xmm15,[rcx+10]
  mulss xmm11,xmm7
  mulss xmm12,xmm7
  mulss xmm13,xmm7
  mulss xmm14,xmm7
  mulss xmm15,xmm7
  movss [rcx+0],xmm11
  movss [rcx+4],xmm12
  movss [rcx+8],xmm13
  movss [rcx+C],xmm14
  movss [rcx+10],xmm15
  xorps xmm7,xmm7
  xorps xmm11,xmm11
  xorps xmm12,xmm12
  xorps xmm13,xmm13
  xorps xmm14,xmm14
  xorps xmm15,xmm15
  jmp return1

newmem3:
  push r8
  mov r8, [defense_neg_mult]
  mov [rsi], r8
code3:
  pop r8
  mulss xmm1,[rsi]
  subss xmm0,xmm1
  jmp return3

defense_neg_mult:
 dd (float)1

newmem4:
  movss xmm2,[defense_neg_mult]
code4:
  movaps xmm1,xmm6
  jmp return4

defenpower_calc:
  jmp newmem
return:
