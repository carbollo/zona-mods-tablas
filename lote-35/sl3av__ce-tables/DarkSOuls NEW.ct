FaceEditor:
db 0F B6 83 AC 00 00 00 88 87 AC 00 00 00 0F B6 83 AD 00 00 00 88 87 AD 00 00 00 0F B6 83 AE 00 00 00 88 87 AE 00 00 00 0F
//FaceEditor1:
//db 0F B6 83 AC 00 00 00 88 87 AC 00 00 00 0F B6 83 AD 00 00 00 88 87 AD 00 00 00 0F B6 83 AE 00 00 00 88 87 AE 00 00 00 0F
FaceAccessor:
db 48 89 85 98 00 00 00 48 8B DA 48 89 54 24 38 4C 8B F9 48 8D 71 10 48 83 3E 00
unregistersymbol(FaceLog)
dealloc(FaceHook)

