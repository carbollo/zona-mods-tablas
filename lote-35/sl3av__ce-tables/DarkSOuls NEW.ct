                </CheatEntry>
                <CheatEntry>
                  <ID>1337193205</ID>
                  <Description>"[X] &lt;== Set Daylight/Time (May have to toggle a few times)"</Description>
                  <LastState/>
                  <Color>808000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
writeInteger("set_morning",1)
local timer = createTimer(nil, false)
timer.Interval = 1000  -- time in Milisecond 1000 msec = 1 sec
timer.OnTimer = function(timer)
    timer.Enabled = false
    timer.destroy()
    memrec.Active = false --Disactivate this script
end
-- After 2 sec from the script activate
timer.Enabled = true

[DISABLE]
writeInteger("set_morning",0)
</AssemblerScript>
