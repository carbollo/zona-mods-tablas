label(return1)
label(horse_jumpread)
registersymbol(horse_jumpread)
label(code)
label(return)
label(inf_horse_tworead)
registersymbol(inf_horse_tworead)

codejump:
	reassemble(InfJump)

InfJump:
	nop 2

newmem1:
  mov al,1
code1:
  readmem(horse_jump,6)
  jmp return1

horse_jumpread:
 readmem(horse_jump,6)

newmem:
  mov al,1
code:
  readmem(inf_horse_two,6)
  jmp return

inf_horse_tworead:
 readmem(inf_horse_two,6)

horse_jump:
  jmp newmem1
  nop
return1:
registersymbol(horse_jump)

inf_horse_two:
  jmp newmem
  nop
return:
registersymbol(inf_horse_two)


[DISABLE]
infJump:
	reassemble(codejump)
