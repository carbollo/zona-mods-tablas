          <ID>1337193134</ID>
          <Description>"Scripts by FULLCODES &amp; GIDEON25"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
LuaCall(function cycleFullCompact(sender,force) local state = not(compactmenuitem.Caption == 'Compact View Mode'); if force~=nil then state = not force end; compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible    = state; getMainForm().Panel5.Visible    = state; end; function addCompactMenu() if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,true))
aobscanmodule(pStat,eldenring.exe,8b 88 ? ? ? ? 89 8e ? ? ? ? 49 8b 84 24) // should be unique
alloc(newmem,$1000,pStat)
alloc(pStatAdr,8)
alloc(playergod_cmp,8)
alloc(playerdmg_cmp,8)

aobscanmodule(damager,eldenring.exe,41 8b 96 ? ? ? ? 48 8b ce 45 0f b6 86) // should be unique
alloc(newmem1,$1000,damager)
alloc(dmg_multiplier,8)


registersymbol(pStatAdr)
label(code)
label(return)
label(pStatread)
registersymbol(pStatread)
registersymbol(playerdmg_cmp)
registersymbol(playergod_cmp)
label(inf_health)
registersymbol(inf_health)
label(inf_fp)
registersymbol(inf_fp)
label(inf_stamina)
registersymbol(inf_stamina)

label(code1)
label(return1)
label(damagerread)
registersymbol(damagerread)
label(damage_mult_enable)
registersymbol(damage_mult_enable)
label(ohk)
registersymbol(ohk)
registersymbol(dmg_multiplier)

newmem:
  push rdx
  mov [pStatAdr],rax
  mov rdx, rax
  mov [playerdmg_cmp], rdx    //if needed an extra compare
  mov rdx, [rdx+8]            // instance of CS::PlayerIns   for player compare
  mov [playergod_cmp], rdx
  db 48 8D 90                 //lea rdx,[rax+138]   Current Health
  readmem(pStat+2,4)
  cmp [inf_health], 00000001
  jne @f
  mov ecx, [rdx+4]          //Max Health
  mov [rdx], ecx            //into current health
@@:
  cmp [inf_fp], 00000001
  jne @f
  mov ecx, [rdx+10]         //Max FP
  mov [rdx+0C], ecx         //current fp
@@:
  cmp [inf_stamina], 00000001
  jne code
  mov ecx, [rdx+1C]          //Max Stamina
  mov [rdx+18], ecx          //current stam
code:
  mov ecx,[rdx]
  pop rdx
  jmp return

pStatread:
 readmem(pStat,8)

inf_health:
 dd 0
inf_fp:
 dd 0
inf_stamina:
 dd 0

dmg_multiplier:
 dd (float)2

newmem1:
  db 49 8D 96
  readmem(damager+3,4)  //  lea rdx,[r14+00000228]
  cmp dword ptr [rdx],0
  jng code1
  mov rcx, [playergod_cmp]
  cmp rcx, rdi
  jne code1
  cmp [damage_mult_enable], 00000001
  jne @f
  fild dword ptr [rdx]
  fmul dword ptr [dmg_multiplier]
  fistp dword ptr [rdx]
@@:
  cmp [ohk], 00000001
  jne code1
  mov [rdx],#9999999
code1:
  mov edx,[rdx]
  jmp return1

damage_mult_enable:
 dd 0
ohk:
 dd 0

damagerread:
 readmem(damager,7)

pStat:
  jmp newmem
  nop
return:
registersymbol(pStat)

damager:
  jmp newmem1
  nop 2
return1:
registersymbol(damager)

[DISABLE]

pStat:
  readmem(pStatread,8)
damager:
  readmem(damagerread,7)

unregistersymbol(*)
dealloc(*)

