                  <AssemblerScript>[ENABLE]
{$asm}
aobScanModule(CreateBulletFunc,eldenring.exe,F3 0F 11 B3 14 0B 00 00 F3 0F 11 B3 18 0B 00 00 0F 28 74 24 40 48 83 C4 50 5B C3)
alloc(CreateBulletHook,4096,eldenring.exe)
label(CreateBulletLog)
label(addlog)
label(loopnext)
label(goback)
registerSymbol(CreateBulletLog)
CreateBulletHook:
mov ecx,[rbx+4B4]//bullet id
mov edx,[rbx+4C0]//shooter id
lea r8,[CreateBulletLog]
lea r9,[CreateBulletHook+FF4]
loopstart:
cmp [r8],0
je addlog
cmp [r8],ecx
jne loopnext
cmp [r8+4],edx
jne loopnext
addlog:
mov [r8],ecx
mov [r8+4],edx
inc [r8+8]
jmp goback
loopnext:
add r8,C
cmp r8,r9
jbe loopstart
goback:
movss [rbx+00000B14],xmm6
movss [rbx+00000B18],xmm6
movaps xmm6,[rsp+40]
add rsp,50
pop rbx
ret

align 4
CreateBulletLog:
//dd bullet_id,shooter_id,accumulator

CreateBulletFunc:
jmp CreateBulletHook
{$lua}
BulletLogForm.BulletList.OnKeyDown=function(sender,key)
    if key==67 and isKeyPressed(17) then
       CopyListView(sender)
    end
end


BulletLogForm.OnClose=function(sender)
    getAddressList().getMemoryRecordByID(601069).Active=false
end
BulletLogForm.OnResize=function(sender)
    sender.EditOwnerID.Top=sender.ClientHeight-sender.EditOwnerID.Height
    sender.EditOwnerID.Width=sender.ClientWidth-sender.EditBulletID.Left
    sender.LabelOwnerID.Top=sender.EditOwnerID.Top+(sender.EditOwnerID.Height-sender.LabelOwnerID.Height)/4
    sender.EditBulletID.Top=sender.EditOwnerID.Top-sender.EditOwnerID.Height-2
    sender.EditBulletID.Width=sender.ClientWidth-sender.EditBulletID.Left
    sender.LabelBulletID.Top=sender.EditBulletID.Top+(sender.EditBulletID.Height-sender.LabelBulletID.Height)/4
    sender.BulletList.setSize(sender.ClientWidth,sender.EditBulletID.Top)
end

function UpdateBulletList()
    if not CreateBulletLog then
       CreateBulletLog=getAddressSafe("CreateBulletLog")
    end
    for i=0,4096/12-1 do
        local bullet_id=readInteger(CreateBulletLog+i*12)
        local shooter_id=readInteger(CreateBulletLog+i*12+4)
        local accum=readInteger(CreateBulletLog+i*12+8)
        if bullet_id==0 and shooter_id==0 then
           break
        end
        local item
        if i&lt;items.Count then
           item=items[i]
        else
           item=items.add()
        end
        local s=tostring(bullet_id)
        if s~=item.getCaption() then
           item.setCaption(s)
        end
        s=string.format("0x%08X",shooter_id)
        if item.SubItems.Count&lt;1 then
            item.SubItems.add(s)
        elseif item.SubItems[0]~=s then
            item.SubItems[0]=s
        end

        s=string.format("% 9u",accum)
        if item.SubItems.Count&lt;2 then
            item.SubItems.add(s)
        elseif item.SubItems[1]~=s then
            item.SubItems[1]=s
        end
    end
end

BulletLogForm.OnResize(BulletLogForm)
items=BulletLogForm.BulletList.getItems()
BulletLogTimer=createTimer(nil,true)
BulletLogTimer.Interval=256
BulletLogTimer.OnTimer=function(timer)
    if not pcall(UpdateBulletList) then
        getAddressList().getMemoryRecordByID(601069).Active=false
    end
end

BulletLogForm.BulletList.OnSelectItem=function(sender)
    local item=sender.Selected
    if item then
        BulletLogForm.EditBulletID.Text=item.getCaption()
        if item.SubItems.Count&gt;=1 then
            BulletLogForm.EditOwnerID.Text=item.SubItems[0]
        end
    end
end

BulletLogForm.BulletList.OnDblClick=function(sender)
    local item=sender.Selected
    if item then
        writeInteger(ParamID+4*10,tonumber(item.getCaption()))
    end
end

BulletLogForm.show()
[DISABLE]
{$lua}
BulletLogTimer.destroy()
BulletLogTimer=nil
BulletLogForm.hide()
BulletLogForm.EditBulletID.Text=""
BulletLogForm.EditOwnerID.Text=""
items.clear()
items=nil
BulletLog=nil
{$asm}
unregisterSymbol(CreateBulletLog)
CreateBulletFunc:
