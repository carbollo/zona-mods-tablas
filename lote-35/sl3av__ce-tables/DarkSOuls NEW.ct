            <CheatEntry>
              <ID>1337192519</ID>
              <Description>"ItemDrop by Luke_Yui"</Description>
              <Options moHideChildren="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(ItemDrop_Call,eldenring.exe,48 8B C4 56 57 41 56 48 81 EC C0 00 00 00 48 C7 44 24 30 FE FF FF FF)
alloc(ItemDrop,100,eldenring.exe)
label(ItemDropData)
registerSymbol(ItemDrop)
registerSymbol(ItemDropData)

ItemDrop:
sub rsp,48
mov rcx,[MapItemMan]
xor r9d,r9d
lea r8d,[r9+01]
lea rdx,[ItemDropData]
call ItemDrop_Call
add rsp,48
ret

ItemDropData:
dd 400006E0  // ItemId
dd 00000001  // ItemQuantity
dd 00000000  //
dd FFFFFFFF  //

[DISABLE]
dealloc(ItemDrop)
unregisterSymbol(ItemDrop)
unregisterSymbol(ItemDropData)
</AssemblerScript>
