movss xmm3,[r13+r15+08]
addss xmm3,[vaddss]
movss [vYCord_Undo],xmm3
movss xmm3,[rr13+r15+04]
movss [vZCord_Undo],xmm3

movss xmm3,[XCord_Waypoint]
movss [r13+r15],xmm3
movss xmm3,[YCord_Waypoint]
addss xmm3,[vaddss]
movss [r13+r15+08],xmm3
movss xmm3,[ZCord_Waypoint]
movss [r13+r15+04],xmm3
jmp code2

vUndo:
mov [vUndo_Teleport],0
cmp [vXCord_Undo],0
je code2
movss xmm3,[vXCord_Undo]
movss [r13+r15],xmm3
movss xmm3,[vYCord_Undo]
movss [r13+r15+08],xmm3
movss xmm3,[vZCord_Undo]
movss [r13+r15+04],xmm3
jmp code2

lSpeed:
mov [Speed],0
movss xmm0,[r13+r15+40]
addss xmm0,[r13+r15+40]
movss [r13+r15+40],xmm0

movss xmm0,[r13+r15+44]
