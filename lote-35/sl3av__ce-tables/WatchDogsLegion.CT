label(code3)
label(return3)
label(NoWntLvl)

newmem3:

code3:
mov byte ptr [rcx+0000013C],01

cmp [NoWntLvl],0
je @f
mov byte ptr [rcx+0000013C],00
@@:
  mov bl,01
  cmp byte ptr [rcx+00000144],00
  jmp return3

NoWntLvl:
dd 0

_AobNoWantedLvl:
  jmp newmem3
  nop 4
return3:
registersymbol(_AobNoWantedLvl)
registersymbol(NoWntLvl)

[DISABLE]

_AobPlayerBase:
  db 48 8B 49 40 48 8B 79 30

_AobNoWantedLvl:
  db B3 01 80 B9 3C 01 00 00 00

unregistersymbol(_AobPlayerBase)
unregistersymbol(Player)
unregistersymbol(_AobNoWantedLvl)
unregistersymbol(NoWntLvl)
