aobscanregion(_AobTeleport,00007ff000000000,00007fffffffffff,48 8B 89 80 00 00 00 48 89 08 89)
alloc(newmem,$1000,_AobTeleport)

label(code)
label(return)
label(XCord)
label(YCord)
label(ZCord)
label(XCord_Undo)
label(YCord_Undo)
label(ZCord_Undo)
label(Load)
label(Save)
label(Undo)
label(SaveCords)
label(LoadCords)
label(LoadCords_Waypoint)
label(Undo_Teleport)
label(Coords)

newmem:
cmp [PlayerPtr],rbx
jne code
mov [Coords],rcx

cmp [SaveCords],1
je Save
cmp [LoadCords],1
je Load
cmp [LoadCords_Waypoint],1
je Waypoint
cmp [Undo_Teleport],1
je Undo
jmp code

Save:
mov [SaveCords],0
movss xmm3,[rcx+80]
movss [XCord],xmm3
movss xmm3,[rcx+88]
movss [YCord],xmm3
movss xmm3,[rcx+84]
movss [ZCord],xmm3
jmp code

Load:
mov [LoadCords],0
cmp [XCord],0
je code
movss xmm3,[rcx+80]
movss [XCord_Undo],xmm3
movss xmm3,[rcx+88]
movss [YCord_Undo],xmm3
movss xmm3,[rcx+84]
movss [ZCord_Undo],xmm3

movss xmm3,[XCord]
movss [rcx+80],xmm3
movss xmm3,[YCord]
movss [rcx+88],xmm3
movss xmm3,[ZCord]
movss [rcx+84],xmm3
jmp code

Waypoint:
mov [LoadCords_Waypoint],0
cmp [XCord_Waypoint],0
je code
movss xmm3,[rcx+80]
movss [XCord_Undo],xmm3
movss xmm3,[rcx+88]
movss [YCord_Undo],xmm3
movss xmm3,[rcx+84]
movss [ZCord_Undo],xmm3

movss xmm3,[XCord_Waypoint]
movss [rcx+80],xmm3
movss xmm3,[YCord_Waypoint]
movss [rcx+88],xmm3
movss xmm3,[ZCord_Waypoint]
movss [rcx+84],xmm3
jmp code

Undo:
mov [Undo_Teleport],0
cmp [XCord_Undo],0
je code
movss xmm3,[XCord_Undo]
movss [rcx+80],xmm3
movss xmm3,[YCord_Undo]
movss [rcx+88],xmm3
movss xmm3,[ZCord_Undo]
movss [rcx+84],xmm3
jmp code

code:
  mov rcx,[rcx+00000080]
  jmp return

XCord:
dd 0

YCord:
dd 0

ZCord:
dd 0

XCord_Undo:
dd 0

YCord_Undo:
dd 0

ZCord_Undo:
dd 0

SaveCords:
dd 0

LoadCords:
dd 0

LoadCords_Waypoint:
dd 0

Undo_Teleport:
dd 0

Coords:
dd 0

_AobTeleport:
  jmp newmem
  nop 2
return:
registersymbol(_AobTeleport)
registersymbol(XCord)
registersymbol(YCord)
registersymbol(ZCord)
registersymbol(XCord_Undo)
registersymbol(YCord_Undo)
registersymbol(ZCord_Undo)
registersymbol(SaveCords)
registersymbol(LoadCords)
registersymbol(LoadCords_Waypoint)
registersymbol(Undo_Teleport)
registersymbol(Coords)

[DISABLE]

_AobPlayerID:
  db 48 8B B8 D8 02 00 00

_AobTeleport:
  db 48 8B 89 80 00 00 00

