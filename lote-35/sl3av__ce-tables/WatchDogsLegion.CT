aobscanregion(_AobPlayerBase,00007ff000000000,00007fffffffffff,48 8B 49 40 48 8B 79 30)
alloc(newmem,$1000,_AobPlayerBase)

label(code)
label(return)
label(Player)

newmem:

code:
  mov rcx,[rcx+40]
  mov [Player],rcx
  mov rdi,[rcx+30]
  jmp return

Player:
dd 0

_AobPlayerBase:
  jmp newmem
  nop 3
return:
registersymbol(_AobPlayerBase)
registersymbol(Player)

////////////////////////////////////////////////////////////////////

aobscanregion(_AobNoWantedLvl,00007ff000000000,00007fffffffffff,B3 01 80 B9 3C 01 00 00 00)
