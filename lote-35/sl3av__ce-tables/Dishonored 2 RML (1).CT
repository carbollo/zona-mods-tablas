function CoordForm_LiveCoordsMouseMove(sender, x, y)

  local mult = 10^(5)
         CoordForm.LiveCoords.Items.Clear()
         CoordForm.LiveCoords.Items.Add("X: " .. math.modf(getAddressList().getMemoryRecordByDescription('X').getValue()*mult)/mult)
         CoordForm.LiveCoords.Items.Add("Y: " .. math.modf(getAddressList().getMemoryRecordByDescription('Y').getValue()*mult)/mult)
         CoordForm.LiveCoords.Items.Add("Z: " .. math.modf(getAddressList().getMemoryRecordByDescription('Z').getValue()*mult)/mult)
end

