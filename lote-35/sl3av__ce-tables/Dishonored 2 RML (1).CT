    <CheatEntry>
      <ID>88062</ID>
      <Description>"Coordinates"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
      <Color>C08000</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>88074</ID>
          <Description>"Save and Load Coordinates"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
          <Color>FFFF80</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}

function trunc(num, digits)
  local mult = 10^(digits)
  return math.modf(num*mult)/mult
end

function file_exists(name)
   local f=io.open(name,"r")
   if f~=nil then io.close(f) return true else return false end
end

SaveDirectory=lfs.currentdir ().."\\Coordinate Cache.txt"
[ENABLE]
CoordForm.Show()
SavSlot = 1
if file_exists(SaveDirectory) then
  local f = io.open(SaveDirectory);

for line in f:lines() do
str = line
end

CIndex = "1:X"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
XCoordS1=result CIndex = "1:Y"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
YCoordS1=result CIndex = "1:Z"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
ZCoordS1=result CIndex = "2:X"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
XCoordS2=result CIndex = "2:Y"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
YCoordS2=result CIndex = "2:Z"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
ZCoordS2=result CIndex = "3:X"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
XCoordS3=result CIndex = "3:Y"
local result = str:sub((str:find(CIndex)+5), str:find(CIndex) + str:find(string.char(13),str:find(CIndex))-str:find(CIndex)-2)
YCoordS3=result CIndex = "3:Z" ZCoordS3=result

f:close();

else

XCoordS1=trunc(getAddressList().getMemoryRecordByDescription('X').getValue(),5)
YCoordS1=trunc(getAddressList().getMemoryRecordByDescription('Y').getValue(),5)
ZCoordS1=trunc(getAddressList().getMemoryRecordByDescription('Z').getValue(),5)

XCoordS2=trunc(getAddressList().getMemoryRecordByDescription('X').getValue(),5)
YCoordS2=trunc(getAddressList().getMemoryRecordByDescription('Y').getValue(),5)
ZCoordS2=trunc(getAddressList().getMemoryRecordByDescription('Z').getValue(),5)

XCoordS3=trunc(getAddressList().getMemoryRecordByDescription('X').getValue(),5)
YCoordS3=trunc(getAddressList().getMemoryRecordByDescription('Y').getValue(),5)
ZCoordS3=trunc(getAddressList().getMemoryRecordByDescription('Z').getValue(),5)

end
-- Close the file from writing..



function CoordForm_ButtonSaveClick(sender)
  if SavSlot == 1 then
    XCoordS1=trunc(getAddressList().getMemoryRecordByDescription('X').getValue(),5)
    YCoordS1=trunc(getAddressList().getMemoryRecordByDescription('Y').getValue(),5)
    ZCoordS1=trunc(getAddressList().getMemoryRecordByDescription('Z').getValue(),5)

    CoordForm.Coordinates.Items.Clear()
    CoordForm.Coordinates.Items.Add("X: " .. XCoordS1)
    CoordForm.Coordinates.Items.Add("Y: " .. YCoordS1)
    CoordForm.Coordinates.Items.Add("Z: " .. ZCoordS1)
  end

  if SavSlot == 2 then
    XCoordS2=trunc(getAddressList().getMemoryRecordByDescription('X').getValue(),5)
    YCoordS2=trunc(getAddressList().getMemoryRecordByDescription('Y').getValue(),5)
    ZCoordS2=trunc(getAddressList().getMemoryRecordByDescription('Z').getValue(),5)

    CoordForm.Coordinates.Items.Clear()
    CoordForm.Coordinates.Items.Add("X: " .. XCoordS2)
    CoordForm.Coordinates.Items.Add("Y: " .. YCoordS2)
    CoordForm.Coordinates.Items.Add("Z: " .. ZCoordS2)
  end

  if SavSlot == 3 then
    XCoordS3=trunc(getAddressList().getMemoryRecordByDescription('X').getValue(),5)
    YCoordS3=trunc(getAddressList().getMemoryRecordByDescription('Y').getValue(),5)
    ZCoordS3=trunc(getAddressList().getMemoryRecordByDescription('Z').getValue(),5)

    CoordForm.Coordinates.Items.Clear()
    CoordForm.Coordinates.Items.Add("X: " .. XCoordS3)
    CoordForm.Coordinates.Items.Add("Y: " .. YCoordS3)
    CoordForm.Coordinates.Items.Add("Z: " .. ZCoordS3)
  end

-- Open the desired file for writing..
   local f = io.open(SaveDirectory, 'w');

-- Write the data to the file..
  Slot1 = "Save Slot 1:"..string.char(13).."1:X ["..XCoordS1.."]"..string.char(13).."1:Y ["..YCoordS1.."]"..string.char(13).."1:Z ["..ZCoordS1.."]"..string.char(13)..string.char(13)
  Slot2 = "Save Slot 2:"..string.char(13).."2:X ["..XCoordS2.."]"..string.char(13).."2:Y ["..YCoordS2.."]"..string.char(13).."2:Z ["..ZCoordS2.."]"..string.char(13)..string.char(13)
  Slot3 = "Save Slot 3:"..string.char(13).."3:X ["..XCoordS3.."]"..string.char(13).."3:Y ["..YCoordS3.."]"..string.char(13).."3:Z ["..ZCoordS3.."]"
  f:write(Slot1..Slot2..Slot3);

-- Close the file from writing..
   f:close();

end

function CoordForm_OnSaveSlot(sender)

         if CoordForm.SaveSlot.ItemIndex == 0 then
            SavSlot = 1
            CoordForm.Coordinates.Items.Clear()
            CoordForm.Coordinates.Items.Add("X: " .. XCoordS1)
            CoordForm.Coordinates.Items.Add("Y: " .. YCoordS1)
            CoordForm.Coordinates.Items.Add("Z: " .. ZCoordS1)
         end

         if CoordForm.SaveSlot.ItemIndex == 1 then
            SavSlot = 2
            CoordForm.Coordinates.Items.Clear()
            CoordForm.Coordinates.Items.Add("X: " .. XCoordS2)
            CoordForm.Coordinates.Items.Add("Y: " .. YCoordS2)
            CoordForm.Coordinates.Items.Add("Z: " .. ZCoordS2)
         end

         if CoordForm.SaveSlot.ItemIndex == 2 then
            SavSlot = 3
            CoordForm.Coordinates.Items.Clear()
            CoordForm.Coordinates.Items.Add("X: " .. XCoordS3)
            CoordForm.Coordinates.Items.Add("Y: " .. YCoordS3)
            CoordForm.Coordinates.Items.Add("Z: " .. ZCoordS3)
         end
end

function CoordForm_ButtonLoadClick(sender)

  if SavSlot == 1 then
    getAddressList().getMemoryRecordByDescription('X').Value = XCoordS1
    getAddressList().getMemoryRecordByDescription('Y').Value = YCoordS1
    getAddressList().getMemoryRecordByDescription('Z').Value = ZCoordS1
  end

  if SavSlot == 2 then
    getAddressList().getMemoryRecordByDescription('X').Value = XCoordS2
    getAddressList().getMemoryRecordByDescription('Y').Value = YCoordS2
    getAddressList().getMemoryRecordByDescription('Z').Value = ZCoordS2
  end

  if SavSlot == 3 then
    getAddressList().getMemoryRecordByDescription('X').Value = XCoordS3
    getAddressList().getMemoryRecordByDescription('Y').Value = YCoordS3
    getAddressList().getMemoryRecordByDescription('Z').Value = ZCoordS3
  end
end

[DISABLE]
CoordForm.Hide()
