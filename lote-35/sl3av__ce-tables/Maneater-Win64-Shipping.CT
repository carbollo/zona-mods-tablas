[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscanmodule(health,Maneater-Win64-Shipping.exe,F3 0F 10 41 0C C3) // should be unique
aobscanmodule(addrcmp,Maneater-Win64-Shipping.exe,48 8B 5C 24 40 0F 2F F0) // should be unique

alloc(newmem,$1000,health)

label(code)
label(return)

newmem:
code:
  push rbx
  mov rbx, addrcmp
  cmp [rsp+8], rbx
  pop rbx
  jne @F

  mov [rcx+08], (float)999.0

@@:
  movss xmm0, [rcx+0C]
  jmp return

health:
  jmp newmem
return:
registersymbol(health)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
health:
  db F3 0F 10 41 0C

unregistersymbol(health)
dealloc(newmem)

