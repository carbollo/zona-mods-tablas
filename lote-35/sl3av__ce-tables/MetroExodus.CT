registersymbol(_UndoPos)
registersymbol(_pCoords)
registersymbol(_PlayerCoords)
Registersymbol(_TeleToEnemy)
registersymbol(_pCoordBaseTot)
registersymbol(_CoordBase)



TeleportMem:
push rbx
lea rbx,[r11-30]
cmp rbx,[_pCoordBaseTot]
jne codeTeleport
mov [_pCoords],r11
cmp [_SavePos],1
je Save
cmp [_LoadPos],1
je Load
cmp [_UndoPos],1
je Undo
cmp [_TeleToEnemy],1
je EnemyTele
jmp codeTeleport


Save:
mov [_SavePos],0
movss xmm12,[r11+10]
movss [X_Pos],xmm12
movss xmm12,[r11+14]
movss [Y_Pos],xmm12
movss xmm12,[r11+18]
movss [Z_Pos],xmm12
jmp codeTeleport


Load:
mov [_LoadPos],0
movss xmm11,[r11+10]
movss [X_Pos_Undo],xmm11
movss xmm11,[r11+14]
movss [Y_Pos_Undo],xmm11
movss xmm11,[r11+18]
movss [Z_Pos_Undo],xmm11

movss xmm12,[X_Pos]
movss [r11+10],xmm12
movss xmm12,[Y_Pos]
movss [r11+14],xmm12
movss xmm12,[Z_Pos]
movss [r11+18],xmm12
jmp codeTeleport

Undo:
mov [_UndoPos],0
movss xmm11,[X_Pos_Undo]
movss [r11+10],xmm11
movss xmm11,[Y_Pos_Undo]
movss [r11+14],xmm11
movss xmm11,[Z_Pos_Undo]
movss [r11+18],xmm11
jmp codeTeleport

EnemyTele:
mov [_TeleToEnemy],0
movss xmm12,[_Enemy_X]
movss [r11+10],xmm12
movss xmm12,[_Enemy_Y]
movss [r11+14],xmm12
movss xmm12,[_Enemy_Z]
movss [r11+18],xmm12
jmp codeTeleport

codeTeleport:
  pop rbx
  mov eax,[r11+10]
  mov [r8-08],eax
  jmp returnTeleport


CoordBaseMem:
  mov rax,[rcx]
  mov [_pCoordBaseTot],rbx
  cmp byte ptr [rax+00001FD9],00
  jmp returnCoordBase



_PlayerCoords:
  jmp TeleportMem
  nop
  nop
  nop
returnTeleport:

_CoordBase-54:
  jmp CoordBaseMem
  nop
  nop
  nop
  nop
  nop
returnCoordBase:

_pCoords:
dd 0
X_Pos:
dd 0
Y_Pos:
dd 0
Z_Pos:
dd 0
X_Pos_Undo:
dd 0
Y_Pos_Undo:
dd 0
Z_Pos_Undo:
