_UndoPos:
dd 0
_TeleToEnemy:
dd 0
_pCoordBaseTot:
dq 0
_Enemy_X:
dd 0
_Enemy_Y:
dd 0
_Enemy_Z:
dd 0
_TeleRandomEnemyToLastSavedPos:
dd 0

[DISABLE]

_PlayerCoords:
  db 41 8B 43 10 41 89 40 F8
_CoordBase-54:
  db 48 8B 01 80 B8 D9 1F 00 00 00
