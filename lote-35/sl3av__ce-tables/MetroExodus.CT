globalalloc(TeleportMem,$3000,physx3_x64.dll)
alloc(_pCoords,8)
alloc(_SavePos,8)
alloc(_LoadPos,8)
alloc(_UndoPos,8)
alloc(_TeleToEnemy,8)
alloc(X_Pos,8)
alloc(Y_Pos,8)
alloc(Z_Pos,8)
alloc(X_Pos_Undo,8)
alloc(Y_Pos_Undo,8)
alloc(Z_Pos_Undo,8)
alloc(_pCoordBaseTot,8)
alloc(_Enemy_X,8)
alloc(_Enemy_Y,8)
alloc(_Enemy_Z,8)
