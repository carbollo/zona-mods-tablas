            <CheatEntry>
              <ID>26508</ID>
              <Description>"[Game Progression] Change Normal &lt;-&gt; NG+"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$STRICT}

{$lua}

if syntaxcheck then return end

[ENABLE]

local isInGame = messageDialog( 'Are you in game world (not at main menu)?', mtConfirmation, mbYes, mbNo )
if isInGame == 0x7 then end
local gametype = inputQuery( '', 'Type: 0 - normal; 1 - NG+', '1' )
gametype = tonumber( gametype, 10 )
if gametype then
  local sym_g_GameModule = getAddressSafe( "g_GameModule" )
  if sym_g_GameModule == nil then end
    GameModule = readQword( sym_g_GameModule )
    if GameModule == 0x0 then end
      writeBytes( GameModule + 0xA78, gametype )
      messageDialog( "Now Quick Save at a Campfire, then hit Esc, RESTART FROM SAVE.", mtInformation, mbOK )
end
return "assert(true)"

[DISABLE]
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>26529</ID>
              <Description>"[Existing Inventory] Inventory Editor"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$STRICT}

{$lua}

if syntaxcheck then return end

[ENABLE]

local memRecIds = {}
local addressList = getAddressList()
local memRec = addressList.getMemoryRecordByID( "26529" ) -- gets "[I &gt; Modifications &gt; Click Item &gt; R, then Esc &gt; E] Coil|Weave Dupe" memory record
if memRec.Count ~= 0x0 then
  for i = 1, memRec.Count - 1 do
    table.insert( memRecIds, memoryrecord_getID( memRec.Child[i] ) )
  end
  for _, v in pairs( memRecIds ) do
    local mr = addresslist_getMemoryRecordByID( addressList, v )
    if mr ~= nil then memoryrecord_delete( mr ) end
  end
end

local sym_LocalPlayer = getAddressSafe( "LocalPlayer" )
if sym_LocalPlayer == nil then end
LocalPlayer = readQword( sym_LocalPlayer )
if LocalPlayer == 0x0 then end
local PlayerEntity = readQword( LocalPlayer + 0x70 )
if PlayerEntity == 0x0 then end

local HumanoidInventory = FindNamedComponentByRTTIClass( PlayerEntity + 0x288, "HumanoidInventory" )
if HumanoidInventory == 0x0 then end

InventoryEntitiesTable = HumanoidInventory + 0x60
InventoryEntitiesTableSize = readInteger( HumanoidInventory + 0x58 )
ArrayStart = readQword( InventoryEntitiesTable )
ArrayEnd = ArrayStart + ( InventoryEntitiesTableSize - 1 ) * 8

local filter = inputQuery( 'Want to find only a specific Item?', 'Filter:', '' )

if filter ~= nil then

  -- filtered run-down
  -- process each InventoryEntity
  local i = 0
  for i = ArrayStart, ArrayEnd, 8 do

    local InventoryEntity = readQword( i )

    local InventoryItemComponent = FindNamedComponentByRTTIClass( InventoryEntity + 0x288, "InventoryItemComponent" )

    local Price = 0x0
    local ItemPriceInfo = 0x0
    if InventoryItemComponent ~= 0x0 then
      local InventoryItemComponentResource = readQword( InventoryItemComponent + 0x30 )
      p_Name = readQword( InventoryItemComponentResource + 0x28 )
      InventoryItemComponentName = readQword( p_Name + 0x20 )
      dw_Size = readInteger( p_Name + 0x28 )
      sz_ItemName = readString( InventoryItemComponentName, dw_Size )
      ItemPriceInfo = readQword( InventoryItemComponentResource + 0x38 )
      local dwPrice = 0
      if ItemPriceInfo ~= 0x0 then
        Price = ItemPriceInfo + 0x2C
      end
    end

    local lsz_ItemName = string.lower( sz_ItemName )
    local found = string.find( lsz_ItemName, filter )

    if found ~= nil then

      local StackableComponent = FindNamedComponentByRTTIClass( InventoryEntity + 0x288, "StackableComponent" )

      local Quantity = 0x0
      local StackQuantity = 0x0
      if StackableComponent ~= 0x0 then
        local StackableComponentResource = readQword( StackableComponent + 0x30 )
        Quantity = StackableComponent + 0x58
        StackQuantity = StackableComponentResource + 0x30
      end

      if InventoryItemComponent ~= 0x0 then

        ir = addressList.createMemoryRecord()
        ir.appendToEntry( memRec )
        ir.Type = vtQword
        ir.setAddress( i )
        ir.ShowAsHex = true
        ir.DontSave = true
        ir.setDescription( sz_ItemName )

        if ItemPriceInfo ~= 0x0 then
          pr = addressList.createMemoryRecord()
          pr.appendToEntry( ir )
          pr.Parent = ir
          pr.setDescription( "Price" )
          pr.setAddress( Price )
          pr.Type = vtDword
          pr.DontSave = true
        end

        if Quantity ~= 0x0 then
          qr = addressList.createMemoryRecord()
          qr.appendToEntry( ir )
          qr.Parent = ir
          qr.setDescription( "Quantity" )
          qr.setAddress( Quantity )
          qr.Type = vtDword
          qr.DontSave = true
        end

        if StackQuantity ~= 0x0 then
          sr = addressList.createMemoryRecord()
          sr.appendToEntry( ir )
          sr.Parent = ir
          sr.setDescription( "Stack Quantity" )
          sr.setAddress( StackQuantity )
          sr.Type = vtDword
          sr.DontSave = true
        end

        -- Item
        ir.Options = "[moManualExpandCollapse, moAllowManualCollapseAndExpand]"
        ir.Collapsed = true

      end
      break

    end
    processMessages()

  end

else

  -- normal run-down, all
  -- process each InventoryEntity
  local i = 0
  for i = ArrayStart, ArrayEnd, 8 do

    local InventoryEntity = readQword( i )

    local InventoryItemComponent = FindNamedComponentByRTTIClass( InventoryEntity + 0x288, "InventoryItemComponent" )
    local StackableComponent = FindNamedComponentByRTTIClass( InventoryEntity + 0x288, "StackableComponent" )

    local Price = 0x0
    local ItemPriceInfo = 0x0
    if InventoryItemComponent ~= 0x0 then
      local InventoryItemComponentResource = readQword( InventoryItemComponent + 0x30 )
      p_Name = readQword( InventoryItemComponentResource + 0x28 )
      InventoryItemComponentName = readQword( p_Name + 0x20 )
      dw_Size = readInteger( p_Name + 0x28 )
      sz_ItemName = readString( InventoryItemComponentName, dw_Size )
      ItemPriceInfo = readQword( InventoryItemComponentResource + 0x38 )
      local dwPrice = 0
      if ItemPriceInfo ~= 0x0 then
        Price = ItemPriceInfo + 0x2C
      end
    end

    local Quantity = 0x0
    local StackQuantity = 0x0
    if StackableComponent ~= 0x0 then
      local StackableComponentResource = readQword( StackableComponent + 0x30 )
      Quantity = StackableComponent + 0x58
      StackQuantity = StackableComponentResource + 0x30
    end

    if InventoryItemComponent ~= 0x0 then
      ir = addressList.createMemoryRecord()
      ir.appendToEntry( memRec )
      ir.Type = vtQword
      ir.setAddress( i )
      ir.ShowAsHex = true
      ir.DontSave = true
      ir.setDescription( sz_ItemName )
    end

    if ItemPriceInfo ~= 0x0 then
      pr = addressList.createMemoryRecord()
      pr.appendToEntry( ir )
      pr.setDescription( "Price" )
      pr.setAddress( Price )
      pr.Type = vtDword
      pr.DontSave = true
    end

    if Quantity ~= 0x0 then
      qr = addressList.createMemoryRecord()
      qr.appendToEntry( ir )
      qr.setDescription( "Quantity" )
      qr.setAddress( Quantity )
      qr.Type = vtDword
      qr.DontSave = true
    end

    if StackQuantity ~= 0x0 then
      sr = addressList.createMemoryRecord()
      sr.appendToEntry( ir )
      sr.setDescription( "Stack Quantity" )
      sr.setAddress( StackQuantity )
      sr.Type = vtDword
      sr.DontSave = true
    end

    -- Item
    ir.Options = "[moManualExpandCollapse, moAllowManualCollapseAndExpand]"
    ir.Collapsed = true
    processMessages()

  end

end
messageDialog( "Done.", mtInformation, mbOK )

[DISABLE]

local memRecIds = {}
local addressList = getAddressList()
local memRec = addressList.getMemoryRecordByID( "26529" ) -- gets "[I &gt; Modifications &gt; Click Item &gt; R, then Esc &gt; E] Coil|Weave Dupe" memory record
if memRec.Count ~= 0x0 then
  for i = 1, memRec.Count - 1 do
    table.insert( memRecIds, memoryrecord_getID( memRec.Child[i] ) )
  end
  for _, v in pairs( memRecIds ) do
    local mr = addresslist_getMemoryRecordByID( addressList, v )
    if mr ~= nil then memoryrecord_delete( mr ) end
  end
end
