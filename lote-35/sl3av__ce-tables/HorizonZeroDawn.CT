              <Description>"[Player] Set Current Level"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$STRICT}

{$lua}

if syntaxcheck then return end

[ENABLE]

local level = inputQuery( '', 'Level:', '' )
level = tonumber( level, 10 )
if level then
  local sym_LocalPlayer = getAddressSafe( "LocalPlayer" )
  if sym_LocalPlayer == nil then end
    LocalPlayer = readQword( sym_LocalPlayer )
    if LocalPlayer == 0x0 then end
      local Entity = readQword( LocalPlayer + 0x70 )
      if Entity == 0x0 then end
        local CharacterProgressionComponent = FindNamedComponentByRTTIClass( Entity + 0x288, "CharacterProgressionComponent" )
        if CharacterProgressionComponent == 0x0 then end
          local CharacterProgressionComponent_SetCurrentLevel = getAddressSafe( "CharacterProgressionComponent_SetCurrentLevel" )
          executeCodeEx( 0, nil, CharacterProgressionComponent_SetCurrentLevel, CharacterProgressionComponent, level )
end
return "assert(true)"

