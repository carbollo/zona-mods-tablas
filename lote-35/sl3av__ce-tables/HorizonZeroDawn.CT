    shr eax,1
    and al,1
    test al,al
    setne al
    mov dl,al
    call HorizonZeroDawn.exe+BB7700 // Entity_SetVisible

    mov rcx,C8
    call Sleep

  @@:
  jmp KeyHandlerThread_loop

align 10 CC

