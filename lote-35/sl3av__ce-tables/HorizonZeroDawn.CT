              <AssemblerScript>{$STRICT}

{$lua}

if syntaxcheck then return end

[ENABLE]

local sym_LocalPlayer = getAddressSafe( "LocalPlayer" )
if sym_LocalPlayer == nil then end
LocalPlayer = readQword( sym_LocalPlayer )
if LocalPlayer == 0x0 then end
local PlayerEntity = readQword( LocalPlayer + 0x70 )
if PlayerEntity == 0x0 then end
local LastPickedUpItem = readQword( PlayerEntity + 0x1D0 )
if LastPickedUpItem == 0x0 then end

local offset_ComponentsTable = 0x290
local offset_ComponentsTableSize = 0x288
local ComponentsTable = PlayerEntity + offset_ComponentsTable
local ComponentsTableSize = readInteger( PlayerEntity + offset_ComponentsTableSize )
local ArrayStart = readQword( ComponentsTable )
local ArrayEnd = ArrayStart + ( ComponentsTableSize - 1 ) * 8

local HumanoidInventory = 0x0

for i = ArrayStart, ArrayEnd, 8 do
  local PlayerEntityComponent = readQword( i )
  local vftable = readQword( PlayerEntityComponent )
  local GetRTTIClass = readQword( vftable + 0x0 )
  local RTTIClass = executeCodeEx( 0, nil, GetRTTIClass )
  local Name = readQword( RTTIClass + 0x38 )
  if readString( Name ) == "HumanoidInventory" then
    HumanoidInventory = PlayerEntityComponent
	break
  end
end

if HumanoidInventory == 0x0 then end

offset_InventoryEntitiesTable = 0x60
offset_InventoryEntitiesTableSize = 0x58
InventoryEntitiesTable = HumanoidInventory + offset_InventoryEntitiesTable
InventoryEntitiesTableSize = readInteger( HumanoidInventory + offset_InventoryEntitiesTableSize )
ArrayStart = readQword( InventoryEntitiesTable )
ArrayEnd = ArrayStart + ( InventoryEntitiesTableSize - 1 ) * 8

local al = getAddressList()
local mr = al.getMemoryRecordByID( "26530" ) -- gets "[I &gt; Modifications &gt; Click Item &gt; R, then Esc &gt; E] Coil|Weave Dupe" memory record
if mr.Count ~= 0x0 then
  for i = 0, mr.Count - 1 do
    mr.Child[0].destroy()
  end
end
-- LastPickedUpItem
lr = al.createMemoryRecord()
lr.appendToEntry( mr )
lr.setDescription( "LastPickedUpItem" )
lr.Type = vtQword
lr.setAddress( PlayerEntity + 0x1D0 )
lr.ShowAsHex = true
lr.DontSave = true
-- Inventory
ir = al.createMemoryRecord()
ir.appendToEntry( mr )
ir.setDescription( "HumanoidInventory" )
ir.Type = vtQword
ir.setAddress( HumanoidInventory )
ir.ShowAsHex = true
ir.DontSave = true
-- InventoryEntity
cr = al.createMemoryRecord()
cr.appendToEntry( ir )
cr.setDescription( "p-&gt;InventoryEntities" )
cr.Type = vtQword
cr.setAddress( HumanoidInventory + offset_InventoryEntitiesTable )
cr.ShowAsHex = true
cr.DontSave = true
szr = al.createMemoryRecord()
szr.appendToEntry( ir )
szr.setDescription( "NumInventoryEntities" )
szr.Type = vtDword
szr.setAddress( HumanoidInventory + offset_InventoryEntitiesTableSize )
szr.DontSave = true
-- LastInventoryEntity+1
writeQword( ArrayEnd + 0x8, 0 )
ler = al.createMemoryRecord()
ler.appendToEntry( ir )
ler.setDescription( "LastInventoryEntity+1" )
ler.Type = vtQword
ler.setAddress( ArrayEnd + 0x8 )
ler.ShowAsHex = true
ler.DontSave = true

