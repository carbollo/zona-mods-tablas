{$asm}
registersymbol( KeyHandlerThread )
CreateThread( KeyHandlerThread )
label( KeyHandlerOff )
registersymbol( KeyHandlerOff )
label( KeyHandlerThread_loop )
label( KeyHandlerThread_back )

label( FindComponentByRTTIClassName )
label( FindComponentByRTTIClassName_exit )
label( ResetTimer )

KeyHandlerThread:
sub rsp,28

KeyHandlerThread_loop:
mov rcx,A
call Sleep

cmp [KeyHandlerOff],1
jne short @f
  add rsp,28
  mov [KeyHandlerOff],2
  ret
@@:

  // VK_NUMPAD.
  mov rcx,6E
  call GetAsyncKeyState
  test ax,ax
  je KeyHandlerThread_back

    xor ecx,ecx
    call GetLocalPlayer
    mov rcx,rax
    mov rcx,[rcx+D0]                       // GameViewGame
    mov rcx,[rcx+350]                      // HUD
    lea rcx,[rcx+128]                      // table_size
    call short FindComponentByRTTIClassName
    test rax,rax                           // if HUDCountdownTimerLogic == NULL
    je short @f                            // exit

      mov rcx,[rax+60]                     // CountdownTimer
      test rcx,rcx                         // if CountdownTimer == NULL
      je short @f                          // exit

        // ResetTimer
        call short ResetTimer

    @@:
    mov rcx,C8
    call Sleep

  KeyHandlerThread_back:
  jmp KeyHandlerThread_loop

align 10 CC

FindComponentByRTTIClassName:
  sub rsp,28
  mov rbx,[rcx+8]              // table_start
  movsx rax,[rcx]              // size
  lea rdi,[rbx+rax*8]          // table_end
  @@:
  cmp rbx,rdi                  // if current step == table_end
  je short FindComponentByRTTIClassName_exit  // exit
    mov rcx,[rbx]
    mov rsi,rcx
    mov rax,[rcx]
    call [rax]                 // GetName
    add rbx,8
    mov rcx,[rax+38]           // RTTIClass-&gt;Name
    lea rdx,[szHUDCountdownTimerLogic] // "HUDCountdownTimerLogic"
    call strcmp
    test eax,eax
    jne short @b
      mov rax,rsi
      add rsp,28
      ret
  FindComponentByRTTIClassName_exit:
  xor rax,rax
  add rsp,28
  ret

align 10 CC

ResetTimer:
test rcx,rcx
je short @f
  cmp qword ptr [rcx+40],0
  je short @f
    mov rax,[rcx+20]
    test rax,rax
    je short @f
      mov [rax+1C],0
@@:
ret

align 10 CC

szHUDCountdownTimerLogic:
db 'HUDCountdownTimerLogic',0

align 10 CC

