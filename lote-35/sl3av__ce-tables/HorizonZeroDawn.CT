            <CheatEntry>
              <ID>26504</ID>
              <Description>"[Trials] Reset Trial Timer To 00:00"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$STRICT}

{$lua}

if syntaxcheck then return end

[ENABLE]

local LocalPlayer = readQword( getAddressSafe( "LocalPlayer" ) )
local GameViewGame = readQword( LocalPlayer + 0xD0 )
local HUD = readQword( GameViewGame + 0x350 )
local HUDCountdownTimerLogic = executeCodeEx( 0, nil, FindNamedComponentByRTTIClass, HUD + 0x128, "HUDCountdownTimerLogic" )
if HUDCountdownTimerLogic ~= 0x0 then
  local CountdownTimer = readQword( HUDCountdownTimerLogic + 0x60 )
  if CountdownTimer ~= 0x0 then
    executeCodeEx( 0, nil, ResetTimer, CountdownTimer )
  end
end
return "assert(true)"

[DISABLE]
</AssemblerScript>
