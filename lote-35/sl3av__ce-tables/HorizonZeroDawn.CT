      <AssemblerScript>{$lua}

if syntaxcheck then return end

[ENABLE]

function cycleFullCompact( sender, force )
  local state = not( compactmenuitem.Caption == 'Compact View Mode' )
  if force ~= nil then
    state = not force
  end
  compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
  getMainForm().Splitter1.Visible = state
  getMainForm().Panel4.Visible = state
  getMainForm().Panel5.Visible = state
end

function addCompactMenu()
  if compactmenualreadyexists then return end
    local parent = getMainForm().Menu.Items
    compactmenuitem = createMenuItem( parent )
    parent.add( compactmenuitem )
    compactmenuitem.Caption = 'Compact View Mode'
    compactmenuitem.OnClick = cycleFullCompact
    compactmenualreadyexists = 'yes'
end

addCompactMenu()
cycleFullCompact( nil, true )
return "assert (true)"

[DISABLE]

cycleFullCompact( nil, false )
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>25470</ID>
      <Description>"[ Enable ]"</Description>
      <Options moHideChildren="1"/>
      <LastState Activated="1"/>
      <Color>A96974</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{$STRICT}

{$lua}

if syntaxcheck then return end

function stopExec( s )
  error( string.format( "\r\n&gt;&gt; %s &lt;&lt;", s ) )
end

function aobScanEx( aob )
  -- thanks panraven for this function!
  -- https://forum.cheatengine.org/viewtopic.php?t=577536
  -- simplified for my needs
  local p, a, n, s, e = nil or '*X*W', nil or fsmNotAligned, nil or '0', getAddress( process ) or 0x0, ( getAddress( process ) + getModuleSize( process ) ) or 0xffffffffffffffff
  local ms = pb and createMemScan( pb ) or createMemScan()
  local fl = createFoundList( ms )
  ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
  ms.waitTillDone()
  fl.initialize()
  local result = nil
  if fl ~= nil and fl.getCount() &gt; 0 then
    result = createStringlist()
    for i = 1, fl.getCount() do result.add( fl.getAddress( i - 1 ) ) end
  end
  fl.destroy()
  ms.destroy()
  return result
end

function string.fromhex( s )
    return ( s:gsub( '..', function ( cc )
        return string.char( tonumber( cc, 16 ) )
    end ) )
end

function aobScanSmall( aob, s, e )
  local i = byteTableToString( readBytes( s, e, true ) ):find( string.fromhex( aob ), 1, true )
  if i == nil then i = 1 end
  return ( s + i - 1 )
end

function getAssemblySpot()
  local start = getAddressSafe( "CodeCave" )
  local addr = aobScanSmall( "DEADC0DE00", start, 0xB00 )
  if addr ~= start then
    local pad = { 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC }
    writeBytes( addr + 0x4, pad )
    addr = addr + 0x10
  end
  return addr
end

function GetRTTIClass( p )
  return executeCodeEx( 0, nil, readQword( readQword( p ) ) ) or 0
end

function FindNamedComponentByRTTIClass( p, s )
  local r = 0
  local ComponentsArray = p + 0x8
  local ComponentsArraySize = readInteger( p ) - 0x1 -- to skip the NULL ptr at the end of table
  local ArrayStart = readQword( ComponentsArray )
  local ArrayEnd = ArrayStart + ComponentsArraySize * 8
  for i = ArrayStart, ArrayEnd, 8 do
    local Component = readQword( i )
    local RTTIClass = GetRTTIClass( Component )
    local Name = readString( readQword( RTTIClass + 0x38 ) )
    if Name == s then
      r = Component
      break
    end
  end
  return r
end

function Init()

  local sl, t, u = 0, 0, 0

  -- get BuildId

  local aob_BuildId = "BA????????488D4C24??488BF8E8"
  sl = aobScanEx( aob_BuildId )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_BuildId' not found." ) end
  t = tonumber( sl[0], 16 )
  t = aobScanSmall( "488D15", t, 0x100 )
  local Build = readString( t + readInteger( t + 0x3, true ) + 0x7, 60000 )
  t = aobScanSmall( "488BCB4C8D05", t + 0x1, 0x100 ) + 0x3
  local Id = readString( t + readInteger( t + 0x3, true ) + 0x7, 60000 )
  local BuildId = string.format( "%s / %s", Build, Id )

  local TableBuildId = addresslist_getMemoryRecord( getAddressList(), 1 )
  TableBuildId = memoryrecord_getDescription( TableBuildId )
  TableBuildId = string.match( TableBuildId, '[[](.*)[]]' )

  if TableBuildId == BuildId then

    -- cave stuff

  local moduleBase = getAddressSafe( process )
  local offset = 0x500
  t = moduleBase + offset
  fullAccess( t, 0x1000 - offset )
  executeCodeEx( 0, nil, getAddressSafe( "RtlZeroMemory" ), t, 0x1000 - offset )
  unregisterSymbol( "CodeCave" )
  registerSymbol( "CodeCave", t, true )

  -- scan time!

  local aob_g_Application = "488D0D????????E8????????84C074??488D0D????????E8????????48"
  sl = aobScanEx( aob_g_Application )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_g_Application' not found." ) end
  t = tonumber( sl[0], 16 )
  t = t + readInteger( t + 0x3, true ) + 0x7
  unregisterSymbol( "g_Application" )
  registerSymbol( "g_Application", t, true )

  u = t + 0xF38
  unregisterSymbol( "g_GameModule" )
  registerSymbol( "g_GameModule", u, true )

  u = t + 0xF40
  unregisterSymbol( "g_MenuModule" )
  registerSymbol( "g_MenuModule", u, true )

  u = t + 0xF48
  unregisterSymbol( "g_GameState" )
  registerSymbol( "g_GameState", u, true )

  u = t + 0xF50
  unregisterSymbol( "g_PlayerProfile" )
  registerSymbol( "g_PlayerProfile", u, true )

  u = t + 0xF58
  unregisterSymbol( "g_DebugSettings" )
  registerSymbol( "g_DebugSettings", u, true )

  u = t + 0xF60
  unregisterSymbol( "g_PlayerRanksResource" )
  registerSymbol( "g_PlayerRanksResource", u, true )

  u = t + 0xF68
  unregisterSymbol( "g_TrophySystem" )
  registerSymbol( "g_TrophySystem", u, true )

  u = t + 0xF70
  unregisterSymbol( "g_NetManagerGame" )
  registerSymbol( "g_NetManagerGame", u, true )

  local aob_g_Viewport = "48833D????????000F84????????488379??000F"
  sl = aobScanEx( aob_g_Viewport )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_g_Viewport' not found." ) end
  t = tonumber( sl[0], 16 )
  t = t + readInteger( t + 0x3, true ) + 0x8
  unregisterSymbol( "g_Viewport" )
  registerSymbol( "g_Viewport", t, true )

  local aob_CharacterProgressionComponent_SetCurrentLevel = "4883EC??488B41??4C8BC9488B40??4885C0"
  sl = aobScanEx( aob_CharacterProgressionComponent_SetCurrentLevel )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_CharacterProgressionComponent_SetCurrentLevel' not found." ) end
  t = tonumber( sl[0], 16 )
  unregisterSymbol( "CharacterProgressionComponent_SetCurrentLevel" )
  registerSymbol( "CharacterProgressionComponent_SetCurrentLevel", t, true )

  local aob_CountdownTimer_StartTimer = "4885C90F84????????534883EC??488379??00488BD974"
  sl = aobScanEx( aob_CountdownTimer_StartTimer )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_CountdownTimer_StartTimer' not found." ) end
  t = tonumber( sl[0], 16 )
  unregisterSymbol( "CountdownTimer_StartTimer" )
  registerSymbol( "CountdownTimer_StartTimer", t, true )

  local aob_CountdownTimer_PauseTimer = "4885C974??534883EC??488379??00488BD974??48" -- 2 identical results
  sl = aobScanEx( aob_CountdownTimer_PauseTimer )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_CountdownTimer_PauseTimer' not found." ) end
  t = tonumber( sl[0], 16 )
  unregisterSymbol( "CountdownTimer_PauseTimer" )
  registerSymbol( "CountdownTimer_PauseTimer", t, true )

  local aob_GetLocalPlayer = "48895C24??48896C24??48897424??574883EC??4863E985C90F85"
  sl = aobScanEx( aob_GetLocalPlayer )
  if not sl or sl.Count &lt; 1 then stopExec( "'aob_GetLocalPlayer' not found." ) end
  t = tonumber( sl[0], 16 )
  unregisterSymbol( "GetLocalPlayer" )
  registerSymbol( "GetLocalPlayer", t, true )

  t = aobScanSmall( "33C0488B5C24", t, 0x200 ) + 0x2
  unregisterSymbol( "hk_GetLocalPlayer" )
  registerSymbol( "hk_GetLocalPlayer", t, true )

  local get_LocalPlayer = getAssemblySpot()
  unregisterSymbol( "get_LocalPlayer" )
  registerSymbol( "get_LocalPlayer", get_LocalPlayer, true )

  u = string.format( "%X", t )

  autoAssemble([[

    label( LocalPlayer )
    registersymbol( LocalPlayer )

    get_LocalPlayer:
    readmem( ]]..u..[[, 5 )
    mov [LocalPlayer],rax
    jmp hk_GetLocalPlayer+5

    align 10 CC

    LocalPlayer:
    dq 0

    align 10 CC

    db DE AD C0 DE

    ]]..u..[[:
    jmp get_LocalPlayer

  ]])

  else

    showMessage( "This table is designed for BuildId: \r\n&gt;&gt; " .. TableBuildId .. "\r\n\r\nYours is: \r\n&gt;&gt; " .. BuildId .. "\r\n\r\nTable version doesn't match the current game version. Good luck, bitch!" )
    return "assert(true)"

  end

end

[ENABLE]

return Init()

[DISABLE]

autoAssemble([[

  hk_GetLocalPlayer:
  readmem( get_LocalPlayer, 5 )

  unregistersymbol( LocalPlayer )
  unregistersymbol( get_LocalPlayer )
  unregistersymbol( hk_GetLocalPlayer )
  unregistersymbol( GetLocalPlayer )

  unregistersymbol( g_Viewport )
  unregistersymbol( g_NetManagerGame )
  unregistersymbol( g_TrophySystem )
  unregistersymbol( g_PlayerRanksResource )
  unregistersymbol( g_DebugSettings )
  unregistersymbol( g_PlayerProfile )
  unregistersymbol( g_GameState )
  unregistersymbol( g_MenuModule )
  unregistersymbol( g_GameModule )
  unregistersymbol( g_Application )

]])

local t = getAddressSafe( "CodeCave" )
executeCodeEx( 0, nil, getAddressSafe( "RtlZeroMemory" ), t, 0xB00 )
unregisterSymbol( "CodeCave" )
