{$lua}

if syntaxcheck then return end

function ResetTimer( CountdownTimer )
  if CountdownTimer ~= 0x0 then
    if readQword( CountdownTimer + 0x40 ) ~= 0x0 then
      local CountdownTimerSave = readQword( CountdownTimer + 0x20 )
      if CountdownTimerSave ~= 0x0 then
        writeInteger( CountdownTimerSave + 0x1C, 0 )
      end
    end
  end
end

[ENABLE]

local sym_LocalPlayer = getAddressSafe( "LocalPlayer" )
if sym_LocalPlayer == nil then end
local LocalPlayer = readQword( sym_LocalPlayer )
if LocalPlayer == 0x0 then end
local GameViewGame = readQword( LocalPlayer + 0xD0 )
if GameViewGame == 0x0 then end
local HUD = readQword( GameViewGame + 0x350 )
if HUD == 0x0 then end
local HUDCountdownTimerLogic = FindNamedComponentByRTTIClass( HUD + 0x128, "HUDCountdownTimerLogic" )
if HUDCountdownTimerLogic ~= 0x0 then
  local CountdownTimer = readQword( HUDCountdownTimerLogic + 0x60 )
  if CountdownTimer ~= 0x0 then
    local StartTimer = getAddressSafe( "CountdownTimer_StartTimer" )
    StartTimer = string.format( "%X", StartTimer )
    autoAssemble([[
    ]]..StartTimer..[[:
    db C3 // ret
    nop 2
    ]])
    local PauseTimer = getAddressSafe( "CountdownTimer_PauseTimer" )
    executeCodeEx( 0, nil, PauseTimer, CountdownTimer )
    ResetTimer( CountdownTimer )
  end
end

[DISABLE]

local StartTimer = getAddressSafe( "CountdownTimer_StartTimer" )
StartTimer = string.format( "%X", StartTimer )
autoAssemble([[
]]..StartTimer..[[:
db 48 85 C9 // test rcx,rcx
]])
</AssemblerScript>
