        <CheatEntry>
          <ID>213</ID>
          <Description>"Populate FloatPlayerVariable"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end

function doWork()
  local record = AddressList.getMemoryRecordByDescription("FloatPlayerVariable")
  for offset, name in offsets:gmatch("%w+=\"(%x+)\" %w+=\"(%w+)\"") do
    local child = AddressList.createMemoryRecord()
    local addr = tonumber(offset,16)
    addr = "+" .. string.format("%X", addr+0x08)
    child.setAddress(addr)
    child.setDescription(name)
    child.Type = vtSingle
    child.appendToEntry(record)
  end
end

