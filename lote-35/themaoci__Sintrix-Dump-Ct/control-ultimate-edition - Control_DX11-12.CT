                <CheatEntry>
                  <ID>1337142590</ID>
                  <Description>"Teleport menu"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

tpm_s = getAddressList().getMemoryRecordByDescription('Teleport menu')

local filePath = getCheatEngineDir() .. "Control_locations.txt" --adjust this each title
local xCord=getAddressSafe('[pCords]+90')
local zCord=getAddressSafe('[pCords]+98')
local yCord=getAddressSafe('[pCords]+94')

[ENABLE]

-- Main form setup
tpFRM = createForm(false)
tpFRM.Caption = "Teleport Menu"
tpFRM.Width = 300
tpFRM.Height = 45
tpFRM.Position = 'poScreenCenter'
tpFRM.Color = 0x000000 tpFRM.AlphaBlend = true tpFRM.AlphaBlendValue = 200
tpFRM.BorderStyle = 'bsDialog'

local defaultLocations = [[
--add default locations here
]]

local function createLocationsFile() if not fileExists(filePath) then local file = io.open(filePath, "w") if file then file:write(defaultLocations) file:close() end end end createLocationsFile()
local function readLocationsFromFile() local locations = {} if fileExists(filePath) then for line in io.lines(filePath) do local name, x, y, z = line:match("([^,]+),([^,]+),([^,]+),([^,]+)") if name and x and y and z then table.insert(locations, {name = name, x = tonumber(x), y = tonumber(y), z = tonumber(z)}) end end end return locations end
local function saveLocation(name, x, y, z) local file = io.open(filePath, "a") if file then file:write(string.format("%s,%.3f,%.3f,%.3f\n", name, x, y, z)) file:close() else print("Failed to open file: " .. filePath) end end

--Init vals
local coordx = 0 local coordy = 0 local coordz = 0

local locations = readLocationsFromFile()
local TeleportSelectiondropdown = createComboBox(tpFRM)
TeleportSelectiondropdown.Left = 1
TeleportSelectiondropdown.Top = 20
TeleportSelectiondropdown.Width = 150
TeleportSelectiondropdown.Height = 25
for _, loc in ipairs(locations) do TeleportSelectiondropdown.Items.add(loc.name) end

local TeleportSelectionEditor = createCheckBox(tpFRM)
TeleportSelectionEditor.Caption = 'Edit Dropdown Menu'
TeleportSelectionEditor.Left = 5
TeleportSelectionEditor.Top = TeleportSelectiondropdown.Top - 20
TeleportSelectionEditor.Width = 150
TeleportSelectionEditor.Height = 20
TeleportSelectionEditor.onClick=function()
  shellExecute(filePath)
  TeleportSelectionEditor.Checked=false
end

local TeleportButton = createButton(tpFRM)
TeleportButton.Caption = "Teleport"
TeleportButton.Left = TeleportSelectiondropdown.Left + TeleportSelectiondropdown.Width
TeleportButton.Top = TeleportSelectiondropdown.Top - 1
TeleportButton.Width = 75
TeleportButton.Height = 25
TeleportButton.OnClick = function()
    local selectedIndex = TeleportSelectiondropdown.ItemIndex
    if selectedIndex &gt;= 0 then
        locations = readLocationsFromFile()
        local loc = locations[selectedIndex + 1]
        if loc then
            writeFloat(xCord, loc.x)
            writeFloat(yCord, loc.y)
            writeFloat(zCord, loc.z)
        end
    end
end

-- Save location button
local TeleportSaveButton = createButton(tpFRM)
TeleportSaveButton.Caption = "Save"
TeleportSaveButton.Left = TeleportButton.Left + TeleportButton.Width - 1
TeleportSaveButton.Top = TeleportButton.Top
TeleportSaveButton.Width = TeleportButton.Width
TeleportSaveButton.Height = 25
TeleportSaveButton.OnClick = function()
    local name = inputQuery("Save Location", "Enter location name:", "")
    if name then
        coordx = readFloat(xCord) or 0
        coordy = readFloat(yCord) or 0
        coordz = readFloat(zCord) or 0
        saveLocation(name, coordx, coordy, coordz)
        TeleportSelectiondropdown.Items.add(name)
    end
end

tpFRM.OnClose = function()
    tpFRM.hide()
    tpm_s.Active = false
    return caFree
end

tpFRM.show()

[DISABLE]

tpFRM.hide() tpm_s=nil

</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>1337142595</ID>
          <Description>"Scripts"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1337143122</ID>
              <Description>"Inf crafting materials"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(findhousememory,$process,8BxxxxEBxxB8xxxxxxxx89)
alloc(newmemfindhousememory,$100,findhousememory)
alloc(savedBytess,5,findhousememory)
label(codefindhousememory returnfindhousememory)

savedBytess:
readmem(findhousememory,5)

newmemfindhousememory:
mov [rax+40],999

codefindhousememory:
mov eax,[rax+40]
jmp findhousememory+A
jmp returnfindhousememory

findhousememory:
jmp newmemfindhousememory
returnfindhousememory:
registersymbol(findhousememory savedBytess)

[DISABLE]

findhousememory:
readmem(savedBytess,5)
unregistersymbol(findhousememory savedBytess)
dealloc(newmemfindhousememory savedBytess)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337143038</ID>
              <Description>"Flight"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

if _G.Bytrl_FlightSpeedxy == nil then
    _G.Bytrl_FlightSpeedxy = 15
end
if _G.Bytrl_FlightSpeedz == nil then
    _G.Bytrl_FlightSpeedz = 15
end

local VelocityX = getAddressSafe('[velocity]+50')
local VelocityY = getAddressSafe('[velocity]+58')
local VelocityZ = getAddressSafe('[velocity]+54')
local pitchBC  = getAddressSafe('[pitch]+BC')

[ENABLE]
if flightTmr then
    flightTmr.destroy()
    flightTmr = nil
end

local function clamp(v, mn, mx)
    if v &lt; mn then return mn end
    if v &gt; mx then return mx end
    return v
end

flightTmr = createTimer()
flightTmr.Interval = 10
flightTmr.onTimer = function()
    if not (VelocityX and VelocityY and VelocityZ and pitchBC) then
        return
    end

    local addrB8 = pitchBC - 4
    local addrC0 = pitchBC + 4

    local b8 = readFloat(addrB8) or 0
    local c0 = readFloat(addrC0) or 0

    -- Compute yaw in radians directly (game uses CCW positive convention matching math.atan2)
    local yaw = math.atan2(b8, c0)

    local speed = _G.Bytrl_FlightSpeedxy
    local vertSpeed = _G.Bytrl_FlightSpeedz

    local forward = isKeyPressed(0x57) and 1 or 0 -- W
    local backward = isKeyPressed(0x53) and 1 or 0 -- S
    local left = isKeyPressed(0x41) and 1 or 0 -- A
    local right = isKeyPressed(0x44) and 1 or 0 -- D
    local upKey = isKeyPressed(VK_SPACE) and 1 or 0
    local downKey = isKeyPressed(VK_SHIFT) and 1 or 0

    local pad = getXBox360ControllerState(0)
    if pad then
        local deadzone = 8000
        local lx = (math.abs(pad.ThumbLeftX) &gt; deadzone) and (pad.ThumbLeftX / 32767.0) or 0
        local ly = (math.abs(pad.ThumbLeftY) &gt; deadzone) and (pad.ThumbLeftY / 32767.0) or 0
        if ly &gt; 0 then forward = clamp(ly, 0, 1) end
        if ly &lt; 0 then backward = clamp(-ly, 0, 1) end
        if lx &gt; 0 then right = clamp(lx, 0, 1) end
        if lx &lt; 0 then left = clamp(-lx, 0, 1) end
        upKey = pad.GAMEPAD_LEFT_SHOULDER and 1 or upKey
        downKey = pad.GAMEPAD_RIGHT_SHOULDER and 1 or downKey
    end

    local fb = forward - backward
    local lr = right - left
    local ud = upKey - downKey

    -- Standard forward/right vectors (X=east/right, Y=north/forward axes)
    local fwdX = math.sin(yaw)
    local fwdY = math.cos(yaw)
    local rgtX = math.cos(yaw)
    local rgtY = -math.sin(yaw)

    -- STANDARD application (NO SWAP): fb along fwd, lr along rgt
    local moveX = (fwdX * fb + rgtX * lr) * speed
    local moveY = (fwdY * fb + rgtY * lr) * speed
    local moveZ = ud * vertSpeed

    writeFloat(VelocityX, moveX)
    writeFloat(VelocityY, moveY)
    writeFloat(VelocityZ, moveZ)
end

[DISABLE]
if flightTmr then
    flightTmr.destroy()
    flightTmr = nil
end
if _G.Bytrl_FlightSpeedxy then
    _G.Bytrl_FlightSpeedxy = nil
end
if _G.Bytrl_FlightSpeedz then
    _G.Bytrl_FlightSpeedz = nil
end
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337143039</ID>
                  <Description>"Flight Controller"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

_G.Bytrl_FlightSpeedxy=_G.Bytrl_FlightSpeedxy or 15
_G.Bytrl_FlightSpeedz=_G.Bytrl_FlightSpeedz or 15

local fsform = createForm(false)
fsform.Caption = "Bytrl Flight Speed Controller"
fsform.Width = 320
fsform.Height = 110
fsform.Position = "poScreenCenter"

-- Horizontal flight speed
local lblDist = createLabel(fsform)
lblDist.Caption = "Horizontal flight speed (xy axis): " .. _G.Bytrl_FlightSpeedxy
lblDist.Left = 10
lblDist.Top = 10

local sDist = createTrackBar(fsform)
sDist.Min = 5
sDist.Max = 50
sDist.Position = _G.Bytrl_FlightSpeedxy
sDist.Left = 10
sDist.Top = lblDist.Top + 15
sDist.Width = 310
sDist.OnChange = function()
  _G.Bytrl_FlightSpeedxy = sDist.Position
  lblDist.Caption = "horizontal flight speed: " .. sDist.Position
end

-- vertical flight speed
local lblDist2 = createLabel(fsform)
lblDist2.Caption = "Vertical flight speed (z axis): " .. _G.Bytrl_FlightSpeedz
lblDist2.Left = 10
lblDist2.Top = sDist.Top + 30

local sDist2 = createTrackBar(fsform)
sDist2.Min = 5
sDist2.Max = 50
sDist2.Position = _G.Bytrl_FlightSpeedz
sDist2.Left = 10
sDist2.Top = lblDist2.Top + 15
sDist2.Width = 310
sDist2.OnChange = function()
  _G.Bytrl_FlightSpeedz = sDist2.Position
  lblDist2.Caption = "vertical flight speed: " .. sDist2.Position
end

fsform.OnClose = function()
  fsform.destroy()
  resetClick(memrec)
end

fsform.show()

[DISABLE]

if fsform then
  fsform.close()
  fsform = nil
end

</AssemblerScript>
