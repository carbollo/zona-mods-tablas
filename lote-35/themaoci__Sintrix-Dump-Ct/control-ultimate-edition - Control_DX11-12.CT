  --0F10xxxx0F10xxxxxxxxxx8Bxxxx0F29 -- dx11 &amp; 12 velocity
  if process == dx11 then
    autoAssemble([[
    // dx11
    define(coregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43, coregame_rmdwin7_f.coregame::MovementModelComponent::updateCurrentVelocity+43)
    alloc(newmemcoregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43,$100,coregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43)
    alloc(velocity,8,coregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43)
    label(codecoregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43 returncoregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43)
    newmemcoregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43:
    mov [velocity],rdx
    codecoregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43:
    movups xmm0,[rdx+50]
    movups xmm6,[rdx+00000090]
    jmp returncoregame_rmdwin7_f_coregame__MovementModelComponent__updateCurrentVelocity_43
