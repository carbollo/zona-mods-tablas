--LEAVE THIS LINE HERE ALWAYS: If mono param is set to true, and a mono address is provided, we wait until mono is active before calling asmCode above. Aka, you can use mono addresses within the asm code without errors.
if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

	local clippistol=getAddressSafe('[clip_pistol]+108')
    local clipsize=getAddressSafe('[clip_pistol]+10C')
    if clippistol and ald('Bottomless Clip').Active==true then
       if not _G.Oldclipsize then _G.Oldclipsize = readFloat(clipsize) end
       writeFloat(clipsize,99) writeFloat(clippistol,99)
    else
        if _G.Oldclipsize then writeFloat(clipsize,_G.Oldclipsize) _G.Oldclipsize=nil end
    end

    local cliptimetoreload=getAddressSafe('[clip_pistol]+124')
    local reloadspeedmin=getAddressSafe('[clip_pistol]+11C')
    local reloadspeedmax=getAddressSafe('[clip_pistol]+120')
    if cliptimetoreload and ald('Instant Reload').Active==true then
      if not _G.Oldcliptimetoreload then
        _G.Oldcliptimetoreload = readFloat(cliptimetoreload)
        _G.Oldreloadspeedmin = readFloat(reloadspeedmin)
        _G.Oldreloadspeedmax = readFloat(reloadspeedmax)
      end
      writeFloat(cliptimetoreload,0) writeFloat(reloadspeedmin,0) writeFloat(reloadspeedmax,0)
    else
      if _G.Oldcliptimetoreload then
        writeFloat(cliptimetoreload,_G.Oldcliptimetoreload) _G.Oldcliptimetoreload=nil
        writeFloat(reloadspeedmin,_G.Oldreloadspeedmin) _G.Oldreloadspeedmin=nil
        writeFloat(reloadspeedmax,_G.Oldreloadspeedmax) _G.Oldreloadspeedmax=nil
      end
    end

    local godModef=getAddressSafe('godMode_f')
    if godModef and ald('God Mode').Active==true then
      if not _G.OldgodModef then _G.OldgodModef = readInteger(godModef) end
      writeInteger(godModef,1)
    else
      if _G.OldgodModef then writeInteger(godModef,_G.OldgodModef) _G.OldgodModef=nil end
    end

    local ohkf=getAddressSafe('ohk_f')
    if ohkf and ald('One Hit Kills').Active==true then
      if not _G.Oldohkf then _G.Oldohkf = readInteger(ohkf) end
      writeInteger(ohkf,1)
    else
      if _G.Oldohkf then writeInteger(ohkf,_G.Oldohkf) _G.Oldohkf=nil end
    end

    local controlpower=getAddressSafe('[control]+40')
    if controlpower and ald('Inf Control Power').Active==true then writeFloat(controlpower,1) end

    local shards=getAddressSafe('[shards]+40')
    if shards and ald('Add Shards').Active==true then ald('Add Shards').Active=false
        local userInput=inputQuery('Add Shards', 'Enter amount to add:', '10000')
        local value=tonumber(userInput) if value~=nil then
            writeInteger(shards,readInteger(shards)+value)
        end
    end

    local abilitypts=getAddressSafe('[shards]+48')
    if abilitypts and ald('Add Ability Points').Active==true then ald('Add Ability Points').Active=false
        local userInput=inputQuery('Add Ability Points', 'Enter amount to add:', '10000')
        local value=tonumber(userInput) if value~=nil then
            writeInteger(abilitypts,readInteger(abilitypts)+value)
        end
    end

    local iof=getAddressSafe('io_f')
    if iof and ald('Instant Objectives').Active==true then
      if not _G.Oldiof then _G.Oldiof = readInteger(iof) end
      writeInteger(iof,1)
    else
      if _G.Oldiof then writeInteger(iof,_G.Oldiof) _G.Oldiof=nil end
    end

end

