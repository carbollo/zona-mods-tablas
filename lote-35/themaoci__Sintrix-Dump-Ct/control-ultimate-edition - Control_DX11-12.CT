  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Control DX11 + DX11"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) local bufferSize = 4096 local buffer = createMemoryStream() while src.Position &lt; src.Size do local toRead = math.min(bufferSize, src.Size - src.Position) buffer.Size = 0 buffer.copyFrom(src, toRead) buffer.Position = 0 dst.copyFrom(buffer, buffer.Size) end buffer.destroy() dst.destroy() return outPath end local dll="Bytrl_.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll if not fileExists(outPath) then eTFTD(dll,outPath) end loadPlugin(outPath)

[ENABLE]

local dx11='Control_DX11.exe' local dx12='Control_DX12.exe' target=nil
if getProcessIDFromProcessName(dx11) ~= nil then target=dx11 else if getProcessIDFromProcessName(dx12) ~= nil then target=dx12 end end

startTable{
  process = target,
  title = "Control DX11 + DX12 - CT version 1.0.1",
  setOverlayLabel = "Control DX11 + DX12 - CT version 1.0.1",
  discord = "https://discord.gg/zRBd7uBBzZ",
  AddressListPic = "https://imgur.com/4pl47YF.png",
  compact = true,
}

--Put any asm within this function (if you use mono addrseses, make sure any valid mono address is provided above)
local function asmCode()

  --440Fxxxxxxxxxxxx440FxxxxxxxxF3xxxxxx0F28 -- dx11 &amp; 12 pCords
  if process == dx11 then
    autoAssemble([[
    // dx11
    define(physics_rmdwin7_f_physics__CharacterController__moveRelative_5B1, physics_rmdwin7_f.physics::CharacterController::moveRelative+5B1)
    alloc(newmemphysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1,$100,physics_rmdwin7_f_physics__CharacterController__moveRelative_5B1)
    alloc(pCords,8,physics_rmdwin7_f_physics__CharacterController__moveRelative_5B1)
    label(codephysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1 returnphysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1)
    newmemphysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1:
    mov [pCords],rbx
    codephysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1:
    movups [rbx+00000090],xmm10
    jmp returnphysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1
    physics_rmdwin7_f_physics__CharacterController__moveRelative_5B1:
    jmp newmemphysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1
    nop 3
    returnphysics_rmdwin7_f_physics__CharacterController__moveRelative_5B1:
    registersymbol(physics_rmdwin7_f_physics__CharacterController__moveRelative_5B1 pCords)]])
  else
    autoAssemble([[
    // dx12
    define(physics_rmdwin10_f_physics__CharacterController__moveRelative_5B1, physics_rmdwin10_f.physics::CharacterController::moveRelative+5B1)
    alloc(newmemphysics_rmdwin10_f_physics__CharacterController__moveRelative_5B1,$100,physics_rmdwin10_f_physics__CharacterController__moveRelative_5B1)
    alloc(pCords,8,physics_rmdwin10_f_physics__CharacterController__moveRelative_5B1)
