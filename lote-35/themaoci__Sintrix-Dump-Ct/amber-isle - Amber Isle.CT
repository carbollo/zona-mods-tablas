          <ID>1337142644</ID>
          <Description>"Get Time Data (Transition Map)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>define(address,TimeData.get_CurrentSeasonOfYear)
define(bytes,48 83 EC 28 44 8B 41 10)

[ENABLE]
//Send @ Sintrix | fearlessTRevolution
