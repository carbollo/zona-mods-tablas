  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Attach &amp; Initialize"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]

startTable{
  process = "Amber Isle.exe",
  title = "Amber Isle x SEND",
  setOverlayLabel = "[Send©2026+] Amber Isle v1.9.2",
  discord = "https://discord.gg/NTFcdAUWxb",
  AddressListPic = "https://i.imgur.com/vcskPNt.png",
  mono = true,
  monoAddress = "Any_Mono_Address_Here_only_used_if_mono_is_true"
}

local function asmCode()

autoAssemble([[

]])


end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

end

[DISABLE]

autoAssemble([[]])

if _tmr then _tmr.destroy() _tmr=nil end
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1337142598</ID>
          <Description>"Get Player Data"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>define(address,Ambertail.Game.PlayerData.OnUpdate)
define(bytes,48 89 5C 24 08)

[ENABLE]
// Send  @ Sintrix | FearlessRevolution
assert(address,bytes)
alloc(newmem,$1000,Ambertail.Game.PlayerData.OnUpdate)
label(code return getPlayer)
registersymbol(getPlayer)

newmem:
mov [getPlayer],rcx

code:
  mov [rsp+08],rbx
  jmp return

getPlayer:
dq

address:
  jmp newmem
return:
// Send  @ Sintrix | FearlessRevolution
[DISABLE]

address:
  db bytes
  unregistersymbol(*)
  dealloc(*)
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>1337142601</ID>
              <Description>"Edit Amber"</Description>
              <VariableType>8 Bytes</VariableType>
              <Address>[getPlayer]+140</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142602</ID>
              <Description>"Edit Inspiration"</Description>
              <VariableType>8 Bytes</VariableType>
              <Address>[getPlayer]+160</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142600</ID>
              <Description>"Accrued Monthly Interest"</Description>
              <VariableType>Double</VariableType>
              <Address>[getPlayer]+B0</Address>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>1337142616</ID>
          <Description>"Get Shop Data"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>define(address,Ambertail.Shop.Shop.OnUpdate)
define(bytes,48 89 5C 24 10)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Ambertail.Shop.Shop.OnUpdate)
registersymbol(ShopPtr)
label(code return ShopPtr)

newmem:
mov [ShopPtr],rcx
// Send @ Sintrix | FearlessRevolution
code:
  mov [rsp+10],rbx
  jmp return

ShopPtr:
dq 0

address:
  jmp newmem
return:

[DISABLE]
// Send @ Sintrix | FearlessRevolution
address:
  db bytes
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
