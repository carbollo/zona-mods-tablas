  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'Idle Slayer.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end

function mono_name_getStaticFieldValue(domain, classname, staticfield)
  local cid = mono_findClass(domain,classname)
  local fields = mono_class_enumFields(cid, true)
  for i in pairs(fields) do
      if fields[i].isStatic and fields[i].name == staticfield then
         local result = mono_class_getStaticFieldValue(cid, fields[i].field)
         return result
      end
  end
end
registerLuaFunctionHighlight("mono_name_getStaticFieldValue")
-- mono_name_getStaticFieldValue(domain, classname, staticfield)

getMainForm().Panel4.Visible = true;
{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>66</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>462</ID>
              <Description>"Grab Game Data"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//PlayerInventory.Update
//Send@FearlessRevolution|Sintrix
define(address,PlayerInventory.Update)
define(bytes,40 53 48 83 EC 30)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,PlayerInventory.Update)
registersymbol(inv)
label(code return inv)


newmem:
mov [inv],rcx

code:
  push rbx
  sub rsp,30
  jmp return

inv:
dq 0

address:
  jmp newmem
  nop
return:

[DISABLE]

address:
  db bytes


unregistersymbol(*)
dealloc(*)

</AssemblerScript>
