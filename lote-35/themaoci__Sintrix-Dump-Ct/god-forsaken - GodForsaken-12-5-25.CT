  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"GodForsaken.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local s=findTableFile('SintrixBytrl.lua').Stream load(readStringLocal(s.Memory,s.Size))()
startTable('GodForsaken.exe','GodForsaken.exe v0.1', 'GodForsaken.exe v0.1', 'Bytrl', true)


autoAssemble([[
aobscanmodule(getOwnerBase,GameAssembly.dll,48 * * 48 * * * * * * 48 * * * * * * FF * 84 * 74 * 80 * * * 74 * 48)
alloc(newmemgetOwnerBase,$100,getOwnerBase)
alloc(owner,8,getOwnerBase)
label(codegetOwnerBase returngetOwnerBase)
newmemgetOwnerBase:
mov [owner],rcx
codegetOwnerBase:
mov rdx,[rcx]
mov rax,[rdx+00000318]
jmp returngetOwnerBase
getOwnerBase:
jmp newmemgetOwnerBase
nop 5
returngetOwnerBase:
registersymbol(getOwnerBase owner)]])


gftmr=createTimer() gftmr.Interval=500 gftmr.onTimer=function()

 if getAddressSafe('[owner]') then owner_base=getAddressSafe('[owner]') end
 --local stat_base=getAddressSafe('[[[[[[GameAssembly.dll+04B8EBC8]+B8]+10]+3E8]+28]+18]')
 local stat_base=getAddressSafe('[[[[[[GameAssembly.dll+04B975B8]+B8]+10]+388]+58]+1F8]')
 if stat_base then registerSymbol('stat_base',stat_base) end
 --PropertiesManager=getAddressSafe('[[[[GameAssembly.dll+04B975B8]+B8]+10]+388]') --data

  if owner_base and stat_base then

    local speed=owner_base+0xEC
    local curHp=owner_base+0x178
    local maxHp=owner_base+0x200
    local strength=getAddressSafe("[stat_base+30]+1c")
    local dexterity=getAddressSafe("[stat_base+48]+1c")
    local intelligence=getAddressSafe("[stat_base+60]+1c")
    local luck=getAddressSafe("[stat_base+78]+1c")
    local baseDamagePercentage=getAddressSafe("[stat_base+A8]+1c")
    local physicalDamagePercentage=getAddressSafe("[stat_base+180]+1c")
    local lightningChaosFrostFireMultiplier=getAddressSafe("[stat_base+198]+1c")
    local attackSpeedPercentage=getAddressSafe("[stat_base+210]+1c")
    local damageOverTimePercentage=getAddressSafe("[stat_base+228]+1c")
    local critRatePercentage=getAddressSafe("[stat_base+240]+1c")
    local critDamagePercentage=getAddressSafe("[stat_base+258]+1c")
    local actualHitProbability=getAddressSafe("[stat_base+2e8]+1c")
