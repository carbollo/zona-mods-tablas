    local summonCritHitDamagePercentage=getAddressSafe("[stat_base+F78]+1c")
    local cantBeHit=getAddressSafe("[owner]+2D8")
    local isNightmare=getAddressSafe("[owner]+FC")
    local hitRadius=getAddressSafe("[owner]+2DC")

    local max=9999

      if ald('Increase speed').Active==true then writeFloat(speed,35) end
      if ald('Increase health').Active==true then writeInteger(curHp,max) writeInteger(maxHp,max) end
      if ald('Increase dexterity').Active==true then writeFloat(dexterity,max) end
      if ald('Increase intelligence').Active==true then writeFloat(intelligence,max) end
      if ald('Increase strength').Active==true then writeFloat(strength,max) end
      if ald('Increase luck').Active==true then writeFloat(luck,max) end
      if ald('Increase base damage %').Active==true then writeFloat(baseDamagePercentage,max) end
      if ald('Increase physical damage %').Active==true then writeFloat(physicalDamagePercentage,max) end
      if ald('Increase lightning/Chaos/Frost/Fire Multipliers').Active==true then writeFloat(lightningChaosFrostFireMultiplier,max) end
      if ald('Increase attack Speed %').Active==true then writeFloat(attackSpeedPercentage,max) end
      if ald('Increase damage over time %').Active==true then writeFloat(damageOverTimePercentage,max) end
      if ald('Increase crit rate %').Active==true then writeFloat(critRatePercentage,max) end
      if ald('Increase crit damage %').Active==true then writeFloat(critDamagePercentage,max) end
      if ald('Increase hit probability %').Active==true then writeFloat(actualHitProbability,max) end
      if ald('Increase health regen %').Active==true then writeFloat(healthRegenPercentage,max) end
      if ald('Increase health regen multiplier %').Active==true then writeFloat(healthRegenMultiplier,max) end
      if ald('Increase Armor %').Active==true then writeFloat(armorPercentage,max) end
      if ald('Increase Armor multiplier %').Active==true then writeFloat(armorPercentage,max) end
      if ald('Increase shield regen %').Active==true then writeFloat(armorPercentage,max) end
      if ald('Increase rare drop %').Active==true then writeFloat(rareDropPercentage,max) end
      if ald('Increase pickup range %').Active==true then writeFloat(pickupRange,max) end
      if ald('Increase thorns').Active==true then writeFloat(thorns,max) end
      if ald('Increase size of area skills %').Active==true then writeFloat(sizeOfAreaSkills,max) end
      if ald('Increase skill duration %').Active==true then writeFloat(skillDurationIncrease,max) end
      if ald('Increase melee skill range').Active==true then writeFloat(meleeSkillRange,max) end
      if ald('Increase regional skill range').Active==true then writeFloat(regionalSkillRange,max) end
      if ald('Increase projectile skill range').Active==true then writeFloat(projectileSkillRange,max) end
      if ald('Increase refresh times').Active==true then writeFloat(refreshTimes,max) end
      if ald('Increase cull times').Active==true then writeFloat(cullTimes,max) end
      if ald('Increase sanity cap %').Active==true then writeFloat(sanityCap,max) end
      if ald('Increase reroll lock').Active==true then writeFloat(rerollLock,max) end
      if ald('Increase summon health %').Active==true then writeFloat(summonHealthPercentage,max) end
      if ald('Increase summon physical damage %').Active==true then writeFloat(summonPhysicalDamage,max) end
      if ald('Increase summon frost damage %').Active==true then writeFloat(summonFrostDamage,max) end
      if ald('Increase summon fire damage %').Active==true then writeFloat(summonFireDamage,max) end
      if ald('Increase summon lightning damage %').Active==true then writeFloat(summonLightningDamage,max) end
      if ald('Increase summon chaos damage %').Active==true then writeFloat(summonChaosDamage,max) end
      if ald('Increase summon frost resistance %').Active==true then writeFloat(summonFrostResistance,max) end
      if ald('Increase summon fire resistance %').Active==true then writeFloat(summonFireResistance,max) end
      if ald('Increase summon lightning resistance %').Active==true then writeFloat(summonLightningResistance,max) end
      if ald('Increase summon chaos resistance %').Active==true then writeFloat(summonChaosResistance,max) end
      if ald('Increase summon physical resistance %').Active==true then writeFloat(summonPhysicalResistance,max) end
      if ald('Increase summon movement speed %').Active==true then writeFloat(summonMovementSpeedPercentage,max) end
      if ald('Increase summon crit hit chance %').Active==true then writeFloat(summonCritHitChancePercentage,max) end
      if ald('Increase summon crit hit damage %').Active==true then writeFloat(summonCritHitDamagePercentage,max) end
      if ald('Enemys swing far away').Active==true then writeFloat(hitRadius,20) else writeFloat(hitRadius,0.5) end
      if ald('Nightmare mode').Active==true then writeByte(isNightmare,1) else writeByte(isNightmare,0) end
      if ald('Cant be hit mode?').Active==true then writeByte(cantBeHit,1) else writeByte(cantBeHit,0) end

      if ald('Modify experience gained %').Active == true and experienceGained then
          ald('Modify experience gained %').Active=false
          local userInput=inputQuery('Set experience gained %', 'Enter %:', '100.0')
          local value=tonumber(userInput)
          if value~=nil then writeFloat(experienceGained,value) end
      end


  end -- base check

end -- tmrfunction


