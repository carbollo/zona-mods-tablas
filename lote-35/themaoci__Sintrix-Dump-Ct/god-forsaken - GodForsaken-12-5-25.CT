            <CheatEntry>
              <ID>107</ID>
              <Description>"Effect everything (will break game)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

define(Timer_get_StartTime, Timer.get_StartTime)
alloc(newmemTimer_get_StartTime,$100,Timer_get_StartTime)
alloc(baseee,8,Timer_get_StartTime)
label(codeTimer_get_StartTime returnTimer_get_StartTime)

newmemTimer_get_StartTime:
//cmp RSP,13E428 // compare out 4 main stats only
mov [baseee],rcx
mov [rcx+1C],(float)999 // test effect all


codeTimer_get_StartTime:
movss xmm0,[rcx+1C]
jmp returnTimer_get_StartTime

Timer_get_StartTime:
jmp newmemTimer_get_StartTime
returnTimer_get_StartTime:
registersymbol(Timer_get_StartTime baseee)

[DISABLE]

Timer_get_StartTime:
db F3 0F 10 41 1C
unregistersymbol(Timer_get_StartTime baseee)
dealloc(newmemTimer_get_StartTime baseee)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>652</ID>
              <Description>"get pointer base"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

autoAssemble([[
aobscanmodule(pointerbasexxx,GameAssembly.dll,50 50 22 33 00 00)
registersymbol(pointerbasexxx)]]) --GameAssembly.dll.data+10FBC8
pbtmr=createTimer() pbtmr.Interval=500 pbtmr.onTimer=function()



  local PropertiesManager=getAddressSafe("[[[[pointerbasexxx]+B8]+10]+3E8]+00")
  if not getAddressSafe("PropertiesManager") then registerSymbol('PropertiesManager',PropertiesManager) end


end
[DISABLE]
if pbtmr then pbtmr.destroy() pbtmr=nil end
unregisterSymbol('pointerbasexxx')
unregisterSymbol('PropertiesManager')
</AssemblerScript>
