  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('DimDefGame.exe','', 'Dungeon Defenders x Sintrix')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>26435</ID>
          <Description>"→ Enable Damage Modifiers"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]


aobscanmodule(PlayerHealthAOB,DunDefGame.exe,29 03 8B 1B 8B 4C 24 14)
alloc(newmem,$1000)
registersymbol(PlayerHP EnemyHP)
label(code return PlayerHP EnemyHP)
//Send@https://sintrix.net
newmem:
cmp [PlayerHP],1
jne @f
cmp [ebx+1E4],(float)0
je @f
mov [ebx],#9999

@@:
cmp [EnemyHP],1
jne code
cmp [ebx+1E4],(float)0
jne code
mov eax,#999999

code:
  sub [ebx],eax
  mov ebx,[ebx]
  mov ecx,[esp+14]
  jmp return

PlayerHP:
dd 0

EnemyHP:
dd 0

PlayerHealthAOB:
  jmp newmem
  nop 3
return:
registersymbol(PlayerHealthAOB)

[DISABLE]

PlayerHealthAOB:
  db 29 03 8B 1B 8B 4C 24 14
//Send@https://sintrix.net
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>26436</ID>
              <Description>"Infinite Player &amp; Crystal Health"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
PlayerHP:
dd 1

[DISABLE]
PlayerHP:
dd 0
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>26437</ID>
              <Description>"One Hit Kills"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
EnemyHP:
dd 1

[DISABLE]
EnemyHP:
dd 0
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
