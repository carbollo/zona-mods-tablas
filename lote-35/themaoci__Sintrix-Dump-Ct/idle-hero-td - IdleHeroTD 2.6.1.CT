define(bytes,48 8B F1 C7 85 F0 F7 FF FF 00 00 00 00)
//Send&amp;Shaggy@Sintrix/FearlessRevolution
[ENABLE]
//Send&amp;Shaggy@Sintrix/FearlessRevolution
assert(address,bytes)
