                          <ID>521</ID>
                          <Description>"→ Game Manager"</Description>
                          <Options moHideChildren="1"/>
                          <Color>00FF00</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
{$lua}
local inst = mono_name_getStaticFieldValue('', 'GameManager', 'Instance', 1)
rinst = readPointer(inst)
registerSymbol('gman', rinst)
--print(string.format("0x%x",rinst))
{$asm}
 
[DISABLE]
{$lua}
unregisterSymbol('gman')
</AssemblerScript>
