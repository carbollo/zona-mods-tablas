registersymbol(setexpbonus weak)
label(code return setexpbonus weak)
//Send&amp;Shaggy@Sintrix/FearlessRevolution
newmem:

cmp [weak],1
jne code
mov [rcx+C8],#1


xorps xmm13,xmm13
movss xmm13,[setexpbonus]
movss [rcx+140],xmm13

code:
  mov rsi,rcx
  mov [rbp-00000810],00000000
  jmp return


weak:
dd 0

setexpbonus:
dd (float)1

//Send&amp;Shaggy@Sintrix/FearlessRevolution
