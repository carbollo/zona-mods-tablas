  <CheatEntries>
    <CheatEntry>
      <ID>489</ID>
      <Description>"→ IMPORTANT: Not guaranteed to evade a ban. Use at your own risk."</Description>
      <Options moHideChildren="1"/>
      <Color>0000FF</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>475</ID>
          <Description>"→ Enable (Auto-Attach Game Process)"</Description>
          <Color>00FF00</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('IdleHeroTD.exe','', 'Idle Hero TD x Sintrix')

{$asm}
[DISABLE]

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>434</ID>
              <Description>"→ Initialize Mono (Required)"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$Lua}
--dont run on syntaxcheck
if syntaxcheck then return end

-- setup monopipe
if not monopipe then
   if LaunchMonoDataCollector() == 0 then
      ShowMessage('Failed To Launch Mono Data Collector')
   end
end


{$asm}
[DISABLE]
{$lua}

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>3</ID>
