        </CheatEntry>
        <CheatEntry>
          <ID>450</ID>
          <Description>"-&gt; Get PlayerStats (open Treasury)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Target:  Age of History 3
//Author:  Sintrix.net
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  getpstats  \\\\\\\\\\\\\\\\\\\\\\\\

aobscan(address,C5 FA 10 84 24 A0 00 00 00 C5 FA 10 48 34 C5 F8 2E C1)
alloc(newmem,1024)
alloc(obytes_getpstats, 18)
label(return originalcode)

registersymbol(obytes_getpstats pstats)

obytes_getpstats:
readmem(address, 18)

newmem:

originalcode:
 mov [pstats],rax
 vmovss xmm0,[rsp+000000A0]
 vmovss xmm1,[rax+34]
 vucomiss xmm0,xmm1
 jmp return

pstats:
dd #0

address:
 jmp newmem
 db 90 90 90 90 90 90 90 90 90 90 90 90 90
 return:


[DISABLE]

address:
readmem(obytes_getpstats, 18)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>3</ID>
              <Description>"pstats"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Byte</VariableType>
              <Address>pstats</Address>
              <Offsets>
                <Offset>0</Offset>
              </Offsets>
              <CheatEntries>
                <CheatEntry>
                  <ID>10</ID>
                  <Description>"Manpower"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Float</VariableType>
                  <Address>+14</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>7</ID>
