                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>4 Bytes</VariableType>
                  <Address>+29c</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>452</ID>
          <Description>"-&gt; Get Advantage Points (open research tab)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Target:  Age of History 3
//Author:  Salis
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  advpoints  \\\\\\\\\\\\\\\\\\\\\\\\

aobscan(address,8B 82 40 01 00 00 48 C1 E0 03 8B 40 0C)
alloc(newmem,102)
alloc(obytes_advpoints, 13)
label(return originalcode)

registersymbol(obytes_advpoints advpoints)

obytes_advpoints:
readmem(address, 13)

newmem:

originalcode:
 mov eax,[rdx+00000140]
 shl rax,03
 mov [advpoints], rax
 mov eax,[rax+0C]
 jmp return

advpoints:
dd #0

address:
 jmp newmem
 db 90 90 90 90 90 90 90 90
return:


[DISABLE]

address:
readmem(obytes_advpoints, 13)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
