              <ID>1337142713</ID>
              <Description>"RelativeScale3D.Y"</Description>
              <Color>C0C0C0</Color>
              <VariableType>Double</VariableType>
              <Address>[pCords]+178</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142714</ID>
