  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"DrainSim-Win64-Shipping.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "_Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]

startTable{
  process = "DrainSim-Win64-Shipping.exe",
  title = "DrainSim-Win64-Shipping.exe",
  discord = "https://discord.gg/zRBd7uBBzZ",
  AddressListPic = "https://imgur.com/4pl47YF.png",
  compact = true
}

local function asmCode()
  autoAssemble([[
  aobscanmodule(find_pCords,DrainSim-Win64-Shipping.exe,0Fxxxxxxxxxxxx48xxxxxxxx0Fxxxxxxxxxxxx0FxxxxxxxxF2xxxxxxxxxxEBxx0Fxxxxxxxxxxxx48xxxxxxxx0FxxxxxxxxF2xxxxxxxxxxxxxxF2xxxxxxxxxxF3xxxxxxxxxxxxxx)
  alloc(newmemfind_pCords,$100,find_pCords)
  alloc(pCords,8,find_pCords)
  alloc(find_pCords_savedBytes,7,find_pCords)
  label(codefind_pCords returnfind_pCords)
  find_pCords_savedBytes:
  readmem(find_pCords,7)
  newmemfind_pCords:
  mov [pCords],rcx
  codefind_pCords:
  movups xmm0,[rcx+00000200]
  jmp returnfind_pCords
  find_pCords:
  jmp newmemfind_pCords
  nop 2
  returnfind_pCords:
  registersymbol(find_pCords pCords find_pCords_savedBytes)]])
end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

  local CustomTimeDilation=getAddressSafe('[[pCords]+A0]+68')
  if CustomTimeDilation and ald('3x Time Dilation').Active==true then
    if not _G.OldCustomTimeDilation then _G.OldCustomTimeDilation = readFloat(CustomTimeDilation) end
    writeFloat(CustomTimeDilation,3)
  else
    if _G.OldCustomTimeDilation then writeFloat(CustomTimeDilation,_G.OldCustomTimeDilation) _G.OldCustomTimeDilation=nil end
  end

  local JumpZVelocity=getAddressSafe('[[[pCords]+A0]+680]+1A8')
  if JumpZVelocity and ald('Increase Jump Velocity').Active==true then
    if not _G.OldJumpZVelocity then _G.OldJumpZVelocity = readFloat(JumpZVelocity) end
    writeFloat(JumpZVelocity,1000)
  else
    if _G.OldJumpZVelocity then writeFloat(JumpZVelocity,_G.OldJumpZVelocity) _G.OldJumpZVelocity=nil end
  end

  local MaxWalkSpeed=getAddressSafe('[[[pCords]+A0]+680]+278')
  local MaxWalkSpeedCrouched=getAddressSafe('[[[pCords]+A0]+680]+27C')
  if MaxWalkSpeed and ald('Increase Walk Speed').Active==true then
    if not _G.OldMaxWalkSpeed then _G.OldMaxWalkSpeed = readFloat(MaxWalkSpeed) end
    writeFloat(MaxWalkSpeed,1000)
    if not _G.OldMaxWalkSpeedCrouched then _G.OldMaxWalkSpeedCrouched = readFloat(MaxWalkSpeedCrouched) end
    writeFloat(MaxWalkSpeedCrouched,850)
  else
    if _G.OldMaxWalkSpeed then writeFloat(MaxWalkSpeed,_G.OldMaxWalkSpeed) _G.OldMaxWalkSpeed=nil end
    if _G.OldMaxWalkSpeedCrouched then writeFloat(MaxWalkSpeedCrouched,_G.OldMaxWalkSpeedCrouched) _G.OldMaxWalkSpeedCrouched=nil end
  end

  local GravityScale=getAddressSafe('[[[pCords]+A0]+680]+1A0')
  if GravityScale and ald('1/2 Gravity Scale').Active==true then
    if not _G.OldGravityScale then _G.OldGravityScale = readFloat(GravityScale) end
    writeFloat(GravityScale,0.5)
  else
    if _G.OldGravityScale then writeFloat(GravityScale,_G.OldGravityScale) _G.OldGravityScale=nil end
  end

  local weight=getAddressSafe('[[[[["DrainSim-Win64-Shipping.exe"+0ABA4038]+A8]+50]+2C0]+30]+450')
  if weight and ald('Null carry weight').Active==true then
    if not _G.Oldweight then _G.Oldweight = readInteger(weight) end
    writeInteger(weight,0)
  else
    if _G.Oldweight then writeInteger(weight,_G.Oldweight) _G.Oldweight=nil end
  end

  local cash=getAddressSafe('[[["DrainSim-Win64-Shipping.exe"+0A935620]+10]+28]+50')
  if cash and ald('Infinite cash').Active==true then
    if not _G.Oldcash then _G.Oldcash = readInteger(cash) end
    writeInteger(cash,999999)
  else
    if _G.Oldcash then writeInteger(cash,_G.Oldcash) _G.Oldcash=nil end
  end

end

ald('Scripts').Active=true MainForm.Width=365 MainForm.Height=304 --printMainFormSize()

[DISABLE]

autoAssemble([[
find_pCords:
readmem(find_pCords_savedBytes,7)
unregistersymbol(find_pCords pCords find_pCords_savedBytes)
dealloc(newmemfind_pCords pCords find_pCords_savedBytes)]])

if _tmr then _tmr.destroy() _tmr=nil end
</AssemblerScript>
