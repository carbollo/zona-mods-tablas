            <CheatEntry>
              <ID>919</ID>
              <Description>"No Unit Cooldown"</Description>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Target:  EMERGENCY-Win64-Shipping.exe
//Author:  Salis
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  instaunit  \\\\\\\\\\\\\\\\\\\\\\\\

aobscanmodule(address,EMERGENCY-Win64-Shipping.exe,0F 2F 83 74 09 00 00)
alloc(newmem,1024,EMERGENCY-Win64-Shipping.exe)
alloc(obytes_instaunit, 10)
label(return originalcode ocode)

registersymbol(obytes_instaunit)

obytes_instaunit:
readmem(address, 10)

newmem:

originalcode:
 cmp [rbx+00000974],#0
 je ocode
 mov [rbx+00000974],(float)0

ocode:
 comiss xmm0,[rbx+00000974]
 jmp return

address:
 jmp newmem
 nop 2
return:


[DISABLE]

address:
readmem(obytes_instaunit, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
