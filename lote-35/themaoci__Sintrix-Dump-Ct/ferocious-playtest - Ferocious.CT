            <CheatEntry>
              <ID>779</ID>
              <Description>"→ Player Movement"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(playerSpeed,GameAssembly.dll,8B 40 14 89 83 D4 00 00 00 41)
alloc(newmem,$1000,playerSpeed)
registersymbol(setSpeed)
label(code return setSpeed)

newmem:
xorps xmm14,xmm14
movss xmm14,[setSpeed]
movss [rax+14],xmm14

code:
  mov eax,[rax+14]
  mov [rbx+000000D4],eax
  jmp return

setSpeed:
dd (float)3

playerSpeed:
  jmp newmem
  nop 4
return:
registersymbol(playerSpeed)

aobscanmodule(playerSpeedForward,GameAssembly.dll,00 8B 40 10 89 83 D4 00 00 00)
alloc(newmem2,$1000,playerSpeedForward)

label(code2)
label(return2)

newmem2:
movss xmm14,[setSpeed]
movss [rax+10],xmm14

code2:
  mov eax,[rax+10]
  mov [rbx+000000D4],eax
  jmp return2

playerSpeedForward+01:
  jmp newmem2
  nop 4
return2:
registersymbol(playerSpeedForward)

[DISABLE]

playerSpeed:
  db 8B 40 14 89 83 D4 00 00 00


playerSpeedForward+01:
  db 8B 40 10 89 83 D4 00 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
