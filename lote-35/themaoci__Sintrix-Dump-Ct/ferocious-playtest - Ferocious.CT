            <CheatEntry>
              <ID>791</ID>
              <Description>"→ Firearm Settings"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,Firearm.get_Settings)
define(bytes,40 53 48 83 EC 20)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Firearm.get_Settings)
registersymbol(playerFirearm)
label(code return playerFirearm)

newmem:
cmp [rcx+50],1
jne code
mov [playerFirearm],rcx

code:
  push rbx
  sub rsp,20
  jmp return

playerFirearm:
dw

address:
  jmp newmem
  nop
return:

[DISABLE]

address:
  db bytes

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
