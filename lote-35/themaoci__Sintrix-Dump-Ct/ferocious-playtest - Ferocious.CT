            <CheatEntry>
              <ID>773</ID>
              <Description>"Unlimited Stamina"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(playerStamina,GameAssembly.dll,F3 0F 11 83 B8 00 00 00 48 85 C0)
alloc(newmem,$1000,playerStamina)

label(code)
label(return)

newmem:

code:
  movss xmm0,[setStamina]
  movss [rbx+000000B8],xmm0
  jmp return

setStamina:
dd (float)150

playerStamina:
  jmp newmem
  nop 3
return:
registersymbol(playerStamina)

[DISABLE]

playerStamina:
  db F3 0F 11 83 B8 00 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
