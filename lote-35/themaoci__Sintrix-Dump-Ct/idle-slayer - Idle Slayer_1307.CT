              <Description>"Always Perfect Chest Hunt"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
//ChestHuntManager.GenerateChests

[ENABLE]
aobscanmodule(mimic,GameAssembly.dll,48 8B F1 75 67 48 8D 0D * * * * E8 22)
alloc(newmem3,$1000,mimic)
label(code3 return3)

newmem3:
mov [rcx+2C],#0

code3:
  mov rsi,rcx
  jne GameAssembly.dll+345AD9
  jmp return3

mimic:
  jmp newmem3
return3:
registersymbol(mimic)

[DISABLE]


