              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,Divinity.GetDescription)
define(bytes,40 53 48 83 EC 20)
//Send@Sintrix|FearlessRevolution
[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Divinity.GetDescription)

label(code)
label(return)
//Divinity.GetDescription
//Send@Sintrix|FearlessRevolution
newmem:
push r13
mov r13,(double)0
mov [rcx+48],r13
pop r13

