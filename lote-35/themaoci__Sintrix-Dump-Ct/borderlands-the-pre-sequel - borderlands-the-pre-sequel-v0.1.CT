<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- start table script : (process , title, footer)
startTable('BorderlandsPreSequel.exe','Borderlands: The Pre-Sequel - Sintrix', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>26212</ID>
          <Description>"Grab Game Data"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send
[ENABLE]

aobscanmodule(fuckinggame,BorderlandsPreSequel.exe,8B 11 8B 82 30 04 00 00 FF D0 85 C0 75 48)
alloc(newmem,$1000)
registersymbol(strokeinducing)
label(strokeinducing)
label(code)
label(return)

newmem:
mov [strokeinducing],ecx

code:
  mov edx,[ecx]
  mov eax,[edx+00000430]
  jmp return

strokeinducing:
dq 0

fuckinggame:
  jmp newmem
  nop 3
return:
registersymbol(fuckinggame)

aobscan(database,8B 06 8B 4D EC 8D 04 88 85 C0 0F 84)
alloc(newmem2,$1000)
registersymbol(tpsdata)
label(tpsdata)
label(code2)
label(return2)

newmem2:

code2:
  mov dword ptr [tpsdata],esi
  mov eax,[esi]
  mov ecx,[ebp-14]
  jmp return2

tpsdata:
dd 0

database:
  jmp newmem2
return2:
registersymbol(database)

[DISABLE]

fuckinggame:
  db 8B 11 8B 82 30 04 00 00

database:
  db 8B 06 8B 4D EC

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
