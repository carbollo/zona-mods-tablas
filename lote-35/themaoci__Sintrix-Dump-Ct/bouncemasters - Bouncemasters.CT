    <CheatEntry>
      <ID>770</ID>
      <Description>"➜  Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1" moActivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('Bouncemasters.exe','Bouncermasters x SEND', 'SINTRIX.NET EXCLUSIVE')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"➜  Initialize Mono"</Description>
          <Options moHideChildren="1" moActivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
