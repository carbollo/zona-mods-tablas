            <CheatEntry>
              <ID>4185</ID>
              <Description>"Extreme Speed (d-pad up)"</Description>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local weight=getAddressSafe('[pCord_x]+C0')
local timedilation=getAddressSafe('[pCord_x]+C4')

if weight and timedilation then
  og_weight=readFloat(weight)
  og_dilation=readFloat(timedilation)

  writeFloat(timedilation,0.0029)
  writeFloat(weight,og_weight+500)
end

[DISABLE]

writeFloat(getAddressSafe('[pCord_x]+C4'),og_dilation)
writeFloat(getAddressSafe('[pCord_x]+C0'),og_weight)

og_dilation=nil og_weight=nil
</AssemblerScript>
