            <CheatEntry>
              <ID>4319</ID>
              <Description>"Tuning"</Description>
              <Options moHideChildren="1"/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanregion(Tuning,7F0000000000,7FFFFFFFFFFF,F3 0F 10 44 81 10)
alloc(newmem,$100,Tuning)
alloc(Tune,8,Tuning)
registersymbol(Tune)
label(code return)

newmem:
mov [Tune],rcx

code:
movss xmm0,[rcx+rax*4+10]
jmp return

Tuning+0:
jmp newmem
nop 1
return:
registersymbol(Tuning)

[DISABLE]

Tuning+0:
db F3 0F 10 44 81 10
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
