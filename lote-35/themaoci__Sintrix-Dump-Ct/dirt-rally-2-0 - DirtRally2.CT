aobscanmodule(SearchArray,dirtrally2.exe,0F 59 07 4C 8B C6)
alloc(newmem,$100,SearchArray)
//alloc(awdd,8,SearchArray)
//registersymbol(awdd)
label(code return)

newmem:
//mov [awdd],rcx
mov [rdi],(float)0

code:
mulps xmm0,[rdi]
mov r8,rsi
jmp return

SearchArray:
jmp newmem
nop 1
return:
registersymbol(SearchArray)

[DISABLE]

SearchArray:
db 0F 59 07 4C 8B C6

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
