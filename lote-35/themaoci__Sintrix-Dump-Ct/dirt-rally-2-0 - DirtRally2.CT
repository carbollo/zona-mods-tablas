  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"dirtrally2.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local s=findTableFile('SintrixBytrl.lua').Stream load(readStringLocal(s.Memory,s.Size))()
startTable('dirtrally2.exe','Dirt Rally 2 v1', 'Dirt Rally 2 v1', 'Bytrl')


autoAssemble([[
aobscanmodule(pBase,dirtrally2.exe,0F 29 43 20 F3 45 0F 59 EE)
alloc(newmempbasex,$100,pBase)
alloc(pCord_x,8,pBase)
alloc(freezeFlag,8,pBase)
label(codepbasex returnpbasex opponentFreeze)
freezeFlag:
dd 0
newmempbasex://player
cmp [rbx+F8],0
je codepbasex
mov [pCord_x],rbx
//mov [rbx+C0],(float)1810
//mov [rbx+C4],(float)0.0029
movaps [rbx+20],xmm0
mulss xmm13,xmm14
jmp returnpbasex
codepbasex://opponents
cmp [freezeFlag],1
je opponentFreeze
movaps [rbx+20],xmm0
mulss xmm13,xmm14
jmp returnpbasex
opponentFreeze:
xorps xmm0,xmm0
mulss xmm13,xmm14
jmp returnpbasex
pBase:
jmp newmempbasex
nop 4
returnpbasex:
registersymbol(pBase pCord_x freezeFlag)]])



ald('Scripts').Active=true --open scripts header

[DISABLE]

autoAssemble([[
pBase:
db 0F 29 43 20 F3 45 0F 59 EE
unregistersymbol(pBase pCord_x freezeFlag)
dealloc(newmempbasex pCord_x freezeFlag)]])

if drtmr then drtmr.destroy() drtmr=nil end

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>88</ID>
          <Description>"bin"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>4471</ID>
              <Description>"Free repairs test (every part)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : dirtrally2.exe
  Version: 
  Date   : 2024-11-09
  Author : Bytrl

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(FreeRepairsTest,dirtrally2.exe,05 75 07 8B 06 89 47 30 EB 13) // should be unique
alloc(newmem_freerepairs,$100,FreeRepairsTest)

label(code_freerepairs)
label(return_freerepairs)

