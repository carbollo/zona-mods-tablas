  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"I See Red - Attach &amp; Initialize"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "_Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]

startTable{
  process = "I See Red.exe",
  title = "I See Red 1.0.1",
  discord = "https://discord.gg/zRBd7uBBzZ",
  AddressListPic = "https://imgur.com/UvDbmlW.png",
  compact = true,
  mono = true,
  monoAddress = "PlayerInputs..ctor"
}

local function asmCode()

autoAssemble([[
define(WhiteboardGames_ISeeRed_PlayerSystems_Player_Update,WhiteboardGames.ISeeRed.PlayerSystems.Player.Update)
alloc(newmemWhiteboardGames_ISeeRed_PlayerSystems_Player_Update,$100,WhiteboardGames_ISeeRed_PlayerSystems_Player_Update)
alloc(Player,8,WhiteboardGames_ISeeRed_PlayerSystems_Player_Update)
alloc(WhiteboardGames_ISeeRed_PlayerSystems_Player_Update_savedBytes,5,WhiteboardGames_ISeeRed_PlayerSystems_Player_Update)
label(codeWhiteboardGames_ISeeRed_PlayerSystems_Player_Update returnWhiteboardGames_ISeeRed_PlayerSystems_Player_Update)
WhiteboardGames_ISeeRed_PlayerSystems_Player_Update_savedBytes:
readmem(WhiteboardGames_ISeeRed_PlayerSystems_Player_Update,5)
newmemWhiteboardGames_ISeeRed_PlayerSystems_Player_Update:
mov [Player],rcx
codeWhiteboardGames_ISeeRed_PlayerSystems_Player_Update:
mov [rsp+08],rbx
jmp returnWhiteboardGames_ISeeRed_PlayerSystems_Player_Update
WhiteboardGames_ISeeRed_PlayerSystems_Player_Update:
jmp newmemWhiteboardGames_ISeeRed_PlayerSystems_Player_Update
returnWhiteboardGames_ISeeRed_PlayerSystems_Player_Update:
registersymbol(WhiteboardGames_ISeeRed_PlayerSystems_Player_Update Player WhiteboardGames_ISeeRed_PlayerSystems_Player_Update_savedBytes)]])

autoAssemble([[
define(WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update,WhiteboardGames.ISeeRed.Weapons.RangedWeapon.Update)
alloc(newmemWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update,$100,WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update)
alloc(weapon,8,WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update)
alloc(WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update_savedBytes,6,WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update)
alloc(car_f,4,WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update)
label(codeWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update returnWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update)

WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update_savedBytes:
readmem(WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update,6)

newmemWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update:
mov [weapon],rcx

codeWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update:
push rbx
sub rsp,60
jmp returnWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update

WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update:
jmp newmemWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update
nop 1
returnWhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update:
registersymbol(WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update weapon WhiteboardGames_ISeeRed_Weapons_RangedWeapon_Update_savedBytes)]])


end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

  local currentTotalHeat=getAddressSafe('[pistol]+3EC')
  local isOverheatable=getAddressSafe('[pistol]+37D')
    if currentTotalHeat and ald('No Pistol Heat').Active==true then
      if not _G.OldisOverheatable then _G.OldisOverheatable = readByte(isOverheatable) end
      writeByte(isOverheatable,0) writeFloat(currentTotalHeat,0)
    else
      if _G.OldisOverheatable then writeByte(isOverheatable,_G.OldisOverheatable) _G.OldisOverheatable=nil end
    end

  local movespeedmultiplier=getAddressSafe('[[Player]+D8]+18')
  if movespeedmultiplier and ald('Increase move speed').Active==true then
    if not _G.Oldmovespeedmultiplier then _G.Oldmovespeedmultiplier = readFloat(movespeedmultiplier) end
    writeFloat(movespeedmultiplier,3)
  else
    if _G.Oldmovespeedmultiplier then writeFloat(movespeedmultiplier,_G.Oldmovespeedmultiplier) _G.Oldmovespeedmultiplier=nil end
  end

  local throwForce=getAddressSafe('[Player]+E8')
  if throwForce and ald('Increase Throw Force').Active==true then
    if not _G.OldthrowForce then _G.OldthrowForce = readFloat(throwForce) end
    writeFloat(throwForce,1000)
  else
    if _G.OldthrowForce then writeFloat(throwForce,_G.OldthrowForce) _G.OldthrowForce=nil end
  end

  local health=getAddressSafe('[Player]+34')
  local maxHealth=getAddressSafe('[Player]+68')
  if health and ald('Infinite Health').Active==true then
    if not _G.Oldhealth then _G.Oldhealth = readInteger(health) end writeInteger(health,9999)
    if not _G.OldmaxHealth then _G.OldmaxHealth = readInteger(maxHealth) end writeInteger(maxHealth,9999)
  else
    if _G.Oldhealth then writeInteger(health,_G.Oldhealth) _G.Oldhealth=nil end
    if _G.OldmaxHealth then writeInteger(maxHealth,_G.OldmaxHealth) _G.OldmaxHealth=nil end
  end

  local meleeDamage=getAddressSafe('[Player]+280')
  if meleeDamage and ald('Increase Melee Damage').Active==true then
    if not _G.OldmeleeDamage then _G.OldmeleeDamage = readInteger(meleeDamage) end
    writeInteger(meleeDamage,9999)
  else
    if _G.OldmeleeDamage then writeInteger(meleeDamage,_G.OldmeleeDamage) _G.OldmeleeDamage=nil end
  end

  local dashCooldown=getAddressSafe('[Player]+298')
  if dashCooldown and ald('No Dash Cooldown').Active==true then
    if not _G.OlddashCooldown then _G.OlddashCooldown = readFloat(dashCooldown) end
    writeFloat(dashCooldown,0)
  else
    if _G.OlddashCooldown then writeFloat(dashCooldown,_G.OlddashCooldown) _G.OlddashCooldown=nil end
  end

  local dashPushForce=getAddressSafe('[Player]+2A8')
  if dashPushForce and ald('Increase Dash Push Force').Active==true then
    if not _G.OlddashPushForce then _G.OlddashPushForce = readFloat(dashPushForce) end
    writeFloat(dashPushForce,150)
  else
    if _G.OlddashPushForce then writeFloat(dashPushForce,_G.OlddashPushForce) _G.OlddashPushForce=nil end
  end

  local maxAutoAimDistance=getAddressSafe('[Player]+288')
  if maxAutoAimDistance and ald('Increase Auto Aim Distance').Active==true then
    if not _G.OldmaxAutoAimDistance then _G.OldmaxAutoAimDistance = readFloat(maxAutoAimDistance) end
    writeFloat(maxAutoAimDistance,9999)
  else
    if _G.OldmaxAutoAimDistance then writeFloat(maxAutoAimDistance,_G.OldmaxAutoAimDistance) _G.OldmaxAutoAimDistance=nil end
  end

  local numberOfCoins=getAddressSafe('[Player]+458')
  if numberOfCoins and ald('Infinite Space Coins').Active==true then
    if not _G.OldnumberOfCoins then _G.OldnumberOfCoins = readInteger(numberOfCoins) end
    writeInteger(numberOfCoins,999999)
  else
    if _G.OldnumberOfCoins then writeInteger(numberOfCoins,_G.OldnumberOfCoins) _G.OldnumberOfCoins=nil end
  end

  local numberOfPrintingMatter=getAddressSafe('[Player]+45C')
  if numberOfPrintingMatter and ald('Infinite Printing Matter').Active==true then
    if not _G.OldnumberOfPrintingMatter then _G.OldnumberOfPrintingMatter = readInteger(numberOfPrintingMatter) end
    writeInteger(numberOfPrintingMatter,999999)
  else
    if _G.OldnumberOfPrintingMatter then writeInteger(numberOfPrintingMatter,_G.OldnumberOfPrintingMatter) _G.OldnumberOfPrintingMatter=nil end
  end

  local currentRage=getAddressSafe('[[Player]+470]+70')
  local requiredRage=getAddressSafe('[[Player]+470]+38')
  if currentRage and ald('Can Always Rage').Active==true then
    if not _G.OldcurrentRage then _G.OldcurrentRage = readFloat(currentRage) if readFloat(currentRage) ~= readFloat(requiredRage) then writeFloat(currentRage,readFloat(requiredRage)) end end
    if readFloat(currentRage) == 0 then writeFloat(currentRage,readFloat(requiredRage)) end
  else
    if _G.OldcurrentRage then writeFloat(currentRage,_G.OldcurrentRage) _G.OldcurrentRage=nil end
  end

  local rageDuration=getAddressSafe('[[Player]+470]+18')
  if rageDuration and ald('Infinite Rage Duration').Active==true then
    if not _G.OldrageDuration then _G.OldrageDuration = readFloat(rageDuration) end
    writeFloat(rageDuration,999999)
  else
    if _G.OldrageDuration then writeFloat(rageDuration,_G.OldrageDuration) _G.OldrageDuration=nil end
  end

  local attackRate=getAddressSafe('[weapon]+2A0')
  if attackRate and ald('Rapid Fire').Active==true then writeFloat(attackRate,0.025) end

  local isInfinite=getAddressSafe('[weapon]+300')
  local isAutomatic=getAddressSafe('[weapon]+37C')
  local isOverheatable=getAddressSafe('[weapon]+37D')
  if isInfinite and ald('Bottomless Clip').Active==true then
    writeByte(isInfinite,1)
    writeByte(isAutomatic,1)
    writeByte(isOverheatable,0)
  end

  local damageMultiplier=getAddressSafe('[weapon]+438')
  if damageMultiplier and ald('Increase Damage Multiplier').Active==true then
    if not _G.OlddamageMultiplier then _G.OlddamageMultiplier = readFloat(damageMultiplier) end
    writeFloat(damageMultiplier,999)
  else
    if _G.OlddamageMultiplier then writeFloat(damageMultiplier,_G.OlddamageMultiplier) _G.OlddamageMultiplier=nil end
  end


end

