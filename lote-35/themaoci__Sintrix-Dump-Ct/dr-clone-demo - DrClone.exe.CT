            </CheatEntry>
            <CheatEntry>
              <ID>1337142791</ID>
              <Description>"Unreal 5 ESP w/ controller (bodycam)"</Description>
              <Options moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

-- ================= OFFSETS =================
local GWORLD_OFFSET       = 0x93CFB50 --gworld offset
local FNAMEPOOL_OFFSET    = 0x916FAC0 --fnamepool offset
local UOBJECT_NAME        = 0x18
local OWNING_GAME_INST    = 0x1D8 -- Uworld &gt;&gt; owningGameInstance - uGameInstance*
local LOCAL_PLAYERS       = 0x38 -- UGameInstance &gt;&gt; LocalPlayers
local ULOCAL_PLAYER_PC    = 0x30 -- UPlayer &gt;&gt; PlayerController
local PC_CAMERA_MGR       = 0x360 -- APlayerController &gt;&gt; PlayerCameraManager
local CAMERA_CACHE        = 0x1410 -- APlayerCameraManager &gt;&gt; CameraCachePrivate
local POV_OFFSET          = 0x10 -- FCameraCacheEntry &gt;&gt; POV
local PERSISTENT_LEVEL    = 0x30 -- UWorld &gt;&gt; PersistentLevel
local ACTORS              = 0xA0 -- try Ulevel &gt;&gt; Actors (usually +A0 or +98)
local ROOT_COMPONENT      = 0x1b8 -- AActor &gt;&gt; RootComponent
--local SCENE_COMPONENT     = 0X000 --USceneComponent
local CTW                 = 0x1D0 --try BoxReflectionCaptureComponent &gt;&gt; PhysicsVolumeChangedDelegate + 43
local CTW_X               = 0x20
local CTW_Y               = 0x28
local CTW_Z               = 0x30
local MESH                = 0x328 -- ACharacter &gt;&gt; Mesh
local CHAR_MOVEMENT       = 0x330 -- ACharacter &gt;&gt; CharacterMovement
local CAPSULE             = 0x338 -- ACharacter &gt;&gt; CapsuleComponent
local CAPSULE_HALF_HEIGHT = 0x508 -- UCapsuleComponent &gt;&gt; CapsuleHalfHeight
local CAPSULE_RADIUS      = 0x50c -- UCapsuleComponent &gt;&gt; CapsuleRadius
-- ===========================================

local CONFIG_NAME = "Bytrl_ESP_Config.txt"
local CONFIG_PATH = getCheatEngineDir() .. CONFIG_NAME

local function parseBool(v)
  return tostring(v):lower() == "true"
end

local function split(str, sep)
  local t = {}
  for s in str:gmatch("([^"..sep.."]+)") do t[#t+1] = s end
  return t
end

local function loadESPConfig()
  if not fileExists(CONFIG_PATH) then return end
  for line in io.lines(CONFIG_PATH) do
    local k, v = line:match("^(.-)=(.+)$")
    if k and v then
      if k == "EnableSnaplines" then _G.Bytrl_EnableSnaplines = parseBool(v)
      elseif k == "CircleSize"  then _G.Bytrl_CircleSize = tonumber(v)
      elseif k == "EspDistance" then _G.Bytrl_EspDistance = tonumber(v)
      elseif k == "DrawMode"    then _G.Bytrl_DrawMode = v
      elseif k == "ShowNames"   then _G.Bytrl_ShowNames = parseBool(v)
      elseif k == "NameSize"    then _G.Bytrl_NameSize = tonumber(v)
      elseif k == "DrawColor"   then
        local c = split(v, ",")
        if #c == 4 then
          _G.Bytrl_DrawColor = {tonumber(c[1]),tonumber(c[2]),tonumber(c[3]),tonumber(c[4])}
        end
      end
    end
  end
end

function saveESPConfig()
  local f = io.open(CONFIG_PATH, "w")
  if not f then return end
  local c = _G.Bytrl_DrawColor or {255,255,255,255}
  f:write("EnableSnaplines=" .. tostring(_G.Bytrl_EnableSnaplines) .. "\n")
  f:write("CircleSize="      .. tostring(_G.Bytrl_CircleSize)      .. "\n")
  f:write("DrawColor="       .. table.concat(c, ",")               .. "\n")
  f:write("EspDistance="     .. tostring(_G.Bytrl_EspDistance)     .. "\n")
  f:write("DrawMode="        .. tostring(_G.Bytrl_DrawMode)        .. "\n")
  f:write("ShowNames="       .. tostring(_G.Bytrl_ShowNames)       .. "\n")
  f:write("NameSize="        .. tostring(_G.Bytrl_NameSize)        .. "\n")
  f:close()
end

loadESPConfig()

_G.Bytrl_EspDistance     = _G.Bytrl_EspDistance     or 50.0
_G.Bytrl_CircleSize      = _G.Bytrl_CircleSize      or 12.0
_G.Bytrl_EnableSnaplines = _G.Bytrl_EnableSnaplines or false
_G.Bytrl_DrawColor       = _G.Bytrl_DrawColor       or {255, 0, 255, 255}
_G.Bytrl_DrawMode        = _G.Bytrl_DrawMode        or "box"
_G.Bytrl_ShowNames       = _G.Bytrl_ShowNames       or false
_G.Bytrl_NameSize        = _G.Bytrl_NameSize        or 12

local baseAddr   = getAddressSafe(process)
local GNamesPool = baseAddr + FNAMEPOOL_OFFSET

local function isValidPtr(ptr)
  if not ptr or ptr == 0 then return false end
  if ptr &lt; 0x1000000 then return false end
  if ptr &gt; 0x7FFFFFFFFFFF then return false end
  return true
end

local function getFName(nameIndex)
  local blockIndex = nameIndex &gt;&gt; 16
  local offset     = (nameIndex &amp; 0xFFFF) * 2
  -- skip first 0x10 bytes (metadata) to get to real blocks
  local block      = readPointer(GNamesPool + 0x10 + blockIndex * 0x8)
  if not block or block == 0 then return nil end
  local entry = block + offset
  local b0 = readByte(entry)
  local b1 = readByte(entry + 1)
  if not b0 or not b1 then return nil end
  local header = b0 + b1 * 256
  local len    = header &gt;&gt; 6
  local isWide = header &amp; 1
  if len &lt;= 0 or len &gt; 256 then return nil end
  if isWide == 1 then
    return readString(entry + 0x2, len * 2, true)
  else
    return readString(entry + 0x2, len, false)
  end
end

local function getActorName(actorPtr)
  local nameIndex = readInteger(actorPtr + UOBJECT_NAME)
  if not nameIndex then return "???" end
  return getFName(nameIndex) or "???"
end

local function isCharacter(actorPtr)
  if not isValidPtr(actorPtr) then return false end
  local mesh         = readPointer(actorPtr + MESH)
  local charMovement = readPointer(actorPtr + CHAR_MOVEMENT)
  local capsule      = readPointer(actorPtr + CAPSULE)
  return isValidPtr(mesh) and isValidPtr(charMovement) and isValidPtr(capsule)
end

local function worldToScreen(wx, wy, wz, camX, camY, camZ, pitch, yaw, fov, sw, sh)
  local URotationToRadians = math.pi / 180.0
  local fYaw   = yaw   * URotationToRadians
  local fPitch = pitch * URotationToRadians

  local axisX = {}
  axisX.x = math.cos(fYaw) * math.cos(fPitch)
  axisX.y = math.sin(fYaw) * math.cos(fPitch)
  axisX.z = math.sin(fPitch)

  local fYaw2 = (yaw + 89.8) * URotationToRadians
  local axisY = {}
  axisY.x = math.cos(fYaw2)
  axisY.y = math.sin(fYaw2)
  axisY.z = 0.0

  local fPitch3 = (pitch + 89.8) * URotationToRadians
  local axisZ = {}
  axisZ.x = math.cos(fYaw) * math.cos(fPitch3)
  axisZ.y = math.sin(fYaw) * math.cos(fPitch3)
  axisZ.z = math.sin(fPitch3)

  local dx = wx - camX
  local dy = wy - camY
  local dz = wz - camZ

  local tX = dx*axisY.x + dy*axisY.y + dz*axisY.z
  local tY = dx*axisZ.x + dy*axisZ.y + dz*axisZ.z
  local tZ = dx*axisX.x + dy*axisX.y + dz*axisX.z

  if tZ &lt; 1.0 then return 0, 0, false, 0 end

  local screenCenterX = sw * 0.5
  local screenCenterY = sh * 0.5
  local scale = screenCenterX / math.tan(fov * math.pi / 360.0)

  local sx  = screenCenterX + tX * scale / tZ
  local sy2 = screenCenterY - tY * scale / tZ

  if sx &lt; -sw or sx &gt; sw*2 then return 0, 0, false, 0 end
  if sy2 &lt; -sh or sy2 &gt; sh*2 then return 0, 0, false, 0 end

  return sx, sy2, true, tZ
end

[ENABLE]
enableOverlay()
overlaySetAutoClear(false)
overlaySetLabel("Bytrl")
_G.__espRunning = true

createThread(function()
  while _G.__espRunning do
    local sw = overlayGetWidth()
    local sh = overlayGetHeight()

    local drawMode    = _G.Bytrl_DrawMode
    local circleSize  = _G.Bytrl_CircleSize
    local enableSnap  = _G.Bytrl_EnableSnaplines
    local showNames   = _G.Bytrl_ShowNames
    local nameSize    = _G.Bytrl_NameSize
    local col         = _G.Bytrl_DrawColor
    local cr,cg,cb,ca = col[1],col[2],col[3],col[4]

    local GWorld = readPointer(baseAddr + GWORLD_OFFSET)
    if not GWorld or GWorld == 0 then sleep(10) end

    local OwningGameInstance  = readPointer(GWorld + OWNING_GAME_INST)
    local LocalPlayersData    = readPointer(OwningGameInstance + LOCAL_PLAYERS)
    local LocalPlayer0        = readPointer(LocalPlayersData + 0x0)
    local PlayerController    = readPointer(LocalPlayer0 + ULOCAL_PLAYER_PC)
    local PlayerCameraManager = readPointer(PlayerController + PC_CAMERA_MGR)

    if PlayerCameraManager and PlayerCameraManager ~= 0 then
      local POV   = PlayerCameraManager + CAMERA_CACHE + POV_OFFSET
      local camX  = readDouble(POV + 0x0)
      local camY  = readDouble(POV + 0x8)
      local camZ  = readDouble(POV + 0x10)
      local pitch = readDouble(POV + 0x18)
      local yaw   = readDouble(POV + 0x20)
      local fov   = readFloat(POV + 0x30)

      if camX and camY and camZ and pitch and yaw and fov then
        local PersistentLevel = readPointer(GWorld + PERSISTENT_LEVEL)
        local ActorsData      = readPointer(PersistentLevel + ACTORS)
        local ActorsCount     = readInteger(PersistentLevel + ACTORS + 0x8)

        if ActorsData and ActorsCount and ActorsCount &gt; 0 then
          local boxes = {}

          for i = 0, math.min(ActorsCount - 1, 2500) do
            local actorPtr = readPointer(ActorsData + i * 0x8)
            if actorPtr and actorPtr ~= 0 and isCharacter(actorPtr) then
              local RootComponent = readPointer(actorPtr + ROOT_COMPONENT)
              local CapsuleComp   = readPointer(actorPtr + CAPSULE)
              if isValidPtr(RootComponent) and isValidPtr(CapsuleComp) then
                local wx = readDouble(RootComponent + CTW + CTW_X)
                local wy = readDouble(RootComponent + CTW + CTW_Y)
                local wz = readDouble(RootComponent + CTW + CTW_Z)
                local halfHeight = readFloat(CapsuleComp + CAPSULE_HALF_HEIGHT) or 90.0
                local radius     = readFloat(CapsuleComp + CAPSULE_RADIUS) or 35.0

                if wx and wy and wz and halfHeight &gt; 0 and radius &gt; 0 then
                  local cx, cy2, cOk, tZ = worldToScreen(
                    wx, wy, wz, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  local _, topY, topOk = worldToScreen(
                    wx, wy, wz + halfHeight, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  local _, botY, botOk = worldToScreen(
                    wx, wy, wz - halfHeight, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  if cOk and topOk and botOk then
                    local boxH = botY - topY
                    local sc   = (sw * 0.5) / math.tan(fov * math.pi / 360.0)
                    local boxW = (radius / tZ) * sc
                    if boxH &gt; 2 then
                      local name = showNames and getActorName(actorPtr) or nil
                      boxes[#boxes + 1] = {
                        cx   = cx,
                        cy   = cy2,
                        x    = cx - boxW,
                        y    = topY,
                        w    = boxW * 2,
                        h    = boxH,
                        name = name
                      }
                    end
                  end
                end
              end
            end
          end

          overlayClear()

          for _, b in ipairs(boxes) do
            if drawMode == "box" then
              overlayDrawBox(b.x, b.y, b.w, b.h, cr, cg, cb)
            else
              overlayDrawCircle(b.cx, b.cy, circleSize, cr, cg, cb, ca, 2.0)
            end

            if enableSnap then
              overlayDrawLine(sw*0.5, sh, b.cx, b.cy, 1.0, cr, cg, cb, ca)
            end

            if showNames and b.name then
              local nw = (#b.name * nameSize) * 0.55
              overlayDrawText(b.cx - nw/2, b.y - nameSize - 2, b.name, nameSize, cr, cg, cb, ca)
            end
          end
        end
      end
    end

    sleep(10)
  end
end)

-- Controller UI
local form = createForm(false)
form.Caption = "Bytrl ESP Controller"
