if syntaxcheck then return end

--use printInstances(classname) to easily find instances

[ENABLE]

local class  = "SectionManager"
local method = "UpgradeStoreOrder"
local sectionManagerInstance=getAddressSafe('[[["GameAssembly.dll"+04683A10]+B8]+0]+0')

--this version is for mass changing 1x each instance
--cache_instances(class)
--mono_call(class, method, {{ type = vtDword, value = 10 }})

local function UpgradeStore(level)
    --this version is when u have an instance already (safe)
    mono_call(class, method, {{ type = vtDword, value = level }}, sectionManagerInstance)
end

UpgradeStore(1)
UpgradeStore(2)

resetClick(memrec)

