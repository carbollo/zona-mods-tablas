_G.Bytrl_NoClipEnabled=_G.Bytrl_NoClipEnabled or false

local fsform = createForm(false)
fsform.Caption = "Bytrl Flight Speed Controller"
fsform.Width = 320
fsform.Height = 110
fsform.Position = "poScreenCenter"

-- Shared flight speed
local lblSpeed = createLabel(fsform)
lblSpeed.Caption = "Flight speed: " .. _G.Bytrl_FlightSpeedxy
lblSpeed.Left = 10
lblSpeed.Top = 10

local sSpeed = createTrackBar(fsform)
sSpeed.Min = 500
sSpeed.Max = 3500
sSpeed.Position = _G.Bytrl_FlightSpeedxy
sSpeed.Left = 10
sSpeed.Top = lblSpeed.Top + 15
sSpeed.Width = 310
sSpeed.OnChange = function()
  _G.Bytrl_FlightSpeedxy = sSpeed.Position
  _G.Bytrl_FlightSpeedz = sSpeed.Position
  lblSpeed.Caption = "Flight speed (xy + z): " .. sSpeed.Position
end

-- No clip checkbox
local cbNoClip = createCheckBox(fsform)
cbNoClip.Caption = "Enable No Clip"
cbNoClip.Left = 10
cbNoClip.Top = sSpeed.Top + 35
cbNoClip.Checked = _G.Bytrl_NoClipEnabled
cbNoClip.OnClick = function()
  _G.Bytrl_NoClipEnabled = cbNoClip.Checked
end

fsform.OnClose = function()
  fsform.destroy()
  resetClick(memrec)
end

fsform.show()

[DISABLE]

if fsform then
  fsform.close()
  fsform = nil
end
