                  <ID>1337142592</ID>
                  <Description>"Flight speed"</Description>
                  <LastState/>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

_G.Bytrl_FlightSpeedxy=_G.Bytrl_FlightSpeedxy or 35
_G.Bytrl_FlightSpeedz=_G.Bytrl_FlightSpeedz or 35

local fsform = createForm(false)
fsform.Caption = "Bytrl Flight Speed Controller"
fsform.Width = 320
fsform.Height = 110
fsform.Position = "poScreenCenter"

-- Horizontal flight speed
local lblDist = createLabel(fsform)
lblDist.Caption = "Horizontal flight speed (xy axis): " .. _G.Bytrl_FlightSpeedxy
lblDist.Left = 10
lblDist.Top = 10

local sDist = createTrackBar(fsform)
sDist.Min = 1
sDist.Max = 100
sDist.Position = _G.Bytrl_FlightSpeedxy
sDist.Left = 10
sDist.Top = lblDist.Top + 15
sDist.Width = 310
sDist.OnChange = function()
  _G.Bytrl_FlightSpeedxy = sDist.Position
  lblDist.Caption = "horizontal flight speed: " .. sDist.Position
end

-- vertical flight speed
local lblDist2 = createLabel(fsform)
lblDist2.Caption = "Vertical flight speed (z axis): " .. _G.Bytrl_FlightSpeedz
lblDist2.Left = 10
lblDist2.Top = sDist.Top + 30

local sDist2 = createTrackBar(fsform)
sDist2.Min = 1
sDist2.Max = 100
sDist2.Position = _G.Bytrl_FlightSpeedz
sDist2.Left = 10
sDist2.Top = lblDist2.Top + 15
sDist2.Width = 310
sDist2.OnChange = function()
  _G.Bytrl_FlightSpeedz = sDist2.Position
  lblDist2.Caption = "vertical flight speed: " .. sDist2.Position
end

fsform.OnClose = function()
  fsform.destroy()
  resetClick(memrec)
end

fsform.show()

[DISABLE]

if fsform then
  fsform.close()
  fsform = nil
end

</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142152</ID>
              <Description>"Unity Flight Template 2 -Floats"</Description>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

flightTmr = createTimer()
flightTmr.Interval = 10
flightTmr.onTimer = function()

  local velocity_x = getAddressSafe('[pBase]+2dc')
  local velocity_y = getAddressSafe('[pBase]+2E4')
  local velocity_z = getAddressSafe('[pBase]+2E0')
  local yaw_addr   = getAddressSafe('[pBase]+2F4')
  local health     = getAddressSafe('[pBase]+34C')
  local isDeadFlag = getAddressSafe('[pBase]+350')
  local mass = getAddressSafe('[pBase]+2CC')

  if fall_timer and health and isDeadFlag and mass then
    writeFloat(health,9999)
    writeByte(isDeadFlag,0)
    writeFloat(mass,0)
  end

  if not (velocity_x and velocity_y and velocity_z and yaw_addr) then return end

  local yaw = readFloat(yaw_addr)
  yaw = math.rad(yaw) -- Degrees to radians if needed

  local speed = 50.0
  local flySpeed = 40.0

  local forward  = isKeyPressed(0x57) and 1 or 0 -- W
  local backward = isKeyPressed(0x53) and 1 or 0 -- S
  local left     = isKeyPressed(0x41) and 1 or 0 -- A
  local right    = isKeyPressed(0x44) and 1 or 0 -- D
  local up       = isKeyPressed(VK_SPACE) and 1 or 0
  local down     = isKeyPressed(VK_SHIFT) and 1 or 0

  local pad = getXBox360ControllerState(0)
  if pad then
    local deadzone = 8000
    local lx = math.abs(pad.ThumbLeftX) &gt; deadzone and pad.ThumbLeftX or 0
    local ly = math.abs(pad.ThumbLeftY) &gt; deadzone and pad.ThumbLeftY or 0

    forward  = ly &gt; 0 and 1 or forward
    backward = ly &lt; 0 and 1 or backward
    right    = lx &gt; 0 and 1 or right
    left     = lx &lt; 0 and 1 or left

    up   = pad.GAMEPAD_LEFT_SHOULDER and 1 or up
    down = pad.GAMEPAD_RIGHT_SHOULDER and 1 or down
  end

  local moveX, moveY, moveZ = 0, 0, 0

  local fb = forward - backward
  moveX = moveX + math.sin(yaw) * fb
  moveY = moveY + math.cos(yaw) * fb

  local lr = right - left
  moveX = moveX + math.sin(yaw + math.pi / 2) * lr
  moveY = moveY + math.cos(yaw + math.pi / 2) * lr

  local mag = math.sqrt(moveX * moveX + moveY * moveY)
  if mag &gt; 0 then
    moveX = (moveX / mag) * speed
    moveY = (moveY / mag) * speed
  end

  moveZ = (up - down) * flySpeed

  writeFloat(velocity_x, moveX)
  writeFloat(velocity_y, moveY)
  writeFloat(velocity_z, moveZ)
end



[DISABLE]
writeFloat(getAddressSafe('[pBase]+2CC'),2)
if flightTmr then flightTmr.destroy() flightTmr=nil end
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142181</ID>
              <Description>"Generic Flight Template -Floats"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local velocity_x=getAddressSafe('[pCords_reach]+230')
local velocity_y=getAddressSafe('[pCords_reach]+234')
local velocity_z=getAddressSafe('[pCords_reach]+238')
local yaw_addr=getAddressSafe('[yaw]+94')
local pitch_addr=getAddressSafe('[yaw]+98')

[ENABLE]

flightTmr=createTimer() flightTmr.Interval=10 flightTmr.onTimer=function()

  if not (velocity_x and velocity_y and velocity_z and yaw_addr) then return end
  local yaw = readFloat(yaw_addr)
  local speed = 20.0
  local flySpeed = 15.0
  local forward  = isKeyPressed(0x57) and 1 or 0     -- W
  local backward = isKeyPressed(0x53) and 1 or 0     -- S
  local left     = isKeyPressed(0x41) and 1 or 0     -- A
  local right    = isKeyPressed(0x44) and 1 or 0     -- D
  local up       = isKeyPressed(VK_SPACE) and 1 or 0 -- Space
  local down     = isKeyPressed(VK_SHIFT) and 1 or 0 -- Shift
  local pad = getXBox360ControllerState(0)
    if pad then
      local deadzone = 8000
      local lx = math.abs(pad.ThumbLeftX) &gt; deadzone and pad.ThumbLeftX or 0
      local ly = math.abs(pad.ThumbLeftY) &gt; deadzone and pad.ThumbLeftY or 0
      forward  = ly &gt; 0 and 1 or forward
      backward = ly &lt; 0 and 1 or backward
      right    = lx &gt; 0 and 1 or right
      left     = lx &lt; 0 and 1 or left
      up   = pad.GAMEPAD_LEFT_SHOULDER and 1 or up
      down = pad.GAMEPAD_RIGHT_SHOULDER and 1 or down
    end
  local moveX = 0
  local moveY = 0
  local moveZ = 0
  local fb = forward - backward
  moveX = moveX + math.cos(yaw) * fb
  moveY = moveY + math.sin(yaw) * fb
  local lr = right - left
  moveX = moveX + math.cos(yaw - math.pi / 2) * lr
  moveY = moveY + math.sin(yaw - math.pi / 2) * lr
  local mag = math.sqrt(moveX * moveX + moveY * moveY)
    if mag &gt; 0 then
      moveX = (moveX / mag) * speed
      moveY = (moveY / mag) * speed
    end
  moveZ = (up - down) * flySpeed
  writeFloat(velocity_x, moveX)
  writeFloat(velocity_y, moveY)
  writeFloat(velocity_z, moveZ)
end

[DISABLE]

if flightTmr then flightTmr.destroy() flightTmr=nil end

