        <CheatEntry>
          <ID>1337142798</ID>
          <Description>"Reminder this is for the BETA version of the game"</Description>
          <LastState Value="" RealAddress="00000000"/>
          <Color>0000FF</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>1337142594</ID>
          <Description>"Bin"</Description>
          <Options moHideChildren="1"/>
          <LastState Value="" RealAddress="00000000"/>
          <Color>C0C0C0</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1337142590</ID>
              <Description>"Teleport menu"</Description>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

tpm_s = memrec

local filePath = getCheatEngineDir() .. "Area51_locations.txt" --adjust this each title
local xCord=getAddressSafe('[pCords]+4')  --adjust this each title
local zCord=getAddressSafe('[pCords]+C')  --adjust this each title
local yCord=getAddressSafe('[pCords]+14') --adjust this each title

[ENABLE]

-- Main form setup
tpFRM = createForm(false)
tpFRM.Caption = "Teleport Menu"
tpFRM.Width = 300
tpFRM.Height = 45
tpFRM.Position = 'poScreenCenter'
tpFRM.Color = 0x000000 tpFRM.AlphaBlend = true tpFRM.AlphaBlendValue = 200
tpFRM.BorderStyle = 'bsDialog'

local defaultLocations = [[
--add default locations here
]]

local function createLocationsFile() if not fileExists(filePath) then local file = io.open(filePath, "w") if file then file:write(defaultLocations) file:close() end end end createLocationsFile()
local function readLocationsFromFile() local locations = {} if fileExists(filePath) then for line in io.lines(filePath) do local name, x, y, z = line:match("([^,]+),([^,]+),([^,]+),([^,]+)") if name and x and y and z then table.insert(locations, {name = name, x = tonumber(x), y = tonumber(y), z = tonumber(z)}) end end end return locations end
local function saveLocation(name, x, y, z) local file = io.open(filePath, "a") if file then file:write(string.format("%s,%.3f,%.3f,%.3f\n", name, x, y, z)) file:close() else print("Failed to open file: " .. filePath) end end

--Init vals
local coordx = 0 local coordy = 0 local coordz = 0

local locations = readLocationsFromFile()
local TeleportSelectiondropdown = createComboBox(tpFRM)
TeleportSelectiondropdown.Left = 1
TeleportSelectiondropdown.Top = 20
TeleportSelectiondropdown.Width = 150
TeleportSelectiondropdown.Height = 25
for _, loc in ipairs(locations) do TeleportSelectiondropdown.Items.add(loc.name) end

local TeleportSelectionEditor = createCheckBox(tpFRM)
TeleportSelectionEditor.Caption = 'Edit Dropdown Menu'
TeleportSelectionEditor.Left = 5
TeleportSelectionEditor.Top = TeleportSelectiondropdown.Top - 20
TeleportSelectionEditor.Width = 150
TeleportSelectionEditor.Height = 20
TeleportSelectionEditor.onClick=function()
  shellExecute(filePath)
  TeleportSelectionEditor.Checked=false
end

local TeleportButton = createButton(tpFRM)
TeleportButton.Caption = "Teleport"
TeleportButton.Left = TeleportSelectiondropdown.Left + TeleportSelectiondropdown.Width
TeleportButton.Top = TeleportSelectiondropdown.Top - 1
TeleportButton.Width = 75
TeleportButton.Height = 25
TeleportButton.OnClick = function()
    local selectedIndex = TeleportSelectiondropdown.ItemIndex
    if selectedIndex &gt;= 0 then
        locations = readLocationsFromFile()
        local loc = locations[selectedIndex + 1]
        if loc then
            writeFloat(xCord, loc.x)
            writeFloat(yCord, loc.y)
            writeFloat(zCord, loc.z)
        end
    end
end

-- Save location button
local TeleportSaveButton = createButton(tpFRM)
TeleportSaveButton.Caption = "Save"
TeleportSaveButton.Left = TeleportButton.Left + TeleportButton.Width - 1
TeleportSaveButton.Top = TeleportButton.Top
TeleportSaveButton.Width = TeleportButton.Width
TeleportSaveButton.Height = 25
TeleportSaveButton.OnClick = function()
    local name = inputQuery("Save Location", "Enter location name:", "")
    if name then
        coordx = readFloat(xCord) or 0
        coordy = readFloat(yCord) or 0
        coordz = readFloat(zCord) or 0
        saveLocation(name, coordx, coordy, coordz)
        TeleportSelectiondropdown.Items.add(name)
    end
end

tpFRM.OnClose = function()
    tpFRM.hide()
    tpm_s.Active = false
    return caFree
end

tpFRM.show()

[DISABLE]

tpFRM.hide() tpm_s=nil

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142561</ID>
              <Description>"Lua based ESP"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

-- ================= CONFIG =================
local CONFIG_NAME = "Bytrl_ESP_Config.txt"
local CONFIG_PATH = getCheatEngineDir() .. CONFIG_NAME

local function parseBool(v)
  return tostring(v):lower() == "true"
end

local function split(str, sep)
  local t = {}
  for s in str:gmatch("([^"..sep.."]+)") do
    t[#t+1] = s
  end
  return t
end

local function loadESPConfig()
  if not fileExists(CONFIG_PATH) then return end

  for line in io.lines(CONFIG_PATH) do
    local k, v = line:match("^(.-)=(.+)$")
    if k and v then
      if k == "EnableSnaplines" then _G.Bytrl_EnableSnaplines = parseBool(v)
      elseif k == "CircleSize" then _G.Bytrl_CircleSize = tonumber(v)
      elseif k == "EspDistance" then _G.Bytrl_EspDistance = tonumber(v)
      elseif k == "DrawMode" then _G.Bytrl_DrawMode = v
      elseif k == "ShowNames" then _G.Bytrl_ShowNames = parseBool(v)
      elseif k == "NameSize" then _G.Bytrl_NameSize = tonumber(v)
      elseif k == "DistMargin" then _G.Bytrl_DistMargin = tonumber(v)
      elseif k == "DrawColor" then
        local c = split(v, ",")
        if #c == 4 then
          _G.Bytrl_DrawColor = {
            tonumber(c[1]),
            tonumber(c[2]),
            tonumber(c[3]),
            tonumber(c[4])
          }
        end
      end
    end
  end
end

function saveESPConfig()
  local f = io.open(CONFIG_PATH, "w")
  if not f then return end

  local c = _G.Bytrl_DrawColor or {255,255,255,255}

  f:write("EnableSnaplines=" .. tostring(_G.Bytrl_EnableSnaplines) .. "\n")
  f:write("CircleSize=" .. tostring(_G.Bytrl_CircleSize) .. "\n")
  f:write("DrawColor=" .. table.concat(c, ",") .. "\n")
  f:write("EspDistance=" .. tostring(_G.Bytrl_EspDistance) .. "\n")
  f:write("DrawMode=" .. tostring(_G.Bytrl_DrawMode) .. "\n")
  f:write("ShowNames=" .. tostring(_G.Bytrl_ShowNames) .. "\n")
  f:write("NameSize=" .. tostring(_G.Bytrl_NameSize) .. "\n")
  f:write("DistMargin=" .. tostring(_G.Bytrl_DistMargin) .. "\n")

  f:close()
end
-- =========================================


-- ===========Defaults============
local MAX_ENTS = 200
local W_CLIP_MIN = 0.001
local MAX_SNAPLINES = 75
local DIST_MARGIN = 50.0
local frameEntities = {}
local FRAME_UPDATE_MS = 10
local lastFrameUpdate = 0

loadESPConfig()

if _G.Bytrl_EnableSnaplines == nil then _G.Bytrl_EnableSnaplines = true end
if _G.Bytrl_CircleSize == nil then _G.Bytrl_CircleSize = 12.0 end
if _G.Bytrl_DrawColor == nil then _G.Bytrl_DrawColor = {126,230,51,255} end
if _G.Bytrl_EspDistance == nil then _G.Bytrl_EspDistance = 40.0 end
if _G.Bytrl_DrawMode == nil then _G.Bytrl_DrawMode = "box" end
if _G.Bytrl_ShowNames == nil then _G.Bytrl_ShowNames = true end
if _G.Bytrl_NameSize == nil then _G.Bytrl_NameSize = 12 end

--Ent bbox locals
local BBOX_MIN_Y = 0x298
local BBOX_MIN_X = 0x29C
local BBOX_MIN_Z = 0x2B4
local BBOX_MAX_X = 0x2A0
local BBOX_MAX_Y = 0x2A4
local BBOX_MAX_Z = 0x2B8

local m16 = {}
local entityVisibility = {}
local entityNameCache = {}
local NAME_REFRESH_MS = 500

local function readMatrix4x4_into(addr, out16)
  for i=0,15 do
    local v = readFloat(addr + i*4)
    if not v then return false end
    out16[i+1] = v
  end
  return true
end

local function w2s_matrix_xzy_raw(x, y_up, z_fwd, m, sw, sh)
  local clipX = x*m[1] + y_up*m[5] + z_fwd*m[9] + m[13]
  local clipY = x*m[2] + y_up*m[6] + z_fwd*m[10] + m[14]
  local clipW = x*m[4] + y_up*m[8] + z_fwd*m[12] + m[16]
  if not clipW or clipW &lt;= W_CLIP_MIN then return 0,0,false end
  local ndcX = clipX / clipW
  local ndcY = clipY / clipW
  local sx = (ndcX*0.5+0.5)*sw
  local sy = (1-(ndcY*0.5+0.5))*sh
  return sx, sy, true
end

local function drawCircle(x,y,r,r1,g,b,a)
  overlayDrawCircle(x,y,r,r1,g,b,a,2.0)
end

local function readEntityBBoxLocal(entPtr)
  local minx = readFloat(entPtr + BBOX_MIN_X)
  local miny = readFloat(entPtr + BBOX_MIN_Y)
  local minz = readFloat(entPtr + BBOX_MIN_Z)
  local maxx = readFloat(entPtr + BBOX_MAX_X)
  local maxy = readFloat(entPtr + BBOX_MAX_Y)
  local maxz = readFloat(entPtr + BBOX_MAX_Z)
  if not (minx and miny and minz and maxx and maxy and maxz) then return nil end
  if minx &gt; maxx then minx,maxx=maxx,minx end
  if miny &gt; maxy then miny,maxy=maxy,miny end
  if minz &gt; maxz then minz,maxz=maxz,minz end
  return minx,miny,minz,maxx,maxy,maxz
end

local function projectBBoxScreen(entPtr, x, y, z, m, sw, sh)
  local minx,miny,minz,maxx,maxy,maxz = readEntityBBoxLocal(entPtr)
  if not minx then return nil end

  local corners = {
    {x+minx, y+minz, z+miny},
    {x+maxx, y+minz, z+miny},
    {x+minx, y+minz, z+maxy},
    {x+maxx, y+minz, z+maxy},
    {x+minx, y+maxz, z+miny},
    {x+maxx, y+maxz, z+miny},
    {x+minx, y+maxz, z+maxy},
    {x+maxx, y+maxz, z+maxy},
  }

  local minSX, minSY = math.huge, math.huge
  local maxSX, maxSY = -math.huge, -math.huge
  local any = false

  for _,c in ipairs(corners) do
    local sx, sy, ok = w2s_matrix_xzy_raw(
      c[1],
      c[3],
      c[2],
      m, sw, sh
    )
    if ok then
      any = true
      if sx &lt; minSX then minSX = sx end
      if sy &lt; minSY then minSY = sy end
      if sx &gt; maxSX then maxSX = sx end
      if sy &gt; maxSY then maxSY = sy end
    end
  end

  if not any then return nil end

  local w = maxSX - minSX
  local h = maxSY - minSY
  if w &lt;= 1 or h &lt;= 1 then return nil end

  return minSX, minSY, w, h
end

local function tryReadEntityName(entPtr)
  local nameStruct = readPointer(entPtr + 0x98)
  if not nameStruct then return nil end

  local nameBuf = readPointer(nameStruct + 0x8)
  if not nameBuf then return nil end

  local raw = readString(nameBuf + 0xC, 64, true)
  if not raw or raw == "" then return nil end

  local clean = raw:gsub("[^%w_%-%s]", ""):match("^%s*(.-)%s*$")
  if not clean or #clean &lt; 2 or #clean &gt; 32 then return nil end

  return clean
end

local function getPlayerName(entPtr)
  local nameBase = readPointer(entPtr + 0x100)
  if not nameBase then return nil end
  local name = readString(nameBase + 0xC, 32, true) -- unicode
  if not name or name == "" then return nil end
  local clean = name:gsub("[^%w_%-%s]", ""):match("^%s*(.-)%s*$")
  if not clean or #clean &lt; 2 or #clean &gt; 32 then return nil end
  return clean
end

local function getEntityNameCached(entPtr)
  local now = getTickCount()
  local cached = entityNameCache[entPtr]

  if cached and (now - cached.time) &lt; NAME_REFRESH_MS then
    return cached.name
  end

  local playerName = getPlayerName(entPtr)
  if playerName then
    entityNameCache[entPtr] = {
      name = playerName,
      time = now
    }
    return playerName
  end

  local nameStruct = readPointer(entPtr + 0x98)
  if not nameStruct then return cached and cached.name end

  local nameBuf = readPointer(nameStruct + 0x8)
  if not nameBuf then return cached and cached.name end

  local raw = readString(nameBuf + 0xC, 64, true)
  if not raw or raw == "" then return cached and cached.name end

  local clean = raw:gsub("[^%w_%-%s]", ""):match("^%s*(.-)%s*$")
  if not clean or #clean &lt; 2 or #clean &gt; 32 then
    return cached and cached.name
  end

  entityNameCache[entPtr] = {
    name = clean,
    time = now
  }

  return clean
end

local function drawNameCentered(x,y,name,size,r,g,b,a)
  local w=(#name*size)*0.55
  overlayDrawText(x-w/2,y,name,size,r,g,b,a)
end

[ENABLE]

overlaySetAutoClear(false)
overlaySetLabel("Bytrl")
_G.__bytrlHardESPThread=true

createThread(function()
  while _G.__bytrlHardESPThread do
    overlayClear()

    local drawMode=_G.Bytrl_DrawMode
    local circleSize=_G.Bytrl_CircleSize
    local espDist=_G.Bytrl_EspDistance
    local margin=_G.Bytrl_DistMargin
    local showNames=_G.Bytrl_ShowNames
    local nameSize=_G.Bytrl_NameSize
    local enableSnap=_G.Bytrl_EnableSnaplines

    local col=_G.Bytrl_DrawColor
    local cr,cg,cb,ca=col[1],col[2],col[3],col[4]

    local viewAddr=getAddressSafe('[[[GameInstance]+10]+70]+480')
    if viewAddr and readMatrix4x4_into(viewAddr,m16) then
      local sw,sh=overlayGetWidth(),overlayGetHeight()
      local entityArray=getAddressSafe('[[[GameInstance]+10]+138]+58')
      local basePtr=readPointer(entityArray or 0)
      if basePtr then
        local localPlayer=readPointer(basePtr+0x10) or 0
        local start=basePtr+0x28
        local lpX=readFloat(localPlayer+0x270)
        local lpZ=readFloat(localPlayer+0x274)
        local maxDist2 = espDist * espDist
        local maxExit2 = (espDist + DIST_MARGIN) * (espDist + DIST_MARGIN)
        local snapCount=0

        for i=0,MAX_ENTS-1 do
          local entPtr=readPointer(start+i*8)
          if entPtr and entPtr~=localPlayer then
            local x=readFloat(entPtr+0x270)
            local z=readFloat(entPtr+0x274)
            local y=readFloat(entPtr+0x278)
            if x and y and z then

            local name = getEntityNameCached(entPtr)
            if name then

              local dx,dz=x-lpX,z-lpZ
              local dist2=dx*dx+dz*dz
              local vis=entityVisibility[entPtr]

              if not vis and dist2&lt;=maxDist2 then vis=true
              elseif vis and dist2&gt;maxExit2 then vis=false end
              entityVisibility[entPtr]=vis

              if vis then
                local sx,sy,ok=w2s_matrix_xzy_raw(x,z,y,m16,sw,sh)
                if ok then
                  local anchorX,anchorY=sx,sy

                  if drawMode=="box" then
                    local bx,by,bw,bh=projectBBoxScreen(entPtr,x,y,z,m16,sw,sh)
                    if bx then
                      overlayDrawBox(bx,by,bw,bh,cr,cg,cb)
                      anchorX=bx+bw/2
                      anchorY=by+bh
                    else
                      drawCircle(sx,sy,circleSize,cr,cg,cb,ca)
                      anchorY=sy+circleSize
                    end
                  else
                    drawCircle(sx,sy,circleSize,cr,cg,cb,ca)
                    anchorY=sy+circleSize
                  end

                  if showNames then
                    drawNameCentered(anchorX,anchorY+2,name,nameSize,cr,cg,cb,ca)
                  end


                  if enableSnap and snapCount&lt;MAX_SNAPLINES then
                    snapCount=snapCount+1
                    overlayDrawLine(sw*0.5,sh*0.95,sx,sy,1.0,cr,cg,cb,ca)
                  end
                end
              end
            end
          end
        end
      end
    end
   sleep(15)
  end
 end
end)

[DISABLE]
entityVisibility=nil
_G.__bytrlHardESPThread=false
_G.Bytrl_EnableSnaplines=nil
_G.Bytrl_CircleSize=nil
_G.Bytrl_DrawColor=nil
_G.Bytrl_EspDistance=nil
_G.Bytrl_DrawMode=nil
_G.Bytrl_ShowNames=nil
_G.Bytrl_NameSize=nil
entityNameCache=nil
DIST_MARGIN=nil
overlayClear()
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337142562</ID>
                  <Description>"esp settings"</Description>
                  <LastState/>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

_G.Bytrl_EspDistance      = _G.Bytrl_EspDistance      or 50.0
_G.Bytrl_CircleSize       = _G.Bytrl_CircleSize       or 12.0
_G.Bytrl_EnableSnaplines  = _G.Bytrl_EnableSnaplines  or false
_G.Bytrl_DrawColor        = _G.Bytrl_DrawColor        or {255,255,255,255}
_G.Bytrl_DrawMode         = _G.Bytrl_DrawMode         or "circle"
_G.Bytrl_ShowNames        = _G.Bytrl_ShowNames        or false
_G.Bytrl_NameSize         = _G.Bytrl_NameSize         or 12

local form = createForm(false)
form.Caption = "Bytrl ESP Controller"
form.Width = 340
form.Height = 210
form.Position = "poScreenCenter"

-- ESP Distance
local lblDist = createLabel(form)
lblDist.Caption = "ESP Distance: " .. _G.Bytrl_EspDistance
lblDist.Left = 10
lblDist.Top = 10

local sDist = createTrackBar(form)
sDist.Min = 10
sDist.Max = 300
sDist.Position = _G.Bytrl_EspDistance
sDist.Left = 10
sDist.Top = lblDist.Top + 15
sDist.Width = 310
sDist.OnChange = function()
  _G.Bytrl_EspDistance = sDist.Position
  lblDist.Caption = "ESP Distance: " .. sDist.Position
  saveESPConfig()
end

--Circle Size (only used in circle mode)
local lblSize = createLabel(form)
lblSize.Caption = "Circle Size: " .. _G.Bytrl_CircleSize
lblSize.Left = 10
lblSize.Top = sDist.Top + 30

--circle size trackbar
local sSize = createTrackBar(form)
sSize.Min = 2
sSize.Max = 60
sSize.Position = _G.Bytrl_CircleSize
sSize.Left = 10
sSize.Top = lblSize.Top + 15
sSize.Width = 310
sSize.OnChange = function()
  _G.Bytrl_CircleSize = sSize.Position
  lblSize.Caption = "Circle Size: " .. sSize.Position
  saveESPConfig()
end

--use boxes
local cbBoxes = createCheckBox(form)
cbBoxes.Caption = "Use Boxes (unchecked = Circles)"
cbBoxes.Left = 10
cbBoxes.Top = sSize.Top + 20
cbBoxes.Checked = (_G.Bytrl_DrawMode == "box")
cbBoxes.OnChange = function()
  _G.Bytrl_DrawMode = cbBoxes.Checked and "box" or "circle"
  saveESPConfig()
end

--use snaplines
local cbSnap = createCheckBox(form)
cbSnap.Caption = "Enable Snaplines"
cbSnap.Left = 10
cbSnap.Top = cbBoxes.Top + 20
cbSnap.Checked = _G.Bytrl_EnableSnaplines
cbSnap.OnChange = function()
  _G.Bytrl_EnableSnaplines = cbSnap.Checked
  saveESPConfig()
end

--show names
local cbNames = createCheckBox(form)
cbNames.Caption = "Show Entity Names"
cbNames.Left = 10
cbNames.Top = cbSnap.Top + 20
cbNames.Checked = _G.Bytrl_ShowNames
cbNames.OnChange = function()
  _G.Bytrl_ShowNames = cbNames.Checked
  saveESPConfig()
end

--name size
local lblNameSize = createLabel(form)
lblNameSize.Caption = "Name Size: " .. _G.Bytrl_NameSize
lblNameSize.Left = 10
lblNameSize.Top = cbNames.Top + 20

local sNameSize = createTrackBar(form)
sNameSize.Min = 8
sNameSize.Max = 32
sNameSize.Position = _G.Bytrl_NameSize
sNameSize.Left = 10
sNameSize.Top = lblNameSize.Top + 15
sNameSize.Width = 310
sNameSize.OnChange = function()
  _G.Bytrl_NameSize = sNameSize.Position
  lblNameSize.Caption = "Name Size: " .. sNameSize.Position
  saveESPConfig()
end

--color pickr
local function CEColorToRGBA(c)
  local r = c &amp; 0xFF
  local g = (c &gt;&gt; 8) &amp; 0xFF
  local b = (c &gt;&gt; 16) &amp; 0xFF
  return r, g, b, 255
end

local btnColor = createButton(form)
btnColor.Caption = "Pick ESP Color"
btnColor.Left = 170
btnColor.Top = cbSnap.Top + 10
btnColor.Width = 130
btnColor.Height = 30
btnColor.OnClick = function()
  local cd = createColorDialog()
  if cd.execute() then
    local c = cd.Color
    local r, g, b, a = CEColorToRGBA(c)
    _G.Bytrl_DrawColor = {r, g, b, a}
  end
  saveESPConfig()
end

form.OnClose = function()
  form.destroy()
  resetClick(memrec)
end

form.show()

[DISABLE]

if form then
  form.close()
  form = nil
end

</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142784</ID>
              <Description>"Unreal 5 ESP"</Description>
              <Options moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

-- ================= OFFSETS =================
local GWORLD_OFFSET       = 0x820BFF0
local OWNING_GAME_INST    = 0x1D8
local LOCAL_PLAYERS       = 0x38
local ULOCAL_PLAYER_PC    = 0x30
local PC_CAMERA_MGR       = 0x348
local CAMERA_CACHE        = 0x1390
local POV_OFFSET          = 0x10
local PERSISTENT_LEVEL    = 0x30
local ACTORS              = 0xA0
local ROOT_COMPONENT      = 0x1A0
local CTW                 = 0x1D0
local CTW_X               = 0x20
local CTW_Y               = 0x28
local CTW_Z               = 0x30
local MESH                = 0x318
local CHAR_MOVEMENT       = 0x320
local CAPSULE             = 0x328
local CAPSULE_HALF_HEIGHT = 0x540
local CAPSULE_RADIUS      = 0x544
-- ===========================================

local CONFIG_NAME = "Bytrl_ESP_Config.txt"
local CONFIG_PATH = getCheatEngineDir() .. CONFIG_NAME

local function parseBool(v)
  return tostring(v):lower() == "true"
end

local function split(str, sep)
  local t = {}
  for s in str:gmatch("([^"..sep.."]+)") do t[#t+1] = s end
  return t
end

local function loadESPConfig()
  if not fileExists(CONFIG_PATH) then return end
  for line in io.lines(CONFIG_PATH) do
    local k, v = line:match("^(.-)=(.+)$")
    if k and v then
      if k == "EnableSnaplines" then _G.Bytrl_EnableSnaplines = parseBool(v)
      elseif k == "CircleSize"  then _G.Bytrl_CircleSize = tonumber(v)
      elseif k == "EspDistance" then _G.Bytrl_EspDistance = tonumber(v)
      elseif k == "DrawMode"    then _G.Bytrl_DrawMode = v
      elseif k == "ShowNames"   then _G.Bytrl_ShowNames = parseBool(v)
      elseif k == "NameSize"    then _G.Bytrl_NameSize = tonumber(v)
      elseif k == "DrawColor"   then
        local c = split(v, ",")
        if #c == 4 then
          _G.Bytrl_DrawColor = {tonumber(c[1]),tonumber(c[2]),tonumber(c[3]),tonumber(c[4])}
        end
      end
    end
  end
end

function saveESPConfig()
  local f = io.open(CONFIG_PATH, "w")
  if not f then return end
  local c = _G.Bytrl_DrawColor or {255,255,255,255}
  f:write("EnableSnaplines=" .. tostring(_G.Bytrl_EnableSnaplines) .. "\n")
  f:write("CircleSize="      .. tostring(_G.Bytrl_CircleSize)      .. "\n")
  f:write("DrawColor="       .. table.concat(c, ",")               .. "\n")
  f:write("EspDistance="     .. tostring(_G.Bytrl_EspDistance)     .. "\n")
  f:write("DrawMode="        .. tostring(_G.Bytrl_DrawMode)        .. "\n")
  f:write("ShowNames="       .. tostring(_G.Bytrl_ShowNames)       .. "\n")
  f:write("NameSize="        .. tostring(_G.Bytrl_NameSize)        .. "\n")
  f:close()
end

loadESPConfig()

_G.Bytrl_EspDistance     = _G.Bytrl_EspDistance     or 50.0
_G.Bytrl_CircleSize      = _G.Bytrl_CircleSize      or 12.0
_G.Bytrl_EnableSnaplines = _G.Bytrl_EnableSnaplines or false
_G.Bytrl_DrawColor       = _G.Bytrl_DrawColor       or {255, 0, 255, 255}
_G.Bytrl_DrawMode        = _G.Bytrl_DrawMode        or "box"
_G.Bytrl_ShowNames       = _G.Bytrl_ShowNames       or false
_G.Bytrl_NameSize        = _G.Bytrl_NameSize        or 12

local baseAddr = getAddressSafe(process)

local function isValidPtr(ptr)
  if not ptr or ptr == 0 then return false end
  if ptr &lt; 0x1000000 then return false end
  if ptr &gt; 0x7FFFFFFFFFFF then return false end
  return true
end

local function isCharacter(actorPtr)
  if not isValidPtr(actorPtr) then return false end
  local mesh         = readPointer(actorPtr + MESH)
  local charMovement = readPointer(actorPtr + CHAR_MOVEMENT)
  local capsule      = readPointer(actorPtr + CAPSULE)
  return isValidPtr(mesh) and isValidPtr(charMovement) and isValidPtr(capsule)
end

local function worldToScreen(wx, wy, wz, camX, camY, camZ, pitch, yaw, fov, sw, sh)
  local URotationToRadians = math.pi / 180.0
  local fYaw   = yaw   * URotationToRadians
  local fPitch = pitch * URotationToRadians

  local axisX = {}
  axisX.x = math.cos(fYaw) * math.cos(fPitch)
  axisX.y = math.sin(fYaw) * math.cos(fPitch)
  axisX.z = math.sin(fPitch)

  local fYaw2 = (yaw + 89.8) * URotationToRadians
  local axisY = {}
  axisY.x = math.cos(fYaw2)
  axisY.y = math.sin(fYaw2)
  axisY.z = 0.0

  local fPitch3 = (pitch + 89.8) * URotationToRadians
  local axisZ = {}
  axisZ.x = math.cos(fYaw) * math.cos(fPitch3)
  axisZ.y = math.sin(fYaw) * math.cos(fPitch3)
  axisZ.z = math.sin(fPitch3)

  local dx = wx - camX
  local dy = wy - camY
  local dz = wz - camZ

  local tX = dx*axisY.x + dy*axisY.y + dz*axisY.z
  local tY = dx*axisZ.x + dy*axisZ.y + dz*axisZ.z
  local tZ = dx*axisX.x + dy*axisX.y + dz*axisX.z

  if tZ &lt; 1.0 then return 0, 0, false, 0 end

  local screenCenterX = sw * 0.5
  local screenCenterY = sh * 0.5
  local scale = screenCenterX / math.tan(fov * math.pi / 360.0)

  local sx  = screenCenterX + tX * scale / tZ
  local sy2 = screenCenterY - tY * scale / tZ

  if sx &lt; -sw or sx &gt; sw*2 then return 0, 0, false, 0 end
  if sy2 &lt; -sh or sy2 &gt; sh*2 then return 0, 0, false, 0 end

  return sx, sy2, true, tZ
end

[ENABLE]
enableOverlay()
overlaySetAutoClear(false)
overlaySetLabel("Bytrl")
_G.__espRunning = true

createThread(function()
  while _G.__espRunning do
    local sw = overlayGetWidth()
    local sh = overlayGetHeight()

    local drawMode     = _G.Bytrl_DrawMode
    local circleSize   = _G.Bytrl_CircleSize
    local enableSnap   = _G.Bytrl_EnableSnaplines
    local showNames    = _G.Bytrl_ShowNames
    local nameSize     = _G.Bytrl_NameSize
    local col          = _G.Bytrl_DrawColor
    local cr,cg,cb,ca  = col[1],col[2],col[3],col[4]

    local GWorld = readPointer(baseAddr + GWORLD_OFFSET)
    if not GWorld or GWorld == 0 then sleep(10) end

    local OwningGameInstance  = readPointer(GWorld + OWNING_GAME_INST)
    local LocalPlayersData    = readPointer(OwningGameInstance + LOCAL_PLAYERS)
    local LocalPlayer0        = readPointer(LocalPlayersData + 0x0)
    local PlayerController    = readPointer(LocalPlayer0 + ULOCAL_PLAYER_PC)
    local PlayerCameraManager = readPointer(PlayerController + PC_CAMERA_MGR)

    if PlayerCameraManager and PlayerCameraManager ~= 0 then
      local POV   = PlayerCameraManager + CAMERA_CACHE + POV_OFFSET
      local camX  = readDouble(POV + 0x0)
      local camY  = readDouble(POV + 0x8)
      local camZ  = readDouble(POV + 0x10)
      local pitch = readDouble(POV + 0x18)
      local yaw   = readDouble(POV + 0x20)
      local fov   = readFloat(POV + 0x30)

      if camX and camY and camZ and pitch and yaw and fov then
        local PersistentLevel = readPointer(GWorld + PERSISTENT_LEVEL)
        local ActorsData      = readPointer(PersistentLevel + ACTORS)
        local ActorsCount     = readInteger(PersistentLevel + ACTORS + 0x8)

        if ActorsData and ActorsCount and ActorsCount &gt; 0 then
          local boxes = {}

          for i = 0, math.min(ActorsCount - 1, 2500) do
            local actorPtr = readPointer(ActorsData + i * 0x8)
            if actorPtr and actorPtr ~= 0 and isCharacter(actorPtr) then
              local RootComponent = readPointer(actorPtr + ROOT_COMPONENT)
              local CapsuleComp   = readPointer(actorPtr + CAPSULE)
              if isValidPtr(RootComponent) and isValidPtr(CapsuleComp) then
                local wx = readDouble(RootComponent + CTW + CTW_X)
                local wy = readDouble(RootComponent + CTW + CTW_Y)
                local wz = readDouble(RootComponent + CTW + CTW_Z)
                local halfHeight = readFloat(CapsuleComp + CAPSULE_HALF_HEIGHT) or 90.0
                local radius     = readFloat(CapsuleComp + CAPSULE_RADIUS) or 35.0

                if wx and wy and wz and halfHeight &gt; 0 and radius &gt; 0 then
                  local cx, cy2, cOk, tZ = worldToScreen(
                    wx, wy, wz, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  local _, topY, topOk = worldToScreen(
                    wx, wy, wz + halfHeight, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  local _, botY, botOk = worldToScreen(
                    wx, wy, wz - halfHeight, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  if cOk and topOk and botOk then
                    local boxH = botY - topY
                    local scale = (sw * 0.5) / math.tan(fov * math.pi / 360.0)
                    local boxW  = (radius / tZ) * scale
                    if boxH &gt; 2 then
                      boxes[#boxes + 1] = {
                        cx = cx, cy = cy2,
                        x = cx - boxW, y = topY,
                        w = boxW * 2, h = boxH
                      }
                    end
                  end
                end
              end
            end
          end

          -- clear and draw all at once
          overlayClear()

          for _, b in ipairs(boxes) do
            if drawMode == "box" then
              overlayDrawBox(b.x, b.y, b.w, b.h, cr, cg, cb)
            else
              overlayDrawCircle(b.cx, b.cy, circleSize, cr, cg, cb, ca, 2.0)
            end

            if enableSnap then
              overlayDrawLine(sw*0.5, sh, b.cx, b.cy, 1.0, cr, cg, cb, ca)
            end

            if showNames then
              local name = "Entity"
              local nw = (#name * nameSize) * 0.55
              overlayDrawText(b.cx - nw/2, b.y - nameSize - 2, name, nameSize, cr, cg, cb, ca)
            end
          end
        end
      end
    end

    sleep(10)
  end
end)

-- Controller UI
local form = createForm(false)
form.Caption = "Bytrl ESP Controller"
form.Width = 340
form.Height = 210
form.Position = "poScreenCenter"

local lblDist = createLabel(form)
lblDist.Caption = "ESP Distance: " .. _G.Bytrl_EspDistance
lblDist.Left = 10
lblDist.Top = 10

local sDist = createTrackBar(form)
sDist.Min = 10
sDist.Max = 300
sDist.Position = _G.Bytrl_EspDistance
sDist.Left = 10
sDist.Top = lblDist.Top + 15
sDist.Width = 310
sDist.OnChange = function()
  _G.Bytrl_EspDistance = sDist.Position
  lblDist.Caption = "ESP Distance: " .. sDist.Position
  saveESPConfig()
end

local lblSize = createLabel(form)
lblSize.Caption = "Circle Size: " .. _G.Bytrl_CircleSize
lblSize.Left = 10
lblSize.Top = sDist.Top + 30

local sSize = createTrackBar(form)
sSize.Min = 2
sSize.Max = 60
sSize.Position = _G.Bytrl_CircleSize
sSize.Left = 10
sSize.Top = lblSize.Top + 15
sSize.Width = 310
sSize.OnChange = function()
  _G.Bytrl_CircleSize = sSize.Position
  lblSize.Caption = "Circle Size: " .. sSize.Position
  saveESPConfig()
end

local cbBoxes = createCheckBox(form)
cbBoxes.Caption = "Use Boxes (unchecked = Circles)"
cbBoxes.Left = 10
cbBoxes.Top = sSize.Top + 20
cbBoxes.Checked = (_G.Bytrl_DrawMode == "box")
cbBoxes.OnChange = function()
  _G.Bytrl_DrawMode = cbBoxes.Checked and "box" or "circle"
  saveESPConfig()
end

local cbSnap = createCheckBox(form)
cbSnap.Caption = "Enable Snaplines"
cbSnap.Left = 10
cbSnap.Top = cbBoxes.Top + 20
cbSnap.Checked = _G.Bytrl_EnableSnaplines
cbSnap.OnChange = function()
  _G.Bytrl_EnableSnaplines = cbSnap.Checked
  saveESPConfig()
end

local cbNames = createCheckBox(form)
cbNames.Caption = "Show Entity Names"
cbNames.Left = 10
cbNames.Top = cbSnap.Top + 20
cbNames.Checked = _G.Bytrl_ShowNames
cbNames.OnChange = function()
  _G.Bytrl_ShowNames = cbNames.Checked
  saveESPConfig()
end

local lblNameSize = createLabel(form)
lblNameSize.Caption = "Name Size: " .. _G.Bytrl_NameSize
lblNameSize.Left = 10
lblNameSize.Top = cbNames.Top + 20

local sNameSize = createTrackBar(form)
sNameSize.Min = 8
sNameSize.Max = 32
sNameSize.Position = _G.Bytrl_NameSize
sNameSize.Left = 10
sNameSize.Top = lblNameSize.Top + 15
sNameSize.Width = 310
sNameSize.OnChange = function()
  _G.Bytrl_NameSize = sNameSize.Position
  lblNameSize.Caption = "Name Size: " .. sNameSize.Position
  saveESPConfig()
end

local function CEColorToRGBA(c)
  local r = c &amp; 0xFF
  local g = (c &gt;&gt; 8) &amp; 0xFF
  local b = (c &gt;&gt; 16) &amp; 0xFF
  return r, g, b, 255
end

local btnColor = createButton(form)
btnColor.Caption = "Pick ESP Color"
btnColor.Left = 170
btnColor.Top = cbSnap.Top + 10
btnColor.Width = 130
btnColor.Height = 30
btnColor.OnClick = function()
  local cd = createColorDialog()
  if cd.execute() then
    local c = cd.Color
    local r, g, b, a = CEColorToRGBA(c)
    _G.Bytrl_DrawColor = {r, g, b, a}
  end
  saveESPConfig()
end

form.OnClose = function()
  form.destroy()
  resetClick(memrec)
end
form.show()

[DISABLE]
_G.__espRunning = false
overlayClear()
if form then
  form.close()
  form = nil
end
disableOverlay()
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142790</ID>
              <Description>"Unreal 5 ESP w/ controller (motortown)"</Description>
              <Options moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

-- ================= OFFSETS =================
local Gworld                = 0x9645B50  --Offsets
local FNamePool             = 0x93E5880  --Found with GH Tool
local UObjectName           = 0x18       --Found In Dumper-7 Console
local OwningGameInstance    = 0x1d8      --UWorld::OwningGameInstance
local LocalPlayers          = 0x38       --UGameInstance::LocalPlayers
local PlayerController      = 0x30       --UPlayer::PlayerController
local PlayerCameraManager   = 0x368      --APlayerController::PlayerCameraManager
local CameraCachePrivate    = 0x1410     --APlayerCameraManager::CameraCachePrivate
local POV                   = 0x10       --FCameraCacheEntry::POV
local PersistentLevel       = 0x30       --UWorld::PersistentLevel
local Actors                = 0xA0       --ULevel::Actors in console
local RootComponent         = 0x1c0      --AActor::RootComponent
local ComponentToWorld      = 0x220      --Found in Dumper-7 Console
local CTW_X                 = 0x20
local CTW_Y                 = 0x28
local CTW_Z                 = 0x30
local Mesh                  = 0x330      --ACharacter::Mesh
local CharacterMovement     = 0x338      --ACharacter::CharacterMovement
local CapsuleComponent      = 0x340      --ACharacter::CapsuleComponent
local CapsuleHalfHeight     = 0x558      --UCapsuleComponent::CapsuleHalfHeight
local CapsuleRadius         = 0x55c      --UCapsuleComponent::CapsuleRadius
-- ===========================================

local CONFIG_NAME = "Bytrl_ESP_Config.txt"
local CONFIG_PATH = getCheatEngineDir() .. CONFIG_NAME

local function parseBool(v)
  return tostring(v):lower() == "true"
end

local function split(str, sep)
  local t = {}
  for s in str:gmatch("([^"..sep.."]+)") do t[#t+1] = s end
  return t
end

local function loadESPConfig()
  if not fileExists(CONFIG_PATH) then return end
  for line in io.lines(CONFIG_PATH) do
    local k, v = line:match("^(.-)=(.+)$")
    if k and v then
      if k == "EnableSnaplines" then _G.Bytrl_EnableSnaplines = parseBool(v)
      elseif k == "CircleSize"  then _G.Bytrl_CircleSize = tonumber(v)
      elseif k == "EspDistance" then _G.Bytrl_EspDistance = tonumber(v)
      elseif k == "DrawMode"    then _G.Bytrl_DrawMode = v
      elseif k == "ShowNames"   then _G.Bytrl_ShowNames = parseBool(v)
      elseif k == "NameSize"    then _G.Bytrl_NameSize = tonumber(v)
      elseif k == "DrawColor"   then
        local c = split(v, ",")
        if #c == 4 then
          _G.Bytrl_DrawColor = {tonumber(c[1]),tonumber(c[2]),tonumber(c[3]),tonumber(c[4])}
        end
      end
    end
  end
end

function saveESPConfig()
  local f = io.open(CONFIG_PATH, "w")
  if not f then return end
  local c = _G.Bytrl_DrawColor or {255,255,255,255}
  f:write("EnableSnaplines=" .. tostring(_G.Bytrl_EnableSnaplines) .. "\n")
  f:write("CircleSize="      .. tostring(_G.Bytrl_CircleSize)      .. "\n")
  f:write("DrawColor="       .. table.concat(c, ",")               .. "\n")
  f:write("EspDistance="     .. tostring(_G.Bytrl_EspDistance)     .. "\n")
  f:write("DrawMode="        .. tostring(_G.Bytrl_DrawMode)        .. "\n")
  f:write("ShowNames="       .. tostring(_G.Bytrl_ShowNames)       .. "\n")
  f:write("NameSize="        .. tostring(_G.Bytrl_NameSize)        .. "\n")
  f:close()
end

loadESPConfig()

_G.Bytrl_EspDistance     = _G.Bytrl_EspDistance     or 50.0
_G.Bytrl_CircleSize      = _G.Bytrl_CircleSize      or 12.0
_G.Bytrl_EnableSnaplines = _G.Bytrl_EnableSnaplines or false
_G.Bytrl_DrawColor       = _G.Bytrl_DrawColor       or {255, 0, 255, 255}
_G.Bytrl_DrawMode        = _G.Bytrl_DrawMode        or "box"
_G.Bytrl_ShowNames       = _G.Bytrl_ShowNames       or false
_G.Bytrl_NameSize        = _G.Bytrl_NameSize        or 12

local baseAddr   = getAddressSafe(process)
local GNamesPool = baseAddr + FNamePool

local function isValidPtr(ptr)
  if not ptr or ptr == 0 then return false end
  if ptr &lt; 0x1000000 then return false end
  if ptr &gt; 0x7FFFFFFFFFFF then return false end
  return true
end

local function getFName(nameIndex)
  local blockIndex = nameIndex &gt;&gt; 16
  local offset     = (nameIndex &amp; 0xFFFF) * 2
  local block      = readPointer(GNamesPool + 0x10 + blockIndex * 0x8)
  if not block or block == 0 then return nil end
  local entry = block + offset
  local b0 = readByte(entry)
  local b1 = readByte(entry + 1)
  if not b0 or not b1 then return nil end
  local header = b0 + b1 * 256
  local len    = header &gt;&gt; 6
  local isWide = header &amp; 1
  if len &lt;= 0 or len &gt; 256 then return nil end
  if isWide == 1 then
    return readString(entry + 0x2, len * 2, true)
  else
    return readString(entry + 0x2, len, false)
  end
end

local function getActorName(actorPtr)
  local nameIndex = readInteger(actorPtr + UObjectName)
  if not nameIndex then return "???" end
  return getFName(nameIndex) or "???"
end

local function isCharacter(actorPtr)
  if not isValidPtr(actorPtr) then return false end
  local mesh     = readPointer(actorPtr + Mesh)
  local charMove = readPointer(actorPtr + CharacterMovement)
  local capsule  = readPointer(actorPtr + CapsuleComponent)
  return isValidPtr(mesh) and isValidPtr(charMove) and isValidPtr(capsule)
end

local function worldToScreen(wx, wy, wz, camX, camY, camZ, pitch, yaw, fov, sw, sh)
  local URotationToRadians = math.pi / 180.0
  local fYaw   = yaw   * URotationToRadians
  local fPitch = pitch * URotationToRadians

  local axisX = {}
  axisX.x = math.cos(fYaw) * math.cos(fPitch)
  axisX.y = math.sin(fYaw) * math.cos(fPitch)
  axisX.z = math.sin(fPitch)

  local fYaw2 = (yaw + 89.8) * URotationToRadians
  local axisY = {}
  axisY.x = math.cos(fYaw2)
  axisY.y = math.sin(fYaw2)
  axisY.z = 0.0

  local fPitch3 = (pitch + 89.8) * URotationToRadians
  local axisZ = {}
  axisZ.x = math.cos(fYaw) * math.cos(fPitch3)
  axisZ.y = math.sin(fYaw) * math.cos(fPitch3)
  axisZ.z = math.sin(fPitch3)

  local dx = wx - camX
  local dy = wy - camY
  local dz = wz - camZ

  local tX = dx*axisY.x + dy*axisY.y + dz*axisY.z
  local tY = dx*axisZ.x + dy*axisZ.y + dz*axisZ.z
  local tZ = dx*axisX.x + dy*axisX.y + dz*axisX.z

  if tZ &lt; 1.0 then return 0, 0, false, 0 end

  local screenCenterX = sw * 0.5
  local screenCenterY = sh * 0.5
  local scale = screenCenterX / math.tan(fov * math.pi / 360.0)

  local sx  = screenCenterX + tX * scale / tZ
  local sy2 = screenCenterY - tY * scale / tZ

  if sx &lt; -sw or sx &gt; sw*2 then return 0, 0, false, 0 end
  if sy2 &lt; -sh or sy2 &gt; sh*2 then return 0, 0, false, 0 end

  return sx, sy2, true, tZ
end

[ENABLE]
enableOverlay()
overlaySetAutoClear(false)
overlaySetLabel("Bytrl")
_G.__espRunning = true

createThread(function()
  while _G.__espRunning do
    local sw = overlayGetWidth()
    local sh = overlayGetHeight()

    local drawMode    = _G.Bytrl_DrawMode
    local circleSize  = _G.Bytrl_CircleSize
    local enableSnap  = _G.Bytrl_EnableSnaplines
    local showNames   = _G.Bytrl_ShowNames
    local nameSize    = _G.Bytrl_NameSize
    local col         = _G.Bytrl_DrawColor
    local cr,cg,cb,ca = col[1],col[2],col[3],col[4]

    local GWorld             = readPointer(baseAddr + Gworld)
    if not GWorld or GWorld == 0 then sleep(10) end

    local GameInstance       = readPointer(GWorld + OwningGameInstance)
    local LocalPlayersData   = readPointer(GameInstance + LocalPlayers)
    local LocalPlayer0       = readPointer(LocalPlayersData + 0x0)
    local PC                 = readPointer(LocalPlayer0 + PlayerController)
    local CamMgr             = readPointer(PC + PlayerCameraManager)

    if CamMgr and CamMgr ~= 0 then
      local PovAddr = CamMgr + CameraCachePrivate + POV
      local camX    = readDouble(PovAddr + 0x0)
      local camY    = readDouble(PovAddr + 0x8)
      local camZ    = readDouble(PovAddr + 0x10)
      local pitch   = readDouble(PovAddr + 0x18)
      local yaw     = readDouble(PovAddr + 0x20)
      local fov     = readFloat(PovAddr + 0x30)

      if camX and camY and camZ and pitch and yaw and fov then
        local Level      = readPointer(GWorld + PersistentLevel)
        local ActorsData = readPointer(Level + Actors)
        local ActorsCount = readInteger(Level + Actors + 0x8)

        if ActorsData and ActorsCount and ActorsCount &gt; 0 then
          local boxes = {}

          for i = 0, math.min(ActorsCount - 1, 2500) do
            local actorPtr = readPointer(ActorsData + i * 0x8)
            if actorPtr and actorPtr ~= 0 and isCharacter(actorPtr) then
              local RootComp  = readPointer(actorPtr + RootComponent)
              local CapsuleComp = readPointer(actorPtr + CapsuleComponent)
              if isValidPtr(RootComp) and isValidPtr(CapsuleComp) then
                local wx = readDouble(RootComp + ComponentToWorld + CTW_X)
                local wy = readDouble(RootComp + ComponentToWorld + CTW_Y)
                local wz = readDouble(RootComp + ComponentToWorld + CTW_Z)
                local halfHeight = readFloat(CapsuleComp + CapsuleHalfHeight) or 90.0
                local radius     = readFloat(CapsuleComp + CapsuleRadius) or 35.0

                if wx and wy and wz and halfHeight &gt; 0 and radius &gt; 0 then
                  local cx, cy2, cOk, tZ = worldToScreen(
                    wx, wy, wz, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  local _, topY, topOk = worldToScreen(
                    wx, wy, wz + halfHeight, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  local _, botY, botOk = worldToScreen(
                    wx, wy, wz - halfHeight, camX, camY, camZ, pitch, yaw, fov, sw, sh)

                  if cOk and topOk and botOk then
                    local boxH = botY - topY
                    local sc   = (sw * 0.5) / math.tan(fov * math.pi / 360.0)
                    local boxW = (radius / tZ) * sc
                    if boxH &gt; 2 then
                      local name = showNames and getActorName(actorPtr) or nil
                      boxes[#boxes + 1] = {
                        cx   = cx,
                        cy   = cy2,
                        x    = cx - boxW,
                        y    = topY,
                        w    = boxW * 2,
                        h    = boxH,
                        name = name
                      }
                    end
                  end
                end
              end
            end
          end

          overlayClear()

          for _, b in ipairs(boxes) do
            if drawMode == "box" then
              overlayDrawBox(b.x, b.y, b.w, b.h, cr, cg, cb)
            else
              overlayDrawCircle(b.cx, b.cy, circleSize, cr, cg, cb, ca, 2.0)
            end

            if enableSnap then
              overlayDrawLine(sw*0.5, sh, b.cx, b.cy, 1.0, cr, cg, cb, ca)
            end

            if showNames and b.name then
              local nw = (#b.name * nameSize) * 0.55
              overlayDrawText(b.cx - nw/2, b.y - nameSize - 2, b.name, nameSize, cr, cg, cb, ca)
            end
          end
        end
      end
    end

    sleep(10)
  end
end)

-- Controller UI
local form = createForm(false)
form.Caption = "Bytrl ESP Controller"
form.Width = 340
form.Height = 210
form.Position = "poScreenCenter"

local lblDist = createLabel(form)
lblDist.Caption = "ESP Distance: " .. _G.Bytrl_EspDistance
lblDist.Left = 10
lblDist.Top = 10

local sDist = createTrackBar(form)
sDist.Min = 10
sDist.Max = 300
sDist.Position = _G.Bytrl_EspDistance
sDist.Left = 10
sDist.Top = lblDist.Top + 15
sDist.Width = 310
sDist.OnChange = function()
  _G.Bytrl_EspDistance = sDist.Position
  lblDist.Caption = "ESP Distance: " .. sDist.Position
  saveESPConfig()
end

local lblSize = createLabel(form)
lblSize.Caption = "Circle Size: " .. _G.Bytrl_CircleSize
lblSize.Left = 10
lblSize.Top = sDist.Top + 30

local sSize = createTrackBar(form)
sSize.Min = 2
sSize.Max = 60
sSize.Position = _G.Bytrl_CircleSize
sSize.Left = 10
sSize.Top = lblSize.Top + 15
sSize.Width = 310
sSize.OnChange = function()
  _G.Bytrl_CircleSize = sSize.Position
  lblSize.Caption = "Circle Size: " .. sSize.Position
  saveESPConfig()
end

local cbBoxes = createCheckBox(form)
cbBoxes.Caption = "Use Boxes (unchecked = Circles)"
cbBoxes.Left = 10
cbBoxes.Top = sSize.Top + 20
cbBoxes.Checked = (_G.Bytrl_DrawMode == "box")
cbBoxes.OnChange = function()
  _G.Bytrl_DrawMode = cbBoxes.Checked and "box" or "circle"
  saveESPConfig()
end

local cbSnap = createCheckBox(form)
cbSnap.Caption = "Enable Snaplines"
cbSnap.Left = 10
cbSnap.Top = cbBoxes.Top + 20
cbSnap.Checked = _G.Bytrl_EnableSnaplines
cbSnap.OnChange = function()
  _G.Bytrl_EnableSnaplines = cbSnap.Checked
  saveESPConfig()
end

local cbNames = createCheckBox(form)
cbNames.Caption = "Show Entity Names"
cbNames.Left = 10
cbNames.Top = cbSnap.Top + 20
cbNames.Checked = _G.Bytrl_ShowNames
cbNames.OnChange = function()
  _G.Bytrl_ShowNames = cbNames.Checked
  saveESPConfig()
end

local lblNameSize = createLabel(form)
lblNameSize.Caption = "Name Size: " .. _G.Bytrl_NameSize
lblNameSize.Left = 10
lblNameSize.Top = cbNames.Top + 20

local sNameSize = createTrackBar(form)
sNameSize.Min = 8
sNameSize.Max = 32
sNameSize.Position = _G.Bytrl_NameSize
sNameSize.Left = 10
sNameSize.Top = lblNameSize.Top + 15
sNameSize.Width = 310
sNameSize.OnChange = function()
  _G.Bytrl_NameSize = sNameSize.Position
  lblNameSize.Caption = "Name Size: " .. sNameSize.Position
  saveESPConfig()
end

local function CEColorToRGBA(c)
  local r = c &amp; 0xFF
  local g = (c &gt;&gt; 8) &amp; 0xFF
  local b = (c &gt;&gt; 16) &amp; 0xFF
  return r, g, b, 255
end

local btnColor = createButton(form)
btnColor.Caption = "Pick ESP Color"
btnColor.Left = 170
btnColor.Top = cbSnap.Top + 10
btnColor.Width = 130
btnColor.Height = 30
