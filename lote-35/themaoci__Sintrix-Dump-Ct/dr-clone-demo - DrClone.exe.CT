            <CheatEntry>
              <ID>1337142593</ID>
              <Description>"Unreal 4 Flight Template -Doubles"</Description>
              <LastState/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

  local VelocityY=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+110')--Double
  local VelocityZ=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+118')--Double
  local VelocityX=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+108')--Double
  local ControlRotationYaw=getAddressSafe('[[[[base_address]+38]+0]+30]+330')--Double
  local MovementMode=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+271')--Byte
  local AirControl=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+2F0')--Float
  local MaxFlySpeed=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+2C4')--Float
  local MaxAcceleration=getAddressSafe('[[[[[[base_address]+38]+0]+30]+2F0]+338]+2CC')--Float
  local bActorEnableCollision=getAddressSafe('[[[[[base_address]+38]+0]+30]+300]+64')--Byte

[ENABLE]

if flightTmr then flightTmr.destroy() flightTmr=nil end

local function toRadIfDeg(a)
  if a == nil then return 0 end
  if math.abs(a) &gt; (2*math.pi + 0.5) then
    return math.rad(a)
  end
  return a
end

local function clamp(v, mn, mx)
  if v &lt; mn then return mn end
  if v &gt; mx then return mx end
  return v
end

flightTmr = createTimer()
flightTmr.Interval = 10
flightTmr.onTimer = function()

  if MovementMode then writeByte(MovementMode, 5) end --flying
  if AirControl then writeFloat(AirControl,5) end
  if MaxFlySpeed then writeFloat(MaxFlySpeed,3000) end
  if MaxAcceleration then writeFloat(MaxAcceleration,10000) end
  if bActorEnableCollision then writeByte(bActorEnableCollision, 0) end --no clip

  if not (VelocityX and VelocityY and VelocityZ and ControlRotationYaw) then return end

  local yaw = toRadIfDeg(readDouble(ControlRotationYaw) or 0)

  local speed = 4500.0
  local vertSpeed = 4500.0

  local forward  = isKeyPressed(0x57) and 1 or 0 -- W
  local backward = isKeyPressed(0x53) and 1 or 0 -- S
  local left     = isKeyPressed(0x41) and 1 or 0 -- A
  local right    = isKeyPressed(0x44) and 1 or 0 -- D
  local upKey    = isKeyPressed(VK_SPACE) and 1 or 0
  local downKey  = isKeyPressed(VK_SHIFT) and 1 or 0

  -- gamepad
  local pad = getXBox360ControllerState(0)
  if pad then
    local deadzone = 8000
    local lx = (math.abs(pad.ThumbLeftX) &gt; deadzone) and (pad.ThumbLeftX / 32767.0) or 0
    local ly = (math.abs(pad.ThumbLeftY) &gt; deadzone) and (pad.ThumbLeftY / 32767.0) or 0

    if ly &gt; 0 then forward  = clamp(ly, 0, 1) end
    if ly &lt; 0 then backward = clamp(-ly, 0, 1) end
    if lx &gt; 0 then right    = clamp(lx, 0, 1) end
    if lx &lt; 0 then left     = clamp(-lx, 0, 1) end

    upKey   = pad.GAMEPAD_LEFT_SHOULDER and 1 or upKey
    downKey = pad.GAMEPAD_RIGHT_SHOULDER and 1 or downKey
  end

  local fb = forward - backward
  local lr = right - left
  local ud = upKey - downKey
  local fwdX, fwdY = math.cos(yaw), math.sin(yaw)
  local rgtX, rgtY = -math.sin(yaw), math.cos(yaw)

  local moveX = (fwdX * fb + rgtX * lr) * speed
  local moveY = (fwdY * fb + rgtY * lr) * speed
  local moveZ = ud * vertSpeed

  writeDouble(VelocityX, moveX)
  writeDouble(VelocityY, moveY)
  writeDouble(VelocityZ, moveZ)
end

[DISABLE]

if flightTmr then flightTmr.destroy() flightTmr=nil end
if MovementMode then writeByte(MovementMode,1) end
if AirControl then writeFloat(AirControl,0.200000003) end
if MaxFlySpeed then writeFloat(MaxFlySpeed,600) end
if MaxAcceleration then writeFloat(MaxAcceleration,2048) end
if bActorEnableCollision then writeByte(bActorEnableCollision,203) end

