                <CheatEntry>
                  <ID>1314</ID>
                  <Description>"-&gt; Get PlayerProgressManager"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <Color>00FF00</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$lua}

local classId = mono_findClass('IdleFishing.dll', 'PlayerProgressManager')
local fields = mono_class_enumFields(classId, true)
for i in pairs(fields) do
  if fields[i].isStatic and fields[i].name == 'Instance' then
    local instance = mono_class_getStaticFieldValue(classId, fields[i].field)
    registerSymbol("ppmptr", instance)
    local ppmString = string.format('0x%X', instance);
  end
end

 
{$asm}
[DISABLE]
{$lua}
unregisterSymbol("npcmanptr")

</AssemblerScript>
