              <ID>940</ID>
              <Description>"Godmode"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(Godmode,GameAssembly.dll,F3 0F 11 73 38 74)
alloc(GMAlloc,$1000,Godmode)

label(code return)


GMAlloc:
  cmp [rbx+118],1
  jne code
  movss xmm6,[rbx+34]
  movss [rbx+38],xmm6
  jmp return
code:
  movss [rbx+38],xmm6
  jmp return

Godmode:
  jmp GMAlloc
return:
registersymbol(Godmode)

[DISABLE]

Godmode:
  db F3 0F 11 73 38

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
