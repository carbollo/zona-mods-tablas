    <CheatEntry>
      <ID>6</ID>
      <Description>"֍--Enable Cheats"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('Bloodshed.exe','BLOODSHED v1.0.14 x FLEXY', '')
cycleFullCompact(nil, false)
AddressList.List.Font.Style = ''
LaunchMonoDataCollector()
{$asm}
aobscanmodule(PlayerptrInjecton,GameAssembly.dll,48 89 5C 24 08 55 48 8D 6C 24 E0 48 81 EC 20 01 00 00 48 8B D9)
alloc(PlayerPTR,$1000,PlayerptrInjecton)

label(code return)


PlayerPTR:
  mov [Player],rcx
code:
  mov [rsp+08],rbx
  jmp return

Player:
dq 0

PlayerptrInjecton:
  jmp PlayerPTR
return:
registersymbol(PlayerptrInjecton Player)

[DISABLE]

PlayerptrInjecton:
  db 48 89 5C 24 08

unregistersymbol(*)
dealloc(*)


</AssemblerScript>
