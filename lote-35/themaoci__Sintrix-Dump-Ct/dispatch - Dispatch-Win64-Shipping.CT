  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('Dispatch-Win64-Shipping.exe','', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>822</ID>
          <Description>"Hero List"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
//Send @ Sintrix | FearlessRevolution
aobscanmodule(HeroListPointer,Dispatch-Win64-Shipping.exe,488Bxx410Fxxxx488BxxFFxxxxxxxxxxE9)
alloc(newmem,$1000,HeroListPointer)
alloc(HeroList,8)
label(code return)

newmem:

code:
  mov [HeroList],rdi
  mov rax,[rdi]
  movaps xmm1,xmm12
  jmp return

HeroListPointer+01:
  jmp newmem
  nop 2
return:
registersymbol(HeroListPointer HeroList)

[DISABLE]

HeroListPointer+01:
  db 48 8B 07 41 0F 28 CC

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
