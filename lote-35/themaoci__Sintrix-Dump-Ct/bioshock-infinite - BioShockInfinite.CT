  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- start table script : (process , title, footer)
startTable('BioShockInfinite.exe','Bioshock Infinite - Sintrix', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>26232</ID>
          <Description>"Infinite Health"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@FearlessRevolution|Sintrix
[ENABLE]

aobscanmodule(health,BioShockInfinite.exe,F3 0F 11 87 FC 25 00 00)
alloc(newmem,$1000)
registersymbol(onehitkill)
label(code return onehitkill)

newmem:
cmp dword ptr [edi+25A8],0
jne @f
movss xmm0,[newhealth]
movss [edi+25FC],xmm0
jmp return

@@:
cmp [onehitkill],1
jne code
cmp dword ptr [edi+25A8],0
je code
xorps xmm0,xmm0
jmp code

code:
  movss [edi+000025FC],xmm0
  jmp return

onehitkill:
dd 0

newhealth:
dd (float)3000

health:
  jmp newmem
  nop 3
return:
registersymbol(health)

[DISABLE]

health:
  db F3 0F 11 87 FC 25 00 00

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>26238</ID>
          <Description>"One Hit Kill"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
onehitkill:
dd 1

[DISABLE]
onehitkill:
dd 0
</AssemblerScript>
        </CheatEntry>
