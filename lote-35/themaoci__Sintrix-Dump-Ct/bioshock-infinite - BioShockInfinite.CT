registersymbol(pawndata newspeed)
label(code return pawndata newspeed)
newmem:
movss xmm7,[newspeed]
movss [edi+3EDC],xmm7
mov [pawndata],edi

code:
  mov eax,[edi]
  mov edx,[eax+000003B0]
  jmp return

newspeed:
dd (float)1000

pawndata:
dq 0

pawn:
  jmp newmem
  nop 3
return:
