  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Load Scripts from lua file
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
-- set background picture
--setAddressListPicture('sintrix.jpg', 210, 0x0000FF)
-- start table script : (process , title, footer)
startTable('Firestone.exe','', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"→ Initialize Mono"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>784</ID>
              <Description>"One Hit Kill Enemies"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
BattleMainEnemy.CalculateMaximumHealthTotal:
db C3
//Send@Sintrix|FearlessRevolution
[DISABLE]
BattleMainEnemy.CalculateMaximumHealthTotal:
db 48 89 5C 24 10
//Send@Sintrix|FearlessRevolution
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>781</ID>
              <Description>"Cheap Hero &amp; Guardian Upgrades"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix|FearlessRevolution
[ENABLE]
//Hero,Guardian,CustomUpgrade
aobscanmodule(upgrade1,GameAssembly.dll,0F 10 83 80 03 00 00 0F 10)
alloc(newmem,$1000,upgrade1)

label(code)
label(return)

newmem:

code:
  mov [ebx+380],0
  movups xmm0,[rbx+00000380]
  xorps xmm0,xmm0
  jmp return
//Send@Sintrix|FearlessRevolution
upgrade1:
  jmp newmem
  nop 2
return:
registersymbol(upgrade1)

aobscanmodule(upgrade2,GameAssembly.dll,00 00 48 8B 0D * * * * 0F 10 B3 80 03 00 00)
alloc(newmem2,$1000,upgrade2)

label(code2)
label(return2)

newmem2:
//Send@Sintrix|FearlessRevolution
code2:
  mov [rbx+380],0
  movups xmm6,[rbx+00000380]
  xorps xmm6,xmm6
  jmp return2

upgrade2+09:
  jmp newmem2
  nop 2
return2:
registersymbol(upgrade2)

aobscanmodule(guardian1,GameAssembly.dll,E8 00 00 00 48 8B 0D * * * * 0F 10 73 70 0F 10 BB 80 00 00 00)
alloc(newmem3,$1000,guardian1)

label(code3)
label(return3)

newmem3:
//Send@Sintrix|FearlessRevolution
code3:
  mov [rbx+70],#0
  movups xmm6,[rbx+70]
  xorps xmm6,xmm6
  movups xmm7,[rbx+00000080]
  jmp return3

guardian1+0B:
  jmp newmem3
  nop 6
return3:
registersymbol(guardian1)
//Send@Sintrix|FearlessRevolution
aobscanmodule(guardian2,GameAssembly.dll,0F 10 43 70 0F 10 8B 80 00 00 00)
alloc(newmem4,$1000,guardian2)

label(code4)
label(return4)

newmem4:

code4:
  mov [rbx+70],0
  movups xmm0,[rbx+70]
  xorps xmm0,xmm0
  movups xmm1,[rbx+00000080]
  jmp return4

guardian2:
  jmp newmem4
  nop 6
return4:
registersymbol(guardian2)

//Send@Sintrix|FearlessRevolution

[DISABLE]

upgrade1:
  db 0F 10 83 80 03 00 00
upgrade2+09:
  db 0F 10 B3 80 03 00 00
guardian1+0B:
  db 0F 10 73 70 0F 10 BB 80 00 00 00
guardian2:
  db 0F 10 43 70 0F 10 8B 80 00 00 00
unregistersymbol(*)
dealloc(*)
//Send@Sintrix|FearlessRevolution
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>783</ID>
              <Description>"Gold Doesn't Decrease"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Shaggy@Sintrix
[ENABLE]
BigCurrency.RemoveCur:
db c3//Send@Sintrix|FearlessRevolution
Currency.RemoveCur:
db c3//Send@Sintrix|FearlessRevolution
//Send@Sintrix|FearlessRevolution
[DISABLE]
BigCurrency.RemoveCur:
db 48//Send@Sintrix|FearlessRevolution
Currency.RemoveCur:
db 0f//Send@Sintrix|FearlessRevolution
</AssemblerScript>
