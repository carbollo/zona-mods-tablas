              <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end
local Base= getAddress("GameAssembly.dll");
local mBase= Base+0x01E93CA8;
local chPointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(mBase)+0x320)+0xD0)+0x48)+0x40)+0x300)+0x20)+0xB8)+0x10)+0x0;
