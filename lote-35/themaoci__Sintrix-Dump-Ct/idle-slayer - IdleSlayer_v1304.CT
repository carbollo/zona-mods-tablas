            <CheatEntry>
              <ID>0</ID>
              <Description>"Grab Game Data"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

//PlayerInventory.Update
//Send@Sintrix

aobscanmodule(playerinventory,GameAssembly.dll,40 48 8B D9 0F 29 74 24 30 75 1F)
alloc(newmem,$1000,playerinventory)
registersymbol(inv)
label(code return inv)


newmem:
mov [inv],rcx

code:
  mov rbx,rcx
  movaps [rsp+30],xmm6
  jmp return

inv:
dq 0

playerinventory+01:
  jmp newmem
  nop 3
return:
registersymbol(playerinventory)

[DISABLE]

playerinventory+01:
  db 48 8B D9 0F 29 74 24 30

unregistersymbol(*)
dealloc(*)

