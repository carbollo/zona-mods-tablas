            <CheatEntry>
              <ID>397</ID>
              <Description>"One Hit Kill"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(ehp,GameAssembly.dll,F2 0F 5C C6 66 0F 2F F8 F2 0F 11 83 B0)
alloc(newmem,$1000,ehp)
label(code)
label(return)

newmem:
xorps xmm0,xmm0
code:
  subsd xmm0,xmm6
  comisd xmm7,xmm0
  jmp return

ehp:
  jmp newmem
  nop 3
return:
registersymbol(ehp)

aobscanmodule(bhp,GameAssembly.dll,F3 0F 5C C7 0F 2F F0)
alloc(newmem2,$1000,bhp)
label(code2)
label(return2)

newmem2:
xorps xmm0,xmm0
code2:
  subss xmm0,xmm7
  comiss xmm6,xmm0
  jmp return2

bhp:
  jmp newmem2
  nop 2
return2:
registersymbol(bhp)

[DISABLE]

ehp:
  db F2 0F 5C C6 66 0F 2F F8

bhp:
  db F3 0F 5C C7 0F 2F F0

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>125</ID>
              <Description>"Upgrade Cost Set To Zero"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(ucost,GameAssembly.dll,F2 0F 10 77 40 F2 0F 11)
alloc(newmem,$1000,ucost)
label(code return)

newmem:

code:
  movsd xmm6,[rdi+40]
  xorps xmm6,xmm6
  jmp return

ucost:
  jmp newmem
return:
registersymbol(ucost)

[DISABLE]

ucost:
  db F2 0F 10 77 40

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
