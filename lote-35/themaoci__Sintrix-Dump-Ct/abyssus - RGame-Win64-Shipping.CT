          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(playerController,RGame-Win64-Shipping.exe,49 8B 06 48 8D 95 40 01 00 00)
alloc(newmem,$1000,playerController)
registersymbol(getPlayer)
label(code return getPlayer)
//Send@FearlessRevolution|Sintrix
newmem:
mov [getPlayer],r14

code:
  mov rax,[r14]
  lea rdx,[rbp+00000140]
  jmp return

getPlayer:
dq
//Send@FearlessRevolution|Sintrix
playerController:
  jmp newmem
  nop 5
return:
registersymbol(playerController)

[DISABLE]

