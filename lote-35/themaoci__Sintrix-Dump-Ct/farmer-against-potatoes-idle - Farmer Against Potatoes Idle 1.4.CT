<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>44</ID>
      <Description>"-&gt; Start Table &lt;-"</Description>
      <Options moHideChildren="1"/>
      <LastState Activated="1"/>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

function mono_name_getStaticFieldValue(domain, classname, staticfield)
  local cid = mono_findClass(domain,classname)
  local fields = mono_class_enumFields(cid, true)
  for i in pairs(fields) do
      if fields[i].isStatic and fields[i].name == staticfield then
         local result = mono_class_getStaticFieldValue(cid, fields[i].field)
         return result
      end
  end
end
registerLuaFunctionHighlight("mono_name_getStaticFieldValue")

local function startTable(process, title, footer)
  OpenProcess(process);
  if process ~= process or (readInteger(process) == nil) then
     error(ShowMessage("Failed To Attach To Process"))
  end
  --Set Window Title
  if not((MainForm.Caption):match(title)) then
  MainForm.Caption = title..' ~ '..MainForm.Caption
  end

  --Credits
  if MainForm.lblSigned.Caption:match(footer) == nil then
    local Main = MainForm.lblSigned
    local MadeBy = createPanel(Main.Parent)


    MadeBy.AutoSize = true
    MadeBy.Anchors = '[akTop,akRight,akLeft]'
    MadeBy.AnchorSideTop.Control = MadeBy.Parent
    MadeBy.AnchorSideTop.Side = asrCenter
    MadeBy.AnchorSideRight.Control = MainForm.CommentButton
    MadeBy.AnchorSideRight.Side = asrLeft
    MadeBy.AnchorSideLeft.Control = MainForm.advancedbutton
    MadeBy.AnchorSideLeft.Side = asrRight

    Main.Parent = MadeBy
    Main.Visible = true
    Main.Caption = footer
    Main.Font.Size = 12
    Main.Font.Style = '[fsBold]'
    Main.Font.Quality = 'fqCleartypeNatural'
    Main.AnchorSideTop.Control = MadeBy
    Main.AnchorSideTop.Side = asrCenter
    Main.AnchorSideLeft.Control = MadeBy
    Main.AnchorSideLeft.Side = asrCenter
  end
end
registerLuaFunctionHighlight("startTable")
startTable('Farmer Against Potatoes Idle.exe','Farmer Against Potatoes Idle v1.4','By Sintrix / Build 16567032')

function cycleFullCompact(sender,force)     local state = not(compactmenuitem.Caption == 'Compact View Mode'); if force~=nil then state = not force end; compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible    = state; getMainForm().Panel5.Visible    = state; end; function addCompactMenu() if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,true);

getMainForm().Panel4.Visible = true;
{$asm}
[DISABLE]
{$Lua}
function cycleFullCompact(sender,force)     local state = not(compactmenuitem.Caption == 'Compact View Mode'); if force~=nil then state = not force end; compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible    = state; getMainForm().Panel5.Visible    = state; end; function addCompactMenu() if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,false);

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>448</ID>
          <Description>"&lt;Scripts&gt;"</Description>
          <Options moHideChildren="1"/>
          <LastState Value="" Activated="1" RealAddress="00000000"/>
          <Color>0080FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>46</ID>
              <Description>"-&gt; Enable Mono"</Description>
              <Options moHideChildren="1"/>
              <LastState Activated="1"/>
              <Color>FFFF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$Lua}
if syntaxcheck then return end
if not monopipe then if LaunchMonoDataCollector() == 0 then

if process == nil then ShowMessage('Process is not selected.')
elseif readInteger(process) == 0 then ShowMessage('Process cannot be opened. Gone?')
else
  if (monopipe~=nil) and (monopipe.ProcessID~=getOpenedProcessID()) then
    monopipe.destroy()
    monopipe=nil
  end
  if (monopipe==nil) then
    LaunchMonoDataCollector()
    -- monoSymbolList is only available if the target is il2cpp and not normal mono
    --while (monoSymbolList==nil) or (not monoSymbolList.FullyLoaded) do checkSynchronize(50) end -- checkSynchronize requires that memRec is ASynch.
  end
end
end end
 
