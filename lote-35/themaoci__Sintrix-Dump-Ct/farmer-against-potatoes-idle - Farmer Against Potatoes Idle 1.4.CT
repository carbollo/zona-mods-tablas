                <CheatEntry>
                  <ID>615</ID>
                  <Description>"God Mode"</Description>
                  <LastState Activated="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Target:  Farmer Against Potatoes Idle.exe
//Author:  Salis
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  godmode  \\\\\\\\\\\\\\\\\\\\\\\\

define(address, BattleFightUI:Update+4e)

alloc(newmem,1024)
alloc(obytes_godmode, 10)
label(return code)

registersymbol(obytes_godmode)

obytes_godmode:
readmem(address, 10)

newmem:

code:
 fld qword ptr [newhp]
 fstp qword ptr [rax]
 mov qword ptr [rax+8],#99999
 mov rcx,[rax]
 mov [rbp-00000428],rcx
 jmp return

newhp:
dq (double)99

address:
 jmp newmem
 nop 5
return:


[DISABLE]

address:
readmem(obytes_godmode, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
