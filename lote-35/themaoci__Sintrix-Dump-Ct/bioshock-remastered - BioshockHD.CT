<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>2</ID>
      <Description>"Enable"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>//Send
[ENABLE]

aobscanmodule(health,BioshockHD.exe,F3 0F 11 86 7C 05 00 00 F3)
alloc(newmem,$1000)
registersymbol(GodMode)
registersymbol(EasyKills)
label(GodMode)
label(EasyKill)
label(EasyKills)
label(code)
label(return)

newmem:
cmp [GodMode],1
cmp [esi+08B0],(float)0
jne EasyKill
mov [esi+0000057C],(float)200
jmp return

EasyKill:
cmp [EasyKills],1
jne code
mov [esi+0000057C],(float)0
jmp code

code:
  movss [esi+0000057C],xmm0
  jmp return

GodMode:
dd 0

EasyKills:
dd 0


health:
  jmp newmem
  nop 3
return:
registersymbol(health)

aobscanmodule(mana,BioshockHD.exe,F3 0F 11 86 F8 0A 00 00 F3 0F 10 45 08 0F 2E C1 9F F6 C4 44 7B)
alloc(newmem2,$1000)
registersymbol(InfiniteEve)
label(InfiniteEve)
label(code2)
label(return2)

newmem2:
cmp [InfiniteEve],1
jne code
mov [esi+00000AF8],(float)300
jmp return

code2:
  movss [esi+00000AF8],xmm0
  jmp return2

new:
dd (float)300

InfiniteEve:
dd 0

mana:
  jmp newmem2
  nop 3
return2:
registersymbol(mana)

aobscanmodule(movement,BioshockHD.exe,8B 01 57 FF 90 80 00 00 00 8B 1D)
alloc(newmem3,$1000)
registersymbol(jumpheight)
registersymbol(movementspeed)
label(code3)
label(return3)

newmem3:
xorps xmm5,xmm5
movss xmm5,[movementspeed]
movss [ecx+050C],xmm5
xorps xmm7,xmm7
movss xmm7,[jumpheight]
movss [ecx+0518],xmm7

code3:
  mov eax,[ecx]
  push edi
  call dword ptr [eax+00000080]
  jmp return3

jumpheight:
dq (float)525

movementspeed:
dd (float)2048

movement:
  jmp newmem3
  nop 4
return3:
registersymbol(movement)

aobscanmodule(ammo,BioshockHD.exe,29 06 8B 45 0C)
alloc(newmem4,$1000)
registersymbol(InfAmmo)
label(code4)
label(return4)

newmem4:
cmp [InfAmmo],1
mov [esi],#99
mov eax,[ebp+0C]
jmp return4

code4:
  sub [esi],eax
  mov eax,[ebp+0C]
  jmp return4

InfAmmo:
dd 0

ammo:
  jmp newmem4
return4:
registersymbol(ammo)

aobscanmodule(money,BioshockHD.exe,89 86 EC 0A 00 00)
alloc(newmem5,$1000)
registersymbol(InfMoney)
label(code5)
label(return5)

newmem5:
cmp [InfMoney],1
jne code
mov [esi+AEC],#9999999
jmp return5

code5:
  mov [esi+00000AEC],eax
  jmp return5

InfMoney:
dd 0

money:
  jmp newmem5
  nop
return5:
registersymbol(money)

[DISABLE]

health:
  db F3 0F 11 86 7C 05 00 00
mana:
  db F3 0F 11 86 F8 0A 00 00
movement:
  db 8B 01 57 FF 90 80 00 00 00
ammo:
  db 29 06 8B 45 0C
money:
  db 89 86 EC 0A 00 00

unregistersymbol(*)
dealloc(*)


</AssemblerScript>
