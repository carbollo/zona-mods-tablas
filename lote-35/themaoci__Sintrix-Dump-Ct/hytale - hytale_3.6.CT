        <CheatEntry>
          <ID>1337142510</ID>
          <Description>"Velocity based Flight - Space/LB=up  | Shift/RB=down"</Description>
          <Options moHideChildren="1"/>
          <Color>80FF00</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end

if _G.Bytrl_FlightSpeedxy == nil then _G.Bytrl_FlightSpeedxy = 25 end
if _G.Bytrl_FlightSpeedz == nil then _G.Bytrl_FlightSpeedz = 17 end

[ENABLE]

if flightTmr then flightTmr.destroy() flightTmr=nil end

local function toRadIfDeg(a)
  if a == nil then return 0 end
  if math.abs(a) &gt; (2*math.pi + 0.5) then
    return math.rad(a)
  end
  return a
end

local function clamp(v, mn, mx)
  if v &lt; mn then return mn end
  if v &gt; mx then return mx end
  return v
end

flightTmr = createTimer()
flightTmr.Interval = 10
flightTmr.onTimer = function()

  local VelocityX=getAddressSafe('[[[[[[[GameInstance]+138]+58]+10]+18]+120]+18]+E4')
  local VelocityY=getAddressSafe('[[[[[[[GameInstance]+138]+58]+10]+18]+120]+18]+EC')
  local VelocityZ=getAddressSafe('[[[[[[[GameInstance]+138]+58]+10]+18]+120]+18]+E8')
  local ControlRotationYaw=getAddressSafe('[pCords]+3E0')

  if not (VelocityX and VelocityY and VelocityZ and ControlRotationYaw) then return end

  local yaw = toRadIfDeg(readFloat(ControlRotationYaw) or 0)

  local speed = _G.Bytrl_FlightSpeedxy
  local vertSpeed = _G.Bytrl_FlightSpeedz

  local forward  = isKeyPressed(0x57) and 1 or 0 -- W
  local backward = isKeyPressed(0x53) and 1 or 0 -- S
  local left     = isKeyPressed(0x41) and 1 or 0 -- A
  local right    = isKeyPressed(0x44) and 1 or 0 -- D
  local upKey    = isKeyPressed(VK_SPACE) and 1 or 0
  local downKey  = isKeyPressed(VK_SHIFT) and 1 or 0

  -- gamepad
  local pad = getXBox360ControllerState(0)
  if pad then
    local deadzone = 8000
    local lx = (math.abs(pad.ThumbLeftX) &gt; deadzone) and (pad.ThumbLeftX / 32767.0) or 0
    local ly = (math.abs(pad.ThumbLeftY) &gt; deadzone) and (pad.ThumbLeftY / 32767.0) or 0

    if ly &gt; 0 then forward  = clamp(ly, 0, 1) end
    if ly &lt; 0 then backward = clamp(-ly, 0, 1) end
    if lx &gt; 0 then right    = clamp(lx, 0, 1) end
    if lx &lt; 0 then left     = clamp(-lx, 0, 1) end

    upKey   = pad.GAMEPAD_LEFT_SHOULDER and 1 or upKey
    downKey = pad.GAMEPAD_RIGHT_SHOULDER and 1 or downKey
  end

  local fb = backward - forward
  local lr = right - left
  local ud = upKey - downKey

  -- Corrected basis (Unreal-style yaw)---------
  local fwdX = math.sin(yaw)
  local fwdY = math.cos(yaw)
  local rgtX = math.cos(yaw)
  local rgtY = -math.sin(yaw)
  ----------------------------------------------

  local moveX = (fwdX * fb + rgtX * lr) * speed
  local moveY = (fwdY * fb + rgtY * lr) * speed
  local moveZ = ud * vertSpeed

  writeFloat(VelocityX, moveX)
  writeFloat(VelocityY, moveY)
  writeFloat(VelocityZ, moveZ)
end

[DISABLE]
if flightTmr then flightTmr.destroy() flightTmr=nil end

if _G.Bytrl_FlightSpeedxy then _G.Bytrl_FlightSpeedxy = nil end
if _G.Bytrl_FlightSpeedz then _G.Bytrl_FlightSpeedz = nil end
</AssemblerScript>
