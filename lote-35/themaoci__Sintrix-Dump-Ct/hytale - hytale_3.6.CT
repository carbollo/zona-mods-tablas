  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>1337142218</ID>
      <Description>"Hytale | 2026"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>408080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) local bufferSize = 4096 local buffer = createMemoryStream() while src.Position &lt; src.Size do local toRead = math.min(bufferSize, src.Size - src.Position) buffer.Size = 0 buffer.copyFrom(src, toRead) buffer.Position = 0 dst.copyFrom(buffer, buffer.Size) end buffer.destroy() dst.destroy() return outPath end local dll="Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll if not fileExists(outPath) then eTFTD(dll,outPath) loadPlugin(outPath) else loadPlugin(outPath) end
setAddressListPicture('https://imgur.com/li9ROw8.png',210,0x0000FF)
startTable('HytaleClient.exe','Hytale v3.6', 'Hytale v3.6', 'Bytrl')
MainForm.Width=540 MainForm.Height=300

--[[
aobscanmodule(findvelocity,HytaleClient.exe,F3 * * * * * * * F3 * * * F3 * * * * * * * F3 * * * F3 * * * F3 * * * F3 * * * * * 80 * * * * * * 0F)
alloc(newmemfindvelocity,$100,findvelocity)
alloc(pVel,8,findvelocity)
label(codefindvelocity returnfindvelocity)
newmemfindvelocity:
mov [pVel],rbx
codefindvelocity:
movss xmm0,[rbx+000000E4]
jmp returnfindvelocity
findvelocity:
jmp newmemfindvelocity
nop 3
returnfindvelocity:
registersymbol(findvelocity pVel)]]

autoAssemble([[
// 39 * E8 * * * * 48 * * * F3 * * * * F3 * * * * F3
aobscanmodule(findGameInstance,HytaleClient.exe,39xxE8xxxxxxxx488BxxxxF3xxxxxxxxF3xxxxxxxxF3)
aobscanmodule(CallAddress,HytaleClient.exe,5756534883xxxx488Bxx488Bxxxx488Bxxxxxxxxxx488Bxxxx488Bxxxx488B)
alloc(newmemfindGameInstance,$100,findGameInstance)
alloc(GameInstance,8,findGameInstance)
label(codefindGameInstance returnfindGameInstance)
newmemfindGameInstance:
mov [GameInstance],rcx
codefindGameInstance:
cmp [rcx],ecx
//call HytaleClient.exe+303290
call CallAddress
jmp returnfindGameInstance
findGameInstance:
jmp newmemfindGameInstance
nop 2
returnfindGameInstance:
registersymbol(findGameInstance CallAddress GameInstance)]])

autoAssemble([[
// 80 BB A7 00 00 00 00 74 0A 80 7B 71 00 0F 85 8D //backup;)
aobscanmodule(player_flight,HytaleClient.exe,)
alloc(newmemplayer_flight,$100,player_flight)
alloc(flight_savedBytes,8,player_flight)
alloc(flight,8,player_flight)
label(codeplayer_flight returnplayer_flight)
flight_savedBytes:
readmem(player_flight,7)
newmemplayer_flight:
mov [flight],rbx
codeplayer_flight:
cmp byte ptr [rbx+000000A7],00
jmp returnplayer_flight
player_flight:
jmp newmemplayer_flight
nop 2
returnplayer_flight:
registersymbol(player_flight flight flight_savedBytes)]])

autoAssemble([[
// 0F 12 B0 7C 02 00 00 0F 28 C6 F3 0F 58 //backup;)
aobscanmodule(player_pCords,HytaleClient.exe,0F12xxxxxxxxxx0F28xxF3xxxxxxF3xxxxxxE8)
alloc(newmemplayer_pCords,$100,player_pCords)
alloc(pCords_savedBytes,8,player_pCords)
alloc(pCords,8,player_pCords)
label(codeplayer_pCords returnplayer_pCords)
pCords_savedBytes:
readmem(player_pCords,7)
newmemplayer_pCords:
mov [pCords],rax
codeplayer_pCords:
movlps xmm6,[rax+0000027C]
jmp returnplayer_pCords
player_pCords:
jmp newmemplayer_pCords
nop 2
returnplayer_pCords:
registersymbol(player_pCords pCords pCords_savedBytes)]])

autoAssemble([[
luacall(savedTime=nil)
aobscanmodule(effecttime,HytaleClient.exe,F3 * * * * 48 * * * 48 * * * * * * 39 * 48 * * * 5B E9)
alloc(newmemeffecttime,$100,effecttime)
alloc(time,8,effecttime)
alloc(time_flag,8,effecttime)
alloc(custom_time,8,effecttime)
label(codeeffecttime returneffecttime)
time_flag:
dd 0
newmemeffecttime:
mov [time],rbx //pull time address
cmp [time_flag],1
jne codeeffecttime
push rsi
mov rsi,[rbx+20] //current time value to rsi
mov [custom_time],rsi //current time value to custom_time
movss xmm0,[custom_time] //freeze time
pop rsi
codeeffecttime:
movss [rbx+20],xmm0
jmp returneffecttime
effecttime:
jmp newmemeffecttime
returneffecttime:
registersymbol(effecttime time custom_time time_flag)]])

autoAssemble([[
// 80xxxxxx74xx488Bxxxx4038
// 80 * * * 74 * 48 * * * 40 * * 48 * * E8 * * * * 48
aobscanmodule(setGamemode,HytaleClient.exe,80xxxxxx74xx488Bxxxx4038)
aobscanmodule(jeaddress,HytaleClient.exe,B8xxxxxxxx4883xxxx5B5EC3909090909055)
alloc(newmemsetGamemode,$100,setGamemode)
alloc(gamemode,8,setGamemode)
label(codesetGamemode returnsetGamemode)
newmemsetGamemode:
mov [gamemode],rcx
codesetGamemode:
cmp byte ptr [rcx+0A],01
je jeaddress
jmp returnsetGamemode
setGamemode:
jmp newmemsetGamemode
nop 1
returnsetGamemode:
registersymbol(setGamemode jeaddress gamemode)]])

autoAssemble([[
// F3 0F 10 45 10 F3 0F 58
aobscanmodule(player_stamina,HytaleClient.exe,F3xxxxxxxxF3xxxxxxxxF3xxxxxxxxF3xxxxxxxx0F2E)
alloc(newmemplayer_stamina,$100,player_stamina)
alloc(stamina,8,player_stamina)
alloc(stamina_flag,8,player_stamina)
label(codeplayer_stamina returnplayer_stamina)
stamina_flag:
dd 0
newmemplayer_stamina:
cmp [stamina_flag],1
jne codeplayer_stamina
cmp [rbp+13c],0
jne codeplayer_stamina
mov [stamina],rbp
mov [rbp+10],(float)10
codeplayer_stamina:
movss xmm0,[rbp+10]
jmp returnplayer_stamina
player_stamina:
jmp newmemplayer_stamina
returnplayer_stamina:
registersymbol(player_stamina stamina stamina_flag)]])

autoAssemble([[
aobscanmodule(findFreecam,HytaleClient.exe,488Bxxxx488Dxxxxxx4Cxxxxxxxxxxxx41FFxx488Bxxxxxx4889)
alloc(newmemfindFreecam,$100,findFreecam)
alloc(freecam,8,findFreecam)
label(codefindFreecam returnfindFreecam)
newmemfindFreecam:
mov [freecam],rcx
codefindFreecam:
mov rcx,[rcx+20]
lea rdx,[rsp+78]
jmp returnfindFreecam
findFreecam:
jmp newmemfindFreecam
nop 4
returnfindFreecam:
registersymbol(findFreecam freecam)]])


autoAssemble([[
// D1xx00xx4Axxxxxxxx418D
// D1 02 00 00 4A 8D 74 20 10 41 8D 45 01 99 41 F7 7F 08 41 89 56 6C 40 38 36
aobscanmodule(findFreecamEnableValue,HytaleClient.exe,D1xx00xx4Axxxxxxxx418D)
alloc(newmemfcev,$100,findFreecamEnableValue)
alloc(freecamValueHere,8,findFreecamEnableValue)
label(codefcev returnfcev)
newmemfcev:
mov [freecamValueHere],r14
codefcev:
mov [r14+6C],edx
cmp [rsi],sil
jmp returnfcev
findFreecamEnableValue+12:
jmp newmemfcev
nop 2
returnfcev:
registersymbol(findFreecamEnableValue freecamValueHere)]])

autoAssemble([[
aobscanmodule(findFreecamCords,HytaleClient.exe,F2xxxxxxxx0F12xxF3xxxxxxxxF3xxxxxxxxF3xxxxxxxxF3)
alloc(newmemfindFreecamCords,$100,findFreecamCords)
alloc(fcCords,8,findFreecamCords)
label(codefindFreecamCords returnfindFreecamCords)
newmemfindFreecamCords:
mov [fcCords],rbx
codefindFreecamCords:
movsd [rbx+5C],xmm0
jmp returnfindFreecamCords
findFreecamCords:
jmp newmemfindFreecamCords
returnfindFreecamCords:
registersymbol(findFreecamCords fcCords)]])


EnableFreeCam=function()
  if freeCamValueHere and freeCamAddress then
    local FreecamOnValue=readInteger(freeCamValueHere)
    FreecamOffValue=readInteger(freeCamAddress)
    if FreecamOnValue ~= nil and FreecamOffValue ~= nil then
      writeInteger(freeCamAddress,FreecamOnValue)
    end
  end
end

DisableFreeCam=function()
  if freeCamAddress and FreecamOffValue ~= nil then
     writeInteger(freeCamAddress,FreecamOffValue)
  end
end


httmr=createTimer() httmr.Interval=100 httmr.onTimer=function()

  local flight=getAddressSafe('[flight]+AB')
  if flight and ald('Flight (Use velocity based to evade anticheats)').Active==true then writeByte(flight,1) else writeByte(flight,0) end

  local noclipflag=getAddressSafe('[flight]+75')
  if noclipflag and ald('No clip').Active==true then writeByte(noclipflag,1) else writeByte(noclipflag,0) end

  local time_flag=getAddressSafe('time_flag')
  if time_flag and ald('Freeze and edit time').Active==true then writeInteger(time_flag,1) else writeInteger(time_flag,0) end

  local stamina_flag=getAddressSafe('stamina_flag')
  if stamina_flag and ald('Infinite stamina').Active==true then writeInteger(stamina_flag,1) else writeInteger(stamina_flag,0) end

  freeCamAddress=getAddressSafe('[freecam]+20')
  freeCamValueHere=getAddressSafe('[freecamValueHere]+20')

end

[DISABLE]

