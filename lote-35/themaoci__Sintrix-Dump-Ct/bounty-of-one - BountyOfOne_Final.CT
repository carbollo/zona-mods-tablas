  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"BountyOfOne.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]


local result = messageDialog(
  'You must activate this IN GAME!\n\n' ..
  'Then click retry in game so everything works.\n\n' ..
  'Once this is activated, you leave it activated!\n\n' ..
  'Are you in an active match?', mtConfirmation, mbYes, mbNo)
if result ~= mrYes then return error('') end


local s=findTableFile('SintrixBytrl.lua').Stream load(readStringLocal(s.Memory,s.Size))()
--          target process  |      header      |       footer      |    made by    | mono?
startTable('BountyOfOne.exe','BountyOfOne v1.0', 'BountyOfOne v1.0', 'Bytrl | Send', true)


local function asmCode() autoAssemble([[
  alloc(newmem,100,ObjTurretInstancer:.ctor+b)
  alloc(player,8,ObjTurretInstancer:.ctor+b)
  label(returnhere)
  label(originalcode)
  label(exit)
  newmem:
  mov [player],rsi
  originalcode:
  mov byte ptr [rsi+78],01
  mov rsi,[rsp]
  exit:
  jmp returnhere
  ObjTurretInstancer:.ctor+b:
  jmp newmem
  nop 3
  returnhere:
  registersymbol(player)

  alloc(newmemxp,100,XpHandler:XPChange)
  alloc(GetXP,8,XpHandler:XPChange)
  label(returnherexp originalcodexp exitxp)
  newmemxp:
  mov [GetXP],rcx
  originalcodexp:
  push rbp
  mov rbp,rsp
  sub rsp,60
  exitxp:
  jmp returnherexp
  XpHandler:XPChange:
  jmp newmemxp
  nop 3
  returnherexp:
  registersymbol(GetXP)]])
end

iav('ObjTurretInstancer:.ctor+b',asmCode)

bootmr=createTimer() bootmr.Interval=500 bootmr.onTimer=function()

  local healthEventvalue=getAddressSafe('[[[[player]+48]+170]+30]+34')
  if healthEventvalue and readFloat(healthEventvalue) ~= 0 then ald('Scripts').Active=true else ald('Scripts').Active=false return end

      local blackmarketpointsptr=getAddressSafe('[[[[["mono-2.0-bdwgc.dll"+007401F0]+3D0]+570]+8E0]+28]+E98')
      local _moveSpd=getAddressSafe('[[[[player]+48]+70]+28]+34')
      local _atkSpeed=getAddressSafe('[[[[player]+48]+68]+28]+34')
      local atkSpeedModifierAllvalue=getAddressSafe('[[[[player]+48]+110]+28]+34')
      local baseAttackSpeedvalue=getAddressSafe('[[[[player]+48]+E0]+28]+34')
      local atkSpeedModifiervalue=getAddressSafe('[[[[player]+48]+E8]+28]+34')
      local healthMaxvalue=getAddressSafe('[[[[player]+48]+50]+28]+34')
      local healthvalue=getAddressSafe('[[[[player]+48]+58]+28]+34')
      local critChancevalue=getAddressSafe('[[[[player]+48]+88]+28]+34')
      local critDmgvalue=getAddressSafe('[[[[player]+48]+90]+28]+34')
      local areaFxvalue=getAddressSafe('[[[[player]+48]+98]+28]+34')
      local baseMoveSpeedvalue=getAddressSafe('[[[[player]+48]+F0]+28]+34')
      local moveSpeedModifiervalue=getAddressSafe('[[[[player]+48]+F8]+28]+34')
      local moveSpeedModifierAllvalue=getAddressSafe('[[[[player]+48]+100]+28]+34')
      local baseDamagevalue=getAddressSafe('[[[[player]+48]+D0]+28]+34')
      local damageModifierAllvalue=getAddressSafe('[[[[player]+48]+108]+28]+34')
      local damageModifiervalue=getAddressSafe('[[[[player]+48]+D8]+28]+34')
      local dashCdvalue=getAddressSafe('[[[[player]+48]+78]+28]+34')
      local dashAmountvalue=getAddressSafe('[[[[player]+48]+80]+28]+34')
      local coolDownDashModifiervalue=getAddressSafe('[[[[player]+48]+118]+28]+34')
      local baseDashCdCooldownvalue=getAddressSafe('[[[[player]+48]+C8]+28]+34')
      local cdvalue=getAddressSafe('[[[[player]+48]+A0]+28]+34')
      local baseCdCooldownvalue=getAddressSafe('[[[[player]+48]+C0]+28]+34')
      local cdShownEventvalue=getAddressSafe('[[[[player]+48]+168]+30]+34')
      local reboundvalue=getAddressSafe('[[[[player]+48]+A8]+28]+34')
      local piercevalue=getAddressSafe('[[[[player]+48]+B0]+28]+34')
      local bountyvalue=getAddressSafe('[[[[player]+48]+B8]+28]+34')
      local CurrentLevel=getAddressSafe('[[[GetXP]+20]+20]+28')
      local MaxLevel=getAddressSafe('[[GetXP]+28]+30')
      local CurrentXP=getAddressSafe('[[[GetXP]+30]+20]+28')
      local MaxXP=getAddressSafe('[[[GetXP]+38]+20]+28')
      local XPScalePerLevel=getAddressSafe('[[[GetXP]+40]+20]+28')


      if CurrentLevel and ald('Set Current Level').Active==true then ald('Set Current Level').Active=false
          local userInput=inputQuery('Set Current Level', 'Current Level:', readInteger(CurrentLevel))
          local value=tonumber(userInput) if value~=nil then
              writeInteger(CurrentLevel,value)
          end
      end


      if CurrentXP and ald('Fast levels').Active==true then writeFloat(CurrentXP,readFloat(MaxXP)-1) end


      if cdvalue and ald('No Cooldowns').Active==true then
        if not restorecdvalue then restorecdvalue=readFloat(cdvalue) writeFloat(cdvalue,0) end
        if not restorebaseCdCooldownvalue then restorebaseCdCooldownvalue=readFloat(baseCdCooldownvalue) writeFloat(baseCdCooldownvalue,0) end
      else
        if restorecdvalue then writeFloat(cdvalue,restorecdvalue) restorecdvalue=nil end
        if restorebaseCdCooldownvalue then writeFloat(baseCdCooldownvalue,restorebaseCdCooldownvalue) restorebaseCdCooldownvalue=nil end
      end


      if bountyvalue and ald('Set Current Bounty').Active==true then ald('Set Current Bounty').Active=false
          local userInput=inputQuery('Set internal bounty value', 'Current Bounty:', readInteger(bountyvalue))
          local value=tonumber(userInput) if value~=nil then
              writeInteger(bountyvalue,value)
          end
      end


      if piercevalue and ald('Increase Pierce Effect').Active==true then
        if not restorepiercevalue then restorepiercevalue=readFloat(piercevalue) writeFloat(piercevalue,999) end
      else
        if restorepiercevalue then writeFloat(piercevalue,restorepiercevalue) restorepiercevalue=nil end
      end


      if baseDamagevalue and ald('Set Damage (On Level Up)').Active==true then ald('Set Damage (On Level Up)').Active=false
          local userInput=inputQuery('Set base damage value (will update on level up)', 'Base damage:', readFloat(baseDamagevalue))
          local value=tonumber(userInput) if value~=nil then
              writeFloat(baseDamagevalue,value)
          end
      end


      if areaFxvalue and ald('Increase Pickup Range (On Level Up)').Active==true then
         if not restoreareaFxvalue then restoreareaFxvalue=readFloat(areaFxvalue) writeFloat(areaFxvalue,999) end
      else
         if restoreareaFxvalue then writeFloat(areaFxvalue,restoreareaFxvalue) restoreareaFxvalue=nil end
      end


      if critDmgvalue and ald('Set Critical Damage (On Level Up)').Active==true then ald('Set Critical Damage (On Level Up)').Active=false
          local userInput=inputQuery('Set crit damage', 'Crit damage:', readFloat(critDmgvalue))
          local value=tonumber(userInput) if value~=nil then
              writeFloat(critDmgvalue,value)
          end
      end


      if ald('Increase Critical Hit Chance (On Level Up)').Active==true then
         if not og_critChancevalue then og_critChancevalue=readFloat(critChancevalue) end
         writeFloat(critChancevalue,999)
      else
         if og_critChancevalue then writeFloat(critChancevalue,og_critChancevalue) og_critChancevalue=nil end
      end


      if blackmarketpointsptr and ald('Infinite Black Market Points').Active==true then writeInteger(blackmarketpointsptr,999) end


      if _moveSpd and ald('Increase Movement Speed').Active==true then
        if not restoreMSpeed then restoreMSpeed=readFloat(_moveSpd) writeFloat(_moveSpd,15) end
      else
        if restoreMSpeed then writeFloat(_moveSpd,restoreMSpeed) restoreMSpeed=nil end
      end


      if _atkSpeed and ald('Increase Attack Speed').Active==true then
        if not restoreAtkSpeed then restoreAtkSpeed=readFloat(_atkSpeed) writeFloat(_atkSpeed,999) end
        if not restoreatkSpeedModifierAllvalue then restoreatkSpeedModifierAllvalue=readFloat(atkSpeedModifierAllvalue) writeFloat(atkSpeedModifierAllvalue,999) end
        if not restorebaseAttackSpeedvalue then restorebaseAttackSpeedvalue=readFloat(baseAttackSpeedvalue) writeFloat(baseAttackSpeedvalue,999) end
        if not restoreatkSpeedModifiervalue then restoreatkSpeedModifiervalue=readFloat(atkSpeedModifiervalue) writeFloat(atkSpeedModifiervalue,999) end
      else
        if restoreAtkSpeed then writeFloat(_atkSpeed,restoreAtkSpeed) restoreAtkSpeed=nil end
        if restoreatkSpeedModifierAllvalue then writeFloat(atkSpeedModifierAllvalue,restoreatkSpeedModifierAllvalue) restoreatkSpeedModifierAllvalue=nil end
        if restorebaseAttackSpeedvalue then writeFloat(baseAttackSpeedvalue,restorebaseAttackSpeedvalue) restorebaseAttackSpeedvalue=nil end
        if restoreatkSpeedModifiervalue then writeFloat(atkSpeedModifiervalue,restoreatkSpeedModifiervalue) restoreatkSpeedModifiervalue=nil end
      end


      if healthMaxvalue and ald('God Mode').Active==true then
        if not restoreHealthVal then restoreHealthVal=readFloat(healthvalue) end
        if not restoreHealthMaxVal then restoreHealthMaxVal=readFloat(healthMaxvalue) end
        writeFloat(healthMaxvalue,100) writeFloat(healthvalue,100)
      else
        if restoreHealthVal then writeFloat(healthvalue,restoreHealthVal) restoreHealthVal=nil end
        if restoreHealthMaxVal then writeFloat(healthMaxvalue,restoreHealthMaxVal) restoreHealthMaxVal=nil end
      end


      if dashCdvalue and ald('No Dash Cooldown').Active==true then
        if not og_dashCdvalue then og_dashCdvalue=readFloat(dashCdvalue) writeFloat(dashCdvalue,0) end
        if not og_dashAmountvalue then og_dashAmountvalue=readInteger(dashAmountvalue) writeInteger(dashAmountvalue,100) end
        if not og_coolDownDashModifiervalue then og_coolDownDashModifiervalue=readFloat(coolDownDashModifiervalue) writeFloat(coolDownDashModifiervalue,0) end
        if not og_baseDashCdCooldownvalue then og_baseDashCdCooldownvalue=readFloat(baseDashCdCooldownvalue) writeFloat(baseDashCdCooldownvalue,0) end
      else
        if og_dashCdvalue then writeFloat(dashCdvalue,og_dashCdvalue) og_dashCdvalue=nil end
        if og_dashAmountvalue then writeInteger(dashAmountvalue,og_dashAmountvalue) og_dashAmountvalue=nil end
        if og_coolDownDashModifiervalue then writeFloat(coolDownDashModifiervalue,og_coolDownDashModifiervalue) og_coolDownDashModifiervalue=nil end
        if og_baseDashCdCooldownvalue then writeFloat(baseDashCdCooldownvalue,og_baseDashCdCooldownvalue) og_baseDashCdCooldownvalue=nil end
      end


end --timer



