</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>2251</ID>
              <Description>"Place Anywhere"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
define(address,Assets.Scripts.Simulation.Track.Map.CanPlace)
define(bytes,48 8B C4 4C 89 48 20)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Assets.Scripts.Simulation.Track.Map.CanPlace)

label(code)
label(return)

newmem:

code:
  mov al,1
  ret
  jmp return

address:
  jmp newmem
  nop 2
return:

[DISABLE]

address:
  db bytes

dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>2254</ID>
              <Description>"Rapid Fire"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
define(address,"GameAssembly.dll"+63D534) //Assets.Scripts.Simulation.Towers.Weapons.Weapon.CalcRateFrames

define(bytes,F3 0F 10 70 70)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,"GameAssembly.dll"+63D534)

label(code)
label(return)

newmem:
mov [rax+70],(float)0
mov [rax+74],#0

code:
  movss xmm6,[rax+70]
  jmp return

address:
  jmp newmem
return:

[DISABLE]

address:
  db bytes

dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>2253</ID>
              <Description>"Unlock All Upgrades &amp; Towers"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,"GameAssembly.dll"+C23084)
define(bytes,48 8B D9 75 1F)

[ENABLE]

//Assets.Scripts.Unity.Player.Btd6Player.HasUpgrade
//Send@Sintrix

assert(address,bytes)
alloc(newmem,$1000,"GameAssembly.dll"+C23084)

label(code)
label(return)

newmem:
mov [rcx+98],1
mov [rcx+99],1

code:
  mov rbx,rcx
  jne GameAssembly.dll+C230A8
  jmp return

address:
  jmp newmem
return:

[DISABLE]

address:
  db bytes

dealloc(*)

</AssemblerScript>
