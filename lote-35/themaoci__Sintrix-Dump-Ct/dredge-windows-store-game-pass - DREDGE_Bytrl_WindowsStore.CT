                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

partTmr=createTimer() partTmr.Interval=10 partTmr.onTimer=function()

  local InventoryPartCount=getAddressSafe('[[GetGM]+148]+30')
  local StoragePartCount=getAddressSafe('[[GetGM]+148]+34')
  local totalResearchParts=getAddressSafe('[[GetGM]+148]+38')

    if InventoryPartCount then
      writeInteger(InventoryPartCount,500)
      writeInteger(StoragePartCount,500)
      writeInteger(totalResearchParts,1000)
    end

end
[DISABLE]

if partTmr then partTmr.destroy() partTmr=nil end

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>368614</ID>
                  <Description>"Boost velocity"</Description>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
boostTmr=createTimer() boostTmr.Interval=1 boostTmr.onTimer=function()


  local x=getAddressSafe('[pCords]+D0')
  local y=getAddressSafe('[pCords]+D8')
  local boost=1.05

  if x and boost then
    if isKeyPressed(0x57) or isKeyPressed(0x53) or isKeyPressed(0x41) or isKeyPressed(0x44) then
      local vx = readFloat(x)
      local vy = readFloat(y)

      if math.abs(vx) &lt; 30 then
        writeFloat(x, vx * boost)
      end

      if math.abs(vy) &lt; 30 then
        writeFloat(y, vy * boost)
      end
    else
      writeFloat(x, 0)
      writeFloat(y, 0)
    end
  end

end
 
 
[DISABLE]
if boostTmr then boostTmr.destroy() boostTmr=nil end
</AssemblerScript>
                </CheatEntry>
