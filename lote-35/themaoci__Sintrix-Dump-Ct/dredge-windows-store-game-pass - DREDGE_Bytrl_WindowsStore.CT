              <CheatEntries>
                <CheatEntry>
                  <ID>368882</ID>
                  <Description>"No waves"</Description>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local waterHeight=getAddressSafe('[[GetGM]+168]+30')
local steepness=getAddressSafe('[[GetGM]+168]+34')
local waveLength=getAddressSafe('[[GetGM]+168]+38')
local waveSpeed=getAddressSafe('[[GetGM]+168]+3C')

[ENABLE]

if waterHeight and steepness and waveLength and waveSpeed then
  o_waterHeight=readFloat(waterHeight)
  o_steepness=readFloat(steepness)
  o_waveLength=readFloat(waveLength)
  o_waveSpeed=readFloat(waveSpeed)
  writeFloat(waterHeight,0)
  writeFloat(steepness,0)
  writeFloat(waveLength,0)
  writeFloat(waveSpeed,0)
end

[DISABLE]

if waterHeight and o_waterHeight and steepness and o_steepness and waveLength and o_waveLength and waveSpeed and o_waveSpeed then
  writeFloat(waterHeight,o_waterHeight) o_waterHeight=nil
  writeFloat(steepness,o_steepness) o_steepness=nil
  writeFloat(waveLength,o_waveLength) o_waveLength=nil
  writeFloat(waveSpeed,o_waveSpeed) o_waveSpeed=nil
end
