                <CheatEntry>
                  <ID>368851</ID>
                  <Description>"Fish stay fresh"</Description>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

local freshnessLossPerDay=getAddressSafe('[[[GetGM]+160]+20]+190')
local maxFreshness =getAddressSafe('[[[GetGM]+160]+20]+194')
local maxFreshnessLossReduction=getAddressSafe('[[[GetGM]+160]+20]+198')

[ENABLE]

if freshnessLossPerDay and maxFreshness and maxFreshnessLossReduction then
  writeFloat(freshnessLossPerDay,0)
  writeFloat(maxFreshness,5)
  writeFloat(maxFreshnessLossReduction,1)
end

[DISABLE]

if freshnessLossPerDay and maxFreshness and maxFreshnessLossReduction then
