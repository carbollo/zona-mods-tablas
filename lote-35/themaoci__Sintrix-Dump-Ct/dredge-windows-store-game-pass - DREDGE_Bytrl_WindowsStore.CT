  <CheatEntries>
    <CheatEntry>
      <ID>769</ID>
      <Description>"Initialize"</Description>
      <Options moHideChildren="1"/>
      <Color>008080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

openProcess('DREDGE.exe')
mono_initialize()
LaunchMonoDataCollector()

[DISABLE]


</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>368661</ID>
          <Description>"Enable In-Game"</Description>
          <Options moHideChildren="1"/>
          <Color>008080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : DREDGE.exe
  Version: 
  Date   : 2025-05-15
  Author : Bytrl

  GameManager:Update
  55 48 * * 48 * * * 48 * * * 48 * * F3 * * * * * * * F3 * * * F2 * * * F3 * * * * 48 * * * * * * 66 * * 49
}

define(gmu_address,GameManager:Update)
define(bytes,55 48 8B EC 48 83 EC 60 48 89 75 F8 48 8B F1 F3 0F 10 05 A9)

[ENABLE]

assert(gmu_address,bytes)
alloc(newmem_gmu,$100)
alloc(GetGM,8)
label(code_gmu return_gmu)
newmem_gmu:
  mov [GetGM],rcx
code_gmu:
  push rbp
  mov rbp,rsp
  sub rsp,60
  jmp return_gmu
gmu_address:
  jmp newmem_gmu
  nop 3
return_gmu:
registersymbol(gmu_address newmem_gmu GetGM)


aobscanmodule(find_cords,UnityPlayer.dll,F3 * * * * * * * * F3 * * * * * * * * F3 * * * * * * * * 8B * * C1 * * F3 * * * * * * F3 * * * * * * 83)
alloc(newmemfind_cords,$100,find_cords)
alloc(pCords,8,find_cords)
label(codefind_cords returnfind_cords)
newmemfind_cords:
  mov [pCords],rsi
codefind_cords:
  movss [rsi+00000150],xmm11
  jmp returnfind_cords
find_cords:
  jmp newmemfind_cords
  nop 4
returnfind_cords:
registersymbol(find_cords pCords)

[DISABLE]

gmu_address:
db bytes

find_cords:
db F3 44 0F 11 9E 50 01 00 00

unregistersymbol(*)
dealloc(*)
