            <CheatEntry>
              <ID>21</ID>
              <Description>"-&gt; Set Collected Numbers(open manager)"</Description>
              <Options moHideChildren="1"/>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Target:  Beltmatic.exe
//Author:  Salis
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  setallnums  \\\\\\\\\\\\\\\\\\\\\\\\
//48 8B 0C C1 B0 01 48 89 0B 48 8B 5C 24 30 48 83 C4 20 5F C3 E8 D4
aobscanmodule(address,GameAssembly.dll,48 8B 0C C1 B0 01 48 89 0B 48 8B 5C 24 30 48 83 C4 20 5F C3 E8)
alloc(newmem,1024,GameAssembly.dll)
alloc(obytes_setallnums, 10)
label(return originalcode)

registersymbol(obytes_setallnums newvalx)

obytes_setallnums:
readmem(address, 10)

newmem:

originalcode:
 push rbx
 mov rbx,[newvalx]
 mov [rcx+rax*8], rbx
 pop rbx
 mov rcx,[rcx+rax*8]
 mov al,01
 jmp return

newvalx:
dd (int)2147000000

address:
 jmp newmem
 nop
return:


[DISABLE]

address:
readmem(obytes_setallnums, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
