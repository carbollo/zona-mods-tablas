          <CheatEntries>
            <CheatEntry>
              <ID>9</ID>
              <Description>"-&gt; Get PremiumData"</Description>
              <Options moHideChildren="1"/>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Target:  Idle Research.exe
//Author:  Salis
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  diamondflasks  \\\\\\\\\\\\\\\\\\\\\\\\

aobscanmodule(address,GameAssembly.dll,F2 0F 5C B1 A0 00 00 00)
alloc(newmem,1024,GameAssembly.dll)
alloc(obytes_diamondflasks, 10)
label(return originalcode)

registersymbol(obytes_diamondflasks gvals)

obytes_diamondflasks:
readmem(address, 10)

newmem:

originalcode:

 mov [gvals], rcx
 subsd xmm6,[rcx+000000A0]
 jmp return

gvals:
dd 0

address:
 jmp newmem
 nop 3
return:


[DISABLE]

address:
readmem(obytes_diamondflasks, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
