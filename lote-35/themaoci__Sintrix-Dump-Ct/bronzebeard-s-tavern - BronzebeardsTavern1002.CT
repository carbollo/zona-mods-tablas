<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>44</ID>
      <Description>"Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'GameProject-Win64-Shipping.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end


--Set Window Title
local title = "Bronzebeard's Tavern 1.0.2";
if not((MainForm.Caption):match("Bronzebeard's Tavern")) then
MainForm.Caption = title..' ~ '..MainForm.Caption
end

--Credits
if MainForm.lblSigned.Caption:match('Sintrix / Build 16592632') == nil then
  local Main = MainForm.lblSigned
  local MadeBy = createPanel(Main.Parent)


  MadeBy.AutoSize = true
  MadeBy.Anchors = '[akTop,akRight,akLeft]'
  MadeBy.AnchorSideTop.Control = MadeBy.Parent
  MadeBy.AnchorSideTop.Side = asrCenter
  MadeBy.AnchorSideRight.Control = MainForm.CommentButton
  MadeBy.AnchorSideRight.Side = asrLeft
  MadeBy.AnchorSideLeft.Control = MainForm.advancedbutton
  MadeBy.AnchorSideLeft.Side = asrRight

  Main.Parent = MadeBy
  Main.Visible = true
  Main.Caption = 'Sintrix / Build 16592632'
  Main.Font.Size = 12
  Main.Font.Style = '[fsBold]'
  Main.Font.Quality = 'fqCleartypeNatural'
  Main.AnchorSideTop.Control = MadeBy
  Main.AnchorSideTop.Side = asrCenter
  Main.AnchorSideLeft.Control = MadeBy
  Main.AnchorSideLeft.Side = asrCenter
end


getMainForm().Panel4.Visible = true;
{$asm}
[DISABLE]
{$Lua}

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>26535</ID>
          <Description>"Infinite Health"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(health,GameProject-Win64-Shipping.exe,89 81 10 07 00 00 85 C0 7F 11)
alloc(newmem,$1000,health)

label(code)
label(return)

newmem:

code:
  mov [rcx+00000710],#5
  jmp return

health:
  jmp newmem
  nop
return:
registersymbol(health)

[DISABLE]

health:
  db 89 81 10 07 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>26524</ID>
          <Description>"Infinite Stamina"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(stamina,GameProject-Win64-Shipping.exe,4F 80 B9 1C 07 00 00 00 74 08 F3 0F 11 89 18 07 00 00)
alloc(newmem,$1000,stamina)

label(code)
label(return)

newmem:

code:
  movss xmm1,[stam]
  movss [rcx+00000718],xmm1
  jmp return

stam:
dd (float)62.5

stamina+0A:
  jmp newmem
  nop 3
return:
registersymbol(stamina)

[DISABLE]

stamina+0A:
  db F3 0F 11 89 18 07 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>26526</ID>
          <Description>"Grab Tavern Data (Gain/Spend Money)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(money,GameProject-Win64-Shipping.exe,F3 0F 11 B3 BC 02 00 00)
alloc(newmem,$1000,money)
label(code return)
registersymbol(cash)

newmem:
mov [cash],rbx

code:
  movss [rbx+000002BC],xmm6
  jmp return

cash:
dq 0

money:
  jmp newmem
  nop 3
return:
registersymbol(money)

[DISABLE]

money:
  db F3 0F 11 B3 BC 02 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>26529</ID>
              <Description>"Tavern Money"</Description>
              <VariableType>Float</VariableType>
              <Address>[cash]+2BC</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>26530</ID>
              <Description>"Tavern Bills"</Description>
              <VariableType>Float</VariableType>
              <Address>[cash]+2C0</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>26531</ID>
              <Description>"Employee of The Day Reward"</Description>
              <VariableType>Float</VariableType>
              <Address>[cash]+2B8</Address>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
