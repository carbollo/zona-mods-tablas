            <CheatEntry>
              <ID>397</ID>
              <Description>"One Hit Kill"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(ehp,GameAssembly.dll,F2 0F 5C C6 66 0F 2F F8 F2 0F 11 83 B0)
alloc(newmem,$1000,ehp)
label(code)
label(return)

newmem:
xorps xmm0,xmm0
code:
  subsd xmm0,xmm6
  comisd xmm7,xmm0
  jmp return

ehp:
  jmp newmem
  nop 3
return:
registersymbol(ehp)

aobscanmodule(bhp,GameAssembly.dll,F3 0F 5C C7 0F 2F F0)
alloc(newmem2,$1000,bhp)
label(code2)
label(return2)

newmem2:
xorps xmm0,xmm0
code2:
  subss xmm0,xmm7
  comiss xmm6,xmm0
  jmp return2

bhp:
  jmp newmem2
  nop 2
return2:
registersymbol(bhp)

[DISABLE]

ehp:
  db F2 0F 5C C6 66 0F 2F F8

bhp:
  db F3 0F 5C C7 0F 2F F0

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>313</ID>
              <Description>"Enable Chest Hunt Spawner"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end
local chPointer = mono_name_getStaticFieldValue('','ChestHuntManager','instance')
registerSymbol("chptr", chPointer );
chptrstring = string.format("0x%X",chPointer )


{$asm}
[DISABLE]

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>327</ID>
                  <Description>"Start Chest Hunt"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

if not monopipe then if LaunchMonoDataCollector() == 0 then  error(MessageDialog('Failed to Launch Mono Data Collector', mtError, mbClose)) end end

local method = mono_findMethod('', 'ChestHuntManager', 'StartEvent')

mono_invoke_method('', method, chptrstring,args)

if not syntaxcheck then
   synchronize(createTimer,60,memrec.setActive,false)
  end
 
{$asm}
[DISABLE]

</AssemblerScript>
                  <Hotkeys>
                    <Hotkey>
                      <Action>Toggle Activation</Action>
                      <Keys>
                        <Key>117</Key>
                      </Keys>
                      <ID>0</ID>
                    </Hotkey>
                  </Hotkeys>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
