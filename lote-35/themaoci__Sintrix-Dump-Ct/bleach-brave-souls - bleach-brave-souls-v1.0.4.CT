  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"Enable Bypass"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local s=findTableFile('SintrixBytrl.lua').Stream load(readStringLocal(s.Memory,s.Size))()

if process ~= 'Not_pad.exe' then
    showMessage('Cheat Engine will reboot when you click okay, you will need to reload this table and activate this script again to continue!')
    stringOnlyUdce()
else
    retitleAll()
    changeMemRec('Enable Bypass', 'Launch BLEACH Brave Souls now!')
end

[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>104576</ID>
          <Description>"Attach Game"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
startTable('BleachBraveSouls.exe','BleachBraveSouls v1.0.4 x SEND &amp; BVTRL', '', '')
changeMemRec('Launch BLEACH Brave Souls now!', 'Attached to BleachBraveSouls.exe')
[DISABLE]

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>104577</ID>
              <Description>"Disable Enemy Attacks"</Description>
              <VariableType>Auto Assembler Script</VariableType>
