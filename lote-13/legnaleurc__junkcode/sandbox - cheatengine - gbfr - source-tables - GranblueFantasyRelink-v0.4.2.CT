  mov [gbfr_SigilLevelSnapshot],eax
  mov r9d,[gbfr_SigilSecondaryTrait]
  mov [gbfr_SigilTraitSnapshot],r9d
  test r9d,r9d
  je gbfr_SigilTraitReady

  mov eax,[r10+0C]
  test eax,eax
  je gbfr_SigilInvalidTrait
  mov r10,gbfr_SigilPools
gbfr_SigilFindPool:
  mov ecx,[r10]
  test ecx,ecx
  je gbfr_SigilInvalidTrait
  cmp ecx,eax
  je gbfr_SigilPoolReady
  mov ecx,[r10+04]
  lea r10,[r10+rcx*4+08]
  jmp gbfr_SigilFindPool

gbfr_SigilPoolReady:
  mov ecx,[r10+04]
  add r10,08
gbfr_SigilCheckTrait:
  test ecx,ecx
  je gbfr_SigilInvalidTrait
  cmp [r10],r9d
  je gbfr_SigilTraitReady
  add r10,04
  dec ecx
  jmp gbfr_SigilCheckTrait

gbfr_SigilTraitReady:
