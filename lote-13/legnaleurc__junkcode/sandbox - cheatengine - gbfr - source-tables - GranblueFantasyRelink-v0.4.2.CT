gbfr_SelectedSigilRenderSite:
  jmp gbfr_SigilMem
  nop 2
gbfr_SelectedSigilRenderReturn:

[DISABLE]
assert(gbfr_SigilCreateBusy,00 00 00 00)
assert(gbfr_SigilCreateArmed,00 00 00 00)

gbfr_SelectedSigilRenderSite:
  db 48 8B 51 18 48 85 D2

unregistersymbol(gbfr_SigilCreateStatus)
unregistersymbol(gbfr_SigilCreateArmed)
unregistersymbol(gbfr_SigilCreateBusy)
unregistersymbol(gbfr_SigilSecondaryTrait)
unregistersymbol(gbfr_SigilLevel)
unregistersymbol(gbfr_SigilDefinition)
unregistersymbol(gbfr_SigilCreate)
unregistersymbol(gbfr_SigilCreateMatch)
unregistersymbol(gbfr_SetSigilTrait)
unregistersymbol(gbfr_SetSigilTraitMatch)
unregistersymbol(gbfr_SelectedSigilRenderAOB)
]]></AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>42011</ID>
              <Description>"Create Sigil"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
-- CE_STANDALONE_SIGIL_SELECTOR
if syntaxcheck then return end

local record = memrec

local function finish(message)
  if message ~= nil then
    showMessage(message)
  end
  local timer = createTimer(nil, false)
  timer.Interval = 50
  timer.OnTimer = function()
    timer.Enabled = false
    timer.destroy()
    if record ~= nil then
      record.Active = false
    end
  end
  timer.Enabled = true
end

local tableFile = findTableFile("gbfr_sigil_catalog.dat")
if tableFile == nil then
  finish("The embedded Sigil catalog could not be loaded.")
  return
end

local stream = tableFile.getData()
if stream == nil or stream.Size == 0 then
  finish("The embedded Sigil catalog is empty.")
  return
end

stream.Position = 0
local catalogText = stream.readString(stream.Size)
stream.destroy()

local sigils = {}
local sigilByText = {}
local traitNames = {}
local pools = {}

for line in catalogText:gmatch("[^\r\n]+") do
  local hash, minimum, maximum, mode, reference, name = line:match("^S\t([0-9A-F]+)\t(%d+)\t(%d+)\t(%d+)\t([0-9A-F]+)\t(.+)$")
  if hash ~= nil then
    local item = {
      hash = hash,
      minimum = tonumber(minimum),
      maximum = tonumber(maximum),
      mode = tonumber(mode),
      reference = reference,
      text = string.format("%s | %s | Lv %s-%s", name, hash, minimum, maximum)
    }
    table.insert(sigils, item)
    sigilByText[item.text] = item
  else
    local traitHash, traitName = line:match("^T\t([0-9A-F]+)\t(.+)$")
    if traitHash ~= nil then
      traitNames[traitHash] = traitName
    else
      local pool, poolHash = line:match("^P\t(%d+)\t([0-9A-F]+)$")
      if pool ~= nil then
        pool = tonumber(pool)
        pools[pool] = pools[pool] or {}
        table.insert(pools[pool], poolHash)
      end
    end
  end
end

if #sigils == 0 then
  finish("The embedded Sigil catalog is invalid.")
  return
end

local sigilList = createStringList()
for _, item in ipairs(sigils) do
  sigilList.add(item.text)
end
local _, selectedText = showSelectionList(
  "Create Sigil",
  "Choose a Sigil:",
  sigilList,
  false
)
sigilList.destroy()

local sigil = sigilByText[selectedText]
if sigil == nil then
  finish()
  return
end

local levelText = inputQuery(
  "Create Sigil",
  string.format("Level (%d-%d):", sigil.minimum, sigil.maximum),
  tostring(sigil.minimum)
)
if levelText == nil then
  finish()
  return
end

local level = tonumber(levelText)
if level == nil or level % 1 ~= 0
   or level < sigil.minimum or level > sigil.maximum then
  finish(string.format("Enter a whole level from %d to %d.", sigil.minimum, sigil.maximum))
  return
end

local secondaryHash = "00000000"
if sigil.mode == 2 then
  local candidates = pools[tonumber(sigil.reference)]

  local secondaryList = createStringList()
  local secondaryByText = {}
  local randomText = "Game-native random | 00000000"
  secondaryList.add(randomText)
  secondaryByText[randomText] = "00000000"
  if candidates ~= nil then
    for _, traitHash in ipairs(candidates) do
      local traitName = traitNames[traitHash]
      if traitName ~= nil then
        local text = string.format("%s | %s", traitName, traitHash)
        secondaryList.add(text)
        secondaryByText[text] = traitHash
      end
    end
  end

  local _, selectedSecondary = showSelectionList(
    "Create Sigil",
    "Choose a secondary trait:",
    secondaryList,
    false
  )
  secondaryList.destroy()
  secondaryHash = secondaryByText[selectedSecondary]
  if secondaryHash == nil then
    finish()
    return
  end
end

local definitionAddress = getAddressSafe("gbfr_SigilDefinition")
local levelAddress = getAddressSafe("gbfr_SigilLevel")
local secondaryAddress = getAddressSafe("gbfr_SigilSecondaryTrait")
local requestAddress = getAddressSafe("gbfr_SigilCreateArmed")
if definitionAddress == nil or definitionAddress == 0
   or levelAddress == nil or levelAddress == 0
   or secondaryAddress == nil or secondaryAddress == 0
   or requestAddress == nil or requestAddress == 0 then
  finish("Enable Sigil Creator before using Create Sigil.")
  return
end

local function dword(hex)
  local value = tonumber(hex, 16)
  if value >= 2147483648 then
    return value - 4294967296
  end
  return value
end

writeInteger(definitionAddress, dword(sigil.hash))
writeInteger(levelAddress, level)
writeInteger(secondaryAddress, dword(secondaryHash))
writeInteger(requestAddress, 1)
finish("Request queued. Open Inventory > Sigils and change the selected Sigil.")
{$asm}

[DISABLE]
]]></AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>42012</ID>
              <Description>"Last Create Result (2=Created; 3-7=Error)"</Description>
              <VariableType>4 Bytes</VariableType>
              <Address>gbfr_SigilCreateStatus</Address>
              <DropDownList ReadOnly="1" DescriptionOnly="1" DisplayValueAsItem="1">0:Ready
1:Creating
2:Created
3:Invalid Sigil or level
4:Game rejected request
5:Secondary trait failed
6:Unique Sigil already owned
7:Incompatible secondary trait</DropDownList>
            </CheatEntry>
