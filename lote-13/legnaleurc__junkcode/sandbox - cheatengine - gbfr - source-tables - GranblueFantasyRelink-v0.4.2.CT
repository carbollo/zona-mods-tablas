gbfr_SigilMem:
  mov rdx,[rcx+18]
  test rdx,rdx
  pushfq
  je gbfr_SigilReplay
  cmp dword ptr [gbfr_SigilCreateArmed],1
  jne gbfr_SigilReplay

  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,90
  movdqu [rsp+30],xmm0
  movdqu [rsp+40],xmm1
  movdqu [rsp+50],xmm2
  movdqu [rsp+60],xmm3
  movdqu [rsp+70],xmm4
  movdqu [rsp+80],xmm5

  xor eax,eax
  mov edx,1
  lock cmpxchg dword ptr [gbfr_SigilCreateBusy],edx
  jne gbfr_SigilRestore
  cmp dword ptr [gbfr_SigilCreateArmed],1
  jne gbfr_SigilCancelled

  mov dword ptr [gbfr_SigilCreateArmed],0
  mov dword ptr [gbfr_SigilCreateStatus],1
  mov dword ptr [gbfr_SigilCreatedHandle],0
  mov [gbfr_SigilOwner],rdi

  mov r11d,[gbfr_SigilDefinition]
  mov r10,gbfr_SigilCatalog
gbfr_SigilFindDefinition:
  mov eax,[r10]
  test eax,eax
  je gbfr_SigilInvalid
  cmp eax,r11d
  je gbfr_SigilDefinitionReady
  add r10,10
  jmp gbfr_SigilFindDefinition

gbfr_SigilDefinitionReady:
