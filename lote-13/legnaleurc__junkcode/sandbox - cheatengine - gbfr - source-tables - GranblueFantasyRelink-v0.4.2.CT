  mov [gbfr_SigilCreatedHandle],eax
  test eax,eax
  je gbfr_SigilRejected
  cmp dword ptr [gbfr_SigilTraitSnapshot],0
  je gbfr_SigilSuccess

  mov r10,[gbfr_SigilOwner]
  add r10,000025D0
  mov ecx,000013EC
gbfr_SigilFindCreated:
  mov eax,[gbfr_SigilCreatedHandle]
  cmp [r10+1C],eax
  jne gbfr_SigilFindCreatedNext
  mov eax,[gbfr_SigilDefinitionSnapshot]
  cmp [r10+10],eax
  je gbfr_SigilApplyTrait
gbfr_SigilFindCreatedNext:
  add r10,24
  dec ecx
  jnz gbfr_SigilFindCreated
  jmp gbfr_SigilTraitFailed

gbfr_SigilApplyTrait:
  mov [gbfr_SigilCreatedEntry],r10
  mov rcx,[gbfr_SigilOwner]
  mov edx,[gbfr_SigilCreatedHandle]
  mov r8d,1
  mov r9d,[gbfr_SigilTraitSnapshot]
