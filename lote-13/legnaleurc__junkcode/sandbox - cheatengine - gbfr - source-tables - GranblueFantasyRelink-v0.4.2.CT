  add r10,000025D0
  mov ecx,000013EC
gbfr_SigilDuplicateLoop:
  cmp dword ptr [r10+1C],0
  je gbfr_SigilDuplicateNext
  cmp dword ptr [r10+10],r11d
  je gbfr_SigilDuplicate
gbfr_SigilDuplicateNext:
  add r10,24
  dec ecx
  jnz gbfr_SigilDuplicateLoop

gbfr_SigilCreateReady:
  mov eax,[gbfr_SigilLevelSnapshot]
  mov [rsp+20],eax
  mov rcx,[gbfr_SigilOwner]
  mov edx,[gbfr_SigilDefinitionSnapshot]
  xor r8d,r8d
