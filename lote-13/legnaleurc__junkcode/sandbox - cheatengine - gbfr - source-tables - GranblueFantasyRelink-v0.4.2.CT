        <CheatEntry>
          <ID>42005</ID>
          <Description>"Camera Distance / Zoom Out"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_CameraDistanceAOB,granblue_fantasy_relink.exe,C5 F8 28 FA 48 89 F1)
assert(gbfr_CameraDistanceAOB,C5 F8 28 FA 48 89 F1)

alloc(newmem,$100,gbfr_CameraDistanceAOB)
registersymbol(gbfr_CameraDistanceAOB)
registersymbol(gbfr_CameraDistanceMultiplier)

label(return)
label(gbfr_CameraDistanceMultiplier)

newmem:
  vmulss xmm7,xmm2,[gbfr_CameraDistanceMultiplier]
  mov rcx,rsi
  jmp return

align 4 CC
gbfr_CameraDistanceMultiplier:
  dd (float)2.0

gbfr_CameraDistanceAOB:
  jmp newmem
  nop 2
return:

[DISABLE]
gbfr_CameraDistanceAOB:
  db C5 F8 28 FA 48 89 F1

unregistersymbol(gbfr_CameraDistanceMultiplier)
unregistersymbol(gbfr_CameraDistanceAOB)
dealloc(newmem)
]]></AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>42006</ID>
              <Description>"Distance Multiplier (1=normal)"</Description>
              <VariableType>Float</VariableType>
              <Address>gbfr_CameraDistanceMultiplier</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>42007</ID>
              <Description>"Apply Distance Multiplier During Lock-On"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_LockOnCameraDistanceAOB,granblue_fantasy_relink.exe,C5 FA 10 8E C4 03 00 00 C5 BA 5C D0)
assert(gbfr_LockOnCameraDistanceAOB,C5 FA 10 8E C4 03 00 00 C5 BA 5C D0)

alloc(newmem,$200,gbfr_LockOnCameraDistanceAOB)
registersymbol(gbfr_LockOnCameraDistanceAOB)

label(normal)
label(return)

newmem:
  vmovss xmm1,[rsi+000003C4]
  cmp byte ptr [rsi+00000AF8],00
  je normal
  vmovss xmm2,[gbfr_CameraDistanceMultiplier]
  vmulss xmm2,xmm2,xmm8
  vsubss xmm2,xmm2,xmm0
  jmp return

normal:
  vsubss xmm2,xmm8,xmm0
  jmp return

gbfr_LockOnCameraDistanceAOB:
  jmp newmem
  nop 7
return:

[DISABLE]
gbfr_LockOnCameraDistanceAOB:
  db C5 FA 10 8E C4 03 00 00 C5 BA 5C D0

unregistersymbol(gbfr_LockOnCameraDistanceAOB)
dealloc(newmem)
]]></AssemblerScript>
            </CheatEntry>
