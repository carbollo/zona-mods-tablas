<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    <CheatEntry>
      <ID>90001</ID>
      <Description>"Initialize Mark For Save (enable this for Sigil &amp; Weapon Imbue)"</Description>
      <Color>808000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(GBFR_MarkForSave,granblue_fantasy_relink.exe,55 48 83 EC ? 48 8D ? ? ? 48 C7 45 F8 ? ? ? ? 48 8B ? ? ? ? ? 48 85 ? 0F 84 ? ? ? ? 4C 8B)
registersymbol(GBFR_MarkForSave)

{$lua}
if syntaxcheck then
  return
end

function MarkForSave(baseAddress,size)
  local GBFR_MarkForSave = GetAddressSafe("GBFR_MarkForSave")
  if GBFR_MarkForSave == nil then
    return nil
  end
  if baseAddress == nil or baseAddress &lt;= 0xFFFFFFF then
    return nil
  end
  local numberOfAddressesToSave = math.floor(size / 4)
  if size == 0 or size % 4 ~= 0 then
    numberOfAddressesToSave = numberOfAddressesToSave + 1
  end
  local resultTable = { success = 0, total = numberOfAddressesToSave }
  for i = 0, numberOfAddressesToSave-1 do
    local address = baseAddress + i * 4
    local result = ExecuteCode(GBFR_MarkForSave, address)
    if result ~= 0 then
      resultTable.success = resultTable.success + 1
    end
  end
  return resultTable
end

function MarkForSaveWrapper(baseAddress, size)
  local saveResult = MarkForSave(baseAddress, size)
  ShowMessage(saveResult and ("Marked for save (" .. saveResult.success .. "/" .. saveResult.total .. ")") or "Mark for save FAILED (function not found on this build)")
end
{$asm}
[DISABLE]
unregistersymbol(GBFR_MarkForSave)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>2240</ID>
      <Description>"Sigil Editor"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game    : granblue_fantasy_relink.exe

  RECORD LAYOUT (base = SigilEdit_C - 0x18), stride 0x24
    +00 Trait 1 ID    +04 Trait 1 Level
    +08 Trait 2 ID    +0C Trait 2 Level
    +10 Sigil ID      +14 possible Trait 3 ID (holds the "None" ID when empty)
    +18 Sigil Level   +1C unmapped        +20 unmapped

  IF THIS STOPS ENABLING, it means the pattern moved or went ambiguous after a game update.
}

[ENABLE]

aobscanmodule(Sigil_Edit_C,granblue_fantasy_relink.exe,8B 47 18 39 46 18 74 0B 48 8D 4E 18 89 01 E8 ?? ?? ?? ?? 8B 47 1C 39 46 1C 74 0B 48 8D 4E 1C 89 01 E8 ?? ?? ?? ?? 8B 47 20 39 46 20 74 0B 48 8D 4E 20 89 01 E8 ?? ?? ?? ?? 48 89 F0 48 83 C4 30)
assert(Sigil_Edit_C,8B 47 18 39 46 18)
alloc(newmem,$1000,Sigil_Edit_C)
globalalloc(SigilEdit_C,8)
globalalloc(SigilHit_C,4)
label(return)

newmem:
  push rax
  push rbx
  lea rax,[rdi+18]
  mov [SigilEdit_C],rax
  mov rbx,SigilHit_C
  inc dword ptr [rbx]
  pop rbx
  pop rax
  mov eax,[rdi+18]
  cmp [rsi+18],eax
  jmp return

Sigil_Edit_C:
  jmp newmem
  nop
return:
registersymbol(Sigil_Edit_C)

[DISABLE]

Sigil_Edit_C:
  db 8B 47 18 39 46 18

unregistersymbol(Sigil_Edit_C)
dealloc(newmem)
dealloc(SigilEdit_C)
dealloc(SigilHit_C)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>90002</ID>
          <Description>"Save Selected Sigil (tick to save, then untick)"</Description>
          <Color>008000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Marks the currently captured sigil for the save file.
  Requires: "Initialize Mark For Save" enabled, "Enable Sigil Editor" enabled,
  and a sigil highlighted so SigilEdit_C holds a pointer.
  EXPERIMENTAL. Back up your save first. Offline / single-player only. }

[ENABLE]
{$lua}
if syntaxcheck then return end
if getAddressSafe("SigilEdit_C") == nil then
  ShowMessage("Enable 'Enable Sigil Editor' first, then highlight a sigil.")
  return
end
if MarkForSaveWrapper == nil then
  ShowMessage("Enable 'Initialize Mark For Save' first.")
  return
end
local captured = readQword("SigilEdit_C")
if captured == nil or captured &lt;= 0xFFFFFFF then
  ShowMessage("No sigil captured. Highlight a sigil in the Gear list, then tick this again.")
  return
end
-- SigilEdit_C points at struct+0x18; record is 9 dwords = 0x24 bytes.
-- The copy function ends at field +20 and returns, so 0x24 is the exact
-- record size. Using 0x30 here would overrun into the next sigil.
MarkForSaveWrapper(captured - 0x18, 0x24)
{$asm}
[DISABLE]
</AssemblerScript>
        </CheatEntry>
