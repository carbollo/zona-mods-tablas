label(gbfr_OMRank)

newmem:
  lea rdx,[gbfr_OMBonus]
  mov r8d,[rdx+rdi*4]
  mov r9d,[rdx+rdi*4+10]
  jmp return

align 10 CC
gbfr_OMBonus:
