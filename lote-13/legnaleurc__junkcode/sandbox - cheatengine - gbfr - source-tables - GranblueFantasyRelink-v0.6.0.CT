  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>41999</ID>
      <Description>"Auto Attach to Process"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if syntaxcheck then return end
openProcess("granblue_fantasy_relink.exe")
{$asm}

[DISABLE]]]></AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>42029</ID>
          <Description>"Editors"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
          <Color>C08040</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]

[DISABLE]]]></AssemblerScript>
          <CheatEntries>
        <CheatEntry>
          <ID>42010</ID>
          <Description>"Sigil Creator"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_SelectedSigilRenderAOB,granblue_fantasy_relink.exe,48 8B 51 18 48 85 D2 74 ?? 48 8D 4C 24 24)
define(gbfr_SelectedSigilRenderSite,gbfr_SelectedSigilRenderAOB)
define(gbfr_SelectedSigilRenderContinue,gbfr_SelectedSigilRenderSite+09)
define(gbfr_SelectedSigilRenderNull,gbfr_SelectedSigilRenderSite+13)
assert(gbfr_SelectedSigilRenderSite,48 8B 51 18 48 85 D2)
assert(gbfr_SelectedSigilRenderSite+07,74 0A)

aobscanmodule(gbfr_SetSigilTraitMatch,granblue_fantasy_relink.exe,45 89 CF 44 89 C7 89 D3)
define(gbfr_SetSigilTrait,gbfr_SetSigilTraitMatch-19)
assert(gbfr_SetSigilTrait,55 41 57 41 56 56 57 53 48 83 EC 28 48 8D 6C 24 20 48 C7 45 00 FE FF FF FF 45 89 CF 44 89 C7 89 D3 49 89 CE 48 81 C1 C8 25 00 00)

aobscanmodule(gbfr_SigilCreateMatch,granblue_fantasy_relink.exe,45 89 C5 89 D3 8B 51 30)
define(gbfr_SigilCreate,gbfr_SigilCreateMatch-23)
assert(gbfr_SigilCreate,55 41 57 41 56 41 55 41 54 56 57 53 48 81 EC B8 00 00 00 48 8D AC 24 80 00 00 00 48 C7 45 30 FE FF FF FF 45 89 C5 89 D3 8B 51 30 21 DA)

alloc(gbfr_SigilMem,$1000,gbfr_SelectedSigilRenderSite)
registersymbol(gbfr_SigilRequest)

label(check_owned)
label(owned_loop)
label(owned_next)
label(create)
label(done)
label(gbfr_SigilRequest)
label(gbfr_UniqueSigils)

gbfr_SigilMem:
  mov rdx,[rcx+18]
  test rdx,rdx
  je gbfr_SelectedSigilRenderNull
  cmp dword ptr [gbfr_SigilRequest+0C],1
  jne gbfr_SelectedSigilRenderContinue
  mov dword ptr [gbfr_SigilRequest+0C],0

  push rdx
  sub rsp,28
  mov r11d,[gbfr_SigilRequest]
  mov r10,gbfr_UniqueSigils
@@:
  mov ecx,[r10]
  test ecx,ecx
  je create
  cmp ecx,r11d
  je check_owned
  add r10,04
  jmp @b

check_owned:
  lea r10,[rdi+000025D0]
  mov ecx,000013EC
owned_loop:
  cmp dword ptr [r10+1C],0
  je owned_next
  cmp [r10+10],r11d
  je done
owned_next:
  add r10,24
  dec ecx
  jne owned_loop

create:
  mov eax,[gbfr_SigilRequest+04]
  mov [rsp+20],eax
  mov rcx,rdi
  mov edx,r11d
  xor r8d,r8d
  xor r9d,r9d
  call gbfr_SigilCreate
  test eax,eax
  je done

  mov r9d,[gbfr_SigilRequest+08]
  test r9d,r9d
  je done
  cmp r9d,887AE0B0
  je done
  mov rcx,rdi
  mov edx,eax
  mov r8d,1
  call gbfr_SetSigilTrait

done:
  add rsp,28
  pop rdx
  jmp gbfr_SelectedSigilRenderContinue

align 4 CC
gbfr_SigilRequest:
  dd 0,0,0,0

gbfr_UniqueSigils:
  dd D8A464F1
  dd 1A57AEF1
  dd 1C4D37E4
  dd 82F1E7E4
  dd 426AD20E
  dd F8FEF304
  dd 4F01D6CA
  dd 8ECBB0A3
  dd AB835493
  dd E4F986D9
  dd 5A360EA8
  dd CE16D68B
  dd 52A6E299
  dd 02B1F8C0
  dd 895ABBF6
  dd 9ADA3E00
  dd 98A6D249
  dd 673C5D8F
  dd AEEF8343
  dd 49434696
