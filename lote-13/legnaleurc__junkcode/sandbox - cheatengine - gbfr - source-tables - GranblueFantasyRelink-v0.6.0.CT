        <CheatEntry>
          <ID>42008</ID>
          <Description>"Freeze Quest Timer"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_TimerWrite,granblue_fantasy_relink.exe,C5 FA 11 46 34 48 8B 05)
aobscanmodule(gbfr_TimerCheck,granblue_fantasy_relink.exe,48 83 EC 28 80 79 48 00)
aobscanmodule(gbfr_TimerSlot,granblue_fantasy_relink.exe,C5 FA 58 4E 04)
assert(gbfr_TimerWrite,C5 FA 11 46 34)
assert(gbfr_TimerCheck,48 83 EC 28 80 79 48 00)
assert(gbfr_TimerSlot,C5 FA 58 4E 04)

alloc(newmem,$500,gbfr_TimerWrite)
registersymbol(gbfr_TimerWrite)
registersymbol(gbfr_TimerCheck)
registersymbol(gbfr_TimerSlot)

label(check)
label(check_done)
label(check_return)
label(slot)
label(slot_code)
label(slot_return)
label(timer_slot)

newmem:
check:
  push rax
  cmp byte ptr [rcx+48],00
  jne check_done
  cmp byte ptr [rcx+28],00
  jne check_done
  cmp dword ptr [rcx+20],00
  jne check_done
  mov rax,[rcx+10]
  test rax,rax
  je check_done
  add rax,D8
  mov [timer_slot],rax
check_done:
  pop rax
  sub rsp,28
  cmp byte ptr [rcx+48],00
  jmp check_return

slot:
  cmp rsi,[timer_slot]
  jne slot_code
  vxorps xmm0,xmm0,xmm0
slot_code:
  vaddss xmm1,xmm0,[rsi+04]
  jmp slot_return

align 8 CC
timer_slot:
  dq 0

gbfr_TimerWrite:
  nop 5
gbfr_TimerCheck:
  jmp check
  nop 3
check_return:
gbfr_TimerSlot:
  jmp slot
slot_return:

[DISABLE]
gbfr_TimerWrite:
  db C5 FA 11 46 34
gbfr_TimerCheck:
  db 48 83 EC 28 80 79 48 00
gbfr_TimerSlot:
  db C5 FA 58 4E 04

unregistersymbol(gbfr_TimerSlot)
unregistersymbol(gbfr_TimerCheck)
unregistersymbol(gbfr_TimerWrite)
dealloc(newmem)
]]></AssemblerScript>
        </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>42030</ID>
          <Description>"Camera"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
