        <CheatEntry>
          <ID>42000</ID>
          <Description>"Auto Perfect Guard"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_GuardAOB,granblue_fantasy_relink.exe,56 57 48 83 EC 28 48 89 D6 48 89 CF 48 8B 49 10 48 8B 01)
aobscanmodule(gbfr_GuardFlowAOB,granblue_fantasy_relink.exe,4C 8B 76 10 77 ??)
// The update moved the referenced float constants.  Validate the instruction
// opcodes, but accept the new RIP-relative displacements.
assert(gbfr_GuardAOB+A2,C5 FA 10 05 ?? ?? ?? ??)
assert(gbfr_GuardAOB+B3,C5 FA 10 05 ?? ?? ?? ??)
assert(gbfr_GuardFlowAOB,4C 8B 76 10 77 55)

alloc(newmem,$1000,gbfr_GuardAOB+A2)
alloc(guardEarlyOriginal,8,gbfr_GuardAOB+A2)
alloc(guardLateOriginal,8,gbfr_GuardAOB+B3)
registersymbol(gbfr_GuardAOB)
registersymbol(gbfr_GuardFlowAOB)

guardEarlyOriginal:
  readmem(gbfr_GuardAOB+A2,8)
guardLateOriginal:
  readmem(gbfr_GuardAOB+B3,8)

label(early)
label(early_code)
label(early_return)
label(late)
label(late_code)
label(late_return)
label(flow)
label(flow_native)
label(flow_clear)
label(flow_return)
label(forced)

newmem:
early:
  pushfq
  push rax
  mov rax,[rdi+10]
  test rax,rax
  je early_code
  cmp dword ptr [rax+210],1
  jne early_code
  mov dword ptr [forced],1
  pop rax
  popfq
  jmp gbfr_GuardAOB+E1
early_code:
  pop rax
  popfq
  reassemble(gbfr_GuardAOB+A2)
  jmp early_return

late:
  pushfq
  push rax
  mov rax,[rdi+10]
  test rax,rax
  je late_code
  cmp dword ptr [rax+210],1
  jne late_code
  mov dword ptr [forced],1
  pop rax
  popfq
  jmp gbfr_GuardAOB+E1
late_code:
  pop rax
  popfq
  reassemble(gbfr_GuardAOB+B3)
  jmp late_return

flow:
  mov r14,[rsi+10]
  jna flow_clear
  cmp dword ptr [forced],1
  jne flow_native
  test r14,r14
  je flow_native
  cmp dword ptr [r14+210],1
  jne flow_native
  push rax
  mov rax,[r14+5AC0]
  test rax,rax
  je @f
  cmp dword ptr [rax+40],1
  pop rax
  jbe flow_native
  jmp flow_clear
@@:
  pop rax
flow_native:
  mov dword ptr [forced],0
  jmp gbfr_GuardFlowAOB+5B
flow_clear:
  mov dword ptr [forced],0
  jmp flow_return

align 4 CC
forced:
  dd 0

gbfr_GuardAOB+A2:
  jmp early
  nop 3
early_return:

gbfr_GuardAOB+B3:
  jmp late
  nop 3
late_return:

gbfr_GuardFlowAOB:
  jmp flow
  nop
flow_return:

[DISABLE]
gbfr_GuardAOB+A2:
  readmem(guardEarlyOriginal,8)
gbfr_GuardAOB+B3:
  readmem(guardLateOriginal,8)
gbfr_GuardFlowAOB:
  db 4C 8B 76 10 77 55

unregistersymbol(gbfr_GuardFlowAOB)
unregistersymbol(gbfr_GuardAOB)
dealloc(guardLateOriginal)
dealloc(guardEarlyOriginal)
dealloc(newmem)
]]></AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>42009</ID>
          <Description>"Auto Perfect Dodge"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_DodgeAOB,granblue_fantasy_relink.exe,84 C0 0F 84 ?? ?? ?? ?? 49 8B 06 4C 89 F1 FF 90 F0 09 00 00)
aobscanmodule(gbfr_RequestDodge,granblue_fantasy_relink.exe,56 57 53 48 83 EC 50 48 8B 41 10)
assert(gbfr_DodgeAOB,84 C0 0F 84 C6 00 00 00)
assert(gbfr_RequestDodge,56 57 53 48 83 EC 50)

alloc(newmem,$800,gbfr_DodgeAOB)
registersymbol(gbfr_DodgeAOB)

label(status_loop)
label(status_next)
label(status_clear)
label(status_active)
label(status_done)
label(success)
label(blocked)
label(code)
label(return)
label(request_owner)

newmem:
  cmp dword ptr [r14+210],1
  jne code
  cmp dword ptr [r14+40],48
  je blocked
  cmp qword ptr [r14+160],0
  je blocked
  cmp dword ptr [r14+40],2F
  je code
  test byte ptr [r14+1C726],02
  jne blocked

  push r8
  push r9
  push r10
  mov r8,[r14+AF8]
  mov r9,[r14+B00]
  cmp r8,r9
  je status_clear
  ja status_active
  mov r10,r9
  sub r10,r8
  cmp r10,400
  ja status_active
  test r10,07
  jne status_active
status_loop:
  mov r10,[r8]
  test r10,r10
  je status_next
  cmp dword ptr [r10+50],06
  je status_active
status_next:
  add r8,08
  cmp r8,r9
  jb status_loop
status_clear:
  clc
  jmp status_done
status_active:
  stc
status_done:
  pop r10
  pop r9
  pop r8
  jc blocked

  test al,al
  jne success
  cmp dword ptr [r14+40],04
  je code
  cmp qword ptr [request_owner],r14
  je blocked
  mov [request_owner],r14
  mov rcx,r15
  xor edx,edx
  call gbfr_RequestDodge
  mov qword ptr [request_owner],0
success:
  mov al,1
  test al,al
  jmp return
blocked:
  xor eax,eax
code:
  test al,al
  reassemble(gbfr_DodgeAOB+02)
  jmp return

align 8 CC
request_owner:
  dq 0

gbfr_DodgeAOB:
  jmp newmem
  nop 3
return:

[DISABLE]
gbfr_DodgeAOB:
  db 84 C0 0F 84 C6 00 00 00

unregistersymbol(gbfr_DodgeAOB)
dealloc(newmem)
]]></AssemblerScript>
        </CheatEntry>
          </CheatEntries>
        </CheatEntry>
