gbfr_SelectedSigilRenderSite:
  jmp gbfr_SigilMem
  nop 2

[DISABLE]
gbfr_SigilRequest+0C:
  dd 0

gbfr_SelectedSigilRenderSite:
  db 48 8B 51 18 48 85 D2

unregistersymbol(gbfr_SigilRequest)
]]></AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>42011</ID>
              <Description>"Create Sigil"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
-- CE_STANDALONE_SIGIL_SELECTOR
if syntaxcheck then return end

local selectorTitle = "Create Sigil"

local function finish(message)
  if message ~= nil then
    showMessage(message)
  end
  local timer = createTimer(nil, false)
  timer.Interval = 50
  timer.OnTimer = function()
    timer.destroy()
    memrec.Active = false
  end
  timer.Enabled = true
end

local tableFile = findTableFile("gbfr_sigil_catalog.dat")
if tableFile == nil then
  finish("The embedded Sigil catalog could not be loaded.")
  return
end

local stream = tableFile.getData()
if stream == nil or stream.Size == 0 then
  finish("The embedded Sigil catalog is empty.")
  return
end

stream.Position = 0
local catalogText = stream.readString(stream.Size)
stream.destroy()

local sigils = {}
local synthesisTraits = {}
local traitByHash = {}
local pools = {}
local synthesisDefinitionSet = {}

for line in catalogText:gmatch("[^\r\n]+") do
  local hash, minimum, maximum, mode, reference, name = line:match("^S\t([0-9A-F]+)\t(%d+)\t(%d+)\t(%d+)\t([0-9A-F]+)\t(.+)$")
  if hash ~= nil then
    local item = {
      hash = hash,
      minimum = tonumber(minimum),
      maximum = tonumber(maximum),
      mode = tonumber(mode),
      reference = reference,
      text = string.format("%s | %s | Lv %s-%s", name, hash, minimum, maximum)
    }
    table.insert(sigils, item)
  else
    local traitHash, traitName = line:match("^T\t([0-9A-F]+)\t(.+)$")
    if traitHash ~= nil then
      local trait = {
        hash = traitHash,
        text = string.format("%s | %s", traitName, traitHash)
      }
      if traitHash ~= "00000000" then
        traitByHash[traitHash] = trait
        table.insert(synthesisTraits, trait)
      end
    else
      local pool, poolHash = line:match("^P\t(%d+)\t([0-9A-F]+)$")
      if pool ~= nil then
        pool = tonumber(pool)
        pools[pool] = pools[pool] or {}
        table.insert(pools[pool], poolHash)
      else
        local synthesisDefinition = line:match("^Y\t([0-9A-F]+)$")
        if synthesisDefinition ~= nil then
          synthesisDefinitionSet[synthesisDefinition] = true
        end
      end
    end
  end
end

local sigilList = createStringList()
local sigilByText = {}
for _, item in ipairs(sigils) do
  sigilList.add(item.text)
  sigilByText[item.text] = item
end
local _, selectedText = showSelectionList(
  selectorTitle,
  "Choose a Sigil:",
  sigilList,
  false
)
sigilList.destroy()

local sigil = sigilByText[selectedText]
if sigil == nil then
  finish()
  return
end
local level = sigil.minimum
if sigil.minimum ~= sigil.maximum then
  local levelText = inputQuery(
    selectorTitle,
    string.format("Level (%d-%d):", sigil.minimum, sigil.maximum),
    tostring(sigil.minimum)
  )
  if levelText == nil then
    finish()
    return
  end
  level = tonumber(levelText)
  if level == nil or level % 1 ~= 0
     or level < sigil.minimum or level > sigil.maximum then
    finish(string.format("Enter a whole level from %d to %d.", sigil.minimum, sigil.maximum))
    return
  end
end

local secondaryHash = "00000000"
local secondaryList
local secondaryByText = {}
local secondaryPrompt
if synthesisDefinitionSet[sigil.hash] then
  secondaryList = createStringList()
  secondaryPrompt = "Choose a Sigil Synthesis-compatible secondary trait:"
  for _, trait in ipairs(synthesisTraits) do
    secondaryList.add(trait.text)
    secondaryByText[trait.text] = trait.hash
  end
elseif sigil.mode == 2 then
  local candidates = pools[tonumber(sigil.reference)]
  secondaryList = createStringList()
  secondaryPrompt = "Choose a natural secondary trait:"
  local randomText = "Game-native random | 00000000"
  secondaryList.add(randomText)
  secondaryByText[randomText] = "00000000"
  for _, traitHash in ipairs(candidates) do
    local trait = traitByHash[traitHash]
    secondaryList.add(trait.text)
    secondaryByText[trait.text] = trait.hash
  end
end

if secondaryList ~= nil then
  local _, selectedSecondary = showSelectionList(
    selectorTitle,
    secondaryPrompt,
    secondaryList,
    false
  )
  secondaryList.destroy()
  secondaryHash = secondaryByText[selectedSecondary]
  if secondaryHash == nil then
    finish()
    return
  end
end

local request = getAddressSafe("gbfr_SigilRequest")
if request == nil or request == 0 then
  finish("Enable Sigil Creator before using Create Sigil.")
  return
end
if readInteger(request + 0x0C) ~= 0 then
  finish("A Sigil request is already pending.")
  return
end

local function dword(hex)
  local value = tonumber(hex, 16)
  if value >= 2147483648 then
    return value - 4294967296
  end
  return value
end

writeInteger(request, dword(sigil.hash))
writeInteger(request + 0x04, level)
writeInteger(request + 0x08, dword(secondaryHash))
writeInteger(request + 0x0C, 1)
finish("Request queued. Open Inventory > Sigils and change the selected Sigil.")
{$asm}

[DISABLE]
]]></AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>42031</ID>
          <Description>"Summon Stone Spawner"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_SummonRenderHook,granblue_fantasy_relink.exe,41 8B 46 08 C5 F8 57 C0)
aobscanmodule(gbfr_SummonAddMatch,granblue_fantasy_relink.exe,89 D3 8B 51 30 21 DA 48 8B 41 08 4C 8B 41 18 49 89 D1)
define(gbfr_SummonAdd,gbfr_SummonAddMatch-23)
aobscanmodule(gbfr_SummonFinalizeHook,granblue_fantasy_relink.exe,44 8B A5 DC 02 00 00)
assert(gbfr_SummonAdd,55 41 57 41 56 41 55 41 54 56 57 53 48 81 EC A8 00 00 00)

alloc(gbfr_SummonMem,$1000,gbfr_SummonRenderHook)
registersymbol(gbfr_SummonRequest)

label(code)
label(return)
label(gbfr_SummonFinalizeMem)
label(gbfr_SummonApplyBonus)
label(gbfr_SummonFinalizeCode)
label(gbfr_SummonFinalizeReturn)
label(gbfr_SummonRequest)
label(gbfr_SummonOverride)

gbfr_SummonMem:
  cmp dword ptr [gbfr_SummonRequest+14],1
  jne code
  mov dword ptr [gbfr_SummonRequest+14],0

  mov eax,[gbfr_SummonRequest+04]
  or eax,[gbfr_SummonRequest+0C]
  mov [gbfr_SummonOverride],eax

  sub rsp,20
  mov rcx,rdi
  mov edx,[gbfr_SummonRequest]
  call gbfr_SummonAdd
  add rsp,20
  mov rcx,[rsi+00000188]
  mov dword ptr [gbfr_SummonOverride],0

code:
  mov eax,[r14+08]
  vxorps xmm0,xmm0,xmm0
  jmp return

gbfr_SummonFinalizeMem:
  cmp dword ptr [gbfr_SummonOverride],0
  je gbfr_SummonFinalizeCode
  mov eax,[gbfr_SummonRequest]
  cmp [rdi+08],eax
  jne gbfr_SummonFinalizeCode
  mov dword ptr [gbfr_SummonOverride],0

  mov eax,[gbfr_SummonRequest+04]
  test eax,eax
  je gbfr_SummonApplyBonus
  mov [r14],eax
  mov eax,[gbfr_SummonRequest+08]
  mov [rbx],eax

gbfr_SummonApplyBonus:
  mov eax,[gbfr_SummonRequest+0C]
  test eax,eax
  je gbfr_SummonFinalizeCode
  mov [r14+04],eax
  mov eax,[gbfr_SummonRequest+10]
  mov [rbx+04],eax

gbfr_SummonFinalizeCode:
  mov r12d,[rbp+000002DC]
  jmp gbfr_SummonFinalizeReturn

align 4 CC
gbfr_SummonRequest:
  dd 0,0,0,0,0,0
gbfr_SummonOverride:
  dd 0

gbfr_SummonRenderHook:
  jmp gbfr_SummonMem
  nop 3
return:

gbfr_SummonFinalizeHook:
  jmp gbfr_SummonFinalizeMem
  nop 2
gbfr_SummonFinalizeReturn:

[DISABLE]
gbfr_SummonRequest+14:
  dd 0
gbfr_SummonOverride:
  dd 0

gbfr_SummonRenderHook:
  db 41 8B 46 08 C5 F8 57 C0
gbfr_SummonFinalizeHook:
  db 44 8B A5 DC 02 00 00

unregistersymbol(gbfr_SummonRequest)
]]></AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>42032</ID>
              <Description>"Spawn Summon Stone"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
-- CE_STANDALONE_SUMMON_CATALOG_SELECTOR
if syntaxcheck then return end

local function finish(message)
  if message ~= nil then
    showMessage(message)
  end
  local timer = createTimer(nil, false)
  timer.Interval = 50
  timer.OnTimer = function()
    timer.destroy()
    memrec.Active = false
  end
  timer.Enabled = true
end

local tableFile = findTableFile("gbfr_summon_catalog.dat")
if tableFile == nil then
  finish("The embedded Summon Stone catalog could not be loaded.")
  return
end

local stream = tableFile.getData()
stream.Position = 0
local catalogText = stream.readString(stream.Size)
stream.destroy()

local summons = {}
local traitsByPool = {}
local bonusesByPool = {}
for line in catalogText:gmatch("[^\r\n]+") do
  local summonId, mode, rarity, element, traitPool, bonusPool, name =
    line:match("^S\t([0-9A-F]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)\t([0-9A-F]+)\t([0-9A-F]+)\t(.+)$")
  if summonId ~= nil then
    table.insert(summons, {
      id = summonId,
      mode = mode,
      traitPool = traitPool,
      bonusPool = bonusPool,
      text = string.format("%s | %s | %s | %s | ID %s", name, element, rarity, mode, summonId)
    })
  end

  local traitLot, traitId, levelsText, traitName =
    line:match("^T\t([0-9A-F]+)\t([0-9A-F]+)\t([0-9,]+)\t(.+)$")
  if traitLot ~= nil then
    local item = {
      id = traitId,
      text = string.format("%s | ID %s", traitName, traitId),
      levels = {}
    }
    for levelText in levelsText:gmatch("%d+") do
      table.insert(item.levels, tonumber(levelText))
    end
    traitsByPool[traitLot] = traitsByPool[traitLot] or {}
    table.insert(traitsByPool[traitLot], item)
  end

  local bonusLot, bonusId, choicesText, bonusName =
    line:match("^B\t([0-9A-F]+)\t([0-9A-F]+)\t([^\t]+)\t(.+)$")
  if bonusLot ~= nil then
    local item = {
      id = bonusId,
      text = string.format("%s | ID %s", bonusName, bonusId),
      levels = {}
    }
    for indexText, displayText in choicesText:gmatch("(%d+)=([^;]+)") do
      table.insert(item.levels, {index = tonumber(indexText), display = displayText})
    end
    bonusesByPool[bonusLot] = bonusesByPool[bonusLot] or {}
    table.insert(bonusesByPool[bonusLot], item)
  end
end

local function choose(title, prompt, rows)
  local list = createStringList()
  local byText = {}
  for _, item in ipairs(rows) do
    list.add(item.text)
    byText[item.text] = item
  end
  local _, selectedText = showSelectionList(title, prompt, list, false)
  list.destroy()
  return byText[selectedText]
end

local summon = choose("Spawn Summon Stone", "Choose a Summon Stone:", summons)
if summon == nil then
  finish()
  return
end

local request = getAddressSafe("gbfr_SummonRequest")
if request == nil or request == 0 then
  finish("Enable Summon Stone Spawner before using Spawn Summon Stone.")
  return
end
if readInteger(request + 0x14) ~= 0 then
  finish("A Summon Stone request is already pending.")
  return
end

local function dword(hex)
  local value = tonumber(hex, 16)
  if value >= 2147483648 then
    return value - 4294967296
  end
  return value
end

local function queue(traitId, traitLevel, bonusId, bonusLevel, message)
  writeInteger(request, dword(summon.id))
  writeInteger(request + 0x04, dword(traitId))
  writeInteger(request + 0x08, traitLevel)
  writeInteger(request + 0x0C, dword(bonusId))
  writeInteger(request + 0x10, bonusLevel)
  writeInteger(request + 0x14, 1)
  finish(message)
end

if summon.mode == "Guaranteed" then
  queue("00000000", 0, "00000000", 0, nil)
  return
end

local traitChoices = {{id = "00000000", native = true, text = "Game-native random Main Trait"}}
for _, item in ipairs(traitsByPool[summon.traitPool]) do
  table.insert(traitChoices, item)
end
local trait = choose("Spawn Summon Stone", "Choose a Main Trait:", traitChoices)
if trait == nil then
  finish()
  return
end
local traitLevel = 0
if not trait.native then
  traitLevel = trait.levels[1]
end
if not trait.native and #trait.levels > 1 then
  local levelRows = {}
  for _, level in ipairs(trait.levels) do
    table.insert(levelRows, {value = level, text = "T.Lvl " .. tostring(level)})
  end
  local selectedLevel = choose("Spawn Summon Stone", "Choose the Main Trait level:", levelRows)
  if selectedLevel == nil then
    finish()
    return
  end
  traitLevel = selectedLevel.value
end

local bonusChoices = {{id = "00000000", native = true, text = "Game-native random Equip Bonus"}}
for _, item in ipairs(bonusesByPool[summon.bonusPool]) do
  table.insert(bonusChoices, item)
end
local bonus = choose("Spawn Summon Stone", "Choose an Equip Bonus:", bonusChoices)
if bonus == nil then
  finish()
  return
end
local bonusLevel = {index = 0}
if not bonus.native then
  bonusLevel = bonus.levels[1]
end
if not bonus.native and #bonus.levels > 1 then
  local levelRows = {}
  for _, level in ipairs(bonus.levels) do
    table.insert(levelRows, {
      value = level,
      text = string.format("%s | stored index %d", level.display, level.index)
    })
  end
  local selectedLevel = choose("Spawn Summon Stone", "Choose the Equip Bonus value:", levelRows)
  if selectedLevel == nil then
    finish()
    return
  end
  bonusLevel = selectedLevel.value
end

local message = "Native request queued. Change the selected Summon Stone once."
if not trait.native or not bonus.native then
  message = "Exact legal request queued. Change the selected Summon Stone once."
end
queue(trait.id, traitLevel, bonus.id, bonusLevel.index, message)
{$asm}

[DISABLE]
]]></AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>42033</ID>
          <Description>"Wrightstone Spawner"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript><![CDATA[[ENABLE]
aobscanmodule(gbfr_WrightstoneRenderMatch,granblue_fantasy_relink.exe,89 D3 48 8B 3D ?? ?? ?? ?? 48 8D 8F 90 F9 01 00)
define(gbfr_WrightstoneRenderHook,gbfr_WrightstoneRenderMatch+09)
aobscanmodule(gbfr_WrightstoneAddMatch,granblue_fantasy_relink.exe,45 89 C6 89 D6 48 89 CF 4C 8D B9 90 F9 01 00)
define(gbfr_WrightstoneAdd,gbfr_WrightstoneAddMatch-23)
aobscanmodule(gbfr_WrightstoneTraitCopyMatch,granblue_fantasy_relink.exe,48 89 CE 48 39 D1 74 72)
define(gbfr_WrightstoneTraitCopy,gbfr_WrightstoneTraitCopyMatch-14)
assert(gbfr_WrightstoneRenderHook,48 8D 8F 90 F9 01 00)
assert(gbfr_WrightstoneAdd,55 41 57 41 56 41 55 41 54 56 57 53 48 81 EC 98 00 00 00)
assert(gbfr_WrightstoneTraitCopy,55 56 57 48 83 EC 30 48 8D 6C 24 30 48 C7 45 F8 FE FF FF FF)

alloc(gbfr_WrightstoneMem,$1000,gbfr_WrightstoneRenderHook)
registersymbol(gbfr_WrightstoneRequest)

label(code)
label(return)
label(find_row)
label(apply)
label(done)
label(gbfr_WrightstoneRequest)

gbfr_WrightstoneMem:
  cmp dword ptr [gbfr_WrightstoneRequest+1C],1
  jne code
  mov dword ptr [gbfr_WrightstoneRequest+1C],0

  sub rsp,20
  mov rcx,rdi
  mov edx,[gbfr_WrightstoneRequest]
  xor r8d,r8d
  call gbfr_WrightstoneAdd
  test eax,eax
  je done

  lea r9,[rdi+0001F9A0]
  mov r10d,1388
find_row:
  cmp [r9+1C],eax
  je apply
  add r9,30
  dec r10d
  jne find_row
  jmp done

apply:
  mov rcx,r9
  mov rdx,gbfr_WrightstoneRequest+04
  call gbfr_WrightstoneTraitCopy

done:
  add rsp,20

code:
  lea rcx,[rdi+0001F990]
  jmp return

align 4 CC
gbfr_WrightstoneRequest:
  dd 0,0,0,0,0,0,0,0

gbfr_WrightstoneRenderHook:
  jmp gbfr_WrightstoneMem
  nop 2
return:

[DISABLE]
gbfr_WrightstoneRequest+1C:
  dd 0

gbfr_WrightstoneRenderHook:
  db 48 8D 8F 90 F9 01 00

unregistersymbol(gbfr_WrightstoneRequest)
]]></AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>42034</ID>
              <Description>"Spawn Wrightstone"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript><![CDATA[[ENABLE]
{$lua}
-- CE_STANDALONE_WRIGHTSTONE_CATALOG_SELECTOR
if syntaxcheck then return end

local function finish(message)
  if message ~= nil then
    showMessage(message)
  end
  local timer = createTimer(nil, false)
  timer.Interval = 50
  timer.OnTimer = function()
    timer.destroy()
    memrec.Active = false
  end
  timer.Enabled = true
end

local tableFile = findTableFile("gbfr_wrightstone_catalog.dat")
if tableFile == nil then
  finish("The embedded Wrightstone catalog could not be loaded.")
  return
end

local stream = tableFile.getData()
stream.Position = 0
local catalogText = stream.readString(stream.Size)
stream.destroy()

local traitNames = {}
local pools = {}
local levelLots = {}
local definitions = {}

local function parseLevels(text)
  local values = {}
  for value in text:gmatch("%d+") do
    table.insert(values, tonumber(value))
  end
  return values
end

for line in catalogText:gmatch("[^\r\n]+") do
  local traitId, traitName = line:match("^T	([0-9A-F]+)	(.+)$")
  if traitId ~= nil then
    traitNames[traitId] = traitName
  end

  local poolId, poolText = line:match("^P	([NE])	([0-9A-F,]+)$")
  if poolId ~= nil then
    pools[poolId] = {}
    for value in poolText:gmatch("[0-9A-F]+") do
      table.insert(pools[poolId], value)
    end
  end

  local lotId, levelsText = line:match("^L	(%d+)	([0-9,]+)$")
  if lotId ~= nil then
    levelLots[tonumber(lotId)] = parseLevels(levelsText)
  end

  local template, mainId, mainLot, pool, sub1Lot, sub2Lot, text =
    line:match("^R	([0-9A-F]+)	([0-9A-F]+)	(%d+)	([NE0])	(-?%d+)	(-?%d+)	(.+)$")
  if template ~= nil then
    table.insert(definitions, {
      template = template,
      mode = "Random",
      mainId = mainId,
      mainLot = tonumber(mainLot),
      pool = pool,
      sub1Lot = tonumber(sub1Lot),
      sub2Lot = tonumber(sub2Lot),
      text = text
    })
  end

  local fixedTemplate, fixedMainId, mainLevel,
    sub1Id, sub1Level, sub2Id, sub2Level, fixedText =
    line:match("^X	([0-9A-F]+)	([0-9A-F]+)	(%d+)	([0-9A-F]+)	(%d+)	([0-9A-F]+)	(%d+)	(.+)$")
  if fixedTemplate ~= nil then
    table.insert(definitions, {
      template = fixedTemplate,
      mode = "Fixed",
      mainId = fixedMainId,
      mainLevel = tonumber(mainLevel),
      sub1Id = sub1Id,
      sub1Level = tonumber(sub1Level),
      sub2Id = sub2Id,
      sub2Level = tonumber(sub2Level),
      text = fixedText
    })
  end
end

table.sort(definitions, function(left, right)
  return left.text:lower() < right.text:lower()
end)

local function choose(title, prompt, rows)
  local list = createStringList()
  local byText = {}
  for _, item in ipairs(rows) do
    list.add(item.text)
    byText[item.text] = item
  end
  local _, selectedText = showSelectionList(title, prompt, list, false)
  list.destroy()
  return byText[selectedText]
end

local function chooseLevel(prompt, levels)
  if #levels == 1 then return levels[1] end
  local rows = {}
  for _, level in ipairs(levels) do
    table.insert(rows, {value = level, text = "T.Lvl " .. tostring(level)})
  end
  local selected = choose("Spawn Wrightstone", prompt, rows)
  return selected == nil and nil or selected.value
end

local definition = choose(
  "Spawn Wrightstone",
  "Choose a real Wrightstone definition:",
  definitions
)
if definition == nil then
  finish()
  return
end

local request = getAddressSafe("gbfr_WrightstoneRequest")
if request == nil or request == 0 then
  finish("Enable Wrightstone Spawner before using Spawn Wrightstone.")
  return
end
if readInteger(request + 0x1C) ~= 0 then
  finish("A Wrightstone request is already pending.")
  return
end

local function dword(hex)
  local value = tonumber(hex, 16)
  if value >= 2147483648 then
    return value - 4294967296
  end
  return value
end

local function queue(mainId, primaryLevel, sub1Id, sub1Level, sub2Id, sub2Level)
  writeInteger(request, dword(definition.template))
  writeInteger(request + 0x04, dword(mainId))
  writeInteger(request + 0x08, primaryLevel)
  writeInteger(request + 0x0C, dword(sub1Id))
  writeInteger(request + 0x10, sub1Level)
  writeInteger(request + 0x14, dword(sub2Id))
  writeInteger(request + 0x18, sub2Level)
  writeInteger(request + 0x1C, 1)
  finish("Exact legal request queued. Open Inventory > Wrightstones and move the selection once.")
end

if definition.mode == "Fixed" then
  queue(
    definition.mainId,
    definition.mainLevel,
    definition.sub1Id,
    definition.sub1Level,
    definition.sub2Id,
    definition.sub2Level
  )
  return
end

local primaryLevel = chooseLevel(
  "Choose the primary Trait level:",
  levelLots[definition.mainLot]
)
if primaryLevel == nil then
  finish()
  return
end

local used = {[definition.mainId] = true}
local function chooseSecondary(slot, lotId)
  if lotId < 0 then return "887AE0B0", 0 end
  local rows = {}
  for _, traitId in ipairs(pools[definition.pool]) do
    if not used[traitId] then
      table.insert(rows, {
        id = traitId,
        text = string.format("%s | ID %s", traitNames[traitId], traitId)
      })
    end
  end
  local trait = choose(
    "Spawn Wrightstone",
    "Choose Secondary Trait " .. tostring(slot) .. ":",
    rows
  )
  if trait == nil then return nil end
  local level = chooseLevel(
    "Choose Secondary Trait " .. tostring(slot) .. " level:",
    levelLots[lotId]
  )
  if level == nil then return nil end
  used[trait.id] = true
  return trait.id, level
end

local secondary1, secondary1Level = chooseSecondary(1, definition.sub1Lot)
if secondary1 == nil then
  finish()
  return
end
local secondary2, secondary2Level = chooseSecondary(2, definition.sub2Lot)
if secondary2 == nil then
  finish()
  return
end
queue(
  definition.mainId,
  primaryLevel,
  secondary1,
  secondary1Level,
  secondary2,
  secondary2Level
)
{$asm}

[DISABLE]
]]></AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
