  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>50000</ID>
      <Description>"Auto Attach to Process"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
openProcess("granblue_fantasy_relink.exe")
{$asm}

[DISABLE]</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>50001</ID>
          <Description>"Editors"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

[DISABLE]</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>50002</ID>
              <Description>"Over Mastery Bonuses"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(gbfr_OMHook,granblue_fantasy_relink.exe,44 8B 4D E4 45 8B 06)
assert(gbfr_OMHook,44 8B 4D E4 45 8B 06)

alloc(newmem,$100,gbfr_OMHook)
registersymbol(gbfr_OMHook)
registersymbol(gbfr_OMBonus)
registersymbol(gbfr_OMRank)

label(return)
label(gbfr_OMBonus)
label(gbfr_OMRank)

newmem:
  lea rdx,[gbfr_OMBonus]
  mov r8d,[rdx+rdi*4]
  mov r9d,[rdx+rdi*4+10]
  jmp return

