                    <CheatEntry>
                      <ID>50031</ID>
                      <Description>"Save Selected Sigil"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Marks the currently captured sigil for the save file.
  Requires: "In-Place Editors" enabled, "Sigil Editor" enabled,
  and a sigil highlighted so SigilEdit_C holds a pointer.
  EXPERIMENTAL. Back up your save first. Offline / single-player only. }

[ENABLE]
{$lua}
if syntaxcheck then return end
if getAddressSafe("SigilEdit_C") == nil then
  ShowMessage("Enable 'Sigil Editor' first, then highlight a sigil.")
  memrec.Active = false
  return
end
if MarkForSaveWrapper == nil then
  ShowMessage("Enable 'In-Place Editors' first.")
  memrec.Active = false
  return
end
local captured = readQword("SigilEdit_C")
if captured == nil or captured &lt;= 0xFFFFFFF then
  ShowMessage("No sigil captured. Highlight a sigil in the Gear list, then run Save Selected Sigil again.")
  memrec.Active = false
  return
end
-- SigilEdit_C points at struct+0x18; record is 9 dwords = 0x24 bytes.
-- The copy function ends at field +20 and returns, so 0x24 is the exact
-- record size. Using 0x30 here would overrun into the next sigil.
MarkForSaveWrapper(captured - 0x18, 0x24)
memrec.Active = false
{$asm}
[DISABLE]</AssemblerScript>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>50032</ID>
                  <Description>"Weapon Editor (Imbue Weapon, Edit, Save)"</Description>
                  <Options moHideChildren="1" />
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game   : granblue_fantasy_relink.exe
  Version:
  Date   : 2026-07-08
  Author : zachw

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(WPN_Edit,granblue_fantasy_relink.exe,48 8B 45 60 44 8B 68 58 C5 FA 10 35 ?? ?? ?? ?? 45 31 FF 45 39 F5) // should be unique
alloc(newmem,$1000,WPN_Edit)
globalalloc(WPNEdit,8)
label(code)
label(return)

newmem:
  mov rax,[rbp+60]
  mov [WPNEdit],rax
code:
  mov r13d,[rax+58]
  jmp return

WPN_Edit:
  jmp newmem
  nop 3
return:
registersymbol(WPN_Edit)

[DISABLE]

WPN_Edit:
  db 48 8B 45 60 44 8B 68 58

unregistersymbol(WPN_Edit)
dealloc(newmem)
dealloc(WPNEdit)
