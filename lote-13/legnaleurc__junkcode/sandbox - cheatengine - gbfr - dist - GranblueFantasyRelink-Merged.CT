gbfrNormalizeAob = function(value)
  if value == nil then return "" end
  return string.upper(string.gsub(tostring(value), "[^0-9A-Fa-f]", ""))
end
gbfrFormatAob = function(value)
  local normalized = gbfrNormalizeAob(value)
  return string.gsub(normalized, "(%x%x)", "%1 "):gsub(" $", "")
end
gbfrInplacePreviousOnValueChange = getAddressList().OnValueChange
gbfrInplaceValueChangeHandler = function(addressList, memrec)
  local picker = gbfrInplacePickers[memrec.ID]
  if picker == nil then
    if gbfrInplacePreviousOnValueChange ~= nil then
      return gbfrInplacePreviousOnValueChange(addressList, memrec)
    end
    return false
  end

  local list = createStringList()
  local displayedValues = picker.values
  if picker.summonField ~= "" and picker.summonField ~= "Summon Stone ID" then
    displayedValues = {}
    local definitionRecord = addressList.getMemoryRecordByID(gbfrSummonDefinitionRecordId)
    local definition = gbfrNormalizeAob(definitionRecord and definitionRecord.Value)
    local traitRecord = addressList.getMemoryRecordByID(gbfrSummonTraitRecordId)
    local bonusRecord = addressList.getMemoryRecordByID(gbfrSummonBonusRecordId)
    local trait = gbfrNormalizeAob(traitRecord and traitRecord.Value)
    local bonus = gbfrNormalizeAob(bonusRecord and bonusRecord.Value)
    local values = picker.summonField == "Trait ID" and (gbfrSummonValidTraits[definition] or {})
        or picker.summonField == "Equip Bonus ID" and (gbfrSummonValidBonuses[definition] or {})
        or picker.summonField == "Trait Level" and ((gbfrSummonValidTraits[definition] or {})[trait] or {})
        or ((gbfrSummonValidBonuses[definition] or {})[bonus] or {})
    if picker.summonField == "Trait ID" or picker.summonField == "Equip Bonus ID" then
      for _, choice in ipairs(picker.choices) do
        local rawValue = picker.values[choice]
        if values[gbfrNormalizeAob(rawValue)] ~= nil then
          list.add(choice)
          displayedValues[choice] = rawValue
        end
      end
    else
      for index, level in ipairs(values) do
        local display = "T.Lvl " .. tostring(level)
        if picker.summonField == "Equip Bonus Level" then
          local labels = (gbfrSummonBonusDisplays[definition] or {})[bonus] or {}
          display = (labels[index] or tostring(level)) .. " | stored index " .. tostring(level)
        end
        list.add(display)
        displayedValues[display] = tostring(level)
      end
    end
    if list.Count == 0 then
      list.destroy()
      showMessage("The selected Summon Stone has no legal values for this field in the game-data catalog.")
      return true
    end
  elseif picker.dynamicSigilTrait1 then
    displayedValues = {}
    local definitionRecord = addressList.getMemoryRecordByID(gbfrSigilDefinitionRecordId)
    local definition = gbfrNormalizeAob(definitionRecord and definitionRecord.Value)
    local expectedPrimary = gbfrNormalizeAob(gbfrSigilPrimaryByDefinition[definition])
    for _, choice in ipairs(picker.choices) do
      local rawValue = picker.values[choice]
      if gbfrNormalizeAob(rawValue) == expectedPrimary then
        local display = "[固定主因子] " .. choice
        list.add(display)
        displayedValues[display] = rawValue
        break
      end
    end
    if list.Count == 0 then
      list.destroy()
      showMessage("The selected Sigil ID has no known primary trait.")
      return true
    end
  elseif picker.dynamicSigilTrait2 then
    displayedValues = {}
    local definitionRecord = addressList.getMemoryRecordByID(gbfrSigilDefinitionRecordId)
    local primaryRecord = addressList.getMemoryRecordByID(gbfrSigilPrimaryRecordId)
    local definition = gbfrNormalizeAob(definitionRecord and definitionRecord.Value)
    local primary = gbfrNormalizeAob(primaryRecord and primaryRecord.Value)
    local expectedPrimary = gbfrNormalizeAob(gbfrSigilPrimaryByDefinition[definition])
    local natural = gbfrSigilNaturalSecondary[definition] or {}
    local groups = {{}, {}, {}}
    for _, choice in ipairs(picker.choices) do
      local rawValue = picker.values[choice]
      local group = 3
      local marker = "[非自然] "
      if primary == expectedPrimary and natural[rawValue] then
        group = 1
        marker = "[自然] "
      elseif gbfrSigilDefinitionSynthesisAllowed[definition] == true
          and picker.synthesisAllowed[choice] == true
          and gbfrSigilSynthesisAllowed[primary] == true then
        group = 2
        marker = "[可因子合成] "
      end
      local display = marker .. choice
      table.insert(groups[group], display)
      displayedValues[display] = rawValue
    end
    for _, group in ipairs(groups) do
      for _, choice in ipairs(group) do list.add(choice) end
    end
  else
    for _, choice in ipairs(picker.choices) do list.add(choice) end
  end
  local _, selected = showSelectionList(
    picker.title,
    "Type to search, then choose a value:",
    list,
    false
  )
  list.destroy()
  if selected ~= nil and displayedValues[selected] ~= nil then
    memrec.Value = displayedValues[selected]
    if memrec.ID == gbfrSigilDefinitionRecordId then
      local definition = gbfrNormalizeAob(displayedValues[selected])
      local expectedPrimary = gbfrNormalizeAob(gbfrSigilPrimaryByDefinition[definition])
      local primaryRecord = addressList.getMemoryRecordByID(gbfrSigilPrimaryRecordId)
      local primaryPicker = gbfrInplacePickers[gbfrSigilPrimaryRecordId]
      if primaryRecord ~= nil and primaryPicker ~= nil then
        for _, choice in ipairs(primaryPicker.choices) do
          local rawValue = primaryPicker.values[choice]
          if gbfrNormalizeAob(rawValue) == expectedPrimary then
            primaryRecord.Value = rawValue
            break
          end
        end
      end
    elseif memrec.ID == gbfrSummonDefinitionRecordId then
      local definition = gbfrNormalizeAob(displayedValues[selected])
      local traits = gbfrSummonValidTraits[definition] or {}
      local bonuses = gbfrSummonValidBonuses[definition] or {}
      local traitId, traitLevels = next(traits)
      local bonusId, bonusLevels = next(bonuses)
      if traitId ~= nil and bonusId ~= nil then
        addressList.getMemoryRecordByID(gbfrSummonTraitRecordId).Value = gbfrFormatAob(traitId)
        addressList.getMemoryRecordByID(gbfrSummonTraitLevelRecordId).Value = tostring(traitLevels[1])
        addressList.getMemoryRecordByID(gbfrSummonBonusRecordId).Value = gbfrFormatAob(bonusId)
        addressList.getMemoryRecordByID(gbfrSummonBonusLevelRecordId).Value = tostring(bonusLevels[1])
      end
    elseif memrec.ID == gbfrSummonTraitRecordId then
      local definitionRecord = addressList.getMemoryRecordByID(gbfrSummonDefinitionRecordId)
      local levels = (gbfrSummonValidTraits[gbfrNormalizeAob(definitionRecord.Value)] or {})[gbfrNormalizeAob(displayedValues[selected])]
      if levels then addressList.getMemoryRecordByID(gbfrSummonTraitLevelRecordId).Value = tostring(levels[1]) end
    elseif memrec.ID == gbfrSummonBonusRecordId then
      local definitionRecord = addressList.getMemoryRecordByID(gbfrSummonDefinitionRecordId)
      local levels = (gbfrSummonValidBonuses[gbfrNormalizeAob(definitionRecord.Value)] or {})[gbfrNormalizeAob(displayedValues[selected])]
      if levels then addressList.getMemoryRecordByID(gbfrSummonBonusLevelRecordId).Value = tostring(levels[1]) end
    end
  end
  return true
end
getAddressList().OnValueChange = gbfrInplaceValueChangeHandler

function MarkForSave(baseAddress,size)
  local GBFR_MarkForSave = GetAddressSafe("GBFR_MarkForSave")
  if GBFR_MarkForSave == nil then
    return nil
  end
  if baseAddress == nil or baseAddress &lt;= 0xFFFFFFF then
    return nil
  end
  local numberOfAddressesToSave = math.floor(size / 4)
  if size == 0 or size % 4 ~= 0 then
    numberOfAddressesToSave = numberOfAddressesToSave + 1
  end
  local resultTable = { success = 0, total = numberOfAddressesToSave }
  for i = 0, numberOfAddressesToSave-1 do
    local address = baseAddress + i * 4
    local result = ExecuteCode(GBFR_MarkForSave, address)
    if result ~= 0 then
      resultTable.success = resultTable.success + 1
    end
  end
  return resultTable
end

function MarkForSaveWrapper(baseAddress, size)
  local saveResult = MarkForSave(baseAddress, size)
  ShowMessage(saveResult and ("Marked for save (" .. saveResult.success .. "/" .. saveResult.total .. ")") or "Mark for save FAILED (function not found on this build)")
end
{$asm}
[DISABLE]
{$lua}
if not syntaxcheck then

local addressList = getAddressList()
if addressList.OnValueChange == gbfrInplaceValueChangeHandler then
  addressList.OnValueChange = gbfrInplacePreviousOnValueChange
end
gbfrInplaceValueChangeHandler = nil
gbfrInplacePreviousOnValueChange = nil
gbfrInplacePickers = nil
gbfrSigilPrimaryByDefinition = nil
gbfrSigilNaturalSecondary = nil
gbfrSigilDefinitionSynthesisAllowed = nil
gbfrSigilSynthesisAllowed = nil
gbfrSummonValidTraits = nil
gbfrSummonValidBonuses = nil
gbfrSummonBonusDisplays = nil
gbfrFormatAob = nil
gbfrNormalizeAob = nil
  MarkForSave = nil
  MarkForSaveWrapper = nil
end
{$asm}
unregistersymbol(GBFR_MarkForSave)</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>50017</ID>
                  <Description>"Summon Stone Editor"</Description>
                  <Options moHideChildren="1" />
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Summon Stone Editor  Enable this one script, then hover a summon stone in your inventory
  Record: -8 summon stone id, +0 trait id, +4 bonus id, +8 trait level, +C bonus level,
  Save spans -8..+18 (0x24 bytes). }

[ENABLE]
globalalloc(SummonBase,8)

aobscanmodule(Summon_Hook,granblue_fantasy_relink.exe,48 85 C9 74 32 41 8B 46 08 C5 F8 57 C0)
alloc(newmem,$1000,Summon_Hook)
label(code)
label(return)
newmem:
  push rax
  lea rax,[r14+08]
  mov [SummonBase],rax
  pop rax
code:
  db 41 8B 46 08
  db C5 F8 57 C0
  jmp return
Summon_Hook+05:
  jmp newmem
  nop 3
return:
registersymbol(Summon_Hook)

{$lua}
if syntaxcheck then return end
-- Equip Bonus Level Dropdown
local T = {
  ["32 8E 4E 66"] = {"4%","6%","8%","10%","12%","14%","16%","18%","20%"},                 -- Skill Damage Up
  ["E0 71 D1 00"] = {"4%","6%","8%","10%","12%","14%","16%","18%","20%"},                 -- Critical hit rate
  ["21 8D 13 75"] = {"4%","6%","8%","10%","12%","14%","16%","18%","20%"},                 -- SBA Dmg Up
  ["9F 50 FB 2F"] = {"10%","15%","20%","25%","30%","35%","40%","45%","50%"},              -- Skill Damage Cap Up
  ["C9 41 62 A6"] = {"10%","15%","20%","25%","30%","35%","40%","45%","50%"},              -- Normal Attack Cap Up
  ["1B D8 39 5A"] = {"10%","15%","20%","25%","30%","35%","40%","45%","50%"},              -- Chain Burst Damage Up
  ["40 BC 70 22"] = {"10%","15%","20%","25%","30%","35%","40%","45%","50%"},              -- Healing Cap Up
  ["BB 9F 53 A3"] = {"10%","15%","20%","25%","30%","35%","40%","45%","50%"},              -- SBA Dmg Cap Up
  ["6F 31 B0 F7"] = {"3","4","5","6","7","9","11","13","15"},                            -- Stun Power Up
  ["80 0C 90 A8"] = {"400","600","800","1000","1200","1400","1600","1800","2000"},        -- Attack Power Up
  ["CB 92 4E BC"] = {"400","600","800","1000","1200","1400","1600","1800","2000"},        -- Health Up
  ["A4 DF 45 92"] = {"25%","30%","35%","40%","45%","50%","60%","80%","100%"},             -- [Inf] Normal Cap Up
  ["8A C5 70 CE"] = {"25%","30%","35%","40%","45%","50%","60%","80%","100%"},             -- [Inf] Skill Cap Up
  ["89 2C 1D 5A"] = {"25%","30%","35%","40%","45%","50%","60%","80%","100%"},             -- [Inf] SBA Cap Up
  ["37 9A B0 54"] = {"25%","30%","35%","40%","45%","50%","60%","80%","100%"},             -- [Inf] Chain Burst Dmg
  ["C1 7B F7 F0"] = {"6","7","9","11","13","15","16","18","20"},                         -- [Inf] Stun Power Up
  ["0C D5 C0 33"] = {"10%","12%","14%","16%","18%","20%","22%","25%","30%"},              -- [Inf] SBA Dmg Up
  ["FB A3 39 AF"] = {"10%","12%","14%","16%","18%","20%","22%","25%","30%"},              -- [Inf] Skill Dmg Up
  ["67 A9 74 A0"] = {"10%","12%","14%","16%","18%","20%","22%","25%","30%"},              -- [Inf] Crit Rate
  ["B1 37 E5 A3"] = {"1000","1200","1400","1600","1800","2000","2200","2500","3000"},     -- [Inf] Attack Up
  ["44 6E 25 F2"] = {"1000","1200","1400","1600","1800","2000","2500","3000","5000"},     -- [Inf] Health Up
  ["80 CA A9 2E"] = {"25%","30%","35%","40%","45%","50%","55%","60%","75%"},              -- [Inf] Healing Cap Up
}
local ROW = "Equip Bonus Level"
local function stoneBase()
  if getAddressSafe("SummonBase") == nil then return nil end
  local base = readQword("SummonBase")
  if base == nil or base &lt;= 0xFFFFFFF then return nil end
  return base
end
local function currentKey()
  local base = stoneBase(); if base == nil then return nil end
  local b = readBytes(base + 0x4, 4, true); if b == nil then return nil end
  return string.format("%02X %02X %02X %02X", b[1], b[2], b[3], b[4])
end
local function getRow() return getAddressList().getMemoryRecordByDescription(ROW) end
local lastKey = false
local function refreshList()
  local rec = getRow(); if rec == nil then return end
  local key = currentKey()
  if key == lastKey then return end
  lastKey = key
  local list = key and T[key]
  if list then
    local lines = {}
    for i = 1, #list do lines[i] = i .. ":" .. list[i] end
    rec.DropDownList.Text = table.concat(lines, "\n")
  else
    rec.DropDownList.Text = ""
  end
end
local rec0 = getRow()
if rec0 then
  rec0.DropDownDescriptionOnly = true
  rec0.DisplayAsDropDownListItem = false
  rec0.OnGetDisplayValue = function(memrec, value)
    local key = currentKey()
    local list = key and T[key]
    local lvl = tonumber(value)
    if list and lvl and lvl &gt;= 1 and lvl &lt;= #list then return true, list[lvl] end
    return false
  end
end
if SummonBonusTimer then SummonBonusTimer.destroy(); SummonBonusTimer = nil end
SummonBonusTimer = createTimer(getMainForm())
SummonBonusTimer.Interval = 200
SummonBonusTimer.OnTimer = refreshList
refreshList()
{$asm}

[DISABLE]
{$lua}
if SummonBonusTimer then SummonBonusTimer.destroy(); SummonBonusTimer = nil end
local rec = getAddressList().getMemoryRecordByDescription("Equip Bonus Level")
if rec then rec.OnGetDisplayValue = nil; rec.DropDownList.Text = "" end
{$asm}
Summon_Hook+05:
  db 41 8B 46 08 C5 F8 57 C0
unregistersymbol(Summon_Hook)
dealloc(newmem)
dealloc(SummonBase)</AssemblerScript>
