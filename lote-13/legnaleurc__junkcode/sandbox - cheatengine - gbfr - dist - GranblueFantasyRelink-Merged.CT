                    <CheatEntry>
                      <ID>50023</ID>
                      <Description>"Save Selected Summon"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Marks the highlighted summon stone's whole record for the next in-game save.}

[ENABLE]
{$lua}
if syntaxcheck then return end
if getAddressSafe("SummonBase")==nil or MarkForSaveWrapper==nil then
  ShowMessage("Enable In-Place Editors and the Summon Stone Editor first."); memrec.Active = false; return
end
local base=readQword("SummonBase")
if base==nil or base &lt;= 0xFFFFFFF then ShowMessage("No stone captured. Highlight one, then try again."); memrec.Active = false; return end
local function normalized(offset)
  local bytes = readBytes(base + offset, 4, true)
  if bytes == nil then return "" end
  return string.format("%02X%02X%02X%02X", bytes[1], bytes[2], bytes[3], bytes[4])
end
local definition = normalized(-8)
local trait = normalized(0)
local bonus = normalized(4)
local traitLevel = readBytes(base + 8, 1, false)
local bonusLevel = readBytes(base + 0xC, 1, false)
local validTraits = gbfrSummonValidTraits and gbfrSummonValidTraits[definition]
local validBonuses = gbfrSummonValidBonuses and gbfrSummonValidBonuses[definition]
local function contains(values, wanted)
  if values == nil then return false end
  for _, value in ipairs(values) do if value == wanted then return true end end
  return false
end
if validTraits == nil or validBonuses == nil
   or not contains(validTraits[trait], traitLevel)
   or not contains(validBonuses[bonus], bonusLevel) then
  ShowMessage("Refusing to save: this Summon Stone ID, trait, trait level, or equip bonus combination is not present in the game-data catalog.")
  memrec.Active = false
  return
end
MarkForSaveWrapper(base - 8, 0x24)
memrec.Active = false
{$asm}
[DISABLE]</AssemblerScript>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>50024</ID>
                  <Description>"Sigil Editor"</Description>
                  <Options moHideChildren="1" />
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game    : granblue_fantasy_relink.exe

  RECORD LAYOUT (base = SigilEdit_C - 0x18), stride 0x24
    +00 Trait 1 ID    +04 Trait 1 Level
    +08 Trait 2 ID    +0C Trait 2 Level
    +10 Sigil ID      +14 possible Trait 3 ID (holds the "None" ID when empty)
    +18 Sigil Level   +1C unmapped        +20 unmapped

  IF THIS STOPS ENABLING, it means the pattern moved or went ambiguous after a game update.
}

[ENABLE]

aobscanmodule(Sigil_Edit_C,granblue_fantasy_relink.exe,8B 47 18 39 46 18 74 0B 48 8D 4E 18 89 01 E8 ?? ?? ?? ?? 8B 47 1C 39 46 1C 74 0B 48 8D 4E 1C 89 01 E8 ?? ?? ?? ?? 8B 47 20 39 46 20 74 0B 48 8D 4E 20 89 01 E8 ?? ?? ?? ?? 48 89 F0 48 83 C4 30)
assert(Sigil_Edit_C,8B 47 18 39 46 18)
alloc(newmem,$1000,Sigil_Edit_C)
globalalloc(SigilEdit_C,8)
globalalloc(SigilHit_C,4)
label(return)

newmem:
  push rax
  push rbx
  lea rax,[rdi+18]
  mov [SigilEdit_C],rax
  mov rbx,SigilHit_C
  inc dword ptr [rbx]
  pop rbx
  pop rax
  mov eax,[rdi+18]
  cmp [rsi+18],eax
  jmp return

Sigil_Edit_C:
  jmp newmem
  nop
return:
registersymbol(Sigil_Edit_C)

[DISABLE]

Sigil_Edit_C:
  db 8B 47 18 39 46 18

unregistersymbol(Sigil_Edit_C)
dealloc(newmem)
dealloc(SigilEdit_C)
dealloc(SigilHit_C)</AssemblerScript>
