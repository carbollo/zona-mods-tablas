{$lua}
if syntaxcheck then return end

local function ValidateNativeWrightstone(base)
  local tableFile = findTableFile("gbfr_wrightstone_catalog.dat")
  if tableFile == nil then return false, "The embedded Wrightstone catalog could not be loaded." end
  local stream = tableFile.getData()
  stream.Position = 0
  local catalogText = stream.readString(stream.Size)
  stream.destroy()

  local pools, lots, definitions = {}, {}, {}
  for line in catalogText:gmatch("[^\r\n]+") do
    local poolId, values = line:match("^P\t([NE])\t([0-9A-F,]+)$")
    if poolId ~= nil then
      pools[poolId] = {}
      for value in values:gmatch("[0-9A-F]+") do pools[poolId][value] = true end
    end
    local lotId, levels = line:match("^L\t(%d+)\t([0-9,]+)$")
    if lotId ~= nil then
      lots[tonumber(lotId)] = {}
      for value in levels:gmatch("%d+") do lots[tonumber(lotId)][tonumber(value)] = true end
    end
    local template, main, mainLot, pool, sub1Lot, sub2Lot =
      line:match("^R\t([0-9A-F]+)\t([0-9A-F]+)\t(%d+)\t([NE0])\t(-?%d+)\t(-?%d+)\t")
    if template ~= nil then
      table.insert(definitions, {mode="R", main=main, mainLot=tonumber(mainLot), pool=pool,
        sub1Lot=tonumber(sub1Lot), sub2Lot=tonumber(sub2Lot)})
    end
    local fixedTemplate, fixedMain, mainLevel, sub1, sub1Level, sub2, sub2Level =
      line:match("^X\t([0-9A-F]+)\t([0-9A-F]+)\t(%d+)\t([0-9A-F]+)\t(%d+)\t([0-9A-F]+)\t(%d+)\t")
    if fixedTemplate ~= nil then
      table.insert(definitions, {mode="X", main=fixedMain, mainLevel=tonumber(mainLevel),
        sub1=sub1, sub1Level=tonumber(sub1Level), sub2=sub2, sub2Level=tonumber(sub2Level)})
    end
  end

  local function hashAt(offset)
    local value = readInteger(base + offset)
    if value == nil then return nil end
    return string.format("%08X", value % 0x100000000)
  end
  local main, mainLevel = hashAt(0), readInteger(base + 4)
  local sub1, sub1Level = hashAt(8), readInteger(base + 12)
  local sub2, sub2Level = hashAt(16), readInteger(base + 20)
  if main == nil or mainLevel == nil or sub1 == nil or sub1Level == nil
     or sub2 == nil or sub2Level == nil then
    return false, "The trait record could not be read."
  end
  local none = "887AE0B0"
  local function slotMatches(trait, level, lotId, pool, used)
    if lotId &lt; 0 then return trait == none and level == 0 end
    return trait ~= none and pools[pool][trait] == true and lots[lotId][level] == true
       and used[trait] ~= true
  end
  for _, definition in ipairs(definitions) do
    if definition.mode == "X" then
      if main == definition.main and mainLevel == definition.mainLevel
         and sub1 == definition.sub1 and sub1Level == definition.sub1Level
         and sub2 == definition.sub2 and sub2Level == definition.sub2Level then return true end
    elseif main == definition.main and lots[definition.mainLot][mainLevel] == true then
      local used = {[main] = true}
      if slotMatches(sub1, sub1Level, definition.sub1Lot, definition.pool, used) then
        if definition.sub1Lot &gt;= 0 then used[sub1] = true end
        if slotMatches(sub2, sub2Level, definition.sub2Lot, definition.pool, used) then return true end
      end
    end
  end
  return false, "The trait combination, slot count, or levels do not match any native Wrightstone definition."
end

local slot = getAddressSafe("gbfr_WrightstoneBase")
local base = slot and readQword(slot)
if MarkForSaveWrapper == nil then
  ShowMessage("Enable In-Place Editors first.")
elseif base == nil or base &lt;= 0xFFFFFFF then
  ShowMessage("Enable the Wrightstone Editor and select a Wrightstone first.")
else
  local valid, reason = ValidateNativeWrightstone(base)
  if valid then MarkForSaveWrapper(base, 0x18) else ShowMessage(reason) end
end
memrec.Active = false
