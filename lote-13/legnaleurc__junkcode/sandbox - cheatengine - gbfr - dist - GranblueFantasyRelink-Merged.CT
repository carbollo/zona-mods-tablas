label(status_loop)
label(status_next)
label(status_clear)
label(status_active)
label(status_done)
label(success)
label(blocked)
label(code)
label(return)
label(request_owner)

newmem:
  cmp dword ptr [r14+210],1
  jne code
  cmp dword ptr [r14+40],48
  je blocked
  cmp qword ptr [r14+160],0
  je blocked
  cmp dword ptr [r14+40],2F
  je code
  test byte ptr [r14+1C726],02
  jne blocked

  push r8
  push r9
  push r10
  mov r8,[r14+AF8]
  mov r9,[r14+B00]
  cmp r8,r9
  je status_clear
  ja status_active
  mov r10,r9
  sub r10,r8
  cmp r10,400
  ja status_active
  test r10,07
  jne status_active
status_loop:
  mov r10,[r8]
  test r10,r10
  je status_next
  cmp dword ptr [r10+50],06
  je status_active
status_next:
  add r8,08
  cmp r8,r9
  jb status_loop
status_clear:
  clc
  jmp status_done
status_active:
  stc
status_done:
  pop r10
  pop r9
  pop r8
  jc blocked

  test al,al
  jne success
  cmp dword ptr [r14+40],04
  je code
  cmp qword ptr [request_owner],r14
  je blocked
  mov [request_owner],r14
  mov rcx,r15
  xor edx,edx
  call gbfr_RequestDodge
  mov qword ptr [request_owner],0
success:
  mov al,1
  test al,al
  jmp return
blocked:
  xor eax,eax
code:
  test al,al
  reassemble(gbfr_DodgeAOB+02)
  jmp return

align 8 CC
request_owner:
  dq 0

gbfr_DodgeAOB:
  jmp newmem
  nop 3
return:

