aobscanmodule(gbfr_SelectedSigilRenderAOB,granblue_fantasy_relink.exe,48 8B 51 18 48 85 D2 74 ?? 48 8D 4C 24 24)
define(gbfr_SelectedSigilRenderSite,gbfr_SelectedSigilRenderAOB)
define(gbfr_SelectedSigilRenderContinue,gbfr_SelectedSigilRenderSite+09)
define(gbfr_SelectedSigilRenderNull,gbfr_SelectedSigilRenderSite+13)
assert(gbfr_SelectedSigilRenderSite,48 8B 51 18 48 85 D2)
assert(gbfr_SelectedSigilRenderSite+07,74 0A)

aobscanmodule(gbfr_SetSigilTraitMatch,granblue_fantasy_relink.exe,45 89 CF 44 89 C7 89 D3)
define(gbfr_SetSigilTrait,gbfr_SetSigilTraitMatch-19)
assert(gbfr_SetSigilTrait,55 41 57 41 56 56 57 53 48 83 EC 28 48 8D 6C 24 20 48 C7 45 00 FE FF FF FF 45 89 CF 44 89 C7 89 D3 49 89 CE 48 81 C1 C8 25 00 00)

aobscanmodule(gbfr_SigilCreateMatch,granblue_fantasy_relink.exe,45 89 C5 89 D3 8B 51 30)
define(gbfr_SigilCreate,gbfr_SigilCreateMatch-23)
assert(gbfr_SigilCreate,55 41 57 41 56 41 55 41 54 56 57 53 48 81 EC B8 00 00 00 48 8D AC 24 80 00 00 00 48 C7 45 30 FE FF FF FF 45 89 C5 89 D3 8B 51 30 21 DA)

alloc(gbfr_SigilMem,$1000,gbfr_SelectedSigilRenderSite)
registersymbol(gbfr_SigilRequest)
registersymbol(gbfr_SigilCreateStatus)

label(check_owned)
label(owned_loop)
label(owned_next)
label(create)
label(success)
label(rejected)
label(duplicate)
label(trait_failed)
label(find_created)
label(find_created_next)
label(done)
label(gbfr_SigilRequest)
label(gbfr_SigilCreateStatus)
label(gbfr_SigilCreatedHandle)
label(gbfr_UniqueSigils)

gbfr_SigilMem:
  mov rdx,[rcx+18]
  test rdx,rdx
  je gbfr_SelectedSigilRenderNull
  cmp dword ptr [gbfr_SigilRequest+0C],1
  jne gbfr_SelectedSigilRenderContinue
  mov dword ptr [gbfr_SigilRequest+0C],0

  push rdx
  sub rsp,28
  mov r11d,[gbfr_SigilRequest]
  mov r10,gbfr_UniqueSigils
@@:
  mov ecx,[r10]
  test ecx,ecx
  je create
  cmp ecx,r11d
  je check_owned
  add r10,04
  jmp @b

check_owned:
  lea r10,[rdi+000025D0]
  mov ecx,000013EC
owned_loop:
  cmp dword ptr [r10+1C],0
  je owned_next
  cmp [r10+10],r11d
  je duplicate
owned_next:
  add r10,24
  dec ecx
  jne owned_loop

create:
  mov eax,[gbfr_SigilRequest+04]
  mov [rsp+20],eax
  mov rcx,rdi
  mov edx,r11d
  xor r8d,r8d
  xor r9d,r9d
  call gbfr_SigilCreate
  test eax,eax
  je rejected
  mov [gbfr_SigilCreatedHandle],eax

  mov r9d,[gbfr_SigilRequest+08]
  test r9d,r9d
  je success
  cmp r9d,887AE0B0
  je success
  mov rcx,rdi
  mov edx,eax
  mov r8d,1
  call gbfr_SetSigilTrait

  lea r10,[rdi+000025D0]
  mov ecx,000013EC
find_created:
  mov eax,[gbfr_SigilCreatedHandle]
  cmp [r10+1C],eax
  jne find_created_next
  mov eax,[gbfr_SigilRequest]
  cmp [r10+10],eax
  jne find_created_next
  mov eax,[gbfr_SigilRequest+08]
  cmp [r10+08],eax
  je success
  jmp trait_failed
find_created_next:
  add r10,24
  dec ecx
  jne find_created

trait_failed:
  mov dword ptr [gbfr_SigilCreateStatus],5
  jmp done
duplicate:
  mov dword ptr [gbfr_SigilCreateStatus],6
  jmp done
rejected:
  mov dword ptr [gbfr_SigilCreateStatus],4
  jmp done
success:
  mov dword ptr [gbfr_SigilCreateStatus],2

done:
  add rsp,28
  pop rdx
  jmp gbfr_SelectedSigilRenderContinue

align 4 CC
gbfr_SigilRequest:
  dd 0,0,0,0
gbfr_SigilCreateStatus:
  dd 0
gbfr_SigilCreatedHandle:
  dd 0

gbfr_UniqueSigils:
  dd D8A464F1
  dd 1A57AEF1
  dd 1C4D37E4
  dd 82F1E7E4
  dd 426AD20E
  dd F8FEF304
  dd 4F01D6CA
  dd 8ECBB0A3
  dd AB835493
  dd E4F986D9
  dd 5A360EA8
  dd CE16D68B
  dd 52A6E299
  dd 02B1F8C0
  dd 895ABBF6
  dd 9ADA3E00
  dd 98A6D249
  dd 673C5D8F
  dd AEEF8343
  dd 49434696
  dd 65F0420A
  dd 02472C43
  dd E2B380E5
  dd B441275D
  dd 9BD1CC24
  dd 6AAE4B8F
  dd B289A9AD
  dd B8C44D5E
  dd 119B24A8
  dd A8A0CBFF
  dd 23953FD4
  dd 95CC3CB8
  dd AF8E7E7E
  dd 1BBE919C
  dd E19B1965
  dd 0

gbfr_SelectedSigilRenderSite:
  jmp gbfr_SigilMem
  nop 2

[DISABLE]
gbfr_SigilRequest+0C:
  dd 0

gbfr_SelectedSigilRenderSite:
  db 48 8B 51 18 48 85 D2

unregistersymbol(gbfr_SigilCreateStatus)
unregistersymbol(gbfr_SigilRequest)</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>50059</ID>
                  <Description>"Create Sigil"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
-- CE_STANDALONE_SIGIL_SELECTOR
if syntaxcheck then return end

local selectorTitle = "Create Sigil"

local function finish(message)
  if message ~= nil then
    showMessage(message)
  end
  local timer = createTimer(nil, false)
  timer.Interval = 50
  timer.OnTimer = function()
    timer.destroy()
    memrec.Active = false
  end
  timer.Enabled = true
end

local tableFile = findTableFile("gbfr_sigil_catalog.dat")
if tableFile == nil then
  finish("The embedded Sigil catalog could not be loaded.")
  return
end

local stream = tableFile.getData()
if stream == nil or stream.Size == 0 then
  finish("The embedded Sigil catalog is empty.")
  return
end

stream.Position = 0
local catalogText = stream.readString(stream.Size)
stream.destroy()

local sigils = {}
local synthesisTraits = {}
local traitByHash = {}
local pools = {}
local synthesisDefinitionSet = {}

for line in catalogText:gmatch("[^\r\n]+") do
  local hash, minimum, maximum, mode, reference, name = line:match("^S\t([0-9A-F]+)\t(%d+)\t(%d+)\t(%d+)\t([0-9A-F]+)\t(.+)$")
  if hash ~= nil then
    local item = {
      hash = hash,
      minimum = tonumber(minimum),
      maximum = tonumber(maximum),
      mode = tonumber(mode),
      reference = reference,
      text = string.format("%s | %s | Lv %s-%s", name, hash, minimum, maximum)
    }
    table.insert(sigils, item)
  else
    local traitHash, traitName = line:match("^T\t([0-9A-F]+)\t(.+)$")
    if traitHash ~= nil then
      local trait = {
        hash = traitHash,
        text = string.format("%s | %s", traitName, traitHash)
      }
      if traitHash ~= "00000000" then
        traitByHash[traitHash] = trait
        table.insert(synthesisTraits, trait)
      end
    else
      local pool, poolHash = line:match("^P\t(%d+)\t([0-9A-F]+)$")
      if pool ~= nil then
        pool = tonumber(pool)
        pools[pool] = pools[pool] or {}
        table.insert(pools[pool], poolHash)
      else
        local synthesisDefinition = line:match("^Y\t([0-9A-F]+)$")
        if synthesisDefinition ~= nil then
          synthesisDefinitionSet[synthesisDefinition] = true
        end
      end
    end
  end
end

local sigilList = createStringList()
local sigilByText = {}
for _, item in ipairs(sigils) do
  sigilList.add(item.text)
  sigilByText[item.text] = item
end
local _, selectedText = showSelectionList(
  selectorTitle,
  "Choose a Sigil:",
  sigilList,
  false
)
sigilList.destroy()

local sigil = sigilByText[selectedText]
if sigil == nil then
  finish()
  return
end
local level = sigil.maximum

local secondaryHash = "00000000"
local secondaryList
local secondaryByText = {}
local secondaryPrompt
if synthesisDefinitionSet[sigil.hash] then
  secondaryList = createStringList()
  secondaryPrompt = "Choose a Sigil Synthesis-compatible secondary trait:"
  for _, trait in ipairs(synthesisTraits) do
    secondaryList.add(trait.text)
    secondaryByText[trait.text] = trait.hash
  end
elseif sigil.mode == 2 then
  local candidates = pools[tonumber(sigil.reference)]
  secondaryList = createStringList()
  secondaryPrompt = "Choose a natural secondary trait:"
  local randomText = "Game-native random | 00000000"
  secondaryList.add(randomText)
  secondaryByText[randomText] = "00000000"
  for _, traitHash in ipairs(candidates) do
    local trait = traitByHash[traitHash]
    secondaryList.add(trait.text)
    secondaryByText[trait.text] = trait.hash
  end
end

if secondaryList ~= nil then
  local _, selectedSecondary = showSelectionList(
    selectorTitle,
    secondaryPrompt,
    secondaryList,
    false
  )
  secondaryList.destroy()
  secondaryHash = secondaryByText[selectedSecondary]
  if secondaryHash == nil then
    finish()
    return
  end
end

local request = getAddressSafe("gbfr_SigilRequest")
if request == nil or request == 0 then
  finish("Enable Sigil Creator before using Create Sigil.")
  return
end
if readInteger(request + 0x0C) ~= 0 then
  finish("A Sigil request is already pending.")
  return
end

local function dword(hex)
  local value = tonumber(hex, 16)
  if value &gt;= 2147483648 then
    return value - 4294967296
  end
  return value
end

writeInteger(request, dword(sigil.hash))
writeInteger(request + 0x04, level)
writeInteger(request + 0x08, dword(secondaryHash))
writeInteger(request + 0x10, 1)
writeInteger(request + 0x0C, 1)

local messages = {
  [2] = "Sigil created.",
  [3] = "Invalid Sigil request or catalog entry.",
  [4] = "The game rejected the Sigil creation request.",
  [5] = "The Sigil was created, but its secondary trait could not be verified.",
  [6] = "That globally unique Sigil is already owned."
}
local attempts = 0
local timer = createTimer(nil, false)
timer.Interval = 100
timer.OnTimer = function()
  attempts = attempts + 1
  local status = readInteger(request + 0x10)
  if messages[status] ~= nil then
    timer.destroy()
    showMessage(messages[status])
    memrec.Active = false
  elseif attempts &gt;= 100 then
    if readInteger(request + 0x0C) == 1 then
      writeInteger(request + 0x0C, 0)
    end
    writeInteger(request + 0x10, 8)
    timer.destroy()
    showMessage("The Sigil request timed out. Open Inventory &gt; Sigils and change the selection before trying again.")
    memrec.Active = false
  end
end
timer.Enabled = true
{$asm}

[DISABLE]</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>50060</ID>
                  <Description>"Last Create Result (0=Idle; 1=Pending; 2=Created; 3/4/5/6/8=Error)"</Description>
                  <VariableType>4 Bytes</VariableType>
                  <Address>gbfr_SigilCreateStatus</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>50061</ID>
              <Description>"Summon Stone Spawner"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1" />
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(gbfr_SummonRenderHook,granblue_fantasy_relink.exe,41 8B 46 08 C5 F8 57 C0)
aobscanmodule(gbfr_SummonAddMatch,granblue_fantasy_relink.exe,89 D3 8B 51 30 21 DA 48 8B 41 08 4C 8B 41 18 49 89 D1)
define(gbfr_SummonAdd,gbfr_SummonAddMatch-23)
aobscanmodule(gbfr_SummonFinalizeHook,granblue_fantasy_relink.exe,44 8B A5 DC 02 00 00)
assert(gbfr_SummonAdd,55 41 57 41 56 41 55 41 54 56 57 53 48 81 EC A8 00 00 00)

alloc(gbfr_SummonMem,$1000,gbfr_SummonRenderHook)
registersymbol(gbfr_SummonRequest)

label(code)
label(return)
label(gbfr_SummonFinalizeMem)
label(gbfr_SummonApplyBonus)
label(gbfr_SummonFinalizeCode)
label(gbfr_SummonFinalizeReturn)
label(gbfr_SummonRequest)
label(gbfr_SummonOverride)

gbfr_SummonMem:
  cmp dword ptr [gbfr_SummonRequest+14],1
  jne code
  mov dword ptr [gbfr_SummonRequest+14],0

  mov eax,[gbfr_SummonRequest+04]
  or eax,[gbfr_SummonRequest+0C]
  mov [gbfr_SummonOverride],eax

  sub rsp,20
  mov rcx,rdi
  mov edx,[gbfr_SummonRequest]
  call gbfr_SummonAdd
  add rsp,20
  mov rcx,[rsi+00000188]
  mov dword ptr [gbfr_SummonOverride],0

code:
  mov eax,[r14+08]
  vxorps xmm0,xmm0,xmm0
  jmp return

gbfr_SummonFinalizeMem:
  cmp dword ptr [gbfr_SummonOverride],0
  je gbfr_SummonFinalizeCode
  mov eax,[gbfr_SummonRequest]
  cmp [rdi+08],eax
  jne gbfr_SummonFinalizeCode
  mov dword ptr [gbfr_SummonOverride],0

  mov eax,[gbfr_SummonRequest+04]
  test eax,eax
  je gbfr_SummonApplyBonus
  mov [r14],eax
  mov eax,[gbfr_SummonRequest+08]
  mov [rbx],eax

gbfr_SummonApplyBonus:
  mov eax,[gbfr_SummonRequest+0C]
  test eax,eax
  je gbfr_SummonFinalizeCode
  mov [r14+04],eax
  mov eax,[gbfr_SummonRequest+10]
  mov [rbx+04],eax

gbfr_SummonFinalizeCode:
  mov r12d,[rbp+000002DC]
  jmp gbfr_SummonFinalizeReturn

align 4 CC
gbfr_SummonRequest:
  dd 0,0,0,0,0,0
gbfr_SummonOverride:
  dd 0

gbfr_SummonRenderHook:
  jmp gbfr_SummonMem
  nop 3
return:

gbfr_SummonFinalizeHook:
  jmp gbfr_SummonFinalizeMem
  nop 2
gbfr_SummonFinalizeReturn:

[DISABLE]
gbfr_SummonRequest+14:
  dd 0
gbfr_SummonOverride:
  dd 0

gbfr_SummonRenderHook:
  db 41 8B 46 08 C5 F8 57 C0
gbfr_SummonFinalizeHook:
  db 44 8B A5 DC 02 00 00

