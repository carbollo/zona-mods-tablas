    <CheatEntry>
      <ID>51</ID>
      <Description>"Broken"</Description>
      <Options moHideChildren="1"/>
      <Color>C0C0C0</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>14</ID>
          <Description>"SA Meter (CTRL S To Set To Max, CTRL A To Freeze)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : granblue_fantasy_relink.exe
  Version: 
  Date   : 2024-02-01
  Author : zachw

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(SA_Meter,granblue_fantasy_relink.exe,D7 C5 FA 10 4E 7C) // should be unique
alloc(newmem,$1000,SA_Meter)
globalalloc(SAMeter,4)
label(code)
label(return)

newmem:
push rax
lea rax,[rsi+7C]
mov [SAMeter],rax
pop rax
code:
  vmovss xmm1,[rsi+7C]
  jmp return

SA_Meter+01:
  jmp newmem
return:
registersymbol(SA_Meter)

[DISABLE]

SA_Meter+01:
  db C5 FA 10 4E 7C

unregistersymbol(SA_Meter)
dealloc(newmem)
dealloc(SAMeter)
