  xorps xmm0, xmm0

code:
  // comiss xmm0,[rcx+00000094]
  reassemble(INJECT_INF_HP)
  jmp return
  align 10 cc

INJECT_INF_HP:
  jmp newmem
  nop 2
return:
registersymbol(INJECT_INF_HP INJECT_INF_HPo)

