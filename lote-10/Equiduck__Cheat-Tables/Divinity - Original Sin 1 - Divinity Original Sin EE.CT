    <CheatEntry>
      <ID>2801</ID>
      <Description>"Unlimited Health"</Description>
	  <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(health,EoCApp.exe,49 8B CF 41 2B D4 E8 * * * * 41)
alloc(newmem,$1000,health)

label(code)
label(return)
label(OneHitKill2)
registersymbol(OneHitKill2)

newmem:
  mov rcx,[r15+C0]
  cmp [rcx+190],1
  mov rcx,r15
  je return
  cmp [OneHitKill2],1
  jne code
  xor edx,edx
  jmp return
code:
  db 41 2B D4
  jmp return

OneHitKill2:
dd 1

health:
  jmp newmem
  nop
return:
registersymbol(health)

[DISABLE]

health:
  db 49 8B CF 41 2B D4

unregistersymbol(health)
dealloc(newmem)
unregistersymbol(OneHitKill2)

