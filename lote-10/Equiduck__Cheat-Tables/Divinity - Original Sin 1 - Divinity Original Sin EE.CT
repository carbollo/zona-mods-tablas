      <Description>"Teleport To Coordinates"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]

-- DOS EE: Safe map X/Y teleport with limited auto-height scan
--
-- Engine position:
--   X, HEIGHT/Y, Z
--
-- Map X/Y:
--   TARGET_MAP_X = engine X
--   TARGET_MAP_Y = engine Z
--
-- This avoids broad object scans. It only scans character positions nearby
-- to infer possible ground heights, then lets CharacterAppearAtPosition snap
-- to the nearest valid navmesh.

local PROCESS_NAME = "EoCApp.exe"

local MODE = "host" -- "host" or "ownedParty"

local TARGET_MAP_X = 405
local TARGET_MAP_Y = 167

local USE_MANUAL_HEIGHT = false
local MANUAL_HEIGHT = 2.75

local SCAN_RADIUS = 60.0
local MAX_POSITION_CALLS = 300
local HEIGHT_BIN_SIZE = 0.25
local SELECT_CANDIDATE_INDEX = 1
local HEIGHT_OFFSET = 0.05

local PLAY_SPAWN = 1
local PARTY_SPACING = 1.0

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  CharacterGetOwner         = 0xCE8D20,
  CharacterSetOnStage       = 0xCEFD30,
  CharacterAppearAtPosition = 0xCF2340,
  CharMgr                   = 0x134EB68,
}

local function getModuleBaseLocal(moduleName)
  local b = getAddressSafe(moduleName)
  if b and b ~= 0 then return b end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then return module.Address end
  end

  return nil
end

local base = getModuleBaseLocal(PROCESS_NAME)
if not base or base == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

local function isptr(p)
  return p and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function fmt(v)
  if v == nil then return "nil" end
  return string.format("0x%X", v)
end

local function rq(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readQword, a)
  if ok then return v end
end

local function ri(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readInteger, a)
  if ok then return v end
end

local function rw(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readSmallInteger, a)
  if ok then return v end
end

local function rf(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readFloat, a)
  if ok then return v end
end

local scratch = allocateMemory(0x4000)
if not scratch then
  print("FAIL: allocateMemory failed. Restart CE and reattach.")
  return
end

local off = 0

local function resetScratch()
  off = 0
  for i = 0, 0x3FFF do
    writeBytes(scratch + i, 0)
  end
end

local function alloc(size)
  local aligned = math.floor((size + 15) / 16) * 16

  if off + aligned &gt;= 0x4000 then
    error("scratch exhausted")
  end

  local p = scratch + off
  off = off + aligned
  return p
end

local function boxQword(v)
  local p = alloc(8)
  writeQword(p, v or 0)
  return p
end

local function boxDword(v)
  local p = alloc(8)
  writeInteger(p, v or 0)
  return p
end

local function boxFloat(v)
  local p = alloc(8)
  writeFloat(p, v or 0)
  return p
end

local function makeFakeRef(obj)
  local ref = alloc(0x20)
  writeQword(ref + 0x10, obj)
  return ref
end

local function makeRefBox(obj)
  return boxQword(makeFakeRef(obj))
end

local function charObjToHandle(obj)
  if not isptr(obj) then return nil end

  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil
  local genTable = isptr(mgr) and rq(mgr + 0x40) or nil

  if not isptr(objTable) or not isptr(genTable) or not count then return nil end

  for i = 0, count - 1 do
    if rq(objTable + i * 8) == obj then
      local gen = rw(genTable + i * 2)

      if gen then
        return 0x64000000 | ((gen &amp; 0x3FF) &lt;&lt; 16) | i
      end
    end
  end

  return nil
end

local function getObjPosition(obj)
  local vt = rq(obj)
  local fnGetPos = isptr(vt) and rq(vt + 0x90) or nil

  if not isptr(fnGetPos) then
    return nil, nil, nil
  end

  local posPtr = executeCodeEx(0, nil, fnGetPos, obj)

  if not isptr(posPtr) then
    return nil, nil, nil
  end

  return rf(posPtr), rf(posPtr + 4), rf(posPtr + 8)
end

local function getHostPlayer()
  resetScratch()

  local outBox = boxQword(0)
  local frame = alloc(0x40)

  writeQword(frame + 0x10, outBox)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetHostCharacter, 0, frame)
  local hostRef = readQword(outBox) or 0
  local hostObj = rq(hostRef + 0x10)
  local hostHandle = charObjToHandle(hostObj)

  print("CharacterGetHostCharacter ret = " .. fmt(ret))
  print("hostRef    = " .. fmt(hostRef))
  print("hostObj    = " .. fmt(hostObj))
  print("hostHandle = " .. tostring(hostHandle) .. " / " .. fmt(hostHandle))

  if not isptr(hostObj) then
    error("host player object invalid")
  end

  return hostObj
end

local function getOwnerObj(charObj)
  resetScratch()

  local outOwner = boxQword(0)
  local frame = alloc(0x60)

  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, outOwner)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetOwner, 0, frame)
  local ownerRef = readQword(outOwner) or 0
  local ownerObj = rq(ownerRef + 0x10)

  return ownerObj, ret
end

local function roundToStep(v, step)
  return math.floor((v / step) + 0.5) * step
end

local function horizontalDistSq(x, z, tx, tz)
  local dx = x - tx
  local dz = z - tz
  return dx * dx + dz * dz
end

local function scanCharacterHeights(targetX, targetZ)
  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil

  if not isptr(objTable) or not count then
    error("bad CharMgr table")
  end

  local radiusSq = SCAN_RADIUS * SCAN_RADIUS
  local buckets = {}
  local calls = 0
  local nearby = 0

  print("")
  print("=== SAFE HEIGHT SCAN, CHARACTERS ONLY ===")
  print("CharMgr count       = " .. tostring(count))
  print("max position calls  = " .. tostring(MAX_POSITION_CALLS))
  print("scan radius         = " .. tostring(SCAN_RADIUS))

  for i = 0, count - 1 do
    if calls &gt;= MAX_POSITION_CALLS then break end

    local obj = rq(objTable + i * 8)

    if isptr(obj) then
      calls = calls + 1

      local x, h, z = getObjPosition(obj)

      if x and h and z then
        local d2 = horizontalDistSq(x, z, targetX, targetZ)

        if d2 &lt;= radiusSq then
          nearby = nearby + 1

          local height = roundToStep(h, HEIGHT_BIN_SIZE)
          local key = string.format("%.3f", height)

          if not buckets[key] then
            buckets[key] = {
              height = height,
              count = 0,
              nearestD2 = d2,
              nearestObj = obj,
              nearestX = x,
              nearestY = h,
              nearestZ = z,
            }
          end

          local b = buckets[key]
          b.count = b.count + 1

          if d2 &lt; b.nearestD2 then
            b.nearestD2 = d2
            b.nearestObj = obj
            b.nearestX = x
            b.nearestY = h
            b.nearestZ = z
          end
        end
      end
    end
  end

  local candidates = {}

  for _, b in pairs(buckets) do
    table.insert(candidates, b)
  end

  table.sort(candidates, function(a, b)
    if math.abs(a.nearestD2 - b.nearestD2) &lt; 0.001 then
      return a.count &gt; b.count
    end

    return a.nearestD2 &lt; b.nearestD2
  end)

  print("position calls used       = " .. tostring(calls))
  print("nearby positioned chars   = " .. tostring(nearby))
  print("height candidates         = " .. tostring(#candidates))

  for i, c in ipairs(candidates) do
    if i &gt; 20 then break end

    print(string.format(
      "[%02d] height=%.6f samples=%d nearestObj=%s nearestPos=%.3f, %.3f, %.3f horizDist=%.3f",
      i,
      c.height,
      c.count,
      fmt(c.nearestObj),
      c.nearestX,
      c.nearestY,
      c.nearestZ,
      math.sqrt(c.nearestD2)
    ))
  end

  return candidates
end

local function callSetOnStage(charObj, enabled)
  resetScratch()

  local frame = alloc(0x50)

  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxDword(enabled and 1 or 0))

  local ret = executeCodeEx(0, nil, base + RVA.CharacterSetOnStage, 0, frame)
  print("CharacterSetOnStage ret = " .. fmt(ret))

  return ret
end

local function callAppearAtPosition(charObj, x, h, z)
  resetScratch()

  local frame = alloc(0x90)

  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxFloat(x))
  writeQword(frame + 0x40, boxFloat(h))
  writeQword(frame + 0x58, boxFloat(z))
  writeQword(frame + 0x70, boxDword(PLAY_SPAWN))

  local ret = executeCodeEx(0, nil, base + RVA.CharacterAppearAtPosition, 0, frame)
  print("CharacterAppearAtPosition ret = " .. fmt(ret))

  return ret
end

local function teleportChar(label, charObj, x, h, z)
  print("")
  print("=== TELEPORT " .. label .. " ===")
  print("obj    = " .. fmt(charObj))
  print("handle = " .. tostring(charObjToHandle(charObj)) .. " / " .. fmt(charObjToHandle(charObj)))

  if not isptr(charObj) then
    print("SKIP: invalid character object")
    return false
  end

  local bx, by, bz = getObjPosition(charObj)

  print("before = " .. tostring(bx) .. ", " .. tostring(by) .. ", " .. tostring(bz))
  print("target = " .. tostring(x) .. ", " .. tostring(h) .. ", " .. tostring(z))

  callSetOnStage(charObj, true)
  callAppearAtPosition(charObj, x, h, z)

  sleep(250)

  local ax, ay, az = getObjPosition(charObj)

  print("after  = " .. tostring(ax) .. ", " .. tostring(ay) .. ", " .. tostring(az))

  return true
end

local function getOwnedParty(hostObj)
  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil

  if not isptr(objTable) or not count then
    return {}
  end

  local result = {}

  for i = 0, count - 1 do
    local obj = rq(objTable + i * 8)

    if isptr(obj) and obj ~= hostObj then
      local ownerObj = getOwnerObj(obj)

      if ownerObj == hostObj then
        table.insert(result, obj)
      end
    end
  end

  return result
end

local function main()
  print("=== SAFE MAP X/Y TELEPORT ===")
  print("base           = " .. fmt(base))
  print("MODE           = " .. MODE)
  print("target map X/Y = " .. tostring(TARGET_MAP_X) .. ", " .. tostring(TARGET_MAP_Y))

  if MODE ~= "host" and MODE ~= "ownedParty" then
    error("MODE must be \"host\" or \"ownedParty\"")
  end

  local hostObj = getHostPlayer()

  local height

  if USE_MANUAL_HEIGHT then
    height = MANUAL_HEIGHT
    print("")
    print("using manual height = " .. tostring(height))
  else
    local candidates = scanCharacterHeights(TARGET_MAP_X, TARGET_MAP_Y)
    local selected = candidates[SELECT_CANDIDATE_INDEX]

    if not selected then
      print("")
      print("No nearby character-derived height candidates found.")
      print("Set USE_MANUAL_HEIGHT=true and set MANUAL_HEIGHT.")
      return
    end

    height = selected.height + HEIGHT_OFFSET

    print("")
    print("=== SELECTED HEIGHT ===")
    print("selected candidate = " .. tostring(SELECT_CANDIDATE_INDEX))
    print("ground height      = " .. tostring(selected.height))
    print("height offset      = " .. tostring(HEIGHT_OFFSET))
    print("teleport height    = " .. tostring(height))
    print("nearest object     = " .. fmt(selected.nearestObj))
    print("nearest pos        = " .. tostring(selected.nearestX) .. ", " .. tostring(selected.nearestY) .. ", " .. tostring(selected.nearestZ))
  end

  teleportChar("HOST", hostObj, TARGET_MAP_X, height, TARGET_MAP_Y)

  if MODE == "ownedParty" then
    local party = getOwnedParty(hostObj)

    print("")
    print("owned party count = " .. tostring(#party))

    for i, obj in ipairs(party) do
      local ox = ((i % 3) - 1) * PARTY_SPACING
      local oz = math.floor((i - 1) / 3) * PARTY_SPACING

      teleportChar(
        "OWNED #" .. tostring(i),
        obj,
        TARGET_MAP_X + ox,
        height,
        TARGET_MAP_Y + oz
      )
    end
  end

  print("")
  print("DONE")
end

main()

[DISABLE]
{$asm}</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>50006</ID>
      <Description>"Add Skill"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]

-- DOS EE: Learn/Add Spell/Skill to Host Character
--
-- Default target = host player.
-- Set SKILL_ID to the exact internal skill name.
--
-- Examples:
--   Projectile_Flare
--   Target_Heal
--   Shout_Haste
--   Projectile_Fireball

local PROCESS_NAME = "EoCApp.exe"

local SKILL_ID = "Projectile_Flare"

-- nil = host player
-- or set to exact character object pointer
local TARGET_CHARACTER_OBJ = nil
-- local TARGET_CHARACTER_OBJ = 0x0000000000000000

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  CharacterAddSkill         = 0xCF3AD0,
  CharMgr                   = 0x134EB68,
}

local function getModuleBaseLocal(moduleName)
  local b = getAddressSafe(moduleName)
  if b and b ~= 0 then return b end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then return module.Address end
  end

  return nil
end

local base = getModuleBaseLocal(PROCESS_NAME)
if not base or base == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

local function isptr(p)
  return p and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function fmt(v)
  if v == nil then return "nil" end
  return string.format("0x%X", v)
end

local function rq(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readQword, a)
  if ok then return v end
end

local function ri(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readInteger, a)
  if ok then return v end
end

local function rw(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readSmallInteger, a)
  if ok then return v end
end

local scratch = allocateMemory(0x4000)
if not scratch then
  print("FAIL: allocateMemory failed. Restart CE and reattach.")
  return
end

local off = 0

local function resetScratch()
  off = 0
  for i = 0, 0x3FFF do
    writeBytes(scratch + i, 0)
  end
end

local function alloc(size)
  local aligned = math.floor((size + 15) / 16) * 16

  if off + aligned &gt;= 0x4000 then
    error("scratch exhausted")
  end

  local p = scratch + off
  off = off + aligned
  return p
end

local function boxQword(v)
  local p = alloc(8)
  writeQword(p, v or 0)
  return p
end

local function makeCString(s)
  local p = alloc(#s + 1)
  writeString(p, s)
  writeBytes(p + #s, 0)
  return p
end

local function makeFakeRef(obj)
  local ref = alloc(0x20)
  writeQword(ref + 0x10, obj)
  return ref
end

local function makeRefBox(obj)
  return boxQword(makeFakeRef(obj))
end

local function charObjToHandle(obj)
  if not isptr(obj) then return nil end

  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil
  local genTable = isptr(mgr) and rq(mgr + 0x40) or nil

  if not isptr(objTable) or not isptr(genTable) or not count then return nil end

  for i = 0, count - 1 do
    if rq(objTable + i * 8) == obj then
      local gen = rw(genTable + i * 2)

      if gen then
        return 0x64000000 | ((gen &amp; 0x3FF) &lt;&lt; 16) | i
      end
    end
  end

  return nil
end

local function getHostPlayer()
  resetScratch()

  local outBox = boxQword(0)
  local frame = alloc(0x40)

  writeQword(frame + 0x10, outBox)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetHostCharacter, 0, frame)
  local hostRef = readQword(outBox) or 0
  local hostObj = rq(hostRef + 0x10)
  local hostHandle = charObjToHandle(hostObj)

  print("CharacterGetHostCharacter ret = " .. fmt(ret))
  print("hostRef    = " .. fmt(hostRef))
  print("hostObj    = " .. fmt(hostObj))
  print("hostHandle = " .. tostring(hostHandle) .. " / " .. fmt(hostHandle))

  if not isptr(hostObj) then
    error("host player object invalid")
  end

  return hostObj
end

local function callCharacterAddSkill(charObj, skillId)
  resetScratch()

  local frame = alloc(0x60)
  local skillCString = makeCString(skillId)

  -- CharacterAddSkill(Character, Skill)
  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxQword(skillCString))

  local fn = base + RVA.CharacterAddSkill

  print("")
  print("=== CALL CharacterAddSkill ===")
  print("fn      = " .. fmt(fn))
  print("charObj = " .. fmt(charObj))
  print("handle  = " .. tostring(charObjToHandle(charObj)) .. " / " .. fmt(charObjToHandle(charObj)))
  print("skill   = " .. skillId)

  local ret = executeCodeEx(0, nil, fn, 0, frame)

  print("CharacterAddSkill ret = " .. fmt(ret))
  return ret
end

local function main()
  print("=== DOS EE LEARN SPELL/SKILL ===")
  print("base     = " .. fmt(base))
  print("wrapper  = " .. fmt(base + RVA.CharacterAddSkill))
  print("SKILL_ID = " .. SKILL_ID)

  local targetObj = TARGET_CHARACTER_OBJ

  if not isptr(targetObj) then
    targetObj = getHostPlayer()
  else
    print("using TARGET_CHARACTER_OBJ = " .. fmt(targetObj))
  end

  callCharacterAddSkill(targetObj, SKILL_ID)

  print("")
  print("DONE")
  print("Check the character's skill/spell list.")
end

main()

