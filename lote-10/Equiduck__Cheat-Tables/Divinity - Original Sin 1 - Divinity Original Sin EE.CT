    <CheatEntry>
      <ID>50000</ID>
      <Description>"Spawn Item By UUID"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local TEMPLATE = "3c79e509-9cf3-4102-9224-03e429b3bdd4"
local AMOUNT = 1
local X = X or 0
local Y = Y or 0
local Z = Z or 0

local function getModuleBaseLocal(moduleName)
  local base = getAddressSafe(moduleName)
  if base and base ~= 0 then return base end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then
      return module.Address
    end
  end

  return nil
end

local function zeroMemory(addr, size)
  for i = 0, size - 1 do
    writeBytes(addr + i, 0)
  end
end

local function allocCString(value)
  local ptr = allocateMemory(#value + 1)
  writeString(ptr, value)
  writeBytes(ptr + #value, 0)
  return ptr
end

local function boxQword(value)
  local ptr = allocateMemory(8)
  writeQword(ptr, value or 0)
  return ptr
end

local function boxDword(value)
  local ptr = allocateMemory(8)
  writeInteger(ptr, value or 0)
  return ptr
end

local function boxFloat(value)
  local ptr = allocateMemory(8)
  writeFloat(ptr, value or 0)
  return ptr
end

local eocBase = getModuleBaseLocal("EoCApp.exe")
if not eocBase or eocBase == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

local CreateItemTemplateAtPosition = eocBase + 0xD0EB00
local ItemHandleGetPosition        = eocBase + 0xD080C0
local CharacterGetHostCharacter    = eocBase + 0xCF00D0
local ItemHandleToCharacter        = eocBase + 0xD12A50

print(string.format("EoCApp base                  = 0x%X", eocBase))
print(string.format("CreateItemTemplateAtPosition = 0x%X", CreateItemTemplateAtPosition))
print(string.format("ItemHandleGetPosition        = 0x%X", ItemHandleGetPosition))
print(string.format("CharacterGetHostCharacter    = 0x%X", CharacterGetHostCharacter))
print(string.format("ItemHandleToCharacter        = 0x%X", ItemHandleToCharacter))
print("Template = " .. TEMPLATE)

-- 1. Create item at position.
local templateCString = allocCString(TEMPLATE)
local templateBox = boxQword(templateCString)

local xBox = boxFloat(X)
local yBox = boxFloat(Y)
local zBox = boxFloat(Z)
local outHandleBox = boxDword(0)

local createFrame = allocateMemory(0x90)
zeroMemory(createFrame, 0x90)

writeQword(createFrame + 0x10, templateBox)
writeQword(createFrame + 0x28, xBox)
writeQword(createFrame + 0x40, yBox)
writeQword(createFrame + 0x58, zBox)
writeQword(createFrame + 0x70, outHandleBox)

local createRet = executeCodeEx(0, nil, CreateItemTemplateAtPosition, 0, createFrame)
local newHandle = readInteger(outHandleBox) or 0

print("")
print(string.format("Create ret=0x%X newHandle=0x%X", tonumber(createRet or 0), newHandle))

if newHandle == 0 then
  print("FAIL: item was not created")
  return
end

-- 2. Verify created handle position through direct handler.
local handleBoxForPos = boxDword(newHandle)
local outXBox = boxFloat(0)
local outYBox = boxFloat(0)
local outZBox = boxFloat(0)

local posFrame = allocateMemory(0x80)
zeroMemory(posFrame, 0x80)

writeQword(posFrame + 0x10, handleBoxForPos)
writeQword(posFrame + 0x28, outXBox)
writeQword(posFrame + 0x40, outYBox)
writeQword(posFrame + 0x58, outZBox)

local posRet = executeCodeEx(0, nil, ItemHandleGetPosition, 0, posFrame)

print(string.format(
  "Position ret=0x%X X=%.3f Y=%.3f Z=%.3f",
  tonumber(posRet or 0),
  readFloat(outXBox) or 0,
  readFloat(outYBox) or 0,
  readFloat(outZBox) or 0
))

-- 3. Get native host character reference.
local hostCharRefBox = boxQword(0)

local hostFrame = allocateMemory(0x40)
zeroMemory(hostFrame, 0x40)

writeQword(hostFrame + 0x10, hostCharRefBox)

local hostRet = executeCodeEx(0, nil, CharacterGetHostCharacter, 0, hostFrame)
local hostCharRef = readQword(hostCharRefBox) or 0

print("")
print(string.format("Host ret=0x%X hostCharRef=0x%X", tonumber(hostRet or 0), hostCharRef))

if hostCharRef == 0 then
  print("FAIL: CharacterGetHostCharacter did not return a native character ref")
  return
end

local okType = readInteger(hostCharRef + 0x08) or 0
print(string.format("hostCharRef type/check at +0x08 = 0x%X", okType))

-- 4. Move created item handle to host character.
local handleBox = boxDword(newHandle)
local amountBox = boxDword(AMOUNT)

local moveFrame = allocateMemory(0x70)
zeroMemory(moveFrame, 0x70)

writeQword(moveFrame + 0x10, handleBox)
writeQword(moveFrame + 0x28, hostCharRefBox)
writeQword(moveFrame + 0x40, amountBox)

local moveRet = executeCodeEx(0, nil, ItemHandleToCharacter, 0, moveFrame)

print("")
print(string.format("ItemHandleToCharacter ret=0x%X", tonumber(moveRet or 0)))
print("Check the host character inventory for the spawned item.")

[DISABLE]
{$asm}
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>50001</ID>
      <Description>"Level Up Party"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
-- DOS EE: Add exactly enough party XP for party level-up
-- Fixed: FUN_140E495F0 mutates statsPtr + 0x13C, so test calls restore it.

local LEVELS_TO_GAIN = 1
local MAX_SEARCH_XP = 2000000000

local PROCESS_NAME = "EoCApp.exe"

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  PartyAddActualExperience  = 0xCF0040,
  CalcLevelFromXPDelta      = 0xE495F0,  -- FUN_140E495F0(statsPtr, xpDelta), mutates statsPtr+0x13C
  CharacterManager          = 0x134EAF0
}

local function getModuleBaseLocal(moduleName)
  local base = getAddressSafe(moduleName)
  if base and base ~= 0 then return base end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then
      return module.Address
    end
  end

  return nil
end

local function zeroMemory(addr, size)
  for i = 0, size - 1 do writeBytes(addr + i, 0) end
end

local function boxQword(value)
  local ptr = allocateMemory(8)
  writeQword(ptr, value or 0)
  return ptr
end

local function boxDword(value)
  local ptr = allocateMemory(8)
  writeInteger(ptr, value or 0)
  return ptr
end

local function looksLikePtr(p)
  return p ~= nil and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function rq(addr)
  if not looksLikePtr(addr) then return nil end
  local ok, v = pcall(readQword, addr)
  if ok then return v end
  return nil
end

local function ri(addr)
  if not looksLikePtr(addr) then return nil end
  local ok, v = pcall(readInteger, addr)
  if ok then return v end
  return nil
end

local function getHostCharRef(eocBase)
  local CharacterGetHostCharacter = eocBase + RVA.CharacterGetHostCharacter

  local hostCharRefBox = boxQword(0)
  local hostFrame = allocateMemory(0x40)

  zeroMemory(hostFrame, 0x40)
  writeQword(hostFrame + 0x10, hostCharRefBox)

  local hostRet = executeCodeEx(0, nil, CharacterGetHostCharacter, 0, hostFrame)
  local hostCharRef = readQword(hostCharRefBox) or 0

  print(string.format("Host ret=0x%X hostCharRef=0x%X", tonumber(hostRet or 0), hostCharRef))

  if hostCharRef == 0 then
    return nil, nil, "CharacterGetHostCharacter returned 0"
  end

  return hostCharRef, hostCharRefBox, nil
end

local function resolvePartyObjectFromCharRef(eocBase, charRef)
  local handleSource = rq(charRef + 0x10)
  if not looksLikePtr(handleSource) then
    return nil, "charRef + 0x10 was null/bad"
  end

  local handle = ri(handleSource + 0x220)
  if not handle or handle == 0 then
    return nil, "handle at handleSource + 0x220 was null"
  end

  local mgr = rq(eocBase + RVA.CharacterManager)
  if not looksLikePtr(mgr) then
    return nil, "character manager was null/bad"
  end

  local low = handle &amp; 0xFFFF
  local salt = (handle &gt;&gt; 16) &amp; 0x3FF

  local maxObjects = ri(mgr + 0x24)
  if not maxObjects or low &gt;= maxObjects then
    return nil, string.format("handle low index out of range: handle=0x%X", handle)
  end

  local objects = rq(mgr + 0x18)
  local salts = rq(mgr + 0x40)

  if not looksLikePtr(objects) or not looksLikePtr(salts) then
    return nil, "character manager arrays were null/bad"
  end

  local expectedSalt = readSmallInteger(salts + low * 2)

  if expectedSalt ~= salt then
    return nil, string.format(
      "handle salt mismatch: handle=0x%X expectedSalt=0x%X salt=0x%X",
      handle,
      tonumber(expectedSalt or 0),
      salt
    )
  end

  local partyObj = rq(objects + low * 8)
  if not looksLikePtr(partyObj) then
    return nil, "resolved party object was null/bad"
  end

  return partyObj, nil
end

local function calcLevelNonDestructive(eocBase, statsPtr, xpDelta)
  local fn = eocBase + RVA.CalcLevelFromXPDelta

  local xpField = statsPtr + 0x13C
  local originalXP = readInteger(xpField) or 0

  local ret = executeCodeEx(0, nil, fn, statsPtr, xpDelta)
  local predictedLevel = tonumber(ret or 0)

  -- Critical fix: FUN_140E495F0 mutates statsPtr + 0x13C.
  writeInteger(xpField, originalXP)

  return predictedLevel
end

local function findXPForTargetLevel(eocBase, statsPtr, targetLevel)
  local predictedAtZero = calcLevelNonDestructive(eocBase, statsPtr, 0)

  if predictedAtZero &gt;= targetLevel then
    return 0, nil
  end

  local high = 1

  while high &lt; MAX_SEARCH_XP do
    local predicted = calcLevelNonDestructive(eocBase, statsPtr, high)

    if predicted &gt;= targetLevel then
      break
    end

    high = high * 2
  end

  if high &gt;= MAX_SEARCH_XP and calcLevelNonDestructive(eocBase, statsPtr, high) &lt; targetLevel then
    return nil, "Could not find enough XP within MAX_SEARCH_XP"
  end

  local low = 0

  while low + 1 &lt; high do
    local mid = math.floor((low + high) / 2)
    local predicted = calcLevelNonDestructive(eocBase, statsPtr, mid)

    if predicted &gt;= targetLevel then
      high = mid
    else
      low = mid
    end
  end

  return high, nil
end

local function getPartyMembers(partyObj)
  local memberCount = ri(partyObj + 0x54) or 0
  local memberArray = rq(partyObj + 0x48)

  if memberCount &lt;= 0 or memberCount &gt; 8 or not looksLikePtr(memberArray) then
    return nil, string.format(
      "bad party member data. count=%d array=0x%X",
      memberCount,
      tonumber(memberArray or 0)
    )
  end

  local members = {}

  for i = 0, memberCount - 1 do
    local member = rq(memberArray + i * 8)

    if looksLikePtr(member) then
      local statsPtr = rq(member + 0xC0)

      if looksLikePtr(statsPtr) then
        local currentLevel = ri(statsPtr + 0x08) or 0
        local currentXP = ri(statsPtr + 0x13C) or 0

        if currentLevel &gt; 0 and currentLevel &lt;= 100 then
          table.insert(members, {
            index = i,
            member = member,
            statsPtr = statsPtr,
            currentLevel = currentLevel,
            currentXP = currentXP
          })
        else
          print(string.format(
            "Skipping member[%d]: suspicious level=%d statsPtr=0x%X",
            i,
            currentLevel,
            statsPtr
          ))
        end
      else
        print(string.format(
          "Skipping member[%d]: bad statsPtr from member + 0xC0: 0x%X",
          i,
          tonumber(statsPtr or 0)
        ))
      end
    else
      print(string.format(
        "Skipping member[%d]: bad member pointer: 0x%X",
        i,
        tonumber(member or 0)
      ))
    end
  end

  if #members == 0 then
    return nil, "no valid party members found"
  end

  return members, nil
end

local eocBase = getModuleBaseLocal(PROCESS_NAME)
if not eocBase or eocBase == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

print(string.format("EoCApp base                = 0x%X", eocBase))
print(string.format("CharacterGetHostCharacter  = 0x%X", eocBase + RVA.CharacterGetHostCharacter))
print(string.format("PartyAddActualExperience   = 0x%X", eocBase + RVA.PartyAddActualExperience))
print(string.format("CalcLevelFromXPDelta       = 0x%X", eocBase + RVA.CalcLevelFromXPDelta))

local hostCharRef, hostCharRefBox, hostErr = getHostCharRef(eocBase)
if hostErr then
  print("FAIL: " .. hostErr)
  return
end

local partyObj, resolveErr = resolvePartyObjectFromCharRef(eocBase, hostCharRef)
if not partyObj then
  print("FAIL: " .. tostring(resolveErr))
  return
end

print(string.format("partyObj                   = 0x%X", partyObj))
print(string.format("party actual XP +0x144     = %d", ri(partyObj + 0x144) or -1))

local members, membersErr = getPartyMembers(partyObj)
if not members then
  print("FAIL: " .. tostring(membersErr))
  return
end

print(string.format("valid party members        = %d", #members))

local neededXP = 0

for _, m in ipairs(members) do
  local targetLevel = m.currentLevel + LEVELS_TO_GAIN

  print("")
  print(string.format("member[%d]                 = 0x%X", m.index, m.member))
  print(string.format("statsPtr                   = 0x%X", m.statsPtr))
  print(string.format("currentLevel               = %d", m.currentLevel))
  print(string.format("currentXP stats+0x13C      = %d", m.currentXP))
  print(string.format("targetLevel                = %d", targetLevel))

  local memberNeededXP, xpErr = findXPForTargetLevel(eocBase, m.statsPtr, targetLevel)

  if not memberNeededXP then
    print("FAIL: " .. tostring(xpErr))
    return
  end

  print(string.format("neededXP for this member   = %d", memberNeededXP))

  if memberNeededXP &gt; neededXP then
    neededXP = memberNeededXP
  end
end

print("")
print(string.format("XP to add to party         = %d", neededXP))

if neededXP &lt;= 0 then
  print("No XP needed. Already at or above target level.")
  return
end

local PartyAddActualExperience = eocBase + RVA.PartyAddActualExperience
local xpBox = boxDword(neededXP)

local xpFrame = allocateMemory(0x50)
zeroMemory(xpFrame, 0x50)

writeQword(xpFrame + 0x10, hostCharRefBox)
writeQword(xpFrame + 0x28, xpBox)

local xpRet = executeCodeEx(0, nil, PartyAddActualExperience, 0, xpFrame)

print("")
print(string.format("PartyAddActualExperience ret=0x%X XP=%d", tonumber(xpRet or 0), neededXP))
print("Check party level-up.")

[DISABLE]
{$asm}
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>50002</ID>
      <Description>"Resurrect All Party Members"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
-- DOS EE: Resurrect dead party members
-- Uses CharacterResurrect Osiris handler:
--   CharacterResurrect = EoCApp.exe + 0xCF3320
--
-- This builds a minimal CHARACTER ref wrapper for each party member:
--   fakeCharRef + 0x10 = party member object

local PROCESS_NAME = "EoCApp.exe"

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  CharacterResurrect        = 0xCF3320,
  CharacterManager          = 0x134EAF0
}

local function getModuleBaseLocal(moduleName)
  local base = getAddressSafe(moduleName)
  if base and base ~= 0 then return base end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then
      return module.Address
    end
  end

  return nil
end

local function zeroMemory(addr, size)
  for i = 0, size - 1 do
    writeBytes(addr + i, 0)
  end
end

local function boxQword(value)
  local ptr = allocateMemory(8)
  writeQword(ptr, value or 0)
  return ptr
end

local function looksLikePtr(p)
  return p ~= nil and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function rq(addr)
  if not looksLikePtr(addr) then return nil end
  local ok, v = pcall(readQword, addr)
  if ok then return v end
  return nil
end

local function ri(addr)
  if not looksLikePtr(addr) then return nil end
  local ok, v = pcall(readInteger, addr)
  if ok then return v end
  return nil
end

local function getHostCharRef(eocBase)
  local CharacterGetHostCharacter = eocBase + RVA.CharacterGetHostCharacter

  local hostCharRefBox = boxQword(0)
  local hostFrame = allocateMemory(0x40)

  zeroMemory(hostFrame, 0x40)
  writeQword(hostFrame + 0x10, hostCharRefBox)

  local hostRet = executeCodeEx(0, nil, CharacterGetHostCharacter, 0, hostFrame)
  local hostCharRef = readQword(hostCharRefBox) or 0

  print(string.format("Host ret=0x%X hostCharRef=0x%X", tonumber(hostRet or 0), hostCharRef))

  if hostCharRef == 0 then
    return nil, "CharacterGetHostCharacter returned 0"
  end

  return hostCharRef, nil
end

local function resolvePartyObjectFromCharRef(eocBase, charRef)
  local handleSource = rq(charRef + 0x10)
  if not looksLikePtr(handleSource) then
    return nil, "charRef + 0x10 was null/bad"
  end

  local handle = ri(handleSource + 0x220)
  if not handle or handle == 0 then
    return nil, "handle at handleSource + 0x220 was null"
  end

  local mgr = rq(eocBase + RVA.CharacterManager)
  if not looksLikePtr(mgr) then
    return nil, "character manager was null/bad"
  end

  local low = handle &amp; 0xFFFF
  local salt = (handle &gt;&gt; 16) &amp; 0x3FF

  local maxObjects = ri(mgr + 0x24)
  if not maxObjects or low &gt;= maxObjects then
    return nil, string.format("handle low index out of range: handle=0x%X", handle)
  end

  local objects = rq(mgr + 0x18)
  local salts = rq(mgr + 0x40)

  if not looksLikePtr(objects) or not looksLikePtr(salts) then
    return nil, "character manager arrays were null/bad"
  end

  local expectedSalt = readSmallInteger(salts + low * 2)

  if expectedSalt ~= salt then
    return nil, string.format(
      "handle salt mismatch: handle=0x%X expectedSalt=0x%X salt=0x%X",
      handle,
      tonumber(expectedSalt or 0),
      salt
    )
  end

  local partyObj = rq(objects + low * 8)
  if not looksLikePtr(partyObj) then
    return nil, "resolved party object was null/bad"
  end

  return partyObj, nil
end

local function getPartyMembers(partyObj)
  local memberCount = ri(partyObj + 0x54) or 0
  local memberArray = rq(partyObj + 0x48)

  if memberCount &lt;= 0 or memberCount &gt; 8 or not looksLikePtr(memberArray) then
    return nil, string.format(
      "bad party member data. count=%d array=0x%X",
      memberCount,
      tonumber(memberArray or 0)
    )
  end

  local members = {}

  for i = 0, memberCount - 1 do
    local member = rq(memberArray + i * 8)

    if looksLikePtr(member) then
      table.insert(members, {
        index = i,
        member = member
      })
    else
      print(string.format(
        "Skipping member[%d]: bad pointer 0x%X",
        i,
        tonumber(member or 0)
      ))
    end
  end

  if #members == 0 then
    return nil, "no valid party members found"
  end

  return members, nil
end

local function makeFakeCharacterRef(memberObj)
  local fakeRef = allocateMemory(0x20)
  zeroMemory(fakeRef, 0x20)

  -- CharacterResurrect handler only needs:
  --   lVar5 = **(frame + 0x10)
  --   plVar1 = *(lVar5 + 0x10)
  writeQword(fakeRef + 0x10, memberObj)

  return fakeRef
end

local function callCharacterResurrect(eocBase, memberObj)
  local CharacterResurrect = eocBase + RVA.CharacterResurrect

  local fakeRef = makeFakeCharacterRef(memberObj)
  local fakeRefBox = boxQword(fakeRef)

  local frame = allocateMemory(0x40)
  zeroMemory(frame, 0x40)

  writeQword(frame + 0x10, fakeRefBox)

  local ret = executeCodeEx(0, nil, CharacterResurrect, 0, frame)
  return tonumber(ret or 0)
end

local eocBase = getModuleBaseLocal(PROCESS_NAME)
if not eocBase or eocBase == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

print(string.format("EoCApp base                = 0x%X", eocBase))
print(string.format("CharacterGetHostCharacter  = 0x%X", eocBase + RVA.CharacterGetHostCharacter))
print(string.format("CharacterResurrect         = 0x%X", eocBase + RVA.CharacterResurrect))

local hostCharRef, hostErr = getHostCharRef(eocBase)
if hostErr then
  print("FAIL: " .. hostErr)
  return
end

local partyObj, resolveErr = resolvePartyObjectFromCharRef(eocBase, hostCharRef)
if not partyObj then
  print("FAIL: " .. tostring(resolveErr))
  return
end

print(string.format("partyObj                   = 0x%X", partyObj))

local members, membersErr = getPartyMembers(partyObj)
if not members then
  print("FAIL: " .. tostring(membersErr))
  return
end

print(string.format("party members              = %d", #members))
print("")

for _, m in ipairs(members) do
  print(string.format("Trying resurrect member[%d] = 0x%X", m.index, m.member))

  local ret = callCharacterResurrect(eocBase, m.member)

  print(string.format("  CharacterResurrect ret=0x%X", ret))
end

print("")
print("Done. Check dead party members.")

