      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
-- DOS EE: Spawn character/NPC by template UUID
-- Modes:
--   "companion" = spawn near host, add to character, make companion/party member
--   "npc"       = spawn near host, non-hostile NPC, NOT added to party
--
-- Default is companion mode.

local PROCESS_NAME = "EoCApp.exe"

local TEMPLATE_UUID = "041af1cc-2f0f-446a-ae1e-48cc75189a7b"

local SPAWN_MODE = "companion" -- "companion" or "npc"

local NPC_FACTION = "Good NPC"
local RELATION_VALUE = 0

local SPAWN_OFFSET_X = 1.5
local SPAWN_OFFSET_Z = 1.5
local MAKE_COMPANION_PARAM4 = 0

local ENABLE_TEMPLATE_CLASS_SAFETY = true
local KNOWN_CHARACTER_TEMPLATE_UUID = "041af1cc-2f0f-446a-ae1e-48cc75189a7b"

local CLEAR_COMBAT_BIT = true
local SET_OBJECT_FLAG_0x4000000 = true

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  CharacterAddToCharacter   = 0xCF11C0,
  CharacterSetFaction       = 0xCF1040,
  CharacterMakeCompanion    = 0xCF1450,

  InternString              = 0x71FF00,
  C9DA00                    = 0xC9DA00,
  AllocReq                  = 0x28D8D0,
  C84C20                    = 0xC84C20,

  BAB860                    = 0xBAB860,
  BA5CF0                    = 0xBA5CF0,
  BFEE90                    = 0xBFEE90,

  TemplateMap               = 0x134E7A0,
  RelMgr                    = 0x134EAD8,
  CharMgr                   = 0x134EB68,
  LevelMap                  = 0x134EB70,
  SpawnSys                  = 0x134EB10,
  DefaultHandle             = 0x12ECBD8
}

local function getModuleBaseLocal(moduleName)
  local b = getAddressSafe(moduleName)
  if b and b ~= 0 then return b end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then return module.Address end
  end

  return nil
end

local base = getModuleBaseLocal(PROCESS_NAME)
if not base or base == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

local function alloc(size)
  local p = allocateMemory(size)
  if not p then error("allocateMemory failed") end
  return p
end

local function zeroMemory(addr, size)
  for i = 0, size - 1 do writeBytes(addr + i, 0) end
end

local function isptr(p)
  return p and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function fmt(v)
  if v == nil then return "nil" end
  return string.format("0x%X", v)
end

local function rq(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readQword, a)
  if ok then return v end
end

local function ri(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readInteger, a)
  if ok then return v end
end

local function rw(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readSmallInteger, a)
  if ok then return v end
end

local function rb(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readBytes, a, 1, false)
  if ok then return v end
end

local function rf(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readFloat, a)
  if ok then return v end
end

local function boxQword(value)
  local p = alloc(8)
  writeQword(p, value or 0)
  return p
end

local function makeCString(s)
  local p = alloc(#s + 1)
  writeString(p, s)
  writeBytes(p + #s, 0)
  return p
end

local function makeFakeRef(obj)
  local ref = alloc(0x20)
  zeroMemory(ref, 0x20)
  writeQword(ref + 0x10, obj)
  return ref
end

local function internString(s)
  local mem = makeCString(s)
  return executeCodeEx(0, nil, base + RVA.InternString, mem, -1)
end

local function resolveHandle(managerRva, handle)
  if not handle or handle == 0 then return nil end

  local mgr = rq(base + managerRva)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil
  local genTable = isptr(mgr) and rq(mgr + 0x40) or nil

  if not isptr(objTable) or not isptr(genTable) or not count then return nil end

  local idx = handle &amp; 0xFFFF
  local gen = (handle &gt;&gt; 16) &amp; 0x3FF

  if idx &gt;= count then return nil end
  if rw(genTable + idx * 2) ~= gen then return nil end

  return rq(objTable + idx * 8)
end

local function handleToCharObj(handle)
  return resolveHandle(RVA.CharMgr, handle)
end

local function charObjToHandle(obj)
  if not isptr(obj) then return nil end

  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil
  local genTable = isptr(mgr) and rq(mgr + 0x40) or nil

  if not isptr(objTable) or not isptr(genTable) or not count then return nil end

  for i = 0, count - 1 do
    if rq(objTable + i * 8) == obj then
      local gen = rw(genTable + i * 2)
      if gen then
        return 0x64000000 | ((gen &amp; 0x3FF) &lt;&lt; 16) | i, i
      end
    end
  end

  return nil
end

local function getObjPosition(obj)
  local vt = rq(obj)
  local fnGetPos = isptr(vt) and rq(vt + 0x90) or nil
  if not isptr(fnGetPos) then return nil, nil, nil end

  local posPtr = executeCodeEx(0, nil, fnGetPos, obj)
  if not isptr(posPtr) then return nil, nil, nil end

  return rf(posPtr), rf(posPtr + 4), rf(posPtr + 8)
end

local function getHostPlayer()
  local outBox = boxQword(0)

  local frame = alloc(0x40)
  zeroMemory(frame, 0x40)
  writeQword(frame + 0x10, outBox)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetHostCharacter, 0, frame)
  local hostRef = readQword(outBox) or 0
  local playerObj = rq(hostRef + 0x10)
  local playerHandle = charObjToHandle(playerObj)

  if not isptr(playerObj) then error("host player object invalid") end

  print("host player obj    = " .. fmt(playerObj))
  print("host player handle = " .. tostring(playerHandle) .. " / " .. fmt(playerHandle))
  print("CharacterGetHostCharacter ret = " .. fmt(ret))

  return playerObj, playerHandle
end

local function resolveTemplateObj(uuid)
  local map = rq(base + RVA.TemplateMap)
  local bucketCount = isptr(map) and ri(map + 0x28) or nil
  local buckets = isptr(map) and rq(map + 0x30) or nil

  if not isptr(map) or not bucketCount or bucketCount == 0 or not isptr(buckets) then
    return nil, "bad template map"
  end

  local key = internString(uuid)
  if not isptr(key) then return nil, "intern failed" end

  local node = rq(buckets + (key % bucketCount) * 8)
  local hops = 0

  while isptr(node) and hops &lt; 1000 do
    local nextNode = rq(node + 0x00)
    local nodeKey = rq(node + 0x08)
    local templateObj = rq(node + 0x10)

    if nodeKey == key then
      return templateObj, nil
    end

    node = nextNode
    hops = hops + 1
  end

  return nil, "template UUID not found"
end

local function assertCharacterTemplate(candidateUuid)
  local candidateObj, candidateErr = resolveTemplateObj(candidateUuid)

  print("")
  print("=== TEMPLATE CHECK ===")
  print("candidate uuid = " .. candidateUuid)
  print("candidate obj  = " .. fmt(candidateObj))
  print("candidate err  = " .. tostring(candidateErr))

  if not isptr(candidateObj) then
    error("candidate template did not resolve: " .. tostring(candidateErr))
  end

  if not ENABLE_TEMPLATE_CLASS_SAFETY then
    return candidateObj
  end

  local knownObj, knownErr = resolveTemplateObj(KNOWN_CHARACTER_TEMPLATE_UUID)

  print("known char obj = " .. fmt(knownObj))
  print("known char err = " .. tostring(knownErr))

  if not isptr(knownObj) then
    error("known character template did not resolve: " .. tostring(knownErr))
  end

  local candidateVtable = rq(candidateObj)
  local knownVtable = rq(knownObj)

  print("candidate vtable = " .. fmt(candidateVtable))
  print("known vtable     = " .. fmt(knownVtable))
  print("candidate +0x6C  = " .. tostring(rb(candidateObj + 0x6C)) .. " / " .. fmt(rb(candidateObj + 0x6C)))

  if candidateVtable ~= knownVtable then
    error("REFUSING TO SPAWN: UUID does not look like a character/NPC template.")
  end

  return candidateObj
end

local function findRealCreateContext()
  local charMgr = rq(base + RVA.CharMgr)
  local levelMap = rq(base + RVA.LevelMap)
  if not isptr(levelMap) then return nil, nil end

  local bucketCount = ri(levelMap + 0x18)
  local buckets = rq(levelMap + 0x20)
  if not bucketCount or bucketCount == 0 or not isptr(buckets) then return nil, nil end

  for b = 0, bucketCount - 1 do
    local node = rq(buckets + b * 8)
    local hops = 0

    while isptr(node) and hops &lt; 200 do
      local key = rq(node + 0x08)
      local levelObj = rq(node + 0x10)

      if isptr(levelObj) then
        local ctx90 = rq(levelObj + 0x90)
        if isptr(ctx90) and rq(ctx90 + 0x08) == charMgr then
          return ctx90, key
        end
      end

      node = rq(node + 0x00)
      hops = hops + 1
    end
  end

  return nil, nil
end

local function callCharacterSetFaction(charObj, factionName)
  local factionStr = makeCString(factionName)

  local frame = alloc(0x60)
  zeroMemory(frame, 0x60)

  writeQword(frame + 0x10, boxQword(makeFakeRef(charObj)))
  writeQword(frame + 0x28, boxQword(factionStr))

  return executeCodeEx(0, nil, base + RVA.CharacterSetFaction, 0, frame)
end

local function makeFactionKeyMem(name)
  local key = internString(name)
  local mem = alloc(8)
  writeQword(mem, key or 0)
  return mem
end

local function getIndivFactionPtr(charObj)
  if not isptr(charObj) then return nil end

  local ok = executeCodeEx(0, nil, base + RVA.BAB860, charObj, 0)
  if not ok or ok == 0 then return nil end

  local relObj = executeCodeEx(0, nil, base + RVA.BA5CF0, charObj)
  if not isptr(relObj) then return nil end

  return relObj + 0x20
end

local function setRelationMemToMem(leftMem, rightMem, relation)
  local relMgr = rq(base + RVA.RelMgr)
  if not isptr(relMgr) or not isptr(leftMem) or not isptr(rightMem) then return nil end

  return executeCodeEx(0, nil, base + RVA.BFEE90, relMgr, leftMem, rightMem, relation, 1)
end

local function setIndivToFaction(charObj, factionName, relation)
  return setRelationMemToMem(getIndivFactionPtr(charObj), makeFactionKeyMem(factionName), relation)
end

local function setFactionToIndiv(factionName, charObj, relation)
  return setRelationMemToMem(makeFactionKeyMem(factionName), getIndivFactionPtr(charObj), relation)
end

local function setFactionToFaction(leftFaction, rightFaction, relation)
  return setRelationMemToMem(makeFactionKeyMem(leftFaction), makeFactionKeyMem(rightFaction), relation)
end

local function makeNpcNonHostile(charObj)
  callCharacterSetFaction(charObj, NPC_FACTION)

  setIndivToFaction(charObj, "Hero", RELATION_VALUE)
  setFactionToIndiv("Hero", charObj, RELATION_VALUE)

  setIndivToFaction(charObj, "Companion", RELATION_VALUE)
  setFactionToIndiv("Companion", charObj, RELATION_VALUE)

  setFactionToFaction(NPC_FACTION, "Hero", RELATION_VALUE)
  setFactionToFaction("Hero", NPC_FACTION, RELATION_VALUE)

  setFactionToFaction(NPC_FACTION, "Companion", RELATION_VALUE)
  setFactionToFaction("Companion", NPC_FACTION, RELATION_VALUE)
end

local function setObjectFlag(charObj)
  if not SET_OBJECT_FLAG_0x4000000 then return end

  local vt = rq(charObj)
  local fnSetFlag = isptr(vt) and rq(vt + 0x78) or nil

  if isptr(fnSetFlag) then
    executeCodeEx(0, nil, fnSetFlag, charObj, 0x4000000)
  end
end

local function clearCombatBit(charObj)
  if not CLEAR_COMBAT_BIT then return end

  local b = rb(charObj + 0x90)
  if b then
    writeBytes(charObj + 0x90, b &amp; 0xEF)
  end
end

local function spawnCharacterNearPlayer(playerObj)
  local templateObj = assertCharacterTemplate(TEMPLATE_UUID)

  local px, py, pz = getObjPosition(playerObj)
  if not px or not py or not pz then error("player position invalid") end

  local createCtx, levelKey = findRealCreateContext()
  if not isptr(createCtx) or not isptr(levelKey) then error("create context invalid") end

  local handleMem = alloc(8)
  writeInteger(handleMem, ri(base + RVA.DefaultHandle) or 0)

  print("")
  print("=== CREATE CHARACTER ===")
  print("createCtx = " .. fmt(createCtx))
  print("levelKey  = " .. fmt(levelKey))
  print("template  = " .. fmt(templateObj))

  local ret = executeCodeEx(0, nil, base + RVA.C9DA00, createCtx, templateObj, handleMem, levelKey)

  local handleMemAfter = ri(handleMem)
  local newObj = ret
  local newHandle = charObjToHandle(newObj)

  if not isptr(newObj) and handleMemAfter and handleMemAfter ~= 0 then
    newObj = handleToCharObj(handleMemAfter)
    newHandle = handleMemAfter
  end

  if not isptr(newObj) or not newHandle then error("character creation failed") end

  setObjectFlag(newObj)

  local spawnCtx = rq(newObj + 0x100)
  local spawnSys = rq(base + RVA.SpawnSys)
  if not isptr(spawnCtx) or not isptr(spawnSys) then error("spawn context invalid") end

  local req = executeCodeEx(0, nil, base + RVA.AllocReq, spawnSys + 0x2D8)
  if not isptr(req) then error("spawn request allocation failed") end

  writeInteger(req + 0x08, newHandle)
  writeFloat(req + 0x1C, px + SPAWN_OFFSET_X)
  writeFloat(req + 0x20, py)
  writeFloat(req + 0x24, pz + SPAWN_OFFSET_Z)
  writeInteger(req + 0x28, 0)
  writeBytes(req + 0x30, 1)

  executeCodeEx(0, nil, base + RVA.C84C20, spawnCtx, req, 0)

  print("spawned obj    = " .. fmt(newObj))
  print("spawned handle = " .. tostring(newHandle) .. " / " .. fmt(newHandle))

  return newObj, newHandle
end

local function callCharacterAddToCharacter(childObj, ownerObj)
  local frame = alloc(0x80)
  zeroMemory(frame, 0x80)

  writeQword(frame + 0x10, boxQword(makeFakeRef(childObj)))
  writeQword(frame + 0x28, boxQword(makeFakeRef(ownerObj)))

  return executeCodeEx(0, nil, base + RVA.CharacterAddToCharacter, 0, frame)
end

local function callCharacterMakeCompanion(newObj, playerObj)
  local frame = alloc(0x80)
  zeroMemory(frame, 0x80)

  writeQword(frame + 0x10, boxQword(makeFakeRef(newObj)))
  writeQword(frame + 0x28, boxQword(makeFakeRef(playerObj)))

  return executeCodeEx(0, nil, base + RVA.CharacterMakeCompanion, 0, frame, 0, MAKE_COMPANION_PARAM4)
end

local function dumpFinal(playerObj, npcObj, npcHandle)
  print("")
  print("=== FINAL ===")
  print("mode      = " .. SPAWN_MODE)
  print("playerObj = " .. fmt(playerObj))
  print("npcObj    = " .. fmt(npcObj))
  print("npcHandle = " .. tostring(npcHandle) .. " / " .. fmt(npcHandle))
  print("npc +0x90 = " .. tostring(rb(npcObj + 0x90)) .. " / " .. fmt(rb(npcObj + 0x90)))
  print("npc +0x178= " .. fmt(rq(npcObj + 0x178)))
  print("npc +0x180= " .. fmt(rq(npcObj + 0x180)))
  print("npc +0x220= " .. tostring(ri(npcObj + 0x220)) .. " / " .. fmt(ri(npcObj + 0x220)))
end

local function main()
  print("=== SPAWN CHARACTER BY UUID: NPC OR COMPANION MODE ===")
  print("base          = " .. fmt(base))
  print("TEMPLATE_UUID = " .. TEMPLATE_UUID)
  print("SPAWN_MODE    = " .. SPAWN_MODE)

  if SPAWN_MODE ~= "companion" and SPAWN_MODE ~= "npc" then
    error("SPAWN_MODE must be \"companion\" or \"npc\"")
  end

  local playerObj = getHostPlayer()
  local npcObj, npcHandle = spawnCharacterNearPlayer(playerObj)

  makeNpcNonHostile(npcObj)
  clearCombatBit(playerObj)
  clearCombatBit(npcObj)

  if SPAWN_MODE == "companion" then
    print("")
    print("=== COMPANION MODE ===")

    local addRet = callCharacterAddToCharacter(npcObj, playerObj)
    print("CharacterAddToCharacter ret = " .. fmt(addRet))

    makeNpcNonHostile(npcObj)

    local compRet = callCharacterMakeCompanion(npcObj, playerObj)
    print("CharacterMakeCompanion ret = " .. fmt(compRet))

    makeNpcNonHostile(npcObj)
    clearCombatBit(playerObj)
    clearCombatBit(npcObj)
  else
    print("")
    print("=== NPC MODE ===")
    print("Not calling CharacterAddToCharacter.")
    print("Not calling CharacterMakeCompanion.")
    print("If this NPC starts/locks combat, reload or rerun in companion mode.")
  end

  dumpFinal(playerObj, npcObj, npcHandle)

  print("")
  print("DONE")
end

main()

[DISABLE]
{$asm}</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>50004</ID>
      <Description>"Lockpick Skill 99"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
-- DOS EE: Test LockPicking ability key variants, then raise the working one
-- No scanners.

local PROCESS_NAME = "EoCApp.exe"

local TARGET_VALUE = 99

local ABILITY_CANDIDATES = {
  "LockPicking",
  "Lockpicking",
  "lockpicking",
  "Ability_Lockpicking",
  "Character_LockPicking",
}

local CHARACTER_ADD_ABILITY_RVA = 0xCE8EC0
local CHARACTER_GET_ABILITY_RVA = 0xCE8F90

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  CharMgr                   = 0x134EB68,
}

local function getModuleBaseLocal(moduleName)
  local b = getAddressSafe(moduleName)
  if b and b ~= 0 then return b end
  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then return module.Address end
  end
  return nil
end

local base = getModuleBaseLocal(PROCESS_NAME)
if not base or base == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

local function alloc(size)
  local p = allocateMemory(size)
  if not p then error("allocateMemory failed") end
  return p
end

local function zeroMemory(addr, size)
  for i = 0, size - 1 do writeBytes(addr + i, 0) end
end

local function isptr(p)
  return p and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function fmt(v)
  if v == nil then return "nil" end
  return string.format("0x%X", v)
end

local function rq(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readQword, a)
  if ok then return v end
end

local function ri(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readInteger, a)
  if ok then return v end
end

local function rw(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readSmallInteger, a)
  if ok then return v end
end

local function boxQword(v)
  local p = alloc(8)
  writeQword(p, v or 0)
  return p
end

local function boxDword(v)
  local p = alloc(4)
  writeInteger(p, v or 0)
  return p
end

local function makeCString(s)
  local p = alloc(#s + 1)
  writeString(p, s)
  writeBytes(p + #s, 0)
  return p
end

local function makeFakeRef(obj)
  local ref = alloc(0x20)
  zeroMemory(ref, 0x20)
  writeQword(ref + 0x10, obj)
  return ref
end

local function charObjToHandle(obj)
  if not isptr(obj) then return nil end

  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil
  local genTable = isptr(mgr) and rq(mgr + 0x40) or nil

  if not isptr(objTable) or not isptr(genTable) or not count then return nil end

  for i = 0, count - 1 do
    if rq(objTable + i * 8) == obj then
      local gen = rw(genTable + i * 2)
      if gen then
        return 0x64000000 | ((gen &amp; 0x3FF) &lt;&lt; 16) | i, i
      end
    end
  end

  return nil
end

local function getHostPlayer()
  local outBox = boxQword(0)

  local frame = alloc(0x40)
  zeroMemory(frame, 0x40)
  writeQword(frame + 0x10, outBox)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetHostCharacter, 0, frame)
  local hostRef = readQword(outBox) or 0
  local playerObj = rq(hostRef + 0x10)
  local playerHandle = charObjToHandle(playerObj)

  print("CharacterGetHostCharacter ret = " .. fmt(ret))
  print("hostRef      = " .. fmt(hostRef))
  print("playerObj    = " .. fmt(playerObj))
  print("playerHandle = " .. tostring(playerHandle) .. " / " .. fmt(playerHandle))

  if not isptr(playerObj) then error("host player object invalid") end

  return playerObj
end

local function callCharacterGetAbility(charObj, ability)
  local handlerAddr = base + CHARACTER_GET_ABILITY_RVA
  local outValue = boxDword(0)
  local abilityMem = makeCString(ability)

  local frame = alloc(0x80)
  zeroMemory(frame, 0x80)

  writeQword(frame + 0x10, boxQword(makeFakeRef(charObj)))
  writeQword(frame + 0x28, boxQword(abilityMem))
  writeQword(frame + 0x40, outValue)

  local ret = executeCodeEx(0, nil, handlerAddr, 0, frame)
  local value = readInteger(outValue) or 0

  return value, ret
end

local function callCharacterAddAbility(charObj, ability, amount)
  local handlerAddr = base + CHARACTER_ADD_ABILITY_RVA
  local abilityMem = makeCString(ability)
  local amountBox = boxDword(amount)

  local frame = alloc(0x80)
  zeroMemory(frame, 0x80)

  writeQword(frame + 0x10, boxQword(makeFakeRef(charObj)))
  writeQword(frame + 0x28, boxQword(abilityMem))
  writeQword(frame + 0x40, amountBox)

  local ret = executeCodeEx(0, nil, handlerAddr, 0, frame)
  return ret
end

local function main()
  print("=== LOCKPICKING ABILITY KEY TEST ===")
  print("base       = " .. fmt(base))
  print("GetAbility = " .. fmt(base + CHARACTER_GET_ABILITY_RVA))
  print("AddAbility = " .. fmt(base + CHARACTER_ADD_ABILITY_RVA))

  local playerObj = getHostPlayer()

  for _, ability in ipairs(ABILITY_CANDIDATES) do
    print("")
    print("=== TEST: " .. ability .. " ===")

    local before, getRet1 = callCharacterGetAbility(playerObj, ability)
    print("before get ret = " .. fmt(getRet1) .. " value=" .. tostring(before))

    local addRet = callCharacterAddAbility(playerObj, ability, 1)
    print("add +1 ret     = " .. fmt(addRet))

    local after, getRet2 = callCharacterGetAbility(playerObj, ability)
    print("after get ret  = " .. fmt(getRet2) .. " value=" .. tostring(after))

    if after &gt; before then
      print("")
      print("FOUND WORKING KEY: " .. ability)

      local delta = TARGET_VALUE - after
      print("adding delta to target: " .. tostring(delta))

      if delta ~= 0 then
        callCharacterAddAbility(playerObj, ability, delta)
      end

      local final = callCharacterGetAbility(playerObj, ability)
      print("final value = " .. tostring(final))
      print("DONE")
      return
    end
  end

  print("")
  print("No candidate changed. Next needed: decompile FUN_140ce8ec0 and FUN_140ce8f90.")
end

main()

