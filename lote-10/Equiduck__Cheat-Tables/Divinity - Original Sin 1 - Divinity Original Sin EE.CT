    <CheatEntry>
      <ID>2803</ID>
      <Description>"Unlimited Actions"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(actions,EoCApp.exe,8B 98 * * * * 3B DE)
