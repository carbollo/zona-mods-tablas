      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
-- DOS EE: Set attributes + abilities + reputation to target values
--
-- Sets primary attributes:
--   Strength, Dexterity, Intelligence, Constitution, Speed, Perception
--
-- Sets abilities:
--   Bow, Scoundrel/RogueLore, Lockpicking, Pickpocket, Crafting, Loremaster, etc.
--
-- Default target = host player.

local PROCESS_NAME = "EoCApp.exe"

local ATTRIBUTE_TARGET_VALUE = 99
local ABILITY_TARGET_VALUE = 99
local APPLY_TO_OWNED_PARTY = false

-- nil = host player
-- or set exact character object pointer
local TARGET_CHARACTER_OBJ = nil
-- local TARGET_CHARACTER_OBJ = 0x0000000000000000

local RVA = {
  CharacterGetHostCharacter = 0xCF00D0,
  CharacterGetOwner         = 0xCE8D20,

  CharacterAddAbility       = 0xCE8EC0,
  CharacterGetAbility       = 0xCE8F90,

  CharacterAddAttribute     = 0xCE9060,
  CharacterGetAttribute     = 0xCE90B0,

  CharMgr                   = 0x134EB68,
}

local ATTRIBUTES = {
  "Strength",
  "Dexterity",
  "Intelligence",
  "Constitution",
  "Speed",
  "Perception",
}

local ABILITIES = {
  -- Weapons
  "SingleHanded",
  "TwoHanded",
  "Bow",
  "Crossbow",
  "DualWielding",
  "Wand",
  "Blackrock",       -- Tenebrium

  -- Defense
  "Shield",          -- Shield Specialist
  "ArmorMastery",    -- Armour Specialist
  "BodyBuilding",
  "Willpower",
  "Reflexes",

  -- Skill schools
  "WarriorLore",     -- Man-at-Arms
  "RangerLore",      -- Expert Marksman
  "RogueLore",       -- Scoundrel
  "FireSpecialist",  -- Pyrokinetic
  "WaterSpecialist", -- Hydrosophist
  "AirSpecialist",   -- Aerotheurge
  "EarthSpecialist", -- Geomancer
  "Sourcery",        -- Witchcraft / Source-like internal field

  -- Personality
  "Charisma",
  "Charm",
  "Intimidate",
  "Leadership",
  "Reason",
  "Barter",
  "Luck",            -- Lucky Charm

  -- Craft / utility
  "Blacksmithing",
  "Crafting",
  "Loremaster",
  "Telekinesis",
  "Lockpicking",
  "Pickpocket",
  "Sneaking",
}

local function getModuleBaseLocal(moduleName)
  local b = getAddressSafe(moduleName)
  if b and b ~= 0 then return b end

  for _, module in ipairs(enumModules()) do
    if module.Name == moduleName then return module.Address end
  end

  return nil
end

local base = getModuleBaseLocal(PROCESS_NAME)
if not base or base == 0 then
  print("FAIL: EoCApp.exe not found")
  return
end

local function isptr(p)
  return p and p &gt; 0x100000000 and p &lt; 0x0000800000000000
end

local function fmt(v)
  if v == nil then return "nil" end
  return string.format("0x%X", v)
end

local function rq(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readQword, a)
  if ok then return v end
end

local function ri(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readInteger, a)
  if ok then return v end
end

local function rw(a)
  if not isptr(a) then return nil end
  local ok, v = pcall(readSmallInteger, a)
  if ok then return v end
end

local scratch = allocateMemory(0x10000)
if not scratch then
  print("FAIL: allocateMemory failed")
  return
end

local off = 0

local function resetScratch()
  off = 0
  for i = 0, 0xFFFF do
    writeBytes(scratch + i, 0)
  end
end

local function alloc(size)
  local aligned = math.floor((size + 15) / 16) * 16

  if off + aligned &gt;= 0x10000 then
    error("scratch exhausted")
  end

  local p = scratch + off
  off = off + aligned
  return p
end

local function boxQword(v)
  local p = alloc(8)
  writeQword(p, v or 0)
  return p
end

local function boxDword(v)
  local p = alloc(8)
  writeInteger(p, v or 0)
  return p
end

local function makeCString(s)
  local p = alloc(#s + 1)
  writeString(p, s)
  writeBytes(p + #s, 0)
  return p
end

local function makeFakeRef(obj)
  local ref = alloc(0x20)
  writeQword(ref + 0x10, obj)
  return ref
end

local function makeRefBox(obj)
  return boxQword(makeFakeRef(obj))
end

local function charObjToHandle(obj)
  if not isptr(obj) then return nil end

  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil
  local genTable = isptr(mgr) and rq(mgr + 0x40) or nil

  if not isptr(objTable) or not isptr(genTable) or not count then return nil end

  for i = 0, count - 1 do
    if rq(objTable + i * 8) == obj then
      local gen = rw(genTable + i * 2)

      if gen then
        return 0x64000000 | ((gen &amp; 0x3FF) &lt;&lt; 16) | i
      end
    end
  end

  return nil
end

local function getHostPlayer()
  resetScratch()

  local outBox = boxQword(0)
  local frame = alloc(0x40)

  writeQword(frame + 0x10, outBox)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetHostCharacter, 0, frame)
  local hostRef = readQword(outBox) or 0
  local hostObj = rq(hostRef + 0x10)

  print("CharacterGetHostCharacter ret = " .. fmt(ret))
  print("hostRef    = " .. fmt(hostRef))
  print("hostObj    = " .. fmt(hostObj))
  print("hostHandle = " .. tostring(charObjToHandle(hostObj)) .. " / " .. fmt(charObjToHandle(hostObj)))

  if not isptr(hostObj) then
    error("host player object invalid")
  end

  return hostObj
end

local function getOwnerObj(charObj)
  resetScratch()

  local outOwner = boxQword(0)
  local frame = alloc(0x60)

  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, outOwner)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetOwner, 0, frame)
  local ownerRef = readQword(outOwner) or 0
  local ownerObj = rq(ownerRef + 0x10)

  return ownerObj, ret
end

local function getOwnedParty(hostObj)
  local mgr = rq(base + RVA.CharMgr)
  local objTable = isptr(mgr) and rq(mgr + 0x18) or nil
  local count = isptr(mgr) and ri(mgr + 0x24) or nil

  if not isptr(objTable) or not count then
    return {}
  end

  local result = {}

  for i = 0, count - 1 do
    local obj = rq(objTable + i * 8)

    if isptr(obj) and obj ~= hostObj then
      local ownerObj = getOwnerObj(obj)

      if ownerObj == hostObj then
        table.insert(result, obj)
      end
    end
  end

  return result
end

local function callGetAttribute(charObj, attribute)
  resetScratch()

  local frame = alloc(0x80)
  local attrCString = makeCString(attribute)
  local outAmount = boxDword(0)

  -- CharacterGetAttribute(Character, Attribute, AmountOut)
  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxQword(attrCString))
  writeQword(frame + 0x40, outAmount)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetAttribute, 0, frame)
  local amount = readInteger(outAmount) or 0

  return amount, ret
end

local function callAddAttribute(charObj, attribute, amount)
  resetScratch()

  local frame = alloc(0x80)
  local attrCString = makeCString(attribute)

  -- CharacterAddAttribute(Character, Attribute, Value)
  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxQword(attrCString))
  writeQword(frame + 0x40, boxDword(amount))

  local ret = executeCodeEx(0, nil, base + RVA.CharacterAddAttribute, 0, frame)

  return ret
end

local function callGetAbility(charObj, ability)
  resetScratch()

  local frame = alloc(0x80)
  local abilityCString = makeCString(ability)
  local outAmount = boxDword(0)

  -- CharacterGetAbility(Character, Ability, AmountOut)
  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxQword(abilityCString))
  writeQword(frame + 0x40, outAmount)

  local ret = executeCodeEx(0, nil, base + RVA.CharacterGetAbility, 0, frame)
  local amount = readInteger(outAmount) or 0

  return amount, ret
end

local function callAddAbility(charObj, ability, amount)
  resetScratch()

  local frame = alloc(0x80)
  local abilityCString = makeCString(ability)

  -- CharacterAddAbility(Character, Ability, Amount)
  writeQword(frame + 0x10, makeRefBox(charObj))
  writeQword(frame + 0x28, boxQword(abilityCString))
  writeQword(frame + 0x40, boxDword(amount))

  local ret = executeCodeEx(0, nil, base + RVA.CharacterAddAbility, 0, frame)

  return ret
end

local function setAttributeTo(charObj, attribute, target)
  local before, getRet1 = callGetAttribute(charObj, attribute)

  if getRet1 ~= 1 then
    print(string.format("%-18s INVALID before=%s getRet=%s", attribute, tostring(before), fmt(getRet1)))
    return false
  end

  local delta = target - before
  local addRet = nil

  if delta ~= 0 then
    addRet = callAddAttribute(charObj, attribute, delta)
  end

  local after, getRet2 = callGetAttribute(charObj, attribute)

  print(string.format(
    "%-18s before=%s delta=%s after=%s getRet=%s addRet=%s",
    attribute,
    tostring(before),
    tostring(delta),
    tostring(after),
    fmt(getRet2),
    fmt(addRet)
  ))

  return getRet2 == 1 and after == target
end

local function setAbilityTo(charObj, ability, target)
  local before, getRet1 = callGetAbility(charObj, ability)

  if getRet1 ~= 1 then
    print(string.format("%-18s INVALID before=%s getRet=%s", ability, tostring(before), fmt(getRet1)))
    return false
  end

  local delta = target - before
  local addRet = nil

  if delta ~= 0 then
    addRet = callAddAbility(charObj, ability, delta)
  end

  local after, getRet2 = callGetAbility(charObj, ability)

  print(string.format(
    "%-18s before=%s delta=%s after=%s getRet=%s addRet=%s",
    ability,
    tostring(before),
    tostring(delta),
    tostring(after),
    fmt(getRet2),
    fmt(addRet)
  ))

  return getRet2 == 1 and after == target
end

local function setAllFor(label, charObj)
  print("")
  print("=== SET ATTRIBUTES: " .. label .. " ===")
  print("obj    = " .. fmt(charObj))
  print("handle = " .. tostring(charObjToHandle(charObj)) .. " / " .. fmt(charObjToHandle(charObj)))
  print("target = " .. tostring(ATTRIBUTE_TARGET_VALUE))

  for _, attribute in ipairs(ATTRIBUTES) do
    local ok, err = pcall(setAttributeTo, charObj, attribute, ATTRIBUTE_TARGET_VALUE)

    if not ok then
      print(attribute .. " ERROR: " .. tostring(err))
    end
  end

  print("")
  print("=== SET ABILITIES: " .. label .. " ===")
  print("obj    = " .. fmt(charObj))
  print("handle = " .. tostring(charObjToHandle(charObj)) .. " / " .. fmt(charObjToHandle(charObj)))
  print("target = " .. tostring(ABILITY_TARGET_VALUE))

  for _, ability in ipairs(ABILITIES) do
    local ok, err = pcall(setAbilityTo, charObj, ability, ABILITY_TARGET_VALUE)

    if not ok then
      print(ability .. " ERROR: " .. tostring(err))
    end
  end

end

local function main()
  print("=== DOS EE SET ATTRIBUTES + ABILITIES ===")
  print("base                  = " .. fmt(base))
  print("CharacterAddAttribute = " .. fmt(base + RVA.CharacterAddAttribute))
  print("CharacterGetAttribute = " .. fmt(base + RVA.CharacterGetAttribute))
  print("CharacterAddAbility   = " .. fmt(base + RVA.CharacterAddAbility))
  print("CharacterGetAbility   = " .. fmt(base + RVA.CharacterGetAbility))
  print("ATTRIBUTE_TARGET      = " .. tostring(ATTRIBUTE_TARGET_VALUE))
  print("ABILITY_TARGET        = " .. tostring(ABILITY_TARGET_VALUE))
  print("APPLY_TO_OWNED_PARTY  = " .. tostring(APPLY_TO_OWNED_PARTY))

  local targetObj = TARGET_CHARACTER_OBJ

  if not isptr(targetObj) then
    targetObj = getHostPlayer()
  else
    print("using TARGET_CHARACTER_OBJ = " .. fmt(targetObj))
  end

  setAllFor("HOST/TARGET", targetObj)

  if APPLY_TO_OWNED_PARTY then
    local party = getOwnedParty(targetObj)

    print("")
    print("owned party count = " .. tostring(#party))

    for i, obj in ipairs(party) do
      setAllFor("OWNED #" .. tostring(i), obj)
    end
  end

  print("")
  print("DONE")
  print("Check the character sheet.")
end

main()

