                <CheatEntry>
                  <ID>1337082735</ID>
                  <Description>"Last Spell Casted"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Highlight info about spell on cast
[ENABLE]
aobscanmodule(last_spell,DarkSoulsIII.exe,44 0F B6 78 25 48 8B 01 FF)
alloc(newmem,$1000,last_spell)

label(code)
label(return)
label(last_spell_ptr)

newmem:

code:
  mov r15,last_spell_ptr
  mov [r15],rax
  movzx r15d,byte ptr [rax+25]
  jmp return

last_spell_ptr:
  dq 0

last_spell:
  jmp code
return:
registersymbol(last_spell)
registersymbol(last_spell_ptr)

[DISABLE]
last_spell:
  db 44 0F B6 78 25
unregistersymbol(last_spell)
unregistersymbol(last_spell_ptr)
dealloc(newmem)

