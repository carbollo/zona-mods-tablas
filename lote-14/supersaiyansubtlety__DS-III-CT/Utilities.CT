            <CheatEntry>
              <ID>1337080190</ID>
              <Description>"Knight's Ring buff increases all stats by 30"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Author: Igromanru
	Description: Knight's Ring buff increases all stats by 30
    Credits: Oden for base idea
}
[ENABLE]
{$lua}
if syntaxcheck then return end
local effect = SpEffectParam:new("KnightsRingBuffIncreasesAllStatsBy30",112046000)
effect:vigorBuff(30)
effect:attunementBuff(30)
effect:enduranceBuff(30)
effect:vitalityBuff(30)
effect:strenghtBuff(30)
effect:dextrerityBuff(30)
effect:intelligenceBuff(30)
effect:faithBuff(30)
effect:luckBuff(30)

[DISABLE]
{$lua}
if syntaxcheck then return end
paramUtils:restore("KnightsRingBuffIncreasesAllStatsBy30")
</AssemblerScript>
