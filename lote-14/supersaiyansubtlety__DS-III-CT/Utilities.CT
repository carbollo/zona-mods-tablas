                <CheatEntry>
                  <ID>1337083031</ID>
                  <Description>"AddSoul"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Enter amount of souls and activate Thread_AddSoul
[ENABLE]
alloc(AddSoul,$35,DarkSoulsIII.exe)
registerSymbol(AddSoul)

define(SoulsToAdd,AddSoul+32)
registerSymbol(SoulsToAdd)

SoulsToAdd:
dd #500

AddSoul:
mov edi,[SoulsToAdd]
mov rbx,[BaseB]
mov rsi,[rbx+80]
mov rbx,[rbx+80]
mov rcx,[rbx+XB]
mov edx,edi
sub rsp,28
call 1405A3310
add rsp,28
ret

[DISABLE]
dealloc(AddSoul)
unregisterSymbol(AddSoul)
unregisterSymbol(SoulsToAdd)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>1337083032</ID>
                      <Description>"Souls"</Description>
                      <ShowAsSigned>1</ShowAsSigned>
                      <VariableType>4 Bytes</VariableType>
                      <Address>SoulsToAdd</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337083033</ID>
                      <Description>"Thread_AddSoul"</Description>
                      <Options moHideChildren="1"/>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
disableMemrec(memrec)
{$asm}
createthread(AddSoul)
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337083034</ID>
                  <Description>"BonfireWarp"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Select bonfire to warp to and activate
//the Thread_BonfireWarpscript to warp to it
[ENABLE]
alloc(BonfireWarp,$35,DarkSoulsIII.exe)
registerSymbol(BonfireWarp)

define(SprjLuaEventBase,DarkSoulsIII.exe+473A9C8)
define(Lua_Warp,DarkSoulsIII.exe+475DC0)

define(TargetBonfireId,BonfireWarp+32)
registerSymbol(TargetBonfireId)

TargetBonfireId:
dd #4002950

BonfireWarp:
mov rcx,[SprjLuaEventBase]
xor r9d,r9d
mov r8,[TargetBonfireId]
lea r8d,[r8-000003E8]
mov edx,[BaseC+ACC]
lea edx,[edx-000003E8]
sub rsp,28
call Lua_Warp
add rsp,28
ret

[DISABLE]
dealloc(BonfireWarp)
unregisterSymbol(BonfireWarp)
unregisterSymbol(TargetBonfireId)
</AssemblerScript>
