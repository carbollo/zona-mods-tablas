              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337083022</ID>
                  <Description>"Item Gib"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <Color>FF0000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
 Author: Coinsworth -- Special thanks to Loki for helping test
 Desc: Adds item to inventory

 https://pastebin.com/DKUvVwN8
}
[ENABLE]
aobscanmodule(ItemGibCall,DarkSoulsIII.exe,00 CC CC CC CC 4C 89 44 24 18)
alloc(ItemGib,$80,DarkSoulsIII.exe)
registersymbol(ItemGib)

define(ItemGibQuan,ItemGib+6D)
registerSymbol(ItemGibQuan)
define(ItemGibItem,ItemGib+71)
registerSymbol(ItemGibItem)
define(ItemGibDura,ItemGib+75)
registerSymbol(ItemGibDura)

define(ItemGibInfusion,ItemGib+79)
registerSymbol(ItemGibInfusion)
define(ItemGibUpgrade,ItemGib+7D)
registerSymbol(ItemGibUpgrade)

ItemGibQuan:
dd 1

ItemGibItem:
dd 400001F4

ItemGibDura:
dd FFFFFFFF

ItemGibInfusion:
dd 0

ItemGibUpgrade:
dd 0

ItemGib:
sub rsp,48
lea r8d,[rsp+20]
lea rdx,[rsp+30]
mov eax,[ItemGibQuan]
mov ebx,[ItemGibItem]
mov esi,[ItemGibDura]

cmp ebx,10000000
jge ItemGib+37
add ebx,[ItemGibInfusion]
add ebx,[ItemGibUpgrade]

mov [rdx],1
mov [rdx+0C],esi
mov [r8+14],ebx
mov [r8+18],eax
mov rax,[DarkSoulsIII.exe+4768E78]
mov rbp,[rax+80]
mov rbx,[DarkSoulsIII.exe+4752300]
mov rcx,rbx
call ItemGibCall+05
add rsp,48
ret

[DISABLE]
dealloc(ItemGib)
unregistersymbol(ItemGib)
unregistersymbol(ItemGibQuan)
unregistersymbol(ItemGibItem)
unregistersymbol(ItemGibDura)
unregistersymbol(ItemGibInfusion)
unregistersymbol(ItemGibUpgrade)
</AssemblerScript>
