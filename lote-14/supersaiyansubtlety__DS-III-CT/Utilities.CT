                  <Description>"No Durability Damage"</Description>
                  <LastState Activated="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
// 13.04.2017 for v1.13 fixed by Autopilot
aobscanmodule(Durability, DarkSoulsIII.exe, 48 8B 49 08 48 85 C9 74 ?? 48 8B 01 48 ?? ?? 10 F3 C3 48)
registersymbol(Durability)
alloc(duraMem, $200, Durability)
label(return)
label(return2)
label(jumphere)

duraMem:
  mov rcx,[rcx+08]
  test rcx,rcx
  je jumphere
  cmp [rcx+10],edx
  jg jumphere
  jmp return
jumphere:
  jmp return2

Durability:
  jmp duraMem
  nop
  nop
  nop
  nop
return:

Durability+10:
return2:

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
Durability:
mov rcx,[rcx+08]
test rcx,rcx
je Durability+10

dealloc(duraMem)
unregistersymbol(Durability)



							
</AssemblerScript>
