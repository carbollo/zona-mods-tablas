  <CheatEntries>
    <CheatEntry>
      <ID>30173</ID>
      <Description>"&lt;----Activate scripts by clicking on the box     (Made by Tavreth)"</Description>
      <Options moHideChildren="1"/>
      <Color>008000</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>30130</ID>
          <Description>"Enable for First Person (Enable At Main Menu)"</Description>
          <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
define(newmem,GRW.exe+98B600)
define(stop,GRW.exe+15C45200)//2bytes
define(respawnTime,GRW.exe+15C45203)//4bytes
define(HeadPointerVar,GRW.exe+15C45207)//8bytes
define(FOV1Result,GRW.exe+15C4520F)//4bytes
define(HeadRenderPTR,GRW.exe+15C45213)//8bytes
define(HeadRenderReset,GRW.exe+15C4521B)//1bytes
define(3rdPersonToggle,GRW.exe+15C4521C)//1bytes
define(GlobalCoords,GRW.exe+15C45220)//16bytes
label(loop)
label(preloop)
label(returnhere)
label(exit)
label(adsstop)
label(returnhere2)
label(dronebyte)
label(SetSpawnTime)
label(returnSetSpawnTime)
label(FOV1)
label(FOV1return)
label(FOV1Skip)
label(FOV2)
label(FOV2return)
label(FOV1multiplier)
label(FOVbase)
label(FOV3skip)
label(FOV3)
label(FOV3return)
label(exit2)
label(returnhere3)
label(HeadRender)
label(HeadRenderExit)
label(skipHead)
label(toggleSkip)
label(turnoff)
label(HeadPointer)
label(HeadPointerReturn)
label(HeadPointerExit)
label(HeadPointerDiff)
label(HeadPointer1JB)
label(HeadPointer2JB)
label(HeadPointerNext)
label(HeadPointerNext2)
label(done)
label(HeadPointerNull)
label(HeadPointerNullReturn)


//xmm 0 1 2 are valid
newmem:
movaps xmm1,[rdx+30]
push r15
push r14
push r13
push rdi
push rax
push r9
push rcx
push rdx
push r8
sub rsp 28
mov rcx,[GRW.exe+491D500]
mov rdx,45
call GRW.exe+6EA690
mov r15l,al
add rsp 28
pop r8
pop rdx
pop rcx
pop r9
pop rax
pop rdi
test r15l,r15l
je toggleSkip
mov r15l,[3rdPersonToggle]
test r15l,r15l
je turnoff
mov byte ptr [3rdPersonToggle],00
jmp toggleSkip
turnoff:
mov byte ptr [3rdPersonToggle],01
toggleSkip:
cmp rcx,[GRW.exe+493D138]
jne exit2 //check if writing to camera coords
mov r15,[GRW.exe+4914628]
mov r15l,[r15+349]
test r15l,r15l
je exit //not first person when 0
mov r15l,[stop]
test r15l,r15l
jne exit2 //not first person when 1
mov r15l,[stop+1]
test r15l,r15l
jne exit //not first person when 1
mov r15l,[3rdPersonToggle]
test r15l,r15l
jne exit
mov r15,[GRW.exe+49223E8]
mov r15,[r15+50]
xor r13,r13
jmp loop

preloop:
inc r13
loop:
mov r14,[r15+r13*8]
mov r14,[r14+18]
mov r14l,[r14+3FC]
test r14l,r14l
je preloop

mov r14,[r15+r13*8]
mov r14,[r14+10]
mov r13,[r14+E0]
mov r13,[r13+10C0]
movaps xmm1,[r13+50]
movaps [GlobalCoords],xmm1
mov r15,[HeadPointerVar]
test r15,r15
je done
movaps xmm1,[r15+80]

done:
mov r15d,(float)1
movaps [rcx+30],xmm1
mov [rcx+3C],r15d
pop r13
pop r14
pop r15
push r11
push r10
push r9
push r8
push rax
push rcx
push rdx
mov rcx,[HeadRenderPTR]
test rcx,rcx
je skipHead
xor rdx,rdx
mov dl,01
mov [HeadRenderReset],dl
call GRW.exe+25B1C60
skipHead:
pop rdx
pop rcx
pop rax
pop r8
pop r9
pop r10
pop r11
jmp returnhere
exit:
mov r15l,[HeadRenderReset]
test r15l,r15l
je exit2
push r11
push r10
push r9
push r8
push rax
push rcx
push rdx
mov rcx,[HeadRenderPTR]
xor rdx,rdx
mov [HeadRenderReset],dl
call GRW.exe+25B1C60
pop rdx
pop rcx
pop rax
pop r8
pop r9
pop r10
pop r11
exit2:
pop r13
pop r14
pop r15
movaps [rcx+30],xmm1
jmp returnhere

adsstop:
mov [stop],dl
ret

dronebyte:
mov [rdi+0000180A],bl
mov [stop+1],bl
jmp returnhere2

SetSpawnTime:
mov [respawnTime],41200000
movss xmm1,[respawnTime]
jmp returnSetSpawnTime

FOV1:
movss xmm14,[rax+10]
movss xmm15,[FOV1multiplier+4]
comiss xmm14,xmm15
jb FOV1Skip
subss xmm14,xmm15
mulss xmm14,[FOV1multiplier]
addss xmm14,xmm15
FOV1Skip:
movss [rcx+38],xmm14
movss [FOV1Result],xmm14
xorps xmm14,xmm14
xorps xmm15,xmm15
jmp FOV1return

FOV2:
movss xmm0,[FOV1Result]
movss [rax+38],xmm0
jmp FOV2return

FOV3:
mov eax,[rcx+0000034C]
cmp eax,#1051261138
je FOV3skip
cmp eax,#1057360530
je FOV3skip
cmp eax,#1048447523
je FOV3skip
cmp eax,#1060121943
je FOV3skip
movss xmm0,[FOVbase]
movss xmm1,[FOVbase+4]
movss [rcx+0000034C],xmm0
movss [rcx+00000344],xmm1
jmp FOV3return
FOV3skip:
movss xmm0,[rcx+0000034C]
movss xmm1,[rcx+00000344]
jmp FOV3return

HeadRender:
push r15
push r14
mov r14,14257AC30
mov r15,[rbx+08]
mov r15,[r15+1F0]
cmp r15,r14
jne HeadRenderExit
mov r14l,[HeadRenderReset]
test r14l,r14l
jne HeadRenderExit
mov [HeadRenderPTR],rbx
mov sil,01
HeadRenderExit:
pop r14
pop r15
cmp byte ptr [rbx+30],00
je GRW.exe+11B01D09
jmp returnhere3

HeadPointer:
movaps [rsi+00000080],xmm0
sub rsp 18
Push r15
mov r15,[GRW.exe+491D340]
mov r15,[r15+10]
mov r15,[r15+608]
mov r15l,[r15+182]
test r15l,r15l
jne HeadPointerExit
mov r15,[HeadPointerVar]
test r15,r15
jne HeadPointerExit


movaps [rsp],xmm0
movss xmm13,[rsp]
movss xmm14,[HeadPointerDiff]
movss xmm15,[GlobalCoords]
comiss xmm15,xmm13
jb HeadPointer1JB
subss xmm15,xmm14
comiss xmm15,xmm13
ja HeadPointerExit
jmp HeadPointerNext

HeadPointer1JB:
addss xmm15,xmm14
comiss xmm15,xmm13
jb HeadPointerExit

HeadPointerNext:
movss xmm13,[rsp+4]
movss xmm15,[GlobalCoords+4]
comiss xmm15,xmm13
jb HeadPointer2JB

subss xmm15,xmm14
comiss xmm15,xmm13
ja HeadPointerExit
jmp HeadPointerNext2

HeadPointer2JB:
addss xmm15,xmm14
comiss xmm15,xmm13
jb HeadPointerExit

HeadPointerNext2:
mov [HeadPointerVar],rsi

HeadPointerExit:
add rsp 18
pop r15
xorps xmm13,xmm13
xorps xmm14,xmm14
xorps xmm15,xmm15
jmp HeadPointerReturn

HeadPointerNull:
mov byte ptr [rdi+00000182],01
push r15
xor r15,r15
mov [HeadPointerVar],r15
pop r15
jmp HeadPointerNullReturn


FOV1multiplier:
db 85 EB 71 40 74 A3 50 3F
FOVbase:
db 72 A3 50 3F 0E 6A 90 3F
HeadPointerDiff:
db 9A 99 99 3E

"GRW.exe"+B3703B6:
jmp newmem
nop 3
returnhere:

"GRW.exe"+E7D197A:
jmp dronebyte
nop
returnhere2:

"GRW.exe"+FF4B56A:
