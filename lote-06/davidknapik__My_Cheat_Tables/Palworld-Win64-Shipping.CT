[ENABLE]

aobscanmodule(ammoDecrease,Palworld-Win64-Shipping.exe,8D 42 FF 89 81 84 00 00 00) // should be unique
aobscanmodule(ammoTestZero,Palworld-Win64-Shipping.exe,83 B8 84 00 00 00 00 0F 9E C0 48 8B 5C 24 ** 48) // should be unique
alloc(newmemammoDecrease,$1000,ammoDecrease)
alloc(newmemammoTestZero,$1000,ammoTestZero)

label(codeammoDecrease)
label(returnammoDecrease)

label(codeammoTestZero)
label(returnammoTestZero)

newmemammoDecrease:

xor eax,eax
mov [rcx+00000084],edx
codeammoDecrease:
//  lea eax,[rdx-01]
//  mov [rcx+00000084],eax
  jmp returnammoDecrease

/* -----------  zero check ----------------- */
/* -----------  zero check ----------------- */
/* -----------  zero check ----------------- */

newmemammoTestZero:

cmp dword ptr [rax+00000084],00
jg codeammoTestZero

push ebx
xor ebx,ebx
inc ebx
mov [rax+00000084],ebx
pop ebx
cmp dword ptr [rax+00000084],00

codeammoTestZero:
//  cmp dword ptr [rax+00000084],00
  jmp returnammoTestZero

ammoTestZero:
  jmp newmemammoTestZero
  nop 2
returnammoTestZero:

ammoDecrease:
  jmp newmemammoDecrease
  nop 4
returnammoDecrease:


[DISABLE]

ammoDecrease:
  db 8D 42 FF 89 81 84 00 00 00

ammoTestZero:
  db 83 B8 84 00 00 00 00

unregistersymbol(ammoTestZero)
unregistersymbol(ammoDecrease)
dealloc(newmemammoDecrease)

