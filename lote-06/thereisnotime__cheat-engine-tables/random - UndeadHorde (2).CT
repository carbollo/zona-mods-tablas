    <CheatEntry>
      <ID>44</ID>
      <Description>"One Hit Kill + Unlimited Health"</Description>
      <LastState Activated="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : UndeadHorde.exe
  Version:
  Date   : 2019-05-16
  Author : Rysefox

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(OHK,prog.dll,F3 0F 10 B6 8C 03 00 00) // should be unique
alloc(newmem,$1000)

label(code)
label(return)
label(EnemyOHK)

newmem:
cmp [esi+E4],00100000 //FILTERING PLAYER AND MINION OUT
jne EnemyOHK          //IF IT NOT 00100000 JUMP TO ONE HIT KILL
jmp code              //JMP TO CODE

code:
movss xmm6,[esi+390]  //MAX HEALTH WRITES IN XMM6
  movss [esi+0000038C],xmm6   //XMM6 MOVE THE MAX IN CURRENT
  jmp return

EnemyOHK:
push edx              //PUSH FREE REGISTER
mov edx,(float)1      //MOV IN EDX (FLOAT)1
mov [esi+38C],edx     //MOV EDX WITH 1 HEALTH IN CURRENT ENEMY HEALTH
pop edx               //POP REGISTER
jmp return


OHK:
  jmp newmem
  nop
  nop
  nop
return:
registersymbol(OHK)

[DISABLE]

OHK:
  db F3 0F 10 B6 8C 03 00 00

unregistersymbol(OHK)
dealloc(newmem)

