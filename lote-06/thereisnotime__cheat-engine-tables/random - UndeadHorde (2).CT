    <CheatEntry>
      <ID>10</ID>
      <Description>"Player AOB Script"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>// Game   : UndeadHorde.exe
// Version:
// Date   :
// Author : Rysefox
[ENABLE]
aobscanmodule(aobPlayer_Stats,prog.dll,F3 0F 10 80 8C 03 00 00 0F 2F C1 76 6E)
aobscanmodule(aobPlayer_Inventorty,prog.dll,FF B7 B4 02 00 00 F3)
aobscanmodule(aobPlayer_XPManager,prog.dll,FF 77 08 68 70 BC ?? ?? ?? ?? ??)
aobscanmodule(aobPlayer_ManaBar,prog.dll,F3 0F 11 9E 58 02 00 00)

alloc(newmemPlayer_Stats,4096,aobPlayer_Stats)
alloc(newmemPlayer_Inventorty,4096,aobPlayer_Inventorty)
alloc(newmemPlayer_XPManager,4096,aobPlayer_XPManager)
alloc(newmemPlayer_ManaBar,4096,aobPlayer_ManaBar)

label(aobPlayer_Stats_r)
label(aobPlayer_Stats_i)
registersymbol(aobPlayer_Stats_r)
registersymbol(aobPlayer_Stats_i)
label(lblPlayer_Stats)
label(lblPlayer_StatsSkip)
label(lblPlayer_StatsRet)
//-------------------------------------
label(aobPlayer_Inventorty_r)
