registersymbol(aobPlayer_ManaBar_i)
label(lblPlayer_ManaBar)
label(lblPlayer_ManaBarSkip)
label(lblPlayer_ManaBarRet)
//------------------------------------

label(Player_Offsets)
registersymbol(Player_Offsets)
//--------------------------------------
label(Player_Inventory)
registersymbol(Player_Inventory)
//--------------------------------------
label(Player_XP)
registersymbol(Player_XP)
//-------------------------------------
label(Player_Mana)
registersymbol(Player_Mana)

newmemPlayer_Stats:

lblPlayer_Stats:
readmem(aobPlayer_Stats,8)
je short lblPlayer_StatsSkip
mov [Player_Offsets],eax
movss xmm0,[eax+0000038C]


lblPlayer_StatsSkip:
jmp lblPlayer_StatsRet
aobPlayer_Stats_i:
readmem(aobPlayer_Stats,8)


Player_Offsets:
dq 0

//--------------------------------------------------------
newmemPlayer_Inventorty:

lblPlayer_Inventorty:
readmem(aobPlayer_Inventorty,6)
je short lblPlayer_InventortySkip
mov [Player_Inventory],edi
push [edi+000002B4]
pop [edi+000002B4]

lblPlayer_InventortySkip:
jmp lblPlayer_InventortyRet
aobPlayer_Inventorty_i:
readmem(aobPlayer_Inventorty,6)

Player_Inventory:
dq 0

aobPlayer_Stats:
aobPlayer_Stats_r:
jmp lblPlayer_Stats
nop
nop
nop
lblPlayer_StatsRet:
aobPlayer_Inventorty:
aobPlayer_Inventorty_r:
jmp lblPlayer_Inventorty
nop
lblPlayer_InventortyRet:
//---------------------------------------------
newmemPlayer_XPManager:

lblPlayer_XPManager:
readmem(aobPlayer_XPManager,8)
je short lblPlayer_XPManagerSkip
mov [Player_XP],edi
push [edi+08]
pop [edi+08]

lblPlayer_XPManagerSkip:
jmp lblPlayer_XPManagerRet
aobPlayer_XPManager_i:
readmem(aobPlayer_XPManager,8)

Player_XP:
dq 0

aobPlayer_XPManager:
aobPlayer_XPManager_r:
jmp lblPlayer_XPManager
nop
nop
nop
lblPlayer_XPManagerRet:
//-----------------------------------------------------------
newmemPlayer_ManaBar:

lblPlayer_ManaBar:
readmem(aobPlayer_ManaBar,8)
je short lblPlayer_ManaBarSkip
mov [Player_Mana],esi
movss [esi+00000258],xmm3

lblPlayer_ManaBarSkip:
jmp lblPlayer_ManaBarRet
aobPlayer_ManaBar_i:
readmem(aobPlayer_ManaBar,8)

Player_Mana:
dq 0

aobPlayer_ManaBar:
aobPlayer_ManaBar_r:
jmp lblPlayer_ManaBar
nop
nop
nop
lblPlayer_ManaBarRet:
[DISABLE]
aobPlayer_Stats_r:
readmem(aobPlayer_Stats_i,8)
//-----------------------------------
aobPlayer_Inventorty_r:
readmem(aobPlayer_Inventorty_i,6)
//-----------------------------------
aobPlayer_XPManager_r:
readmem(aobPlayer_XPManager_i,8)
//-----------------------------------
aobPlayer_ManaBar_r:
readmem(aobPlayer_ManaBar_i,8)

unregistersymbol(aobPlayer_Stats_r)
unregistersymbol(aobPlayer_Stats_i)
unregistersymbol(aobPlayer_Inventorty_r)
unregistersymbol(aobPlayer_Inventorty_i)
unregistersymbol(aobPlayer_XPManager_r)
unregistersymbol(aobPlayer_XPManager_i)
unregistersymbol(aobPlayer_ManaBar_r)
unregistersymbol(aobPlayer_ManaBar_i)


unregistersymbol(Player_Offsets)
unregistersymbol(Player_Inventory)
unregistersymbol(Player_XP)
unregistersymbol(Player_Mana)

dealloc(newmemPlayer_Stats)
dealloc(newmemPlayer_Inventorty)
dealloc(newmemPlayer_XPManager)
dealloc(newmemPlayer_ManaBar)
</AssemblerScript>
