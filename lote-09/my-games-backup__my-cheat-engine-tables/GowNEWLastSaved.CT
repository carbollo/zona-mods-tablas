            <CheatEntry>
              <ID>87667</ID>
              <Description>"Generate Parameters (Reference only, Nothing to Modify here)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.438.9704
	Date	: January 16, 2022
	Author	: aSwedishMagyar
}
{$lua}
function getParamName(base)
	local name = ''
	base = readPointer(base+0x10)
    if base == nil then return name end
    return readString(base,100)
end
function createParam(base,mainRec)
	local base = readPointer(base+0x28)
    if base == nil then return end
    base = readPointer(base)
    if base == nil then return end
    createRecord(base+0x14,"State",0,mainRec)
    createRecord(base+0x18,"Max Val",4,mainRec)
end
function createParamHeader(desc,mainRec)
	local addList = getAddressList()
    local hTemp = addList.createMemoryRecord()
	hTemp.Description = desc
    hTemp.isGroupHeader = true
    hTemp.Options = '[moHideChildren]'
    hTemp.appendToEntry(mainRec)
    return hTemp
end
function generateParams(mainRec)
	local base = getAddressSafe('[ParamList]')
    if base == nil then return end
    local num = readInteger(base+0x50) - 1
    base = readPointer(base+0x48)
	for i = 0,num do
    	local cAddr = readPointer(base+i*0x10)
		local paramName = getParamName(cAddr)
        local topRec = createParamHeader(paramName,mainRec)
        createParam(cAddr,topRec)
    end
end
if syntaxcheck then return end
[ENABLE]
setupNames()
generateParams(memrec)
[DISABLE]
removeRecords(memrec)
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>26115</ID>
          <Description>"Scripts"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>26158</ID>
              <Description>"Inf Health"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.438.9704
	Date	: January 16, 2022
	Author	: aSwedishMagyar
}
[ENABLE]
registersymbol(codeinfHealth)
alloc(newinfHealth,100,infHealth)
label(codeinfHealth)
label(returninfHealth)
newinfHealth:
  push rax
  mov rax,goPlayer
  mov rax,[rax]
  mov rax,[rax+8]
  cmp [rcx+90],rax
  pop rax
  jne codeinfHealth
  ret
codeinfHealth:
  readmem(infHealth,5)
  jmp returninfHealth

infHealth:
  jmp newinfHealth
returninfHealth:

[DISABLE]
infHealth:
  readmem(codeinfHealth,5)

unregistersymbol(codeinfHealth)
dealloc(newinfHealth)

