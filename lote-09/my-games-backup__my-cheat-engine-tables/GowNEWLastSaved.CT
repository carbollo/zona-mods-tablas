            <CheatEntry>
              <ID>87653</ID>
              <Description>"Inf Rage"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.438.9704
	Date	: January 17, 2022
	Author	: aSwedishMagyar
}
{$lua}
function setRageInf(val)
	local base = getAddressSafe('[[goPlayer]+8]')
    if base == nil then return end
    local rBase = readPointer(base+0x3E0)
    local mRage = readFloat(rBase+0x18)
    if val == 1 then writeFloat(base+0x3E8,mRage) end
    writeBytes(base+0x3E8+0x19,val)
    writeBytes(base+0x3E8+0x1A,val)
end
if syntaxcheck then return end
[ENABLE]
setRageInf(1)
[DISABLE]
setRageInf(0)
</AssemblerScript>
            </CheatEntry>
