              <Description>"Modify Damage"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.440.8343
	Date	: 2022-01-24
	Author	: aSwedishMagyar
}
[ENABLE]
registersymbol(codedamageCalc)
registersymbol(damageMult)
alloc(newdamageCalc,100,damageCalc)
label(dodamageMult)
label(dodamageCalc)
label(codedamageCalc)
label(returndamageCalc)
label(damageMult)
newdamageCalc:
  push rbx
  mov rbx,7FFFFFFFFFFFFFFF
  cmp rbx,rax
  pop rbx
  je dodamageMult
  push rbx
  mov rbx,0000000004000000
  cmp rbx,rax
  pop rbx
  jne dodamageCalc
dodamageMult:
  movss xmm0,[damageMult]
  jmp returndamageCalc
dodamageCalc:
  reassemble(damageCalc)
  jmp returndamageCalc
codedamageCalc:
  readmem(damageCalc,5)

damageMult:
  dd (float)1
damageCalc:
  jmp newdamageCalc
returndamageCalc:

[DISABLE]
damageCalc:
  readmem(codedamageCalc,5)

unregistersymbol(codedamageCalc)
unregistersymbol(damageMult)
dealloc(newdamageCalc)

