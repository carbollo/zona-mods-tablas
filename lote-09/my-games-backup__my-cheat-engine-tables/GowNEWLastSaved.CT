            <CheatEntry>
              <ID>27836</ID>
              <Description>"Resource Gain Modifiers"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.438.9704
	Date	: January 16, 2022
	Author	: aSwedishMagyar
}
{$lua}
function getItemList()
	local itemList = {	'EconomyXP','Hacksilver',
    					'ReinforcementCommon','ReinforcementUncommon','ReinforcementRare',
                        'AxeReinforcement','TalismanReinforcement','RuneDust'}
    return itemList
end
function getNameList()
	local nameList = {	'XP','Hacksilver',
    					'Soft Svartalfheim Steel','Solid Svartalfheim Steel','Hardened Svartalfheim Steel',
                        'Frozen Flame','Dust of Realms','Enchanted Dust'}
    return nameList
end
function createInfItemsRecord(mainRec)
	local addList = getAddressList()
    local newRec = addList.createMemoryRecord()
    newRec.isGroupHeader = true
    newRec.Description = "Inf Items"
    newRec.OnActivate = function() infItems = true;return true end
    newRec.OnDeactivate = function() infItems = false;return true end
	newRec.appendToEntry(mainRec)
end
function setupItemMults(mainRec)
	local itemList = getItemList()
    local nameList = getNameList()
    for i = 1,#itemList do
    	_G[itemList[i].."Mult"] = allocateMemory(4)
    	writeFloat(_G[itemList[i].."Mult"],1)
        createRecord(itemList[i].."Mult",nameList[i].." Multiplier",4,mainRec)
    end
end
function removeItemMults(mainRec)
	local itemList = getItemList()
    for i = 1,#itemList do
    	deAlloc(_G[itemList[i].."Mult"])
    end
    removeRecords(mainRec)
end
function checkInfItemList(name)
	local itemList = getItemList()
	for i = 1,#itemList do if name == itemList[i] then return true end end
    return false
end
function itemGainModifier()
	local itemList = getItemList()
    local cAddr = readPointer(readPointer(RCX+0x28))
    local name = readString(cAddr,100)
    local mult = 1
    if _G[name.."Mult"] then mult = readFloat(_G[name.."Mult"]) end
    if bAnd(RDX,0x80000000) ~= 0 then
    	if infItems then if checkInfItemList(name) then mult = 0 end
        else mult = 1 end
    end
    RDX = RDX * mult
end
if syntaxcheck then return end
local base = getAddressSafe('itemGain')
[ENABLE]
debugProcess(2)
debug_setBreakpoint(base,1,bptExecute,bpmInt3,itemGainModifier)
infItems = false
createInfItemsRecord(memrec)
setupItemMults(memrec)
[DISABLE]
debug_removeBreakpoint(base)
removeItemMults(memrec)
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
