              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.438.9704
	Date	: January 16, 2022
	Author	: aSwedishMagyar
}
[ENABLE]
registersymbol(codesetFOV)
registersymbol(fovSetVal)
alloc(newsetFOV,100,setFOV)
label(codesetFOV)
label(returnsetFOV)
label(fovSetVal)
newsetFOV:
  mov eax,[fovSetVal]
  readmem(setFOV+3,3)
  jmp returnsetFOV

codesetFOV:
  readmem(setFOV,6)

fovSetVal:
  dd (float)90
setFOV:
  jmp newsetFOV
  nop
returnsetFOV:

