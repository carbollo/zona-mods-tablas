            <CheatEntry>
              <ID>26117</ID>
              <Description>"Generate Inventory"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
	Game	: GoW.exe
	Version	: 1.0.438.9704
	Date	: January 16, 2022
	Author	: aSwedishMagyar
}
{$lua}
function setupNames()
	local base = getAddressSafe('NameList')
    if nameList then return end
    nameList = {}
    for j = 0,2 do
        local num = readInteger(base+0x18+4*j) - 1
        local cBase = readPointer(base+j*8)
        for i = 0,num do
		    local cAddr = readPointer(cBase+i*0x10)
            local number = readInteger(cBase+i*0x10+8)
            local name = readString(cAddr,1000)
            nameList[number] = name
        end
    end
end
function getItemName(base)
	local name = ''
	base = readPointer(base+0x28)
    if base == nil then return '' end
    local num = readInteger(base+8)
    if nameList[num] then name = name..nameList[num] end
	base = readPointer(base)
    if base == nil then return name end
    name = "["..readString(base).."]   "..name
    return name
end
function createItem(base,hList)
	local name = getItemName(base)
    local qty = readInteger(base+0x30)
    local mainRec = hList[2]
    if qty ~= 0xFFFFFFFF or (not name) or name == '' then mainRec = hList[1] end
    createRecord(base+0x30,name,2,mainRec)
end
function createHeaders(mainRec)
	local addList = getAddressList()
    local hList = {}
    local dList = {"Initialized Items","Un-initialized Items"}
    for i=1,2 do
        local hTemp = addList.createMemoryRecord()
	    hTemp.Description = dList[i]
        hTemp.isGroupHeader = true
        hTemp.Options = '[moHideChildren]'
        hTemp.appendToEntry(mainRec)
        hList[i] = hTemp
    end
    return hList
end
function generateInventory(mainRec)
	local base = getAddressSafe('[Inventory]')
    if base == nil then return end
    local num = readInteger(base+0x20) - 1
    base = readPointer(base+0x10)
    local hList = createHeaders(mainRec)
	for i = 0,num do createItem(base+i*0x40,hList) end
end
if syntaxcheck then return end
[ENABLE]
setupNames()
generateInventory(memrec)
[DISABLE]
removeRecords(memrec)
