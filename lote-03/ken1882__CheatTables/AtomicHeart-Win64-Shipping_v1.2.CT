Ally1:set_currentHp+6d: 48 8B 00                       - mov rax,[rax]
Ally1:set_currentHp+70: 48 8B 40 60                    - mov rax,[rax+60]
Ally1:set_currentHp+74: F2 0F 10 44 24 08              - movsd xmm0,[rsp+08]
// ---------- INJECTING HERE ----------
