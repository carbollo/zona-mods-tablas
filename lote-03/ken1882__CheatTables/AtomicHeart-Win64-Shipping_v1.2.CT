            <CheatEntry>
              <ID>353805</ID>
              <Description>"Ghost Mode"</Description>
              <Color>000080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$ASM}
[ENABLE]
{$LUA}
function toHex(str)
str = string.format("%X", str)
return str
end
if syntaxcheck then return end
local CharacterBase = toHex(getAddressSafe('[[LocalPlayer_Pointer]+30]+250'))
local MovementBase  = toHex(getAddressSafe('[' .. CharacterBase .. ']+288'))
if CharacterBase   ~=nil or MovementBase ~=nil then
   adActorEnableCollision   = toHex(getAddressSafe('[' .. CharacterBase .. ']+5C'))
   adMovementMode           = toHex(getAddressSafe('[' .. MovementBase .. ']+168'))
   adMaxFlySpeed           = toHex(getAddressSafe('[' .. MovementBase .. ']+198'))
   writeBytes(adMovementMode, 5)           --Flying
   writeFloat(adMaxFlySpeed, 1500)         --MaxFlySpeed
   writeBytes(adActorEnableCollision, 129) --Collision Off
   memrec.Color = 0x0000FF
end
{$ASM}
[DISABLE]
{$LUA}
   writeBytes(adActorEnableCollision, 137) --Collision On
   writeBytes(adMovementMode, 1)           --Walking
   writeFloat(adMaxFlySpeed, 600)          --Walking
   memrec.Color = 0x000080
{$ASM}


</AssemblerScript>
            </CheatEntry>
