                  <AssemblerScript>{$ASM}
[ENABLE]
{$LUA}
function toHex(str)
str = string.format("%X", str)
return str
end
if syntaxcheck then return end

local al = getAddressList()
if al ~= nil then
local fallDamageScript  = al.getMemoryRecordByDescription('No Fall Damage')
local outOfBoundsScript = al.getMemoryRecordByDescription('Freeze Out of Bounds Countdown')
fallDamageScript.Active = true
outOfBoundsScript.Active = true
end

local LocalPlayerBase     = toHex(getAddressSafe('[[[LocalPlayer_Pointer]+30]+250]+130'))
local SavedLocaltionsBase = toHex(getAddressSafe('SavedLocaltions_'))
if LocalPlayerBase ~= nil or SavedLocaltionsBase ~= nil then
--LocalPlayer
   adLocalPlayer_X  = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+1D0'))
   adLocalPlayer_Y  = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+1D4'))
   adLocalPlayer_Z  = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+1D8'))
   if readString(SavedLocaltionsBase, 255, true) == 'K13 North Cave Tier 2' then
      writeFloat(adLocalPlayer_X, 150223.2031)
      writeFloat(adLocalPlayer_Y, 226407.9688)
      writeFloat(adLocalPlayer_Z, -23342.67188)
   end
   if readString(SavedLocaltionsBase, 255, true) == 'P11 Cave Tier 3' then
      writeFloat(adLocalPlayer_X, 352058.5312)
      writeFloat(adLocalPlayer_Y, 115647.9375)
      writeFloat(adLocalPlayer_Z, -23436.09375)
   end
   if readString(SavedLocaltionsBase, 255, true) == 'I13 Cave Tier 1' then
      writeFloat(adLocalPlayer_X, 23751.12109)
      writeFloat(adLocalPlayer_Y, 226590.5156)
      writeFloat(adLocalPlayer_Z, -26582.55273)
   end
   if readString(SavedLocaltionsBase, 255, true) == 'M14 Exotic Deposit' then
      writeFloat(adLocalPlayer_X, 232924.9375)
      writeFloat(adLocalPlayer_Y, 272743.8438)
      writeFloat(adLocalPlayer_Z, -15100.2998)
   end
   if readString(SavedLocaltionsBase, 255, true) == 'M14 Mid Cave Tier 1' then
      writeFloat(adLocalPlayer_X, 232245.0781)
      writeFloat(adLocalPlayer_Y, 277000.5312)
      writeFloat(adLocalPlayer_Z, -18300.7207)
   end
   if readString(SavedLocaltionsBase, 255, true) == 'M14 West Cave Tier 3' then
      writeFloat(adLocalPlayer_X, 204280.2188)
      writeFloat(adLocalPlayer_Y, 262264.5625)
      writeFloat(adLocalPlayer_Z, -13600.06152)
   end
   if readString(SavedLocaltionsBase, 255, true) == 'M14 East Cave Tier 3' then
      writeFloat(adLocalPlayer_X, 250442.625)
      writeFloat(adLocalPlayer_Y, 268938.125)
      writeFloat(adLocalPlayer_Z, -18500.98438)
   end
   memrec.Color = 0x0000FF00 --AABBGGRR Green
end

local ce = getMainForm()
memrec.OnActivate = function(memrec, anteState, curState)
    if not anteState and curState then
        local t = createTimer(ce)
        t.Interval = 1000
        t.OnTimer = function(t)
                        t.destroy()
                        t = nil
                        memrec.Active = false
                    end
    end
    return true
end

