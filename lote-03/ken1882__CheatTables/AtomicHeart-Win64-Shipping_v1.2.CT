                    <CheatEntry>
                      <ID>353734</ID>
                      <Description>"God Mode [LUA, set value of a pointer]"</Description>
                      <Color>0000FF</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$ASM}
[ENABLE]
{$LUA}
function toHex(str)
str = string.format("%X", str)
return str
end

local HealthComponentBase = toHex(getAddressSafe('[[[LocalPlayer_Pointer]+30]+2A8]+588'))
if HealthComponentBase ~=nil then
   adCanDie   = toHex(getAddressSafe('[' .. HealthComponentBase .. ']+310'))
   adCanTakeDamage   = toHex(getAddressSafe('[' .. HealthComponentBase .. ']+311'))


   writeBytes(adCanDie, 0)
   writeBytes(adCanTakeDamage, 0)

memrec.Color = 0x0000FF00 --format AABBGGRR this is bright green

   end

{$ASM}
[DISABLE]
{$LUA}

   writeBytes(adCanDie, 1)
   writeBytes(adCanTakeDamage, 1)

memrec.Color = 0x000000FF -- this is bright red

{$ASM}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>256777</ID>
                      <Description>"Inf. Health [LUA, read value of a pointer and write it to a different pointer]"</Description>
                      <Color>0000FF</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$LUA}
function toHex(str)
  str = string.format("%X", str)
  return str
end

local al = getAddressList()
local t = createTimer(getMainForm())
t.Interval = 50
t.OnTimer = function(checkHealth)
                local mr = al.getMemoryRecordByDescription('Inf. Health')
                if mr.Active == false then
                  t.destroy()
                else if mr ~= nil and mr.Active == true then
                      local KallamariPlayerCharacterBase  = toHex(getAddressSafe('[[LocalPlayer_Pointer]+30]+2A8'))
                      local AttributeSetBase              = toHex(getAddressSafe('['..KallamariPlayerCharacterBase..']+570'))

                      if KallamariPlayerCharacterBase ~= nil and AttributeSetBase ~=nil then
                         adHP             = toHex(getAddressSafe('[' .. KallamariPlayerCharacterBase .. ']+C14'))
                         adHPMax          = toHex(getAddressSafe('[' .. KallamariPlayerCharacterBase .. ']+C10'))
                         adHealthBase     = toHex(getAddressSafe('[' .. AttributeSetBase .. ']+38'))
                         adHealth_Current = toHex(getAddressSafe('[' .. AttributeSetBase .. ']+3C'))
                         adHealth_Max     = toHex(getAddressSafe('[' .. AttributeSetBase .. ']+4C'))

                         if readFloat(adHP) &lt; readFloat(adHPMax) or readFloat(adHealth_Current) &lt; readFloat(adHealth_Max) then
                            writeFloat(adHP, readFloat(adHPMax))
                            writeFloat(adHealthBase, readFloat(adHealth_Max))
                            writeFloat(adHealth_Current, readFloat(adHealth_Max))
                         end
                         memrec.Color = 0x0000FF00
                     end
                  end
              end
end
{$ASM}
[DISABLE]
{$LUA}
memrec.Color = 0x000000FF -- this is bright red
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>353735</ID>
                          <Description>"Instant Level Up"</Description>
                          <Color>0000FF</Color>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
{$LUA}
function toHex(str)
  str = string.format("%X", str)
  return str
end

local al = getAddressList()
local t = createTimer(getMainForm())
t.Interval = 50
t.OnTimer = function(checkHealth)
                local mr = al['Instant Level Up']
                if mr.Active == false then
                  t.destroy()
                else if mr ~= nil and mr.Active == true then
                      local ProgressionComponentBase  = toHex(getAddressSafe('[[[LocalPlayer_Pointer]+30]+2A8]+AD8'))
                      if ProgressionComponentBase ~= nil then
                       adCurrentXP = toHex(getAddressSafe('[' .. ProgressionComponentBase .. ']+D0'))
                       adNextLevelXP = toHex(getAddressSafe('[' .. ProgressionComponentBase .. ']+C8'))

                       if readFloat(adCurrentXP) &lt; readFloat(adNextLevelXP) then
                          writeFloat(adCurrentXP, readFloat(adNextLevelXP))
                       end
                     end
                  end
              end
end

memrec.Color = 0x0000FF00 --format AABBGGRR this is bright green

{$ASM}
[DISABLE]
{$LUA}

memrec.Color = 0x000000FF -- this is bright red

</AssemblerScript>
