                    <CheatEntry>
                      <ID>353399</ID>
                      <Description>"Fill Health [ASM script example to change a pointer value]"</Description>
                      <Color>00FF00</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : FSD-Win64-Shipping.exe
  Version:
  Date   : 2021-11-26
  Author : Akira Fudo
}

{$LUA}
if syntaxcheck then return end
{$ASM}
[ENABLE]
{$LUA}
local memrec = memrec or getAddressList().getMemoryRecordByDescription("[F2] Fill Health")

local timer = createTimer()
timer.Interval = 1 * 1000 --;1000 milliseconds per second
timer.OnTimer = function(theTimerCallingThisFunction)
  memrec.Active = false --;deactivate the script
  timer.destroy() --;destroy the timer so it doesn't keep running
end
{$ASM}
[[[[LocalPlayer_Pointer]+30]+260]+958]+38: //;health.BaseValue
  dd (float)9999

{$ASM}
[[[[LocalPlayer_Pointer]+30]+260]+958]+3C: //;health.CurrentValue
  dd (float)9999
nop

{$LUA}
memrec.Color = 0x0000FF00 --;AABBGGRR Green
{$ASM}
[DISABLE]
{$LUA}
memrec.Color = 0x000000FF --;AABBGGRR Red
{$asm}

</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>239470</ID>
                      <Description>"Entity_Player Pointer [Pointer script example to separate different characters/players]"</Description>
                      <Options moHideChildren="1" moManualExpandCollapse="1"/>
                      <Color>C0C0C0</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : isaac-ng.exe
  Version:
  Date   : 2021-05-05
  Author : Akira Fudo &amp; Mux

Jacob = 19 | Hex 13
Esau = 20 | Hex 14

Entity_Player Pointer -&gt; Character Size -&gt; [1420] Character Size??? (3)
8B 8F 20 14 00 00
8B 8F ? ? ? ? 56 89 48 ? 8B 8F ? ? ? ? 89 48 ? 8D 4F ? E8 ? ? ? ? 80 BD 7A FC FF FF
8Bxxxxxxxxxx56xxxxxx8Bxxxxxxxxxx89xxxxxxxxxxE8xxxxxxxxxxxxxxxxxxxxxx8Dxxxxxx74
}

[ENABLE]

aobscanmodule(Entity_Player,isaac-ng.exe,8Bxxxxxxxxxx56xxxxxx8Bxxxxxxxxxx89xxxxxxxxxxE8xxxxxxxxxxxxxxxxxxxxxx8Dxxxxxx74) // should be unique
alloc(newmem,$40)
alloc(newmem2,$40)

registersymbol(Character_Pointer)
registersymbol(Esau_base)

label(Character_Pointer)
label(Esau_base)
label(code)
label(return)

newmem:
  cmp [edi+00001304],14
  je newmem2
  mov [Character_Pointer],edi
  jmp code

newmem2:
  mov [Esau_base],edi
  jmp code

code:
  mov ecx,[edi+00001420]
  jmp return

Character_Pointer:
  db 00 00 00 00

Esau_base:
  db 00 00 00 00

Entity_Player:
  jmp newmem
  nop
return:
registersymbol(Entity_Player)

[DISABLE]

Entity_Player:
  db 8B 8F 20 14 00 00

unregistersymbol(Entity_Player)
unregistersymbol(Character_Pointer)
unregistersymbol(Esau_base)
dealloc(newmem)
dealloc(newmem2)

