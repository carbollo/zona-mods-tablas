   adDropShip_Y  = toHex(getAddressSafe('[' .. DropShipBase .. ']+1D4'))
   adDropShip_Z  = toHex(getAddressSafe('[' .. DropShipBase .. ']+1D8'))

   writeFloat(adLocalPlayer_X, readFloat(adDropShip_X))
   writeFloat(adLocalPlayer_Y, readFloat(adDropShip_Y))
   writeFloat(adLocalPlayer_Z, (readFloat(adDropShip_Z) + buffer))
