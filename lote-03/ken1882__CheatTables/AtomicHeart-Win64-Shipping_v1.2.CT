                    <CheatEntry>
                      <ID>353293</ID>
                      <Description>"Inf. HP [Double value type example"</Description>
                      <Color>0000FF</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : IEH.exe
  Version:
  Date   : 2022-04-16
  Author : Akira Fudo

Ally1:set_currentHp+7a
F2 0F 11 80 10 01 00 00 48 83
F2 0F ? ? ? ? ? ? 48 83 C4 ? C3 00 01
F2xxxxxxxxxxxxxx48xxxxxxxx00xxxxxx00xxxxxxxx00xxxxxx00xxxxxx00xxxxxx00xxxxxx48xxxxxx48
}

[ENABLE]

aobscanregion(currentHp,Ally1:set_currentHp,Ally1:set_currentHp+86,F2 0F 11 80 10 01 00 00 48 83)
alloc(newmem,$1000,currentHp)

label(code)
label(return)
label(maxHp)

newmem:

code:
  fld qword ptr [maxHp]
  fstp qword ptr [rax+00000110]
  jmp return

maxHp:
  dq (double)Inf

currentHp:
  jmp newmem
  nop 3
return:
registersymbol(currentHp)

{$LUA}
memrec.Color = 0x0000FF00 --;AABBGGRR Green
{$ASM}
[DISABLE]
{$LUA}
memrec.Color = 0x000000FF --;AABBGGRR Red
{$ASM}

currentHp:
  db F2 0F 11 80 10 01 00 00

unregistersymbol(currentHp)
dealloc(newmem)

