                      <ID>256776</ID>
                      <Description>"Enable Dev Settings [script for unity engine to easly change system bool flags]"</Description>
                      <Color>C0C0C0</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : valheim.exe
  Version: 
  Date   : 2021-02-19
  Author : Akira Fudo
}

{$LUA}
if not monopipe then LaunchMonoDataCollector() end
{$ASM}
[enable]
DevSettings:get_Enabled:
mov al,1
ret
nop

[disable]
DevSettings:get_Enabled:
push rbp
mov rbp,rsp
</AssemblerScript>
