{$LUA}
if syntaxcheck then return end
function toHex(str)
  str = string.format("%X", str)
  return str
end
local sCoordX    = toHex(getAddressSafe('PlayerRootComponent_CoordsSave'))
local sCoordY    = toHex(getAddressSafe('PlayerRootComponent_CoordsSave+4'))
local sCoordZ    = toHex(getAddressSafe('PlayerRootComponent_CoordsSave+8'))
local pCoordBase = toHex(getAddressSafe('[[[LocalPlayer_Pointer]+38]+270]+140'))
sleep(1000)
if pCoordBase ~= nil or sCoordXthen ~= nil then
      pCoordX    = toHex(getAddressSafe('[' .. pCoordBase .. ']+230'))
      pCoordY    = toHex(getAddressSafe('[' .. pCoordBase .. ']+234'))
      pCoordZ    = toHex(getAddressSafe('[' .. pCoordBase .. ']+238'))
      writeFloat(pCoordX, readFloat(sCoordX))
      writeFloat(pCoordY, readFloat(sCoordY))
      writeFloat(pCoordZ, readFloat(sCoordZ))
end
createTimer(1000, function() memrec.Active = false end)
memrec.Color=0x0000FF --BGR (Hexdecimal)
{$ASM}
[DISABLE]
{$LUA}
if syntaxcheck then return end
memrec.Color=0x000080 --BGR (Hexdecimal)
