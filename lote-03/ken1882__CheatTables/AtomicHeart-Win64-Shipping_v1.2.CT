          <AssemblerScript>{$LUA}
if syntaxcheck then return end
[ENABLE]
local processPath = enumModules()[1].PathToFile --Path to process executable

function getDir(path)
  local local_path = path
  if local_path == nil then return end
  for dir in local_path:gmatch('(.-)([^\\]-([^%.]+))$') do
      return dir
  end
end

local str,Address
local sub_folder = getDir(processPath) .. '' --Path to process executable + sub folder(s)

str=inputQuery('Game Folder', 'Path', sub_folder)

if str and str~='' then
  ShellExecute(str,Address)
end
{$ASM}
nop
[DISABLE]
