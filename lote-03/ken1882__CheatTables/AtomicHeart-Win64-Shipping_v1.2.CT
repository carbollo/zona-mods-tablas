                  <Description>"HealthAddressCMP"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$LUA}
function toHex(str)
  str = string.format("%X", str)
  return str
end
if syntaxcheck then return end
local al = getAddressList()
local t = createTimer(getMainForm())
t.Interval = 50
t.OnTimer = function(checkAddress)
                local mr = al.getMemoryRecordByDescription('HealthAddressCMP')
                if mr.Active == false then
                  t.destroy()
                else if mr ~= nil and mr.Active == true then
                      local currentHealthBase = toHex(getAddressSafe('GetPlayerArmorTankClass_Pointer'))
                      --local currentUnitCompareBase = toHex(getAddressSafe('PlayerHealthCheck'))

                      if currentHealthBase ~= nil then
                         adAddess         = toHex(getAddressSafe('[[[[' .. currentHealthBase.. ']+270]+160]+0]+30'))
                         adAddressCompare = toHex(getAddressSafe('PlayerHealthCheck'))

                         if readQword(adAddess) ~= readQword(adAddressCompare) then
                            writeQword(adAddressCompare, readQword(adAddess))
                         end
                     end
                  end
              end
end
{$ASM}
