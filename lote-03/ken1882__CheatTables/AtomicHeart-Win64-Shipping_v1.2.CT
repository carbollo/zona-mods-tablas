[ENABLE]

{$LUA}
function toHex(str)
str = string.format("%X", str)
return str
end
if syntaxcheck then return end

local al = getAddressList()
if al ~= nil then
local fallDMGScript = al.getMemoryRecordByDescription('No Fall Damage')
local allowTpScript = al.getMemoryRecordByDescription('Allow Teleport')
fallDMGScript.Active = true
allowTpScript.Active = true
end

local LocalPlayerBase = toHex(getAddressSafe('PlayerCoordinates_Pointer'))
local MapMarkerBase   = toHex(getAddressSafe('MapLastLeftClickCoordinates_Pointer'))
local buffer = 1000

if LocalPlayerBase ~= nil or MapMarkerBase ~= nil then
   adLocalPlayer_X  = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+1D0'))
   adLocalPlayer_Y  = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+1D4'))
   adLocalPlayer_Z  = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+1D8'))
   adMapMarker_X    = toHex(getAddressSafe('[' .. MapMarkerBase .. ']+3A0'))
   adMapMarker_Y    = toHex(getAddressSafe('[' .. MapMarkerBase .. ']+3A4'))
   writeFloat(adLocalPlayer_X, readFloat(adMapMarker_X))
   writeFloat(adLocalPlayer_Y, readFloat(adMapMarker_Y))
   writeFloat(adLocalPlayer_Z, (readFloat(adLocalPlayer_Z) + buffer))
   --writeFloat(adLocalPlayer_Z, readFloat(adMapMarker_Z))
   memrec.Color = 0x0000FF00 --AABBGGRR Green
end

createTimer(1000, function() memrec.Active = false end)
memrec.Color = 0x0000FF
{$ASM}
[DISABLE]
{$LUA}
memrec.Color = 0x000080
{$ASM}

</AssemblerScript>
