        <CheatEntry>
          <ID>31298</ID>
          <Description>"Research"</Description>
          <Options moHideChildren="1"/>
          <LastState Value="" RealAddress="00000000"/>
          <Color>FFFFFF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>40297</ID>
              <Description>"max stack size of the items on 1 - 8"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : valheim.exe
  Version: 
  Date   : 2021-02-10
  Author : Akira Fudo

  Max stack size of the items on 1 - 8
}

[ENABLE]

aobscan(m_maxStackSize,48 63 80 E0 00 00 00 83 F8 01 0F 8E C7) // should be unique
alloc(newmem,$1000,m_maxStackSize)

label(code)
label(return)

newmem:

code:
  movsxd  rax,dword ptr [rax+000000E0]
  jmp return

m_maxStackSize:
  jmp newmem
  nop 2
return:
registersymbol(m_maxStackSize)

[DISABLE]

m_maxStackSize:
  db 48 63 80 E0 00 00 00

unregistersymbol(m_maxStackSize)
dealloc(newmem)

