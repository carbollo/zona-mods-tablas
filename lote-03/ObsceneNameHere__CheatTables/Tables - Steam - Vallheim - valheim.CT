registerSymbol(ZNetScene)
registerSymbol(ZNetScene_base)

alloc(newmem, 1024, ZNetScene)
label(originalcode)
label(after)
label(ZNetScene_base)

newmem:

originalcode:
  cmp dword ptr [rcx],00
  add rax,000000B8

after:
  mov [ZNetScene_base],rcx
  jmp return

ZNetScene_base:
  db 00 00 00 00

ZNetScene:
  jmp newmem
  nop 4
return:
registersymbol(ZNetScene)

