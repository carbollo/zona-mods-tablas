        <CheatEntry>
          <ID>17365</ID>
          <Description>"[X] &lt;== Console in Ironman by littleeon"</Description>
          <Options moHideChildren="1"/>
          <Color>C08000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : stellaris.exe
  Version: 4.3.3
  Date   : 2022-09-23
  Author : littleeon
         Updater:  Fuwa
         Version:  4.4.1
         Date:     2026-06-16
}

[ENABLE]
{$lua}
local p7 = {0x48, 0x39, 0xC0, 0x90, 0x90, 0x90, 0x90}
local p2 = {0x90, 0x90}
local modBase = getAddress("stellaris.exe")
local modSize = getModuleSize("stellaris.exe")
local modEnd = modBase + modSize
local saved = {}

local function findAll(pattern)
  local addrs = {}
  local results = AOBScan(pattern, "+X-C-W")
  if results then
    for i = 0, results.Count - 1 do
      local addr = getAddress(results[i])
      if addr &gt;= modBase and modEnd &gt; addr then
        table.insert(addrs, addr)
      end
    end
    results.destroy()
  end
  return addrs
end

local function patch(addr, bytes)
  local orig = {readBytes(addr, #bytes, true)}
  table.insert(saved, {addr=addr, orig=orig, size=#bytes})
  writeBytes(addr, bytes)
end

-- If this function ever causes actual problems, then the reason is that it overwrites all hits
-- even non relevant / unrelated functions,
-- but that might be a problem for the future for anyone interested to make it work again
-- Console1: cmp [rbx+A9],0 / je
for _, a in ipairs(findAll("80 BB A9 00 00 00 00 74")) do
  patch(a, p7)
end

-- Console2: cmp [rbx+A8],0 / jne
for _, a in ipairs(findAll("80 BB A8 00 00 00 00 0F 85")) do
  patch(a, p7)
end

-- Console3: cmp [rbx+A8],0 / je
local c3 = findAll("80 BB A8 00 00 00 00 74")
if #c3 == 0 then
  local generic = findAll("80 BB ?? 00 00 00 00 74 ?? C6 ?? ?? 00")
  for _, a in ipairs(generic) do
    local b = readBytes(a + 2, 1)
    if b ~= 0xA9 and b ~= 0x48 then
      table.insert(c3, a)
    end
  end
end
for _, a in ipairs(c3) do
  patch(a, p7)
end

-- Console4: dev mode check
for _, a in ipairs(findAll("?? 38 ?? ?? ?? 00 00 75 05 ?? 32 ?? EB 03 ?? B7 01")) do
  patch(a + 7, p2)
end

-- Store saved bytes globally for disable
_G.consoleSaved = saved

[DISABLE]
{$lua}
if _G.consoleSaved then
  for _, entry in ipairs(_G.consoleSaved) do
    writeBytes(entry.addr, entry.orig)
  end
  _G.consoleSaved = nil
end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>17377</ID>
