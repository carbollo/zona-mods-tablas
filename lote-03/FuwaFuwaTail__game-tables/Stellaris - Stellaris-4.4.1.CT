        <CheatEntry>
          <ID>7207</ID>
          <Description>"-- ! -- Activate Modded Achievements before main menu (during game startup) if using NAC mods -- ! --"</Description>
          <Color>0080FF</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>7205</ID>
          <Description>"[X] &lt;== Enable Modded Achievements"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>C08000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : stellaris.exe
  Version:
  Date   : 2022-09-23
  Author : Nameless
         Updater:  Fuwa
         Version:  4.4.1
         Date:     2026-06-16

  This script does blah blah blah
}


//=========================================
 [ENABLE]
//=========================================
define(LUDO,"stellaris.exe")

// To find:
// CHECKSUM_PATCH    -&gt; search for string "common/achievements.txt"
//                   -&gt; replace first 85 CO (test eax, eax) BELOW with 31 CO (xor eax, eax)
// CHECKSUM_WARNING  -&gt; search for string "vx.x.x" (replace the "x" with the version numbers, e.g. v4.4.1)
//                   -&gt; replace first 85 C0 (test eax, eax) ABOVE with 31 C0 (xor eax, eax)
// TOOLTIP_PATCH     -&gt; search for string "ACHIEVEMENT_TOOLTIP_CHECKSUM"
//                   -&gt; replace first 85 CO (test eax, eax) ABOVE with 31 C0 (xor eax, eax)

aobScanModule(CHECKSUM_PATCH,stellaris.exe,E8 34 AA FD 01 8B F8 85 C0)
aobScanModule(CHECKSUM_WARNING,stellaris.exe, E8 24 7C 28 01 85 C0)
aobScanModule(TOOLTIP_PATCH,stellaris.exe, E8 03 73 28 01 85 C0)

registersymbol(CHECKSUM_PATCH)
registersymbol(CHECKSUM_WARNING)
registersymbol(TOOLTIP_PATCH)

CHECKSUM_PATCH+7:
  db 31 C0

CHECKSUM_WARNING+5:
  db 31 C0

TOOLTIP_PATCH+5:
  db 31 C0

//=========================================
 [DISABLE]
//=========================================

CHECKSUM_PATCH+7:
  db 85 C0

CHECKSUM_WARNING+5:
  db 85 C0

TOOLTIP_PATCH+5:
  db 85 C0

unregistersymbol(CHECKSUM_PATCH)
unregistersymbol(CHECKSUM_WARNING)
unregistersymbol(TOOLTIP_PATCH)

/*

//=========================================
// Extra information
//=========================================

Injection addresses as per Version 4.3.7
//aobScanModule(CHECKSUM_PATCH,stellaris.exe,E8 74 B5 E7 01 8B F8 85 C0)
//aobScanModule(CHECKSUM_WARNING,stellaris.exe,75 0D E8 E7 57 B9 01 85 C0)
//aobScanModule(TOOLTIP_PATCH,stellaris.exe,01 E8 23 94 1D 01 85 C0 0F)
*/



