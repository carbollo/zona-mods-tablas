stellaris.exe+1B6D4F: 41 80 BE C8 00 00 00 00  - cmp byte ptr [r14+000000C8],00
// ---------- INJECTING HERE ----------
stellaris.exe+1B6D57: 75 30                    - jne stellaris.exe+1B6D89
// ---------- DONE INJECTING  ----------
stellaris.exe+1B6D59: 49 8B 8E B8 00 00 00     - mov rcx,[r14+000000B8]
stellaris.exe+1B6D60: 48 83 C1 30              - add rcx,30
stellaris.exe+1B6D64: 48 8B 01                 - mov rax,[rcx]
stellaris.exe+1B6D67: FF 50 70                 - call qword ptr [rax+70]
stellaris.exe+1B6D6A: 49 8B 86 C0 00 00 00     - mov rax,[r14+000000C0]
