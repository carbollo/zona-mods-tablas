        <CheatEntry>
          <ID>17371</ID>
          <Description>"[X] &lt;== Allow Achievements with Console Commands"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>C08000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : stellaris.exe
  Version:
  Date   : 2022-09-23
  Author : Nameless
         Updater:  Fuwa
         Version:  4.4.1
         Date:     2026-06-16

  This script does blah blah blah
}


//=========================================
 [ENABLE]
//=========================================
define(LUDO,"stellaris.exe")

// To find: Search string "EXECUTED_COMMAND_SUCCESS_CHAT_MESSAGE"
// Jump to the function that references it (7FF7EF5C3460 in 4.3.7)
// Two writes disabled: mov byte ptr [rax+FC],1 and mov byte ptr [rax+83],1
// These only execute when [rbx+178]==0 and r8b!=0 (command succeeded)
// AOB anchored on: test r8b,r8b + je (45 84 C0 0F 84 2B 03 00 00)
// If pattern breaks, search "EXECUTED_COMMAND_SUCCESS_CHAT_MESSAGE"
// and look ~50 bytes above for the two mov byte ptr [rax+??],1 writes
aobScanModule(CONSOLE_ACH,stellaris.exe,45 84 C0 0F 84 2B 03 00 00 48 8D 05 ?? ?? ?? ?? 48 89 44 24 50)

registersymbol(CONSOLE_ACH)

CONSOLE_ACH+33:
  db 90 90 90 90 90 90 90

CONSOLE_ACH+3A:
  db 90 90 90 90 90 90 90

//=========================================
 [DISABLE]
//=========================================

CONSOLE_ACH+33:
  db C6 80 FC 00 00 00 01

CONSOLE_ACH+3A:
  db C6 80 83 00 00 00 01

unregistersymbol(CONSOLE_ACH)


