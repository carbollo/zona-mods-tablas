                <CheatEntry>
                  <ID>7321</ID>
                  <Description>"[X] &lt;== Race Editing/Creation =========="</Description>
                  <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
                  <Color>404080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//=========================================
// Checking CE version
//=========================================

{$lua}
  if(getCEVersion() &lt; 6.7) then
    ShowMessage('Sorry. CE version should be 6.7 or above')
  end
{$asm}

//=========================================
// Checking Selected Process
//=========================================

{$lua}
  if(process == nil) then
    ShowMessage('No process was selected')
  elseif (process ~= "stellaris.exe") then
    ShowMessage('Error. Expected Process = stellaris.exe')
  end
{$asm}

//=========================================
 [ENABLE]
//=========================================

//=========================================
// Definitions
//=========================================

define(LUDO,"stellaris.exe")
// define(MSPC,"stellaris.exe"+0074C77C)
{
if pSpecies is not filled:
Search in memory for "Biological", should find 2 (all-caps, camel-case) $28 apart apart, $10 before first is the "key"
Search for "key", should get 6 hits, put addresses to id 0, 1, 2 in a row, find the pointer to the list. Search for the list
using pointer scan with offset (usually 0, 40 or 0, 0, 40)

Cheat mode, AOB scan for:
?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 42 49 4F 4C 4F 47 49 43 41 4C ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 42 69 6F 6C 6F 67 69 63 61 6C

for ethics and civic points search for "ETHOS_MAX_POINTS" and "GOVERNMENT_CIVIC_POINTS_BASE" respectively, scroll a bit up to find offset.
These are usually grouped together.
}


{
== Finding the species code ==
 Sourced from this file:
 \Stellaris\common\species_archetypes\00_species_archetypes.txt
}

