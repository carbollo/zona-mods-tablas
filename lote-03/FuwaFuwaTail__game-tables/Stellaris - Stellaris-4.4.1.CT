          <CheatEntries>
            <CheatEntry>
              <ID>17380</ID>
              <Description>"[X] &lt;== Console in Ironman"</Description>
              <Options moHideChildren="1"/>
              <Color>C08000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : stellaris.exe
  Version: 
  Date   : 2022-09-23
  Author : Nameless

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(EnableConsole1,stellaris.exe,75 30 49 8B 8E A0 00 00 00) // should be unique
aobscanmodule(EnableConsole2,stellaris.exe,44 38 A1 DF 00 00 00) // should be unique
alloc(newmem,$1000,EnableConsole1)

label(ConsoleKey)
label(ConsoleAvailable)
label(return_consolekey)
label(return_consoleavailable)

registersymbol(EnableConsole1)
registersymbol(EnableConsole2)

newmem:

ConsoleKey:
  //jne stellaris.exe+1B6D89
  //jne stellaris.exe+A4389C - 3.6.0
  mov rcx,[r14+00000090]
  jmp return_consolekey
  
ConsoleAvailable:
  cmp eax,eax
  jmp return_consoleavailable
  

EnableConsole1:
  jmp ConsoleKey
  nop 4
return_consolekey:

EnableConsole2:
  jmp ConsoleAvailable
  nop 2
return_consoleavailable:


[DISABLE]

EnableConsole1:
  db 75 30 49 8B 8E A0 00 00 00

EnableConsole2:
  db 44 38 A1 DF 00 00 00

unregistersymbol(EnableConsole1 EnableConsole2)
dealloc(newmem)

{
