[ENABLE]

aobscanmodule(SpyMission,stellaris.exe,48 29 86 B0 02 00 00) // should be unique
alloc(newmem,$1000,SpyMission)

label(code)
label(return)

newmem:
  push rbx
  push rcx
  mov rbx,[rbp+B8]
  mov rcx,pPlayer
  mov rcx,[rcx]
  cmp rcx,rbx
  jne code
  mov [rsi+000002B0],rax


code:
  pop rbx
  pop rcx
  sub [rsi+000002B0],rax

  jmp return

SpyMission:
  jmp newmem
  nop 2
return:
registersymbol(SpyMission)

[DISABLE]

SpyMission:
  db 48 29 86 B0 02 00 00

unregistersymbol(SpyMission)
