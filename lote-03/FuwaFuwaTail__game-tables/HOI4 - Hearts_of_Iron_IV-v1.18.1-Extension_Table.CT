          <ID>7355</ID>
          <Description>"[X] &lt;== Upgrade some equipment to 99"</Description>
          <Color>C08000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : hoi4.exe
  Version: 
  Date   : 2022-10-08
  Author : Nameless

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(UpgradeLevel,$process,41 38 AD 34 01 00 00) // should be unique
aobscanmodule(UPXP,$process,8B 08 89 8F D8 09 00 00) //8B 08 89 8D 20 01 00 00

alloc(newmem,$1000,UpgradeLevel)

label(code)
label(return)
label(noxpcost)
label(return_upxp)

registersymbol(UpgradeLevel)
registersymbol(UPXP)


newmem:

code:
  mov [r13+00000134],#99
  cmp [r13+00000134],bpl
  
  jmp return

noxpcost:
  mov ecx,500
  mov [rdi+000009D8],ecx
  jmp return_upxp

UpgradeLevel:
 jmp newmem
  nop 2
return:

UPXP:
  jmp noxpcost
  nop
  nop
  nop
return_upxp:

[DISABLE]

UpgradeLevel:
  db 41 38 AD 34 01 00 00

UPXP:
  db 8B 08 89 8F D8 09 00 00


