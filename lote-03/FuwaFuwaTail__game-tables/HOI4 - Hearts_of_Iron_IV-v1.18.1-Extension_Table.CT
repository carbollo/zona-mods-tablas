        <CheatEntry>
          <ID>0</ID>
          <Description>"[X] &lt;== Enable Console/Developer Mode in Ironman"</Description>
          <Options moHideChildren="1"/>
          <Color>008000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : hoi4.exe
  Version:
  Date   : 2022-09-30
  Author : Nameless
  Updated:
          Version: 1.18.1
          Date:    2026-05-05
          Updater: Fuwa

  This script does blah blah blah

  To find the CHP6 and CHP7 bits:
  Find the string "Command available only for developers", put a breakpoint on the mov above (in non-ironman).
  Run "focus.autocomplete", and it shoudl break. Get the basepointer, get the struct, get the offset bool into the address list,
  "what accesses.."

  run "xp 50" to get the normal one (CHP6)
  run "focus.autocomplete" (again), to get those. (CHP7)


}

{
define(CHP1,hoi4.exe+B51BED) //1.12.2 -&amp;gt; Enable console key
define(CHP2,hoi4.exe+1B8108A) //1.12.2 -&amp;gt; ("Console not available in multiplayer or ironman mode.")
define(CHP3,hoi4.exe+1B81140) //1.12.2 -&gt; ("Command available only for developers.") the JE a bit above
define(CHP4,hoi4.exe+1B81167) //1.12.2 -&gt; Only a little below CHP3, mov byte ptr [r15+000000D1],01. AOB hits one before
define(CHP5,hoi4.exe+1B81142) //1.12.2 -&gt; Just above "Command available only for developers.",  mov byte ptr [r15+000000D0],00, AOB hits one before
define(CHP5b,hoi4.exe+20b3ae7) // 1.13.7 -&gt; A bit above "command"
define(CHP6,hoi4.exe+1B8128) //1.12.2 -&gt;  mov [r15+000000D0],cl, AOB hits 7 before
define(CHP7,hoi4.exe+1B82900) //1.12.2 -&gt; Separate function,  mov [rcx+000000D0],dl, AOB hits one before

}

[ENABLE]

aobscanmodule(CHP1,hoi4.exe,84 C0 0F 84 ?? ?? ?? ?? 48 8B CF E8 ?? ?? ?? ?? E9 ?? ?? ?? ?? 49)

// Enable console in multiplayer and ironman
aobScanModule(CHP2,$process, 84 C0 75 1A 49 8B 8D 90 00 00 00 48 85 C9 )

// Developer commands
aobscanmodule(CHP3,hoi4.exe,74 1E 41 C6 07 00)

// Crash on console use
//aobscanmodule(CHP6,hoi4.exe, 41 88 ?? D8 00 00 00) -&gt; brute forced it
aobscanmodule(CHP6,hoi4.exe, 41 88 B7 D8 00 00 00)
aobscanmodule(CHP6b,hoi4.exe, 0F B6 45 90 41 88 85 D8 00 00 00)
aobscanmodule(CHP6c,hoi4.exe, 41 88 85 D8 00 00 00 48 83 7D B0 00)
aobscanmodule(CHP6d,hoi4.exe, 41 88 85 D8 00 00 00 48 83 7D D8 00)

// Crash on console use on focus.autocomplete
aobScanModule(CHP7,$process, CC 88 91 D8 00 00 00 C3 CC)
// 1.16: CC 88 91 D8 00 00 00 C3 CC ;;;  CC 88 91 ?? 00 00 00 C3 CC

/*
hoi4.exe+1B81087 - FF 50 10              - call qword ptr [rax+10]
CHP2             - 84 C0                 - test al,al
hoi4.exe+1B8108C - 75 1A                 - jne hoi4.exe+1B810A8 &lt;-- Nop out
hoi4.exe+1B8108E - 49 8B 8F 88000000     - mov rcx,[r15+00000088]
*/

registersymbol(CHP1 CHP2 CHP3 CHP6 CHP6b CHP6c CHP6d CHP7)
newmem:

CHP1+2:
 nop
 nop
 nop
 nop
 nop
 nop

CHP2+2:
 db 90 90         // replace jne with nop, never jump

CHP3:
 db eb

CHP6:
 nop
 nop
 nop
 nop
 nop
 nop
 nop

CHP6b+4:
 nop
 nop
 nop
 nop
 nop
 nop
 nop

CHP6c:
 nop
 nop
 nop
 nop
 nop
 nop
 nop

CHP6d:
 nop
 nop
 nop
 nop
 nop
 nop
 nop

CHP7+1:
 nop
 nop
 nop
 nop
 nop
 nop

[DISABLE]

CHP1+2:
  db 0F 84 B1 02 00 00

CHP2+2:
 db 74 35

CHP3:
 db 74

CHP6:
 //mov [r13+000000D8],al
 db 41 88 85 D8 00 00 00

CHP6b+4:
 db 41 88 85 D8 00 00 00

CHP6c:
 db 41 88 85 D8 00 00 00

CHP6d:
 db 41 88 85 D8 00 00 00

CHP7+1:
 //mov [rcx+000000D8],dl
 db CC 88 91 D8 00 00 00 C3 CC

unregistersymbol(*)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: hoi4.exe+B51BEF

hoi4.exe+B51BC3: 48 8B CF              - mov rcx,rdi
hoi4.exe+B51BC6: E8 15 02 B9 00        - call hoi4.exe+16E1DE0
hoi4.exe+B51BCB: E9 D6 02 00 00        - jmp hoi4.exe+B51EA6
hoi4.exe+B51BD0: 48 8B 0D D1 33 F0 01  - mov rcx,[hoi4.exe+2A54FA8]
hoi4.exe+B51BD7: 48 85 C9              - test rcx,rcx
hoi4.exe+B51BDA: 75 0C                 - jne hoi4.exe+B51BE8
hoi4.exe+B51BDC: E8 2F F3 02 01        - call hoi4.exe+1B80F10
hoi4.exe+B51BE1: 48 8B 0D C0 33 F0 01  - mov rcx,[hoi4.exe+2A54FA8]
hoi4.exe+B51BE8: E8 C3 F2 02 01        - call hoi4.exe+1B80EB0
hoi4.exe+B51BED: 84 C0                 - test al,al
// ---------- INJECTING HERE ----------
hoi4.exe+B51BEF: 0F 84 B1 02 00 00     - je hoi4.exe+B51EA6
// ---------- DONE INJECTING  ----------
hoi4.exe+B51BF5: 48 8B CF              - mov rcx,rdi
hoi4.exe+B51BF8: E8 83 03 B9 00        - call hoi4.exe+16E1F80
hoi4.exe+B51BFD: E9 A4 02 00 00        - jmp hoi4.exe+B51EA6
hoi4.exe+B51C02: 49 8B CE              - mov rcx,r14
hoi4.exe+B51C05: E8 36 52 D7 00        - call hoi4.exe+18C6E40
hoi4.exe+B51C0A: 49 8B CE              - mov rcx,r14
hoi4.exe+B51C0D: 84 C0                 - test al,al
hoi4.exe+B51C0F: 74 14                 - je hoi4.exe+B51C25
hoi4.exe+B51C11: E8 7A 47 D7 00        - call hoi4.exe+18C6390
hoi4.exe+B51C16: 8B D0                 - mov edx,eax
}
</AssemblerScript>
