        <CheatEntry>
          <ID>3703</ID>
          <Description>"[X] &lt;== Minimum Fuel (Requires player pointer)"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>008000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//=========================================
// Definitions
//=========================================
{
define(MOMF+5,"hoi4.exe"+005C8DB8)

define(MOMF+5, "hoi4.exe"+0099CA97) 
}
//=========================================
[ENABLE]
//=========================================

{$LUA}
memrec.Color = 0x00008000
{$ASM}

label(_BackMMF)
label(_ExitMMF)

aobScanModule(MOMF,$process,48 8B 51 10 48 89 54 24 50)

registerSymbol(_MonMinFuel)
registerSymbol(MOMF)

//=========================================
alloc(_MonMinFuel,512,$process)
//=========================================
_MonMinFuel:
 push rax
 push rbx
 mov rax,[pPlayer]
 cmp [rcx+000000B0],rax
 jne _ExitMMF

 mov rbx, #8192000000 //#2228224000
 cmp [rcx+10],rbx
 jns _ExitMMF

 mov [rcx+10],rbx

_ExitMMF:
 pop rbx
 pop rax
 mov rdx,[rcx+10]
 mov [rsp+50],rdx 
jmp _BackMMF

MOMF:
 jmp _MonMinFuel
 nop
 nop
 nop
 nop
_BackMMF:

//=========================================
[DISABLE]
//=========================================
// This part restores all original code
//=========================================

{$LUA}
memrec.Color = 0x00c08000
{$ASM}

MOMF:
//mov rdx,[rcx+10]
//mov [rsp+50],rdx
  db 48 8B 51 10 48 89 54 24 50

unregisterSymbol(_MonMinFuel)
unregisterSymbol(MOMF)

dealloc(_MonMinFuel)
</AssemblerScript>
