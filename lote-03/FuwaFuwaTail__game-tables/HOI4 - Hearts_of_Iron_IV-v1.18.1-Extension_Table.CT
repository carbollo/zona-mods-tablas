  Author : Nameless

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(GetPPlayer,hoi4.exe,48 8B 01 FF 50 48 48 8D 95 80) // should be unique
alloc(newmem,$1000,GetPPlayer)

label(code)
label(return)
label(pPlayer)
registersymbol(GetPPlayer)
registersymbol(pPlayer)

newmem:

code:
  mov [pPlayer],rcx
  mov rax,[rcx]
  call qword ptr [rax+48]
  jmp return
  
pPlayer:
 dq 0

GetPPlayer:
  jmp newmem
  nop
return:

