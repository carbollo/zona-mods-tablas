  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Keep Firing (Hold Middle Mouse BTN)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(playercode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here
// edi registry has the following
/**
Offset     Player    Enemy
3C         0         1
44         2         0
4C         Inf       0
5C         0         1
**/

cmp [edi+3C], 0
je playercode

originalcode:
mov eax,[edi+40]
test eax,eax
jmp exit

playercode:
mov eax,#1
test eax,eax
jmp exit

exit:
jmp returnhere

