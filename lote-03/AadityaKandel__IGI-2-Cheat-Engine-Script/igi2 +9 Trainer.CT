label(enemycode)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here

// rsp registry for enemies has common value of 0x19F790
// edi registry has the following
/**
Offset     Player    Enemy
3C         0         1
44         2         0
4C         Inf       0
5C         0         1
**/
cmp [edi+3C], 0
jne enemycode

originalcode:
mov [edi+48], #0
mov eax,[edi+48]
test eax,eax
jmp exit

enemycode:
mov eax, #10
test eax,eax
jmp exit

exit:
jmp returnhere

