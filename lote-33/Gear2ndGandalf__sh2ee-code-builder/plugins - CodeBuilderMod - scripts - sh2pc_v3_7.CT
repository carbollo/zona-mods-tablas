              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : sh2pc.exe
  Version: 1.0
  Date   : 2023-08-08
  Author : Gear2

  Set complex fog mode on or off.

  Off will let you use the flashlight but enemies will be blind
  in the overworld with your flashlight turned off. You will need
  the flashlight to pick up items even in the day.

  On will disable the flashlight and enemies will always see you.
}

[ENABLE]

{$lua}
if syntaxcheck then return end
messageDialog('CHEAT INFO', 'When complex fog is off James cannot pick up items without the flashlight.', mtInformation, mbOK)
{$asm}

assert("d3d8.dll"+783CB,0F B7 00 48 89 41 1C)
define(complexFogMode,"d3d8.dll"+783CB)
registersymbol(complexFogMode)
registersymbol(complexValue)

alloc(newmem,2048)
alloc(complexValue,4)

label(code)
label(return)

complexValue:
  db 0

newmem:
  push ebx
  mov ebx,[complexValue]
  mov [eax],ebx
  movzx eax,word ptr [eax]
  dec eax
  mov [ecx+1C],eax
  pop ebx
  jmp return

code:
  //movzx eax,word ptr [eax]
  //dec eax
  //mov [ecx+1C],eax
  //jmp return

complexFogMode:
  jmp newmem
  nop 2
return:

[DISABLE]

complexFogMode:
  db 0F B7 00 48 89 41 1C

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
