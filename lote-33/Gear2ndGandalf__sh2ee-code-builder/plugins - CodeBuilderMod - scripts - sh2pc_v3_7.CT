            <CheatEntry>
              <ID>35152</ID>
              <Description>"Burst Fire"</Description>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

[ENABLE]

--=============================================================
-- CONFIGURATION
--=============================================================
BURST = {
  gateToGameplay   = true,   -- see the note at the gate below
  restoreOnDisable = true,
  interval         = 100,
  burstValue       = 0x00,   -- 0 = Burst Fire, anything else = Normal Fire
}

getLuaEngine().cbShowOnPrint.Checked = false

--=============================================================
-- COMMON HELPERS
--=============================================================

-- getMemoryRecordByDescription() returns nil when the description
-- is missing or has been renamed.  Calling :getCurrentAddress() on
-- nil gives an unreadable error, so name the record instead.
local function rec(al, desc)
  local r = al.getMemoryRecordByDescription(desc)
  if r == nil then error('Memory record not found: "' .. desc .. '"', 0) end
  local a = r:getCurrentAddress()
  if a == nil or a == 0 then error('Record "' .. desc .. '" resolved to 0', 0) end
  return a
end

-- getAddress() RAISES on an unknown symbol, it does NOT return nil.
-- Every "if not addr then return end" guard was therefore dead code.
local function sym(name)
  local ok, a = pcall(getAddress, name)
  if ok and a ~= nil and a ~= 0 then return a end
  return nil
end

-- Liveness canary.  _G outlives the game process, so a nil check on
-- a stored address proves nothing (notebook: Cautions / Scripting).
-- Read the module's own MZ header back instead.
local function processLive()
  local base = sym('sh2pc.exe')
  if base == nil then return false end
  return readSmallInteger(base) == 0x5A4D
end

--=============================================================
-- RESOLVE RECORDS
--=============================================================
if not processLive() then error('sh2pc.exe is not attached', 0) end

local al = getAddressList()
local storeFire  = rec(al, 'Firing Mode')
local storeMenu  = rec(al, 'Menu Event ID')
local storeEvent = rec(al, 'Event ID')
local storeScene = rec(al, 'Cutscene ID')

-- WHAT THIS FIELD ACTUALLY IS
-- 'Firing Mode' is sh2pc.exe+1BB1124.  The James entity struct starts at
-- sh2pc.exe+1BB1000, so this is entity +0x124 -- live per-entity state,
-- not a persistent settings global.  Confirmation that 1BB1000 is the
-- struct base: PosX sits at +0x01C and PosY at +0x024, which are exactly
-- the two offsets the "Enemy In Range" AA hook reads off eax.
-- Health is +0x13C and max health +0x140, both in the same block.
--
-- That block is repopulated whenever a save or a level is loaded, which
-- is why the gate below matters.

-- Original value, captured lazily (see the timer)
origFire     = nil
origFireAddr = storeFire

--=============================================================
-- TIMER
--=============================================================
if burstFire then burstFire.destroy() end
burstFire          = createTimer(nil, false)
burstFire.Interval = BURST.interval
burstFire.OnTimer  = function(t)

  if not processLive() then return end

  -- readByte returns nil on a failed read.  The old code went straight
  -- into "fire &gt; 0", which throws "attempt to compare nil with number"
  -- -- and with the Lua console hidden you would never have seen it.
  local menu  = readByte(storeMenu)
  local event = readByte(storeEvent)
  local scene = readByte(storeScene)
  if menu == nil or event == nil or scene == nil then return end

  -- Verify gameplay is unlocked.
  -- This gate is NEW.  Burst Fire was the only timer in the set without
  -- it, so it wrote into the James entity struct every 100 ms on the main
  -- menu, through load screens and during cutscenes -- while the loader
  -- is repopulating that exact block.  Same class of ungated write that
  -- put the other scripts under suspicion for the load crash.
  if BURST.gateToGameplay then
    if menu ~= 0x0D or event ~= 0x04 or scene ~= 0x00 then return end
  end

  local fire = readByte(storeFire)
  if fire == nil then return end

  -- Begin logic
  if fire ~= BURST.burstValue then
    -- Capture the first real in-gameplay value so DISABLE has something
    -- honest to put back.  Capturing at enable time would have grabbed
    -- whatever was in the struct on the main menu, which is meaningless.
    if origFire == nil then origFire = fire end
    writeByte(storeFire, BURST.burstValue)
  end
end

burstFire.Enabled = true

--=============================================================
-- CONSOLE HELPER
--=============================================================
function burstFireStatus()
  local live = readByte(origFireAddr)
  print(string.format('[BurstFire] live=%s  captured original=%s  gated=%s  interval=%dms',
                      tostring(live), tostring(origFire),
                      tostring(BURST.gateToGameplay), BURST.interval))
end

[DISABLE]

if burstFire then
    burstFire.Enabled = false
    burstFire.destroy()
    burstFire = nil
end

-- Put the field back.  The original script captured nothing, so disabling
-- it left James in burst mode until the game happened to rewrite the byte.
if BURST and BURST.restoreOnDisable and origFire ~= nil and origFireAddr ~= nil then
  pcall(writeByte, origFireAddr, origFire)
end
origFire     = nil
origFireAddr = nil

burstFireStatus = nil

</AssemblerScript>
            </CheatEntry>
