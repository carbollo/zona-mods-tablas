assert(sh2pc.exe+127309,D9 58 ? A1)
define(positionX,sh2pc.exe+127309)
alloc(newmem,2048)
alloc(playerPos,16)
alloc(enemySlots,128)  // 8 slots * 16 bytes each (X, Y, valid, padding)
alloc(enemyTypes,32)   // 8 slots * 4 bytes each (type ID)
alloc(slotIndex,4)
label(isEnemy writeSlot return)
newmem:
  cmp [eax+10],00000200
  jae isEnemy
  // Player
  push ebx
  mov ebx,[eax+1C]
  mov [playerPos],ebx
  mov ebx,[eax+24]
  mov [playerPos+4],ebx
  pop ebx
  fstp dword ptr [eax+1C]
  mov eax,[sh2pc.exe+1B8F25C]
  jmp return
isEnemy:
  push ebx
  push ecx
  push edx
  // Check if this is a new "frame" by seeing if slotIndex needs reset
  // Simple heuristic: if we've written 8 slots, wrap to 0
  mov ebx,[slotIndex]
  cmp ebx,8
  jb writeSlot
  xor ebx,ebx
  mov [slotIndex],ebx
writeSlot:
  // Calculate slot offset: ebx * 16 for enemySlots
  mov ecx,ebx
  shl ecx,4
  // Write X to enemySlots + offset
  mov edx,[eax+1C]
  mov [enemySlots+ecx],edx
  // Write Y to enemySlots + offset + 4
  mov edx,[eax+24]
  mov [enemySlots+ecx+4],edx
  // Mark slot as valid
  mov edx,1
  mov [enemySlots+ecx+8],edx
  // Calculate type offset: ebx * 4 for enemyTypes
  mov ecx,ebx
  shl ecx,2
  // Write enemy type ID
  movzx edx,word ptr [eax+10]
  mov [enemyTypes+ecx],edx
  // Increment slot index
  mov ebx,[slotIndex]
  inc ebx
  mov [slotIndex],ebx
  pop edx
  pop ecx
  pop ebx
  fstp dword ptr [eax+1C]
  mov eax,[sh2pc.exe+1B8F25C]
  jmp return
positionX:
  jmp newmem
  nop 3
return:
registersymbol(playerPos enemySlots enemyTypes slotIndex positionX)

[DISABLE]
positionX:
  db D9 58 1C A1 5C F2 F8 01
unregistersymbol(positionX)
unregistersymbol(playerPos)
unregistersymbol(enemySlots)
unregistersymbol(enemyTypes)
unregistersymbol(slotIndex)
dealloc(*)
