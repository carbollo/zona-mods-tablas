label(pyramid lips daddy eddie eddieReturns pyramids final return)

hpPyramid:
  dd (float)7000 // Set to extra

hpFlesh:
  dd (float)8000 // Set to extra

hpDaddy:
  dd (float)10000 // Set to extra

hpEddie:
  dd (float)5000 // Set to extra

hpEddieAlt:
  dd (float)12000 // Set to extra

hpTwoPyramids:
  dd (float)30000 // Set to extra

hpMary:
