<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>35096</ID>
      <Description>"Attach SH2EE"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]

-- Hide LUA warnings
getLuaEngine().cbShowOnPrint.Checked = false
getLuaEngine().hide()

-- Verify the game is actually running before attaching
local pid = getProcessIDFromProcessName("sh2pc.exe")
if pid == nil or pid == 0 then
    error("Failed to open sh2pc.exe - is the game running?")
end

-- Attach to the current process (forces a fresh attachment)
openProcess(pid)

-- Confirm attachment succeeded
if getOpenedProcessID() ~= pid then
    error("Could not attach to sh2pc.exe")
end

-- Monitor the process; auto-disable this script if the game closes
if processMonitor then processMonitor.destroy() end
processMonitor = createTimer(nil, false)
processMonitor.Interval = 1000
processMonitor.OnTimer = function(t)
    local currentPid = getProcessIDFromProcessName("sh2pc.exe")
    if currentPid == nil or currentPid == 0 then
        -- Process is gone, disable this script
        local al = getAddressList()
        local scriptRecord = al.getMemoryRecordByDescription('Attach SH2EE')
        if scriptRecord then
            scriptRecord.Active = false
        end
    end
end
processMonitor.Enabled = true

[DISABLE]

if processMonitor then
    processMonitor.Enabled = false
    processMonitor.destroy()
    processMonitor = nil
end
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>36270</ID>
          <Description>"Compact View"</Description>
          <Color>808080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

luacall(function cycleFullCompact(sender,force); local state = not(compactmenuitem.Caption == 'Compact View Mode'); if force~=nil then state = not force end; compactmenuitem.Caption = state and 'Compact View Mode' or 'Full view Mode'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible = state; getMainForm().Panel5.Visible = state; end; function addCompactMenu(); if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,true))

[DISABLE]

luacall(cycleFullCompact(nil,false))
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>35097</ID>
          <Description>"Claude Code Scripts"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <Color>979700</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>35098</ID>
              <Description>"Object Load Budget"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>4 Bytes</VariableType>
              <Address>01FAC644</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>36273</ID>
              <Description>"Record Log"</Description>
              <Color>808080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game : sh2pc.exe (Silent Hill 2 Enhanced Edition)
  =================================================================
  ARENA TRACE  --  order record fills against allocations
  =================================================================

  Two ring buffers sharing one monotonic sequence counter, so a
  record write and a block allocation can be ordered against each
  other.

  HOOK 1  005AA905  sub_5AA620's fill loop
      EBX = owner, EAX = record index, BP = bone ordinal

  HOOK 2  005B6C9D  sub_5B6C20 stamping the in-use tag
      EAX = block header, [EAX] = payload size
      Payload (what the caller receives) = EAX + 0x10

  Both freeze together when recLogOn is zeroed.

  SYMBOLS
    recLog    65536 x 16: owner, index, ordinal, seq
    allocLog   4096 x 16: header, size, seq, 0
    traceSeq  shared counter
    recLogOn  0 = freeze both logs
}

[ENABLE]
assert(sh2pc.exe+1AA905,6B C0 70 89 7C 01 60)
assert(sh2pc.exe+1B6C9D,89 78 04 5F 83 C0 10)
alloc(recCave,256,sh2pc.exe+1AA905)
alloc(allocCave,256,sh2pc.exe+1B6C9D)
alloc(recLog,1048576)
alloc(allocLog,65536)
alloc(recLogPtr,4)
alloc(allocPtr,4)
alloc(traceSeq,4)
alloc(recLogOn,4)
registersymbol(recLog)
registersymbol(allocLog)
registersymbol(recLogPtr)
registersymbol(allocPtr)
registersymbol(traceSeq)
registersymbol(recLogOn)
label(rCode)
label(rReturn)
label(rSkip)
label(aCode)
label(aReturn)
label(aSkip)

recLogPtr:
  dd 0
allocPtr:
  dd 0
traceSeq:
  dd 0
recLogOn:
  dd 1

recCave:
  pushfd
  cmp dword ptr [recLogOn],0
  je rSkip
  push eax
  push ecx
  push edx
  mov ecx,[recLogPtr]
  and ecx,000FFFF0
  mov edx,recLog
  add edx,ecx
  mov [edx],ebx                 // owner
  mov [edx+04],eax              // record index
  movzx ecx,bp
  mov [edx+08],ecx              // bone ordinal
  mov ecx,[traceSeq]
  mov [edx+0C],ecx              // sequence
  add dword ptr [recLogPtr],10
  inc dword ptr [traceSeq]
  pop edx
  pop ecx
  pop eax
rSkip:
  popfd
rCode:
  imul eax,eax,70
  mov [ecx+eax+60],edi
  jmp rReturn

allocCave:
  pushfd
  cmp dword ptr [recLogOn],0
  je aSkip
  push ecx
  push edx
  mov ecx,[allocPtr]
  and ecx,0000FFF0
  mov edx,allocLog
  add edx,ecx
  mov [edx],eax                 // block header
  mov ecx,[eax]
  mov [edx+04],ecx              // payload size
  mov ecx,[traceSeq]
  mov [edx+08],ecx              // sequence
  mov dword ptr [edx+0C],0
  add dword ptr [allocPtr],10
  inc dword ptr [traceSeq]
  pop edx
  pop ecx
aSkip:
  popfd
aCode:
  mov [eax+4],edi
  pop edi
  add eax,10
  jmp aReturn

sh2pc.exe+1AA905:
  jmp recCave
  nop
  nop
rReturn:

sh2pc.exe+1B6C9D:
  jmp allocCave
  nop
  nop
aReturn:

[DISABLE]
sh2pc.exe+1AA905:
  db 6B C0 70 89 7C 01 60
sh2pc.exe+1B6C9D:
  db 89 78 04 5F 83 C0 10
unregistersymbol(recLog)
unregistersymbol(allocLog)
unregistersymbol(recLogPtr)
unregistersymbol(allocPtr)
unregistersymbol(traceSeq)
unregistersymbol(recLogOn)
dealloc(recLogOn)
dealloc(traceSeq)
dealloc(allocPtr)
dealloc(recLogPtr)
dealloc(allocLog)
dealloc(recLog)
dealloc(allocCave)
dealloc(recCave)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>35100</ID>
              <Description>"Enemy Spawn System"</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game : sh2pc.exe (Silent Hill 2 Enhanced Edition)
  =================================================================
  ENEMY MAYHEM  --  density + stalkers + randomiser in one script
  =================================================================

  Three independent subsystems, each switchable at runtime:

    DENSITY    more enemies, clustered into crowds, spawning at a
               sane distance instead of in your face
    PHANTOM    teleports distant enemies to you
    TYPES      rewrites which enemy each spawn point produces

  Enable this script once. Turn subsystems on and off from the
  config block below or SH2_Control_Panel.CEA.

  THE SOUND TABLE, AND WHY SIZE IS NOT THE LEVER
  Spawning an enemy whose SOUND BANK this visit has not loaded
  registers a burst of sound users in one event. Measured once
  directly: a single spawn took the index from 1 to 35 with only
  seven live enemies. When the index passes the table bound the
  game parks on an assert (00518E96) - a jmp-to-self, so the
  process is healthy and can simply be killed.
  The stock table is 8 slots. SH2_Sound_Table_Expansion.CEA moves
  and enlarges it to 34, which raises the threshold but does NOT
  remove it: one spike is bigger than the whole enlarged table.
  Spawning types already RESIDENT on the level costs about nothing
  - 30 concurrent Lying Figures never moved the index off 1-2.
  So the rule is residency, not pacing and not table size. The
  drip below is encounter pacing that also happens to be polite to
  the sound system; it is not what keeps you safe.

  DEPENDENCIES INSIDE DENSITY
  The eviction floor is not optional. A dense map hits the 32-slot
  entity wall, the game demands an eviction, and only enemies past
  the floor qualify. At stock 16000 nothing does, and it freezes.

  UNSAFE TYPES
  "Only use types this level already loaded" is ON by default and
  should stay on. It reads the live character registry, not the
  spawn table: a level's table lists its day AND night rosters
  together, but only one of them is loaded at a time.
  The registry is necessary but NOT sufficient. It records MODEL
  registration and says nothing about sound-bank residency -
  Pyramid Head is registered on Town East for a set piece while
  its bank is absent, which froze the game anyway. So a second
  test runs alongside it: provenSweep() marks a type proven only
  once an instance is standing in the entity table. Measured, not
  inferred. Unproven types are rationed and introduced alone.

  BOSS AREAS
  If a spawn table contains a boss or set-piece type, Phantom and
  Surge pause automatically. Bosses are never retyped or moved.

  CONSOLE       mayhemStatus()     what is running
                mayhemLoadedTypes()  what this area actually has loaded
                mayhemReshuffle()  new random crowd layout
                mayhemPanic()      everything off, everything restored
                mayhemCheckArena() bone pool health
}

[ENABLE]
{$lua}
if syntaxcheck then return end

MAYHEM = MAYHEM or {}
local M = MAYHEM
MAYHEM.heartbeat = false

--=================== CONFIGURATION ===================
-- Re-enabling this script resets these. GUI edits last for the session.

M.on = { density = true, phantom = true, types = false }

M.bossPause = true      -- pause Phantom and Surge in boss areas

---- DENSITY ----
local D = {}
D.nodeCount     = 1152     -- bone pool size (stock 400)
-- Nothing forces 8 any more. The pool at nodeCount 1152 supports roughly 35,
-- the expanded sound table holds 34, and the entity array caps out at 32
-- regardless. 8 is a taste setting: raise it if you want crowds, and read
-- the governor note below before going near the pool budget.
D.enemyCap      = 8        -- concurrent enemy limit (stock 3)
-- OFF BY DEFAULT, and it should stay off unless jitter is on. Bypassing the
-- filter makes the day roster and the night roster eligible at the same time.
-- Those are alternative stagings of the same encounters and are authored at
-- IDENTICAL coordinates -- Town East ships 44 such pairs. Two enemies on one
-- point drive the engine's overlap test (sub_529C50) into a divide by zero,
-- which becomes NaN, which freezes the game on the sound assert. See S14.
D.filterBypass  = false    -- ignore the scenario/difficulty gate
D.evictRange    = 8000     -- eviction floor, world units (stock 16000)
D.liveRespawn   = true     -- killed enemies return, no reload needed
D.respawnEvery  = 20       -- seconds between re-arm passes; 0 = on entry only
-- Re-arms are DRIPPED rather than applied in one pass. Treat this as ENCOUNTER
-- PACING, not as sound protection: resident-type spawns cost the sound table
-- about nothing however many arrive at once, and an unloaded type costs more
-- than the whole table however slowly it arrives. The drip stops a whole area
-- materialising in one frame, which is a gameplay choice. Residency is the
-- safety mechanism (see autoPool and provenSweep).
D.rearmPerTick  = 2        -- records re-armed per tick, max
D.sndSpare      = 2        -- sound slots to always leave free (of the live bound)
-- A type whose bank is not resident registers a burst on its first spawn.
-- Two measurements exist and they disagree by a lot: about +7 slots for a
-- Dark Nurse on a level that had partially loaded it, and +34 in one event
-- for a type the level never loaded at all. Treat 7 as a floor, not a
-- typical cost. These two knobs give a novel type the table to itself for
-- its introduction, which helps in the +7 case and cannot help in the +34
-- case. Keeping unproven types out entirely is what actually works.
D.bankIntroMax  = 1        -- max sound index at which a NEW type may spawn
D.bankIntroWait = 8        -- seconds to hold ALL arming while a bank registers

D.spawnPatch    = true     -- rewrite the engine's spawn distance gate
D.spawnMinOut   = 8000     -- outdoors: nothing spawns nearer than this
D.spawnMaxOut   = 10000    -- outdoors: nothing spawns further than this
D.spawnMinIn    = 0        -- indoors: 0 = leave the stock value alone
D.spawnMaxIn    = 0

D.crowds        = true     -- cluster spawn points into pockets
D.crowdCount    = 50       -- max pockets, auto-scaled down on small tables
D.minPocket     = 6        -- fewest records worth calling a pocket
D.lonerPercent  = 100
D.sizeCap       = 30
D.crowdRadius   = 2200     -- pocket scatter, outdoors
D.crowdRadiusIn = 200      -- pocket scatter, indoors
D.smallTable    = 30       -- record count below which indoors is assumed
-- Duplicate spawn coordinates are the precondition for the worst failure this
-- toolkit can cause (S14). Nudging one record of each duplicate pair a few
-- dozen units makes the zero-distance case unreachable, which is what makes
-- the filter bypass survivable. Cheap, and invisible in play.
D.jitter        = true     -- separate spawn points that share exact coordinates
D.jitterUnits   = 64       -- how far to nudge, world units
-- ENCOUNTER PACING, NOT SOUND PROTECTION. This was written to stop a
-- "pristine pocket bursts in one frame" sound overflow; that hypothesis is
-- RETRACTED (corrections log C-31.5 - a freeze survived this guard with it
-- active). Kept because it is still useful: it stops a reshuffle dropping a
-- fresh crowd on top of you, which is jarring. 0 disables it.
D.reshuffleClear = 12000   -- keep new pockets at least this far from you

D.surge         = true     -- keep refilling the pocket nearest you
D.surgeTarget   = 30
D.surgeRadius   = 8000
D.surgeBatch    = 100
D.surgeKeep     = 1
D.tickMs        = 100

-- Governor: if the bone pool runs low, quietly shave the cap until it
-- recovers, then put it back. Stops you wedging the game by overreaching.
D.governor      = true
D.governorFloor = 120      -- free bone nodes below which the cap drops
D.governorMin   = 4        -- never drop the cap below this

-- Director: paces encounters. After a quiet stretch it raises the surge
-- target; after a busy one it lowers it. Off by default.
D.director      = false
D.directorMin   = 8
D.directorMax   = 40
D.quietSeconds  = 12       -- no enemies near for this long = raise pressure
D.directorBusy  = 8        -- this many near you = ease off
D.directorRadius = 12000
M.d = D

---- PHANTOM ----
local P = {}
P.mode          = "ring"   -- outdoors: "ring" or "trail"
P.intervalMs    = 500
P.chance        = 0.4      -- per eligible enemy, per roll
P.maxPerTick    = 6
P.minDistance   = 8000.0   -- only move enemies FARTHER than this
P.ringMin       = 8000.0
P.ringMax       = 10000.0
P.trailMinAge   = 3        -- samples back along your own path
P.trailMaxAge   = 20
P.facePlayer    = true     -- write facing angle; may point them backwards
P.autoIndoor    = true     -- ring throws enemies through walls in small rooms
P.indoorRecords = 30
P.indoorMode    = "trail"
P.indoorMinDist = 8000.0
P.verbose       = false
M.p = P

---- TYPES ----
local T = {}
-- SAFE BY DEFAULT. A type the level never loaded has no model and no sound
-- bank; the game parks itself on an EB FE assert (snd_select.c at 00518E96)
-- the first time it needs one. Turn this off only for types you have tested
-- on that specific level.
T.autoPool    = true
T.liveRespawn = true       -- re-arm spawn points after retyping, so it shows now
T.tickMs      = 500
-- ENCOUNTER PACING, NOT SOUND PROTECTION. Written on the theory that several
-- bank introductions arriving together overran the table; that is RETRACTED
-- (corrections log C-31.4 - killed by arithmetic, then by a freeze with only
-- two registered types). Kept because staggering new types across reshuffles
-- reads better in play. Types already seen alive are free.
T.novelPerPass = 2
M.t = T

-- Types verified to work on a level despite being absent from its table.
M.extraTypes = { --[[ [0x208] = true, [0x209] = true ]] }

-- Relative weights. Unavailable types are dropped and their weight shared out.
M.weights = {
  [0x200] = 25,   -- Lying Figure
  [0x201] = 25,   -- Mannequin
  [0x202] =  0,   -- Creeper
  [0x207] = 20,   -- Nurse
  [0x20B] = 15,   -- Dark Nurse
  -- The four below REQUIRE SH2_Animation_Guard.CEA to be active (S35).
  -- Without it they crash on attack wherever James lacks the reaction track.
  -- All start at 0 so enabling this script changes nothing on its own.
  [0x204] =  0,   -- Abstract Daddy      (untested since the guard)
  [0x205] =  0,   -- Eddie               (untested since the guard)
  [0x208] =  0,   -- Pyramid Head (Knife)
  [0x209] =  0,   -- Pyramid Head (Spear)  guard field-tested, Town East
}
-- Closer (0x20A) removed as a DESTINATION. It spawns underground on maps that
-- do not own it (S33 S2) - a root-offset problem, not an animation one, so the
-- guard does nothing for it. Still a valid SOURCE; see M.sources below.

-- S35: types whose attacks dereference a reaction track James may not have.
-- Gated on SH2_Animation_Guard.CEA being enabled.
M.needGuard = { [0x204] = true, [0x205] = true, [0x208] = true, [0x209] = true }

function mayhemGuardActive()
  local ok, a = pcall(getAddressSafe, "gStats")
  return ok and a ~= nil and a ~= 0
end

-- M.protected does three jobs. Split them so spawnable boss types can still be
-- handled as ordinary enemies once they exist.
--   M.protected  - never OVERWRITE a record originally holding these (line 932)
--   M.noHandle   - never teleport or cluster these (line 979)
--   M.bossTypes  - presence in the spawn table means "boss area" (line 1111)
-- Only records currently holding one of these get rewritten.
M.sources = {
  [0x200] = true, [0x201] = true, [0x202] = true,
  [0x207] = true, [0x20A] = true, [0x20B] = true,
}

-- Never MOVED by Phantom. Distinct from M.protected, which governs whether a
-- record is a legal retype SOURCE. Set-piece AD/Eddie are covered by bossArea.
M.neverMove = { [0x203] = true, [0x206] = true }

M.protected = {
  [0x203] = "Flesh Lips", [0x204] = "Abstract Daddy",
  [0x205] = "Eddie",      [0x206] = "Final Boss",
}

---- COMBAT ----
-- Damage is a LIVE read: sub_5434A0 fetches the float from the attack table
-- every time a blow lands, so a slider bites instantly with no reshuffle.
-- Speed is a CODE PATCH: the five difficulty multipliers are imm32 operands
-- inside C7 44 24 xx instructions, rebuilt on the stack on every call.
local C = {}
C.dmgOn     = false     -- master switch for damage scaling
C.dmgGlobal = 1.0       -- multiplier applied over the shipped values
C.spdOn     = false
C.spdMul    = 1.0
M.c = C

-- Per-enemy damage multipliers, applied on top of dmgGlobal.
-- Keys are alphanumeric so the panel's preset parser can round-trip them.
M.dmgGroups = {
  LyingFigure = 1.0, Mannequin     = 1.0, Nurse    = 1.0,
  DarkNurse= 1.0, PyramidHead   = 1.0, Eddie    = 1.0,
  FleshLip    = 1.0, AbstractDaddy = 1.0, Mary     = 1.0,
  Closer      = 1.0,
}
M.dmgGroupNames = {
  LyingFigure = "Lying Figure",   Mannequin     = "Mannequin",
  Nurse       = "Nurse",          DarkNurse  = "Dark Nurse",
  PyramidHead = "Pyramid Head",   Eddie         = "Eddie",
  FleshLip    = "Flesh Lip",      AbstractDaddy = "Abstract Daddy",
  Mary        = "Mary",           Closer        = "Closer",
}
M.dmgGroupOrder = {
  "LyingFigure", "Mannequin", "Nurse", "DarkNurse", "PyramidHead",
  "Eddie", "FleshLip", "AbstractDaddy", "Mary", "Closer",
}

--=====================================================

-- snapshot for the control panel's Reset button
MAYHEM_DEFAULTS = { on = {}, d = {}, p = {}, t = {}, c = {} }
for k, v in pairs(M.on) do MAYHEM_DEFAULTS.on[k] = v end
for k, v in pairs(D)    do MAYHEM_DEFAULTS.d[k]  = v end
for k, v in pairs(P)    do MAYHEM_DEFAULTS.p[k]  = v end
for k, v in pairs(T)    do MAYHEM_DEFAULTS.t[k]  = v end
for k, v in pairs(C) do MAYHEM_DEFAULTS.c[k] = v end
MAYHEM_DEFAULTS.dmgGroups = {}
for k, v in pairs(M.dmgGroups) do MAYHEM_DEFAULTS.dmgGroups[k] = v end
-- Weights and bossPause live outside the four groups above, so the panel's
-- Defaults button could not restore them. Snapshot them too.
MAYHEM_DEFAULTS.weights = {}
for k, v in pairs(M.weights) do MAYHEM_DEFAULTS.weights[k] = v end
MAYHEM_DEFAULTS.bossPause = M.bossPause

------------------------------------------------------------------ addresses
local NODE_SIZE, HEAD, COUNT = 0xE0, 0x01FAC640, 0x01FAC644
local MGR_PTR, MGR_TABLE     = 0x01F7A950, 0x14
local PLAYER_PTR             = 0x01FB7C80
local ENT_BASE, ENT_STRIDE, ENT_SLOTS = 0x01FB1000, 0x2CC, 32
local ENT_COUNT              = 0x01FB698C
local STRIDE, MAXREC         = 0x14, 256
local R_TYPE, R_SUB, R_X, R_Y, R_H = 0x00, 0x02, 0x04, 0x08, 0x0C
local TRIGGERED              = 0x01F7ADE0
-- Sound slot system (snd_select.c). Stock struct at 01D7EAC0, 0x114 bytes:
-- the dword at +0x1C (01D7EADC) is the CURRENT USER INDEX and +0x20 holds
-- the slots (stride 0x1C). The index breathes 0-2 in normal play at any
-- enemy count; it is a residency SPIKE that overruns it, not accumulation.
-- BOTH the base and the bound move when SH2_Sound_Table_Expansion.CEA is
-- active, so neither may be hardcoded here. A stale base returns a frozen
-- snapshot from the moment of relocation and silently disables the headroom
-- gate; a stale bound throttles the drip to the stock ceiling. Resolve both
-- live, below.
local SND_IDX_STATIC         = 0x01D7EADC
local function sndIdxAddr()
  if _G.SND and SND.state and SND.state.buf then return SND.state.buf + 0x1C end
  return SND_IDX_STATIC
end
-- The slot bound lives in the imm8 of "cmp eax,8" at 00518E0E. Read it live
-- rather than assuming: SH2_Sound_Table_Expansion.CEA raises it to 34, and
-- a hardcoded 8 here would throttle the drip to the stock ceiling even with
-- the larger table active. Falls back to 8 when the expansion is off.
local SND_BOUND_AT           = 0x00518E10
local function sndBound()
  local b = readBytes(SND_BOUND_AT, 1, true)
  local v = b and b[1]
  if v == nil or v &lt; 4 or v &gt; 255 then return 8 end
  return v
end
local REG_BASE, REG_END, REG_STRIDE = 0x01F7D820, 0x01F7F630, 0x94
local E_TYPE, E_X, E_Y, E_Z  = 0x10, 0x1C, 0x20, 0x24
local E_FACE, E_SKEL, E_STATE = 0x30, 0x9C, 0x148
local SYM_CAP    = "sh2pc.exe+90204"
local SYM_FILTER = "sh2pc.exe+90258"
local SYM_EVICT  = "sh2pc.exe+8F009"
local SYM_SPMIN  = "sh2pc.exe+2A9D98"   -- min spawn distance, squared
local SYM_SPMAX  = "sh2pc.exe+2A9DA0"   -- max spawn distance, squared

local NAMES = {
  [0x100] = "James", [0x105] = "Maria", [0x107] = "Laura",
  [0x200] = "Lying Figure", [0x201] = "Mannequin", [0x202] = "Creeper",
  [0x203] = "Flesh Lips", [0x204] = "Abstract Daddy", [0x205] = "Eddie",
  [0x206] = "Final Boss", [0x207] = "Nurse", [0x208] = "PH (Knife)",
  [0x209] = "PH (Spear)", [0x20A] = "Closer", [0x20B] = "Dark Nurse",
}
local function nameOf(t) return NAMES[t] or string.format("Type_%04X", t) end

------------------------------------------------------------------ helpers
local function u32(v) if v == nil then return nil end if v &lt; 0 then return v + 0x100000000 end return v end
local function s32(v) if v == nil then return nil end if v &gt;= 0x80000000 then return v - 0x100000000 end return v end
local function s16(v) if v == nil then return nil end if v &gt;= 0x8000 then return v - 0x10000 end return v end

local function sym(nm)
  local a = getAddress(nm)
  if a == nil or a == 0 then error("[Mayhem] cannot resolve " .. nm) end
  return a
end

local function tableBase()
  local mgr = readInteger(MGR_PTR)
  if mgr == nil or mgr == 0 then return nil end
  local t = readInteger(mgr + MGR_TABLE)
  if t == nil or t == 0 then return nil end
  if (readSmallInteger(t) or 0) == 0 then return nil end
  return t
end

-- Read the whole spawn table once. Every subsystem works from this.
local function readTable(tb)
  local rec, n = {}, 0
  for i = 0, MAXREC - 1 do
    local r = tb + i * STRIDE
    local t = readSmallInteger(r + R_TYPE)
    if t == nil or t == 0 then break end
    rec[n] = { addr = r, t = t, sub = readSmallInteger(r + R_SUB),
               x = s32(readInteger(r + R_X)), y = s32(readInteger(r + R_Y)),
               h = s16(readSmallInteger(r + R_H)) }
    if rec[n].x == nil or rec[n].y == nil then return nil, 0 end
    n = n + 1
  end
  return rec, n
end

local function clearTriggered(sub)
  if sub == nil or sub &lt; 0 or sub &gt; 0x7FFE then return false end
  local a = TRIGGERED + (sub &gt;&gt; 5) * 4
  local v = readInteger(a)
  if v == nil then return false end
  return writeInteger(a, (v &amp; ~(1 &lt;&lt; (sub &amp; 0x1F))) &amp; 0xFFFFFFFF) and true or false
end

-- RETIRED (kept for reference, no callers): pre-marking records as spawned.
-- Setting bits proved destructive when the tick raced a level load - one
-- field run crashed the Town East loader with an AV at 0054FDE2. Clearing
-- bits (writing 0s over mostly-0s) is the only write this script performs
-- on the triggered field now. Do not reintroduce set-writes without first
-- verifying the bitfield's true extent and adding a load-state guard.
local function setTriggered(sub) -- luacheck: ignore
  if sub == nil or sub &lt; 0 or sub &gt; 0x7FFE then return false end
  local a = TRIGGERED + (sub &gt;&gt; 5) * 4
  local v = readInteger(a)
  if v == nil then return false end
  return writeInteger(a, (v | (1 &lt;&lt; (sub &amp; 0x1F))) &amp; 0xFFFFFFFF) and true or false
end

local function d2(a, b) local dx, dy = a.x - b.x, a.y - b.y return dx * dx + dy * dy end

-- What is ACTUALLY loaded right now: 52 records, stride 0x94, type at +0x00.
-- The spawn table is the wrong source for this - it lists every record the
-- level can ever use, day roster and night roster together, while only one
-- of those has its model, animation and sound bank resident.
local function loadedTypes()
  local set, n = {}, 0
  local a = REG_BASE
  while a &lt; REG_END do
    local t = readInteger(a)
    if t == nil then return nil, 0 end
    if t ~= 0 then set[t] = true; n = n + 1 end
    a = a + REG_STRIDE
  end
  if n == 0 then return nil, 0 end
  return set, n
end

function mayhemLoadedTypes()
  local set, n = loadedTypes()
  if set == nil then print("[Types]   registry unreadable - is a level loaded?"); return end
  local ids = {}
  for t in pairs(set) do ids[#ids + 1] = t end
  table.sort(ids)
  local parts = {}
  for _, t in ipairs(ids) do parts[#parts + 1] = string.format("%s (%04X)", nameOf(t), t) end
  print(string.format("[Types]   %d of 52 registry slots in use:", n))
  print("[Types]   " .. table.concat(parts, ", "))
end

local function playerEnt()
  local p = readInteger(PLAYER_PTR)
  if p == nil or p == 0 then return nil end
  return p
end

------------------------------------------------------------ 1. BONE POOL
-- Allocated once and left in place. A larger pool is harmless when the rest
-- of Density is off, and shrinking it while bones are live would not be.
local P5 = { ecx = "sh2pc.exe+13AAF4", edi = "sh2pc.exe+13AAF9",
             eax = "sh2pc.exe+13AB00", cnt = "sh2pc.exe+13AB0A",
             edx = "sh2pc.exe+13AB14" }

local function poke(nm, v)
  local a = sym(nm)
  if not writeInteger(a, v) then error("[Pool] write failed at " .. nm) end
  if u32(readInteger(a)) ~= u32(v) then error("[Pool] verify failed at " .. nm) end
end

-- CE's _G outlives the game process. After a game relaunch the buffer and the
-- five patched immediates are gone, but _G.mayhemArena still holds the old
-- address - a bare nil-check would skip setup and leave the game on the stock
-- 400-node pool while the script believes it has D.nodeCount. Validate against
-- the CURRENT process instead: our immediate must still point at our buffer,
-- and the canary at the end of the buffer must still be readable and intact.
local function poolIsLive()
  local b = _G.mayhemArena
  if b == nil or _G.mayhemArenaSpan == nil then return false end
  local ok, addr = pcall(getAddress, P5.edi)
  if not ok or addr == nil or addr == 0 then return false end
  local edi = readInteger(addr)
  if edi == nil or u32(edi) ~= u32(b) then return false end
  local tail = readInteger(b + _G.mayhemArenaSpan - 4)
  return tail ~= nil and u32(tail) == 0xC0FFEE01
end

local function setupPool()
  if poolIsLive() then return end
  if _G.mayhemArena ~= nil then
    print("[Pool]    Stale pool from a previous game process detected - rebuilding.")
    _G.mayhemArena, _G.mayhemArenaSpan = nil, nil
  end
  local span = D.nodeCount * NODE_SIZE + 8
  local base = allocateMemory(span + 0x1000)
  if base == nil or base == 0 then
    error(string.format("[Pool] allocateMemory(%d) failed. Lower nodeCount.", span))
  end
  -- Probe every page before letting the game write here.
  local off = 0
  while off &lt; span do
    local a, saved = base + off, readInteger(base + off)
    if saved == nil or not writeInteger(a, 0x5A5A5A5A) or readInteger(a) ~= 0x5A5A5A5A then
      error(string.format("[Pool] ABORTED - only 0x%X bytes usable. Lower nodeCount to ~%d.",
            off, math.floor((off - 8) / NODE_SIZE)))
    end
    writeInteger(a, saved)
    off = off + 0x1000
  end
  writeInteger(base + span - 4, 0xC0FFEE01)
  _G.mayhemArena, _G.mayhemArenaSpan = base, span

  poke(P5.ecx, D.nodeCount * 56 + 2)
  poke(P5.edi, base); poke(P5.eax, base)
  poke(P5.cnt, D.nodeCount); poke(P5.edx, D.nodeCount - 1)

  -- Safe mid-level: the allocator only follows next-pointers, so a free list
  -- spanning the old and new buffers works. Nodes held by live enemies rejoin
  -- this list when they die; the old buffer's spares are abandoned.
  for i = 0, D.nodeCount - 2 do
    writeInteger(base + i * NODE_SIZE, base + (i + 1) * NODE_SIZE)
  end
  writeInteger(base + (D.nodeCount - 1) * NODE_SIZE, 0)
  writeInteger(HEAD, base)
  writeInteger(COUNT, D.nodeCount)

  print(string.format("[Pool]    %d nodes at %08X (stock 400), ~%d enemies of budget",
        D.nodeCount, base, math.floor((D.nodeCount - 76) / 30)))
end

function mayhemCheckArena()
  local b = _G.mayhemArena
  if b == nil then print("[Arena] No buffer allocated."); return false end
  local tail = readInteger(b + _G.mayhemArenaSpan - 4)
  print(string.format("[Arena] base=%08X head=%s count=%s", b,
        string.format("%08X", u32(readInteger(HEAD)) or 0), tostring(readInteger(COUNT))))
  if tail == nil then print("[Arena] DEAD - buffer unreadable."); return false end
  if u32(tail) ~= 0xC0FFEE01 then
    print(string.format("[Arena] CANARY CLOBBERED (%08X).", u32(tail))); return false
  end
  print("[Arena] Alive - canary intact."); return true
end

-- The game's attachment heap. Distinct from the bone pool above.
-- Layout proved in S38 from sub_5B6C20 (alloc) and sub_5B6D00 (free):
--   anchor 01D9F400: +00 total size, +04 FREE BYTES (live), +08 first block,
--                    +0C tail block (write-only; stale after 005B6D7C)
--   block prefix:    +00 size, +04 anchor ptr (0 = FREE), +08 next (all blocks,
--                    address order), +0C prev
-- Owner header and record array are SEPARATE allocations: (10+90) and
-- (10 + count*70). S37 S1.3's +90/+94/+98/+9C are the array block's prefix.
-- Read-only. Nothing here writes to the game.
local ATT_ANCHOR = 0x01D9F400

function mayhemArenaAudit(verbose)
  local total = readInteger(ATT_ANCHOR)
  local head  = u32(readInteger(ATT_ANCHOR + 8) or 0)
  if total == nil or head == 0 then print("[Attach]  anchor unreadable."); return nil end
  local limit = ATT_ANCHOR + total

  local p, blocks, used, freeB, largest = head, 0, 0, 0, 0
  local gaps, overlaps = 0, 0
  local seen = {}
  while p ~= 0 do
    if p &lt; ATT_ANCHOR or p &gt;= limit then
      print(string.format("[Attach]  block %08X outside the arena - chain broken.", p))
      return nil
    end
    if blocks &gt; 4096 then print("[Attach]  chain too long - aborting."); return nil end
    local size  = readInteger(p)
    local owner = u32(readInteger(p + 4) or 0)
    local nxt   = u32(readInteger(p + 8) or 0)
    if size == nil then print(string.format("[Attach]  %08X unreadable.", p)); return nil end

    blocks = blocks + 1
    seen[p] = true
    if owner == 0 then
      freeB = freeB + size
      if size &gt; largest then largest = size end
    else
      used = used + size
    end

    local adj = p + 0x10 + size
    if nxt ~= 0 and nxt ~= adj then
      if nxt &lt; adj then overlaps = overlaps + 1 else gaps = gaps + 1 end
      print(string.format("[Attach]  ** %s at %08X: size %06X, next %08X, expected %08X (%+d)",
            nxt &lt; adj and "OVERLAP" or "gap", p, size, nxt, adj, nxt - adj))
    end
    if verbose then
      print(string.format("[Attach]  %08X  size %06X  %s", p, size,
            owner == 0 and "free" or "in use"))
    end
    p = nxt
  end

  local accounted = used + freeB + blocks * 0x10 + 0x10
  local counter   = readInteger(ATT_ANCHOR + 4) or -1
  local tail      = u32(readInteger(ATT_ANCHOR + 0xC) or 0)
  print(string.format("[Attach]  %d blocks: %d used, %d free, largest free %d",
        blocks, used, freeB, largest))
  print(string.format("[Attach]  free counter %d, walk %d (%+d)   tail %08X %s",
        counter, freeB, freeB - counter, tail,
        seen[tail] and "ok" or "** NOT A BLOCK HEADER **"))
  if accounted ~= total then
    print(string.format("[Attach]  ** MISMATCH: walk accounts for %d of %d bytes.", accounted, total))
    print("[Attach]  ** Do not trust the numbers above - the layout reading is wrong.")
  elseif overlaps &gt; 0 then
    print(string.format("[Attach]  ** %d OVERLAPPING BLOCK(S) - this is the S37 fault condition.", overlaps))
  end
  return largest, freeB, blocks, overlaps
end

-- Silent variant for the panel tick. Returns used, blocks, overlaps.
function mayhemArenaQuick()
  local total = readInteger(ATT_ANCHOR)
  local p     = u32(readInteger(ATT_ANCHOR + 8) or 0)
  if total == nil or p == 0 then return nil end
  local limit, blocks, used, bad = ATT_ANCHOR + total, 0, 0, 0
  while p ~= 0 and p &gt;= ATT_ANCHOR and p &lt; limit and blocks &lt; 4096 do
    local size  = readInteger(p)
    local owner = u32(readInteger(p + 4) or 0)
    local nxt   = u32(readInteger(p + 8) or 0)
    if size == nil then return nil end
    blocks = blocks + 1
    if owner ~= 0 then used = used + size end
    if nxt ~= 0 and nxt &lt; p + 0x10 + size then bad = bad + 1 end
    p = nxt
  end
  return used, blocks, bad
end

-- Owner-level validation. Read-only.
-- cnt == 0 is legitimate (an enemy with no attachments) - do not flag it.
function mayhemArenaOwners()
  local total = readInteger(ATT_ANCHOR)
  local p     = u32(readInteger(ATT_ANCHOR + 8) or 0)
  if total == nil or p == 0 then print("[Owners]  anchor unreadable."); return end
  local limit = ATT_ANCHOR + total

  local order, size, live, n = {}, {}, {}, 0
  while p ~= 0 and p &gt;= ATT_ANCHOR and p &lt; limit and n &lt; 4096 do
    local s = readInteger(p)
    if s == nil then break end
    n = n + 1
    order[n], size[p] = p, s
    live[p] = u32(readInteger(p + 4) or 0) ~= 0
    p = u32(readInteger(p + 8) or 0)
  end

  local ENT_LO, STRIDE, SLOTS = 0x01FB1000, 0x2CC, 32
  local claims, bad, owners, empty = {}, 0, 0, 0
  for i = 1, n do
    local blk = order[i]
    if live[blk] and size[blk] == 0x90 then
      owners = owners + 1
      local owner = blk + 0x10
      local ent   = u32(readInteger(owner) or 0)
      local ty    = (readSmallInteger(owner + 4) or 0) % 0x10000
      local cnt   = readBytes(owner + 8, 1, false) or 0
      local arr   = u32(readInteger(owner + 0x84) or 0)
      local nxt   = order[i + 1]
      local resident = false
      for a = REG_BASE, REG_END - REG_STRIDE, REG_STRIDE do
        if (readSmallInteger(a) or -1) % 0x10000 == ty then resident = true; break end
      end
      local msg   = {}

      local slot = (ent - ENT_LO) / STRIDE
      if ent &lt; ENT_LO or slot ~= math.floor(slot) or slot &gt;= SLOTS then
        msg[#msg+1] = string.format("entity %08X is not a slot", ent)
      end

      if cnt == 0 then
        empty = empty + 1
        if arr ~= 0 then msg[#msg+1] = string.format("cnt 0 but +84 = %08X", arr) end
      else
        if arr ~= owner + 0xA0 then
          msg[#msg+1] = string.format("+84 = %08X, expected %08X", arr, owner + 0xA0)
        end
        if nxt == nil or arr ~= nxt + 0x10 then
          msg[#msg+1] = "array is not the following block"
        elseif not live[nxt] then
          msg[#msg+1] = "** ARRAY BLOCK IS FREE **"
        elseif size[nxt] ~= cnt * 0x70 then
          msg[#msg+1] = string.format("cnt %d wants %04X, block holds %04X",
                                      cnt, cnt * 0x70, size[nxt])
        end
        if claims[arr] then
          msg[#msg+1] = string.format("** array also claimed by owner %08X **", claims[arr])
        end
        claims[arr] = owner

        if nxt and live[nxt] and arr == nxt + 0x10 then
          local recs, hits = math.min(cnt, math.floor(size[nxt] / 0x70)), {}
          for r = 0, recs - 1 do
            local o = readSmallInteger(arr + r * 0x70 + 0x6C)
            if o and (o &gt; 63 or o &lt; 0) then hits[#hits+1] = r end
          end
          if #hits &gt; 0 then
            msg[#msg+1] = string.format("bad ordinals at %s", table.concat(hits, ","))
            print(string.format("[Owners]  %08X type %04X (%s) ent %08X cnt %d: %s",
              owner, ty, resident and "resident" or "** NOT RESIDENT **",
              ent, cnt, table.concat(msg, "; ")))
            for r = 0, recs - 1 do
              local rec = arr + r * 0x70
              local o   = (readSmallInteger(rec + 0x6C) or 0) % 0x10000
              print(string.format("[Owners]    %s rec %2d  +60 %08X  +64 %08X  +68 %08X  ord %04X  +6E %04X",
                    (o &gt; 63) and "BAD" or "ok ", r,
                    u32(readInteger(rec + 0x60) or 0), u32(readInteger(rec + 0x64) or 0),
                    u32(readInteger(rec + 0x68) or 0), o,
                    (readSmallInteger(rec + 0x6E) or 0) % 0x10000))
            end
          end
        end
      end

      if #msg &gt; 0 then
        bad = bad + 1
        print(string.format("[Owners]  %08X type %04X ent %08X cnt %d: %s",
              owner, ty, ent, cnt, table.concat(msg, "; ")))
      end
    end
  end
  print(string.format("[Owners]  %d blocks, %d owners (%d with no records), %d flagged.",
        n, owners, empty, bad))
  return bad
end

------------------------------------------------------- 2. DENSITY PATCHES
-- fromUser marks a deliberate change, so the governor knows what to
-- restore the cap to once the bone budget recovers.
-- S37 S1.9: cap 15 clean for 20 min, cap 20 dead in ~2 min on Town East,
-- one variable changed. Stopgap until mayhemAttachFree() can measure real
-- arena pressure. Deliberately NOT in D -- serialize() saves every number in
-- M.d, so a preset could otherwise carry a raised ceiling back in.
M.capCeilingTypes = 31

function mayhemSetCap(v, fromUser)
  v = math.max(1, math.min(31, math.floor(v)))
  if fromUser ~= false then M.capWanted = v end
  if M.on.types and v &gt; M.capCeilingTypes then
    if D.enemyCap ~= M.capCeilingTypes then
      print(string.format("[Mayhem]  Cap held at %d - Randomise Types is on (S37 S1.9).",
            M.capCeilingTypes))
    end
    v = M.capCeilingTypes
  end
  D.enemyCap = v
  local a = sym(SYM_CAP)
  _G.mayhemCapOrig = _G.mayhemCapOrig or readBytes(a, 1, false)
  writeBytes(a, v)
  return v
end

-- The scenario/visit filter (sh2pc.exe+90258) decides which of a level's
-- records may fire. Bypassing it makes ALL of them eligible at once -- which
-- means the day roster and the night roster together. Those are alternative
-- encounters and they frequently sit at IDENTICAL coordinates, so the bypass
-- can put two enemies on the exact same point. The engine's separation solver
-- (sub_529C50) divides by the distance between overlapping pairs and does not
-- guard against that distance being zero, so a coincident pair yields INF and
-- then a NaN that poisons every entity in the follow table. See S32.
function mayhemSetFilter(on)
  D.filterBypass = on and true or false
  local f = sym(SYM_FILTER)
  if D.filterBypass then
    _G.mayhemFilterOrig = _G.mayhemFilterOrig or readBytes(f, 6, true)
    writeBytes(f, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90)
  elseif _G.mayhemFilterOrig ~= nil then
    writeBytes(f, _G.mayhemFilterOrig)
  end
  return D.filterBypass
end

function mayhemSetEvict(v)
  D.evictRange = v
  local a = sym(SYM_EVICT)
  _G.mayhemEvictOrig = _G.mayhemEvictOrig or readInteger(a)
  if v == nil then writeInteger(a, _G.mayhemEvictOrig) else writeFloat(a, v) end
end

-- Given in world units; the engine stores them squared.
function mayhemSetSpawnRange(minU, maxU)
  local a, b = sym(SYM_SPMIN), sym(SYM_SPMAX)
  if _G.mayhemSpawnOrig == nil then
    _G.mayhemSpawnOrig = { readFloat(a), readFloat(b) }
  end
  if minU and minU &gt; 0 then writeFloat(a, minU * minU) else writeFloat(a, _G.mayhemSpawnOrig[1]) end
  if maxU and maxU &gt; 0 then writeFloat(b, maxU * maxU) else writeFloat(b, _G.mayhemSpawnOrig[2]) end
end

local function patchesOn()
  setupPool()
  mayhemSetCap(D.enemyCap)
  mayhemSetFilter(D.filterBypass)
  if D.evictRange ~= nil then mayhemSetEvict(D.evictRange) end
  if D.spawnPatch then mayhemSetSpawnRange(D.spawnMinOut, D.spawnMaxOut) end
end

local function patchesOff()
  if _G.mayhemSpawnOrig ~= nil then
    writeFloat(sym(SYM_SPMIN), _G.mayhemSpawnOrig[1])
    writeFloat(sym(SYM_SPMAX), _G.mayhemSpawnOrig[2])
  end
  if _G.mayhemEvictOrig ~= nil then writeInteger(sym(SYM_EVICT), _G.mayhemEvictOrig) end
  if _G.mayhemFilterOrig ~= nil then writeBytes(sym(SYM_FILTER), _G.mayhemFilterOrig) end
  if _G.mayhemCapOrig ~= nil then writeBytes(sym(SYM_CAP), _G.mayhemCapOrig) end
end

------------------------------------------------------------- 3. CROWDS
_G.mayhemCrowdBk = _G.mayhemCrowdBk or {}
_G.mayhemActive = nil

local function restoreCrowds()
  local tables, records = 0, 0
  for tb, st in pairs(_G.mayhemCrowdBk) do
    for i, v in pairs(st) do
      local r = tb + i * STRIDE
      writeInteger(r + R_X, v.x)
      writeInteger(r + R_Y, v.y)
      writeSmallInteger(r + R_H, v.h)
      records = records + 1
    end
    tables = tables + 1
  end
  if records &gt; 0 then
    print(string.format("[Crowds]  Restored %d positions across %d table(s).", records, tables))
  end
  _G.mayhemCrowdBk = {}
  _G.mayhemActive = nil
end

-- Runs AFTER clustering, deliberately: applyCrowds restores from its own
-- backup and re-clusters on every revisit, so anything written before it is
-- discarded. Clustering can also create fresh duplicates of its own.
-- Idempotent -- a second pass finds nothing left to move.
local function jitterDuplicates(tb, rec, n)
  if not D.jitter then return 0 end
  local bk = _G.mayhemCrowdBk[tb]
  if bk == nil then bk = {}; _G.mayhemCrowdBk[tb] = bk end
  local R = math.max(8, D.jitterUnits or 64)
  local seen, moved = {}, 0
  for i = 0, n - 1 do
    local r = rec[i].addr
    local x, y = s32(readInteger(r + R_X)), s32(readInteger(r + R_Y))
    if x == nil or y == nil then return moved end
    local key = x .. "," .. y
    local c = seen[key]
    if c == nil then
      seen[key] = 1
    else
      seen[key] = c + 1
      -- Golden angle, so three or more records on one point fan out evenly
      -- instead of stacking along a line.
      local a = (c - 1) * 2.39996323
      local nx = x + math.floor(R * math.cos(a) + 0.5)
      local ny = y + math.floor(R * math.sin(a) + 0.5)
      -- Only back up if clustering has not already done so, or we would
      -- record the clustered position as the original (the S10 hazard).
      if bk[i] == nil then
        bk[i] = { x = x, y = y, h = s16(readSmallInteger(r + R_H)) }
      end
      writeInteger(r + R_X, nx)
      writeInteger(r + R_Y, ny)
      rec[i].x, rec[i].y = nx, ny
      moved = moved + 1
    end
  end
  return moved
end

local function applyCrowds(tb, rec, n)
  if n &lt; D.minPocket then return nil end

  if _G.mayhemCrowdBk[tb] == nil then
    local b = {}
    for i = 0, n - 1 do b[i] = { x = rec[i].x, y = rec[i].y, h = rec[i].h } end
    _G.mayhemCrowdBk[tb] = b
  else
    -- Cluster from the ORIGINAL layout, never the clustered one, or every
    -- revisit drags the pockets further from where they started.
    local b = _G.mayhemCrowdBk[tb]
    for i = 0, n - 1 do
      if b[i] then rec[i].x, rec[i].y, rec[i].h = b[i].x, b[i].y, b[i].h end
    end
  end

  local indoors = n &lt; D.smallTable
  local radius  = indoors and D.crowdRadiusIn or D.crowdRadius
  if D.spawnPatch then
    if indoors then mayhemSetSpawnRange(D.spawnMinIn, D.spawnMaxIn)
    else            mayhemSetSpawnRange(D.spawnMinOut, D.spawnMaxOut) end
  end

  local want = math.max(1, math.min(D.crowdCount, math.floor(n / D.minPocket)))

  -- farthest-point sampling gives anchors that are spread out
  local ai = { math.random(0, n - 1) }
  local near = {}
  for i = 0, n - 1 do near[i] = d2(rec[i], rec[ai[1]]) end
  while #ai &lt; want do
    local best, bd = nil, -1
    for i = 0, n - 1 do if near[i] &gt; bd then best, bd = i, near[i] end end
    if best == nil or bd &lt;= 0 then break end
    ai[#ai + 1] = best
    for i = 0, n - 1 do
      local d = d2(rec[i], rec[best]); if d &lt; near[i] then near[i] = d end
    end
  end

  local anchors = {}
  for _, k in ipairs(ai) do
    anchors[#anchors + 1] = { x = rec[k].x, y = rec[k].y, h = rec[k].h, members = {} }
  end

  -- Shove any anchor that landed on top of the player out to a safe radius,
  -- keeping its direction so the layout still resembles the level. Only
  -- applies when a player exists - on the first clustering after a load
  -- there is nothing to protect yet.
  local clear = D.reshuffleClear or 0
  if clear &gt; 0 then
    local pptr = playerEnt()
    if pptr then
      local px, pz = readFloat(pptr + E_X), readFloat(pptr + E_Z)
      if px and pz and px == px and pz == pz then
        local pushed = 0
        for _, a in ipairs(anchors) do
          local dx, dy = a.x - px, a.y - pz
          local d = math.sqrt(dx * dx + dy * dy)
          if d &lt; clear then
            local ang = (d &gt; 1) and math.atan(dy, dx) or (math.random() * math.pi * 2)
            a.x = math.floor(px + math.cos(ang) * clear)
            a.y = math.floor(pz + math.sin(ang) * clear)
            pushed = pushed + 1
          end
        end
        if pushed &gt; 0 then
          print(string.format("[Crowds]  %d pocket(s) pushed clear of the player.", pushed))
        end
      end
    end
  end

  local pool = {}
  for i = 0, n - 1 do pool[#pool + 1] = i end
  for i = #pool, 2, -1 do local j = math.random(i); pool[i], pool[j] = pool[j], pool[i] end

  local assignable = #pool - math.floor(n * D.lonerPercent / 100)
  local ci, placed = 1, 0
  for k = 1, assignable do
    local tries = 0
    while #anchors[ci].members &gt;= D.sizeCap and tries &lt;= #anchors do
      ci = (ci % #anchors) + 1; tries = tries + 1
    end
    if tries &gt; #anchors then break end
    anchors[ci].members[#anchors[ci].members + 1] = pool[k]
    placed = placed + 1
    ci = (ci % #anchors) + 1
  end

  local function place(idx, a)
    local r = rec[idx].addr
    local ang, rad = math.random() * math.pi * 2, math.sqrt(math.random()) * radius
    writeInteger(r + R_X, a.x + math.floor(math.cos(ang) * rad))
    writeInteger(r + R_Y, a.y + math.floor(math.sin(ang) * rad))
    writeSmallInteger(r + R_H, a.h)
  end
  for _, a in ipairs(anchors) do
    for _, idx in ipairs(a.members) do place(idx, a) end
  end

  print(string.format("[Crowds]  %d records -&gt; %d pockets, %d loners%s",
        n, #anchors, n - placed, indoors and "  (indoors)" or ""))
  return { base = tb, anchors = anchors, indoors = indoors, place = place, n = n }
end

local function surgeTick(st)
  local p = playerEnt(); if p == nil then return end
  local px, pz = readFloat(p + E_X), readFloat(p + E_Z)
  if px == nil or pz == nil then return end
  local pos = { x = px, y = pz }

  local near, nd = nil, math.huge
  for _, a in ipairs(st.anchors) do
    local d = d2(a, pos); if d &lt; nd then near, nd = a, d end
  end
  if near == nil or nd &gt; D.surgeRadius * D.surgeRadius then return end
  if #near.members &gt;= D.surgeTarget then return end

  local donor, dd = nil, -1
  for _, a in ipairs(st.anchors) do
    if a ~= near and #a.members &gt; D.surgeKeep then
      local d = d2(a, pos); if d &gt; dd then donor, dd = a, d end
    end
  end
  if donor == nil then return end

  for _ = 1, D.surgeBatch do
    if #donor.members &lt;= D.surgeKeep or #near.members &gt;= D.surgeTarget then break end
    local idx = table.remove(donor.members)
    near.members[#near.members + 1] = idx
    st.place(idx, near)
  end
end

-- Clearing the "already spawned" flag. Deliberately separate from clustering:
-- a small room has too few records to cluster but still needs re-arming.
-- THE METERED VALVE: rearm() enqueues records; rearmDrain(), called from the
-- tick, clears a few per tick. CLEAR-WRITES ONLY. An earlier design also SET
-- the triggered bit first, to stop the engine burst-spawning a pristine
-- pocket on first contact - that raced a level load and crashed the Town East
-- loader with an access violation at 0054FDE2. setTriggered() is kept below,
-- unused, as a record of a route that is closed. Do not re-enable it without
-- a load-state gate.
local function rearm(rec, n)
  local q = _G.mayhemRearmQ
  if q == nil then q = {}; _G.mayhemRearmQ = q end
  local seen = {}
  for i = 1, #q do
    local e = q[i]
    seen[type(e) == "table" and e.sub or e] = true
  end
  local added = 0
  for i = 0, n - 1 do
    local s = rec[i].sub
    if s ~= nil and not seen[s] then
      q[#q + 1] = { sub = s, t = rec[i].t }
      seen[s] = true; added = added + 1
    end
  end
  return added
end

-- Bank residency, measured rather than inferred. The character registry
-- lists types whose MODEL was registered; it says nothing about sound
-- banks. A type standing in the entity table has, by definition, paid its
-- bank cost already. Everything else flies alone.
local function provenSweep()
  local p = _G.mayhemProven
  if p == nil then p = {}; _G.mayhemProven = p end
  for i = 0, ENT_SLOTS - 1 do
    local a = ENT_BASE + i * ENT_STRIDE
    local t = readSmallInteger(a + E_TYPE)
    if t and t ~= 0 and (t &gt;&gt; 8) == 2 then p[t] = true end
  end
end

local function rearmDrain()
  local q = _G.mayhemRearmQ
  if q == nil or #q == 0 then return end
  local idx = readInteger(sndIdxAddr())
  if idx == nil then return end                    -- no level loaded; wait
  local room = (sndBound() - (D.sndSpare or 2)) - idx   -- headroom this tick
  if room &lt;= 0 then return end                     -- sound busy; try next tick
  local live = loadedTypes()                       -- registry, right now

  -- A bank introduction in flight freezes ALL arming, resident types too, so
  -- the arriving bank has the table to itself. Released when the registry
  -- shows the type, or on timeout. See bankIntroMax on the cost estimates.
  local pend = _G.mayhemBankPending
  if pend ~= nil then
    if (live ~= nil and live[pend.t]) or os.clock() &gt; pend.deadline then
      _G.mayhemBankPending = nil
    else
      return
    end
  end

  local k = math.min(room, D.rearmPerTick or 2)
  local armed, i = 0, 1
  while i &lt;= #q and armed &lt; k do
    local e = q[i]
    local s = type(e) == "table" and e.sub or e
    local t = type(e) == "table" and e.t or nil
    local proven = _G.mayhemProven
    local unloaded = t ~= nil and not (proven and proven[t])
    if unloaded then
      if armed == 0 and idx &lt;= (D.bankIntroMax or 1) then
        table.remove(q, i)
        clearTriggered(s)
        _G.mayhemBankPending = { t = t, deadline = os.clock() + (D.bankIntroWait or 8) }
        break                                      -- bank load flies alone
      end
      i = i + 1                                    -- not now; try others first
    else
      table.remove(q, i)
      clearTriggered(s)
      armed = armed + 1
    end
  end
end

--------------------------------------------------------------- 4. TYPES
_G.mayhemTypeBk = _G.mayhemTypeBk or {}

local function restoreTypes()
  local tables, records = 0, 0
  for tb, b in pairs(_G.mayhemTypeBk) do
    for i, t in pairs(b) do
      writeSmallInteger(tb + i * STRIDE, t)
      records = records + 1
    end
    tables = tables + 1
  end
  if records &gt; 0 then
    print(string.format("[Types]   Restored %d record types across %d table(s).", records, tables))
  end
  _G.mayhemTypeBk = {}
  _G.mayhemTypedTables = {}
end

local function applyTypes(tb, rec, n)
  if n == 0 then return false end
  T.neverRetype = T.neverRetype or {
    [0x008E6298] = "Town East first monster",
  }

  if _G.mayhemTypeBk[tb] == nil then
    local b = {}
    for i = 0, n - 1 do b[i] = rec[i].t end
    _G.mayhemTypeBk[tb] = b
  end
  local orig = _G.mayhemTypeBk[tb]

  local permitted, src = {}, "all weighted types"
  if T.autoPool then
    -- Registry first: it is the only source that reflects what this VISIT
    -- has loaded. Fall back to the spawn table if it cannot be read, and
    -- say so, because that fallback is the day/night trap.
    local live = loadedTypes()
    if live then
      for t in pairs(live) do permitted[t] = true end
      src = "loaded registry"
    else
      for i = 0, n - 1 do permitted[orig[i]] = true end
      src = "spawn table (registry unreadable - RISKY)"
    end
    for t in pairs(M.extraTypes) do permitted[t] = true end
  else
    for t in pairs(M.weights) do permitted[t] = true end
  end

  -- Proven types cost nothing to spawn; unproven ones pay a bank intro.
  -- Ration the unproven ones so a single pass cannot queue several banks.
  local proven = _G.mayhemProven or {}
  local novelBudget = T.novelPerPass or 2
  local deferred = {}

  local ladder, total, dropped = {}, 0, {}
  local wkeys = {}
  for t in pairs(M.weights) do wkeys[#wkeys + 1] = t end
  table.sort(wkeys, function(a, b)
    local pa, pb = proven[a] and 1 or 0, proven[b] and 1 or 0
    if pa ~= pb then return pa &gt; pb end      -- proven types get first refusal
    return a &lt; b
  end)

  -- Rotate the novel ration. Tie-breaking unproven types by ID meant the same
  -- low-ID types consumed the budget every pass; the rest were deferred, so
  -- they never spawned, never became proven, and were deferred forever.
  do
    local first
    for i, t in ipairs(wkeys) do if not proven[t] then first = i break end end
    if first then
      for i = #wkeys, first + 1, -1 do
        local j = math.random(first, i)
        wkeys[i], wkeys[j] = wkeys[j], wkeys[i]
      end
    end
  end

  for _, t in ipairs(wkeys) do
    local w = M.weights[t]
    if w &gt; 0 then
      if M.needGuard[t] and not mayhemGuardActive() then
        dropped[#dropped + 1] = nameOf(t) .. " (no Animation Guard)"
      elseif not permitted[t] then
        dropped[#dropped + 1] = nameOf(t)
      elseif proven[t] or novelBudget &gt; 0 then
        if not proven[t] then novelBudget = novelBudget - 1 end
        total = total + w
        ladder[#ladder + 1] = { t = t, upto = total }
      else
        deferred[#deferred + 1] = nameOf(t)
      end
    end
  end
  if total == 0 then
    print("[Types]   Nothing in the weight list is loaded here - left alone.")
    return true
  end
  table.sort(ladder, function(a, b) return a.upto &lt; b.upto end)

  local function pick()
    local roll = math.random() * total
    for _, e in ipairs(ladder) do if roll &lt;= e.upto then return e.t end end
    return ladder[#ladder].t
  end

  local after, changed, blocked = {}, 0, 0
  for i = 0, n - 1 do
    local ot = orig[i]
    local nt = ot
    if not T.neverRetype[rec[i].addr] and not M.protected[ot] and M.sources[ot] then
      nt = pick()
      -- Belt and braces: never write a type the pool does not permit.
      if not permitted[nt] then nt = ot; blocked = blocked + 1 end
      if nt ~= ot then changed = changed + 1 end
    end
    writeSmallInteger(rec[i].addr + R_TYPE, nt)
    rec[i].t = nt
    after[nt] = (after[nt] or 0) + 1
  end

  local keys = {}
  for t in pairs(after) do keys[#keys + 1] = t end
  table.sort(keys)
  local parts = {}
  for _, t in ipairs(keys) do parts[#parts + 1] = string.format("%s x%d", nameOf(t), after[t]) end
  print(string.format("[Types]   %d of %d rewritten: %s", changed, n, table.concat(parts, ", ")))
  print(string.format("[Types]   pool source: %s", src))
  if #dropped &gt; 0 then
    table.sort(dropped)
    print("[Types]   Not loaded here, weight redistributed: " .. table.concat(dropped, ", "))
  end
  if blocked &gt; 0 then
    print(string.format("[Types]   %d picks blocked as unavailable here.", blocked))
  end
  if #deferred &gt; 0 then
    table.sort(deferred)
    print("[Types]   Held back this pass (bank not yet loaded): " ..
          table.concat(deferred, ", "))
    print("[Types]   Reshuffle again once these have appeared to add more.")
  end
  if not T.autoPool then
    print("[Types]   WARNING: autoPool is OFF. A type this level never loaded")
    print("[Types]   will freeze the game on a sound assert (00518E96).")
  end
  return true
end

--------------------------------------------------------------- 4b. COMBAT

-- Attack damage table. Base 006EC384, stride 0x24, index = low byte of
-- [ecx+2E] at the read site 005434B3. Damage float is at record +0x00.
-- Verified: index 55 -&gt; 006ECB40 -&gt; 41F00000 -&gt; 30.0 (PH Spear Thrust).
local ATK_BASE, ATK_STRIDE = 0x006EC384, 0x24
local function atkAddr(i) return ATK_BASE + i * ATK_STRIDE end

-- { index, group key, display name }
local ATTACKS = {
  { 42, "LyingFigure",   "Acid" },
  { 43, "LyingFigure",   "Bite" },
  { 44, "Mannequin",     "Right Swing" },
  { 45, "Mannequin",     "Left Swing" },
  { 46, "Nurse",         "Pipe Swing" },
  { 47, "Nurse",         "Pipe Thrust" },
  { 48, "DarkNurse",  "Pipe Swing" },
  { 49, "DarkNurse",  "Pipe Thrust" },
  { 50, "PyramidHead",   "Great Knife Slice" },
  { 51, "PyramidHead",   "Great Knife Overhead" },   -- see instakill note
  { 52, "PyramidHead",   "Punch" },
  { 53, "PyramidHead",   "Grab" },
  { 54, "PyramidHead",   "Strangle" },
  { 55, "PyramidHead",   "Spear Thrust" },
  { 56, "PyramidHead",   "Spear Wild Swing" },
  { 58, "Eddie",         "Punch" },
  { 59, "Eddie",         "Shoot" },
  { 60, "FleshLip",      "Stab" },
  { 61, "FleshLip",      "Strangle" },
  { 62, "FleshLip",      "Kick" },
  { 63, "AbstractDaddy", "Grab" },
  { 64, "AbstractDaddy", "Suck" },
  { 65, "Mary",          "Grab" },
  { 66, "Mary",          "Strangle" },
  { 67, "Mary",          "Tail Stab" },
  { 68, "Mary",          "Moth Bite" },
  { 69, "Mary",          "Moth Swarming" },
  { 70, "Closer",        "Left Stab" },
  { 71, "Closer",        "Right Stab" },
}
-- Index 57 is unmapped and deliberately absent. Do not guess it.
M.attacks = ATTACKS

-- Snapshot the SHIPPED values once, so Defaults restores cleanly however
-- many times the sliders have been dragged. Taken lazily on first use:
-- the table is static exe data and readable whether or not a level is up.
local function dmgSnapshot()
  if _G.mayhemDmgBk then return true end
  local b = {}
  for _, a in ipairs(ATTACKS) do
    local v = readFloat(atkAddr(a[1]))
    if v == nil then
      print("[Combat] attack table unreadable - damage scaling unavailable.")
      return false
    end
    b[a[1]] = v
  end
  _G.mayhemDmgBk = b
  return true
end

function mayhemDmgApply()
  if not dmgSnapshot() then return false end
  local tbl = getAddressSafe("dmgTable")
  local flg = getAddressSafe("dmgOn")
  if tbl == nil or flg == nil then
    print("[Combat] SH2_Damage_Hook.CEA is not enabled - damage sliders inert.")
    return false
  end
  local b = _G.mayhemDmgBk
  -- Fill every slot first, including the ones we do not scale, so a
  -- stale zero can never reach the game. Only then arm the flag.
  for i = 0, 127 do
    local base = b[i]
    if base == nil then base = readFloat(0x006EC384 + i * 0x24) or 0.0 end
    writeFloat(tbl + i * 4, base)
  end
  if C.dmgOn then
    for _, a in ipairs(ATTACKS) do
      local m = C.dmgGlobal * (M.dmgGroups[a[2]] or 1.0)
      writeFloat(tbl + a[1] * 4, b[a[1]] * m)
    end
  end
  writeInteger(flg, C.dmgOn and 1 or 0)
  return true
end

function mayhemDmgRestore()
  local b = _G.mayhemDmgBk
  if b == nil then return end
  for i, v in pairs(b) do writeFloat(atkAddr(i), v) end
  print("[Combat] Shipped damage values restored.")
end

function mayhemDmgList()
  if not dmgSnapshot() then return end
  local b = _G.mayhemDmgBk
  print("---------------------------------------------------------")
  for _, a in ipairs(ATTACKS) do
    print(string.format("[Combat] %3d  %08X  %-14s %-22s  %8.2f -&gt; %8.2f",
          a[1], atkAddr(a[1]), M.dmgGroupNames[a[2]], a[3],
          b[a[1]], readFloat(atkAddr(a[1])) or 0))
  end
  print("---------------------------------------------------------")
end

-- Speed. Each enemy has its own five-entry difficulty array, built on the
-- stack from imm32 operands. The immediate sits at instruction start + 4.
-- S39: STRIDE IS NOT UNIFORM. Apartment Boss and Pyramid Head carry an extra
-- 3-byte instruction between Beginner and Easy (0x0B, then 8,8,8), so every
-- address is listed explicitly. All 40 verified in-process against C7 44 24.
local SPD = {
  {key="lying",     name="Lying Figure",    a={0x004C4337,0x004C433F,0x004C4347,0x004C434F,0x004C4357}},
  {key="crawling",  name="Crawling Figure", a={0x004C43C7,0x004C43CF,0x004C43D7,0x004C43DF,0x004C43E7}},
  {key="mannequin", name="Mannequin",       a={0x004C1667,0x004C166F,0x004C1677,0x004C167F,0x004C1687}},
  {key="nurse",     name="Nurse",           a={0x004BA2B7,0x004BA2BF,0x004BA2C7,0x004BA2CF,0x004BA2D7}},
  {key="fleshlips", name="Flesh Lips",      a={0x004B8A97,0x004B8A9F,0x004B8AA7,0x004B8AAF,0x004B8AB7}},
  {key="daddy",     name="Abstract Daddy",  a={0x004B5D77,0x004B5D7F,0x004B5D87,0x004B5D8F,0x004B5D97}},
  {key="aptboss",   name="Apartment Boss",  a={0x004BEFFA,0x004BF005,0x004BF00D,0x004BF015,0x004BF01D}},
  {key="ph",        name="Pyramid Head",    a={0x004BC0AA,0x004BC0B5,0x004BC0BD,0x004BC0C5,0x004BC0CD}},
}
M.spdGroupList = SPD

local DIFF_BYTE = 0x01DBBFF4        -- Action Level, 1 byte. +1 is Riddle.
local DIFF_NAME = { [0]="Beginner", [1]="Easy", [2]="Normal",
                    [3]="Hard", [4]="Extra" }

-- assert(), by hand. Refuse to write if the opcode is not the C7 44 24 we
-- decoded. Checks every address of every group; one bad entry aborts all.
local function spdVerify()
  for _, g in ipairs(SPD) do
    for i = 1, 5 do
      local b = readBytes(g.a[i] - 4, 3, true)
      if b == nil or b[1] ~= 0xC7 or b[2] ~= 0x44 or b[3] ~= 0x24 then
        print(string.format(
          "[Combat] ABORTED - %s slot %d (%08X) is not C7 44 24. Speed left alone.",
          g.name, i - 1, g.a[i] - 4))
        return false
      end
    end
  end
  return true
end

function mayhemDifficulty()
  local b = readBytes(DIFF_BYTE, 1, true)
  local v = b and b[1]
  if v == nil then return nil, "unreadable" end
  if v &gt; 4 then return nil, string.format("out of range (%d)", v) end
  return v, DIFF_NAME[v]
end

function mayhemSpdApply()
  if not spdVerify() then return false end
  if _G.mayhemSpdBk == nil then
    local b = {}
    for _, g in ipairs(SPD) do
      b[g.key] = {}
      for i = 1, 5 do
        b[g.key][i] = readFloat(g.a[i])
        if b[g.key][i] == nil then return false end
      end
    end
    _G.mayhemSpdBk = b
  end
  local b = _G.mayhemSpdBk
  -- All five slots of every group, always. Writing one would need the live
  -- difficulty index; writing all is the same cost, survives a difficulty
  -- change mid-session, and is immune to the Story-mode out-of-range value.
  local m = C.spdOn and C.spdMul or 1.0
  for _, g in ipairs(SPD) do
    for i = 1, 5 do writeFloat(g.a[i], b[g.key][i] * m) end
  end
  return true
end

function mayhemSpdRestore()
  local b = _G.mayhemSpdBk
  if b == nil or not spdVerify() then return end
  for _, g in ipairs(SPD) do
    for i = 1, 5 do writeFloat(g.a[i], b[g.key][i]) end
  end
  print("[Combat] Stock speed multipliers restored.")
end

function mayhemSpdList()
  if not spdVerify() then return end
  local idx = mayhemDifficulty()
  print("---------------------------------------------------------")
  for _, g in ipairs(SPD) do
    local cur = {}
    for i = 1, 5 do cur[i] = string.format("%.2f", readFloat(g.a[i]) or 0) end
    print(string.format("[Combat] %-16s %s", g.name, table.concat(cur, " / ")))
  end
  print(string.format("[Combat] difficulty: %s", idx and DIFF_NAME[idx] or "?"))
  print("---------------------------------------------------------")
end

function mayhemCombatStatus()
  local idx, nm = mayhemDifficulty()
  print(string.format("[Combat] difficulty: %s%s", nm,
        idx == nil and "  &lt;- speed array would be indexed out of bounds" or ""))
  print(string.format("[Combat] damage %s  x%.2f global   speed %s  x%.2f",
        C.dmgOn and "ON " or "off", C.dmgGlobal,
        C.spdOn and "ON " or "off", C.spdMul))
end

------------------------------------------------------------- 5. PHANTOM
local trail = {}
local phantomIndoors = false

local function eligible(a, pptr)
  if a == pptr then return false end
  local t = readSmallInteger(a + E_TYPE)
  if t == nil or t == 0 then return false end
  if (t &gt;&gt; 8) ~= 2 then return false end        -- enemies only
  if M.neverMove[t] then return false end
  local st = readInteger(a + E_STATE) or 0
  if (st &amp; 0x400) == 0 then return false end    -- parked shell, not really there
  if (readInteger(a + E_SKEL) or 0) == 0 then return false end
  return true, t
end

local function dist2D(x1, z1, x2, z2)
  local dx, dz = x1 - x2, z1 - z2
  return math.sqrt(dx * dx + dz * dz)
end

local function phantomMode()
  if P.autoIndoor and phantomIndoors then return P.indoorMode end
  return P.mode
end
local function phantomMinDist()
  if P.autoIndoor and phantomIndoors then return P.indoorMinDist end
  return P.minDistance
end

local function pickDestination(px, py, pz)
  if phantomMode() == "ring" then
    -- If ringMax exceeds minDistance an enemy stays eligible right after being
    -- moved, so it teleports again next tick. Fine if you want chaos; set
    -- ringMax below minDistance for single pounces.
    local ang = math.random() * math.pi * 2
    local r   = P.ringMin + math.random() * (P.ringMax - P.ringMin)
    return px + math.cos(ang) * r, py, pz + math.sin(ang) * r
  end
  local lo, hi = P.trailMinAge, math.min(P.trailMaxAge, #trail)
  if hi &lt; lo then return nil end
  local s = trail[#trail - math.random(lo, hi) + 1]
  if s == nil then return nil end
  return s.x, s.y, s.z
end

local function phantomTick(force)
  local pptr = playerEnt(); if pptr == nil then return end
  local px, py, pz = readFloat(pptr + E_X), readFloat(pptr + E_Y), readFloat(pptr + E_Z)
  if px == nil or py == nil or pz == nil then return end
  if px ~= px or py ~= py or pz ~= pz then return end

  local last = trail[#trail]
  if last == nil or dist2D(px, pz, last.x, last.z) &gt; 60.0 then
    trail[#trail + 1] = { x = px, y = py, z = pz }
    if #trail &gt; 64 then table.remove(trail, 1) end
  end

  local minD, moved = phantomMinDist(), 0
  for i = 0, ENT_SLOTS - 1 do
    if moved &gt;= P.maxPerTick then break end
    local a = ENT_BASE + i * ENT_STRIDE
    local ok, t = eligible(a, pptr)
    if ok then
      local ex, ez = readFloat(a + E_X), readFloat(a + E_Z)
      if ex ~= nil and ez ~= nil then
        local d = dist2D(ex, ez, px, pz)
        if d &gt; minD and (force or math.random() &lt; P.chance) then
          local dx, dy, dz = pickDestination(px, py, pz)
          if dx ~= nil then
            writeFloat(a + E_X, dx); writeFloat(a + E_Y, dy); writeFloat(a + E_Z, dz)
            if P.facePlayer then writeFloat(a + E_FACE, math.atan(px - dx, pz - dz)) end
            if P.verbose then
              print(string.format("[Phantom] %s -&gt; %.0f, %.0f", nameOf(t), dx, dz))
            end
            moved = moved + 1
            if force then return end
          end
        end
      end
    end
  end
end

------------------------------------------------- 5b. GOVERNOR + DIRECTOR
local quietFor = 0

local function countNear(radius)
  local pptr = playerEnt(); if pptr == nil then return 0 end
  local px, pz = readFloat(pptr + E_X), readFloat(pptr + E_Z)
  if px == nil or pz == nil then return 0 end
  local n = 0
  for i = 0, ENT_SLOTS - 1 do
    local a = ENT_BASE + i * ENT_STRIDE
    if eligible(a, pptr) then
      local ex, ez = readFloat(a + E_X), readFloat(a + E_Z)
      if ex and ez and dist2D(ex, ez, px, pz) &lt;= radius then n = n + 1 end
    end
  end
  return n
end

local function governorTick()
  if not D.governor then return end
  local free = readInteger(COUNT)
  if free == nil then return end
  if free &lt; D.governorFloor and D.enemyCap &gt; D.governorMin then
    mayhemSetCap(D.enemyCap - 1, false)
    M.governorActive = true
  elseif M.governorActive and free &gt; D.governorFloor * 3 then
    local want = M.capWanted or D.enemyCap
    if M.on.types then want = math.min(want, M.capCeilingTypes) end
    if D.enemyCap &lt; want then
      mayhemSetCap(D.enemyCap + 1, false)
    else
      M.governorActive = false
    end
  end
end

local function directorTick()
  if not D.director then return end
  local near = countNear(D.directorRadius)
  if near == 0 then quietFor = quietFor + 1 else quietFor = 0 end
  if quietFor &gt;= D.quietSeconds then
    D.surgeTarget = math.min(D.directorMax, D.surgeTarget + 1)
    quietFor = 0
  elseif near &gt;= D.directorBusy then
    D.surgeTarget = math.max(D.directorMin, D.surgeTarget - 1)
  end
end

--------------------------------------------------------- 6. MASTER TIMER
local accD, accP, accSec = 0, 0, 0
local TICK = 50

local function onAreaChange(tb, rec, n)
  phantomIndoors = n &lt; P.indoorRecords
  trail = {}
  _G.mayhemActive = nil
  M.bossArea = false
  local orig = _G.mayhemTypeBk and _G.mayhemTypeBk[tb]   -- pre-Mayhem types
  for i = 0, n - 1 do
    local t = (orig and orig[i]) or rec[i].t
    if M.protected[t] then M.bossArea = true break end
  end
  print(string.format("[Mayhem]  Area %08X - %d records, %s%s", tb, n,
        phantomIndoors and "indoors" or "outdoors",
        M.bossArea and ", BOSS AREA (phantom + surge paused)" or ""))
end

if mayhemTimer then mayhemTimer.Enabled = false; mayhemTimer.destroy() end
mayhemTimer = createTimer(nil, false)
mayhemTimer.Interval = TICK
mayhemTimer.OnTimer = function()
  local tb = tableBase()
  if tb == nil then return end

  local rec, n
  if _G.mayhemLastTable ~= tb then
    -- LOAD GUARD: never touch a table the loader may still be building.
    -- Require the same table pointer on two consecutive ticks AND a living
    -- world (James exists) before applying anything. Writing game state
    -- mid-load is what crashed the Town East loader in the field.
    if _G.mayhemPendingTable ~= tb then
      _G.mayhemPendingTable = tb
      return
    end
    local ents = readInteger(ENT_COUNT)
    if ents == nil or ents &lt; 1 then return end
    rec, n = readTable(tb)
    if rec == nil or n == 0 then return end
    _G.mayhemLastTable = tb
    -- Bank residency is per-VISIT, not per-reshuffle. mayhemReshuffle() nils
    -- mayhemLastTable to force this branch, so clearing proven here wiped it
    -- on every reshuffle too. With proven empty every type reads as novel,
    -- the lowest type id eats the whole novelPerPass ration, and every other
    -- type is deferred forever -- they can never spawn, so they can never
    -- become proven. Symptom: 100% Lying Figure whatever the weight sliders
    -- say. Only clear it when the TABLE ADDRESS actually changes.
    if tb ~= _G.mayhemAreaTable then
      _G.mayhemProven = nil
      _G.mayhemAreaTable = tb
    end
    _G.mayhemNextRearm = nil
    _G.mayhemRearmQ = nil          -- stale subs belong to the previous area
    _G.mayhemBankPending = nil
    onAreaChange(tb, rec, n)
    if M.on.types then
      -- Populate proven from what is standing right now, before the ladder is
      -- built. Otherwise the first pass of every area always misreads a
      -- resident type as novel.
      provenSweep()
      applyTypes(tb, rec, n)
      if T.liveRespawn then rearm(rec, n) end
    end
    if M.on.density and D.crowds then _G.mayhemActive = applyCrowds(tb, rec, n) end
    local jm = jitterDuplicates(tb, rec, n)
    if jm &gt; 0 then
      print(string.format("[Jitter]  %d duplicate spawn point(s) separated by %d units.",
            jm, math.max(8, D.jitterUnits or 64)))
    end
    -- Meter the whole area's records whenever clustering is on: clustered
    -- pockets otherwise burst-spawn on first contact, which is the sound
    -- overflow. With liveRespawn also on this is the same call either way.
    if M.on.density and (D.crowds or D.liveRespawn) then rearm(rec, n) end
    _G.mayhemNextRearm = os.clock() + math.max(1, D.respawnEvery)
    return
  end

  accD = accD + TICK; accP = accP + TICK; accSec = accSec + TICK

  if accSec &gt;= 1000 then
    accSec = 0
    if M.on.density then governorTick(); directorTick() end
  end

  -- drip-arm whenever the meter holds records, gated on sound headroom
if _G.mayhemRearmQ and (M.on.density or M.on.types) then
    provenSweep()      -- must run first: rearmDrain reads _G.mayhemProven,
    rearmDrain()       -- and an empty proven set makes every type look novel
  end

  -- density: re-arm on its own clock, then surge
  if M.on.density then
    if D.liveRespawn and D.respawnEvery &gt; 0 then
      local now = os.clock()
      if _G.mayhemNextRearm == nil or now &gt;= _G.mayhemNextRearm then
        local r, cnt = readTable(tb)
        if r then rearm(r, cnt) end
        _G.mayhemNextRearm = now + math.max(1, D.respawnEvery)
      end
    end
    if accD &gt;= D.tickMs then
      accD = 0
      if D.crowds then
        if _G.mayhemActive == nil then
          local r, cnt = readTable(tb)
          if r then _G.mayhemActive = applyCrowds(tb, r, cnt) end
        elseif D.surge and not (M.bossPause and M.bossArea) then
          surgeTick(_G.mayhemActive)
        end
      end
    end
  end

  if M.on.phantom and accP &gt;= P.intervalMs then
    accP = 0
    if not (M.bossPause and M.bossArea) then phantomTick(false) end
  end
end
mayhemTimer.Enabled = true

--------------------------------------------------------- 7. TOGGLES
function mayhemDensity(on)
  M.on.density = on and true or false
  if M.on.density then
    patchesOn()
    _G.mayhemActive = nil
  else
    patchesOff()
    restoreCrowds()
  end
  print("[Mayhem]  Density " .. (M.on.density and "ON" or "OFF"))
  return M.on.density
end

function mayhemPhantom(on)
  M.on.phantom = on and true or false
  if not M.on.phantom then trail = {} end
  print("[Mayhem]  Phantom " .. (M.on.phantom and "ON" or "OFF"))
  return M.on.phantom
end

function mayhemTypes(on)
  M.on.types = on and true or false
  if M.on.types then
    _G.mayhemLastTable = nil   -- forces a re-apply on the next tick
    mayhemSetCap(M.capWanted or D.enemyCap, false)   -- re-clamp: the cap may
                                                     -- have been set while
                                                     -- types was still off
  else
    restoreTypes()
    _G.mayhemLastTable = nil
  end
  print("[Mayhem]  Types " .. (M.on.types and "ON" or "OFF"))
  return M.on.types
end

function mayhemReshuffle()
  _G.mayhemActive = nil
  _G.mayhemLastTable = nil
  print("[Mayhem]  Reshuffling on the next tick.")
end

function mayhemPanic()
  mayhemPhantom(false)
  mayhemTypes(false)
  mayhemDensity(false)
  _G.mayhemRearmQ = nil
  _G.mayhemBankPending = nil
  print("[Mayhem]  PANIC - everything off and restored.")
end

function mayhemStatus()
  print("---------------------------------------------------------")
  print(string.format("[Mayhem]  density %s   phantom %s   types %s",
        M.on.density and "ON " or "off", M.on.phantom and "ON " or "off",
        M.on.types and "ON " or "off"))
  print(string.format("[Mayhem]  area: %s%s   bone budget %s   entities %s / 32",
        phantomIndoors and "indoors" or "outdoors",
        M.bossArea and " (BOSS)" or "",
        tostring(readInteger(COUNT)), tostring(readInteger(ENT_COUNT))))
  print(string.format("[Mayhem]  sound users %s / %d   re-arm queue %d waiting",
        tostring(readInteger(sndIdxAddr())), sndBound(),
        _G.mayhemRearmQ and #_G.mayhemRearmQ or 0))
  local pptr = playerEnt()
  if pptr then
    local live = 0
    for i = 0, ENT_SLOTS - 1 do
      if eligible(ENT_BASE + i * ENT_STRIDE, pptr) then live = live + 1 end
    end
    print(string.format("[Mayhem]  %d live enemies, cap %d%s, trail %d samples",
          live, D.enemyCap,
          M.governorActive and string.format(" (governor trimmed from %d)", M.capWanted or D.enemyCap) or "",
          #trail))
  end
  print("---------------------------------------------------------")
end

--------------------------------------------------------- 8. STARTUP
math.randomseed(os.time())
print("=========================================================")
if M.on.density then patchesOn() end

-- Hotkeys removed: the cheat table and the game both use the F keys, and a
-- stray F8 firing mayhemPanic() mid-session is the kind of thing you spend an
-- hour diagnosing. Everything is reachable from the Control Panel or the
-- console. Any stale hotkeys from an earlier enable are torn down here.
if _G.mayhemKeys then
  for _, h in ipairs(_G.mayhemKeys) do pcall(function() h.destroy() end) end
  _G.mayhemKeys = nil
end

print(string.format("[Mayhem]  Enemy Spawn System v1.0   density %s   phantom %s   types %s",
      M.on.density and "ON" or "off", M.on.phantom and "ON" or "off",
      M.on.types and "ON" or "off"))
print("[Mayhem]  mayhemStatus()  mayhemReshuffle()  mayhemPanic()")
print("=========================================================")
{$asm}


[DISABLE]
{$lua}
if syntaxcheck then return end

if mayhemTimer then
  mayhemTimer.Enabled = false
  mayhemTimer.destroy()
  mayhemTimer = nil
end
if _G.mayhemKeys then
  for _, h in ipairs(_G.mayhemKeys) do pcall(function() h.destroy() end) end
  _G.mayhemKeys = nil
end

-- Spawn tables are static exe data, so everything touched must go back.
local function restoreAll()
  local recs = 0
  for tb, b in pairs(_G.mayhemTypeBk or {}) do
    for i, t in pairs(b) do writeSmallInteger(tb + i * 0x14, t); recs = recs + 1 end
  end
  for tb, st in pairs(_G.mayhemCrowdBk or {}) do
    for i, v in pairs(st) do
      writeInteger(tb + i * 0x14 + 0x04, v.x)
      writeInteger(tb + i * 0x14 + 0x08, v.y)
      writeSmallInteger(tb + i * 0x14 + 0x0C, v.h)
      recs = recs + 1
    end
  end
  if recs &gt; 0 then print(string.format("[Mayhem]  Restored %d spawn records.", recs)) end
  _G.mayhemTypeBk, _G.mayhemCrowdBk = {}, {}
end
restoreAll()

-- Damage is data and speed is code; both must go back before the script
-- is gone, because nothing else in the process will put them right.
if mayhemDmgRestore then pcall(mayhemDmgRestore) end
if mayhemSpdRestore then pcall(mayhemSpdRestore) end
_G.mayhemDmgBk, _G.mayhemSpdBk = nil, nil

local function put(nm, fn, v)
  if v == nil then return end
  local a = getAddress(nm)
  if a and a ~= 0 then fn(a, v) end
end
put("sh2pc.exe+2A9D98", writeFloat, (_G.mayhemSpawnOrig or {})[1])
put("sh2pc.exe+2A9DA0", writeFloat, (_G.mayhemSpawnOrig or {})[2])
put("sh2pc.exe+8F009",  writeInteger, _G.mayhemEvictOrig)
put("sh2pc.exe+90258",  writeBytes,   _G.mayhemFilterOrig)
put("sh2pc.exe+90204",  writeBytes,   _G.mayhemCapOrig)
_G.mayhemSpawnOrig, _G.mayhemEvictOrig = nil, nil
_G.mayhemFilterOrig, _G.mayhemCapOrig = nil, nil

for _, e in ipairs({
  { "sh2pc.exe+13AAF4", 0x5782 }, { "sh2pc.exe+13AAF9", 0x01F96840 },
  { "sh2pc.exe+13AB00", 0x01F96840 }, { "sh2pc.exe+13AB0A", 0x190 },
  { "sh2pc.exe+13AB14", 0x18F },
}) do
  local a = getAddress(e[1]); if a and a ~= 0 then writeInteger(a, e[2]) end
end
_G.mayhemArena, _G.mayhemArenaSpan = nil, nil
_G.mayhemActive, _G.mayhemLastTable, _G.mayhemNextRearm = nil, nil, nil

print("[Mayhem]  Stock values restored. Reload a level before playing unpatched.")
print("[Mayhem]  Bone buffer left allocated on purpose - live bones may point into it.")
{$asm}


</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>35099</ID>
                  <Description>"Animation Guard"</Description>
                  <Color>7A8E4F</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
assert(sh2pc.exe+138D43,8B 44 24 18 0F BE F0)
define(animGuard,sh2pc.exe+138D43)
alloc(newmem,256,sh2pc.exe+138D43)
alloc(gStats,16)
label(code)
label(return)
label(noSub)
label(fallbackIdx)
registersymbol(gStats)
registersymbol(fallbackIdx)

gStats:
  dd 0                        // +00  guard reached
  dd 0                        // +04  null track caught
  dd 0                        // +08  substituted
fallbackIdx:
  dd 02                       // +0C  HEX. 01 = key 4E27 (30f knockdown)
                              //      02 / 06 / 0A / 0F / 13 = 15-frame clips
                              //      FFFFFFFF = skip (DIAGNOSTIC ONLY - locks James)

newmem:
  inc dword ptr [gStats]
  cmp dword ptr [esp+1C],0
  jne code
  inc dword ptr [gStats+04]

  push eax
  push ecx
  mov eax,[fallbackIdx]
  cmp eax,0
  jl noSub
  mov ecx,[01FB7B84]
  test ecx,ecx
  je noSub
  imul eax,eax,0C
  add ecx,eax
  cmp word ptr [ecx],0
  je noSub
  mov [esp+24],ecx            // overwrite arg4 in place
  inc dword ptr [gStats+08]
  pop ecx
  pop eax
  jmp code
noSub:
  pop ecx
  pop eax
  mov eax,3
  jmp short code+2

code:
  mov eax,[esp+18]
  movsx esi,al
  jmp return

animGuard:
  jmp newmem
  nop
  nop
return:

[DISABLE]
animGuard:
  db 8B 44 24 18 0F BE F0
unregistersymbol(gStats)
unregistersymbol(fallbackIdx)
dealloc(newmem)
dealloc(fallbackIdx)
dealloc(gStats)

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>36274</ID>
                  <Description>"Ordinal Guard"</Description>
                  <Color>7A8E4F</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game : sh2pc.exe (Silent Hill 2 Enhanced Edition)
  =================================================================
  ORDINAL GUARD  --  reject stale bone ordinals before they fault
  =================================================================

  sub_5AA620 iterates owner+0x08 records and passes each record's
  +0x6C word to sub_539720 with no validation of any kind:

    005AA6B1  mov al,[esi+8]                  ; record count
    005AA6C2  mov ecx,[esi+84]                ; array base
    005AA6C8  movsx edx,word ptr [ecx+edi+6C] ; &lt;- hooked, 5 bytes
    005AA6CD  lea eax,[ecx+edi]
    005AA6D0  push edx                        ; arg4
    005AA6E0  call sub_539720

  S39 established that owner+0x08 is set to the full record count
  before the fill loop has written those records. sub_5AA620 can
  therefore read records still holding the previous tenant's bytes -
  usually an allocator prefix left behind when the block was free.
  Its +0x6C word sign-extends into an ordinal in the thousands, and
  sub_539720 walks the bone chain off its end and dereferences null
  at 00539745.

  This substitutes ordinal 0 for any out-of-range value. It is a
  redirect, not a suppression: bone 0 exists in every skeleton the
  engine builds, so the shipped code runs unmodified on a value it
  can resolve. A substituted attachment can look wrong; it cannot
  fault.

  Legitimate ordinals observed across every S39 capture peak at
  0x24. ordMax defaults to 0x3F for headroom, live 4-byte value.

  This is a MITIGATION. The root cause is owner+0x08 being trusted
  while the array is unpopulated, and it is not fixed here.

  SYMBOLS EXPORTED
    ordStats  +00 ordinals passed
              +04 ordinals substituted  &lt;- should stay 0 in
                                           ordinary play
    ordMax    dword. highest ordinal accepted. HEX.
}

[ENABLE]
assert(005AA6C8,0F BF 54 39 6C)
alloc(ordCave,256,005AA6C8)
alloc(ordStats,8)
alloc(ordMax,4)
registersymbol(ordStats)
registersymbol(ordMax)
label(subst)
label(ordReturn)

ordStats:
  dd 0
  dd 0
ordMax:
  dd 0000003F

ordCave:
  movsx edx,word ptr [ecx+edi+6C]
  pushfd
  cmp edx,0
  jl subst
  cmp edx,[ordMax]
  jg subst
  inc dword ptr [ordStats]
  popfd
  jmp ordReturn
subst:
  inc dword ptr [ordStats+04]
  xor edx,edx
  popfd
  jmp ordReturn

005AA6C8:
  jmp ordCave
ordReturn:

[DISABLE]
005AA6C8:
  db 0F BF 54 39 6C
unregistersymbol(ordStats)
unregistersymbol(ordMax)
dealloc(ordMax)
dealloc(ordStats)
dealloc(ordCave)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>36275</ID>
                  <Description>"Bone Walk Guard"</Description>
                  <Color>7A8E4F</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game : sh2pc.exe (Silent Hill 2 Enhanced Edition)
  =================================================================
  BONE WALK GUARD  --  stop the chain walk at the last real node
  =================================================================

    0053973C  mov ecx,[eax+9C]   ; skeleton root
    00539742  jbe 539749         ; ordinal 0 -&gt; no walk
    00539744  dec edx            ; &lt;- hooked, 5 bytes
    00539745  mov ecx,[ecx]      ; no null check
    00539747  jne 539744
    00539749  ...uses ecx+8

  Two ways this faults: a null skeleton root, or an ordinal larger
  than the entity's actual bone count. Chains measured 29-36 nodes
  (S6m, and EDX at the S39 fault showing 36 hops), so an ordinal
  need not be absurd to overrun - it only has to exceed the count
  for the type actually resolved, which retyping changes.

  Truncation arm: stop at the deepest node that exists and let
  00539749 run on it. That is a real node the engine built.
  Null-root arm: take the ret at 0053975B, the same exit the
  engine already uses when sub_537D00 returns null.

  Both arms are shipped engine states, not novel ones.

  SYMBOLS EXPORTED
    walkStats  +00 walks entered
               +04 truncated   (ordinal exceeded the chain)
               +08 null root   (entity +0x9C was 0)
}

[ENABLE]
assert(00539744,4A 8B 09 75 FB)
alloc(walkCave,256,00539744)
alloc(walkStats,16)
registersymbol(walkStats)
label(wLoop)
label(wTrunc)
label(wNull)
label(wReturn)

walkStats:
  dd 0
  dd 0
  dd 0
  dd 0

walkCave:
  inc dword ptr [walkStats]
  test ecx,ecx
  je wNull
wLoop:
  cmp dword ptr [ecx],0
  je wTrunc
  dec edx
  mov ecx,[ecx]
  test edx,edx
  jne wLoop
  jmp wReturn
wTrunc:
  inc dword ptr [walkStats+04]
  jmp wReturn
wNull:
  inc dword ptr [walkStats+08]
  jmp 0053975B

00539744:
  jmp walkCave
wReturn:

[DISABLE]
00539744:
  db 4A 8B 09 75 FB
unregistersymbol(walkStats)
dealloc(walkStats)
dealloc(walkCave)

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>36277</ID>
                  <Description>"Eviction Guard"</Description>
                  <Color>7A8E4F</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ SH2_Eviction_Guard.CEA
  ------------------------------------------------------------------------
  sub_48F000 (chara_admin.c) chooses an eviction victim when the 32-slot
  entity array is full. It walks the list from sub_53A7B0 through +0x194,
  keeps only entities whose [esi+10] high byte is 0x02, measures HORIZONTAL
  distance from [01FB7C80] using +0x1C (X) and +0x24 (Z) -- +0x20 is not in
  the metric -- and selects the FARTHEST one.

  The running maximum is seeded at 0048F009 with 16000.0f, so that value is
  also a floor: nothing closer than it can ever be selected. Entities whose
  health at +0x13C is &lt;= [0062EDDC] (0.0) get [006A9D8C] (32000.0, exactly
  twice the floor) added to their distance, so a corpse always clears the
  floor from anywhere on the map.

  If nothing clears the floor, EDI stays 0 at 0048F094 and the function
  falls into the assert at 0048F098 and parks forever on EB FE at 0048F0B0
  ("assert error", chara_admin.c line 959).

  CONFIRMED, paused capture at 0048F098 (S40):
      25 live, 0 dead, best effective distance 8354.1 vs floor 16000.0
  Corpse starvation. Every live enemy was inside the floor, and no corpse
  existed to use the bonus path. With "Furthest a spawn may appear" at
  13000 a live enemy cannot reach 16000 on Town East, so at ents 32/32
  with dead 0 the assert is deterministic, not unlucky.

  WHAT THIS GUARD DOES
  It does not change the selection and does not move the floor. It only
  supplies a fallback for the case the selection returns nothing: the last
  0x2xx entity the scan examined. Bound the input by what the consumer can
  survive, not by what the data looks like.

  If the scan examined no 0x2xx entity at all -- an empty list, or a list
  with no enemies -- the fallback is null and the assert is allowed to fire.
  That is a different fault and should not be masked.

  COST
  The capture hook sits inside the scan loop, but sub_48F000 only runs from
  sub_48F810 when the array is already full, not per frame. Two stores per
  candidate.

  TRADE-OFF
  The fallback is an arbitrary nearby enemy, so a rescue can despawn
  something in view. That is the price of not freezing. Watch evictStatus():
  if "rescued" climbs steadily, lower Despawn distance rather than relying
  on the guard -- the guard is a backstop, not a tuning knob.
  ------------------------------------------------------------------------
}

[ENABLE]

alloc(evictGuard,512)
alloc(evictLast,4)
alloc(evictStats,8)

registersymbol(evictGuard)
registersymbol(evictLast)
registersymbol(evictStats)

label(evCapture)
label(evGuard)
label(evGuardDone)
label(evAssert)

evictLast:
  dd 0

evictStats:
  dd 0          // +0  rescues: fallback supplied, freeze averted
  dd 0          // +4  assert allowed through: no 0x2xx entity at all

evictGuard:

// ---- capture: reached only by entities that passed the 0x2xx filter ----
evCapture:
  mov [evictLast],esi
  mov eax,[01FB7C80]
  jmp 0048F036

// ---- guard: replaces "test edi,edi / jne 48F0B2" ----
evGuard:
  push eax
  mov eax,[evictLast]
  mov [evictLast],00000000      // consume it; never reuse across calls
  test edi,edi
  jne evGuardDone               // normal selection succeeded
  test eax,eax
  je evAssert                   // no candidate was ever examined
  mov edi,eax
  add [evictStats],1
evGuardDone:
  pop eax
  jmp 0048F0B2

evAssert:
  pop eax
  add [evictStats+04],1
  push 3BF
  jmp 0048F09D

// A1 807CFB01  =  mov eax,[01FB7C80]      exactly 5 bytes
assert(0048F031,A1 807CFB01)
0048F031:
  jmp evCapture

// 85FF 751A 68BF030000  =  test/jne/push  exactly 9 bytes
assert(0048F094,85FF 751A 68BF030000)
0048F094:
  jmp evGuard
  nop
  nop
  nop
  nop

[DISABLE]

0048F031:
  db A1 80 7C FB 01

0048F094:
  db 85 FF 75 1A 68 BF 03 00 00

unregistersymbol(evictGuard)
unregistersymbol(evictLast)
unregistersymbol(evictStats)
dealloc(evictStats)
dealloc(evictLast)
dealloc(evictGuard)

{
  Lua companion -- paste into the CE table script:

  function evictStatus()
    local s = getAddress("evictStats")
    print(string.format("[Evict] rescued %d   assert allowed %d   floor %.1f",
      readInteger(s) or 0, readInteger(s+4) or 0,
      readFloat(getAddress("sh2pc.exe+8F009")) or 0))
  end
}


</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>36276</ID>
                  <Description>"PH Instakill Toggle"</Description>
                  <Color>7A8E4F</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ SH2_Instakill_Disable.CEA
  005434BE  75 14  jne 5434D4   -&gt;   EB 14  jmp 5434D4

  Attack 51 (PH Great Knife Overhead) is the only index sub_5434A0
  special-cases. It writes -1.0 into the victim's health at +0x13C
  before the damage table is read, which is why 1,000,000 HP does
  not survive it. This makes 51 fall through to the ordinary table
  path, where Damage_Hook governs it like every other attack.
  Record 51 sits at 006ECAB0 (006EC384 + 51 * 0x24).
}

[ENABLE]
assert(005434BE,75 14)
005434BE:
  db EB 14

[DISABLE]
005434BE:
  db 75 14

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>36272</ID>
                  <Description>"Damage Hook"</Description>
                  <Color>7A8E4F</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game : sh2pc.exe (Silent Hill 2 Enhanced Edition)
  =================================================================
  DAMAGE HOOK  --  scale enemy damage without writing read-only data
  =================================================================

  The attack table at 006EC384 lives in a Read Only section. Rather
  than rely on Cheat Engine quietly unprotecting the page, this
  intercepts the READ at 005434D7 and substitutes a value from a
  table we allocate ourselves.

    005434D4  lea eax,[eax+eax*8]        ; eax = index * 9
    005434D7  mov edx,[eax*4+6EC384]     ; &lt;- hooked, 7 bytes
    005434DE  mov [esi],edx              ; damage out-param

  The attack index is the low byte of [ecx+2E]. ECX is live here -
  the engine reads the same byte at 005434B3 and again at 005434E6.

  dmgOn stays 0 until Lua has populated dmgTable, so enabling this
  script on its own changes nothing. That ordering matters: an
  allocation is zero-filled, and a live table full of zeroes would
  make every enemy in the game harmless the moment you ticked it.

  SYMBOLS EXPORTED
    dmgTable   128 floats, indexed by attack index
    dmgOn      dword. 0 = pass through to the stock table
}

[ENABLE]
assert(sh2pc.exe+1434D7,8B 14 85 84 C3 6E 00)
alloc(dmgHook,256,sh2pc.exe+1434D7)
alloc(dmgTable,512)
alloc(dmgOn,4)
registersymbol(dmgTable)
registersymbol(dmgOn)
label(useOrig)
label(useOrigPop)
label(dmgReturn)

dmgOn:
  dd 0

dmgHook:
  cmp dword ptr [dmgOn],0
  je useOrig
  push eax
  movzx eax,byte ptr [ecx+2E]
  cmp eax,80
  jae useOrigPop
  mov edx,[eax*4+dmgTable]
  pop eax
  jmp dmgReturn
useOrigPop:
  pop eax
useOrig:
  mov edx,[eax*4+006EC384]
  jmp dmgReturn

sh2pc.exe+1434D7:
  jmp dmgHook
  nop
  nop
dmgReturn:

[DISABLE]
sh2pc.exe+1434D7:
  db 8B 14 85 84 C3 6E 00
unregistersymbol(dmgTable)
unregistersymbol(dmgOn)
dealloc(dmgOn)
dealloc(dmgTable)
dealloc(dmgHook)


</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>35101</ID>
                  <Description>"Control Panel"</Description>
                  <Color>00B789</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game : sh2pc.exe (Silent Hill 2 Enhanced Edition)
  =================================================================
  CONTROL PANEL  --  live settings for Enemy Mayhem
  =================================================================

  Optional. Enemy Mayhem runs fine without it.
  Enable SH2_Enemy_Mayhem.CEA FIRST, then this.

  Three columns, one per subsystem. Each scrolls on its own, and
  the window can be resized - drag it shorter and the columns grow
  scrollbars rather than clipping.

  PRESETS live in a text file in your Windows APPDATA folder, so
  they survive closing Cheat Engine and are not stored in the cheat
  table. "Last used" is written when you close the window and
  reloaded next time you open it.

  Pocket scatter, surge target and the type weights only bite when
  an area is re-clustered. Hit Reshuffle to force that.

  "Loaded Types" prints this area's resident enemy types to the
  Cheat Engine Lua console (Table -&gt; Show Cheat Table Lua Script,
  or Ctrl+Alt+L). The count is also on the status line.

  To turn everything off and put the game back, untick the Enemy
  Mayhem script itself - that restores more than this panel can.
}

[ENABLE]
{$lua}
if syntaxcheck then return end

--=================== THEME ===================
local BG    = 0x1C1C1C
local PANEL = 0x262626
local HEAD  = 0x303030
local TXT   = 0xD8D8D8
local DIM   = 0x8A8A8A
local ACC   = 0x6FE04A --0x4A6FE0
local WARN  = 0x40D0D0
--=============================================

-- Timer first: it touches labels on the form, so destroying the form while
-- the old timer is still live would fault on its next tick.
if sh2PanelTimer then
  sh2PanelTimer.Enabled = false; sh2PanelTimer.destroy(); sh2PanelTimer = nil
end
if sh2Panel then sh2Panel.destroy(); sh2Panel = nil end

if MAYHEM == nil or mayhemDensity == nil then
  showMessage("Enable SH2_Enemy_Mayhem.CEA first, then this panel.")
  error("[Panel] Enemy Mayhem is not loaded.")
end

local M = MAYHEM
local refreshers = {}
function sh2PanelRefresh() for _, f in ipairs(refreshers) do pcall(f) end end

-- Debounced reshuffle. A trackbar fires OnChange on every step of a drag, so
-- calling mayhemReshuffle() straight from a slider queues one full re-cluster
-- per pixel travelled. Instead we stamp a deadline and let the status timer
-- fire a single reshuffle once the value has been still for a moment.
local RESHUFFLE_DELAY = 0.45
local reshufflePending = nil
local function askReshuffle()
  reshufflePending = os.clock() + RESHUFFLE_DELAY
end
local function serviceReshuffle()
  if reshufflePending and os.clock() &gt;= reshufflePending then
    reshufflePending = nil
    if mayhemReshuffle then mayhemReshuffle() end
  end
end

local COL_W, COL_TOP, COL_H = 384, 128, 556
local COL_X = { 14, 412, 810, 1208 }

--=================== PRESETS ===================
local function presetPath()
  local d = os.getenv("APPDATA")
  if d == nil or d == "" then d = getCheatEngineDir() end
  return d .. "\\sh2_enemy_mayhem_presets.txt"
end

local GROUPS = { "on", "d", "p", "t", "c" }

local function serialize()
  local out = {}
  for _, key in ipairs(GROUPS) do
    local tbl = M[key]
    if type(tbl) == "table" then
      local keys = {}
      for k, v in pairs(tbl) do
        local ty = type(v)
        if ty == "number" or ty == "boolean" or ty == "string" then keys[#keys + 1] = k end
      end
      table.sort(keys)
      for _, k in ipairs(keys) do
        out[#out + 1] = string.format("%s.%s=%s", key, k, tostring(tbl[k]))
      end
    end
  end
  -- type weights, saved by hex id
  local ws = {}
  for t in pairs(M.weights) do ws[#ws + 1] = t end
  table.sort(ws)
  for _, t in ipairs(ws) do
    out[#out + 1] = string.format("w.%X=%s", t, tostring(M.weights[t]))
  end
  -- per-enemy damage multipliers
  local gs = {}
  for k in pairs(M.dmgGroups) do gs[#gs + 1] = k end
  table.sort(gs)
  for _, k in ipairs(gs) do
    out[#out + 1] = string.format("dg.%s=%s", k, tostring(M.dmgGroups[k]))
  end
  out[#out + 1] = "misc.bossPause=" .. tostring(M.bossPause)
  return table.concat(out, "\n")
end

local function deserialize(text)
  for line in text:gmatch("[^\r\n]+") do
    local grp, key, val = line:match("^(%w+)%.([%w_]+)=(.*)$")
    if grp then
      local v
      if val == "true" then v = true
      elseif val == "false" then v = false
      elseif tonumber(val) then v = tonumber(val)
      else v = val end
      if grp == "w" then
        local id = tonumber(key, 16)
        if id then M.weights[id] = v end
      elseif grp == "misc" then
        if key == "bossPause" then M.bossPause = v end
      elseif grp == "dg" then
        if M.dmgGroups[key] ~= nil then M.dmgGroups[key] = v end
      elseif M[grp] and type(M[grp]) == "table" then
        M[grp][key] = v
      end
    end
  end
end

local function loadAllPresets()
  local t, f = {}, io.open(presetPath(), "r")
  if f == nil then return t end
  local name, buf = nil, {}
  for line in f:lines() do
    local hdr = line:match("^%[(.+)%]$")
    if hdr then
      if name then t[name] = table.concat(buf, "\n") end
      name, buf = hdr, {}
    elseif name then buf[#buf + 1] = line end
  end
  if name then t[name] = table.concat(buf, "\n") end
  f:close()
  return t
end

local function saveAllPresets(t)
  local f = io.open(presetPath(), "w")
  if f == nil then print("[Panel] cannot write " .. presetPath()); return false end
  local names = {}
  for k in pairs(t) do names[#names + 1] = k end
  table.sort(names)
  for _, k in ipairs(names) do f:write("[", k, "]\n", t[k], "\n") end
  f:close()
  return true
end

-- True while the current area is indoors. Outdoor spawn distances must not be
-- written indoors; the tick owns the indoor values.
local function outdoors()
  return not (_G.mayhemActive and _G.mayhemActive.indoors)
end

local function applyLoadedSettings()
  if M.t.autoPool == false then
    print("[Panel] NOTE: this preset has unrestricted enemy types enabled.")
    print("[Panel] If the game freezes, tick 'Only use types this level already loaded'.")
  end
  if mayhemSetCap then mayhemSetCap(M.d.enemyCap, true) end
  if mayhemSetEvict then mayhemSetEvict(M.d.evictRange) end
  if mayhemSetSpawnRange and outdoors() then
    mayhemSetSpawnRange(M.d.spawnMinOut, M.d.spawnMaxOut)
  end
  mayhemDensity(M.on.density)
  mayhemPhantom(M.on.phantom)
  mayhemTypes(M.on.types)
  if mayhemSpdApply then mayhemSpdApply() end
  if mayhemReshuffle then mayhemReshuffle() end
  sh2PanelRefresh()
end

--=================== WINDOW ===================
sh2Panel = createForm(false)
sh2Panel.Caption = "Silent Hill 2 Enhanced Edition  -  Enemy Spawn System  v1.0"
sh2Panel.Width       = 1606
sh2Panel.Height      = 764
sh2Panel.Color       = BG
sh2Panel.BorderStyle = 'bsSizeable'
sh2Panel.Position    = 'poScreenCenter'

local function label(parent, x, y, text, colour, size, bold)
  local l = createLabel(parent)
  l.Left, l.Top, l.Caption = x, y, text
  l.Font.Color = colour or TXT
  l.Font.Size  = size or 9
  l.Font.Name  = "Segoe UI"
  if bold then l.Font.Style = '[fsBold]' end
  return l
end

--=================== THEMED COLUMN SCROLLING ===================
-- Custom rather than createScrollBox: the native bar cannot be themed.
-- outer clips, inner slides, track+thumb are ordinary panels in HEAD/ACC.
local colScroll = {}

local function scrollTo(s, v)
  if s.max &lt;= 0 then s.inner.Top = 0; s.pos = 0; return end
  if v &lt; 0 then v = 0 elseif v &gt; s.max then v = s.max end
  s.pos = v
  s.inner.Top = -v
  local room = s.track.Height - s.thumb.Height
  s.thumb.Top = room &gt; 0 and math.floor(room * v / s.max) or 0
end

local function column(idx, title)
  label(sh2Panel, COL_X[idx] + 2, COL_TOP - 20, title, ACC, 10, true)

  local outer = createPanel(sh2Panel)
  outer.Left, outer.Top, outer.Width, outer.Height = COL_X[idx], COL_TOP, COL_W, COL_H
  outer.BevelOuter = 'bvNone'
  pcall(function() outer.ParentColor = false end)
  outer.Color = PANEL
  pcall(function() outer.Anchors = '[akLeft,akTop,akBottom]' end)

  local inner = createPanel(outer)
  inner.Left, inner.Top, inner.Width, inner.Height = 0, 0, COL_W - 14, COL_H
  inner.BevelOuter = 'bvNone'
  pcall(function() inner.ParentColor = false end)
  inner.Color = PANEL

  local track = createPanel(outer)
  track.Left, track.Top, track.Width, track.Height = COL_W - 10, 0, 8, COL_H
  track.BevelOuter = 'bvNone'
  pcall(function() track.ParentColor = false end)
  track.Color = HEAD
  track.Visible = false
  pcall(function() track.Anchors = '[akTop,akRight,akBottom]' end)

  local thumb = createPanel(track)
  thumb.Left, thumb.Top, thumb.Width, thumb.Height = 0, 0, 8, 40
  thumb.BevelOuter = 'bvNone'
  pcall(function() thumb.ParentColor = false end)
  thumb.Color = ACC

  local s = { outer = outer, inner = inner, track = track, thumb = thumb,
              pos = 0, max = 0 }
  colScroll[inner] = s

  pcall(function()
    local function wheel(sender, shift, delta)
      local d = tonumber(delta) or 0
      scrollTo(s, s.pos - (d &gt; 0 and 60 or -60))
      return true
    end
    outer.OnMouseWheel = wheel
    inner.OnMouseWheel = wheel
  end)

  pcall(function()
    thumb.OnMouseDown = function(sender, button, shift, x, y) s.drag = y end
    thumb.OnMouseUp   = function() s.drag = nil end
    thumb.OnMouseMove = function(sender, shift, x, y)
      if s.drag == nil then return end
      local room = track.Height - thumb.Height
      if room &lt;= 0 then return end
      local t = thumb.Top + (y - s.drag)
      if t &lt; 0 then t = 0 elseif t &gt; room then t = room end
      scrollTo(s, math.floor(s.max * t / room))
    end
    track.OnMouseDown = function(sender, button, shift, x, y)
      local page = outer.Height - 40
      scrollTo(s, s.pos + ((y &lt; thumb.Top) and -page or page))
    end
  end)

  return inner
end

-- Measures the tallest child and sizes the thumb. Call after a column's
-- controls exist, and again whenever the form is resized.
local function columnFinish(inner)
  local s = colScroll[inner]
  if s == nil then return end
  local bottom = 0
  local ok = pcall(function()
    for i = 0, inner.ControlCount - 1 do
      local c = inner.getControl(i)
      local b = c.Top + c.Height
      if b &gt; bottom then bottom = b end
    end
  end)
  if not ok or bottom == 0 then bottom = inner.Height end
  local content = bottom + 14
  local view    = s.outer.Height
  inner.Height  = math.max(content, view)
  s.max = math.max(0, content - view)
  s.track.Visible = s.max &gt; 0
  if s.max &gt; 0 then
    s.thumb.Height = math.max(28, math.floor(view * view / content))
  end
  scrollTo(s, s.pos)
end

local SLIDER_W = 330

local function slider(parent, y, caption, minV, maxV, step, get, set, suffix)
  local x = 14
  label(parent, x, y, caption, DIM, 8)
  local val = label(parent, x + SLIDER_W - 92, y, "", ACC, 9, true)
  local tb  = createTrackBar(parent)
  tb.Left, tb.Top, tb.Width, tb.Height = x - 4, y + 15, SLIDER_W + 8, 26
  tb.Min, tb.Max = 0, math.floor((maxV - minV) / step)
  tb.TickStyle, tb.Frequency = 'tsNone', 1

  local function show(v)
    if suffix == "%" then val.Caption = string.format("%d%%", math.floor(v * 100 + 0.5))
    else val.Caption = string.format("%g%s", v, suffix or "") end
  end
  local guard = false
  tb.OnChange = function(sender)
    if guard then return end
    local v = minV + sender.Position * step
    show(v)
    local ok, err = pcall(set, v)
    if not ok then print("[Panel] " .. tostring(err)) end
  end
  local function refresh()
    local v = get() or minV
    guard = true
    tb.Position = math.max(0, math.min(tb.Max, math.floor((v - minV) / step + 0.5)))
    guard = false
    show(v)
  end
  refresh()
  refreshers[#refreshers + 1] = refresh
  return y + 50, refresh
end

-- Returns the next free y, so callers never have to track heights by hand.
local function checkbox(parent, y, caption, get, set, d1, d2)
  local x = 14
  local cb = createCheckBox(parent)
  cb.Left, cb.Top, cb.Caption = x, y, caption
  cb.Font.Color, cb.Font.Size, cb.Font.Name = TXT, 9, "Segoe UI"
  cb.Width = SLIDER_W
  local guard = false
  cb.Checked = get() and true or false
  cb.OnChange = function(sender)
    if guard then return end
    local ok, err = pcall(set, sender.Checked)
    if not ok then print("[Panel] " .. tostring(err)) end
  end
  local h = 22
  if d1 then label(parent, x + 18, y + 17, d1, DIM, 8); h = 40 end
  if d2 then label(parent, x + 18, y + 29, d2, DIM, 8); h = 52 end
  refreshers[#refreshers + 1] = function()
    guard = true; cb.Checked = get() and true or false; guard = false
  end
  return y + h
end

local function heading(parent, y, text)
  label(parent, 14, y, text, ACC, 9, true)
  return y + 20
end

local function button(parent, x, y, w, caption, onclick)
  local b = createButton(parent)
  b.Left, b.Top, b.Width, b.Height = x, y, w, 28
  b.Caption = caption
  b.OnClick = onclick
  return b
end

--=================== MASTER SWITCHES ===================
local top = createPanel(sh2Panel)
top.Left, top.Top, top.Width, top.Height = 14, 34, sh2Panel.Width - 28, 70
top.Color, top.BevelOuter = HEAD, 'bvNone'
pcall(function() top.Anchors = '[akLeft,akTop,akRight]' end)
label(sh2Panel, 16, 14, "SUBSYSTEMS", ACC, 10, true)

local function masterSwitch(x, caption, desc, get, set)
  local cb = createCheckBox(top)
  cb.Left, cb.Top, cb.Caption = x, 10, caption
  cb.Font.Color, cb.Font.Size, cb.Font.Name = TXT, 10, "Segoe UI"
  cb.Font.Style = '[fsBold]'
  cb.Width = 340
  local guard = false
  cb.Checked = get() and true or false
  cb.OnChange = function(s)
    if guard then return end
    local ok, err = pcall(set, s.Checked)
    if not ok then print("[Panel] " .. tostring(err)) end
  end
  local l = createLabel(top)
  l.Left, l.Top, l.Caption = x + 18, 30, desc
  l.Font.Color, l.Font.Size, l.Font.Name = DIM, 8, "Segoe UI"
  l.Width = 350
  refreshers[#refreshers + 1] = function()
    guard = true; cb.Checked = get() and true or false; guard = false
  end
end

masterSwitch(14, "Toggle Populator",
  "More/less enemies, clustered/scattered, close/far.",
  function() return M.on.density end, function(v) mayhemDensity(v) end)
masterSwitch(412, "Toggle Teleporter",
  "Teleports enemies around/behind/close/far from you.",
  function() return M.on.phantom end, function(v) mayhemPhantom(v) end)
masterSwitch(810, "Toggle Randomizer",
  "Rewrites which enemy each spawn point makes.",
  function() return M.on.types end, function(v) mayhemTypes(v) end)

--label(top, 14, 48, "Tick a box to turn a subsystem on or off.", DIM, 8)

--=================== COLUMN 1: DENSITY ===================
local L = column(1, "POPULATOR")
local y = 10

y, M.capRefresh = slider(L, y, "Enemy cap", 1, 31, 1,
  function() return M.d.enemyCap end,
  function(v) mayhemSetCap(v, true); M.capShown = nil end)
y = heading(L, y, "Spawn distance, outdoors")
local function pushSpawn()
  if outdoors() then mayhemSetSpawnRange(M.d.spawnMinOut, M.d.spawnMaxOut) end
end

y = slider(L, y, "Despawn distance", 200, 16000, 100,
  function() return M.d.evictRange or 16000 end, function(v) mayhemSetEvict(v) end, " u")
y = slider(L, y, "Nearest a spawn may appear", 0, 20000, 250,
  function() return M.d.spawnMinOut end,
  function(v) M.d.spawnMinOut = v; pushSpawn() end, " u")
y = slider(L, y, "Furthest a spawn may appear", 0, 40000, 500,
  function() return M.d.spawnMaxOut end,
  function(v) M.d.spawnMaxOut = math.max(v, M.d.spawnMinOut); pushSpawn() end, " u")

y = heading(L, y + 4, "Applies on the next load")
y = slider(L, y, "Pocket scatter, outdoors", 0, 8000, 100,
  function() return M.d.crowdRadius end, function(v) M.d.crowdRadius = v end, " u")
y = slider(L, y, "Loners  (share kept out of pockets)", 0, 100, 5,
  function() return M.d.lonerPercent or 0 end,
  function(v) M.d.lonerPercent = math.floor(v) end, " %")
y = slider(L, y, "Surge target  (records gathered near you)", 1, 60, 1,
  function() return M.d.surgeTarget end, function(v) M.d.surgeTarget = math.floor(v) end)
-- Pacing, not protection. This began as a guard against a "pristine pocket
-- bursts in one frame" sound overflow; that hypothesis is retracted (C-31.5).
y = slider(L, y, "Keep new pockets away from you  (pacing)", 0, 30000, 1000,
  function() return M.d.reshuffleClear or 0 end,
  function(v) M.d.reshuffleClear = math.floor(v) end, " u")
y = slider(L, y, "Re-arm killed spawn points every", 0, 120, 5,
  function() return M.d.respawnEvery end,
  function(v) M.d.respawnEvery = math.floor(v); _G.mayhemNextRearm = nil end, " s")

y = y + 6
y = checkbox(L, y, "Overworld Day/Night filter",
  function() return M.d.filterBypass end,
  function(v)
    if mayhemSetFilter then mayhemSetFilter(v) else M.d.filterBypass = v end
    if not v then print("[Panel] Filter bypass OFF - only the roster this visit would normally use.") end
  end,
