assert(sh2pc.exe+91961,8B 46 ? 3B C5 74)
define(transferStance,sh2pc.exe+91961)
alloc(newmem,2048)
alloc(weapon,4)

label(code return)

weapon:
  dd 007D6098 //Steel Pipe

newmem:
  cmp [esi+18],007D60B8 //Check for Great Knife Equipped
  jne code
  push ecx
  mov ecx,[weapon] //Apply Steel Pipe Stance Animation to Great Knife
  mov [esi+18],ecx
  mov eax,[esi+18]
  cmp eax,ebp
  pop ecx
  jmp return

code:
  mov eax,[esi+18]
  cmp eax,ebp
  jmp return

transferStance:
  jmp newmem
return:
registersymbol(transferStance weapon)

assert(sh2pc.exe+138D9D,89 41 ? 89 41 ? 5F)
define(transferMoveset,sh2pc.exe+138D9D)
alloc(newmem2,2048)

label(code2 return2)

newmem2:
  cmp eax, 006CF00C //GK Ready
  je gk01
  cmp eax, 006CEFF4 //GK Ready Left
  je gk02
  cmp eax, 006CF048 //GK Stance
  je gk03
  cmp eax, 006CF03C //GK Stance Left
  je gk04
  cmp eax, 006CF024 //GK Stance Recovering
  je gk05
  cmp eax, 006CF030 //GK Stance Recovering Left
  je gk06
  cmp eax, 006CF06C //GK Swing
  je gk07
  cmp eax, 006CF078 //GK Swing Wall Collision
  je gk08
  cmp eax, 006CF054 //GK Swing Left
  je gk09
  cmp eax, 006CF060 //GK Swing Left Wall Collision
  je gk10
  cmp eax, 006CF09C //GK Over
  je gk11
  cmp eax, 006CF0A8 //GK Over Wall Collision
  je gk12
  cmp eax, 006CF084 //GK Over Left
  je gk13
  cmp eax, 006CF090 //GK Over Left Wall Collision
  je gk14
  cmp eax, 006CF018 //GK Disengage
  je gk15
  cmp eax, 006CF000 //GK Disengage Left
  je gk16
  jmp code2 //Not a GK animation, skip replacement

gk01:
  mov eax, 006CECEC //Plank Ready
  jmp code2
gk02:
  mov eax, 006CECD4 //Plank Ready Left
  jmp code2
gk03:
  mov eax, 006CED40 //Plank Stance
  jmp code2
gk04:
  mov eax, 006CED34 //Plank Stance Left
  jmp code2
gk05:
  mov eax, 006CED94 //Plank Recovering
  jmp code2
gk06:
  mov eax, 006CEDDC //Plank Recovering Left
  jmp code2
gk07:
  mov eax, 006CEDC4 //Plank Swing
  jmp code2
gk08:
  mov eax, 006CEDD0 //Plank Swing Wall Collision
  jmp code2
gk09:
  mov eax, 006CED7C //Plank Swing Left
  jmp code2
gk10:
  mov eax, 006CED88 //Plank Swing Left Wall Collision
  jmp code2
gk11:
  mov eax, 006CEE24 //Plank Over
  jmp code2
gk12:
  mov eax, 006CEE30 //Plank Over Wall Collision
  jmp code2
gk13:
  mov eax, 006CEDF4 //Plank Over Left
  jmp code2
gk14:
  mov eax, 006CEE00 //Plank Over Left Wall Collision
  jmp code2
gk15:
  mov eax, 006CECF8 //Plank Disengage
  jmp code2
gk16:
  mov eax, 006CECE0 //Plank Disengage Left
  jmp code2

code2:
  mov [ecx+38],eax //Upper Body
  mov [ecx+34],eax //Lower Body
  jmp return2

transferMoveset:
  jmp newmem2
  nop
return2:
registersymbol(transferMoveset)

[DISABLE]

transferStance:
  db 8B 46 18 3B C5

transferMoveset:
  db 89 41 38 89 41 34

unregistersymbol(*)
dealloc(*)
