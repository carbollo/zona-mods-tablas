                  <Description>"Melee Kills"</Description>
                  <DropDownList DisplayValueAsItem="1">75:10 Star
</DropDownList>
                  <ShowAsSigned>0</ShowAsSigned>
                  <Color>FFFFFF</Color>
                  <VariableType>2 Bytes</VariableType>
                  <Address>sh2pc.exe+19BBF92</Address>
                </CheatEntry>
                <CheatEntry>
