--=============================================================
-- TIMER
--=============================================================
if nightmare then nightmare.destroy() end
nightmare          = createTimer(nil, false)
nightmare.Interval = 100
nightmare.OnTimer  = function(t)

  if not processLive() then return end

  -- Read records
  local menu   = readByte(storeMenu)
  local event  = readByte(storeEvent)
  local room   = readByte(storeRoom)
  local scene  = readByte(storeScene)
  if menu == nil or event == nil or room == nil or scene == nil then return end

  -- Gate trace.  nightmareTrace(true) to watch whether the gate below
  -- opens during a save load -- that is the one measurement that says
  -- whether Lua writes can reach the loader at all.
  if NIGHT.trace and (menu ~= lastMenu or event ~= lastEvent or scene ~= lastScene) then
    print(string.format('[Nightmare] menu=%02X event=%02X scene=%02X room=%02X',
                        menu, event, scene, room))
    lastMenu, lastEvent, lastScene = menu, event, scene
  end

  -- Begin logic
  -- Reset begin sfx when entering main menu
  if menu == 0x07 then
    beginOnce = 0
  end

  -- Verify gameplay is unlocked
  if menu ~= 0x0D or event ~= 0x04 or scene ~= 0x00 then
    deathDelay = 0
    SH2HP.release('nightmare')
    return
  end

  local maxHp  = readFloat(storeMaxHp)
  local health = readFloat(storeHp)
  if maxHp == nil or health == nil then return end

  local torch  = readInteger(storeTorch)
  local dark   = readInteger(storeDark)
  local item   = readByte(storeItem)
  local lamp   = readByte(storeLamp)
  local level  = readByte(storeExtra)
  local shade  = readByte(storeShade)
  local save   = readInteger(storeSave)
  local skip   = readByte(storeSkip)
  local sanity = readFloat(sanityAddr)
  if torch == nil or dark == nil or item == nil or lamp == nil
     or level == nil or shade == nil or save == nil or skip == nil
     or sanity == nil then return end

  -- Prevent maxHP from exceeding value.
  -- Ampoules_Increase_Max_Health tops out at 50 * 1.80 = 90.0 exactly on
  -- Extra, so the old "&gt; 90.0" test sat precisely on the boundary.  Half a
  -- unit of headroom stops one float rounding from wiping the player's
  -- whole ampoule tier ladder back to baseline.
  if maxHp &gt; NIGHT.maxHpCeiling then
    writeFloat(storeMaxHp, NIGHT.maxHpBase)
  end

  --[[ Play heartbeat when health is low
  if health &lt; 10.0 and heartLoop == 0 then
    if heartSFX then playSound(heartSFX) end
    heartLoop = 25
  elseif health &lt; 10.0 and heartLoop &gt; 0 then
    heartLoop = heartLoop - 1
  elseif health &gt;= 10.0 then
    heartLoop = 0
  end]]

  -- Start death sequence when hp reaches zero.
  -- "&lt;= 0.0" not "== 0.0": a large hit or a regen tick can step past the
  -- exact float, and the old test then never fired.
  if health &lt;= 0.0 and deathDelay == 0 then
    deathDelay = 25
    SH2HP.lock('nightmare')   -- regen and life steal cannot revive James now
  end

  -- Death sequence
  if deathDelay &gt; 0 then
    SH2HP.set('nightmare', 0.0)
    writeInteger(storeDead, 0x40)
    writeInteger(storeUpper, 0x008E3B38)
    writeInteger(storeLower, 0x008E3B38)
    deathDelay = deathDelay - 1
    if yellSFX and yellOnce == 0 then
      playSound(yellSFX, 0.4)
      yellOnce = 1
    end
    if deathDelay == 0 then
      writeByte(storeOver, 0x02)
      writeFloat(sanityAddr, 100.0)
      yellOnce = 0
      SH2HP.release('nightmare')
    end
    return
  end

  -- Force extra action difficulty
  if level ~= NIGHT.forceLevel then
    writeByte(storeExtra, NIGHT.forceLevel)
  end

  -- Give radio and flashlight at start of playthrough.
  -- The bits are OR'd in.  The old code assigned 0x00000893 over the whole
  -- 32-bit progress field, which rewrote a mid-game save back to an
  -- early-game state every 100 ms -- a prime suspect for the load crash,
  -- since progress gates which map variant and asset set the loader pulls.
  if torch &lt; 0x40000000 then
    if item == 0x39 or item == 0x31 then
      if item ~= 0x3D then writeByte(storeItem, 0x3D) end
    elseif item &lt; 0x39 then
      if item ~= 0x3C then writeByte(storeItem, 0x3C) end
    end
    local want = bOr(torch, 0x00000893)
    if want ~= torch then writeInteger(storeTorch, want) end
  end

  -- Force shade setting off
  if shade ~= 0x00 and room == 0x02 then
    writeByte(storeShade, 0x00)
  end

  -- Force skip the long winding trail
  if skip == 0x80 then
    writeByte(storeSkip, 0x01)
  end

  -- Prevent quicksaving and menu saving
  if save ~= 0 then
    writeInteger(storeSave, 0)
  end

  -- Force pyramid head speed
  if phSpeedOK then
    local speed = readFloat(phSpeedAddr)
    if speed ~= nil and speed ~= NIGHT.phSpeed then
      writeFloat(phSpeedAddr, NIGHT.phSpeed)
    end
  end

  --=========================================================
  -- SANITY PRESSURE
  --=========================================================
  -- fatigue is the single driver for the stamina floor, the movement
  -- throttle and the health drain further down.  Computed once here so
  -- all three stay in step within a tick.
  local fatigue = 1.0 - (sanity / 100.0)
  if fatigue &lt; 0.0 then fatigue = 0.0 end
  if fatigue &gt; 1.0 then fatigue = 1.0 end

  -- Stamina is fatigue: higher means more spent, and max stamina means
  -- completely spent.  This raises a FLOOR under it rather than assigning
  -- outright, so ordinary running still drives the value and the script
  -- can only ever push James more tired, never less.
  if NIGHT.staminaFatigue then
    local st    = readInteger(storeSt)
    local maxSt = readInteger(storeMaxSt)
    -- The field idles at -1 in the CT view, which reads as a sentinel for
    -- "not currently tracking".  Leave it alone while it is negative; the
    -- floor takes effect the moment the game starts counting.
    if st ~= nil and maxSt ~= nil and st &gt;= 0 and maxSt &gt; 0 then
      local floorSt = math.floor(maxSt * fatigue)
      if floorSt &gt; maxSt then floorSt = maxSt end
      if st &lt; floorSt then writeInteger(storeSt, floorSt) end
    end
  end

  -- Movement throttle, applied to the two mov-immediate operands.  The
  -- quantiser matters: these are unaligned 4-byte writes into live .text,
  -- so the fewer of them the better.  At the default step the scale only
  -- moves about eighteen times across a full 100 -&gt; 0 sanity slide.
  if speedImmOK then
    local scale = 1.0 - (fatigue * NIGHT.speedThrottle)
    if scale &lt; NIGHT.speedFloor then scale = NIGHT.speedFloor end
    if scale &gt; 1.0 then scale = 1.0 end
    local q = math.floor(scale / NIGHT.speedStep + 0.5) * NIGHT.speedStep
    if speedImmApplied == nil
       or math.abs(q - speedImmApplied) &gt;= (NIGHT.speedStep * 0.5) then
      for i = 1, #speedImm do
        writeFloat(speedImm[i].addr, speedImm[i].orig * q)
      end
      speedImmApplied = q
    end
  end

  --=========================================================
  -- PLAYER VS ENEMY RANGE
  --=========================================================
  -- These symbols come from the "Enemy In Range" AA child script.
  -- getAddress RAISES on a missing symbol rather than returning nil,
  -- so the old guards never ran and a child that had not activated
  -- yet killed the whole timer.
  local playerPosAddr  = sym('playerPos')
  local enemySlotsAddr = sym('enemySlots')
  local enemyTypesAddr = sym('enemyTypes')
  if playerPosAddr == nil or enemySlotsAddr == nil or enemyTypesAddr == nil then
    return
  end

  local pX = readFloat(playerPosAddr)
  local pY = readFloat(playerPosAddr + 4)
  if pX == nil or pY == nil then return end

  local nearestDistance = math.huge
  local nearestType     = 0
  local foundEnemy      = false

  for i = 0, 7 do
    local slotBase = enemySlotsAddr + (i * 16)
    local valid = readInteger(slotBase + 8)
    if valid == 1 then
      local eX = readFloat(slotBase)
      local eY = readFloat(slotBase + 4)
      -- reject NaN as well as zero: the separation solver can poison
      -- entity X and Z (notebook S32), and NaN comparisons are silently
      -- false, which would leave nearestDistance at math.huge forever.
      if eX ~= nil and eY ~= nil and eX == eX and eY == eY
         and (eX ~= 0 or eY ~= 0) then
        local dx = pX - eX
        local dy = pY - eY
        local d = math.sqrt(dx * dx + dy * dy)
        if d &lt; nearestDistance then
          nearestDistance = d
          nearestType = readInteger(enemyTypesAddr + (i * 4)) or 0
          foundEnemy = true
        end
      end
    end
  end

  -- Clear the valid flags so the AA hook has to re-mark them.  Slots the
  -- hook stops refilling then age out instead of pinning a dead enemy.
  for i = 0, 7 do
    writeInteger(enemySlotsAddr + (i * 16) + 8, 0)
  end

  local distance   = foundEnemy and nearestDistance or math.huge
  local enemyRange = NIGHT.enemyRange
  local proximity  = 1.0 - (distance / enemyRange)
  if proximity &lt; 0.0 then proximity = 0.0 end
  if proximity &gt; 1.0 then proximity = 1.0 end

  -- Apply settings to player when in range of an enemy
  if distance &lt; enemyRange and distance &gt; 0 then

    -- In range: force flashlight on, disable player controls, flicker
    writeByte(storeLamp, 0x01)
    writeByte(storeLight, 0x02)
    writeByte(storeSee, 0x01)
    if not bindingsDisabled then
      writeByte(storeKeyB, 0x00)
      writeInteger(storeJoyB, 0xFFFFFFFF)
      bindingsDisabled = true
    end

    -- Drain multipliers by enemy type (1.0 = normal, higher = scarier)
    local DRAIN_MULT = {
      [ENEMY.LYING_FIGURE]   = 1.0,
      [ENEMY.MANNEQUIN]      = 1.2,
      [ENEMY.CREEPER]        = 1.0,
      [ENEMY.FLESH_LIPS]     = 2.0,
      [ENEMY.ABSTRACT_DADDY] = 2.0,
      [ENEMY.EDDIE]          = 1.0,
      [ENEMY.FINAL_BOSS]     = 2.2,
      [ENEMY.NURSE]          = 1.5,
      [ENEMY.PH_GREAT_KNIFE] = 2.2,
      [ENEMY.PH_SPEAR]       = 2.2,
      [ENEMY.CLOSER]         = 1.5,
      [ENEMY.DARK_NURSE]     = 1.8,
    }

    sanityRecoveryDelay = NIGHT.sanityDelay

    -- Sanity is the shield and it still drains first.  The health drain
    -- now fades in BEHIND it on a curve instead of switching on at a cliff
    -- when sanity hits zero, which is what "health drain increases as
    -- sanity decreases" asks for.
    local typeMult = DRAIN_MULT[nearestType] or 1.0

    if sanity &gt; 0.0 then
      local minSanDrain = 0.05
      local maxSanDrain = 0.20
      local sanDrain = (minSanDrain + proximity * (maxSanDrain - minSanDrain)) * typeMult
      local newSanity = sanity - sanDrain
      if newSanity &lt; 0.0 then newSanity = 0.0 end
      writeFloat(sanityAddr, newSanity)
    end

    -- Deliberately tiny.  Worst case -- zero sanity, enemy on top of you,
    -- a 2.2x type -- is 0.22 HP/sec, so a full 50 HP bar takes about three
    -- and a half minutes.  The old cliff rate emptied it in forty-five
    -- seconds.  The squared fatigue term means half sanity costs a quarter
    -- of that, so nothing perceptible happens until James is genuinely
    -- coming apart.
    if health &gt; 0.0 and fatigue &gt; 0.0 then
      local drain = NIGHT.hpDrainMax
                  * (fatigue ^ NIGHT.hpDrainCurve)
                  * (0.25 + 0.75 * proximity)
                  * typeMult
      SH2HP.add('nightmare', -drain)
    end

    if flickerHoldTicks &gt; 0 then
      flickerHoldTicks = flickerHoldTicks - 1
    else
      -- Brightness: darker baseline with random variation
      local minBright = 0.3
      local maxBright = 7.0
      local brightness = minBright + math.random() * (maxBright - minBright)

      -- Change light color based on enemy proximity
      local colorShift = 1.0 - (proximity * 0.25)
      writeFloat(storeRed, brightness)
      writeFloat(storeGreen, brightness * colorShift)
      writeFloat(storeBlue, brightness * colorShift)

      -- Flicker faster as proximity increases
      local maxHold = math.floor((1.0 - proximity) ^ 2 * 6)
      if maxHold &lt; 0 then maxHold = 0 end
      if math.random() &lt; 0.5 then
        flickerHoldTicks = 0
      else
        flickerHoldTicks = math.random(0, maxHold)
      end
    end

  else
    -- Out of range: restore bindings, color, normal flashlight behavior
    if bindingsDisabled then
      writeByte(storeKeyB, origKeyB)
      writeInteger(storeJoyB, origJoyB)
      writeFloat(storeRed, origRed)
      writeFloat(storeGreen, origGreen)
      writeFloat(storeBlue, origBlue)
      bindingsDisabled = false
    end

    -- Sanity recovery: delay after leaving range, then a curved rate.
    -- Slower near 0.0 (deeply shaken), faster near 100.0 (composed).
    if sanityRecoveryDelay &gt; 0 then
      sanityRecoveryDelay = sanityRecoveryDelay - 1
    elseif sanity &lt; 100.0 then
      local minRecovery = 0.02
      local maxRecovery = 0.20
      local recoveryRate = minRecovery + (sanity / 100.0) * (maxRecovery - minRecovery)
      local newSanity = sanity + recoveryRate
      if newSanity &gt; 100.0 then newSanity = 100.0 end
      writeFloat(sanityAddr, newSanity)
    end

    if lamp == 0x01 then
      writeByte(storeLight, 0x02)
      writeByte(storeSee, 0x01)
    else
      writeByte(storeLight, 0x01)
      writeByte(storeSee, 0x00)
    end
  end

  -- Outside is always dark
  if (room == 0x03 or room == 0x04 or room == 0x08) and dark &lt; 0x00080000 then
    writeInteger(storeSky, 0x00000000)
    writeByte(storeTime, 0x0E)
    writeInteger(storeSFogC, 0x00000000)
    writeFloat(storeSFogD, 3000.0)
    writeInteger(storeCFogC, 0x040C1000)
    writeSmallInteger(storeCFogD, 16100)
    writeFloat(storeModel, 0.0)
  elseif (room == 0x03 or room == 0x04 or room == 0x08 or room == 0x0E)
         and dark &gt; 0x00080000 then
    writeInteger(storeCFogC, 0x040C1000)
  end

  --[[ Play beginning sfx.  Live again now that beginSFX is uncommented at
  -- the top of the file, but guarded: if findTableFile misses, playSound
  -- would get nil and take the whole timer down with it.
  if room == 0x04 and torch &lt; 0x00008000 and beginOnce == 0 then
    if beginSFX then playSound(beginSFX) end
    beginOnce = 1
  end]]

end

nightmare.Enabled = true

--=============================================================
-- CONSOLE HELPERS
--=============================================================
function nightmareTrace(on)
  NIGHT.trace = (on ~= false)
  if NIGHT.trace then getLuaEngine().show() end
  print('[Nightmare] gate trace ' .. (NIGHT.trace and 'ON' or 'OFF'))
end

function nightmareStatus()
  print(string.format('[Nightmare] sanity=%.1f  bindingsDisabled=%s  ' ..
                      'phSpeed=%s  speedScale=%s  hpUsers=%d  hpLock=%s',
                      readFloat(sanityAddr) or -1,
                      tostring(bindingsDisabled),
                      tostring(phSpeedOK),
                      tostring(speedImmApplied),
                      SH2HP.users,
                      tostring(SH2HP.owner)))
end

[DISABLE]

if nightmare then
  nightmare.Enabled = false
  nightmare.destroy()
  nightmare = nil
end

if SH2HP then SH2HP.detach('nightmare') end

-- Restore keybindings and flashlight colour.  storeRed/Green/Blue are
-- global now; when they were local this block threw on the first line
-- and nothing below it ever ran.
if bindingsDisabled then
  pcall(function()
    writeByte(storeKeyB, origKeyB)
    writeInteger(storeJoyB, origJoyB)
    writeFloat(storeRed, origRed)
    writeFloat(storeGreen, origGreen)
    writeFloat(storeBlue, origBlue)
  end)
  bindingsDisabled = false
end

-- Put James's movement immediates back before anything else
if speedImm and speedImmOK then
  for i = 1, #speedImm do
    if speedImm[i].addr and speedImm[i].orig then
      pcall(writeFloat, speedImm[i].addr, speedImm[i].orig)
    end
  end
end
speedImmOK      = false
speedImmApplied = nil

-- Put the Pyramid Head speed immediate back the way it was found
if phSpeedOK and phSpeedAddr and phSpeedOrig then
  pcall(writeFloat, phSpeedAddr, phSpeedOrig)
end
phSpeedOK = false

pcall(unregisterSymbol, 'sanity')
if sanityAddr then deAlloc(sanityAddr); sanityAddr = nil end

nightmareTrace  = nil
nightmareStatus = nil


