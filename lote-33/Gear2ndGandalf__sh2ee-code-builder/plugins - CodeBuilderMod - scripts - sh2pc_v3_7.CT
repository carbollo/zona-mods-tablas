newmem:
  cmp [esp+08],004BF926 // Pyramid Head
  je pyramid
  cmp [esp+08],004B8C2A // Flesh Lips
  je lips
  cmp [esp+08],004B699E // Abstract Daddy
  je daddy
  cmp [esp+08],004B145B // Eddie
  je eddie
  cmp [esp+08],004BC537 // Two Pyramid Heads
  je pyramids
  cmp [esp+08],004B4BCA // Final Boss
  je final
  mov [esi+4C],eax
  mov ecx,eax
  jmp return

pyramid:
  push edx
  mov edx,[hpPyramid]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

lips:
  push edx
  mov edx,[hpFlesh]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

daddy:
  push edx
  mov edx,[hpDaddy]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

eddie:
  cmp [sh2pc.exe+1BB7DAC],90
  je eddieReturns
  push edx
  mov edx,[hpEddie]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

eddieReturns:
  push edx
  mov edx,[hpEddieAlt]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

pyramids:
  push edx
  mov edx,[hpTwoPyramids]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

final:
  push edx
  mov edx,[hpMary]
  mov [esi+4C],edx
  mov ecx,eax
  pop edx
  jmp return

npcMaxHP:
  jmp newmem
return:

