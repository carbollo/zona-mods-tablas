        <CheatEntry>
          <ID>36245</ID>
          <Description>"Misc"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>36246</ID>
              <Description>"Lua Template"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

[ENABLE]

-- Hide LUA warnings
getLuaEngine().cbShowOnPrint.Checked = false
getLuaEngine().hide()

-- Store table records
local al = getAddressList()
local storeVariable = al.getMemoryRecordByDescription('table record'):getCurrentAddress()

-- Free previous allocations if re-enabled
if allocateAddr then deAlloc(allocateAddr) end

-- Allocate memory
allocateAddr = allocateMemory(4)

-- Assign values
writeFloat(allocateAddr, 0)

-- Register symbols
registerSymbol('allocate', allocateAddr)

-- Make timer
if myTimer then myTimer.destroy() end
myTimer          = createTimer(nil, false)
myTimer.Interval = 100
myTimer.OnTimer  = function(t)

-- Read records
local variable   = readInteger(storeVariable)
-- Local Variables
local allocate   = readFloat(allocateAddr)

-- Logic
if variable &gt; 0 then return end
end

myTimer.Enabled = true

[DISABLE]

-- Destroy timer
if myTimer then
    myTimer.Enabled = false
    myTimer.destroy()
    myTimer = nil
end

unregisterSymbol('allocate')

-- Free allocated memory
if allocateAddr then deAlloc(allocateAddr); allocateAddr = nil end

</AssemblerScript>
