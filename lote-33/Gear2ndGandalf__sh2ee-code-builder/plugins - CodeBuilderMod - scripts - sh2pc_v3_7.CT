              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//--------------------------------Removes the game over function
assert(sh2pc.exe+8EC44,74 ? 68 ? ? ? ? 6A ? C7 05)
define(noGameOver,sh2pc.exe+8EC44)
noGameOver:
    db EB 37

//---------------------------------Resurrect James
assert(sh2pc.exe+15979D,C6 05 ? ? ? ? ? 5E 83 C4 ? C3 A0 ? ? ? ? 84 C0 6A)
define(revival,sh2pc.exe+15979D)
revival:
    db C6 05 17 81 FB 01 00

//----------------------------Auto-break being grabbed
assert(sh2pc.exe+15975B,D9 05 ? ? ? ? D8 1D ? ? ? ? 8A 0D)
define(grabBreak,sh2pc.exe+15975B)
registersymbol(grabBreak)

alloc(newmem,2048)

label(code)
