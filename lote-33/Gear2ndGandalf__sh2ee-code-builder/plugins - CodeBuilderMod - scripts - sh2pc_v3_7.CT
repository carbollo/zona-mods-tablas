            <CheatEntry>
              <ID>35485</ID>
              <Description>"Fruity Colors"</Description>
              <Color>7A8E4F</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : sh2pc.exe
  Version: 1.0
  Date   : 2023-06-13
  Author : Gear2

  Randomly change lighting with flashlight toggle or room load.
}

[ENABLE]

{$lua}
if syntaxcheck then return end
messageDialog('CHEAT INFO', 'You have to load an area to change world colors.', mtInformation, mbOK)
{$asm}

alloc(returnAddress,4)
registerSymbol(returnAddress)

alloc(randNumGen,2048)
registersymbol(randNumGen)

randNumGen:
  push eax
  push ecx
  push edx
  mov ecx,7
  rdtsc
  xor edx,edx
  shr eax,1
  idiv ecx
  inc edx
  jmp [returnAddress]

