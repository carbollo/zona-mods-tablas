assert(sh2pc.exe+156B96,D9 9E ? ? ? ? D9 86 ? ? ? ? D8 1D ? ? ? ? DF E0)
define(rollerSkates,sh2pc.exe+156B96)
registersymbol(rollerSkates skateSpeed skateSpeedAlt freeMode)
alloc(newmem,2048)
alloc(skateSpeed,4)
alloc(skateSpeedAlt,4)
alloc(freeMode,4)

label(greatKnife guns code return)

freeMode:
  db 0

skateSpeed:
  dd (float)4

skateSpeedAlt:
  dd (float)3

newmem:
  cmp [freeMode],0
  jz greatKnife
  fst dword ptr [esi+000000A8]
  fld dword ptr [skateSpeed]
  fstp dword ptr [esi+000000A8]
  jmp return

greatKnife:
  cmp [sh2pc.exe+1B7A809],A  //Is a gun equipped?
  jle guns
  cmp [sh2pc.exe+1BB7CE4],1C //Are you attacking?
  jne code
  fst dword ptr [esi+000000A8]
  fld dword ptr [skateSpeed]
  fstp dword ptr [esi+000000A8]
  jmp return

guns:
  cmp [sh2pc.exe+1B7A809],A  //Is a gun equipped?
  jg greatKnife
  cmp [sh2pc.exe+1BB7CE4],1C //Are you attacking?
  jne code
  fst dword ptr [esi+000000A8]
  fld dword ptr [skateSpeedAlt]
  fstp dword ptr [esi+000000A8]
  jmp return

code:
  fstp dword ptr [esi+000000A8]
  jmp return

rollerSkates:
  jmp newmem
  nop
return:

[DISABLE]

rollerSkates:
  db D9 9E A8 00 00 00

