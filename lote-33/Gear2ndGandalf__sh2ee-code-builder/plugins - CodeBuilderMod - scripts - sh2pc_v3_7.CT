                  <Color>FFFFFF</Color>
                  <VariableType>Float</VariableType>
                  <Address>bonus</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>35146</ID>
              <Description>"Ampoules Increase Max Health"</Description>
              <Options moHideChildren="1" moDefaultCollapsed="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

[ENABLE]

getLuaEngine().cbShowOnPrint.Checked = false

--=============================================================
-- COMMON HELPERS
--=============================================================

-- getMemoryRecordByDescription() returns nil when the description
-- is missing or has been renamed.  Calling :getCurrentAddress() on
-- nil gives an unreadable error, so name the record instead.
local function rec(al, desc)
  local r = al.getMemoryRecordByDescription(desc)
  if r == nil then error('Memory record not found: "' .. desc .. '"', 0) end
  local a = r:getCurrentAddress()
  if a == nil or a == 0 then error('Record "' .. desc .. '" resolved to 0', 0) end
  return a
end

-- getAddress() RAISES on an unknown symbol, it does NOT return nil.
-- Every "if not addr then return end" guard was therefore dead code.
local function sym(name)
  local ok, a = pcall(getAddress, name)
  if ok and a ~= nil and a ~= 0 then return a end
  return nil
end

-- Liveness canary.  _G outlives the game process, so a nil check on
-- a stored address proves nothing (notebook: Cautions / Scripting).
-- Read the module's own MZ header back instead.
local function processLive()
  local base = sym('sh2pc.exe')
  if base == nil then return false end
  return readSmallInteger(base) == 0x5A4D
end

--=============================================================
-- SHARED HEALTH BROKER
-- Identical block in every script that writes Player Health.
-- The first script to enable builds it; the last to disable tears
-- it down.
--
-- Why it exists: Nightmare, Health Regeneration, Life Steal and
-- Ampoules each ran their own 100 ms timer and each called
-- writeFloat() on the same address.  Last writer won, nothing
-- clamped to max HP, and regen could revive James in the middle of
-- the death sequence.  Now every script queues a DELTA and one
-- flusher sums them, clamps once, and writes once.
--=============================================================
if SH2HP == nil or SH2HP.pid ~= getOpenedProcessID() then
  SH2HP = {
    pid      = getOpenedProcessID(),
    users    = 0,      -- refcount of enabled scripts
    queue    = {},     -- source name -&gt; pending delta this tick
    absolute = nil,    -- an absolute set beats any queued deltas
    owner    = nil,    -- exclusive lock holder, or nil
    hpAddr   = nil,
    maxAddr  = nil,
    timer    = nil,
  }
end

function SH2HP.flush()
  if SH2HP.absolute == nil and next(SH2HP.queue) == nil then return end
  local hp  = readFloat(SH2HP.hpAddr)
  local max = readFloat(SH2HP.maxAddr)
  if hp == nil or max == nil then
    SH2HP.queue, SH2HP.absolute = {}, nil
    return
  end
  local target
  if SH2HP.absolute ~= nil then
    target = SH2HP.absolute
  else
    target = hp
    for _, d in pairs(SH2HP.queue) do target = target + d end
  end
  SH2HP.queue, SH2HP.absolute = {}, nil
  if target ~= target then return end                 -- drop NaN
  if max &gt; 0.0 and target &gt; max then target = max end -- the clamp that was missing
  if target &lt; 0.0 then target = 0.0 end
  if math.abs(target - hp) &gt; 0.0001 then writeFloat(SH2HP.hpAddr, target) end
end

function SH2HP.attach(hpAddr, maxAddr)
  SH2HP.hpAddr, SH2HP.maxAddr = hpAddr, maxAddr
  SH2HP.users = SH2HP.users + 1
  if SH2HP.timer == nil then
    SH2HP.timer          = createTimer(nil, false)
    SH2HP.timer.Interval = 100
    SH2HP.timer.OnTimer  = function(t) SH2HP.flush() end
    SH2HP.timer.Enabled  = true
  end
end

function SH2HP.detach(source)
  if SH2HP.owner == source then SH2HP.owner = nil end
  SH2HP.queue[source] = nil
  SH2HP.users = SH2HP.users - 1
  if SH2HP.users &lt;= 0 then
    SH2HP.users = 0
    if SH2HP.timer then
      SH2HP.timer.Enabled = false
      SH2HP.timer.destroy()
      SH2HP.timer = nil
    end
    SH2HP.queue, SH2HP.absolute, SH2HP.owner = {}, nil, nil
  end
end

-- Relative change.  Ignored while another source holds the lock.
function SH2HP.add(source, delta)
  if SH2HP.owner ~= nil and SH2HP.owner ~= source then return end
  if delta == nil or delta ~= delta then return end
  SH2HP.queue[source] = (SH2HP.queue[source] or 0.0) + delta
end

-- Absolute value.  Beats any deltas queued in the same tick.
function SH2HP.set(source, value)
  if SH2HP.owner ~= nil and SH2HP.owner ~= source then return end
  if value == nil or value ~= value then return end
  SH2HP.absolute = value
end

-- Exclusive lock.  The death sequence takes it so nothing can heal
-- James back off zero before the game-over flag is set.
function SH2HP.lock(source)
  if SH2HP.owner == nil then SH2HP.owner = source end
  return SH2HP.owner == source
end

function SH2HP.release(source)
  if SH2HP.owner == source then SH2HP.owner = nil end
end

--=============================================================
-- RESOLVE RECORDS
--=============================================================
if not processLive() then error('sh2pc.exe is not attached', 0) end

local al = getAddressList()
local storeLevel    = rec(al, 'Action Level')
local storeMaxHp    = rec(al, 'Player Max Health')
local storeHp       = rec(al, 'Player Health')
local storeAmpoules = rec(al, 'Ampoules')

-- Tier multipliers applied to baseline max HP
local TIERS = {
    1.05, 1.10, 1.16, 1.22, 1.29, 1.36,
    1.44, 1.52, 1.60, 1.68, 1.74, 1.80
}

-- Baseline max HP by action level
-- Beginner = 0x00 (200), Easy = 0x01 / Normal = 0x02 (100), Hard = 0x03 / Extra = 0x04 (50)
local function getBaselineForLevel(level)
  if level == 0x00 then return 200.0
  elseif level == 0x01 or level == 0x02 then return 100.0
  elseif level == 0x03 or level == 0x04 then return 50.0
  else return 0.0
  end
end

-- NOTE ON THE CEILING
-- On Extra the top tier is 50 * 1.80 = 90.0.  Nightmare_Difficulty clamps
-- max HP above 90.5 (it used to clamp above 90.0, which sat exactly on this
-- boundary).  If you extend TIERS past 1.80, raise NIGHT.maxHpCeiling to
-- match or Nightmare will wipe the ladder back to baseline.

-- Persistent state for this session
if tierStateAddr then deAlloc(tierStateAddr) end
tierStateAddr = allocateMemory(8)
registerSymbol('ampouleStep', tierStateAddr)
registerSymbol('ampouleBase', tierStateAddr + 4)
writeInteger(tierStateAddr, 0)
writeFloat(tierStateAddr + 4, 0.0)

SH2HP.attach(storeHp, storeMaxHp)

local baselineStableTicks = 0
local prevAmpoules = nil
local prevMaxHp    = nil

--=============================================================
-- TIMER
--=============================================================
if ampouleTimer then ampouleTimer.destroy() end
ampouleTimer          = createTimer(nil, false)
ampouleTimer.Interval = 100
ampouleTimer.OnTimer  = function(t)

  if not processLive() then return end

  local level    = readByte(storeLevel)
  local maxHp    = readFloat(storeMaxHp)
  local health   = readFloat(storeHp)
  local ampoules = readSmallInteger(storeAmpoules)
  local step     = readInteger(tierStateAddr)
  local baseline = readFloat(tierStateAddr + 4)
  if level == nil or maxHp == nil or health == nil or ampoules == nil
     or step == nil or baseline == nil then return end

  -- Continuously sync baseline to current difficulty
  local expectedBaseline = getBaselineForLevel(level)
  if expectedBaseline &gt; 0.0 and expectedBaseline ~= baseline then
    baseline = expectedBaseline
    writeFloat(tierStateAddr + 4, baseline)
    -- Difficulty changed; reset tier so recovery logic below can re-derive it
    step = 0
    writeInteger(tierStateAddr, step)
  end

  -- Check if baseline is stable
  if expectedBaseline &gt; 0.0 and expectedBaseline == baseline then
    baselineStableTicks = baselineStableTicks + 1
  else
    baselineStableTicks = 0
  end

  -- Initialize trackers on first tick
  if prevAmpoules == nil then
    prevAmpoules = ampoules
    prevMaxHp = maxHp
    return
  end

  -- Smart tier recovery: if max HP decreased (e.g. reloaded save), re-derive tier
  if maxHp &lt; prevMaxHp and baseline &gt; 0.0 and baselineStableTicks &gt; 2 then
    if maxHp &lt;= baseline + 0.5 then
      -- At or near baseline -- reset tier to 0
      step = 0
      writeInteger(tierStateAddr, step)
    else
      local ratio = maxHp / baseline
      local guessedStep = nil
      for i = 1, #TIERS do
        if math.abs(ratio - TIERS[i]) &lt; 0.01 then
          guessedStep = i
          break
        end
      end
      -- Only update step if we actually matched a tier
      if guessedStep ~= nil then
        step = guessedStep
        writeInteger(tierStateAddr, step)
      end
    end
  end

  -- Detect ampoule consumption
  if ampoules &lt; prevAmpoules and baseline &gt; 0.0 then
    local used = prevAmpoules - ampoules
    step = step + used
    if step &gt; #TIERS then step = #TIERS end
    local multiplier = TIERS[step]
    local newMax = baseline * multiplier
    writeFloat(storeMaxHp, newMax)
    -- Full heal goes through the broker as an absolute so it cannot race
    -- a regen or life-steal delta queued in the same tick.  The broker
    -- reads max HP itself when it clamps, so the write above must land
    -- first -- it does, this is a direct write and the flush is deferred.
    SH2HP.set('ampoule', newMax)
    writeInteger(tierStateAddr, step)
    maxHp = newMax
  end

  -- Update tracker
  prevAmpoules = ampoules
  prevMaxHp = maxHp
end

ampouleTimer.Enabled = true

[DISABLE]

if ampouleTimer then
    ampouleTimer.Enabled = false
    ampouleTimer.destroy()
    ampouleTimer = nil
end

if SH2HP then SH2HP.detach('ampoule') end

pcall(unregisterSymbol, 'ampouleStep')
pcall(unregisterSymbol, 'ampouleBase')

if tierStateAddr then
    deAlloc(tierStateAddr)
    tierStateAddr = nil
end

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>35147</ID>
                  <Description>"Tier"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <Color>FFFFFF</Color>
                  <VariableType>4 Bytes</VariableType>
                  <Address>ampouleStep</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>35148</ID>
                  <Description>"Base"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <Color>FFFFFF</Color>
                  <VariableType>Float</VariableType>
                  <Address>ampouleBase</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>35149</ID>
              <Description>"Store Teleport Coordinates"</Description>
              <Options moHideChildren="1" moDefaultCollapsed="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

local saveSFX = findTableFile('SOUND_0152.wav')

[ENABLE]

getLuaEngine().cbShowOnPrint.Checked = false

--=============================================================
-- COMMON HELPERS
--=============================================================

-- getMemoryRecordByDescription() returns nil when the description
-- is missing or has been renamed.  Calling :getCurrentAddress() on
-- nil gives an unreadable error, so name the record instead.
local function rec(al, desc)
  local r = al.getMemoryRecordByDescription(desc)
  if r == nil then error('Memory record not found: "' .. desc .. '"', 0) end
  local a = r:getCurrentAddress()
  if a == nil or a == 0 then error('Record "' .. desc .. '" resolved to 0', 0) end
  return a
end

-- getAddress() RAISES on an unknown symbol, it does NOT return nil.
-- Every "if not addr then return end" guard was therefore dead code.
local function sym(name)
  local ok, a = pcall(getAddress, name)
  if ok and a ~= nil and a ~= 0 then return a end
  return nil
end

-- Liveness canary.  _G outlives the game process, so a nil check on
-- a stored address proves nothing (notebook: Cautions / Scripting).
-- Read the module's own MZ header back instead.
local function processLive()
  local base = sym('sh2pc.exe')
  if base == nil then return false end
  return readSmallInteger(base) == 0x5A4D
end

--=============================================================
-- RESOLVE RECORDS
--=============================================================
if not processLive() then error('sh2pc.exe is not attached', 0) end

local al = getAddressList()
local storeMenu  = rec(al, 'Menu Event ID')
local storeEvent = rec(al, 'Event ID')
local storeRoom  = rec(al, 'Room ID')
local storeScene = rec(al, 'Cutscene ID')
local storeKeyLT = rec(al, 'Dual Shock L Trigger')
local storeKeySQ = rec(al, 'Dual Shock Square')
local storeKeyX  = rec(al, 'Dual Shock X')
local storePosX  = rec(al, 'PosX')
local storePosY  = rec(al, 'PosY')
local storePosZ  = rec(al, 'PosZ')
local storeCamX  = rec(al, 'CamX')
local storeCamY  = rec(al, 'CamY')
local storeCamZ  = rec(al, 'CamZ')

-- Saved coordinates (persist across ticks)
local savePosX, savePosY, savePosZ = nil, nil, nil
local saveCamX, saveCamY, saveCamZ = nil, nil, nil
local saveRoom = nil

-- Edge detection flags
local saveHeld = false
local loadHeld = false

--=============================================================
-- TIMER
--=============================================================
if storeTeleport then storeTeleport.destroy() end
storeTeleport          = createTimer(nil, false)
storeTeleport.Interval = 50
storeTeleport.OnTimer  = function(t)

  if not processLive() then return end

  -- Read records
  local menu  = readByte(storeMenu)
  local event = readByte(storeEvent)
  local room  = readByte(storeRoom)
  local scene = readByte(storeScene)
  if menu == nil or event == nil or room == nil or scene == nil then return end

  -- Begin logic
  -- Invalidate saved coordinates if room has changed since the save
  if saveRoom ~= nil and room ~= saveRoom then
    savePosX, savePosY, savePosZ = nil, nil, nil
    saveCamX, saveCamY, saveCamZ = nil, nil, nil
    saveRoom = nil
  end

  -- Verify gameplay is unlocked
  if menu ~= 0x0D or event ~= 0x04 or scene ~= 0x00 then
    saveHeld, loadHeld = false, false
    return
  end

  local keyLT = readByte(storeKeyLT)
  local keySQ = readByte(storeKeySQ)
  local keyX  = readByte(storeKeyX)
  if keyLT == nil or keySQ == nil or keyX == nil then return end

  -- Save: T + Left Click, or LT + X
  -- The release branch was missing: the old code toggled saveHeld on and
  -- off on alternate ticks for as long as the key was down, so it re-saved
  -- and replayed the sound about five times a second.
  if (isKeyPressed(VK_T) and isKeyPressed(VK_LBUTTON))
     or (keyLT == 0x80 and keyX == 0x80) then
    if not saveHeld then
      local posX = readFloat(storePosX)
      local posY = readFloat(storePosY)
      local posZ = readFloat(storePosZ)
      local camX = readFloat(storeCamX)
      local camY = readFloat(storeCamY)
      local camZ = readFloat(storeCamZ)
      -- Refuse to store a poisoned coordinate.  The separation solver can
      -- write NaN into X and Z (notebook S32); teleporting back to one
      -- would put the poison straight back into the player entity.
      if posX ~= nil and posY ~= nil and posZ ~= nil
         and camX ~= nil and camY ~= nil and camZ ~= nil
         and posX == posX and posY == posY and posZ == posZ
         and camX == camX and camY == camY and camZ == camZ then
        savePosX, savePosY, savePosZ = posX, posY, posZ
        saveCamX, saveCamY, saveCamZ = camX, camY, camZ
        saveRoom = room
        --if saveSFX then playSound(saveSFX) end
      else
        print('[Teleport] refused to save: non-finite coordinate')
      end
      saveHeld = true
    end
  else
    saveHeld = false
  end

  -- Load: T + Right Click, or LT + Square
  if (isKeyPressed(VK_T) and isKeyPressed(VK_RBUTTON))
     or (keyLT == 0x80 and keySQ == 0x80) then
    if not loadHeld and savePosX ~= nil then
      writeFloat(storePosX, savePosX)
      writeFloat(storePosY, savePosY)
      writeFloat(storePosZ, savePosZ)
      writeFloat(storeCamX, saveCamX)
      writeFloat(storeCamY, saveCamY)
      writeFloat(storeCamZ, saveCamZ)
      loadHeld = true
    end
  else
    loadHeld = false
  end
end

storeTeleport.Enabled = true

[DISABLE]

if storeTeleport then
    storeTeleport.Enabled = false
    storeTeleport.destroy()
    storeTeleport = nil
end

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>35150</ID>
                  <Description>"KeyBoard Save = T + L Click Mouse"</Description>
                  <Color>FFFFFF</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>36281</ID>
                  <Description>"KeyBoard Load = T + R Click Mouse"</Description>
                  <Color>FFFFFF</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
