  je code_1
  cmp edx,2
  je code_1a
  cmp edx,3
  je code_1b
  cmp edx,4
  je code_1
  cmp edx,5
  je code_1a
  cmp edx,6
  je code_1b
  cmp edx,7
  je code_1
  jmp return_1

