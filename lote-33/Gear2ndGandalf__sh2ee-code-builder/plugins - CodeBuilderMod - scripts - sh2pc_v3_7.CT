  "alternates spawn on the same spot and freeze the game (32).")
y = checkbox(L, y, "Killed enemies come back",
  function() return M.d.liveRespawn end, function(v) M.d.liveRespawn = v end,
  "Clears each spawn point's used flag so it can fire again.")
y = checkbox(L, y, "Cluster spawn points into pockets",
