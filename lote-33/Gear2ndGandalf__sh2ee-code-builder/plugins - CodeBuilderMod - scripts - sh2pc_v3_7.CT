            <CheatEntry>
              <ID>35134</ID>
              <Description>"Item Multiplier"</Description>
              <Options moHideChildren="1" moDefaultCollapsed="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

[ENABLE]

getLuaEngine().cbShowOnPrint.Checked = false

--=============================================================
-- COMMON HELPERS
--=============================================================

-- getMemoryRecordByDescription() returns nil when the description
-- is missing or has been renamed.  Calling :getCurrentAddress() on
-- nil gives an unreadable error, so name the record instead.
local function rec(al, desc)
  local r = al.getMemoryRecordByDescription(desc)
  if r == nil then error('Memory record not found: "' .. desc .. '"', 0) end
  local a = r:getCurrentAddress()
  if a == nil or a == 0 then error('Record "' .. desc .. '" resolved to 0', 0) end
  return a
end

-- getAddress() RAISES on an unknown symbol, it does NOT return nil.
-- Every "if not addr then return end" guard was therefore dead code.
local function sym(name)
  local ok, a = pcall(getAddress, name)
  if ok and a ~= nil and a ~= 0 then return a end
  return nil
end

-- Liveness canary.  _G outlives the game process, so a nil check on
-- a stored address proves nothing (notebook: Cautions / Scripting).
-- Read the module's own MZ header back instead.
local function processLive()
  local base = sym('sh2pc.exe')
  if base == nil then return false end
  return readSmallInteger(base) == 0x5A4D
end

--=============================================================
-- RESOLVE RECORDS
--=============================================================
if not processLive() then error('sh2pc.exe is not attached', 0) end

local al = getAddressList()
local storeDrinks   = rec(al, 'Health Drinks')
local storeAids     = rec(al, 'First Aid Kits')
local storeAmpoules = rec(al, 'Ampoules')
local storeHandgun  = rec(al, 'Handgun Bullet(s)')
local storeShotgun  = rec(al, 'Shotgun Shell(s)')
local storeRifle    = rec(al, 'Rifle Round(s)')
local storeRevolver = rec(al, 'Revolver Round(s)')

-- Free previous allocations if re-enabled
if acquiredAddr then deAlloc(acquiredAddr) end
acquiredAddr = allocateMemory(4)
writeSmallInteger(acquiredAddr, 2)
registerSymbol('acquired', acquiredAddr)

--=============================================================
-- ITEM TABLE
-- consumables carry the -1 the originals had; ammo does not.
--=============================================================
local ITEMS = {
  { name = 'drinks',   addr = storeDrinks,   offset = -1 },
  { name = 'aids',     addr = storeAids,     offset = -1 },
  { name = 'ampoules', addr = storeAmpoules, offset = -1 },
  { name = 'handgun',  addr = storeHandgun,  offset =  0 },
  { name = 'shotgun',  addr = storeShotgun,  offset =  0 },
  { name = 'rifle',    addr = storeRifle,    offset =  0 },
  { name = 'revolver', addr = storeRevolver, offset =  0 },
}

local prev = {}

--=============================================================
-- TIMER
--=============================================================
if itemMultiplier then itemMultiplier.destroy() end
itemMultiplier          = createTimer(nil, false)
itemMultiplier.Interval = 100
itemMultiplier.OnTimer  = function(t)

  if not processLive() then return end

  local acquired = readSmallInteger(acquiredAddr)
  if acquired == nil or acquired &lt; 1 then return end

  for _, it in ipairs(ITEMS) do
    local cur = readSmallInteger(it.addr)
    if cur ~= nil then
      local was = prev[it.name]
      if was == nil then
        prev[it.name] = cur
      elseif cur &gt; was then
        local gained = cur - was
        local total  = cur + (gained * acquired) + it.offset
        if total &lt; 0 then total = 0 end
        if total &gt; 32767 then total = 32767 end
        writeSmallInteger(it.addr, total)
        -- Read the value BACK instead of assuming the write stuck.  The
        -- game clamps several of these to a per-item maximum; the old code
        -- cached the requested total, so once a clamp bit, prev sat above
        -- the real count forever and the multiplier silently stopped.
        prev[it.name] = readSmallInteger(it.addr) or total
      else
        prev[it.name] = cur
      end
    end
  end
end

itemMultiplier.Enabled = true

[DISABLE]

if itemMultiplier then
    itemMultiplier.Enabled = false
    itemMultiplier.destroy()
    itemMultiplier = nil
end

pcall(unregisterSymbol, 'acquired')

if acquiredAddr then deAlloc(acquiredAddr); acquiredAddr = nil end

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>35135</ID>
                  <Description>"Collected * Value"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <Color>FFFFFF</Color>
                  <VariableType>2 Bytes</VariableType>
                  <Address>acquired</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>35136</ID>
              <Description>"Health Regeneration"</Description>
              <Options moHideChildren="1" moDefaultCollapsed="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

[ENABLE]

getLuaEngine().cbShowOnPrint.Checked = false

--=============================================================
-- COMMON HELPERS
--=============================================================

-- getMemoryRecordByDescription() returns nil when the description
-- is missing or has been renamed.  Calling :getCurrentAddress() on
-- nil gives an unreadable error, so name the record instead.
local function rec(al, desc)
  local r = al.getMemoryRecordByDescription(desc)
  if r == nil then error('Memory record not found: "' .. desc .. '"', 0) end
  local a = r:getCurrentAddress()
  if a == nil or a == 0 then error('Record "' .. desc .. '" resolved to 0', 0) end
  return a
end

-- getAddress() RAISES on an unknown symbol, it does NOT return nil.
-- Every "if not addr then return end" guard was therefore dead code.
local function sym(name)
  local ok, a = pcall(getAddress, name)
  if ok and a ~= nil and a ~= 0 then return a end
  return nil
end

-- Liveness canary.  _G outlives the game process, so a nil check on
-- a stored address proves nothing (notebook: Cautions / Scripting).
-- Read the module's own MZ header back instead.
local function processLive()
  local base = sym('sh2pc.exe')
  if base == nil then return false end
  return readSmallInteger(base) == 0x5A4D
end

--=============================================================
-- SHARED HEALTH BROKER
-- Identical block in every script that writes Player Health.
-- The first script to enable builds it; the last to disable tears
-- it down.
--
-- Why it exists: Nightmare, Health Regeneration, Life Steal and
-- Ampoules each ran their own 100 ms timer and each called
-- writeFloat() on the same address.  Last writer won, nothing
-- clamped to max HP, and regen could revive James in the middle of
-- the death sequence.  Now every script queues a DELTA and one
-- flusher sums them, clamps once, and writes once.
--=============================================================
if SH2HP == nil or SH2HP.pid ~= getOpenedProcessID() then
  SH2HP = {
    pid      = getOpenedProcessID(),
    users    = 0,      -- refcount of enabled scripts
    queue    = {},     -- source name -&gt; pending delta this tick
    absolute = nil,    -- an absolute set beats any queued deltas
    owner    = nil,    -- exclusive lock holder, or nil
    hpAddr   = nil,
    maxAddr  = nil,
    timer    = nil,
  }
end

function SH2HP.flush()
  if SH2HP.absolute == nil and next(SH2HP.queue) == nil then return end
  local hp  = readFloat(SH2HP.hpAddr)
  local max = readFloat(SH2HP.maxAddr)
  if hp == nil or max == nil then
    SH2HP.queue, SH2HP.absolute = {}, nil
    return
  end
  local target
  if SH2HP.absolute ~= nil then
    target = SH2HP.absolute
  else
    target = hp
    for _, d in pairs(SH2HP.queue) do target = target + d end
  end
  SH2HP.queue, SH2HP.absolute = {}, nil
  if target ~= target then return end                 -- drop NaN
  if max &gt; 0.0 and target &gt; max then target = max end -- the clamp that was missing
  if target &lt; 0.0 then target = 0.0 end
  if math.abs(target - hp) &gt; 0.0001 then writeFloat(SH2HP.hpAddr, target) end
end

function SH2HP.attach(hpAddr, maxAddr)
  SH2HP.hpAddr, SH2HP.maxAddr = hpAddr, maxAddr
  SH2HP.users = SH2HP.users + 1
  if SH2HP.timer == nil then
    SH2HP.timer          = createTimer(nil, false)
    SH2HP.timer.Interval = 100
    SH2HP.timer.OnTimer  = function(t) SH2HP.flush() end
    SH2HP.timer.Enabled  = true
  end
end

function SH2HP.detach(source)
  if SH2HP.owner == source then SH2HP.owner = nil end
  SH2HP.queue[source] = nil
  SH2HP.users = SH2HP.users - 1
  if SH2HP.users &lt;= 0 then
    SH2HP.users = 0
    if SH2HP.timer then
      SH2HP.timer.Enabled = false
      SH2HP.timer.destroy()
      SH2HP.timer = nil
    end
    SH2HP.queue, SH2HP.absolute, SH2HP.owner = {}, nil, nil
  end
end

-- Relative change.  Ignored while another source holds the lock.
function SH2HP.add(source, delta)
  if SH2HP.owner ~= nil and SH2HP.owner ~= source then return end
  if delta == nil or delta ~= delta then return end
  SH2HP.queue[source] = (SH2HP.queue[source] or 0.0) + delta
end

-- Absolute value.  Beats any deltas queued in the same tick.
function SH2HP.set(source, value)
  if SH2HP.owner ~= nil and SH2HP.owner ~= source then return end
  if value == nil or value ~= value then return end
  SH2HP.absolute = value
end

-- Exclusive lock.  The death sequence takes it so nothing can heal
-- James back off zero before the game-over flag is set.
function SH2HP.lock(source)
  if SH2HP.owner == nil then SH2HP.owner = source end
  return SH2HP.owner == source
end

function SH2HP.release(source)
  if SH2HP.owner == source then SH2HP.owner = nil end
end

--=============================================================
-- RESOLVE RECORDS
--=============================================================
if not processLive() then error('sh2pc.exe is not attached', 0) end

local al = getAddressList()
local storeMenu   = rec(al, 'Menu Event ID')
local storeEvent  = rec(al, 'Event ID')
local storeScene  = rec(al, 'Cutscene ID')
local storeHp     = rec(al, 'Player Health')
local storeMaxHp  = rec(al, 'Player Max Health')
local storeTagged = rec(al, 'Collision Tagged')

-- Free previous allocations if re-enabled
if cooldownAddr then deAlloc(cooldownAddr) end
if criticalAddr then deAlloc(criticalAddr) end
if rushAddr then deAlloc(rushAddr) end
if calmAddr then deAlloc(calmAddr) end

cooldownAddr = allocateMemory(4)
criticalAddr = allocateMemory(4)
rushAddr     = allocateMemory(4)
calmAddr     = allocateMemory(4)

writeFloat(cooldownAddr, 0.0)
writeFloat(criticalAddr, 10.0)
writeFloat(rushAddr, 0.0050)
writeFloat(calmAddr, 0.0010)

registerSymbol('cooldown', cooldownAddr)
registerSymbol('critical', criticalAddr)
registerSymbol('rush', rushAddr)
registerSymbol('calm', calmAddr)

SH2HP.attach(storeHp, storeMaxHp)

--=============================================================
-- TIMER
--=============================================================
if regenTimer then regenTimer.destroy() end
regenTimer          = createTimer(nil, false)
regenTimer.Interval = 100
regenTimer.OnTimer  = function(t)

  if not processLive() then return end

  -- Read records
  local menu      = readByte(storeMenu)
  local event     = readByte(storeEvent)
  local scene     = readByte(storeScene)
  if menu == nil or event == nil or scene == nil then return end

  -- Begin logic
  -- Verify gameplay is unlocked
  if menu ~= 0x0D or event ~= 0x04 or scene ~= 0x00 then return end

  local tagged    = readInteger(storeTagged)
  local health    = readFloat(storeHp)
  local maxHealth = readFloat(storeMaxHp)
  if tagged == nil or health == nil or maxHealth == nil then return end

  -- Local Variables
  local cooldown = readFloat(cooldownAddr)
  local critical = readFloat(criticalAddr)
  local rush     = readFloat(rushAddr)
  local calm     = readFloat(calmAddr)
  if cooldown == nil or critical == nil or rush == nil or calm == nil then return end

  -- Set penalty cooldown on hitbox collision detected
  if tagged == 1 then
    cooldown = 100
    writeFloat(cooldownAddr, cooldown)
  end

  -- Verify cooldown range is compliant then decrease cooldown if active
  if cooldown &lt; 0 then
    cooldown = 0
    writeFloat(cooldownAddr, cooldown)
  elseif cooldown &gt; 0 then
    cooldown = cooldown - 1
    writeFloat(cooldownAddr, cooldown)
  end

  -- Clamp critical to valid range if user exceeds it
  if critical &lt; 0 or critical &gt; 50 then
    critical = 10
    writeFloat(criticalAddr, critical)
  end

  -- Clamp regeneration rates to positive, so a user-set negative value
  -- cannot turn the regenerator into a damage source
  if rush &lt; 0.0 then
    rush = 0.0050
    writeFloat(rushAddr, rush)
  end
  if calm &lt; 0.0 then
    calm = 0.0010
    writeFloat(calmAddr, calm)
  end

  if cooldown ~= 0 then return end

  -- Never regenerate a dead or already-full James.  The upper clamp now
  -- lives in the broker, so both branches are safe against overheal --
  -- the old rush branch had no maxHealth test at all.
  if health &lt;= 0.0 or health &gt;= maxHealth then return end

  -- Rush when critically low, otherwise a calm trickle
  if health &lt;= critical then
    SH2HP.add('regen', rush)
  else
    SH2HP.add('regen', calm)
  end
end

regenTimer.Enabled = true

[DISABLE]

if regenTimer then
    regenTimer.Enabled = false
    regenTimer.destroy()
    regenTimer = nil
end

if SH2HP then SH2HP.detach('regen') end

pcall(unregisterSymbol, 'cooldown')
pcall(unregisterSymbol, 'critical')
pcall(unregisterSymbol, 'rush')
pcall(unregisterSymbol, 'calm')

if cooldownAddr then deAlloc(cooldownAddr); cooldownAddr = nil end
if criticalAddr then deAlloc(criticalAddr); criticalAddr = nil end
if rushAddr then deAlloc(rushAddr); rushAddr = nil end
if calmAddr then deAlloc(calmAddr); calmAddr = nil end

</AssemblerScript>
