newmem:
  cmp [ebp-210],0200
  jae code
@@2:
  cmp [sh2pc.exe+1BB10A8],(float)0.5
  jge moving
  cmp [sh2pc.exe+1B7A809],04
  je handgun
  cmp [sh2pc.exe+1B7A809],06
  je shotgun
  cmp [sh2pc.exe+1B7A809],08
  je rifle
  cmp [sh2pc.exe+1B7A809],0A
  je revolver
  cmp [sh2pc.exe+1B7A809],0C
  je hyperSpray
  cmp [sh2pc.exe+1B7A809],0D
  je woodenPlank
  cmp [sh2pc.exe+1B7A809],0E
  je steelPipe
  cmp [sh2pc.exe+1B7A809],0F
  je greatKnife
  cmp [sh2pc.exe+1B7A809],10
  je weap9
  cmp [sh2pc.exe+1B7A809],11
  je cleaver
  jmp code

moving:
  mov ax,[moveSpeed]
  movsx ecx,ax
  mov [ebp+28],ax
  jmp return

handgun:
