            <CheatEntry>
              <ID>35250</ID>
              <Description>"Mixer H.Spray"</Description>
              <Options moDefaultCollapsed="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
              <Color>7A8E4F</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : sh2pc.exe
  Version: 2.0
  Date   : 2024-06-08
  Author : Gear2

  Randomize or cycle the hyper spray color.

  integrator: 0 = random mode, 1 = sequential cycle mode
  timerSetting: frames between color changes in cycle mode
  noPurple/noWhite/noYellow/noGreen: set to 1 to exclude that color
}

[ENABLE]

alloc(randNumGen,2048)
registersymbol(randNumGen)

randNumGen:
  push eax
  push ecx
  mov ecx,4
  rdtsc
  xor edx,edx
  shr eax,1
  div ecx
  inc edx
  pop ecx
  pop eax
  ret

assert(sh2pc.exe+145896,0F BE 05 ? ? ? ? 40)
define(sprayMix,sh2pc.exe+145896)
registersymbol(sprayMix)
registersymbol(noPurple)
registersymbol(noWhite)
registersymbol(noYellow)
registersymbol(noGreen)
registersymbol(integrator)
registersymbol(cycler)
registersymbol(timerSetting)
registersymbol(counter)

alloc(newmem,2048)
alloc(noPurple,4)
alloc(noWhite,4)
alloc(noYellow,4)
alloc(noGreen,4)
alloc(integrator,4)
alloc(cycler,4)
alloc(timerSetting,4)
alloc(counter,4)

label(switchMode)
label(checkTimer)
label(migrator)
label(reset)
label(skipCycle)
label(originalCode)
label(purple)
label(white)
label(yellow)
label(green)
label(return)

noPurple:
  db 0

noWhite:
  db 0

noYellow:
  db 0

noGreen:
  db 0

integrator:
  db 1

cycler:
  db 0

timerSetting:
  dd #100

counter:
  dd #100

newmem:
  push edx
  call randNumGen
  cmp dword ptr [integrator],1
  je switchMode
  cmp edx,1
  je purple
  cmp edx,2
  je white
  cmp edx,3
  je yellow
  cmp edx,4
  je green
  pop edx
  jmp originalCode

switchMode:
  push ebx
  mov ebx,[timerSetting]
  cmp [counter],ebx
  pop ebx
  ja checkTimer
  cmp dword ptr [counter],#0
  jz migrator
  dec dword ptr [counter]
  cmp dword ptr [cycler],1
  jb purple
  cmp dword ptr [cycler],2
  jb white
  cmp dword ptr [cycler],3
  jb yellow
  cmp dword ptr [cycler],4
  jb green
  cmp dword ptr [cycler],4
  jae reset
  pop edx
  jmp originalCode

checkTimer:
  push ebx
  mov ebx,[timerSetting]
  mov [counter],ebx
  pop ebx
  jmp switchMode

migrator:
  pop edx
  push ebx
  mov ebx,[timerSetting]
  mov [counter],ebx
  inc dword ptr [cycler]
  pop ebx
  jmp originalCode

reset:
  mov dword ptr [cycler],#0
  jmp switchMode

skipCycle:
  inc dword ptr [cycler]
  jmp originalCode

originalCode:
  movsx eax,byte ptr [sh2pc.exe+19BBF89]
  jmp return

purple:
  pop edx
  cmp dword ptr [noPurple],1
  jae skipCycle
  mov byte ptr [sh2pc.exe+19BBF89],FF
  movsx eax,byte ptr [sh2pc.exe+19BBF89]
  jmp return

white:
  pop edx
  cmp dword ptr [noWhite],1
  jae skipCycle
  mov byte ptr [sh2pc.exe+19BBF89],00
  movsx eax,byte ptr [sh2pc.exe+19BBF89]
  jmp return

yellow:
  pop edx
  cmp dword ptr [noYellow],1
  jae skipCycle
  mov byte ptr [sh2pc.exe+19BBF89],01
  movsx eax,byte ptr [sh2pc.exe+19BBF89]
  jmp return

green:
  pop edx
  cmp dword ptr [noGreen],1
  jae skipCycle
  mov byte ptr [sh2pc.exe+19BBF89],02
  movsx eax,byte ptr [sh2pc.exe+19BBF89]
  jmp return

sprayMix:
  jmp newmem
  nop 2
return:

[DISABLE]

sprayMix:
  db 0F BE 05 89 BF DB 01

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
