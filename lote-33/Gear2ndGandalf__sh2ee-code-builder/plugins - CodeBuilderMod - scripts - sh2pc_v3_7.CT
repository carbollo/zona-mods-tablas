--=================== BOTTOM BAR ===================
local bar = createPanel(sh2Panel)
bar.Left, bar.Top, bar.Width, bar.Height = 14, 700, sh2Panel.Width - 28, 46
bar.Color, bar.BevelOuter = HEAD, 'bvNone'
pcall(function() bar.Anchors = '[akLeft,akRight,akBottom]' end)

label(bar, 10, 4, "Preset", DIM, 8)
local presets = loadAllPresets()
local pcombo = createComboBox(bar)
pcombo.Left, pcombo.Top, pcombo.Width = 10, 18, 180
pcombo.Style = 'csDropDown'
local function refillPresets(select)
  pcombo.Items.clear()
  local names = {}
  for k in pairs(presets) do names[#names + 1] = k end
  table.sort(names)
  for _, k in ipairs(names) do pcombo.Items.add(k) end
  if select then pcombo.Text = select end
end
refillPresets()

button(bar, 200, 16, 70, "Save", function()
  local name = pcombo.Text
  if name == nil or name:gsub("%s", "") == "" then
    print("[Panel] type a preset name first."); return
  end
  presets[name] = serialize()
  if saveAllPresets(presets) then refillPresets(name); print("[Panel] saved '" .. name .. "'") end
end)
button(bar, 276, 16, 70, "Load", function()
  local name = pcombo.Text
  if presets[name] == nil then print("[Panel] no preset '" .. tostring(name) .. "'"); return end
  deserialize(presets[name]); applyLoadedSettings()
  print("[Panel] loaded '" .. name .. "'")
end)
button(bar, 352, 16, 70, "Delete", function()
  local name = pcombo.Text
  if presets[name] == nil then return end
  presets[name] = nil; saveAllPresets(presets); refillPresets()
  print("[Panel] deleted '" .. name .. "'")
end)

-- Sits between the preset controls (which end at x=422) and the action buttons
-- (which start at x=812). Keep the caption short enough to live in that gap.
local status = label(bar, 440, 16, "", DIM, 9)
status.Width, status.Height = 380, 30
status.Top = 8
pcall(function() status.AutoSize = false; status.WordWrap = true end)

-- How many enemy types are resident in this area right now. Residency is the
-- safety property that matters, so it belongs on the status line rather than
-- behind a button. Mirrors loadedTypes() in Enemy Mayhem: 52 records, stride
-- 0x94, type id at +0x00. Only 0x2xx ids are counted as enemies.
local REG_BASE, REG_END, REG_STRIDE = 0x01F7D820, 0x01F7F630, 0x94
local function residentEnemyTypes()
  local n, a = 0, REG_BASE
  while a &lt; REG_END do
    local t = readInteger(a)
    if t == nil then return nil end
    if t ~= 0 and (t &gt;&gt; 8) == 2 then n = n + 1 end
    a = a + REG_STRIDE
  end
  return n
end

-- "Sanity" removed: two of its checks rested on hypotheses that were later
-- retracted (C-31.4 / C-31.5), and the rest duplicate the governor or are
-- already prevented by the sliders' own clamping.
-- "Panic" removed: every failure in this game is a freeze on a jmp-to-self,
-- so there is no moment in which to press it, and unticking the script in
-- Cheat Engine restores strictly more than mayhemPanic() ever did. The
-- function still exists for console use.
button(bar, 812, 16, 110, "Loaded Types", function() mayhemLoadedTypes() end)
button(bar, 932, 16, 110, "Reshuffle", function() mayhemReshuffle() end)
button(bar, 1052, 16, 110, "Defaults", function()
  if MAYHEM_DEFAULTS then
    for _, g in ipairs(GROUPS) do
      local tbl = MAYHEM_DEFAULTS[g]
      if type(tbl) == "table" and type(M[g]) == "table" then
        for k, v in pairs(tbl) do M[g][k] = v end
      end
    end
    -- Weights and bossPause sit outside the four groups; restore them too or
    -- Defaults silently leaves the type mix exactly as it was.
    if type(MAYHEM_DEFAULTS.weights) == "table" then
      for k in pairs(M.weights) do M.weights[k] = nil end
      for k, v in pairs(MAYHEM_DEFAULTS.weights) do M.weights[k] = v end
    end
    if MAYHEM_DEFAULTS.bossPause ~= nil then M.bossPause = MAYHEM_DEFAULTS.bossPause end
    if type(MAYHEM_DEFAULTS.dmgGroups) == "table" then
      for k, v in pairs(MAYHEM_DEFAULTS.dmgGroups) do M.dmgGroups[k] = v end
    end
    mayhemDmgApply()
    mayhemSpdApply()
    applyLoadedSettings()
  end
  print("[Panel] defaults restored.")
end)

sh2PanelTimer = createTimer(nil, false)
sh2PanelTimer.Interval = 400
sh2PanelTimer.OnTimer = function(sender)
  if sh2Panel == nil then sender.Enabled = false; return end
  pcall(serviceReshuffle)
  local ok = pcall(function()
    local budget = readInteger(0x01FAC644)
    local ents   = readInteger(0x01FB698C)
    local where  = "-"
    if _G.mayhemActive then where = _G.mayhemActive.indoors and "indoors" or "outdoors" end
    if M.bossArea then where = where .. "  \u{00B7}  BOSS" end
    local gov = M.governorActive and string.format("  \u{00B7}  gov cap %d", M.d.enemyCap) or ""
    local types = residentEnemyTypes()
    local guard = ""
    local ga = getAddressSafe("gStats")
    local aUsed, aBlocks, aBad = nil, nil, nil
    if mayhemArenaQuick then aUsed, aBlocks, aBad = mayhemArenaQuick() end
    if aBad and aBad &gt; 0 and not M.arenaAlarmed then
      M.arenaAlarmed = true
      print(string.format("[Attach]  ** %d OVERLAP(S) - run mayhemArenaAudit() NOW. **", aBad))
    end
    local arena = aUsed and string.format("  \u{00B7}  heap %dk", math.floor(aUsed / 1024)) or ""
    if ga then
      local caught = readInteger(ga + 4) or 0
      if caught &gt; 0 then guard = string.format("  \u{00B7}  guard %d", caught) end
    end

    if M.capRefresh and M.capShown ~= M.d.enemyCap then
      M.capShown = M.d.enemyCap
      pcall(M.capRefresh)
    end

    status.Caption = string.format(
      "bones %s  \u{00B7}  ents %s/32  \u{00B7}  cap %d  \u{00B7}  types %s  \u{00B7}  %s%s%s%s",
      tostring(budget), tostring(ents), M.d.enemyCap,
      tostring(types or "-"), where, gov, guard, arena)
      -- Heartbeat. The console survives the process; nothing else does.
    if M.heartbeat then
      local now = os.clock()
      if (M.hbNext or 0) &lt;= now then
        M.hbNext = now + 15
        print(string.format(
          "[HB] cap %d  ents %s/32  bones %s  blocks %s  heap %s used  overlaps %s  guard %s",
          M.d.enemyCap, tostring(ents), tostring(budget),
          tostring(aBlocks or "-"), tostring(aUsed or "-"),
          tostring(aBad or "-"),
          ga and tostring(readInteger(ga + 4) or "-") or "-"))
      end
    end
    status.Font.Color = (M.bossArea or M.governorActive or (budget or 999) &lt; 100) and WARN or DIM
  end)
  if not ok then sender.Enabled = false end
end
sh2PanelTimer.Enabled = true

-- The X button must hide, not free: the form is referenced by the timer and
-- by every control closure above.
sh2Panel.OnClose = function(sender)
  presets["Last used"] = serialize()
  saveAllPresets(presets)
  sender.hide()
  return 0
end

if presets["Last used"] then
  deserialize(presets["Last used"])
  applyLoadedSettings()
  print("[Panel] restored 'Last used' settings.")
end

sh2Panel.show()
print("[Panel] open.  Presets: " .. presetPath())
{$asm}


[DISABLE]
{$lua}
if syntaxcheck then return end

if sh2PanelTimer then
  sh2PanelTimer.Enabled = false; sh2PanelTimer.destroy(); sh2PanelTimer = nil
end
if sh2Panel then sh2Panel.destroy(); sh2Panel = nil end
print("[Panel] closed. Enemy Mayhem keeps running.")
{$asm}


</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>35102</ID>
              <Description>"Nightmare"</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
              <Color>00B789</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

if syntaxcheck then return end

local yellSFX  = findTableFile('SOUND_0182.wav')
local heartSFX = findTableFile('SOUND_1505.wav')
local beginSFX = findTableFile('SOUND_1637.wav')
local musicSFX = findTableFile('SOUND_1503.wav')

[ENABLE]

--=============================================================
-- CONFIGURATION
--=============================================================
NIGHT = {
  hideConsole   = false,   -- was true.  Left open so the trace below is
                           -- visible while the load crash is being bisected.
  trace         = false,   -- print menu/event/scene/room transitions
  forceLevel    = 0x04,    -- hidden Extra action level
  maxHpCeiling  = 90.5,    -- see note at the clamp
  maxHpBase     = 50.0,
  phSpeed       = 0.75,
  enemyRange    = 5500.0,
  sanityDelay   = 100,     -- ticks before sanity starts recovering

  -- SANITY PRESSURE
  -- Everything below is driven by  fatigue = 1 - sanity/100
  -- (0.0 = composed, 1.0 = completely unravelled).
  hpDrainMax     = 0.010,  -- HP per tick at fatigue 1, proximity 1, mult 1.
                           -- 10 ticks/sec, so 0.10 HP/sec worst case before
                           -- the type multiplier.  The old rate was 0.05,
                           -- which stripped 50 HP in about 45 seconds.
  hpDrainCurve   = 2.0,    -- fatigue exponent.  Higher = more negligible
                           -- early and sharper at the bottom end.
  staminaFatigue = true,   -- raise the fatigue floor as sanity falls
  speedThrottle  = 0.35,   -- fraction of speed removed at zero sanity
  speedFloor     = 0.55,   -- never scale movement below this
  speedStep      = 0.02,   -- quantiser; .text is only rewritten when the
                           -- scale moves at least this far
}

if NIGHT.hideConsole then
  getLuaEngine().cbShowOnPrint.Checked = false
  getLuaEngine().hide()
end

--=============================================================
-- COMMON HELPERS
--=============================================================

-- getMemoryRecordByDescription() returns nil when the description
-- is missing or has been renamed.  Calling :getCurrentAddress() on
-- nil gives an unreadable error, so name the record instead.
local function rec(al, desc)
  local r = al.getMemoryRecordByDescription(desc)
  if r == nil then error('Memory record not found: "' .. desc .. '"', 0) end
  local a = r:getCurrentAddress()
  if a == nil or a == 0 then error('Record "' .. desc .. '" resolved to 0', 0) end
  return a
end

-- getAddress() RAISES on an unknown symbol, it does NOT return nil.
-- Every "if not addr then return end" guard was therefore dead code.
local function sym(name)
  local ok, a = pcall(getAddress, name)
  if ok and a ~= nil and a ~= 0 then return a end
  return nil
end

-- Liveness canary.  _G outlives the game process, so a nil check on
-- a stored address proves nothing (notebook: Cautions / Scripting).
-- Read the module's own MZ header back instead.
local function processLive()
  local base = sym('sh2pc.exe')
  if base == nil then return false end
  return readSmallInteger(base) == 0x5A4D
end

--=============================================================
-- SHARED HEALTH BROKER
-- Identical block in every script that writes Player Health.
-- The first script to enable builds it; the last to disable tears
-- it down.
--
-- Why it exists: Nightmare, Health Regeneration, Life Steal and
-- Ampoules each ran their own 100 ms timer and each called
-- writeFloat() on the same address.  Last writer won, nothing
-- clamped to max HP, and regen could revive James in the middle of
-- the death sequence.  Now every script queues a DELTA and one
-- flusher sums them, clamps once, and writes once.
--=============================================================
if SH2HP == nil or SH2HP.pid ~= getOpenedProcessID() then
  SH2HP = {
    pid      = getOpenedProcessID(),
    users    = 0,      -- refcount of enabled scripts
    queue    = {},     -- source name -&gt; pending delta this tick
    absolute = nil,    -- an absolute set beats any queued deltas
    owner    = nil,    -- exclusive lock holder, or nil
    hpAddr   = nil,
    maxAddr  = nil,
    timer    = nil,
  }
end

function SH2HP.flush()
  if SH2HP.absolute == nil and next(SH2HP.queue) == nil then return end
  local hp  = readFloat(SH2HP.hpAddr)
  local max = readFloat(SH2HP.maxAddr)
  if hp == nil or max == nil then
    SH2HP.queue, SH2HP.absolute = {}, nil
    return
  end
  local target
  if SH2HP.absolute ~= nil then
    target = SH2HP.absolute
  else
    target = hp
    for _, d in pairs(SH2HP.queue) do target = target + d end
  end
  SH2HP.queue, SH2HP.absolute = {}, nil
  if target ~= target then return end                 -- drop NaN
  if max &gt; 0.0 and target &gt; max then target = max end -- the clamp that was missing
  if target &lt; 0.0 then target = 0.0 end
  if math.abs(target - hp) &gt; 0.0001 then writeFloat(SH2HP.hpAddr, target) end
end

function SH2HP.attach(hpAddr, maxAddr)
  SH2HP.hpAddr, SH2HP.maxAddr = hpAddr, maxAddr
  SH2HP.users = SH2HP.users + 1
  if SH2HP.timer == nil then
    SH2HP.timer          = createTimer(nil, false)
    SH2HP.timer.Interval = 100
    SH2HP.timer.OnTimer  = function(t) SH2HP.flush() end
    SH2HP.timer.Enabled  = true
  end
end

function SH2HP.detach(source)
  if SH2HP.owner == source then SH2HP.owner = nil end
  SH2HP.queue[source] = nil
  SH2HP.users = SH2HP.users - 1
  if SH2HP.users &lt;= 0 then
    SH2HP.users = 0
    if SH2HP.timer then
      SH2HP.timer.Enabled = false
      SH2HP.timer.destroy()
      SH2HP.timer = nil
    end
    SH2HP.queue, SH2HP.absolute, SH2HP.owner = {}, nil, nil
  end
end

-- Relative change.  Ignored while another source holds the lock.
function SH2HP.add(source, delta)
  if SH2HP.owner ~= nil and SH2HP.owner ~= source then return end
  if delta == nil or delta ~= delta then return end
  SH2HP.queue[source] = (SH2HP.queue[source] or 0.0) + delta
end

-- Absolute value.  Beats any deltas queued in the same tick.
function SH2HP.set(source, value)
  if SH2HP.owner ~= nil and SH2HP.owner ~= source then return end
  if value == nil or value ~= value then return end
  SH2HP.absolute = value
end

-- Exclusive lock.  The death sequence takes it so nothing can heal
-- James back off zero before the game-over flag is set.
function SH2HP.lock(source)
  if SH2HP.owner == nil then SH2HP.owner = source end
  return SH2HP.owner == source
end

function SH2HP.release(source)
  if SH2HP.owner == source then SH2HP.owner = nil end
end

--=============================================================
-- RESOLVE RECORDS
--=============================================================
if not processLive() then error('sh2pc.exe is not attached', 0) end

local al = getAddressList()

local storeMenu  = rec(al, 'Menu Event ID')
local storeEvent = rec(al, 'Event ID')
local storeRoom  = rec(al, 'Room ID')
local storeScene = rec(al, 'Cutscene ID')
local storeMaxHp = rec(al, 'Player Max Health')
local storeHp    = rec(al, 'Player Health')
local storeMaxSt = rec(al, 'Player Max Stamina')
local storeSt    = rec(al, 'Player Stamina')
local storeSp    = rec(al, 'Player Speed')
local storeUpper = rec(al, 'True Upper')
local storeLower = rec(al, 'True Lower')
local storeOver  = rec(al, 'Game Over Toggle')
local storeDead  = rec(al, 'Player Control')
local storeSave  = rec(al, 'Save Game Toggle')
local storeTorch = rec(al, 'Progress 1')
local storeDark  = rec(al, 'Progress 7')
local storeItem  = rec(al, 'Byte 3')
local storeLamp  = rec(al, 'Flashlight Setting')
local storeSee   = rec(al, 'Flashlight Toggle')
local storeExtra = rec(al, 'Action Level')
local storeLight = rec(al, 'Visibility Toggle')
local storeSky   = rec(al, 'Sky Color')
local storeTime  = rec(al, 'Time of Day')
local storeSFogC = rec(al, 'Simple Fog Color')
local storeSFogD = rec(al, 'Simple Fog Density')
local storeCFogC = rec(al, 'Complex Fog Color')
local storeCFogD = rec(al, 'Complex Fog Density')
local storeShade = rec(al, 'Shadows Toggle')
local storeModel = rec(al, 'Model Brightness Alt')
local storeAmmo  = rec(al, 'Ammo Multiplier')
local storeSkip  = rec(al, 'Long Trail')

--=============================================================
-- GLOBALS
-- These must be global, not local: CE compiles ENABLE and
-- DISABLE as separate chunks, so an ENABLE local is nil by
-- the time DISABLE runs.  storeRed/Green/Blue used to be local
-- and every disable-time restore silently threw.
--=============================================================
storeKeyB   = rec(al, 'Flashlight Keyboard')
storeJoyB   = rec(al, 'Flashlight Controller')
storeRed    = rec(al, 'Flashlight Red')
storeGreen  = rec(al, 'Flashlight Green')
storeBlue   = rec(al, 'Flashlight Blue')

origKeyB    = readByte(storeKeyB)
origJoyB    = readInteger(storeJoyB)
origRed     = readFloat(storeRed)
origGreen   = readFloat(storeGreen)
origBlue    = readFloat(storeBlue)

bindingsDisabled = false

-- Pyramid Head speed lives in an imm32 operand inside .text.  There is
-- no assert() available from Lua, so validate by plausibility instead
-- and keep the original byte pattern so DISABLE can put it back.
phSpeedAddr = sym('sh2pc.exe+BC13D')
phSpeedOrig = nil
phSpeedOK   = false
if phSpeedAddr then
  local v = readFloat(phSpeedAddr)
  if v ~= nil and v &gt; 0.05 and v &lt; 8.0 then
    phSpeedOrig = v
    phSpeedOK   = true
  else
    print('[Nightmare] sh2pc.exe+BC13D does not look like a speed float; ' ..
          'speed patch disabled this session.')
  end
end

-- JAMES'S MOVEMENT SPEED
-- The field is entity +0xA8 (sh2pc.exe+1BB10A8).  Do NOT throttle it by
-- writing that address: the "find what writes" capture shows fifteen
-- separate sites hitting it, two of them 2065 times each, because
-- 00556B90 fsubr / 00556B96 fstp decay it every single frame.  A 100 ms
-- poll would be overwritten within a frame or two and would only stutter.
--
-- The two sites that SET it are plain mov-immediates, hit twice each in
-- the whole capture:
--     00548880  C7 87 A8000000 9A99193F   mov [edi+000000A8],(float)0.6
--     0054872E  C7 87 A8000000 00002040   mov [edi+000000A8],(float)2.5
-- The imm32 operand sits six bytes into each instruction.  Scaling those
-- is the same lever the enemy speed work already uses, and it costs one
-- write per change instead of ten per second.
speedImm = {
  { addr = sym('sh2pc.exe+148886'), orig = nil, expect = 0.6 },
  { addr = sym('sh2pc.exe+148734'), orig = nil, expect = 2.5 },
}
speedImmOK      = false
speedImmApplied = nil

do
  local ok = true
  for i = 1, #speedImm do
    local s = speedImm[i]
    if s.addr == nil then
      ok = false
      break
    end
    -- Assert the OPCODE, not just the value.  The six bytes in front of
    -- the immediate must be C7 87 A8 00 00 00, i.e. mov [edi+A8],imm32.
    -- A value check alone would happily patch the wrong instruction.
    local b = readBytes(s.addr - 6, 6, true)
    local v = readFloat(s.addr)
    if b == nil or v == nil
       or b[1] ~= 0xC7 or b[2] ~= 0x87 or b[3] ~= 0xA8
       or b[4] ~= 0x00 or b[5] ~= 0x00 or b[6] ~= 0x00
       or math.abs(v - s.expect) &gt; 0.01 then
      print('[Nightmare] speed immediate ' .. i .. ' failed its byte check; ' ..
            'movement throttle disabled this session.')
      ok = false
      break
    end
    s.orig = v
  end
  speedImmOK = ok
end

-- Sanity state: allocated so it persists across script toggles
if not sanityAddr then
  sanityAddr = allocateMemory(4)
  registerSymbol('sanity', sanityAddr)
  writeFloat(sanityAddr, 100.0)
end

SH2HP.attach(storeHp, storeMaxHp)

--=============================================================
-- STATE
--=============================================================
