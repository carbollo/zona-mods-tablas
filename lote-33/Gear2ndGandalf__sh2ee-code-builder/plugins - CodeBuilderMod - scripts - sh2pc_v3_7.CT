alloc(steelPipeSpeed,4)
alloc(greatKnifeSpeed,4)
alloc(chainsawSpeed,4)
alloc(cleaverSpeed,4)

label(moving handgun shotgun rifle revolver hyperSpray woodenPlank steelPipe greatKnife weap9 cleaver code return)

moveSpeed:
  dw #8000

handgunSpeed:
  dw #3000

shotgunSpeed:
  dw #3000

rifleSpeed:
  dw #3000

revolverSpeed:
  dw #3000

hyperSpraySpeed:
  dw #3000

woodenPlankSpeed:
  dw #2500

steelPipeSpeed:
