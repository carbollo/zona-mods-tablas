local function findByDescription(parent, searchName, ancestors)
  if ancestors == nil then
    ancestors = {}
  end

  if parent == nil then
    print(string.format("Passed parent is null, can't search for %s!", searchName))
    return nil
  end

  ancestors[#ancestors +1] = parent.getDescription()

  --print(string.format("%s",
  --    table.concat(ancestors, " &gt; ")))

  if parent.Count &lt;= 0 then
    print(string.format("%s %s does not contain any children, can't search for %s!",
      table.concat(ancestors, " &gt; "), searchName))
    table.remove(ancestors, #ancestors)
    return nil
  end

  for i=0,parent.Count-1 do
    local child = parent.Child[i]

    --print(string.format("%s &gt; %s",
    --  table.concat(ancestors, " &gt; "), child.getDescription()))

    if child.getDescription() == searchName then
       print(string.format("%s%s !!",
         table.concat(ancestors, " &gt; "), parent.getDescription(), searchName))

       table.remove(ancestors, #ancestors)
       return child
    end
    if child.Count &gt; 0 then
      local found = findByDescription(child, searchName, ancestors);
      if found ~= nil then
        table.remove(ancestors, #ancestors)
        return found;
      end
    end
  end

  table.remove(ancestors, #ancestors)
  return nil
end

local function removeChildren(parentNode, startIndex)
  if parentNode.Count &gt; startIndex then
    for i=parentNode.Count-1, startIndex, -1 do
      local r =parentNode.Child[i]
      print(string.format('Remove node #%d (of %d); "%s"', i, parentNode.Count-1, r.getDescription()))
      memoryrecord_delete(r)
    end
  end
end

function removeChildByName(parentNode, name)
  for i=parentNode.Count-1, 0, -1 do
    local r =parentNode.Child[i]
    if r.getDescription() == name then
      print(string.format('Remove node #%d (of %d); "%s"', i, parentNode.Count-1, r.getDescription()))
      memoryrecord_delete(r)
      break
    end
  end
end

local function generateSlots(targetNode, aOptions, startIndex, maxSlots)
  local al = getAddressList()

  print(string.format('Parent for adding slots: "%s"',
    targetNode.getDescription()))

  -- Remove already generated Slots
  removeChildren(targetNode, startIndex)

  -- Generate Slots (including slot groups)
  for j = 1, maxSlots do
    local grp = nil

    -- Handling for slot group
    if j % 10 == 1 then
      grp = al.createMemoryRecord()
      grp.setDescription(string.format('%d-%d', j, math.min(j +10, maxSlots)))
      grp.Options = '[moAlwaysHideChildren,moManualExpandCollapse,moAllowManualCollapseAndExpand]'
      grp.IsGroupHeader=true
      grp.DontSave = true
      grp.appendToEntry(targetNode)
    else
      grp = targetNode.Child[targetNode.Count-1]
    end

    print(string.format("%d -&gt; Group: %s", j, grp.getDescription()))

    -- Create new slot
    local slot = al.createMemoryRecord()
    slot.setDescription(string.format("Slot %d", j))
    slot.setType(vtByteArray)
    slot.Aob.Size = 5
    slot.setAddress(string.format('+A * %x', j - 1))
    slot.ShowAsSigned = true
    slot.appendToEntry(grp)
    slot.DropDownList.Text = aOptions
    slot.DropDownReadOnly=true
    slot.DropDownDescriptionOnly=true
    slot.DisplayAsDropDownListItem=true
    slot.DontSave = true
  end
end

local function findEntry(hierarchy)
  local al = getAddressList()

  if al.Count &lt; 1 then
    print('No entries in cheat table existing!')
    return nil
  end

  local parentNode = al.getMemoryRecordByDescription(hierarchy[1])

  if parentNode == nil then
    print(string.format('Root %s not found', hierarchy[1]))
    return nil
  end

  for i = 2, #hierarchy do
    parentNode = findByDescription(parentNode, hierarchy[i]);
  end

  if parentNode == nil then
    print(string.format('%s not found', table.concat(hierarchy, ' &gt; ')))
    return nil
  end

  return parentNode
end

local function createChildEntry(parentNode, name, baseOffset, pointerOffsets, aOptions)
  local al = getAddressList()
  removeChildByName(parentNode, name)

  local n = al.createMemoryRecord()
  n.setDescription(name)
  n.setType(vtByte)
  n.setAddress(string.format('+%x', baseOffset))
  
  if pointerOffsets ~= nil and #pointerOffsets &gt; 0 then
    n.setOffsetCount(#pointerOffsets)
    for i=1, #pointerOffsets do
      n.setOffset(pointerOffsets[i])
    end
  end

  n.ShowAsSigned = true
  n.appendToEntry(parentNode)
  n.DropDownList.Text = aOptions
  n.DropDownReadOnly=true
  n.DropDownDescriptionOnly=true
  n.DisplayAsDropDownListItem=true
  n.DontSave = true
end

local function generateWeaponEntries(hierarchy, baseOffset, pointerOffsets, aOptions)
  local parentNode = findEntry(hierarchy)

  if parentNode ~= nil then
    for i=0,parentNode.Count-1 do
      local child = parentNode.Child[i]
      createChildEntry(child, "primary weapon", baseOffset, pointerOffsets, aOptions)
      createChildEntry(child, "secondary weapon", baseOffset + (pointerOffsets ~= nil and #pointerOffsets &gt; 0 and 4 or 1), pointerOffsets, aOptions)
    end
  end
end

-- Start --
local al = getAddressList()

if al.Count &gt;= 1 then

  -- Red Alert

  local p = findEntry({'Red Alert', 'Player (Campaign)'})

  generateSlots(findByDescription(p, 'SideBar (Buildings)'), aRaBuildings, 1, 75)
  generateSlots(findByDescription(p, 'SideBar (Infantry, Units, SuperWeapons)'),
    aRaInfantryUnitsSuperweapons, 1, 75)

  p = findEntry({'Red Alert', 'Player (Skirmish)'})
  generateSlots(findByDescription(p, 'SideBar (Buildings)'), aRaBuildings, 1, 75)
  generateSlots(findByDescription(p, 'SideBar (Infantry, Units, SuperWeapons)'),
    aRaInfantryUnitsSuperweapons, 1, 75)

  generateWeaponEntries(
    {'Red Alert', 'Structure Definitions (click to open details)'}, 361, {0},
    aRaWeapons)

  generateWeaponEntries(
    {'Red Alert', 'Unit Definitions (click to open details)'}, 361, {0},
    aRaWeapons)

  generateWeaponEntries(
    {'Red Alert', 'Infantry Definitions (click to open details)'}, 361, {0},
    aRaWeapons)

  generateWeaponEntries(
    {'Red Alert', 'Aircraft Definitions (click to open details)'}, 361, {0},
    aRaWeapons)

  -- Tiberian Dawn

  local p = findEntry({'Tiberian Dawn', 'Player (Campaign)'})

  generateSlots(findByDescription(p, 'SideBar (Buildings)'), aRaBuildings, 1, 30)
  generateSlots(findByDescription(p, 'SideBar (Infantry, Units, SuperWeapons)'),
    aRaInfantryUnitsSuperweapons, 1, 30)

  p = findEntry({'Tiberian Dawn', 'Player (Skirmish)'})
  generateSlots(findByDescription(p, 'SideBar (Buildings)'), aRaBuildings, 1, 30)
  generateSlots(findByDescription(p, 'SideBar (Infantry, Units, SuperWeapons)'),
    aRaInfantryUnitsSuperweapons, 1, 30)

  generateWeaponEntries(
    {'Tiberian Dawn', 'Structure Definitions (click to open details)'}, 65, {},
    aTdWeapons)

  generateWeaponEntries(
    {'Tiberian Dawn', 'Unit Definitions (click to open details)'}, 65, {},
    aTdWeapons)

  generateWeaponEntries(
    {'Tiberian Dawn', 'Infantry Definitions (click to open details)'}, 65, {},
    aTdWeapons)

  generateWeaponEntries(
    {'Tiberian Dawn', 'Aircraft Definitions (click to open details)'}, 65, {},
    aTdWeapons)

end

