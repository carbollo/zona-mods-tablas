              <ID>1337157535</ID>
              <Description>"script templates ⚠☝️🐸⛧"</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1"/>
              <Color>FF596B</Color>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337157536</ID>
                  <Description>"Required for the table"</Description>
                  <Options moHideChildren="1" moManualExpandCollapse="1"/>
