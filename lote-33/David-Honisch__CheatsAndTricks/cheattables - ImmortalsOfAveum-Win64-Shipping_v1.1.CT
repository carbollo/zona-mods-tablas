[ENABLE]

aobscanmodule(Items_AoB,$process,8B 5B ? 48 8B ? ? ? 8B C3)
alloc(Items_Newmem,$100,Items_AoB)
alloc(Items_BackupBytes,8,Items_AoB)

label(Items_Return)
label(Items_OriginalCode)

Items_BackupBytes:
  readmem(Items_AoB,8)

Items_Newmem:
  mov r12d,[rbx+20]
  cmp [Items_BackupBytes+20],r12d
  jne Items_OriginalCode
  mov [Items_Pointer],rbx

Items_OriginalCode:
  readmem(Items_AoB,8)
  {
  mov ebx,[rbx+20]
  mov rsi,[rsp+48]
  }
  jmp Items_Return

Items_BackupBytes+20:
  dd 0

Items_Pointer:
  dq 0

Items_AoB:
  jmp Items_Newmem
  nop 3
Items_Return:
registersymbol(Items_AoB)
registersymbol(Items_Pointer)
registersymbol(Items_BackupBytes)

{$LUA}
if syntaxcheck then return end
local msg = [[
Change the value of "EnterCurrentItemQuantity"
To the quantity of the item you want to access.
So if you have for example 666 Gold then enter the value 666.
After this open your inventory and go to the "Gear" tab.
In "Item" -&gt; "Quantity" you can now adjust the quantity of the item.
              ]]
mShowMessage('Note', msg, true, 0)
memrec.Color = scriptColorActivated
{$ASM}
[DISABLE]
{$LUA}
if syntaxcheck then return end
memrec.Color = scriptColorDeactivated
{$ASM}

Items_AoB:
  readmem(Items_BackupBytes,8)

unregistersymbol(*)
