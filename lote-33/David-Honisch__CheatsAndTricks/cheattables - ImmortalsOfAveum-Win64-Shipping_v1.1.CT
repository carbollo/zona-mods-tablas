                    <CheatEntry>
                      <ID>1337157537</ID>
                      <Description>"Script Author Name Modifier"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]

aobscanmodule(AuthorName_AoB,$process,8A 04 ?? 49 FF ?? 88 02 48 83 C2)
alloc(AuthorName_Newmem,$100,AuthorName_AoB)
alloc(AuthorName_BackupBytes,6,AuthorName_AoB)

label(AuthorName_Return)
label(AuthorName_OriginalCode)

AuthorName_BackupBytes:
  readmem(AuthorName_AoB,6)

AuthorName_Newmem:
//;Compare against default Author Name (in this case it's "Ryo Asuka"):
  cmp [rcx+rdx],'Ryo ' //;4 Characters / 4 Bytes
  jne AuthorName_OriginalCode
  cmp [rcx+rdx+4],'Asuk' //;4 Characters / 4 Bytes
  jne AuthorName_OriginalCode
  cmp byte ptr [rcx+rdx+8],'a' //;1 Character / 1 Byte
  jne AuthorName_OriginalCode
//;Set String to:
  mov [rcx+rdx],'Akir' //;4 Characters / 4 Bytes
  mov [rcx+rdx+4],'a Fu' //;4 Characters / 4 Bytes
  mov word ptr [rcx+rdx+8],'do' //;2 Characters / 2 Bytes
//;Set String Length:
  mov dword ptr [rcx+rdx-8],A //;String length is 10 (A in hex decimal)

AuthorName_OriginalCode:
  readmem(AuthorName_AoB,6)
  {
  mov al,[rcx+rdx]
  dec r8
  }
  jmp AuthorName_Return

AuthorName_AoB:
  jmp AuthorName_Newmem
  nop
AuthorName_Return:
registersymbol(AuthorName_AoB)
registersymbol(AuthorName_BackupBytes)

[DISABLE]

AuthorName_AoB:
  readmem(AuthorName_BackupBytes,6)

unregistersymbol(AuthorName_AoB)
unregistersymbol(AuthorName_BackupBytes)
dealloc(AuthorName_Newmem)
dealloc(AuthorName_BackupBytes)
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337157538</ID>
                      <Description>"Unity Tool"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
[ENABLE]
if syntaxcheck then return end
LaunchMonoDataCollector()
local unityIL2CPPGame = false
function UnityToolButton0Click(sender)
   local className = UnityToolEditBox3.Text -- "PlayerCharacterMasterController"
   local fieldName = UnityToolEditBox1.Text -- "_instances"
   local nameSpace = UnityToolEditBox2.Text -- "RoR2"
   --getStaticFieldAddress(className, fieldName, nameSpace)
   local function toHex(str)
            str = string.format("%X", str)
            return str
         end
   if unityIL2CPPGame == false then
      if not nameSpace then nameSpace = '' end
      local cid       = mono_findClass(nameSpace,className)
      local theFields = mono_class_enumFields(cid,true)
      local sf0
      local sf1
      local sf2
      for i=1,#theFields do
          if theFields[i].isStatic and theFields[i].name == fieldName then
             local test = theFields[i].Type
             sf0 = mono_class_getStaticFieldAddress('',cid)
             sf2 = sf0 + theFields[i].offset
             sf3 = toHex(readPointer(sf2))
             --print(toHex(readPointer(sf0)))
             if readPointer(sf3) ~= nil then
                UnityToolEditBox0.Text = "[" .. toHex(sf0) .. "+" .. theFields[i].offset .. "]" .. " | " .. toHex(readPointer(sf2))
             else
                UnityToolEditBox0.Text = toHex(sf0) .. "+" .. theFields[i].offset .. " | " .. toHex(readPointer(sf2))
             end
          end
      end
   end
   if unityIL2CPPGame == true then
      if not nameSpace then nameSpace = '' end
      local cid       = mono_findClass(nameSpace,className)
      local theFields = mono_class_enumFields(cid,true)
      local sf0
      local sf2
      local sf3
      for i=1,#theFields do
          if theFields[i].isStatic and theFields[i].name == fieldName then
             --sf0 = readPointer(cid+0xB8) + theFields[i].offset
             --print(toHex(sf0))
             --UnityToolEditBox0.Text = toHex(readPointer(sf0))
             sf0 = toHex(cid)
             sf2 = "[" .. toHex(cid) .. "+B8" .. "]" .. "+" .. toHex(theFields[i].offset)
             sf3 = toHex(readPointer(readPointer(cid+0xB8) + theFields[i].offset))
             if sf3 ~= nil then
                UnityToolEditBox0.Text = sf2 .. " | " .. sf3
             end
          end
      end
   end
end

function UnityToolCheckBox0Click(sender)
   if UnityToolCheckBox0.Checked == true then
      unityIL2CPPGame = true
   else
      unityIL2CPPGame = false
   end
end



local SM_CXSCREEN = 0
local SM_CYSCREEN = 1

function getScreenSize()
  local screenWidth = GetSystemMetrics(SM_CXSCREEN)
  local screenHeight = GetSystemMetrics(SM_CYSCREEN)
  return screenWidth, screenHeight
end

local screenWidth, screenHeight = getScreenSize()
-- print("Screen Width: " .. screenWidth)
-- print("Screen Height: " .. screenHeight)


local UnityToolPicture = "https://fearlessrevolution.com/download/file.php?avatar=29812_1599516181.jpg"
local UnityToolIcon = "https://cdn.discordapp.com/attachments/868702792116760637/1138629921867051129/Akira.ico"


UnityToolForm = createForm(true)
UnityToolForm.centerScreen()
UnityToolForm.Caption = "Unity Tool"
UnityToolForm.MaxWidth  = screenWidth
UnityToolForm.MaxHeight = screenHeight
UnityToolForm.Width  = screenWidth / 2
UnityToolForm.Height = screenHeight / 1.8
UnityToolForm.Icon.LoadFromStream(createStringStream(getInternet().getURL(UnityToolIcon)))

UnityToolGroupBox = createGroupBox(UnityToolForm)
UnityToolGroupBox.MaxWidth  = UnityToolForm.MaxWidth - 5
UnityToolGroupBox.MaxHeight = UnityToolForm.MaxHeight - 5
UnityToolGroupBox.Width  = UnityToolForm.Width - 5
UnityToolGroupBox.Height = UnityToolForm.Height / 3

UnityToolImage = createImage(UnityToolForm)
UnityToolImage.Align = alBottom
UnityToolImage.setSize(UnityToolForm.Width,UnityToolForm.Height)
UnityToolImage.Stretch = true
UnityToolImage.Picture.LoadFromStream(createStringStream(getInternet().getURL(UnityToolPicture)))

UnityToolEditBox0 = createEdit(UnityToolGroupBox)
UnityToolEditBox0.Text = "&lt;Address Will Be Displayed Here&gt;"
UnityToolEditBox0.AutoSize = true
UnityToolEditBox0.Align = alTop

UnityToolCheckBox0  = createCheckBox(UnityToolGroupBox)
UnityToolCheckBox0.AutoSize = true
UnityToolCheckBox0.Caption = "IL2CPP Game"
UnityToolCheckBox0.Align = alTop
UnityToolCheckBox0.OnClick = 'UnityToolCheckBox0Click'

UnityToolButton0  = createButton(UnityToolGroupBox)
UnityToolButton0.AutoSize = true
UnityToolButton0.Caption = "Get Address"
UnityToolButton0.Align = alTop
UnityToolButton0.OnClick = 'UnityToolButton0Click'

UnityToolEditBox1 = createEdit(UnityToolGroupBox)
UnityToolEditBox1.Text = "&lt;EnterStaticFieldNameHere&gt; e.g.: _instances"
UnityToolEditBox1.AutoSize = true
UnityToolEditBox1.Align = alTop

UnityToolEditBox2 = createEdit(UnityToolGroupBox)
UnityToolEditBox2.Text = "&lt;EnterClassNameSpaceHere&gt; e.g.: RoR2"
UnityToolEditBox2.AutoSize = true
UnityToolEditBox2.Align = alTop

UnityToolEditBox3 = createEdit(UnityToolGroupBox)
UnityToolEditBox3.Text = "&lt;EnterClassNameHere e.g.: PlayerCharacterMasterController&gt;"
UnityToolEditBox3.AutoSize = true
UnityToolEditBox3.Align = alTop

[DISABLE]
if syntaxcheck then return end
UnityToolForm.destroy()
