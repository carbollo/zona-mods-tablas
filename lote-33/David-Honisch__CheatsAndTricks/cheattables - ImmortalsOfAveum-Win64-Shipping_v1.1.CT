                    <CheatEntry>
                      <ID>1337158048</ID>
                      <Description>"Auto disable script after code execution"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
  if syntaxcheck then return end
{$ASM}
[ENABLE]
{$LUA}
function toHex(str)
str = string.format("%X", str)
return str
end

local AmmoBase    = toHex(getAddressSafe('[[[scrGameControl_Pointer]+88]+20]+38'))
local maxAmmoBase = toHex(getAddressSafe('[[[scrGameControl_Pointer]+88]+20]+40'))
if AmmoBase ~=nil or maxAmmoBase ~=nil then
   adAmmo_1     = toHex(getAddressSafe('[' .. AmmoBase .. ']+20'))
   adAmmo_2     = toHex(getAddressSafe('[' .. AmmoBase .. ']+24'))
   adAmmo_3     = toHex(getAddressSafe('[' .. AmmoBase .. ']+28'))
   adAmmo_4     = toHex(getAddressSafe('[' .. AmmoBase .. ']+2C'))
   adAmmo_5     = toHex(getAddressSafe('[' .. AmmoBase .. ']+30'))
   adAmmo_6     = toHex(getAddressSafe('[' .. AmmoBase .. ']+34'))
   adAmmo_7     = toHex(getAddressSafe('[' .. AmmoBase .. ']+38'))

   adMaxAmmo_1  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+20'))
   adMaxAmmo_2  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+24'))
   adMaxAmmo_3  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+28'))
   adMaxAmmo_4  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+2C'))
   adMaxAmmo_5  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+30'))
   adMaxAmmo_6  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+34'))
   adMaxAmmo_7  = toHex(getAddressSafe('[' .. maxAmmoBase .. ']+38'))

   writeInteger(adAmmo_1, readInteger(adMaxAmmo_1))
   writeInteger(adAmmo_2, readInteger(adMaxAmmo_2))
   writeInteger(adAmmo_3, readInteger(adMaxAmmo_3))
   writeInteger(adAmmo_4, readInteger(adMaxAmmo_4))
   writeInteger(adAmmo_5, readInteger(adMaxAmmo_5))
   writeInteger(adAmmo_6, readInteger(adMaxAmmo_6))
   writeInteger(adAmmo_7, readInteger(adMaxAmmo_7))

memrec.Color = 0x0000FF00 --AABBGGRR Green

end

local memrec = memrec or getAddressList().getMemoryRecordByDescription("Auto disable script after code execution")

local timer = createTimer()
timer.Interval = 1 * 1000 --;1000 milliseconds per second
timer.OnTimer = function(theTimerCallingThisFunction)
  memrec.Active = false --;deactivate the script
  timer.destroy() --;destroy the timer so it doesn't keep running
end

{$ASM}
[DISABLE]
{$LUA}

memrec.Color = 0x000000FF --AABBGGRR Red

{$ASM}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337158049</ID>
                      <Description>"Activation script to choose between multiple processes."</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
  if syntaxcheck then return end

  [ENABLE]

  local al = getAddressList()
  local pl = getProcessList()

  local gameName  = 'Deep Rock Galactic'
  local steamProc = 'FSD-Win64-Shipping.exe'
  local uwpProc   = 'FSD-WinGDK-Shipping.exe'

  if pl[getProcessIDFromProcessName(steamProc)] ~= nil
  or pl[getProcessIDFromProcessName(uwpProc)] ~= nil then

    if (readInteger(process) == nil) or (readInteger(process) ~= readInteger(steamProc)) then
      openProcess(steamProc)
    end
    if (readInteger(process) == nil) or (readInteger(process) ~= readInteger(uwpProc)) then
      openProcess(uwpProc)
      --if not monopipe then LaunchMonoDataCollector() end
      mShowMessage('Surrender to the Darkness', 'Table made by Akira Fudo', true, 0)
        elseif (readInteger(process) == nil) or (readInteger(process) ~= readInteger(uwpProc)) then
          openProcess(uwpProc)
        --else
        --if not monopipe then
          -- LaunchMonoDataCollector()
        --end
        --return
    end

    --Activate other script START
    local al = getAddressList()
    if al ~= nil then
    local playerScript = al.getMemoryRecordByDescription('[LocalPlayer] / Needs to be active for some scripts to work!')
    playerScript.Active = true
    end
    --Activate other script END
  else beep()
    error(showMessage(("%s (%s) is not running.\nPlease open the process first."):format(gameName,steamProc,uwpProc)))
  end

  [DISABLE]

    local al = getAddressList()
    if al ~= nil then
    local playerScript = al.getMemoryRecordByDescription('[LocalPlayer] / Needs to be active for some scripts to work!')
    playerScript.Active = false
    end

  --if monopipe then monopipe.destroy();monopipe=nil end
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337158050</ID>
                      <Description>"Change Pointer Color &amp; Value when checking its Box"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
[ENABLE]
function toHex(str)
  str = string.format("%X", str)
  return str
end
if syntaxcheck then return end
local valueCMP = 1 --Value you want to compare against
local al = getAddressList()
local TestBase = toHex(getAddressSafe('LocalPlayer_Pointer')) --Get base address of the class which holds your pointer
local t = createTimer(getMainForm())
t.Interval = 50
t.OnTimer = function(checkState)
   if memrec.Active == false then
      t.destroy()
   else if memrec ~= nil and memrec.Active == true then
           if al ~= nil then
              if TestBase ~= nil then
                 adTest = toHex(getAddressSafe('[' .. TestBase .. ']+40')) --Get actual pointer address
                 --local pRecord = al.getSelectedRecord(adTest) --Get memory record of the pointer
                 local pRecord = al.getMemoryRecordByDescription('[0040] - ConfiguredLanSpeed')
                 if pRecord.Active == true then
                    pRecord.color = 0x00FF00 --Set color of pointer to green when value of compare is equal
                    writeInteger(adTest, 1)
                 else if pRecord.Active == false then
                         pRecord.color = 0x0000FF --Set color of pointer to red when value of compare is not equal
                         writeInteger(adTest, 0)
                      end
                 end
              end
           end
        end
   end
end
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337158051</ID>
                      <Description>"Change Color of specific pointer when checking box"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
[ENABLE]
function toHex(str)
  str = string.format("%X", str)
  return str
end
if syntaxcheck then return end
local al = getAddressList()
local t = createTimer(getMainForm())
t.Interval = 50
t.OnTimer = function(checkState)
   if memrec.Active == false then
      t.destroy()
   else if memrec ~= nil and memrec.Active == true then
           if al ~= nil then
              local pRecord = al.getMemoryRecordByDescription('[0040] - ConfiguredLanSpeed')
              if pRecord.Active == true then
                 pRecord.color = 0x0000FF
              else
                 pRecord.color = 0x000080
              end
           end
        end
   end
end
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
