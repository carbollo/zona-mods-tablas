local SM_CXSCREEN = 0
local SM_CYSCREEN = 1

function getScreenSize()
  local screenWidth = GetSystemMetrics(SM_CXSCREEN)
  local screenHeight = GetSystemMetrics(SM_CYSCREEN)
  return screenWidth, screenHeight
end

local screenWidth, screenHeight = getScreenSize()
