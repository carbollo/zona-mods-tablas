  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>256778</ID>
      <Description>"ToggleForm"</Description>
      <Color>FF0077</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$LUA}
[ENABLE]
if syntaxcheck then return end
if CheatForm.Visible == true then
   CheatForm.Hide()
else
   CheatForm.Show()
   --CheatForm.Color = 0x000000
   CheatForm.setLayeredAttributes(0x0000FE, 240, 2)
   speakEnglish("Surrender to the Darkness", false)
end
createTimer(10, function() memrec.Active = false end)
[DISABLE]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>349103</ID>
      <Description>"Deactivation"</Description>
      <Color>000080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$LUA}
if syntaxcheck then return end
[ENABLE]
-- Deactivate All Scripts
local al = getAddressList()
for i = 0, al.Count - 1 do
    if al[i].Type == vtAutoAssembler then al[i].Active = false end
    if al[i].Type == vtAutoAssembler then al[i].Color = scriptColorDeactivated end -- Scripts
    if al[i].Type == vtAutoAssembler and al[i].Description == 'Activation' then al[i].Color = scriptColorActivated end
    if al[i].Type == vtAutoAssembler and al[i].Description == 'Deactivation' then al[i].Color = scriptColorDeactivated end
    if al[i].Type == vtAutoAssembler and al[i].Description == 'ToggleForm' then al[i].Color = 0xFF0077 end
    if al[i].Description == 'Research' then al[i].Color = 0x000000 end
end
-- Deactivate mono if available
if isUnityEngine == true then
   if monopipe then monopipe.destroy();monopipe=nil end
else
end
createTimer(1500, function() memrec.Active = false end)
[DISABLE]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>1337154625</ID>
      <Description>"Activation"</Description>
      <Options moHideChildren="1"/>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$LUA}
AddressList.OnAutoAssemblerEdit = nil
if syntaxcheck then return end
[ENABLE]
if syntaxcheck then return end
if (getCEVersion() == 7.5) then
   local al = getAddressList()
   local pl = getProcessList()
   --if GameProcess ~= nil then
   if pl[getProcessIDFromProcessName(GameProcess0)] ~= nil then
      openProcess(GameProcess0)
      sleep(10)
   elseif pl[getProcessIDFromProcessName(GameProcess1)] ~= nil and GameProcess1 ~= '-' then
      openProcess(GameProcess1)
      sleep(10)
   elseif pl[getProcessIDFromProcessName(GameProcess2)] ~= nil and GameProcess2 ~= '-' then
      openProcess(GameProcess2)
      sleep(10)
   else
      mShowMessage('Note', GameProcess0 .. ' is not running!', true, 0)
      return
   end

   CheatForm.ProcessFolder.Text  = enumModules()[1].PathToFile
   --CheatForm.SavegameFolder.Text = extractString(enumModules()[1].PathToFile, 'Binaries') .. 'Saved'

   local AoB
   local Start
   local End
   local Scan
   local addr

--[[
   02 00 00 C3 CC 48 89 5C 24 08
   48 89 ? ? ? 57 48 83 EC ? 0F 29 ? ? ? 0F 28 ? 48 8B ? 8B 89
   48 89 ?? ?? ?? 57 48 83 ?? ?? 0F 29 ?? ?? ?? 0F 28 ?? 48 8B ?? 8B
   48xxxxxxxxxx48xxxxxxxxxxxxxxxx0Fxxxxxxxxxx8Bxxxxxxxxxx85xxxxxxxxxxxxxx0FxxxxF3]]
--[[
   AoB  = "48 89 ?? ?? ?? 57 48 83 ?? ?? 0F 29 ?? ?? ?? 0F 28 ?? 48 8B ?? 8B"
   Scan = aobScanEx(Start, End, AoB)
   if Scan == nil or Scan.Count ~= 1 then
      print("'ConsumeSurvivalTick' AoB not found or not unique:")
      print(AoB)
   else
      registerSymbol("ConsumeSurvivalTickAddress_AoB", Scan[0] .. "", true)
   end
   AoB,Start,End,Scan,addr = 0,0,0,0,0
--]]
--[[]]
--[[
   AoB   = "E8 ?? ?? ?? ?? 48 8D ?? ?? ?? ?? ?? 48 8D ?? ?? ?? E8"
   Start = "ConsumeSurvivalTickAddress_AoB"
   End   = "ConsumeSurvivalTickAddress_AoB+80"
   Scan = aobScanEx(Start, End, AoB)
   if Scan == nil or Scan.Count ~= 1 then
      print("'ConsumeSurvivalTickAddress_AoB' not found or not unique:")
      print(AoB)
   else
      registerSymbol("SetFoodAddressCall_AoB", Scan[0] .. "", true)
      addr = getAddress("SetFoodAddressCall_AoB")
      addr = addr + readInteger(addr + 1) + 5
      registerSymbol("SetFoodAddress_AoB", addr, true)
   end
   AoB,Start,End,Scan,addr = 0,0,0,0,0
--]]
   if isUnityEngine == true then
      LaunchMonoDataCollector()
      sleep(100)
      if unityIL2CPPGame == true then
         sleep(1000)
         --DebugConsole_Ptr = getExStaticFieldAddress('DebugConsole', 'Instance', 'TheForest')
      else
         --writeUserSymbols('Game','isModded','isModded_Ptr')
         --writeUserSymbols('SROptions','_current','SROptions_Ptr')
      end
         --CameraManager_Ptr = getFValues('CameraManager', 'Current')
         --blockConsole_Offset = getClassOffsets('DebugConsole', '_blockConsole', 'TheForest')

         --writeUserSymbols('PlayerCharacterMasterController','_instances','instanceList_Ptr')

-- Class Offsets
         --ServerBindAddress_Offset                        = getClassOffsets('SROptions', '&lt;ServerBindAddress&gt;k__BackingField')
         --camMinDistance_Offset                        = getClassOffsets('GameCamera', 'm_minDistance')

-- Scripts
         --EpicCoinHackCheck_BackupBytes = readByte('EpicStoreController:CheckHack', 1, true)
         --writeByte('EpicStoreController:CheckHack', 0xC3)


   elseif isUnrealEngine == true then
   -- GameEngine
      if AoB_GameEngine ~= "-" then
         Scan = aobScanEx(Start, End, AoB_GameEngine)
         if Scan == nil or Scan.Count ~= 1 then
            print("'GameEngine' AoB not found or not unique:")
            print(AoB_GameEngine)
         else
            registerSymbol("GameEngine_AoB", Scan[0], true)
            addr = getAddress("GameEngine_AoB")
            addr = addr + readInteger(addr + 3) + 7
            unregisterSymbol("GameEngine_AoB")
            registerSymbol("GEngine", addr, true)
         end
      else
      end
   -- GUObjectArray
      if AoB_GUObjectArray ~= "-" then
         Scan = aobScanEx(Start, End, AoB_GUObjectArray)
         if Scan == nil then
            print("'GUObjectArray' AoB not found:")
            print(AoB_GUObjectArray)
         else
            registerSymbol("GUObjectArray_AoB", Scan[0], true)
            addr = getAddress("GUObjectArray_AoB")
            addr = addr + readInteger(addr + 3) + 7
            unregisterSymbol("GUObjectArray_AoB")
            registerSymbol("GUObjectArray", addr, true)
         end
      else
      end
   -- PhysicsSettings
      if AoB_PhysicsSettings ~= "-" then
         Scan = aobScanEx(Start, End, AoB_PhysicsSettings)
         if Scan == nil or Scan.Count ~= 1 then
            print("'PhysicsSettings' AoB not found or not unique:")
            print(AoB_PhysicsSettings)
         else
            registerSymbol("PhysicsSettings_AoB", Scan[0], true)
            addr = getAddress("PhysicsSettings_AoB+07") -- "+0A" = byte count from instruction beginning to line of static address (adjust as needed)
            addr = addr + readInteger(addr + 3) + 7
            unregisterSymbol("PhysicsSettings_AoB")
            registerSymbol("PhysicsSettingsClass_Ptr", addr, true)
         end
      else
      end
   -- Application
      if AoB_Application ~= "-" then
         Scan = aobScanEx(Start, End, AoB_Application)
         if Scan == nil or Scan.Count ~= 1 then
            print("'Application' AoB not found or not unique:")
            print(AoB_Application)
         else
            registerSymbol("Application_AoB", Scan[0], true)
            addr = getAddress("Application_AoB")
            addr = addr + readInteger(addr + 3) + 7
            unregisterSymbol("Application_AoB")
            registerSymbol("Application_Ptr", addr, true)
         end
      else
      end
      sleep(20)
   -- ClassMapping
      AddToFunctionLoop("ClassMapping",function()
      -- Constantly Register UE Classes
         registerSymbol("PhysicsSettings_Ptr", '[PhysicsSettingsClass_Ptr]+PhysicsSettingsClass_Offset', true); -- Unreflected, trace back from "WorldGravityZ"

         registerSymbol("GameViewportClient_Ptr", '[GEngine]+GameViewportClient_Offset', true); -- Engine:GameViewport

         registerSymbol("GameInstance_Ptr", '[GEngine]+GameInstance_Offset', true); -- GameEngine:GameInstance

         registerSymbol("LocalPlayer_Ptr", '[[GameInstance_Ptr]+LocalPlayers_Offset]+0', true); -- GameInstance:LocalPlayers

         registerSymbol("PlayerController_Ptr", '[LocalPlayer_Ptr]+PlayerController_Offset', true); -- Player:PlayerController

         registerSymbol("PlayerState_Ptr", '[PlayerController_Ptr]+PlayerState_Offset', true); -- Controller:PlayerState
         registerSymbol("Pawn_Ptr", '[PlayerController_Ptr]+Pawn_Offset', true); -- Controller:Pawn
         registerSymbol("HUD_Ptr", '[PlayerController_Ptr]+MyHUD_Offset', true); -- PlayerController:MyHUD
         registerSymbol("PlayerCameraManager_Ptr", '[PlayerController_Ptr]+PlayerCameraManager_Offset', true); -- PlayerController:PlayerCameraManager
         registerSymbol("CheatManager_Ptr", '[PlayerController_Ptr]+CheatManager_Offset', true); -- PlayerController:CheatManager
         registerSymbol("PlayerInput_Ptr", '[PlayerController_Ptr]+PlayerInput_Offset', true); -- PlayerController:PlayerInput

         registerSymbol("World_Ptr", '[GameViewportClient_Ptr]+World_Offset', true); -- GameViewportClient:World

         registerSymbol("Level_Ptr", '[World_Ptr]+PersistentLevel_Offset', true); -- World:PersistentLevel
         registerSymbol("GameModeBase_Ptr", '[World_Ptr]+AuthorityGameMode_Offset', true); -- World:AuthorityGameMode
         registerSymbol("GameStateBase_Ptr", '[World_Ptr]+GameState_Offset', true); -- World:GameState
         registerSymbol("AISystemBase_Ptr", '[World_Ptr]+AISystem_Offset', true); -- World:AISystem

         registerSymbol("WorldSettings_Ptr", '[Level_Ptr]+WorldSettings_Offset', true); -- Level:WorldSettings

         registerSymbol("RootComponent_Ptr", '[Pawn_Ptr]+RootComponent_Offset', true); -- Actor:RootComponent
         registerSymbol("CharacterMovementComponent_Ptr", '[Pawn_Ptr]+CharacterMovement_Offset', true); -- Character:CharacterMovement

         registerSymbol("BehaviorTreeManager_Ptr", '[AISystemBase_Ptr]+BehaviorTreeManager_Offset', true); -- AISystem:BehaviorTreeManager

         registerSymbol("PlayerArray_Ptr", '[GameStateBase_Ptr]+PlayerArray_Offset', true); -- GameStateBase:PlayerArray (Array)
      end);
   else
   end
   -- Allocate Space for Teleport
      local CoordinatesSave = allocateMemory(1)
      registerSymbol("CoordinatesSave", CoordinatesSave)
      local TeleportToCoords = allocateMemory(1)
      registerSymbol("TeleportToCoords", TeleportToCoords)
   -- Activate separate script
      if executeOtherScript == true then
         toggleScript(OtherScriptsName)
      else
      end
else
   showMessage("This table is meant to be used with CE 7.5.\nPlease use the versions equal to it.") --Shows this message when CE version doesn't match
   local str,Address
   str=inputQuery('CE Download Page (Click "Cancel" to stick to your current version)', 'Link', 'https://www.cheatengine.org/downloads.php') --Shows link to CE download page when CE version doesn't match
   if str and str~='' then
      ShellExecute(str,Address)
   end
end

[DISABLE]
if syntaxcheck then return end

-- Activate separate script
if executeOtherScript == true then
   toggleScript(OtherScriptsName)
else
end

if isUnrealEngine == true then
   RemoveFromFunctionLoop("ClassMapping");
   unregisterSymbol("GEngine")
   unregisterSymbol("GUObjectArray")
   unregisterSymbol("PhysicsSettings_Ptr")
   unregisterSymbol("PhysicsSettingsClass_Ptr")
   unregisterSymbol("PhysicsSettings_Ptr")
   unregisterSymbol("GameViewportClient_Ptr");
   unregisterSymbol("GameInstance_Ptr");
   unregisterSymbol("LocalPlayer_Ptr");
   unregisterSymbol("PlayerController_Ptr");
   unregisterSymbol("PlayerState_Ptr");
   unregisterSymbol("Pawn_Ptr");
   unregisterSymbol("HUD_Ptr");
   unregisterSymbol("PlayerCameraManager_Ptr");
   unregisterSymbol("CheatManager_Ptr");
   unregisterSymbol("PlayerInput_Ptr");
   unregisterSymbol("World_Ptr");
   unregisterSymbol("Level_Ptr");
   unregisterSymbol("GameModeBase_Ptr");
   unregisterSymbol("GameStateBase_Ptr");
   unregisterSymbol("AISystemBase_Ptr");
   unregisterSymbol("WorldSettings_Ptr");
   unregisterSymbol("RootComponent_Ptr");
   unregisterSymbol("CharacterMovementComponent_Ptr");
   unregisterSymbol("BehaviorTreeManager_Ptr");
   unregisterSymbol("PlayerArray_Ptr");
else
end

deAlloc(getAddress("CoordinatesSave"))
deAlloc(getAddress("TeleportToCoords"))
unregisterSymbol("CoordinatesSave")
unregisterSymbol("CoordinatesSave")

toggleScript("Deactivation")
