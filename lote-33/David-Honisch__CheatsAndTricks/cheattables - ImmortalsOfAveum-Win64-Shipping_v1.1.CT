            <CheatEntry>
              <ID>1337158127</ID>
              <Description>"Teleport"</Description>
              <Options moHideChildren="1"/>
              <Color>FF596B</Color>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337158129</ID>
                  <Description>"Print Current Coordinates"</Description>
                  <Color>000080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$LUA}
[ENABLE]
if syntaxcheck then return end
Print("X " .. readDouble("[RootComponent_Ptr]+X_Offset"))
Print("Y " .. readDouble("[RootComponent_Ptr]+Y_Offset"))
Print("Z " .. readDouble("[RootComponent_Ptr]+Z_Offset"))
createTimer(10, function() memrec.Active = false end)
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337158151</ID>
                  <Description>"Teleport To"</Description>
                  <Color>000080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$LUA}
[ENABLE]
if syntaxcheck then return end
function toHex(str)
str = string.format("%X", str)
return str
end
if syntaxcheck then return end
local LocalPlayerBase = toHex(getAddressSafe('RootComponent_Ptr'))
local WorldBase       = toHex(getAddressSafe('TeleportToCoords'))
local buffer          = 200
writeBytes('CoordinatesSave+24', readBytes('[RootComponent_Ptr]+X_Offset',24))
if LocalPlayerBase ~= nil or WorldBase ~= nil then
   local adLocalPlayer_X = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+X_Offset'))
   local adLocalPlayer_Y = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+Y_Offset'))
   local adLocalPlayer_Z = toHex(getAddressSafe('[' .. LocalPlayerBase .. ']+Z_Offset'))

   if readString(WorldBase, 255, true) == '0' then
      local CameraBase = getAddressSafe('CameraCoordinates_Pointer')
      if CameraBase ~= nil then
         local adCamera_X = toHex(getAddressSafe('[' .. toHex(CameraBase) .. ']+90'))
         writeBytes(adLocalPlayer_X, readBytes(adCamera_X, 24))
      else
         showMessage("'CameraCoordinates_Pointer' Not Found")
      end
   end
   if readString(WorldBase, 255, true) == '1' then
      local MapMarker4Base = getAddressSafe('[[[Minimap_Ptr]+1A8]+10]+40')
      if MapMarker4Base ~= nil then
         toggleScript("Fly Mode")
         local adMapMarker4_X = toHex(getAddressSafe('[' .. toHex(MapMarker4Base) .. ']+X_Offset'))
         local adMapMarker4_Y = toHex(getAddressSafe('[' .. toHex(MapMarker4Base) .. ']+Y_Offset'))
         local adMapMarker4_Z = toHex(getAddressSafe('[' .. toHex(MapMarker4Base) .. ']+Z_Offset'))
         writeDouble(adLocalPlayer_X, readDouble(adMapMarker4_X))
         writeDouble(adLocalPlayer_Y, (readDouble(adMapMarker4_Y) + buffer))
         writeDouble(adLocalPlayer_Z, readDouble(adMapMarker4_Z))
      else
         showMessage("'Minimap_Ptr' Not Found")
      end
   end
   if readString(WorldBase, 255, true) == '2' then
      writeDouble(adLocalPlayer_X, -10816.1376321126)
      writeDouble(adLocalPlayer_Y, 146.521891483089)
      writeDouble(adLocalPlayer_Z, 171.314822066975)
   end
   if readString(WorldBase, 255, true) == '3' then
      writeDouble(adLocalPlayer_X, -10559.8951871348)
      writeDouble(adLocalPlayer_Y, 2911.02968712268)
      writeDouble(adLocalPlayer_Z, 604.174983024733)
   end
end
createTimer(100, function() memrec.Active = false end)
memrec.Color = scriptColorActivated
[DISABLE]
if syntaxcheck then return end
memrec.Color = scriptColorDeactivated
</AssemblerScript>
