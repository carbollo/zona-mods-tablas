                      <ID>1337158052</ID>
                      <Description>"call method"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
if syntaxcheck then return end
local addy = readPointer(getAddress('[PlayerManager_Ptr+localPlayerAgentInLevel_Offset]+Damage_Offset'))
local mtd = mono_findMethod('', 'Dam_PlayerDamageLocal', 'set_Air')
mono_invoke_method_dialog('', mtd, addy)
[ENABLE]
error()
[DISABLE]

</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337158053</ID>
                      <Description>"modify op codes"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$LUA}
--[[
  Game Executable   : FSD-Win64-Shipping.exe
  Author            : Akira Fudo
  Executable Version: 4.27.2.0
  Module Version    :
  Script Date       : 15/07/2023

89 81 F0 04 00 00 48 81
89 81 ? ? ? ? 48 81 C1 ? ? ? ? 89 44 ? ? E8 ? ? ? ? B0
89xxxxxxxxxx48xxxxxxxxxxxx89xxxxxxxxxxxxxxxxB0xxxxxxxxxxC332
--]]

[ENABLE]
if syntaxcheck then return end
-- aobScanRegionEx(Star, End, AoB)
-- aobScanEx(AoB)
local Scan_AoB = aobScanEx("89 81 F0 04 00 00 48 81")
if Scan_AoB.Count &gt; 0 and Scan_AoB ~= nil then
   registerSymbol("AoB_BoscoRevives", Scan_AoB[0], true)
   Backup_BoscoRevives = readBytes("AoB_BoscoRevives", 6, true)
   writeBytes("AoB_BoscoRevives", 0x90, 0x90, 0x90, 0x90, 0x90, 0x90)
end
memrec.Color = scriptColorActivated
[DISABLE]
if syntaxcheck then return end
writeBytes("AoB_BoscoRevives", Backup_BoscoRevives)
unregisterSymbol("AoB_BoscoRevives")
memrec.Color = scriptColorDeactivated

--[[
FSD-Win64-Shipping.exe+129E5BD: 48 8B 5C 24 30        - mov rbx,[rsp+30]
FSD-Win64-Shipping.exe+129E5C2: 48 83 C4 20           - add rsp,20
FSD-Win64-Shipping.exe+129E5C6: 5F                    - pop rdi
FSD-Win64-Shipping.exe+129E5C7: C3                    - ret
FSD-Win64-Shipping.exe+129E5C8: CC                    - int 3
FSD-Win64-Shipping.exe+129E5C9: CC                    - int 3
