        <CheatEntry>
          <ID>1337157534</ID>
          <Description>"Research"</Description>
          <Options moHideChildren="1"/>
          <Color>000000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
--[[
  Made by Leunsel
  If your wanna make use of it ask for his permission.
  ]]
[ENABLE]

-- Function to check if the board is full
function isBoardFull(checkboxes)
    for _, cb in pairs(checkboxes) do
        if cb.State == cbUnchecked then
            return false
        end
    end
    return true
end

-- Function to simulate AI move
function makeAIMove(checkboxes)
    local emptyCheckboxes = {}
    local playerCheckboxes = {}
    local aiCheckboxes = {}

    -- Categorize checkboxes based on their current state
    for i = 1, #checkboxes do
        local checkbox = checkboxes[i]
        if checkbox.State == cbUnchecked then
            table.insert(emptyCheckboxes, i)
        elseif checkbox.State == cbGrayed then
            table.insert(playerCheckboxes, i)
        elseif checkbox.State == cbChecked then
            table.insert(aiCheckboxes, i)
        end
    end

    local function evaluateMove(moveIndex, playerState)
        local originalState = checkboxes[moveIndex].State
        checkboxes[moveIndex].State = playerState
        local win = checkForWin(checkboxes, playerState)
        checkboxes[moveIndex].State = originalState
        return win
    end

    -- Check for AI win
    for _, index in ipairs(emptyCheckboxes) do
        if evaluateMove(index, cbChecked) then
            return index
        end
    end

    -- Check for player win and block
    for _, index in ipairs(emptyCheckboxes) do
        if evaluateMove(index, cbGrayed) then
            return index
        end
    end

    -- Check for immediate player win and block
    for _, index in ipairs(playerCheckboxes) do
        if evaluateMove(index, cbChecked) then
            return index
        end
    end

    -- If no immediate win/block move, choose a random move
    if #emptyCheckboxes &gt; 0 then
        math.randomseed(os.time())
        local randomIndex = math.random(1, #emptyCheckboxes)
        return emptyCheckboxes[randomIndex]
    end

    return -1 -- No available move (shouldn't reach here)
end


-- Function to check for win conditions
function checkForWin(checkboxes, playerState)
    -- Check rows
    for row = 1, 3 do
        local rowWin = true
        for col = 1, 3 do
            local index = (row - 1) * 3 + col
            if checkboxes[index].State ~= playerState then
                rowWin = false
                break
            end
        end
        if rowWin then
            return true
        end
    end

    -- Check columns
    for col = 1, 3 do
        local colWin = true
        for row = 1, 3 do
            local index = (row - 1) * 3 + col
            if checkboxes[index].State ~= playerState then
                colWin = false
                break
            end
        end
        if colWin then
            return true
        end
    end

    -- Check diagonals
    if (checkboxes[1].State == playerState and checkboxes[5].State == playerState and checkboxes[9].State == playerState) or
       (checkboxes[3].State == playerState and checkboxes[5].State == playerState and checkboxes[7].State == playerState) then
        return true
    end

    return false
end

-- Get the checkboxes
local checkboxes = {
    TicTacToe.CB1,
    TicTacToe.CB2,
    TicTacToe.CB3,
    TicTacToe.CB4,
    TicTacToe.CB5,
    TicTacToe.CB6,
    TicTacToe.CB7,
    TicTacToe.CB8,
    TicTacToe.CB9
}

-- Function to update scores
function updateScores(type)
    if type == 1 then
        TicTacToe.PlayerScore.Text = tonumber(TicTacToe.PlayerScore.Text) + 1
    elseif type == 2 then
        TicTacToe.AIScore.Text = tonumber(TicTacToe.AIScore.Text) + 1
    elseif type == 3 then
        TicTacToe.DrawCount.Text = tonumber(TicTacToe.DrawCount.Text) + 1
    end
end

-- Function to reset the game board
function resetBoard(checkboxes)
    for _, checkbox in ipairs(checkboxes) do
        checkbox.State = cbUnchecked
        checkbox.Enabled = true
    end
end

function Checkbox_OnClick(sender)
    if not sender.Checked then
        -- Player's move
        sender.State = cbGrayed
        sender.Enabled = false -- Disable the checkbox

        -- Check for player win
        if checkForWin(checkboxes, cbGrayed) then
            showMessage("Player wins!")
            updateScores(1)
            TicTacToe.WinStreak.Text = tonumber(TicTacToe.WinStreak.Text) + 1
            resetBoard(checkboxes)
            return
        end

        -- Check for draw
        if isBoardFull(checkboxes) then
            showMessage("It's a draw!")
            updateScores(3)
            resetBoard(checkboxes)
            return
        end

        -- Simulate AI move if the board is not full
        local emptyCount = 0
        for _, cb in pairs(checkboxes) do
            if cb.State == cbUnchecked then
                emptyCount = emptyCount + 1
            end
        end

        if emptyCount &gt; 0 then
            local aiMoveIndex = makeAIMove(checkboxes)
            if aiMoveIndex ~= -1 then
                checkboxes[aiMoveIndex].State = cbChecked
                checkboxes[aiMoveIndex].Enabled = false -- Disable the AI checkbox

                -- Check for AI win
                if checkForWin(checkboxes, cbChecked) then
                    showMessage("AI wins!")
                    TicTacToe.WinStreak.Text = tonumber(0)
                    updateScores(2)
                    resetBoard(checkboxes)
                    return
                end

                -- Check for draw after AI move
                if isBoardFull(checkboxes) then
                    showMessage("It's a draw!")
                    updateScores(3)
                    resetBoard(checkboxes)
                    return
                end
            end
        end
    end
end

-- Function to reset the game board and scores
function resetGame()
    resetBoard(checkboxes)
    TicTacToe.PlayerScore.Text = "0"
    TicTacToe.AIScore.Text = "0"
    TicTacToe.DrawCount.Text = "0"
    TicTacToe.WinStreak.Text = "0"
end

-- Function to reset the game scores
function resetScore()
    TicTacToe.PlayerScore.Text = "0"
    TicTacToe.AIScore.Text = "0"
    TicTacToe.DrawCount.Text = "0"
    TicTacToe.WinStreak.Text = "0"
end

-- Attach Checkbox_OnClick to checkbox click event
for _, checkbox in pairs(checkboxes) do
    checkbox.OnClick = Checkbox_OnClick
end

TicTacToe.ResetGame.OnClick = resetGame
TicTacToe.ResetScore.OnClick = resetScore

TicTacToe.Show()
resetBoard(checkboxes)

[DISABLE]

TicTacToe.Hide()
</AssemblerScript>
