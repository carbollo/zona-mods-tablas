-- aobScanEx
-- thanks panraven for this function (https://forum.cheatengine.org/viewtopic.php?t=577536)
-- adjusted by SunBeam &amp; Akira Fudo &amp; LeFiXER
function aobScanEx(start_address, end_address, aob, p, s, e)
   if start_address == 0 or
      start_address == nil or
      start_address == '' or
      end_address == 0 or
      end_address == nil or
      end_address == '' then
      local p, a, n, s, e = p and '*X*W' or '+X', nil or fsmNotAligned, nil or '0', s and s or getAddress( process ), e and e or ( getAddress( process ) + getModuleSize( process ) )
      local ms = pb and createMemScan( pb ) or createMemScan()
      local fl = createFoundList( ms )
      ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
      ms.waitTillDone()
      fl.initialize()
      local result = nil
      if fl ~= nil and fl.getCount() &gt; 0 then
         result = createStringlist()
         for i = 1, fl.getCount() do result.add( fl.getAddress( i - 1 ) ) end
      end
      fl.destroy()
      ms.destroy()
      return result
   else
      local protections = nil or '*X*W*C' --'+X*W*C'
      local alignmenttype = nil or fsmNotAligned
      local alignmentparam = nil or '0'
      local start = getAddressSafe(start_address) or 0x0
      local finish = getAddressSafe(end_address) or 0xffffffffffffffff
      local isHexInput = true
      local isNotBinaryString = false
      local isUnicodeScan = false
      local isCaseSensitive = false

      --local memscan = createMememscancan()
      local memscan = createMemScan()
      local foundlist = createFoundList(memscan)
      memscan.firstScan(soExactValue, vtByteArray, nil, aob, nil, start, finish, protections, alignmenttype, alignmentparam, isHexInput, isNotBinaryString, isUnicodeScan, isCaseSensitive)
      memscan.waitTillDone()
      foundlist.Initialize()
      local result = nil
      if foundlist ~= nil and foundlist.getCount() &gt; 0 then
         result = createStringlist()
         for i = 1, foundlist.getCount() do
             result.add(foundlist.getAddress(i - 1))
         end
      end
      foundlist.destroy()
      memscan.destroy()
      return result
   end
end
--[[
-- aobScanRegionEx
function aobScanRegionEx(start_address, end_address, aob)
   local protections = nil or '*X*W*C' --'+X*W*C'
   local alignmenttype = nil or fsmNotAligned
   local alignmentparam = nil or '0'
   local start = getAddressSafe(start_address) or 0x0
   local finish = getAddressSafe(end_address) or 0xffffffffffffffff
   local isHexInput = true
   local isNotBinaryString = false
   local isUnicodeScan = false
   local isCaseSensitive = false

   --local memscan = createMememscancan()
   local memscan = createMemScan()
   local foundlist = createFoundList(memscan)
   memscan.firstScan(soExactValue, vtByteArray, nil, aob, nil, start, finish, protections, alignmenttype, alignmentparam, isHexInput, isNotBinaryString, isUnicodeScan, isCaseSensitive)
   memscan.waitTillDone()
   foundlist.Initialize()
   local result = nil
   if foundlist ~= nil and foundlist.getCount() &gt; 0 then
      result = createStringlist()
      for i = 1, foundlist.getCount() do
          result.add(foundlist.getAddress(i - 1))
      end
   end
   foundlist.destroy()
   memscan.destroy()
   return result
end
--]]

-- Function to hide all pages except the disclaimer page
local function hideAllPagesExceptDisclaimer()
  -- Hide the disclaimer page
  CheatForm.DisclaimerControl.Visible = true

  -- Show all other pages
  CheatForm.TabControl.Visible = false
end

-- Function to handle the acceptance of the disclaimer
function acceptDisclaimer()
   -- print("Executed!")
   -- Hide the disclaimer page
   CheatForm.DisclaimerControl.Visible = false

   -- Show all other pages
   CheatForm.TabControl.Visible = true
   updateColorPreview()
--[[
   if CheatForm.Color ~= 0x000000 then
      CheatForm.TableSettings.Color  = 0xD0D0D0
      CheatForm.CELabel6.Font.Color  = 0x000000
      CheatForm.CELabel8.Font.Color  = 0x000000
      CheatForm.CELabel9.Font.Color  = 0x000000
      CheatForm.CELabel10.Font.Color = 0x000000
      CheatForm.CELabel11.Font.Color = 0x000000
      CheatForm.CELabel14.Font.Color = 0x000000
   else
      CheatForm.TableSettings.Color  = 0x000000
      CheatForm.CELabel6.Font.Color  = 0xFFFFFF
      CheatForm.CELabel8.Font.Color  = 0xFFFFFF
      CheatForm.CELabel9.Font.Color  = 0xFFFFFF
      CheatForm.CELabel10.Font.Color = 0xFFFFFF
      CheatForm.CELabel11.Font.Color = 0xFFFFFF
      CheatForm.CELabel14.Font.Color = 0xFFFFFF
   end
--]]
end

-- Function to handle the exit action
function exitApplication()
  -- Close the form
  closeCE()
end

-- Convert decimal value to hexadecimal
function decimalToHex(decimalValue)
  return string.format("%02X", decimalValue)
end

-- Define the file path for storing the color values
local filePath = "~CTColor.log"

-- Enumerate the UI elements and their corresponding indices
local UIElements = {
  ["..."] = 0,
  ["..."] = 1
}

-- Method to save color values to a text file
function saveColorValues(elementIndex, red, green, blue)

  -- Check if the file exists
  local file = io.open(filePath, "r+")
  if not file then
    -- If the file doesn't exist, create it and open in "a+" mode
    file = io.open(filePath, "a+")
    file:close()
    file = io.open(filePath, "r+")
  end

  if file then
    local contents = file:read("*all")
    file:seek("set")

    local colorString = tostring(elementIndex) .. "&lt;" .. CheatForm.ComboboxSelection.Text .. "=" .. tostring(red) .. "," .. tostring(green) .. "," .. tostring(blue) .. "&gt;"
    local newLine = colorString .. "\n"

    local overwrite = false
    local updatedContents = ""

    for line in contents:gmatch("[^\r\n]+") do
      local index, value = line:match("(%d+)&lt;(.-)&gt;")
      if index and value then
        index = tonumber(index)
        if index == elementIndex then
          if value ~= colorString then
            line = newLine
            overwrite = true
          end
        end
      end
      updatedContents = updatedContents .. line .. "\n"
    end

    if not overwrite then
      updatedContents = updatedContents .. newLine
    end

    file:write(updatedContents)
    file:close()
  end
end


-- Method to load color values from a text file
function loadColorValues()
  local colorValues = {}
  local file = io.open(filePath, "r")
  if file then
    for line in file:lines() do
      local index, value = line:match("(%d+)&lt;(.-)&gt;")
      if index and value then
        index = tonumber(index)
        local r, g, b = value:match("(%d+),(%d+),(%d+)")
        if r and g and b then
          r = tonumber(r)
          g = tonumber(g)
          b = tonumber(b)
          colorValues[index] = { r, g, b }
        end
      end
    end
    file:close()
  end
  return colorValues
end

-- Method to apply color values to the corresponding UI elements
function applyColorValues(colorValues)
  for index, color in pairs(colorValues) do

    CheatForm.ComboboxSelection.ItemIndex = index

    if index == 0 then
      local rgbColor = color[3] * 65536 + color[2] * 256 + color[1]
      local hexColor = string.format("%08X", rgbColor)
      getAddressList().Control[0].BackgroundColor = tonumber(hexColor, 16)
      -- Apply color values to Addresslist checkboxes
      -- Example code to set the Addresslist checkbox color:
      -- myAddresslist.CheckBoxColor = { color[1], color[2], color[3] }
      -- print("Loaded Values For: " .. CheatForm.ComboboxSelection.Text .. " ()-&gt; R=" .. color[1] .. ", G=" .. color[2] .. ", B=" .. color[3])
    else
    -- print("[" .. index .. "] No Values Loaded!")
    end
  end
end

-- Function to load and apply color values when the button is clicked
function loadColorState()
  local colorValues = loadColorValues()
  applyColorValues(colorValues)
end

-- Colors:FullHexValue
function CheatForm_FullHexValueEditingDone(sender)
--[[
   local function separateLuaChannel(colour, hex)
            if colour == nil or colour == '' then return end
            local c = colour
            -- remove 0x for now
            local tmp = c:gsub('0x', '')
            -- Get the last 2 characters because Lua cs are backwards
            local r = tmp:sub(-2,#c)
            -- Get the middle 2 characters
            local g = tmp:sub(3,4)
            -- And finally, get the first two
            local b = tmp:sub(1,2)
            if hex then
               return b,g,r
            else
               return tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)
            end
         end
-]]
   local function separateLuaChannel(colour, hex)
            if colour == nil or colour == '' then return end
            local c = colour
            -- remove 0x for now
            local tmp = c:gsub('0x00', '')
            -- Get the last 2 characters because Lua cs are backwards
            local r = tmp:sub(-2,#c)
            -- Get the middle 2 characters
            local g = tmp:sub(3,4)
            -- And finally, get the first two
            local b = tmp:sub(1,2)
            if hex then
               return b,g,r
            else
               return tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)
            end
         end

   local myR,myG,myB = separateLuaChannel(CheatForm.FullHexValue.Text, false)

   CheatForm.RedValue.Text       = myR
   CheatForm.GreenValue.Text     = myG
   CheatForm.BlueValue.Text      = myB

   CheatForm.ColorRed.Position   = myR
   CheatForm.ColorGreen.Position = myG
   CheatForm.ColorBlue.Position  = myB


   updateColorPreview()
end

-- Update color preview and hex result
function updateColorPreview()
  local currentRed   = CheatForm.ColorRed.Position
  local currentGreen = CheatForm.ColorGreen.Position
  local currentBlue  = CheatForm.ColorBlue.Position
  local currentAlpha = CheatForm.ColorAlpha.Position

  local mappedAlpha = math.floor((currentAlpha / 127) * 255)
  local abgrColor   = mappedAlpha * 256 * 256 * 256 + currentRed + currentGreen * 256 + currentBlue * 256 * 256

  CheatForm.ColorPreviewPanel.Color = abgrColor
  CheatForm.HexResult.Caption       = string.format("0x%08X", abgrColor)
  CheatForm.FullHexValue.Text       = string.format("0x%08X", abgrColor)
end

-- Handle editing done events for RGB and alpha values
function handleEditingDone(sender)
  local currentValue = tonumber(sender.Text)
  if currentValue then
    if sender.Name == 'RedValue' then
      CheatForm.ColorRed.Position = currentValue
    elseif sender.Name == 'GreenValue' then
      CheatForm.ColorGreen.Position = currentValue
    elseif sender.Name == 'BlueValue' then
      CheatForm.ColorBlue.Position = currentValue
    elseif sender.Name == 'AlphaValue' then
      CheatForm.ColorAlpha.Position = currentValue
    end

    updateColorPreview()
  end
end

-- Handle value changed events for RGB and alpha sliders
function handleValueChanged(sender)
  local currentValue = math.floor(sender.Position)
  if sender.Name == 'ColorRed' then
    CheatForm.RedValue.Text = tostring(currentValue)
  elseif sender.Name == 'ColorGreen' then
    CheatForm.GreenValue.Text = tostring(currentValue)
  elseif sender.Name == 'ColorBlue' then
    CheatForm.BlueValue.Text = tostring(currentValue)
  elseif sender.Name == 'ColorAlpha' then
    CheatForm.AlphaValue.Text = tostring(currentValue)
  end

  updateColorPreview()
end

-- Copy label text to clipboard
function copyLabelTextToClipboard(sender)
  writeToClipboard(sender.Caption)
end

-- Assign button logic
function assignButtonLogic()
  local currentRed = CheatForm.ColorRed.Position
  local currentGreen = CheatForm.ColorGreen.Position
  local currentBlue = CheatForm.ColorBlue.Position
  local currentAlpha = CheatForm.ColorAlpha.Position

  local abgrColor = currentRed + currentGreen * 256 + currentBlue * 256 * 256
  local updatedColor = (abgrColor &amp; 0x00FFFFFF) | ((currentAlpha &amp; 0x7F) &lt;&lt; 24)

  local colorSelectIndex = CheatForm.ComboboxSelection.ItemIndex
  if colorSelectIndex == 0 then
     getAddressList().Control[0].BackgroundColor = updatedColor
  elseif colorSelectIndex == 1 then
     AddressList.CheckboxColor                   = updatedColor
  elseif colorSelectIndex == 2 then
     getMainForm().Foundlist3.Color              = updatedColor
  elseif colorSelectIndex == 3 then
     getMainForm().color                         = updatedColor
  else
  end

  saveColorValues(CheatForm.ComboboxSelection.ItemIndex, currentRed, currentGreen, currentBlue)
end

-- Initialize form and hook up event handlers
function initForm()
   hideAllPagesExceptDisclaimer()
   initGameInfo()
   initTableInfo()
   initSupportInfo()
   initConsoleInfo()

  -- Sliders
   CheatForm.ColorRed.OnChange = handleValueChanged
   CheatForm.ColorGreen.OnChange = handleValueChanged
   CheatForm.ColorBlue.OnChange = handleValueChanged
   CheatForm.ColorAlpha.OnChange = handleValueChanged

   -- Textboxes
   CheatForm.RedValue.OnEditingDone = handleEditingDone
   CheatForm.GreenValue.OnEditingDone = handleEditingDone
   CheatForm.BlueValue.OnEditingDone = handleEditingDone
   CheatForm.AlphaValue.OnEditingDone = handleEditingDone

   -- Preview Label
   CheatForm.HexResult.OnClick = copyLabelTextToClipboard

   -- Assign Button
   CheatForm.CEButton11.OnClick = assignButtonLogic

   initGameInfo()
   initTableInfo()
   initSupportInfo()
   initConsoleInfo()


   getAddressList().Control[0].BackgroundColor = CEColor2
end

-- Call the initForm function to set up the event handlers
initForm()

-- Debug:Dark Mode
CheatForm.DarkModeToggleButton.OnClick = 'CheatForm_DarkModeToggleButtonClick'
function CheatForm_DarkModeToggleButtonClick(sender)
   if GetAddressList().Control[0].BackgroundColor == CEColor2 then
      getMainForm().color                         = darkModeColor0
      getMainForm().Foundlist3.Color              = darkModeColor1
      GetAddressList().Control[0].BackgroundColor = darkModeColor2
      AddressList.CheckboxColor                   = darkModeColor3
      CheatForm.Color                             = darkModeColor4
      CheatForm.TableSettings.Color               = 0x000000
      CheatForm.CELabel6.Font.Color               = 0xFFFFFF
      CheatForm.CELabel8.Font.Color               = 0xFFFFFF
      CheatForm.CELabel9.Font.Color               = 0xFFFFFF
      CheatForm.CELabel10.Font.Color              = 0xFFFFFF
      CheatForm.CELabel11.Font.Color              = 0xFFFFFF
      CheatForm.CELabel14.Font.Color              = 0xFFFFFF
   else
      getMainForm().color                         = CEColor0
      getMainForm().Foundlist3.Color              = CEColor1
      GetAddressList().Control[0].BackgroundColor = CEColor2
      AddressList.CheckboxColor                   = CEColor3
      CheatForm.Color                             = CEColor4
      sleep(10)
      if CheatForm.Color ~= 0x000000 then
         CheatForm.TableSettings.Color            = 0xD0D0D0
         CheatForm.CELabel6.Font.Color            = 0x000000
         CheatForm.CELabel8.Font.Color            = 0x000000
         CheatForm.CELabel9.Font.Color            = 0x000000
         CheatForm.CELabel10.Font.Color           = 0x000000
         CheatForm.CELabel11.Font.Color           = 0x000000
         CheatForm.CELabel14.Font.Color           = 0x000000
      else
      end
   end
end

