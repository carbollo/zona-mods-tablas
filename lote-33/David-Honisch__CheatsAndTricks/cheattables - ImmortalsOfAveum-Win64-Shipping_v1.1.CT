                      <Description>"Change Gravity Scale [script example to change a value + pointer to change it on the fly]"</Description>
                      <Options moHideChildren="1"/>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : LF-Win64-Shipping.exe
  Version:
  Date   : 2021-06-10
  Author : Akira Fudo

  F3 0F 59 83 50 01 00 00 48
  F3 0F ? ? ? ? ? ? 48 83 C4 ? 5B C3 CC CC CC CC 8B 81
  F3xxxxxxxxxxxxxx48xxxxxxxxC3xxCCxxCCxxxxxxxxxxxxC3xxCCxxCCxxCCxxCCxx8BxxxxxxxxxxC3xxCC
}

[ENABLE]

aobscanmodule(GravityScale,DarkAlliance-Win64-Shipping.exe,F3 0F 59 83 50 01 00 00 48)
alloc(newmem,$1000,GravityScale)
alloc(restore_GravityScale,8)

label(code)
label(return)
label(Gravity)

newmem:
  mov [restore_GravityScale],rbx

code:
  push rcx
  mov rcx,[Gravity]
  mov [rbx+00000150],rcx
  mulss xmm0,[rbx+00000150]
  pop rcx
  jmp return

Gravity:
  dq (float)0

GravityScale:
  jmp newmem
  nop 3
return:
registersymbol(GravityScale)
registersymbol(restore_GravityScale)
registersymbol(Gravity)

[DISABLE]
{$lua}
  writeFloat('[restore_GravityScale]+150',1.850000024)
{$asm}
unregistersymbol(restore_GravityScale)
dealloc(restore_GravityScale,8)

GravityScale:
  db F3 0F 59 83 50 01 00 00

unregistersymbol(GravityScale)
unregistersymbol(Gravity)
dealloc(newmem)

