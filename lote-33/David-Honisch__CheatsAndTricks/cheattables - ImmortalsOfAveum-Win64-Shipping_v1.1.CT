sleep(50)
local LocalPlayerCoords   = getAddressSafe('[RootComponent_Ptr]')
local CoordinatesSaveBase = getAddressSafe('CoordinatesSave')
if LocalPlayerCoords ~= nil and CoordinatesSaveBase ~= nil then
   if readQword(CoordinatesSaveBase) ~= 0 then
      writeBytes('[RootComponent_Ptr]+X_Offset', readBytes('CoordinatesSave+24',24))
   else
      showMessage("No Saved Coordinates were found!")
      --speakEnglish("Warning, no saved coordinates were found!",true)
   end
else
   showMessage("'[RootComponent_Ptr]' or 'CoordinatesSave' wasn't found!")
end
