function getDir(path)
  local local_path = path
  if local_path == nil then return end
  for dir in local_path:gmatch('(.-)([^\\]-([^%.]+))$') do
      return dir
  end
end
local ProcessPath             = getDir(ProcessExe) .. '' --Path to process executable + sub folder(s)

function extractString(inputString, keyword)
  local startIndex, endIndex = string.find(inputString, keyword)
  if startIndex then
    return string.sub(inputString, 1, startIndex - 1)
  else
    return nil
  end
end
