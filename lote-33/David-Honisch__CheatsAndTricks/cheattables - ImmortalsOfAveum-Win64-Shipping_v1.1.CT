-- Function to initialize game information
function initGameInfo()
   -- Load and set the game information
   CheatForm.GameName.Text        = GameName
   CheatForm.GameProcess.Text     = GameProcess0
   CheatForm.GameVersion.Text     = GameVersion
   CheatForm.GameEngine.Text      = GameEngine
   CheatForm.GameModule.Text      = GameModule
   CheatForm.AntiCheat.Text       = AntiCheat
   CheatForm.Platform.Text        = Platform
   CheatForm.AppID.Text           = AppID
   CheatForm.ProcessFolder.Text   = ProcessExe
   CheatForm.SavegameFolder.Text  = SavegamePath
   -- Cheat Table Colors
   CheatForm.CEPanel8.Color       = scriptColorActivated
   CheatForm.CELabel14.Font.Color = scriptColorActivated
   CheatForm.CEPanel7.Color       = scriptColorDeactivated
   CheatForm.CELabel11.Font.Color = scriptColorDeactivated
   CheatForm.CEPanel2.Color       = colorMainHeader
   CheatForm.CELabel6.Font.Color  = colorMainHeader
   CheatForm.CEPanel5.Color       = colorPointerHeader
   CheatForm.CELabel9.Font.Color  = colorPointerHeader
   CheatForm.CEPanel4.Color       = colorPointer
   CheatForm.CELabel8.Font.Color  = colorPointer
   CheatForm.CEPanel6.Color       = colorWarningInfo
   CheatForm.CELabel10.Font.Color = colorWarningInfo
end


-- Function to initialize table information
function initTableInfo()
   -- Load and set the table information
   if FormImagePath0 ~= "-" then
      CheatForm.CEImage1.Picture.LoadFromStream(createStringStream(getInternet().getURL(FormImagePath0)))
   end
   if FormImagePath1 ~= "-" then
      CheatForm.Icon.LoadFromStream(createStringStream(getInternet().getURL(FormImagePath1)))
   end
   CheatForm.Font.Color = FormTextColor
   CheatForm.CETreeview1.ExpandSignColor = CheatForm.Font.Color
   CheatForm.CETreeview2.ExpandSignColor = CheatForm.Font.Color
   CheatForm.Console_CETreeview.ExpandSignColor = CheatForm.Font.Color
   CheatForm.Disclaimer_CETreeview1.ExpandSignColor = CheatForm.Font.Color
   CheatForm.Slogan.Font.Color = CheatForm.Font.Color
   CheatForm.RedValue.Font.Color = CheatForm.Font.Color
   CheatForm.GreenValue.Font.Color = CheatForm.Font.Color
   CheatForm.BlueValue.Font.Color = CheatForm.Font.Color

   CheatForm.Slogan.Caption       = FormSloganText
   CheatForm.Caption              = FormCaptionText

   CheatForm.Author.Text          = TableAuthor
   CheatForm.CEVersion.Text       = CEVersion
   CheatForm.TableVersion.Text    = TableVersion
   CheatForm.FearlessPost.Text    = FearlessLink
   if isUnityEngine == true then
      CheatForm.RequireMono.Text  = 'True'
   else
      CheatForm.RequireMono.Text  = 'False'
   end
end

function initSupportInfo()
   CheatForm.CEEdit1.Text         = DiscordLink
   CheatForm.CEEdit2.Text         = PatreonLink
   CheatForm.CEEdit3.Text         = KoFiLink
   CheatForm.CEEdit4.Text         = PayPalLink
end

function initConsoleInfo()
   if isUnrealEngine == true then
      CheatForm.ConsoleTab.TabVisible = true
      CheatForm.CEEdit5.Text         = Console_UUU
      CheatForm.CEEdit6.Text         = Console_UE4SS
      CheatForm.CEEdit7.Text         = Console_SunBeam .. ' | ' .. Console_cfemen
      CheatForm.CEEdit8.Text         = ConsoleCommandListLink
   else
      CheatForm.ConsoleTab.TabVisible = false
   end
end

--Custom Popup Message Function (LeFiXER)
function openLink(link)
  if type(link) == "string" and link ~= nil then
     return shellExecute(link)
  else
     return nil
  end
end

function mShowMessage(title, texttoshow, withbutton, link)
  local myform = createForm(false)
 myform.Caption = title
 myform.autosize = true
 myform.BorderStyle = 'bsDialog'
 myform.Position = 'poScreenCenter'
 myform.Color = GetAddressList().Control[0].BackgroundColor --0x000000

 local font = createFont(myform)
 font.Name = 'Consolas'
 font.Height = -12
 font.Size = 12
 font.CharSet = 'ANSI_CHARSET'
 font.pitch = 'fpFixed'
 font.Quality = 'fqDraft'
 font.Color = AddressList.CheckboxColor --0x0000FF

 local mylabel = createLabel(myform)
 mylabel.Caption = texttoshow
 mylabel.OptimalFill = true
 mylabel.font = font
 mylabel.Align = 'alClient'
 mylabel.left = (myform.width - mylabel.width) / 2
 mylabel.BorderSpacing.Around = 25


 if withbutton then
   local mybtn = createButton(myform)
   mybtn.height = 30
   mybtn.left = (myform.width - mybtn.width) / 2
   mybtn.top = myform.height - mybtn.height
   mybtn.Align = 'alBottom'
   mybtn.BorderSpacing.Around = 25
   mybtn.Caption = 'Okay' --Button Name
   mybtn.OnClick = function()
                     if link == nil or link == '' then
                        myform.hide()
                        return
                     else
                        openLink(link)
                        myform.hide()
                     end
                   end
 end
 myform.show()
end



-- TOGGLE AN ENTRY IN A TABLE (LeFiXER)
function getMemRec(s, id)
   local s,id = AddressList.MemoryRecord[tostring(s)], AddressList.MemoryRecord[tonumber(id)]
   if s ~= nil or id ~= nil then
      return s
   else
      error(showMessage("Couldn't find the script :("))
   end
end

function toggleScript(scr, id)
   local x = getMemRec(scr, nil) or getMemRec(nil, id)
   if x ~= nil then
      x.Active = not x.Active
      if x.Active == true then
           -- Set the enabled colour here, this is a medium-green
         x.Color = scriptColorActivated
      else
           -- Set the disabled colour here, this is a medium-red
         x.Color = scriptColorDeactivated
      end
   end
end



-- dr NHA's Loop Code
--Array Of Functions
FunctionArray={};
registerLuaFunctionHighlight("FunctionArray");

--Names Of Functions
FunctionNamesArray={};
registerLuaFunctionHighlight("FunctionNamesArray");

--Add A Function To The Looper
function AddToFunctionLoop(name,func)
FunctionNamesArray[#FunctionNamesArray+1]=name;
FunctionArray[#FunctionArray+1]=func;
end
registerLuaFunctionHighlight("AddToFunctionLoop");

--Remove A Function From The Looper
function RemoveFromFunctionLoop(name)
local INDEX=-1;
for ind=0,#FunctionNamesArray,1 do
if FunctionNamesArray[ind]~=nil then
if FunctionNamesArray[ind]==name then
INDEX=ind;
break;
end
end
end
if INDEX~=-1 then
FunctionArray[INDEX]=nil;
FunctionNamesArray[INDEX]=nil;
end
end
registerLuaFunctionHighlight("RemoveFromFunctionLoop");

--Create The Looper Thread
function CreateFunctionLoop()
if FunctionLoop~=nil then
FunctionLoop.suspend();
FunctionLoop.terminate();
FunctionLoop=nil;
end
FunctionLoop=createThread(function()
while (1) do
--DO FUNCTIONS
if #FunctionArray&gt;0 then
for ind=0,#FunctionArray,1 do
if  FunctionArray[ind]~=nil then
 FunctionArray[ind]();
 end
end
end
sleep(FunctionLoopSpeed);
end
end);
FunctionLoop.Name="Main_FunctionLoop";
end
registerLuaFunctionHighlight("CreateFunctionLoop");
registerLuaFunctionHighlight("FunctionLoop");

FunctionLoopSpeed=50;
registerLuaFunctionHighlight("FunctionLoopSpeed");

CreateFunctionLoop();



