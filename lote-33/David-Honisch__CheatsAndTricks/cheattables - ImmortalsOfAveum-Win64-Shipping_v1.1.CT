            <CheatEntry>
              <ID>1337158125</ID>
              <Description>"Info"</Description>
              <Color>000080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$LUA}
[ENABLE]
if syntaxcheck then return end
local DebugModeKeys = [[
0) Console Unlocked (F5)
1) Cheats Unlocked
2) DLC Unlocked
]]
mShowMessage('Note', DebugModeKeys, true, 0)
local str,Address
str=inputQuery('Console Command List', 'Link', 'https://docs.google.com/spreadsheets/d/1JhOM1un_tNSIPgyaCWKgZWY_101693k-DhIgtgQQh_g/edit?usp=sharing')
if str and str~='' then
  ShellExecute(str,Address)
end
createTimer(100, function() memrec.Active = false end)
memrec.Color = scriptColorActivated
[DISABLE]
if syntaxcheck then return end
memrec.Color = scriptColorDeactivated
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337149388</ID>
              <Description>"Ghost Mode"</Description>
              <Color>000080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$LUA}
-- print(readFloat(getAddress('[RootComponent_Ptr]+Z_Offset')))
-- print(readByte(getAddress('[Pawn_Ptr]+bActorEnableCollision_Offset')))
[ENABLE]
if syntaxcheck then return end
local msg = [[
Space = Up
C     = Down
]]
mShowMessage('Hotkeys', msg, true, 0)
--[[
function UpControl(sender)
   writeFloat('[RootComponent_Ptr]+Z_Offset', readFloat(('[RootComponent_Ptr]+Z_Offset')) + 50.0)
end
function DownControl(sender)
   writeFloat('[RootComponent_Ptr]+Z_Offset', readFloat(('[RootComponent_Ptr]+Z_Offset')) - 50.0)
end
--]]
-- https://learn.microsoft.com/de-de/windows/win32/inputdev/virtual-key-codes

AddToFunctionLoop("GhostMode",function()
   local CheatFlag = getAddressSafe('[Pawn_Ptr]+bActorEnableCollision_Offset');
   if CheatFlag ~= nil then
      writeByte('[CharacterMovementComponent_Ptr]+MovementMode_Offset', 5)
      writeByte('[CharacterMovementComponent_Ptr]+MovementMode_Offset', 6)
      writeByte('[CharacterMovementComponent_Ptr]+MovementMode_Offset+1', 1)
      if isKeyPressed(VK_SPACE) then
         writeDouble('[RootComponent_Ptr]+Z_Offset', readDouble(('[RootComponent_Ptr]+Z_Offset')) + 5.0)
      elseif isKeyPressed(VK_C) then
         writeDouble('[RootComponent_Ptr]+Z_Offset', readDouble(('[RootComponent_Ptr]+Z_Offset')) - 7.0)
      else
      end
      if readByte(CheatFlag) == 7 then
         writeByte(CheatFlag, 6);
      elseif readByte(CheatFlag) == 17 then
         writeByte(CheatFlag, 16);
      elseif readByte(CheatFlag) == 29 then
         writeByte(CheatFlag, 28);
