                    <CheatEntry>
                      <ID>1337157656</ID>
                      <Description>"Inf. Health + One Hit Kill example "</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">{ Game   : LegendaryTales-Win64-Shipping.exe
  Version:
  Date   : 2021-12-29
  Author : Akira Fudo

F3 0F 10 81 EC 00 00 00 F3 0F 5E
F3 0F ? ? ? ? ? ? F3 0F ? ? ? ? ? ? C3 CC CC CC CC CC CC CC CC CC CC CC CC CC CC CC 48 8B ? ? ? ? ? C3
F3xxxxxxxxxxxxxxF3xxxxxxxxxxxxxxC3xxCCxxCCxxCCxxCCxxCCxxCCxxCCxx48xxxxxxxxxxxxC3xxCCCC
}

[ENABLE]

aobscanmodule(Health,LegendaryTales-Win64-Shipping.exe,F3 0F 10 81 EC 00 00 00 F3 0F 5E)
alloc(newmem,$1000,Health)

label(code)
label(return)
label(Health_Player)
label(Health_Enemy)
label(_OneHitKill)

newmem:
  cmp [rcx+2D0],0 //OwnerEnemy
  je Health_Player
  cmp [rcx+2D0],0 //OwnerEnemy
  jne Health_Enemy
  jmp return

Health_Player:
  mov [rcx+000000EC],(float)9999 //CurrentHealth
  mov [rcx+000000F0],(float)9999 //MaxHealth
  jmp return

Health_Enemy:
  cmp byte ptr [_OneHitKill],1
  jne code
  mov [rcx+000000EC],(float)0 //CurrentHealth
  jmp return

code:
  movss xmm0,[rcx+000000EC]
  jmp return

_OneHitKill:
  dd 0

Health:
  jmp newmem
  nop 3
return:
registersymbol(Health)
registersymbol(_OneHitKill)

{$LUA}
memrec.Color = 0x0000FF00 --format AABBGGRR this is bright green
{$ASM}
[DISABLE]
{$LUA}
memrec.Color = 0x000000FF -- this is bright red
{$ASM}

Health:
  db F3 0F 10 81 EC 00 00 00

unregistersymbol(Health)
unregistersymbol(_OneHitKill)
dealloc(newmem)

