                    <CheatEntry>
                      <ID>1337157990</ID>
                      <Description>"Rate of Fire [Change RoF without overwriting the original value]"</Description>
                      <Color>000080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : Warstride-Win64-Shipping.exe
  Version:
  Date   : 2022-04-20
  Author : Akira Fudo

F3 0F 59 BB 30 04 00 00
F3 0F ? ? ? ? ? ? F3 0F ? ? ? ? ? ? E8 ? ? ? ? 45 33 ? 33 C9 48 8B ? 41 8D ? ? E8 ? ? ? ? 48 8B ? 48 85 ? 74 ? 48 8D
F3xxxxxxxxxxxxxxF3xxxxxxxxxxxxxxE8xxxxxxxxxxxxxx33xxxxxxxx41xxxxxxxxxxxxxxxx48xxxxxxxxxx74xxxxxxxxxxxxxxxx48xxxxE8
}

[ENABLE]

aobscanmodule(TimeBetweenShots,Warstride-Win64-Shipping.exe,F3 0F 59 BB 30 04 00 00)
alloc(newmem,$1000,TimeBetweenShots)

label(code)
label(return)
label(testing)

newmem:
  movss xmm7,[testing]

code:
  //movss [rbx+00000430],xmm7
  jmp return

testing:
  dq (float)0.03

TimeBetweenShots:
  jmp newmem
  nop 3
return:
registersymbol(TimeBetweenShots)
registersymbol(testing)

{$LUA}
memrec.Color = 0x0000FF00 --;AABBGGRR Green
{$ASM}
[DISABLE]
{$LUA}
memrec.Color = 0x000000FF --;AABBGGRR Red
{$ASM}

TimeBetweenShots:
  db F3 0F 59 BB 30 04 00 00

unregistersymbol(TimeBetweenShots)
unregistersymbol(testing)
dealloc(newmem)

