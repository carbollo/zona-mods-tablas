-- Windows Dark Mode
CheatForm.CEButton14.OnClick = 'CheatForm_CEButton14Click'
function CheatForm_CEButton14Click(sender)
------- In the Lua Cheat Table Script window -------
----------------------------------------------------
   function getMemRec(desc)
      if tostring(desc) ~= '' then
         local mr = getAddressList().getMemoryRecordByDescription(desc)
         if mr ~= nil then
            return mr
         end
      end
   end

   function toHex(s)
      if s ~= nil then
         local x = s:format("%X")
         return x
      end
   end

   function setCEDarkMode(state)
      local z = state
      if z == true then
         getSettingsForm().Component[47].checked = nil
         getSettingsForm().ComponentByName['btnOK'].doClick()
      elseif z == false then
         getSettingsForm().Component[47].checked = true
         getSettingsForm().ComponentByName['btnOK'].doClick()
      end
   end

   function getWinDarkMode()
      local hwnd = io.popen("PowerShell Get-ItemProperty -Path HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize -Name AppsUseLightTheme")
      local res = tostring(hwnd:read("*a"))
      hwnd:close()

      local value = tostring(res:gsub("%s",""))
      value = value:sub(19,-1)
      value = value:sub(1,1)
      return value
   end

   function setDarkMode()
      setCEDarkMode(true)
      local hwnd = io.popen("PowerShell Set-ItemProperty -Path HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize -Name AppsUseLightTheme -Value 0")
      hwnd:close()

      if getWinDarkMode() == 1 then
         local ce = enumModules()[1].PathToFile
         shellExecute(ce)
         closeCE()
      else
         return nil
      end
   end

   function setLightMode()
      setCEDarkMode(false)
      local hwnd = io.popen("PowerShell Set-ItemProperty -Path HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize -Name AppsUseLightTheme -Value 1")
      hwnd:close()
   end

   function checkAndRestartCE()
      if darkMode() == true then
         return nil
      else
         setDarkMode()
      end
   end

   checkAndRestartCE()
end

-- Debug:CE Print Table Options
CheatForm.PrintTableOptionsButton.OnClick = 'CheatForm_PrintTableOptionsButtonClick'
function CheatForm_PrintTableOptionsButtonClick(sender)
   local scriptInfo = '' ..
                      '\nGame Name:\t'    .. GameName ..
                      '\nGame Process:\t' .. GameProcess0 ..
                      '\nGame Engine:\t'  .. GameEngine ..
                      '\nGame Module:\t'  .. GameModule ..
				      '\nGame Version:\t' .. GameVersion ..
                      '\nSavegame:\t'     .. SavegamePath ..
                      '\nGame App ID:\t'  .. AppID ..
                      '\n'                ..
                      '\nCheat Engine:\t' .. CEVersion ..
                      '\nCheat Table:\t'  .. TableVersion ..
                      '\n'              ..
                      '\nOptions:'
   print(scriptInfo)
   local al = getAddressList()
   for i = 0, al.Count - 1 do
       if al[i].Type == vtAutoAssembler then print("   " .. al[i].Description) end
   end
end

-- Unity:Print Field Names
CheatForm.ClassNamePrintFields.Text = "&lt;EnterClassNameHere&gt; e.g.: PlayerCharacterMasterController"
CheatForm.CEButton16.OnClick = 'CheatForm_CEButton16Click'
function CheatForm_CEButton16Click(sender)
   if isUnityEngine == true then
      --local className = readString(CheatForm.ClassNamePrintFields.Text, 255, true)
      local className = CheatForm.ClassNamePrintFields.Text
      local cid = mono_findClass(className)
      local fields = mono_class_enumFields(cid, true)
      print("Static Fields:")
      for i = 1,#fields do
          if fields[i].isStatic == true then print("   " .. fields[i].name) end
      end
      print("\nFields:")
      for i = 1,#fields do
          if fields[i].isStatic == false then print("   " .. fields[i].name) end
      end
   end
end

-- Unity:Get Static Field Address
CheatForm.ClassNamePrintAddress.Text = "&lt;EnterClassNameHere&gt; e.g.: PlayerCharacterMasterController"
CheatForm.FieldNamePrintAddress.Text = "&lt;EnterStaticFieldNameHere&gt; e.g.: _instances"
CheatForm.NameSpacePrintAddress.Text = "&lt;EnterClassNameSpaceHere&gt; e.g.: RoR2"
CheatForm.PrintedClassAddress.Text   = "-"
CheatForm.CEButton17.OnClick = 'CheatForm_CEButton17Click'
function CheatForm_CEButton17Click(sender)
   local function getStaticFieldAddress(className, fieldName, nameSpace)
            local function toHex(str)
                     str = string.format("%X", str)
                     return str
            end
            if isUnityEngine == true and unityIL2CPPGame == false then
               if not nameSpace then nameSpace = '' end
               local cid       = mono_findClass(nameSpace,className)
               local theFields = mono_class_enumFields(cid,true)
               local sf0
               local sf1
               local sf2
               for i=1,#theFields do
                   if theFields[i].isStatic and theFields[i].name == fieldName then
                      sf0 = mono_class_getStaticFieldAddress('',cid)
                      sf1 = sf0 + theFields[i].offset
                      sf2 = toHex(readPointer(sf1))
                      --print(toHex(readPointer(sf0)))
                      if readPointer(sf2) ~= nil then
                         CheatForm.PrintedClassAddress.Text = "[" .. toHex(sf0) .. "+" .. theFields[i].offset .. "]" .. " | " .. toHex(readPointer(sf1))
                      else
                         CheatForm.PrintedClassAddress.Text = toHex(sf0) .. "+" .. theFields[i].offset .. " | " .. toHex(readPointer(sf1))
                      end
                   end
               end
            end
            if isUnityEngine == true and unityIL2CPPGame == true then
               if not nameSpace then nameSpace = '' end
               local cid       = mono_findClass(nameSpace,className)
               local theFields = mono_class_enumFields(cid,true)
               local sf0
               local sf1
               local sf2
               for i=1,#theFields do
                   if theFields[i].isStatic and theFields[i].name == fieldName then
                      sf0 = toHex(cid)
                      sf1 = "[" .. toHex(cid) .. "+B8" .. "]" .. "+" .. toHex(theFields[i].offset)
                      sf2 = toHex(readPointer(readPointer(cid+0xB8) + theFields[i].offset))
                      if sf2 ~= nil then
                         CheatForm.PrintedClassAddress.Text = sf1 .. " | " .. sf2
                      end
                   end
               end
            end
         end
         local className = CheatForm.ClassNamePrintAddress.Text -- "PlayerCharacterMasterController"
         local fieldName = CheatForm.FieldNamePrintAddress.Text -- "_instances"
         local nameSpace = CheatForm.NameSpacePrintAddress.Text -- "RoR2"
         getStaticFieldAddress(className, fieldName, nameSpace)
end

