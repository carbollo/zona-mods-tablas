Enable the script to get the Japanese control scheme.
Disable the script to get the English control scheme.

"Active" is what's the game currently using as the input method.
"Saved" is what the game copies to the save file.
*/
[ENABLE]
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>63601</ID>
                  <Description>"Control Scheme"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
//Japanese
//Active
ctrlScheme+D0:  //Main 1
dd 01

ctrlScheme+D0+4: //Main 2
dd 02

ctrlScheme+D0+100:
dd 01

ctrlScheme+D0+104:
dd 02

ctrlScheme+D0+200:
dd 01

ctrlScheme+D0+204:
dd 02

ctrlScheme+D0+300:
dd 01

ctrlScheme+D0+304:
dd 02

//Saved
ctrlSchemeSaved-3F0:  //Main 1
dd 01

ctrlSchemeSaved-3F0+8: //Main 2
dd 02

ctrlSchemeSaved-3F0+100:
dd 01

ctrlSchemeSaved-3F0+108:
dd 02

ctrlSchemeSaved-3F0+200:
dd 01

ctrlSchemeSaved-3F0+208:
dd 02

ctrlSchemeSaved-3F0+300:
dd 01

ctrlSchemeSaved-3F0+308:
dd 02

[DISABLE]
//English
//Active
ctrlScheme+D0:  //Main 1
dd 02

ctrlScheme+D0+4: //Main 2
dd 01

ctrlScheme+D0+100:
dd 02

ctrlScheme+D0+104:
dd 01

ctrlScheme+D0+200:
dd 02

ctrlScheme+D0+204:
dd 01

ctrlScheme+D0+300:
dd 02

ctrlScheme+D0+304:
dd 01

//Saved
