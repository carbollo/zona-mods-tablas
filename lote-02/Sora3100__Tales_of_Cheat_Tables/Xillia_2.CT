          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
globalalloc(skillEdit,1000)

skillEdit:
dd 00 00 00 00

skillEdit+8:
dd 01 00 00 00

[DISABLE]
unregistersymbol(skillEdit)
dealloc(skillEdit)
