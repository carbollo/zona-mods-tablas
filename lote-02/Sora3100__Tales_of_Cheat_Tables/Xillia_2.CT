--[[local address = get_address_from_aob("42 54 4C 55 4E 49 54 53 54 41 54 55 53 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 0D 42 54 4C 44 42")

address = address + 0x68
address = swapEndian(readInteger(address))
registerSymbol("regionCheckEquip", 0x300000000+address+0x9020C)]]
local baseRPCS3Address = 0x300000000
local TOC_BASE = get_address_from_aob("00 01 02 00 ? ? ? ? ? ? ? ? ? ? ? ? 00 01 02 40")
local offset = get_address_from_aob("81 ? ? ? 80 69 00 00 4e 80 00 20 80 ? ? ? 80 ? ? ?", "-W-X*C")
offset = swapEndianWord(readSmallInteger(offset + 0x2))
offset = bitwise_not_16bit(offset) + 1
local address = swapEndian(readInteger(TOC_BASE+0x4))
address = address - offset
address = baseRPCS3Address + address
address = baseRPCS3Address + swapEndian(readInteger(address))
address = baseRPCS3Address + swapEndian(readInteger(address))
address = baseRPCS3Address + swapEndian(readInteger(address + 0x4))
registerSymbol("regionCheckEquip", address + 0x204 + 0x8)

