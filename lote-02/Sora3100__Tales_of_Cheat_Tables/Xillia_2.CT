          <ID>91762</ID>
          <Description>"Field Run Speed"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanregion(walkrunSpeed, 300000000, 400000000, 40 20 00 01 41 2D 55 56) // should be unique
aobscanregion(dashSpeed, 300000000, 400000000, 43 B4 00 00 40 40 00 00 42 A0 00 00 3C 36 0B 61 40 BA AA AC)

registersymbol(walkrunSpeed)
registersymbol(dashSpeed)
[DISABLE]

walkrunSpeed:
  db 40 20 00 01 41 2D 55 56

dashSpeed:
  db 43 B4 00 00 40 40 00 00 42 A0 00 00 3C 36 0B 61 40 BA AA AC

unregistersymbol(walkrunSpeed)
unregistersymbol(dashSpeed)
</AssemblerScript>
