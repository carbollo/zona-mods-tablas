aobscanregion(regionCheckFlags, 300000000, 400000000, 46 50 53 5F 53 43 52 5F ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? 00)

//registersymbol(regionCheckEquip)
registersymbol(regionCheckFlags)
[DISABLE]
unregistersymbol(regionCheckEquip)
unregistersymbol(regionCheckFlags)
