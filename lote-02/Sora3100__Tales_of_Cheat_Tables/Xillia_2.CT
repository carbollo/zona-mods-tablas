              <Description>"Slot 1"</Description>
              <DropDownListLink>Party Formation</DropDownListLink>
              <VariableType>Custom</VariableType>
              <CustomType>4 Byte Big Endian</CustomType>
              <Address>+0</Address>
            </CheatEntry>
            <CheatEntry>
