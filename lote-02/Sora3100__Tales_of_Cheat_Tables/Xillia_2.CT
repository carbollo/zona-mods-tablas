        <CheatEntry>
          <ID>83388</ID>
          <Description>"Chronos (Canaan) Fight Editor"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanregion(chronosFight, 300000000, 400000000, 53 54 52 5F 44 42 47 5F 42 54 4C 5F 45 47 5F 45 56 45 5F 32 39 30 5F 4E 41 4D 45) // should be unique
aobscanregion(chronosStage, 300000000, 400000000, 00 4D 41 50 5F 42 54 4C 5F 4B 4E 4E 5F 30 30 31 00)
aobscanregion(chronosBGM,300000000, 400000000, 30 5F 30 31 30 00 4D 55 53 5F 54 4F 58 32 5F 42 54 4C 5F 42 4F 53 5F 4B 52 4F 00)
aobscanregion(enemyNumberChronos, 300000000, 400000000, 00 00 00 00 00 00 C6 14 00 00 00 01 00 00 C6 14 00 00 00 24 00 00 C6 28) // should be unique
aobscanregion(endofFightMem, 300000000, 400000000, 44 42 47 5F 42 54 4C 5F 45 47 5F 47 49 47 41 5F 45 58 5F 32 33 5F 4E 41 4D 45)
registersymbol(chronosFight)
registersymbol(chronosStage)
registersymbol(chronosBGM)
registersymbol(enemyNumberChronos)
registersymbol(endofFightMem)

enemyNumberChronos-8:
db 00 02 56 0E

endofFightMem+3E:
db 42 54 4C 5F 45 56 5F 45 47 5F 45 56 45 5F 32 39 30 00

chronosFight:

chronosStage:

chronosBGM:

enemyNumberChronos:

endofFightMem:

[DISABLE]
chronosFight-8:
db 00 00 01 AE 00 00 00 00

chronosStage:
db 00 4D 41 50 5F 42 54 4C 5F 4B 4E 4E 5F 30 30 31 00

chronosBGM:
db 30 5F 30 31 30 00 4D 55 53 5F 54 4F 58 32 5F 42 54 4C 5F 42 4F 53 5F 4B 52 4F 00

enemyNumberChronos-10:
db 00 00 00 55 00 00 00 00 00 00 C6 0E 01 01 01 00 00 00 00 00 00 00 C6 14 00 00 00 01 00 00 C6 14 00 00 00 24

endofFightMem+3E:
db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

unregistersymbol(chronosFight)
unregistersymbol(chronosStage)
unregistersymbol(chronosBGM)
unregistersymbol(enemyNumberChronos)
unregistersymbol(endofFightMem)
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>83389</ID>
              <Description>"READ THIS"</Description>
              <Color>0000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>/*
Using entries with (For Debug Use)/(Debug) or (For F Chat)
in the name will crash the game. In the BLES01962 version of the game,
debug enemies do not crash the game.

Activating the More Enemies script will make the Bisley fight crash,
so be sure to return to the title screen after you finish the fight!

Group lets you specify what team that enemy is on.
Leave them in the same group to not make them attack each other.

The same rules apply here as the Arena Editor ones.

Have fun!
*/
[ENABLE]
[DISABLE]
</AssemblerScript>
            </CheatEntry>
