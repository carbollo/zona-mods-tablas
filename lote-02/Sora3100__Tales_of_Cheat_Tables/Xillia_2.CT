                <CheatEntry>
                  <ID>92245</ID>
                  <Description>"Arte list helper"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local debug = false
local auto_disable = false
local clear_console = false
local load_character = 0x1 --based on arte list data

if (clear_console == true) then
   --clear lua engine window
   GetLuaEngine().MenuItem5.doClick()
   if (debug == true) then
      print(os.date ("%c"))
      print("Cleared Lua Engine.")
   end
end

if (debug == true) then
   print("\""..memrec.Description.."\" ENABLE START")
end

local al = getAddressList()
local char_script_memrec = al.getMemoryRecordByID("109575")

if (arte_data_base == nil) then
   if (debug == true) then
      print("Character script is disabled, enabling...")
   end
   char_script_memrec.Active = true
end

local address = getOffset(arte_data_base + 0x8 + arte_list_data_struct_size * (load_character - 1))

local header = memrec.Child[1]

if (header.Count &gt; 0) then
   if (debug == true) then
      print("Deleting "..header.Count.." memory records.")
   end
   while (header.Count &gt; 0) do
         memoryrecord_delete(header.Child[header.Count-1])
   end
end

for i = 0, (arte_size_to_generate - 1), 1 do
    if (i &gt; 200) then
       break
    end

    local arte_memrec = al.createMemoryRecord()
    arte_memrec.Parent = header
    arte_memrec.Description = "Arte "..i+1
    arte_memrec.DontSave = true
    arte_memrec.Address = address
    arte_memrec.Type = vtCustom
    arte_memrec.CustomTypeName = "4 Byte Big Endian"
    arte_memrec.DropDownLinkedMemRec = "Arte List"
    arte_memrec.DropDownLinked = true
    arte_memrec.Options = "[moManualExpandCollapse, moAllowManualCollapseAndExpand]"

    --generate bitflags
    for j=0,3,1 do
        local direction_memrec = al.createMemoryRecord()
        direction_memrec.Parent = arte_memrec
        direction_memrec.DontSave = true
        direction_memrec.Address = address + 0x7
        direction_memrec.Type = vtBinary
        direction_memrec.DropDownLinkedMemRec = "dropdown: Disabled/Enabled"
        direction_memrec.DropDownLinked = true
        direction_memrec.Binary.Size = 1
        direction_memrec.Binary.Startbit = j

        if (j == 0) then
           direction_memrec.Description = "Direction: Neutral"
        elseif (j == 1) then
               direction_memrec.Description = "Direction: Up"
        elseif (j == 2) then
               direction_memrec.Description = "Direction: Side (Left/Right)"
        elseif (j == 3) then
               direction_memrec.Description = "Direction: Down"
        else
            direction_memrec.Description = "Unknown"
        end
    end

    address = address + 0x14
end

if (debug == false) then
   showMessage("By default, this will show Jude's arte list.\r\nSet the arte after the final one to 0 (nothing) to end the list.\r\nClick \"Activate\" once you're done making the list, then copy the result into the value part of the artes memory record.")
end

if (auto_disable == true) then
   createTimer(1000, function() memrec.Active = false end)
end

if (debug == true) then
   print("\""..memrec.Description.."\" ENABLE END")
end
--------------------------------------------------------------------------------------------------------------------------------------------------------------
{$asm}
[DISABLE]
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>92246</ID>
                      <Description>"Generate arte list"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local debug = false
local auto_disable = true
local clear_console = false

if (clear_console == true) then
   --clear lua engine window
   GetLuaEngine().MenuItem5.doClick()
   if (debug == true) then
      print(os.date ("%c"))
      print("Cleared Lua Engine.")
   end
end

if (debug == true) then
   print("\""..memrec.Description.."\" ENABLE START")
end

local header = memrec.Parent.Child[1]
local address = tonumber("0x"..header.Child[0].Address)
local i = 1
local arte_table = {}
local arte_table_string = ""
local arte_table_counter = 1

while not (readInteger(address) == 0) do
      if (i &gt; arte_size_to_generate) then
         break
      end

      local bytes = readBytes(address, 0x14, true)
      --table.insert(arte_table, i, bytes)
      for j,v in pairs(bytes) do
          table.insert(arte_table, arte_table_counter, v)
          arte_table_counter = arte_table_counter + 1
      end

      if (debug == true) then
         print("Added arte ID "..swapEndian(readInteger(address)).." to table")
      end

      i = i + 1
      address = address + 0x14
end

for j,v in pairs(arte_table) do
    if (v &lt; 0x10) then
       arte_table_string = arte_table_string.."0"..toHex(v).." "
    else
        arte_table_string = arte_table_string..toHex(v).." "
    end
end

--remove whitespace at the end
arte_table_string = arte_table_string:sub(1, -2)

print("-----------------------------------------------------------------------")
print(os.date ("%c"))
print("Copy this to the artes memory record:")
print(arte_table_string)
writeToClipboard(arte_table_string)
print("(this was also copied to clipboard)")
print("A total of "..(i-1).." artes were recognized.")
print("-----------------------------------------------------------------------")

if (auto_disable == true) then
   createTimer(1000, function() memrec.Active = false end)
end

if (debug == true) then
   print("\""..memrec.Description.."\" ENABLE END")
end
--------------------------------------------------------------------------------------------------------------------------------------------------------------
{$asm}
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>92744</ID>
                      <Description>"Artes"</Description>
                      <Options moHideChildren="1"/>
                      <GroupHeader>1</GroupHeader>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>68288</ID>
              <Description>"CHR script V2 (please use "Play as &lt;character&gt;" instead)"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanregion(enmData_source, 300000000, 400000000, 00 00 00 09 00 00 00 09 00 04 30 1C 00 00 00 00 00 04 30 28 00 04 30 34) // should be unique
aobscanregion(arteData_source, 300000000, 400000000, 46 50 53 5F 42 54 4C 5F 4D 41 5F 50 43 5F 4A 55 52 00)
aobscanregion(weaponData_source, 300000000, 400000000, 00 00 8B A0 00 00 8B AF 00 00 00 64 00 00 00 0A 2A 00 00 00 00 00 00 18 00 00 8B BB 00 00 00 00)

registersymbol(enmData_source arteData_source weaponData_source)
[DISABLE]
unregistersymbol(enmData_source arteData_source weaponData_source)
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>89015</ID>
                  <Description>"READ THIS"</Description>
                  <Options moHideChildren="1"/>
                  <Color>0000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>/*
These will only take effect while in battle.

"JP Bisley arte crash fix" will fix the crash on the Japanese version of
the game where the game crashes when trying to use an arte/opening the menu
while using Bisley.

Ludger requires 4 weapon mode to be disabled to work.

"Take after" will make the character look like the character you select.
(only if you don't override the model, that is)
It will also give you that character's gimmick. (e.g. Jude's Snap Pivot)
Changing Ludger's gimmick will make the game crash if you try to activate
Chromatus. Similiarly, it will also crash if you set a character to "Empty"
without having a model selected.

DLC costumes may override certain parts of the script. It is recommended
not to use them while using this script.

Note that most characters cannot use items.

Not all characters have working normal attacks/sidesteps.
Some characters don't have all of their normal attacks, as there isn't enough
space.
Please check every direction to see if they have different normal attacks.

Removing weapons of a character will break that character's attacks if an
enemy version of that character would use it.

Characters that do not have a sidestep were given Jude's sidestep,
but they will not function properly sometimes. Characters that do have
sidestep have their normal sidesteps.

Linked artes should be working fine.
Common linked artes require the workaround to not softlock.

Mystic Artes are not supported at this time. (they will softlock you)

Hope you enjoy!
*/
[ENABLE]
[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>89025</ID>
                  <Description>"Common linked artes workaround"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanregion(artePropData_source, 300000000, 400000000, 00 00 00 00 00 03 83 EC 00 00 00 0F FF FF FF FF)

//Driselle debug attack (ID 1192)
artePropData_source+13CC8:
db 00 00 00 0A

registersymbol(artePropData_source)
[DISABLE]
//Driselle debug attack (ID 1192)
artePropData_source+13CC8:
db 00 00 00 0E

unregistersymbol(artePropData_source)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>89061</ID>
                  <Description>"JP Bisley arte crash fix"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanregion(arteNameFix, 300000000, 400000000, 53 54 52 5F 42 54 4C 5F 4D 41 5F 4D 4F 4E 5F 42 49 53 5F 41 5F 30 30 5F 4E 41 4D 45 00 3C 52 75 62 79)

//Remove Ruby tags so the game doesn't overflow resulting in a crash
arteNameFix+1D:
  db E9 AD 94 E7 A5 9E E6 8B B3 E3 83 BB E7 88 86 E7 89 99 00

registersymbol(arteNameFix)
[DISABLE]

arteNameFix+1D:
