                <CheatEntry>
                  <ID>89282</ID>
                  <Description>"Friendly Fire stuff"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanregion(BTLAS, 300000000, 400000000, 00 00 00 08 00 00 0B E5) // should be unique
registersymbol(BTLAS)
globalalloc(BTLASOptions,1000)

BTLASOptions:
  dq 01

[DISABLE]
unregistersymbol(BTLAS)
unregistersymbol(BTLASOptions)
dealloc(BTLASOptions)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>89294</ID>
                      <Description>"Activate"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
--BTLAS+8 = first AttackStatus
--+98 = ignore first, skip to next one
--68 = Hit allies flag
--69 = Hit self flag
  local address = getAddress("BTLAS+8+98+68")

  for i = 0, 3043 do
      --Friendly Fire check
      if (readInteger("BTLASOptions") == 1) then
         writeByte(address,1)
      end
      --Self hit check
      if (readInteger("BTLASOptions+8") == 1) then
         address = address + 1
         writeByte(address,1)
         address = address - 1
      end
      address = address + 0x98
      i = i + 1
  end

{$asm}
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>89286</ID>
                      <Description>"Friendly Fire"</Description>
                      <DropDownListLink>dropdown: Disabled/Enabled</DropDownListLink>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>8 Bytes</VariableType>
                      <Address>BTLASOptions</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>89291</ID>
                      <Description>"Self Fire"</Description>
                      <DropDownListLink>dropdown: Disabled/Enabled</DropDownListLink>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>8 Bytes</VariableType>
                      <Address>BTLASOptions+8</Address>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
