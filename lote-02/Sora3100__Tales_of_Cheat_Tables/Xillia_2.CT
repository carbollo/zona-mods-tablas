            <CheatEntry>
              <ID>62699</ID>
              <Description>"Jude -&gt; Wingul Mystic Arte POC"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
--[[
04 27 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Jude
04 7A 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Milla
04 7C 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Alvin
04 7E 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Elize
04 80 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Rowen
04 82 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Leia
04 C6 4B 97 0C 00 62 00 00 00 20 38 47 04 FF 58 36 --Gaius
04 C1 4B 97 0C 00 62 00 00 00 20 38 56 10 00 00 16 --Muzét
06 F9 4B 97 0C 00 62 00 00 00 20 38 62 00 00 00 20 --Ludger (this doesn't work apparently?)
]]
local arteToReplaceWith = 909
local t = {}

for i = 1, 0, -1 do
    t[2 - i] = (arteToReplaceWith &gt;&gt; (i * 8)) &amp; 0xFF
end
--[[
-- Print the resulting array
for i, value in ipairs(t) do
    print("Byte " .. i .. ": " .. value)
end]]

AoB = AOBScan("04 27 ? ? ? ? ? 00 00 00 ? ? 47 04 FF 58 36")
if (AoB) then
   lngt = AoB.getCount()
   for i = 0,lngt-1
       do
         writeBytes(AoB[i], t)
         --writeBytes(AoB[i], 0x03, 0x8D)
       end
end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end

local arteToReplaceWith = 1063
local t = {}

for i = 1, 0, -1 do
    t[2 - i] = (arteToReplaceWith &gt;&gt; (i * 8)) &amp; 0xFF
end

if (AoB) then
   lngt = AoB.getCount()
   for i = 0,lngt-1
       do
         writeBytes(AoB[i], t)
         --writeBytes(AoB[i], 0x04, 0x27) --Final Fury
       end
AoB.Destroy()
AoB = nil
end
</AssemblerScript>
            </CheatEntry>
