                  <AssemblerScript>[ENABLE]
/*{$lua}
AoB = AOBScan("07 1D 4B 97 0C 00 62 00 00 00 1C 4C 37 04 C8 26")
if (AoB) then
   lngt = AoB.getCount()
   if (lngt &gt; 2) then writeBytes(AoB[2], 0x0, 0x0) end
   AoB.Destroy()
   AoB = nil
else
  -- print("No results found.")
end
{$asm}
*/
