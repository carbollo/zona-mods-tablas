            <CheatEntry>
              <ID>66309</ID>
              <Description>"Multiplayer debug"</Description>
              <Options moHideChildren="1"/>
              <ShowAsSigned>0</ShowAsSigned>
              <GroupHeader>1</GroupHeader>
              <Address>regionCheckEquip+52D4</Address>
              <CheatEntries>
                <CheatEntry>
                  <ID>89210</ID>
                  <Description>"Linking"</Description>
                  <Options moHideChildren="1"/>
                  <ShowAsSigned>0</ShowAsSigned>
                  <GroupHeader>1</GroupHeader>
                  <Address>+0</Address>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>62789</ID>
                      <Description>"READ THIS"</Description>
                      <Color>0000FF</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>/*
Please only use this if you want the AI controlled characters to use linked attacks properly or if both scripts fail.
Instructions:
Set the Leader character's value to "Linked, Player controlled"
Set the Following character's value to "Linked, AI controlled"

If both scripts failed, then follow this:
Set the values of the used characters (or just all) to 1.
(OPTIONAL) Freeze the values. This makes it convenient by not needing to manually set it every time a fight starts.
(Alternate to freezing) Set a hotkey.
Link to a character normally in-game.

Note, that when using this method, linking to a
character will lose control for a second.
*/
[ENABLE]
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>89211</ID>
                      <Description>"Jude"</Description>
                      <Options moHideChildren="1"/>
                      <ShowAsSigned>0</ShowAsSigned>
                      <GroupHeader>1</GroupHeader>
                      <Address>+0</Address>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>89212</ID>
                          <Description>"Link state"</Description>
                          <DropDownListLink>dropdown: Link state</DropDownListLink>
                          <VariableType>Custom</VariableType>
                          <CustomType>4 Byte Big Endian</CustomType>
                          <Address>+0</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>89213</ID>
                          <Description>"Linked to"</Description>
                          <DropDownListLink>Party Formation</DropDownListLink>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Custom</VariableType>
                          <CustomType>4 Byte Big Endian</CustomType>
                          <Address>+4</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>89214</ID>
                          <Description>"Link color"</Description>
                          <DropDownListLink>dropdown: Link color</DropDownListLink>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Custom</VariableType>
                          <CustomType>4 Byte Big Endian</CustomType>
                          <Address>+8</Address>
                        </CheatEntry>
                      </CheatEntries>
