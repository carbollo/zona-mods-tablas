              <ID>90075</ID>
              <Description>"Growth data (Allium Orb)"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanregion(growthData, 300000000, 400000000, 01 00 00 01 00 00 13 1C 00 00 00 01 00 00 00 00 00 00 00 0A 00 00 00 00 01 00 00 02 00 00 13 0C) // should be unique
globalalloc(growthDataEdit,8)

registersymbol(growthData)
[DISABLE]
unregistersymbol(growthData)
unregistersymbol(growthDataEdit)
dealloc(growthDataEdit)
</AssemblerScript>
