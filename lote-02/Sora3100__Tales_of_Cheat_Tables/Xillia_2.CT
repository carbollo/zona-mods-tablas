                <CheatEntry>
                  <ID>66375</ID>
                  <Description>"Enemy Book? can change stats"</Description>
                  <ShowAsSigned>1</ShowAsSigned>
                  <VariableType>4 Bytes</VariableType>
                  <Address>3010D3B3C</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>91767</ID>
                  <Description>"Set all char idle time"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local float = 999999

function swapEndiannessFloat(f)
    local bytes = {string.byte(string.pack("f", f), 1, -1)}
    return string.unpack("f", string.char(bytes[4], bytes[3], bytes[2], bytes[1]))
end

autoAssemble([[
aobscanregion(enmDataIdle, 300000000, 400000000, 00 00 00 01 00 00 00 09 00 00 00 0F 00 00 00 13 00 00 00 1C 00 00 00 1D 00 00 00 23 00 00 00 26 ? ? ? ? 00 00 00 00 00 00 00 00 00 00 00 00) // should be unique

registersymbol(enmDataIdle)
]])

local address = getAddress("enmDataIdle-154")

for i=1,563,1 do
    writeFloat(address+0x174, swapEndiannessFloat(float))

    address = address + 0x1E8
end

{$asm}
[DISABLE]
unregistersymbol(enmDataIdle)
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>89473</ID>
              <Description>"Skill Properties Editor"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanregion(skillPropEdit, 300000000, 400000000, 00 00 00 01 ? ? ? ? ? ? ? ? 00 00 00 02 00 00 00 01 00 00 00 05 00 00 00 00) // should be unique
registersymbol(skillPropEdit)
globalAlloc(skillPropNum,4)

[DISABLE]
unregistersymbol(skillPropEdit)
unregistersymbol(skillPropNum)
dealloc(skillPropNum)
</AssemblerScript>
