            <CheatEntry>
              <ID>24097</ID>
              <Description>"Rewrite Online Phantom Status"</Description>
              <Options moHideChildren="1"/>
              <LastState Activated="0"/>
              <Color>80000008</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(RewriteHostility,DarkSoulsII.exe,48 8B 49 40 48 85 C9 75 03 33)
alloc(newmem,$1000,RewriteHostility)
alloc(hostility,8)
alloc(hostility_on,1)
alloc(hostility_off,1)

label(code)
label(return)
label(on)
label(off)

newmem:
  cmp byte ptr [hostility_on],1
  je on
  cmp byte ptr [hostility_off],1
  je off
  jmp code
on:
  mov byte ptr [hostility_on],0
  mov rax,[rcx+40]
  mov qword ptr [hostility],rax
  xor rax,rax
  mov qword ptr [rcx+40],rax
  jmp code
off:
  mov byte ptr [hostility_off],0
  mov rax,qword ptr [hostility]
  mov qword ptr [rcx+40],rax
  jmp code
code:
  mov rcx,[rcx+40]
  test rcx,rcx
  jmp return

RewriteHostility:
  jmp newmem
  nop
  nop
return:
registersymbol(RewriteHostility)
registersymbol(hostility_on)
registersymbol(hostility_off)

[DISABLE]
RewriteHostility:
  db 48 8B 49 40 48 85 C9
unregistersymbol(RewriteHostility)
unregistersymbol(hostility_on)
unregistersymbol(hostility_off)
dealloc(newmem)

</AssemblerScript>
