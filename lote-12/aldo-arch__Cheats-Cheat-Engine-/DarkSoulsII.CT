alloc(newmem,$1000,"DarkSoulsII.exe")

label(code)
label(return)

newmem:

code:
  mov ebx,#103110
  mov [rsi+10],ebx
  test ebx,ebx
  jmp return

ifhpaob:
  jmp code
return:
registersymbol(ifhpaob)

[DISABLE]

ifhpaob:
  db 89 5E 10 85 DB

unregistersymbol(ifhpaob)
dealloc(newmem)

</AssemblerScript>
