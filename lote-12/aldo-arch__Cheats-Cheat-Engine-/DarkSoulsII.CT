alloc(target_mem, 100)
label(pTarget)
label(code)
label(exit)
label(ret)

registersymbol(target_inj)
registersymbol(target_mem)
registersymbol(pTarget)

target_mem:
pTarget:
dq 0000000000000000
code:
  mov [pTarget], rbx
  cmp [rbx+C0], rdi
  je exit
  mov byte ptr [rbx+761], 00
exit:
  jmp ret

target_inj:
  jmp code
  nop
  nop
ret:

[DISABLE]

target_inj:
  cmp [rbx+000000C0], rdi
  je target_inj+10
  mov byte ptr [rbx+00000761],00

dealloc(target_mem)

unregistersymbol(target_inj)
unregistersymbol(target_mem)
unregistersymbol(pTarget)

