                <CheatEntry>
                  <ID>24171</ID>
                  <Description>"Find Addresses for Last Bullet Used"</Description>
                  <Options moHideChildren="1"/>
                  <LastState Activated="0"/>
                  <Color>80000008</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanmodule(last_bullet,DarkSoulsII.exe,0F BE 4F 2F 39 8B 20 01 00 00)
alloc(newmem,$1000,last_bullet)
alloc(last_bullet_ptr,256)

label(code)
label(return)
label(check)
label(save)

newmem:
  push rax
  lea rax,qword ptr [last_bullet_ptr]
  xor rcx,rcx
  mov rcx,0
check:
  cmp qword ptr [rax+rcx*8],0
  je save
  cmp qword ptr [rax+rcx*8],rdi
  je code
  inc rcx
  cmp rcx,#10
  jl check
  jmp code
save:
  add rdi,2F
  mov qword ptr [rax+rcx*8],rdi
  sub rdi,2F
code:
  pop rax
  movsx ecx,byte ptr [rdi+2F]
  cmp [rbx+00000120],ecx
  jmp return
last_bullet:
  jmp newmem
  nop
  nop
  nop
  nop
  nop
return:
registersymbol(last_bullet)
registersymbol(last_bullet_ptr)

[DISABLE]
last_bullet:
  db 0F BE 4F 2F 39 8B 20 01 00 00
unregistersymbol(last_bullet)
unregistersymbol(last_bullet_ptr)
dealloc(newmem)
dealloc(last_bullet_ptr)

