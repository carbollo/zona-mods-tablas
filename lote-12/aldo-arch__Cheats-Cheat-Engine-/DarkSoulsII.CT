highlitem_mem:
code:
  cmp [previous], r8
  mov [previous], r8
  jne @f

  mov [pItem], r8

@@: // original code
  mov ecx,[r8+14]
  movzx eax,al
  movd xmm1,eax
  cvtdq2ps xmm1,xmm1
  jmp return

pItem:
  dq 0
previous:
  dq 0


highlitem_inj:
  jmp code
return:

