<CheatTable CheatEngineTableVersion="18">
  <CheatEntries>
    <CheatEntry>
      <ID>29780</ID>
      <Description>"Enable"</Description>
      <Options moHideChildren="1"/>
      <LastState Activated="1"/>
      <Color>80000008</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//Prevents Debugger Crash
{$lua}
debugProcess(2)
{$asm}
aobscanmodule(GetCoop,DarkSoulsII.exe,8B F2 48 8B F9 48 85 C0 74 06 48 8B 48 30 EB 02 33 C9 E8 93) //Online Base Address
aobscanmodule(GetBase,DarkSoulsII.exe,48 8B 58 38 48 85 DB 74 * F6) //Base Address
aobscanmodule(GetStatus,DarkSoulsII.exe,* B6 18 48 8D 45 20) //Black Separation Script Address
alloc(newmem1,$1000,GetCoop)
alloc(newmem2,$1000,GetBase)
alloc(newmem,$1000,GetStatus)
alloc(CoopPTR,8)
alloc(BasePTR,8)
label(code1)
label(return1)
label(code2)
label(return2)
label(return)
label(BscPTR)
label(thesame)

newmem:
  lea rbx,[BscPTR]
  cmp [rbx],rax
  je thesame
  cmp [rbx+8],rax
  je thesame
  cmp [rbx+10],rax
  je thesame
  cmp [rbx+18],rax
  je thesame
  cmp [rbx+20],rax
  je thesame

  mov rbx,[BscPTR+18]
  mov [BscPTR+20],rbx

  mov rbx,[BscPTR+10]
  mov [BscPTR+18],rbx

  mov rbx,[BscPTR+8]
  mov [BscPTR+10],rbx

  mov rbx,[BscPTR]
  mov [BscPTR+8],rbx

  mov [BscPTR],rax

thesame:
  movzx ebx,byte ptr [rax]
  lea rax,[rbp+20]
  jmp return

BscPTR:
dq 0
dq 0
dq 0


GetStatus:
  jmp newmem
  nop
  nop
return:
registersymbol(GetStatus)
registersymbol(BscPTR)

newmem1:
code1:
  mov qword ptr [CoopPTR],rax
  mov esi,edx
  mov rdi,rcx
  jmp return1
GetCoop:
  jmp code1
return1:
registersymbol(GetCoop)
registersymbol(CoopPTR)

newmem2:
code2:
  mov qword ptr [BasePTR],rax
  mov rbx,[rax+38]
  test rbx,rbx
  jmp return2
GetBase:
  jmp code2
  nop
  nop
return2:
registersymbol(GetBase)
registersymbol(BasePTR)

[DISABLE]
GetCoop:
  db 8B F2 48 8B F9
unregistersymbol(CoopPTR)
unregistersymbol(GetCoop)
dealloc(newmem1)
dealloc(CoopPTR)

GetBase:
  db 48 8B 58 38 48 85 DB
unregistersymbol(GetBase)
unregistersymbol(BasePTR)
dealloc(newmem2)
dealloc(BasePTR)

GetStatus:
  db 0F B6 18 48 8D 45 20
unregistersymbol(GetStatus)
unregistersymbol(BscPTR)
dealloc(newmem)
</AssemblerScript>
