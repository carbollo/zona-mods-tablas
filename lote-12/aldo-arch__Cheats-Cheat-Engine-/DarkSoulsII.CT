        <CheatEntry>
          <ID>23092</ID>
          <Description>"Item Mod"</Description>
          <Options moHideChildren="1"/>
          <LastState Value="" Activated="0" RealAddress="00000000"/>
          <Color>80000008</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>269</ID>
              <Description>"Item Swap"</Description>
              <Options moHideChildren="1"/>
              <LastState Activated="0"/>
              <Color>80000008</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(itemswap,DarkSoulsII.exe,48 8D 50 40 48 8B C2)
alloc(newmem,$1000,itemswap)
alloc(drop_ptr,8)

label(code)
label(return)

newmem:

code:
  lea rdx,[rax+40]
  mov [drop_ptr],rdx
  mov rax,rdx
  jmp return

itemswap:
  jmp code
  nop
  nop
return:
registersymbol(itemswap)
registersymbol(drop_ptr)

[DISABLE]
itemswap:
  db 48 8D 50 40 48 8B C2
unregistersymbol(itemswap)
unregistersymbol(drop_ptr)
dealloc(newmem)
dealloc(drop_ptr)
</AssemblerScript>
