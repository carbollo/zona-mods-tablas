label(return)

newmem:
  push rdi
  mov rdi,[BasePTR]
  mov rdi,[rdi+D0]
  mov rdi,[rdi+B8]
  cmp rax,rdi
  pop rdi
  je code
  mov dword ptr [rax+000005C4],01

code:
  cmp dword ptr [rax+000005C4],00
  jmp return

