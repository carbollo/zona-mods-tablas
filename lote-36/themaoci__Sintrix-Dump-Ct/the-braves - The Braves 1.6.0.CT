                  <Description>"(Anti-Cheat) Destroy ObscuredCheatingDetector"</Description>
                  <Color>00FF00</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanregion(obscuredcheatingdetector,CodeStage.AntiCheat.Detectors.ObscuredCheatingDetector.get_ExistsAndIsRunning,CodeStage.AntiCheat.Detectors.ObscuredCheatingDetector.get_ExistsAndIsRunning+af,8a 40 2a)

alloc(newmem,$1000)
alloc(obscheatdet,4)
alloc(obytes_obcd,10)
registersymbol(obscheatdet obytes_obcd)
label(code return)

obytes_obcd:
readmem(obscuredcheatingdetector,10)

newmem:

code:
  mov [obscheatdet],eax
  mov al, [eax+2a]
  mov [eax+10],00
  mov [eax+14],00
  mov [eax+18],00
  mov [eax+19],00
  mov [eax+20],00
  mov [eax+2a],00
  mov [eax+29],00
  ret

obscuredcheatingdetector:
  dq 0

obscuredcheatingdetector:
  jmp newmem
  nop 5
return:


[DISABLE]

obscuredcheatingdetector:
readmem(obytes_obcd,10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>917</ID>
                  <Description>"(Anti-Cheat) Destroy SpeedHackDetector"</Description>
                  <Color>00FF00</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Shaggalicious &amp; Send @  https://fearlessrevolution.com

[ENABLE]
