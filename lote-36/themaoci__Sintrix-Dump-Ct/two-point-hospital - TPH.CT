1A144ADF787: 85 C0                          - test eax,eax
1A144ADF789: 0F 84 34 04 00 00              - je 1A144ADFBC3
1A144ADF78F: 48 63 8F CC 00 00 00           - movsxd  rcx,dword ptr [rdi+000000CC]
1A144ADF796: 48 63 56 18                    - movsxd  rdx,dword ptr [rsi+18]
1A144ADF79A: 48 8D 6D 00                    - lea rbp,[rbp+00]
1A144ADF79E: 49 BB C0 47 1D 44 A1 01 00 00  - mov r11,000001A1441D47C0
1A144ADF7A8: 41 FF D3                       - call r11
// ---------- INJECTING HERE ----------
1A144ADF7AB: 89 87 CC 00 00 00              - mov [rdi+000000CC],eax
// ---------- DONE INJECTING  ----------
1A144ADF7B1: 48 8B 4F 38                    - mov rcx,[rdi+38]
