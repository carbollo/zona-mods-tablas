  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>11</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <Color>008000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Load Scripts from lua file
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
-- set background picture
setAddressListPicture('sintrix.jpg', 210, 0x0000FF)
-- start table script : (process , title, footer)
startTable('TPH.exe', 'TPH', 'By Sintrix / Build ')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Inf Cash (updates upon purchase)"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : TPH.exe
  Version: 
  Date   : 2025-06-27
  Author : Dark

  This script does blah blah blah
}

[ENABLE]

aobscan(Money2,89 87 CC 00 00 00 48 8B 4F) // should be unique
alloc(newmem,$1000,Money2)

label(code)
label(return)

newmem:

code:
mov [rdi+000000CC],(int)999999
  //mov [rdi+000000CC],eax
  jmp return

Money2:
  jmp newmem
  nop
return:
registersymbol(Money2)

[DISABLE]

Money2:
  db 89 87 CC 00 00 00

unregistersymbol(Money2)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: 1A144ADF7AB

1A144ADF77D: 48 8B C8                       - mov rcx,rax
1A144ADF780: 83 39 00                       - cmp dword ptr [rcx],00
