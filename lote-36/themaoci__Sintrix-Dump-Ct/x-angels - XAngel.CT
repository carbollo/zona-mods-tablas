  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('XAngel.exe','', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>782</ID>
              <Description>"→ Battle Modifiers"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanregion(FightHealth,FightHandle:DealHP+9d,FightHandle:DealHP+c8,49 63 96 B4 01 00 00)
alloc(newmem,$1000,FightHealth)
registersymbol(playerHealth enemyHealth)
label(code return playerHealth enemyHealth)
//Send@https://sintrix.net
newmem:
cmp [playerHealth],1
jne @f
cmp [r14+188],#0
jne @f
mov [r14+1B4],#99999

@@:
cmp [enemyHealth],1
jne code
cmp [r14+188],#0
je code
mov [r14+1B4],#0

code:
  movsxd  rdx,dword ptr [r14+000001B4]
  jmp return

playerHealth:
dd 0
//Send@https://sintrix.net
enemyHealth:
dd 0

FightHealth:
  jmp newmem
  nop 2
return:
registersymbol(FightHealth)

[DISABLE]

FightHealth:
  db 49 63 96 B4 01 00 00
//Send@https://sintrix.net
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>797</ID>
                  <Description>"Infinite Health"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
playerHealth:
dd 1

[DISABLE]
playerHealth:
dd 0
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>798</ID>
                  <Description>"One Hit Kill"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
enemyHealth:
dd 1

[DISABLE]
enemyHealth:
dd 0
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>784</ID>
              <Description>"→ Grab Money (Enable &amp; Open Shop)"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//Send@https://sintrix.net
aobscanregion(playerDataPtr,ShopCardSellManager+&lt;&gt;c__DisplayClass6_0:&lt;OpenShopSellPanel&gt;b__1+7f7,ShopCardSellManager+&lt;&gt;c__DisplayClass6_0:&lt;OpenShopSellPanel&gt;b__1+837,48 63 80 04 01 00 00 48 63 8E 94 00 00 00 3B C1 7C)
alloc(newmem,$1000,playerDataPtr)
registersymbol(getPlayer)
label(code return getPlayer)

newmem:
mov [getPlayer],rax

code:
  movsxd  rax,dword ptr [rax+00000104]
  jmp return
//Send@https://sintrix.net
getPlayer:
dw

playerDataPtr:
  jmp newmem
  nop 2
return:
registersymbol(playerDataPtr)

[DISABLE]

playerDataPtr:
  db 48 63 80 04 01 00 00
//Send@https://sintrix.net
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>786</ID>
                  <Description>"Money"</Description>
                  <VariableType>4 Bytes</VariableType>
                  <Address>[getPlayer]+104</Address>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
