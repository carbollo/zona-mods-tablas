            <CheatEntry>
              <ID>370344</ID>
              <Description>"Movement control"</Description>
              <Options moHideChildren="1"/>
              <Color>0000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(findvelocity,GameAssembly.dll,F3 * * * * * * * 76 * 48 * * * * * * F3 * * * * 83)
alloc(newmemfindvelocity,$100,findvelocity)
alloc(velocity,8,findvelocity)
label(codefindvelocity returnfindvelocity)

newmemfindvelocity:
mov [velocity],rbx

codefindvelocity:
movss [rbx+000000D8],xmm0
jmp returnfindvelocity

findvelocity:
jmp newmemfindvelocity
nop 3
returnfindvelocity:
registersymbol(findvelocity velocity)

[DISABLE]

findvelocity:
db F3 0F 11 83 D8 00 00 00
unregistersymbol(findvelocity velocity)
dealloc(newmemfindvelocity velocity)
</AssemblerScript>
