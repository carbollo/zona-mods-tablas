nop 2
returnGETPLAYERCAM:
registersymbol(GETPLAYERCAM player_cam)

[DISABLE]

GETPLAYERCAM:
db 80 BF C0 00 00 00 00
unregistersymbol(GETPLAYERCAM player_cam)
dealloc(newmemGETPLAYERCAM player_cam)
