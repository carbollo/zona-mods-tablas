grwtme=createTimer() grwtme.interval=100 grwtme.ontimer=function()

  local plant_base=getAddressSafe('[plant_base]')

    if plant_base then

      local MoistureCapacity=getAddressSafe('[[plant_base]+20]+214')
      local currentMoistureAmount=getAddressSafe('[[plant_base]+20]+2FC')

      local SoilCapacity=getAddressSafe('[[plant_base]+20]+210')
      local currentSoilAmount=getAddressSafe('[[plant_base]+20]+2F8')

      local moistureDrainPerHour=getAddressSafe('[[plant_base]+20]+21C')


      local BaseYieldQuantity=getAddressSafe('[plant_base]+7C')


      writeFloat(moistureDrainPerHour,0)
      writeFloat(currentSoilAmount,readFloat(SoilCapacity))
      writeFloat(currentMoistureAmount,readFloat(MoistureCapacity))


    end

end


