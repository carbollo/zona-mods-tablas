                  <ID>368269</ID>
                  <Description>"Max addicted customers ++"</Description>
                  <Options moHideChildren="1"/>
                  <Color>0000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game   : Schedule I.exe
  Version: 
  Date   : 2025-03-28
  Author : Bytrl

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(findCustomers,GameAssembly.dll,48 * * * * * * 83 * * * * * * 75 * E8 * * * * 45 * * 33 * 48 * * E8 * * * * 84 * 74 * 33 * 48 * * E8 * * * * 48 * * * * 48 * * * 5F C3 CC CC CC CC CC)
