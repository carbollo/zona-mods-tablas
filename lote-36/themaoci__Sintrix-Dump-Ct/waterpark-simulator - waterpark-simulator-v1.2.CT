              <Description>"Flight Space/LB-[up]  C/RB-[down]"</Description>
              <Color>80FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

if not getAddressSafe('getPcorsd') then autoAssemble([[
// 44 0F 58 01 85 D2 0F 89 46 FF FF FF 44 0F 28 5C 24 30 48
aobscanmodule(getPcorsd,UnityPlayer.dll,44 * * * 85 * 0F * * * * * 44 * * * * * 48 * * * * 45)
alloc(newmemgetPcorsd,$100,getPcorsd)
alloc(pCords,8,getPcorsd)
label(codegetPcorsd returngetPcorsd)
newmemgetPcorsd:
cmp [rcx+a10],(float)1.200
jne codegetPcorsd
mov [pCords],rcx
codegetPcorsd:
addps xmm8,[rcx]
test edx,edx
jmp returngetPcorsd
getPcorsd:
jmp newmemgetPcorsd
nop 1
returngetPcorsd:
registersymbol(getPcorsd pCords)]]) end

autoAssemble([[
aobscanmodule(fixpVelocity,UnityPlayer.dll,F3 * * * * * * * F3 * * * * * * * 0F * * F2 * * * F3 * * * * C3 CC CC CC CC CC CC CC CC CC CC CC 8B * * * * * C1)
alloc(newmemfixpVelocity,$100,fixpVelocity)
alloc(pVelocity,8,fixpVelocity)
label(codefixpVelocity returnfixpVelocity)
newmemfixpVelocity:
mov [pVelocity],rcx
codefixpVelocity:
movss xmm0,[rcx+00000094]
jmp returnfixpVelocity
fixpVelocity:
jmp newmemfixpVelocity
nop 3
returnfixpVelocity:
registersymbol(fixpVelocity pVelocity)]])


autoAssemble([[
aobscanmodule(findPitchYaw,UnityPlayer.dll,F3 * * * * 41 * * * F3 * * * * F3 * * * * F3 * * * * F3 * * * * F3 * * * * F3 * * * * F3 * * * F3 * * * F3 * * * F3 * * * 0F * * F3 * * * 0F * * 77 * 0F * * F3 * * * EB * 0F * * E8 * * * * 0F * * F3 * * * * F3)
alloc(newmemfindPitchYaw,$100,findPitchYaw)
alloc(pitch,8,findPitchYaw)
label(codefindPitchYaw returnfindPitchYaw)

newmemfindPitchYaw:
cmp r14,1
jne codefindPitchYaw
mov [pitch],rbx

codefindPitchYaw:
movss [rbx+44],xmm1
jmp returnfindPitchYaw

findPitchYaw:
jmp newmemfindPitchYaw
returnfindPitchYaw:
registersymbol(findPitchYaw pitch)]])

local lastTick=nil
local targetZ=nil

flightTmr=createTimer()
flightTmr.Interval=1
flightTmr.onTimer=function()

  local velocity_x=getAddressSafe('[pVelocity]+94')
  local velocity_y=getAddressSafe('[pVelocity]+9C')
  local cord_z=getAddressSafe('[pCords]+4')
  local yaw_addr=getAddressSafe('[pitch]+48')

  if velocity_x and yaw_addr then
      local now=getTickCount()
      local dt=lastTick and ((now-lastTick)/1000) or (flightTmr.Interval/1000)
      lastTick=now

      local yaw=readFloat(yaw_addr); yaw=math.rad(yaw)

      local speed=50.0
      local flySpeed=40.0

      local forward=isKeyPressed(0x57) and 1 or 0
      local backward=isKeyPressed(0x53) and 1 or 0
      local left=isKeyPressed(0x41) and 1 or 0
      local right=isKeyPressed(0x44) and 1 or 0
      local up=isKeyPressed(VK_SPACE) and 1 or 0
      local down=isKeyPressed(VK_SHIFT) and 1 or 0

      local pad=getXBox360ControllerState(0)
      if pad then
        local deadzone=8000
        local lx=math.abs(pad.ThumbLeftX)&gt;deadzone and pad.ThumbLeftX or 0
        local ly=math.abs(pad.ThumbLeftY)&gt;deadzone and pad.ThumbLeftY or 0

        forward=ly&gt;0 and 1 or forward
        backward=ly&lt;0 and 1 or backward
        right=lx&gt;0 and 1 or right
        left=lx&lt;0 and 1 or left

        up=pad.GAMEPAD_LEFT_SHOULDER and 1 or up
        down=pad.GAMEPAD_RIGHT_SHOULDER and 1 or down
      end

      local moveX,moveY=0,0

      local fb=forward-backward
      moveX=moveX+math.sin(yaw)*fb
      moveY=moveY+math.cos(yaw)*fb

      local lr=right-left
      moveX=moveX+math.sin(yaw+math.pi/2)*lr
      moveY=moveY+math.cos(yaw+math.pi/2)*lr

      local mag=math.sqrt(moveX*moveX+moveY*moveY)
      if mag&gt;0 then
        moveX=(moveX/mag)*speed
        moveY=(moveY/mag)*speed
      end

      writeFloat(velocity_x,moveX)
      writeFloat(velocity_y,moveY)

      if cord_z then
        local z=readFloat(cord_z) or 0.0
        if targetZ==nil then targetZ=z end

        local moveZ=(up-down)*flySpeed
        if moveZ~=0 then
          targetZ=targetZ+(moveZ*dt)
        end

        -- keep altitude when no input
        writeFloat(cord_z,targetZ)
      end
  end
end



[DISABLE]
writeFloat(getAddressSafe('[pBase]+2CC'),2)
if flightTmr then flightTmr.destroy() flightTmr=nil end

autoAssemble([[
fixpVelocity:
db F3 0F 10 81 94 00 00 00
unregistersymbol(fixpVelocity pVelocity)
dealloc(newmemfixpVelocity pVelocity)]])


autoAssemble([[
findPitchYaw:
db F3 0F 11 4B 44
unregistersymbol(findPitchYaw pitch)
dealloc(newmemfindPitchYaw pitch)]])

