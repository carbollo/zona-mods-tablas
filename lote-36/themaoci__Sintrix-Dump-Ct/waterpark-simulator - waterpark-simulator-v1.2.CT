local function checkKeys()
  --
  local x=getAddressSafe('[pCords]+0')
  local z=getAddressSafe('[pCords]+4')
  local y=getAddressSafe('[pCords]+8')
  --
  if isKeyPressed(VK_DOWN) then speak('location saved')
    coordx=readFloat(x)
    coordy=readFloat(y)
    coordz=readFloat(z)
  end
  --
  if isKeyPressed(VK_UP) then speak('teleport')
    writeFloat(x,coordx)
    writeFloat(y,coordy)
    writeFloat(z,coordz)
  end
end

tt=createTimer(nil) timer_setInterval(tt,10) timer_onTimer(tt,checkKeys) timer_setEnabled(tt,true)

[DISABLE]
--teleport timer
timer_setEnabled(tt,false)


