  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>2</ID>
      <Description>"WaterparkSimulator"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

--backup openProcess
--LaunchMonoDataCollector(mono_initialize(openProcess("WaterparkSimulator.exe")))
--Bytrl's ct style function
local function ald(description) local al=getAddressList() local rec=al.getMemoryRecordByDescription(description) if rec then return rec end rec=al.createMemoryRecord() rec.Description=description rec.IsGroupHeader=true rec.Options="" rec.Type=vtCustom rec.DontSave=false rec.Active=false return rec end
--sinatrix shit
local s=findTableFile('SintrixLua.lua').Stream load(readStringLocal(s.Memory,s.Size))() setAddressListPicture('sintrix.jpg', 210, 0x0000FF) startTable('WaterparkSimulator.exe','Waterpark Simulator Table v1.0', 'Waterpark Simulator x Sintrix', 'Bytrl')
--check ce settings
if not MainForm then MainForm=getMainForm() end local cbNeverChangeProtection=getSettingsForm():findComponentByName("cbNeverChangeProtection") local btnOK=getSettingsForm():findComponentByName("btnOK") if cbNeverChangeProtection and cbNeverChangeProtection.Checked == true then cbNeverChangeProtection.Checked = false MainForm.findComponentByName('SettingsButton').doClick() end

autoAssemble([[
alloc(newmem,100,PlayerMovementController:Update+f)
alloc(pBase,8,PlayerMovementController:Update+f)
label(returnhere)
label(originalcode)
label(exit)
newmem:
mov [pBase],rsi
originalcode:
movzx eax,byte ptr [rsi+00000129]
exit:
jmp returnhere
PlayerMovementController:Update+f:
jmp newmem
nop 2
returnhere:
registersymbol(pBase)

aobscanregion(targetOpcode,GameManager:Update,GameManager:Update+5d,48 8B 86 A8 00 00 00)
alloc(newmem333,100,targetOpcode)
alloc(gameManager,8,targetOpcode)
label(returnhere333 originalcode333 exit333)
newmem333:
mov [gameManager],rsi
originalcode333:
mov rax,[rsi+000000A8]
exit333:
jmp returnhere333
targetOpcode:
jmp newmem333
nop 2
returnhere333:
registersymbol(targetOpcode newmem333 GameManager)
]])

--open scripts once
getAddressList().getMemoryRecordByDescription('scripts').Active=true

wptmr=createTimer() wptmr.Interval=500 wptmr.onTimer=function()

  local pushStrengthMultiplier=getAddressSafe('[[[pbase]+50]+E8]+84')
  local parkPrestige=getAddressSafe('[[gameManager]+168]+58')
  local speedMultiplier=getAddressSafe('[pbase]+9C')
  local jumpHeight=getAddressSafe('[pbase]+A8')
  local Gravity=getAddressSafe('[pbase]+AC')
  local staffCapacity=getAddressSafe('[[gameManager]+100]+A8')
  local ResearchPoints=getAddressSafe('[[[gameManager]+A0]+98]+58')
  local cash=getAddressSafe('[[[gameManager]+98]+90]+58')
  local ticketPrice=getAddressSafe('[[gameManager]+98]+CC')
  local maxNumberOfVisitors=getAddressSafe('[[gameManager]+1C0]+58')
  local maxExpectedVisitors=getAddressSafe('[[gameManager]+1B8]+58')
  local currentSatisfaction=getAddressSafe('[[gameManager]+1C8]+58')
  local funSatisfaction=getAddressSafe('[[gameManager]+1D0]+58')
  local energySatisfaction=getAddressSafe('[[gameManager]+1D8]+58')
  local hygeineSatisfaction=getAddressSafe('[[gameManager]+1E0]+58')
  local hungerSatisfaction=getAddressSafe('[[gameManager]+1E8]+58')
  local thirstSatisfaction=getAddressSafe('[[gameManager]+1F0]+58')
  local toiletSatisfaction=getAddressSafe('[[gameManager]+1F8]+58')
  local trashSatisfaction=getAddressSafe('[[gameManager]+200]+58')
  local parkCloseHour=getAddressSafe('[[gameManager]+A8]+EC')


    if ald('Super punch').Active==true and pushStrengthMultiplier then
        writeFloat(pushStrengthMultiplier,100)
    else
        writeFloat(pushStrengthMultiplier,20)
    end


    if ald('Max park prestige').Active==true and parkPrestige then
        writeFloat(parkPrestige,5)
        ald('Max park prestige').Active=false
        showMessage('Park prestige set to max, save to see visually on sign')
    end


    if ald('Increase run/sprint speed').Active==true and speedMultiplier then
        writeFloat(speedMultiplier,2)
    else
        writeFloat(speedMultiplier,1)
    end


    if ald('Increase jump height').Active==true and jumpHeight then
        writeFloat(jumpHeight,5)
    else
        writeFloat(jumpHeight,1.600000024)
    end


    if ald('Lower gravity').Active==true and Gravity then
        writeFloat(Gravity,-5)
    else
        writeFloat(Gravity,-15)
    end


    if ald('Max staff capacity').Active==true and staffCapacity then
        writeInteger(staffCapacity,999)
        ald('Max staff capacity').Active=false
        showMessage('Staff cap set to 999, hire as many as youd like!')
    end


    if ald('Get 10 research points per click').Active==true and ResearchPoints then
        writeFloat(ResearchPoints,readFloat(ResearchPoints)+10)
        ald('Get 10 research points per click').Active=false
    end



    if ald('Get $50000 per click').Active==true and cash then
        writeFloat(cash,readFloat(cash)+50000)
        ald('Get $50000 per click').Active=false
    end



    if ald('Set base ticket price').Active == true and ticketPrice then
        ald('Set base ticket price').Active=false
            local userInput=inputQuery('Set a base ticket price', 'Enter price:', '100.0')
            local value=tonumber(userInput)
            if value~=nil then
                writeFloat(ticketPrice,value)
            end
    end


    if ald('Max expected visitors').Active==true and maxNumberOfVisitors then
        writeInteger(maxNumberOfVisitors,999)
        writeInteger(maxExpectedVisitors,999)
    end


    if ald('Max satisfaction').Active==true and currentSatisfaction then
        writeFloat(currentSatisfaction,1)
        writeFloat(funSatisfaction,1)
        writeFloat(energySatisfaction,1)
        writeFloat(hygeineSatisfaction,1)
        writeFloat(hungerSatisfaction,1)
        writeFloat(thirstSatisfaction,1)
        writeFloat(toiletSatisfaction,1)
        writeFloat(trashSatisfaction,1)
    end


    if ald('End day').Active==true and parkCloseHour then
        writeInteger(parkCloseHour,10)
        sleep(1000)
        ald('End day').Active=false
      else
        if readInteger(parkCloseHour) == 10 then writeInteger(parkCloseHour,18) end
    end


end

