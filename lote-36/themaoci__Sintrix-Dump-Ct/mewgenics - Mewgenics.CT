aobscanmodule(ManaPoint,Mewgenics.exe,89 8F 18 0D 00 00)
alloc(ManaAlloc,$1000,ManaPoint)
label(code return)


ManaAlloc:
  cmp [rdi+d10],1
  jne code
  mov ecx,[rdi+D1C]
  mov [rdi+00000D18],ecx
  jmp return
code:
  mov [rdi+00000D18],ecx
  jmp return

ManaPoint:
  jmp ManaAlloc
  nop
return:
registersymbol(ManaPoint)

