[ENABLE]
local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) local bufferSize = 4096 local buffer = createMemoryStream() while src.Position &lt; src.Size do local toRead = math.min(bufferSize, src.Size - src.Position) buffer.Size = 0 buffer.copyFrom(src, toRead) buffer.Position = 0 dst.copyFrom(buffer, buffer.Size) end buffer.destroy() dst.destroy() return outPath end local dll="Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll if not fileExists(outPath) then eTFTD(dll,outPath) loadPlugin(outPath) else loadPlugin(outPath) end
setAddressListPicture(imageUrl,210,0x0000FF)
startTable(game,title,footer,creator,isMono)
--MainForm.Width=700 MainForm.Height=600

local function asmCode()

  autoAssemble([[
aobscanmodule(GodmodeOSK,Mewgenics.exe,41 89 86 B0 04 00 00 41 8B 8E BC)
alloc(GodmodeOskAlooc,$1000,GodmodeOSK)

label(code return)

GodmodeOskAlooc:
  cmp [r14+C94],1
  jne FlagCheck
  cmp [Godmode],1
  jne code
  mov [r14+000004B0],#100
  jmp return

FlagCheck:
  cmp [OSK],1
  jne code
  xor eax,eax
  mov [r14+000004B0],eax
  jmp return
code:
  mov [r14+000004B0],eax
  jmp return

Godmode:
dd 0

OSK:
dd 0

GodmodeOSK:
  jmp GodmodeOskAlooc
  nop 2
return:
registersymbol(GodmodeOSK OSK Godmode)
]])
  autoAssemble([[
aobscanmodule(MainHousePoint,Mewgenics.exe,8B * * * * * 8B * 3B * 0F * * 89 * * * * * EB * E8)
alloc(newmemMainHousePoint,$100,MainHousePoint)
alloc(MainHouseInvPtr,8,MainHousePoint)
label(codeMainHousePoint returnMainHousePoint)

newmemMainHousePoint:
mov [MainHouseInvPtr],rcx

codeMainHousePoint:
mov edx,[rcx+000000B0]
jmp returnMainHousePoint

MainHousePoint:
jmp newmemMainHousePoint
nop 1
returnMainHousePoint:
registersymbol(MainHousePoint MainHouseInvPtr)
]])
  autoAssemble([[]])

end

if isMono==true then iav(monoAddress,asmCode) else asmCode() end --wait for mono

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()
--------------------------------------------

local Nodescription=getAddressSafe('Godmode')
if Nodescription and ald('Godmode').Active==true then
  if not _G.OldNodescription then
    _G.OldNodescription = readByte(Nodescription)
  end
  writeByte(Nodescription,1)
else
  if _G.OldNodescription then
    writeByte(Nodescription,_G.OldNodescription)
    _G.OldNodescription=nil
  end
end
--------------------------------------------

local OHKFlag=getAddressSafe('OSK')
if OHKFlag and ald('One Hit Kill').Active==true then
  if not _G.OldOHKFlag then
    _G.OldOHKFlag = readByte(OHKFlag)
  end
  writeByte(OHKFlag,1)
else
  if _G.OldOHKFlag then
    writeByte(OHKFlag,_G.OldOHKFlag)
    _G.OldOHKFlag=nil
  end
end

end

[DISABLE]

autoAssemble([[GodmodeOSK:
  db 41 89 86 B0 04 00 00

unregistersymbol(GodmodeOSK OSK Godmode)
dealloc(GodmodeOskAlooc)]])
autoAssemble([[MainHousePoint:
db 8B 91 B0 00 00 00
unregistersymbol(MainHousePoint MainHouseInvPtr)
dealloc(newmemMainHousePoint MainHouseInvPtr)]])
autoAssemble([[]])

if _tmr then _tmr.destroy() _tmr=nil end


