registersymbol(speedhackdet obytes_shd)
label(code return)

obytes_shd:
readmem(speedhackdetect,10)

newmem:

code:
  mov edi,[ebp+08]
  cmp byte ptr [edi+2A],00
  mov [speedhackdet], edi
  mov byte ptr [edi+20],00
  mov byte ptr [edi+10],00
  mov byte ptr [edi+14],00
  mov byte ptr [edi+18],00
  mov byte ptr [edi+19],00
  mov byte ptr [edi+20],00
  mov byte ptr [edi+2a],00
  mov byte ptr [edi+29],00
  jmp return

speedhackdetect:
  jmp newmem
  nop 2
return:
registersymbol(speedhackdetect)
[DISABLE]

speedhackdetect:
readmem(obytes_shd,10)

dealloc(*)
unregistersymbol(*)

