<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>105</ID>
      <Description>"Enable"</Description>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'The Braves.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end


--Set Window Title
local title = "The Braves v1.4.2 InDev";
if not((MainForm.Caption):match("The Braves")) then
MainForm.Caption = title..' ~ '..MainForm.Caption
end

--Credits
if MainForm.lblSigned.Caption:match('By Shaggalicious / Build 15841090') == nil then
  local Main = MainForm.lblSigned
  local MadeBy = createPanel(Main.Parent)


  MadeBy.AutoSize = true
  MadeBy.Anchors = '[akTop,akRight,akLeft]'
  MadeBy.AnchorSideTop.Control = MadeBy.Parent
  MadeBy.AnchorSideTop.Side = asrCenter
  MadeBy.AnchorSideRight.Control = MainForm.CommentButton
  MadeBy.AnchorSideRight.Side = asrLeft
  MadeBy.AnchorSideLeft.Control = MainForm.advancedbutton
  MadeBy.AnchorSideLeft.Side = asrRight

  Main.Parent = MadeBy
  Main.Visible = true
  Main.Caption = 'By Shaggalicious / Build 15841090'
  Main.Font.Size = 12
  Main.Font.Style = '[fsBold]'
  Main.Font.Quality = 'fqCleartypeNatural'
  Main.AnchorSideTop.Control = MadeBy
  Main.AnchorSideTop.Side = asrCenter
  Main.AnchorSideLeft.Control = MadeBy
  Main.AnchorSideLeft.Side = asrCenter
end

--Add Compact Mode Function
function cycleFullCompact(sender,force)
    local state = not(compactmenuitem.Caption == 'Compact View Mode');
         if force~=nil then
            state = not force
         end;
         compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode';
         getMainForm().Splitter1.Visible = state;
         getMainForm().Panel4.Visible    = state;
         getMainForm().Panel5.Visible    = state;
         end;
         function addCompactMenu() if compactmenualreadyexists then return end;
         local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent);
         parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode';
         compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes';
end;
--Set Compact Mode
addCompactMenu();
cycleFullCompact(nil,true);

getMainForm().Panel4.Visible = true;
{$asm}
[DISABLE]


</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>918</ID>
          <Description>"Initialize Mono"</Description>
          <Color>FFFF00</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$Lua}
if syntaxcheck then return end
if not monopipe then if LaunchMonoDataCollector() == 0 then

if process == nil then ShowMessage('Process is not selected.')
elseif readInteger(process) == 0 then ShowMessage('Process cannot be opened. Gone?')
else
  if (monopipe~=nil) and (monopipe.ProcessID~=getOpenedProcessID()) then
    monopipe.destroy()
    monopipe=nil
  end
  if (monopipe==nil) then
    LaunchMonoDataCollector()
    -- monoSymbolList is only available if the target is il2cpp and not normal mono
    --while (monoSymbolList==nil) or (not monoSymbolList.FullyLoaded) do checkSynchronize(50) end -- checkSynchronize requires that memRec is ASynch.
  end
end
end end

