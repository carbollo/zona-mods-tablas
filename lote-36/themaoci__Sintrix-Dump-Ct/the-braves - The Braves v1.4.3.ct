                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Send @ Sintrix
define(address,"GameAssembly.dll"+32154F)
define(bytes,8A 40 2A C3 E9 C8 18 F5 FF)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  mov [eax+10],00
  mov [eax+14],00
  mov [eax+18],00
  mov [eax+19],00
  mov [eax+20],00
  mov [eax+2a],00
  mov [eax+29],00
code:
  mov al,[eax+2A]
  ret 
  jmp GameAssembly.il2cpp_method_get_class+90
  jmp return

address:
  jmp newmem
  nop 4
return:

[DISABLE]

address:
  db bytes

dealloc(newmem)

</AssemblerScript>
