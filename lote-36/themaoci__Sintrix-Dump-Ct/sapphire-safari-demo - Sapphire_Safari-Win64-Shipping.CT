  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Load Scripts from lua file
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
-- set background picture
setAddressListPicture('sintrix.jpg', 210, 0x0000FF)
-- start table script : (process , title, footer)
startTable('Sapphire_Safari-Win64-Shipping.exe','', 'Sapphire Safari Demo x SINTRIX')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>775</ID>
          <Description>"Custom Movement Speed"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(setWalkSpeed,Sapphire_Safari-Win64-Shipping.exe,F3 0F 10 83 48 02 00 00 48)
alloc(newmem,$1000,setWalkSpeed)
registersymbol(walkspeed)
label(code return walkspeed)

newmem:

code:
  movss xmm0,[walkspeed]
  jmp return

walkspeed:
dd (float)400

setWalkSpeed:
  jmp newmem
  nop 3
return:
registersymbol(setWalkSpeed)

[DISABLE]

setWalkSpeed:
  db F3 0F 10 83 48 02 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>776</ID>
              <Description>"Set Movement Speed"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Float</VariableType>
              <Address>walkspeed</Address>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>785</ID>
          <Description>"*Experimental* Stealth Mode (Enable After In Game World)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : Sapphire_Safari-Win64-Shipping.exe
