  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>917</ID>
      <Description>"Ride-Win64-Shipping.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local function ald(description) local al=getAddressList() local rec=al.getMemoryRecordByDescription(description) if rec then return rec end rec=al.createMemoryRecord() rec.Description=description rec.IsGroupHeader=true rec.Options="" rec.Type=vtCustom rec.DontSave=false rec.Active=false return rec end
local s=findTableFile('SintrixLuaMonoParam.lua').Stream load(readStringLocal(s.Memory,s.Size))() setAddressListPicture('sintrix.jpg', 210, 0x0000FF) startTable('Ride-Win64-Shipping.exe','Ride-Win64-Shipping.exe Table v1.0', 'Ride-Win64-Shipping.exe v1.0', 'Bytrl-Yem')


autoAssemble([[

aobscanmodule(ride_win,Ride-Win64-Shipping.exe,48 * * * * * * 48 * * 74 * 48 * * E8 * * * * 49 * * 75 * 48 * * 41 * * 33)
alloc(newmemride_win,$100,ride_win)
alloc(ride,8,ride_win)
label(coderide_win returnride_win)
newmemride_win:
mov [ride],rax
coderide_win:
mov rdi,[rax+00000228]
jmp returnride_win
ride_win:
jmp newmemride_win
nop 2
returnride_win:
registersymbol(ride_win ride)

aobscanmodule(findscrap,Ride-Win64-Shipping.exe,48 89 83 D8 02 00 00 48 83)
alloc(newmemsc,$100,findscrap)
alloc(scrap_base,8,findscrap)
label(codesc returnsc)
newmemsc:
mov [scrap_base],rbx
codesc:
  mov [rbx+000002D8],rax
  jmp returnsc
findscrap:
  jmp newmemsc
  nop 2
returnsc:
registersymbol(findscrap scrap_base)


aobscanmodule(player_walkspeed,Ride-Win64-Shipping.exe,F3 * * * * * * * 48 * * * 5B C3 F3 * * * * * * * 48 * * * 5B C3 F3 * * * * * * * 48 * * * 5B C3 F3 * * * * * * * 48 * * * 5B C3 0F * * 48 * * * 5B C3 90 62 * A9)
alloc(newmemplayer_walkspeed,$100,player_walkspeed)
alloc(walkspeed,8,player_walkspeed)
label(codeplayer_walkspeed returnplayer_walkspeed)
newmemplayer_walkspeed:
mov [walkspeed],rbx
codeplayer_walkspeed:
movss xmm0,[rbx+00000278]
jmp returnplayer_walkspeed
player_walkspeed:
jmp newmemplayer_walkspeed
nop 3
returnplayer_walkspeed:
registersymbol(player_walkspeed walkspeed)

]])

--=========================================================
mbtmr=createTimer() mbtmr.Interval=500 mbtmr.onTimer=function()

local pBase=getAddressSafe('[walkspeed]')
local base2=getAddressSafe('[scrap_base]')
local base=getAddressSafe('[ride]') registerSymbol('base',base)
local base1=getAddressSafe('[[[[[[ride]+228]+38]+00]+30]+2F8]') registerSymbol('base1',base1)


if pBase and base and base2 then

--[[

[[[[[[ride]+38]+00]+30]+2F8]+330]+278 --walk speed
[[[[[[ride]+38]+00]+30]+2F8]+330]+1A8 --jump height
strengthMult=getAddressSafe("[[[[[[[ride]+38]+00]+30]+790]+2C8]+320]+BF8") --strength mult

]]


       strengthMult=getAddressSafe("[[[[[[[ride]+38]+00]+30]+790]+2C8]+320]+BF8")
       noClipFlag=getAddressSafe("[base1+338]+38F")
       gravity=getAddressSafe("[base1+330]+231")
       clipspeed=getAddressSafe("[base1+330]+284")
       beer=getAddressSafe('[[[Ride-Win64-Shipping.exe+092B9650]+10]+A0]+738')
       pwalkSpeed=pBase+0x278
       jumpHeight=pBase+0x1A8
       scrap=base2+0x34c
       epipen=base2+0x348


      if ald('Inf scrap').Active == true then writeInteger(scrap,999) end
      if ald('Inf epipens').Active == true then writeInteger(epipen,999) end
      if ald('Increase walk speed').Active == true then writeFloat(pwalkSpeed,2000) else writeFloat(pwalkSpeed,600) end
      if ald('Increase jump height').Active == true then writeFloat(jumpHeight,1200) else writeFloat(jumpHeight,460) end
      if ald('Increase strength multiplier').Active == true then writeDouble(strengthMult,3) else writeDouble(strengthMult,1) end
      if ald('Infinite Beer').Active == true then writeByte(beer,100) else writeByte(beer,6) end

      if noClipFlag and gravity and clipspeed and ald('No clip').Active == true then
        writeByte(noClipFlag,0)
        writeByte(gravity,5)
        writeFloat(clipspeed,5500)
        resetFlags=true
      else
        if resetFlags then
          writeByte(noClipFlag,3)
          writeByte(gravity,1)
          writeFloat(clipspeed,600)
          resetFlags=nil
        end
      end




    end --if base check
end --timer

ald('Scripts').Active = true

[DISABLE]

autoAssemble([[

ride_win:
db 48 8B B8 28 02 00 00
unregistersymbol(ride_win ride)
dealloc(newmemride_win ride)

findscrap:
  db 48 89 83 D8 02 00 00
unregistersymbol(findscrap scrap_base)
dealloc(newmemsc scrap_base)


player_walkspeed:
db F3 0F 10 83 78 02 00 00
unregistersymbol(player_walkspeed walkspeed)
dealloc(newmemplayer_walkspeed walkspeed)

]])
noClipFlag=nil gravity=nil clipspeed=nil
scrap=nil epipen=nil
pwalkSpeed=nil jumpHeight=nil strengthMult=nil
unregisterSymbol('base1') unregisterSymbol('base')
if mbtmr then mbtmr.destroy() mbtmr = nil end

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>918</ID>
          <Description>"bin"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>919</ID>
              <Description>"junk scripts"</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1</ID>
                  <Description>"player_fov"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(player_fov,Ride-Win64-Shipping.exe,F3 * * * * * * * F3 * * * * 8B * * * * * 89 * * 0F * * * * * * 33)
alloc(newmemplayer_fov,$100,player_fov)
alloc(fov,8,player_fov)
label(codeplayer_fov returnplayer_fov)

newmemplayer_fov:
mov [fov],rbx
mov [rbx+00000240],(float)140

codeplayer_fov:
movss xmm0,[rbx+00000240]
jmp returnplayer_fov

player_fov:
jmp newmemplayer_fov
nop 3
returnplayer_fov:
registersymbol(player_fov fov)

[DISABLE]

player_fov:
db F3 0F 10 83 40 02 00 00
unregistersymbol(player_fov fov)
dealloc(newmemplayer_fov fov)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>2</ID>
                      <Description>"fov"</Description>
                      <VariableType>Float</VariableType>
                      <Address>[fov]+240</Address>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>76</ID>
                  <Description>"player_pCords"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(player_pCords,Ride-Win64-Shipping.exe,0F * * * 0F * * * * 0F * * * 0F * * * * 0F * * * 0F * * * * 0F * * * 0F * * * * 48 * * 48 * * * * 48 * * * * 8B * * * 89)
alloc(newmemplayer_pCords,$100,player_pCords)
alloc(pCords,8,player_pCords)
label(codeplayer_pCords returnplayer_pCords)

newmemplayer_pCords:
mov [pCords],rbx

codeplayer_pCords:
movaps xmm0,[rbx+20]
movaps [rcx+rax+20],xmm0
jmp returnplayer_pCords

player_pCords:
jmp newmemplayer_pCords
nop 4
returnplayer_pCords:
registersymbol(player_pCords pCords)

[DISABLE]

player_pCords:
db 0F 28 43 20 0F 29 44 01 20
unregistersymbol(player_pCords pCords)
dealloc(newmemplayer_pCords pCords)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>77</ID>
                      <Description>"base"</Description>
                      <VariableType>4 Bytes</VariableType>
                      <Address>[pCords]+20</Address>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>78</ID>
                          <Description>"x"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>[pCords]+24</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>79</ID>
                          <Description>"y"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>[pCords]+2C</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>80</ID>
                          <Description>"z"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>[pCords]+34</Address>
                        </CheatEntry>
                      </CheatEntries>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>85</ID>
                  <Description>"player_vel"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(player_vel,Ride-Win64-Shipping.exe,F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * F2 * * * * * * * 0F * * * * * * 0F * * * * 0F * * * * * * F2 * * * * * * * F2 * * * * * * * 0F * * * * * * 0F * * * * * * F2 * * * * * * * F2 * * * * * * * 48 * * * 5B C3 CC)
alloc(newmemplayer_vel,$100,player_vel)
alloc(vel,8,player_vel)
label(codeplayer_vel returnplayer_vel)

newmemplayer_vel:
cmp rdi,0
je codeplayer_vel
mov [vel],rbx

codeplayer_vel:
movsd [rbx+000000D0],xmm0
jmp returnplayer_vel

player_vel:
jmp newmemplayer_vel
nop 3
returnplayer_vel:
registersymbol(player_vel vel)

[DISABLE]

player_vel:
db F2 0F 11 83 D0 00 00 00
unregistersymbol(player_vel vel)
dealloc(newmemplayer_vel vel)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>86</ID>
                      <Description>"base"</Description>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>4 Bytes</VariableType>
                      <Address>[vel]+D0</Address>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>91</ID>
                          <Description>"x-vel"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>[vel]+D4</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>92</ID>
                          <Description>"y-vel"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>[vel]+DC</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>93</ID>
