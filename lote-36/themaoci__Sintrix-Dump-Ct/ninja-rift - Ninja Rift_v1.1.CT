<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>766</ID>
      <Description>"Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'Ninja Rift.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end


--Set Window Title
local title = "Ninja Rift 1.1- Sintrix | https://sintrix.net";
if not((MainForm.Caption):match("Ninja Rift")) then
MainForm.Caption = title..' - '..MainForm.Caption
end


[DISABLE]



</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Infinite Health (Take Damage)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscan(dmg,89 46 1C 8B 46 1C 83)
alloc(newmem,$1000)
label(code return)

newmem:
cmp dword ptr [esi+010C],#1
jne code
mov eax,[esi+1C]
mov [esi+1C],eax
mov eax,[esi+1C]
jmp return

code:
  mov [esi+1C],eax
  mov eax,[esi+1C]
  jmp return

dmg:
  jmp newmem
  nop
return:
registersymbol(dmg)

[DISABLE]

dmg:
  db 89 46 1C 8B 46 1C

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>7</ID>
          <Description>"One Hit Kill"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : Ninja Rift.exe
  Version: 
  Date   : 2024-11-12
  Author : 19199

  This script does blah blah blah
}

[ENABLE]

aobscan(ohk,8B 58 1C 66 0F 57 C9) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
cmp dword ptr [eax+34],#0
jne code
mov [eax+1C],#0
mov ebx,[eax+1C]
xorpd xmm1,xmm1
jmp code

code:
  mov ebx,[eax+1C]
  xorpd xmm1,xmm1
  jmp return

ohk:
  jmp newmem
  nop 2
return:
registersymbol(ohk)

[DISABLE]

ohk:
  db 8B 58 1C 66 0F 57 C9

unregistersymbol(ohk)
dealloc(newmem)

{
// ORIGINAL CODE - INJECTION POINT: 1C40BC78

1C40BC4A: F2 0F 5E C1              - divsd xmm0,xmm1
1C40BC4E: 83 EC 08                 - sub esp,08
1C40BC51: 83 EC 08                 - sub esp,08
1C40BC54: 66 0F D6 04 24           - movq [esp],xmm0
1C40BC59: E8 72 09 9F 5C           - call "Adobe AIR.dll"+51C5D0
1C40BC5E: 83 C4 10                 - add esp,10
1C40BC61: 8B 4D 8C                 - mov ecx,[ebp-74]
1C40BC64: 8B 85 74 FF FF FF        - mov eax,[ebp-0000008C]
1C40BC6A: DD 9D 68 FF FF FF        - fstp qword ptr [ebp-00000098]
1C40BC70: F3 0F 7E 85 68 FF FF FF  - movq xmm0,[ebp-00000098]
// ---------- INJECTING HERE ----------
1C40BC78: 8B 58 1C                 - mov ebx,[eax+1C]
// ---------- DONE INJECTING  ----------
1C40BC7B: 66 0F 57 C9              - xorpd xmm1,xmm1
1C40BC7F: F2 0F 2A CB              - cvtsi2sd xmm1,ebx
1C40BC83: 66 0F 2E C1              - ucomisd xmm0,xmm1
1C40BC87: 0F 93 DB                 - setae bl
1C40BC8A: 0F B6 DB                 - movzx ebx,bl
1C40BC8D: C1 E3 03                 - shl ebx,03
1C40BC90: 8D 5B 05                 - lea ebx,[ebx+05]
1C40BC93: 89 9D 74 FF FF FF        - mov [ebp-0000008C],ebx
1C40BC99: 8D 89 48 0C 00 00        - lea ecx,[ecx+00000C48]
1C40BC9F: 8D 55 80                 - lea edx,[ebp-80]
}
</AssemblerScript>
