        <CheatEntry>
          <ID>764</ID>
          <Description>"Infnite Chakra"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscan(cp,8B 48 28 83 F9 00)
