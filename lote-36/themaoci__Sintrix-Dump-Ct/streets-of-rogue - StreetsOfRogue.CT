            <CheatEntry>
              <ID>32</ID>
              <Description>"Infinite Health"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@ModEngine
[ENABLE]
aobscan(healthwrite,F3 0F 11 A8 A0 0A 00 00 33)
alloc(newmem,$1000,healthwrite)
registersymbol(EasyKills)
label(code return EasyKills onehit)

newmem:
cmp dword ptr [rax+0ACC],#1
jne onehit
movss xmm5,[rax+0AD8]
movss [rax+0AA0],xmm5

onehit:
cmp [EasyKills],1
jne code
cmp dword ptr [rax+0ACC],#0
jne code
xorps xmm5,xmm5
jmp code

code:
  movss [rax+00000AA0],xmm5
  jmp return

EasyKills:
dd 0

healthwrite:
  jmp newmem
  nop 3
return:
registersymbol(healthwrite)

[DISABLE]

healthwrite:
  db F3 0F 11 A8 A0 0A 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
            </CheatEntry>
