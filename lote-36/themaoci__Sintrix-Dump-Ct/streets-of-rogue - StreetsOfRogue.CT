      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"Grab Money Data"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@FearlessRevolution|Sintrix
[ENABLE]
aobscanregion(moneydata,MoneySlot:LateUpdateMoneySlot+36,MoneySlot:LateUpdateMoneySlot+4e,48 63 80 F0 00 00 00 48 63 4E 58)
alloc(newmem,$1000,moneydata)
registersymbol(money)
label(code return money)

newmem:
mov [money],rax

code:
  movsxd  rax,dword ptr [rax+000000F0]
  jmp return

money:
dq 0

moneydata:
  jmp newmem
  nop 2
return:
registersymbol(moneydata)

[DISABLE]

moneydata:
  db 48 63 80 F0 00 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>22</ID>
              <Description>"Invisible"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@ModEngine
[ENABLE]

aobscanregion(invisible,Agent:SetLightBrightness+4c6,Agent:SetLightBrightness+4df,0F B6 80 70 0B 00 00 85 C0 0F 85 CD)
alloc(newmem,$1000,invisible)
