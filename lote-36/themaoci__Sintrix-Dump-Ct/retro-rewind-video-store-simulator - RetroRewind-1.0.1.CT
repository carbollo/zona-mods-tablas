        <CheatEntry>
          <ID>1337142596</ID>
          <Description>"Scripts"</Description>
          <Options moHideChildren="1"/>
          <Color>C0C0C0</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1337142628</ID>
              <Description>"Flight +No clip"</Description>
              <Color>C0C0C0</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local VelocityX=getAddressSafe('[[Player_Character_C]+320]+B8')
local VelocityY=getAddressSafe('[[Player_Character_C]+320]+C0')
local VelocityZ=getAddressSafe('[[Player_Character_C]+320]+C8')
local ControlRotationYaw=getAddressSafe('[[Player_Character_C]+140]+310')
local MovementMode=getAddressSafe('[[Player_Character_C]+320]+201')
local BodyInstanceCollisionEnabled=getAddressSafe('[[Player_Character_C]+1A0]+368')

[ENABLE]

if flightTmr then flightTmr.destroy() flightTmr=nil end

local function toRadIfDeg(a)
  if a == nil then return 0 end
  if math.abs(a) &gt; (2*math.pi + 0.5) then
    return math.rad(a)
  end
  return a
end

local function clamp(v, mn, mx)
  if v &lt; mn then return mn end
  if v &gt; mx then return mx end
  return v
end

flightTmr=createTimer() flightTmr.Interval=10 flightTmr.onTimer=function()

  if MovementMode then writeByte(MovementMode, 5) end --flying
  if BodyInstanceCollisionEnabled then writeByte(BodyInstanceCollisionEnabled, 0) end --no clip

  if not (VelocityX and VelocityY and VelocityZ and ControlRotationYaw) then return end

  local yaw = toRadIfDeg(readDouble(ControlRotationYaw) or 0)

  local speed = 1200
  local vertSpeed = 1200

  local forward  = isKeyPressed(0x57) and 1 or 0 -- W
  local backward = isKeyPressed(0x53) and 1 or 0 -- S
  local left     = isKeyPressed(0x41) and 1 or 0 -- A
  local right    = isKeyPressed(0x44) and 1 or 0 -- D
  local upKey    = isKeyPressed(VK_SPACE) and 1 or 0
  local downKey  = isKeyPressed(VK_SHIFT) and 1 or 0

  -- gamepad
  local pad = getXBox360ControllerState(0)
  if pad then
    local deadzone = 8000
    local lx = (math.abs(pad.ThumbLeftX) &gt; deadzone) and (pad.ThumbLeftX / 32767.0) or 0
    local ly = (math.abs(pad.ThumbLeftY) &gt; deadzone) and (pad.ThumbLeftY / 32767.0) or 0

    if ly &gt; 0 then forward  = clamp(ly, 0, 1) end
    if ly &lt; 0 then backward = clamp(-ly, 0, 1) end
    if lx &gt; 0 then right    = clamp(lx, 0, 1) end
    if lx &lt; 0 then left     = clamp(-lx, 0, 1) end

    upKey   = pad.GAMEPAD_LEFT_SHOULDER and 1 or upKey
    downKey = pad.GAMEPAD_RIGHT_SHOULDER and 1 or downKey
  end

  local fb = forward - backward
  local lr = right - left
  local ud = upKey - downKey
  local fwdX, fwdY = math.cos(yaw), math.sin(yaw)
  local rgtX, rgtY = -math.sin(yaw), math.cos(yaw)

  local moveX = (fwdX * fb + rgtX * lr) * speed
  local moveY = (fwdY * fb + rgtY * lr) * speed
  local moveZ = ud * vertSpeed

  writeDouble(VelocityX, moveX)
  writeDouble(VelocityY, moveY)
  writeDouble(VelocityZ, moveZ)
end

[DISABLE]
if flightTmr then flightTmr.destroy() flightTmr=nil end

if MovementMode then writeByte(MovementMode,1) end
if BodyInstanceCollisionEnabled then writeByte(BodyInstanceCollisionEnabled,3) end

</AssemblerScript>
            </CheatEntry>
