  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"RetroRewind-Win64-Shipping.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "_Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]

startTable{
  process = "RetroRewind-Win64-Shipping.exe",
  title = "RetroRewind-Win64-Shipping.exe | ct v1.0.1",
  discord = "https://discord.gg/zRBd7uBBzZ",
  AddressListPic = "https://imgur.com/4pl47YF.png",
  compact = true
}

local function asmCode()

  autoAssemble([[
  aobscanmodule(find_Player_Character_C,RetroRewind-Win64-Shipping.exe,48xxxx33xx4Cxxxxxxxxxxxx48xxxx41xxxx84xx74xx48xxxx48xxxx)
  alloc(newmemfind_Player_Character_C,$100,find_Player_Character_C)
  alloc(Player_Character_C,8,find_Player_Character_C)
  alloc(find_Player_Character_C_savedBytes,5,find_Player_Character_C)
  label(codefind_Player_Character_C returnfind_Player_Character_C)

  find_Player_Character_C_savedBytes:
  readmem(find_Player_Character_C,5)

  newmemfind_Player_Character_C:
  mov [Player_Character_C],rax

  codefind_Player_Character_C:
  mov rcx,[rax]
  xor edx,edx
  jmp returnfind_Player_Character_C

  find_Player_Character_C:
  jmp newmemfind_Player_Character_C
  returnfind_Player_Character_C:
  registersymbol(find_Player_Character_C Player_Character_C find_Player_Character_C_savedBytes)]])

  autoAssemble([[
  aobscanmodule(findAuthGameMode,RetroRewind-Win64-Shipping.exe,)
  alloc(newmemfindAuthGameMode,$100,findAuthGameMode)
  alloc(AuthorityGameMode,8,findAuthGameMode)
  alloc(findAuthGameMode_savedBytes,7,findAuthGameMode)
  label(codefindAuthGameMode returnfindAuthGameMode)

  findAuthGameMode_savedBytes:
  readmem(findAuthGameMode,7)

  newmemfindAuthGameMode:
  mov [AuthorityGameMode],rax

  codefindAuthGameMode:
  mov rax,[rax+00000158]
  jmp returnfindAuthGameMode

  findAuthGameMode:
  jmp newmemfindAuthGameMode
  nop 2
  returnfindAuthGameMode:
  registersymbol(findAuthGameMode AuthorityGameMode findAuthGameMode_savedBytes)]])

end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()


  local InventoryMaxMoviesObjectHoldsize=getAddressSafe('[Player_Character_C]+7C8')
  if InventoryMaxMoviesObjectHoldsize and ald('Hold 999 movies at a time').Active==true then
    if not _G.OldInventoryMaxMoviesObjectHoldsize then _G.OldInventoryMaxMoviesObjectHoldsize = readInteger(InventoryMaxMoviesObjectHoldsize) end
    writeInteger(InventoryMaxMoviesObjectHoldsize,999)
  else
    if _G.OldInventoryMaxMoviesObjectHoldsize then writeInteger(InventoryMaxMoviesObjectHoldsize,_G.OldInventoryMaxMoviesObjectHoldsize) _G.OldInventoryMaxMoviesObjectHoldsize=nil end
  end

  local CustomTimeDilation=getAddressSafe('[Player_Character_C]+68')
  if CustomTimeDilation and ald('Triple Time Dilation').Active==true then
    if not _G.OldCustomTimeDilation then _G.OldCustomTimeDilation = readFloat(CustomTimeDilation) end
    writeFloat(CustomTimeDilation,3)
  else
    if _G.OldCustomTimeDilation then writeFloat(CustomTimeDilation,_G.OldCustomTimeDilation) _G.OldCustomTimeDilation=nil end
  end

  local Cash=getAddressSafe('[[AuthorityGameMode]+158]+348')
  if Cash and ald('Add 10k cash').Active==true then
    ald('Add 10k cash').Active=false
    writeInteger(Cash,readInteger(Cash)+1000000)
  end

  local JumpMaxCount=getAddressSafe('[Player_Character_C]+470')
  if JumpMaxCount and ald('Inf jumps').Active==true then
    if not _G.OldJumpMaxCount then _G.OldJumpMaxCount = readInteger(JumpMaxCount) end
    writeInteger(JumpMaxCount,999)
  else
    if _G.OldJumpMaxCount then writeInteger(JumpMaxCount,_G.OldJumpMaxCount) _G.OldJumpMaxCount=nil end
  end

  local CurrentWeather=getAddressSafe('[[Player_Character_C]+7D0]+2A3')
  if CurrentWeather and ald('Cycle Current Weather').Active==true then
    if not _G.OldCurrentWeather then _G.OldCurrentWeather = readByte(CurrentWeather) end
    if _G.OldCurrentWeather == 0 then writeByte(CurrentWeather,1) end
    if _G.OldCurrentWeather == 1 then writeByte(CurrentWeather,2) end
    if _G.OldCurrentWeather == 2 then writeByte(CurrentWeather,3) end
    if _G.OldCurrentWeather == 3 then writeByte(CurrentWeather,4) end
    if _G.OldCurrentWeather == 4 then writeByte(CurrentWeather,5) end
    if _G.OldCurrentWeather == 5 then writeByte(CurrentWeather,6) end
    if _G.OldCurrentWeather == 6 then writeByte(CurrentWeather,7) end
    if _G.OldCurrentWeather == 7 then writeByte(CurrentWeather,8) end
    if _G.OldCurrentWeather == 8 then writeByte(CurrentWeather,0) end
    ald('Cycle Current Weather').Active=false _G.OldCurrentWeather=nil
  end

  local MaxWalkSpeed=getAddressSafe('[[Player_Character_C]+320]+248')
  if MaxWalkSpeed and ald('Increase Walk Speed').Active==true then
    if not _G.OldMaxWalkSpeed then _G.OldMaxWalkSpeed = readFloat(MaxWalkSpeed) end
    writeFloat(MaxWalkSpeed,800)
  else
    if _G.OldMaxWalkSpeed then writeFloat(MaxWalkSpeed,_G.OldMaxWalkSpeed) _G.OldMaxWalkSpeed=nil end
  end

  local JumpZVelocity=getAddressSafe('[[Player_Character_C]+320]+178')
  if JumpZVelocity and ald('Increase Jump Velocity').Active==true then
    if not _G.OldJumpZVelocity then _G.OldJumpZVelocity = readFloat(JumpZVelocity) end
    writeFloat(JumpZVelocity,800)
  else
    if _G.OldJumpZVelocity then writeFloat(JumpZVelocity,_G.OldJumpZVelocity) _G.OldJumpZVelocity=nil end
  end

  local DefaultGravityScale=getAddressSafe('[Player_Character_C]+748')
  if DefaultGravityScale and ald('Reduce Gravity Scale').Active==true then
    if not _G.OldDefaultGravityScale then _G.OldDefaultGravityScale = readDouble(DefaultGravityScale) end
    writeDouble(DefaultGravityScale,0.5)
  else
    if _G.OldDefaultGravityScale then writeDouble(DefaultGravityScale,_G.OldDefaultGravityScale) _G.OldDefaultGravityScale=nil end
  end

end

ald('Scripts').Active=true
MainForm.Width=427 MainForm.Height=324  --printMainFormSize()

[DISABLE]

autoAssemble([[
find_Player_Character_C:
readmem(find_Player_Character_C_savedBytes,5)
unregistersymbol(find_Player_Character_C Player_Character_C find_Player_Character_C_savedBytes)
dealloc(newmemfind_Player_Character_C Player_Character_C find_Player_Character_C_savedBytes)]])

autoAssemble([[
findAuthGameMode:
readmem(findAuthGameMode_savedBytes,7)
unregistersymbol(findAuthGameMode AuthorityGameMode findAuthGameMode_savedBytes)
dealloc(newmemfindAuthGameMode AuthorityGameMode findAuthGameMode_savedBytes)]])

if _tmr then _tmr.destroy() _tmr=nil end
</AssemblerScript>
