        <CheatEntry>
          <ID>747</ID>
          <Description>"-&gt; Player Functions"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end
local Base= getAddress("UnityPlayer.dll");
local mBase= Base+0x017A35C0;
local playerstatusPointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(mBase)+0x3B8)+0x38)+0x18)+0x8)+0x198)+0x0)+0x780;
registerSymbol("playrstatusPointer", playerstatusPointer );
playerstatusPointerstring = string.format("0x%X",playerstatusPointer )

{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>748</ID>
              <Description>"Full Health"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$Lua}
if syntaxcheck then return end

if not monopipe then if LaunchMonoDataCollector() == 0 then  error(MessageDialog('Failed to Launch Mono Data Collector', mtError, mbClose)) end end

local method = mono_findMethod('', 'PlayerStatus', 'Heal')
local args={}
args[1]={}
args[1].type=vtSingle
args[1].value = 100
local address = playerstatusPointerstring
mono_invoke_method('', method, address,args)

if not syntaxcheck then
   synchronize(createTimer,60,memrec.setActive,false)
  end

{$asm}
[DISABLE]
</AssemblerScript>
            </CheatEntry>
