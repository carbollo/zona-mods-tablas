            <CheatEntry>
              <ID>602</ID>
              <Description>"Scan for legit (leaderboard manipulation)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(scanForLegit,GameAssembly.dll,80 * * * B0 * 74 * 48 * * * * * * 4C * * * 4C * * * 49)
alloc(newmemscanForLegit,$100,scanForLegit)
alloc(scan,8,scanForLegit)
label(codescanForLegit returnscanForLegit)
newmemscanForLegit:
cmp [rdi+FC],0
jne codescanForLegit
mov [scan],rdi
//mov [rdi+4D],0
codescanForLegit:
cmp byte ptr [rdi+4D],00
mov al,01
jmp returnscanForLegit
scanForLegit:
jmp newmemscanForLegit
nop 1
returnscanForLegit:
registersymbol(scanForLegit scan)

 
 
[DISABLE]

scanForLegit:
db 80 7F 4D 00 B0 01
unregistersymbol(scanForLegit scan)
dealloc(newmemscanForLegit scan)
</AssemblerScript>
