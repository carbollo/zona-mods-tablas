  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"MegaBonk.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end


[ENABLE]

local function ald(description) local al=getAddressList() local rec=al.getMemoryRecordByDescription(description) if rec then return rec end rec=al.createMemoryRecord() rec.Description=description rec.IsGroupHeader=true rec.Options="" rec.Type=vtCustom rec.DontSave=false rec.Active=false return rec end
local s=findTableFile('SintrixLua.lua').Stream load(readStringLocal(s.Memory,s.Size))() setAddressListPicture('sintrix.jpg', 210, 0x0000FF) startTable('MegaBonk.exe','MegaBonk.exe Table v1.3', 'MegaBonk.exe v1.3', 'Bytrl - Yem')


autoAssemble([[

// pointer base address
aobscanmodule(pointerbaseF,GameAssembly.dll,00 00 FF 7F 03)
define(pointerbase,pointerbaseF-6)
registersymbol(pointerbase)

aobscanmodule(getcoins,GameAssembly.dll,F3 0F 11 77 68 76 07)
alloc(newmem8,$100,getcoins)
alloc(coins_base,8,getcoins)
label(code8 return8)
newmem8:
mov [coins_base],rdi
code8:
  movss [rdi+68],xmm6
  jmp return8
getcoins:
  jmp newmem8
return8:
registersymbol(getcoins coins_base)

aobscanmodule(getsilver,GameAssembly.dll,01 7B 14 EB 07)
define(jumptoaddress,getsilver+c)
alloc(newmem67,$100,getsilver)
alloc(silver,8,getsilver)
label(code67 return67)
newmem67:
mov [silver],rbx
code67:
  add [rbx+14],edi
  jmp jumptoaddress
  jmp return67
getsilver:
  jmp newmem67
return67:
registersymbol(getsilver jumptoaddress silver)

aobscanmodule(findlevel,GameAssembly.dll,01 7B 10 48 8B 05 BC 9A C7 02)
alloc(newmemfindlevel,$100,findlevel)
alloc(level,8,findlevel)
label(codefindlevel returnfindlevel)
newmemfindlevel:
mov [level],rbx
codefindlevel:
add [rbx+10],edi
mov rax,[GameAssembly.dll.data+EA838]
jmp returnfindlevel
findlevel:
jmp newmemfindlevel
nop 5
returnfindlevel:
registersymbol(findlevel level)

]])


mbtmr=createTimer() mbtmr.Interval=500 mbtmr.onTimer=function()

--local base=getAddressSafe("[[[[[[GameAssembly.dll+0303C4F8]+B8]+00]+40]+10]+18]+00") -- old [[[[[[GameAssembly.dll+030383E0]+B8]+00]+20]+10]+18]+00
if getAddressSafe('pointerbase') then base=getAddressSafe("[[[[[[pointerbase]+B8]+00]+40]+10]+18]+00") end


  if base then
    local maxHp=base+0x2c
    local hpRegen=base+0x3c
    local shield=base+0x4c
    local thorns=base+0x5c
    local armor=base+0x6c
    local evasion=base+0x7c
    local projectileSize=base+0xbC
    local projectileSpeed=base+0xdc
    local damage=base+0xEC
    local attackSpeed=base+0x11c
    local projectileCount=base+0x12C
    local lifeSteal=base+0x13C
    local critChance=base+0x14c
    local critDamage=base+0x15c
    local knockback=base+0x1aC
    local jumpHeight=base+0x1CC
    local moveSpeed=base+0x1BC
    local pickupRange=base+0x1FC
    local damageToElites=base+0x19c
    local goldGain=base+0x21c
    local xpGain=base+0x22c
    local luck=base+0x20c
    local difficulty=base+0x28c
    local eliteSpawnChance=base+0x29c
    local powerMultiplier=base+0x2ac
    local powerUpDropChance=base+0x2bc
    local extraJumps=base+0x30c
    local silverGain=base+0x33c
    local gold=getAddressSafe('[coins_base]+68')
    local silver=getAddressSafe('[silver]+14')
    local xp=getAddressSafe('[level]+10')
    local level=getAddressSafe('[level]+14')
    local kills=getAddressSafe('[[[["GameAssembly.dll"+03022E48]+B8]+20]+18]+48')
    local noclip=getAddressSafe('[noclip]+208')
    local chest=getAddressSafe('[Chest]+1C0')
    local gametimer=getAddressSafe('[timer]+44')
    local scanforlegit=getAddressSafe('[scan]+4D')

      if ald('Increase knockback').Active==true then if not knockback_saved then knockback_saved=readFloat(knockback) end writeFloat(knockback,999) else if knockback_saved then writeFloat(knockback,knockback_saved) knockback_saved=nil end end
      if ald('Increase power multiplier').Active==true then if not powerMultiplier_saved then powerMultiplier_saved=readFloat(powerMultiplier) end writeFloat(powerMultiplier,999) else if powerMultiplier_saved then writeFloat(powerMultiplier,powerMultiplier_saved) powerMultiplier_saved=nil end end
      if ald('Increase power up drop chance').Active==true then if not powerUpDropChance_saved then powerUpDropChance_saved=readFloat(powerUpDropChance) end writeFloat(powerUpDropChance,999) else if powerUpDropChance_saved then writeFloat(powerUpDropChance,powerUpDropChance_saved) powerUpDropChance_saved=nil end end
      if ald('Increase elite spawn chance').Active==true then if not eliteSpawnChance_saved then eliteSpawnChance_saved=readFloat(eliteSpawnChance) end writeFloat(eliteSpawnChance,999) else if eliteSpawnChance_saved then writeFloat(eliteSpawnChance,eliteSpawnChance_saved) eliteSpawnChance_saved=nil end end
      if ald('Increase damage to elites').Active==true then if not damageToElites_saved then damageToElites_saved=readFloat(damageToElites) end writeFloat(damageToElites,999) else if damageToElites_saved then writeFloat(damageToElites,damageToElites_saved) damageToElites_saved=nil end end
      if ald('Increase xp gain').Active==true then if not xpGain_saved then xpGain_saved=readFloat(xpGain) end writeFloat(xpGain,999) else if xpGain_saved then writeFloat(xpGain,xpGain_saved) xpGain_saved=nil end end
      if ald('Decrease xp gain').Active==true then ald('Increase xp gain').Active=false if not xpGain_saved then xpGain_saved=readFloat(xpGain) end writeFloat(xpGain,0) else if xpGain_saved then writeFloat(xpGain,xpGain_saved) xpGain_saved=nil end end
      if ald('Increase duration').Active==true then if not duration_saved then duration_saved=readFloat(duration) end writeFloat(duration,999) else if duration_saved then writeFloat(duration,duration_saved) duration_saved=nil end end
      if ald('Increase extra jumps').Active==true then if not extraJumps_saved then extraJumps_saved=readFloat(extraJumps) end writeFloat(extraJumps,999) else if extraJumps_saved then writeFloat(extraJumps,extraJumps_saved) extraJumps_saved=nil end end
      if ald('Increase projectile size').Active==true then if not projectileSize_saved then projectileSize_saved=readFloat(projectileSize) end writeFloat(projectileSize,10) else if projectileSize_saved then writeFloat(projectileSize,projectileSize_saved) projectileSize_saved=nil end end
      if ald('Increase projectile speed').Active==true then if not projectileSpeed_saved then projectileSpeed_saved=readFloat(projectileSpeed) end writeFloat(projectileSpeed,10) else if projectileSpeed_saved then writeFloat(projectileSpeed,projectileSpeed_saved) projectileSpeed_saved=nil end end
      if ald('Increase projectile count').Active==true then if not projectileCount_saved then projectileCount_saved=readFloat(projectileCount) end writeFloat(projectileCount,99) else if projectileCount_saved then writeFloat(projectileCount,projectileCount_saved) projectileCount_saved=nil end end
      if ald('Increase lifesteal').Active==true then if not lifeSteal_saved then lifeSteal_saved=readFloat(lifeSteal) end writeFloat(lifeSteal,999) else if lifeSteal_saved then writeFloat(lifeSteal,lifeSteal_saved) lifeSteal_saved=nil end end
      if ald('Increase thorns').Active==true then if not thorns_saved then thorns_saved=readFloat(thorns) end writeFloat(thorns,999) else if thorns_saved then writeFloat(thorns,thorns_saved) thorns_saved=nil end end
      if ald('Increase pickup range').Active==true then if not pickupRange_saved then pickupRange_saved=readFloat(pickupRange) end writeFloat(pickupRange,999) else if pickupRange_saved then writeFloat(pickupRange,pickupRange_saved) pickupRange_saved=nil end end
      if ald('Increase gold gain').Active==true then if not goldGain_saved then goldGain_saved=readFloat(goldGain) end writeFloat(goldGain,999) else if goldGain_saved then writeFloat(goldGain,goldGain_saved) goldGain_saved=nil end end
      if ald('Increase silver gain').Active==true then if not silverGain_saved then silverGain_saved=readFloat(silverGain) end writeFloat(silverGain,999) else if silverGain_saved then writeFloat(silverGain,silverGain_saved) silverGain_saved=nil end end
      if ald('Increase run speed').Active==true then if not moveSpeed_saved then moveSpeed_saved=readFloat(moveSpeed) end writeFloat(moveSpeed,25) else if moveSpeed_saved then writeFloat(moveSpeed,moveSpeed_saved) moveSpeed_saved=nil end end
      if ald('Increase jump height').Active==true then if not jumpHeight_saved then jumpHeight_saved=readFloat(jumpHeight) end writeFloat(jumpHeight,25) else if jumpHeight_saved then writeFloat(jumpHeight,jumpHeight_saved) jumpHeight_saved=nil end end
      if ald('Increase luck').Active==true then if not luck_saved then luck_saved=readFloat(luck) end writeFloat(luck,999) else if luck_saved then writeFloat(luck,luck_saved) luck_saved=nil end end
      if ald('Increase shield').Active==true then if not shield_saved then shield_saved=readFloat(shield) end writeFloat(shield,999) else if shield_saved then writeFloat(shield,shield_saved) shield_saved=nil end end
      if ald('Increase armor').Active==true then if not armor_saved then armor_saved=readFloat(armor) end writeFloat(armor,999) else if armor_saved then writeFloat(armor,armor_saved) armor_saved=nil end end
      if ald('Increase damage').Active==true then if not damage_saved then damage_saved=readFloat(damage) end writeFloat(damage,999) else if damage_saved then writeFloat(damage,damage_saved) damage_saved=nil end end
      if ald('Increase evasion').Active==true then if not evasion_saved then evasion_saved=readFloat(evasion) end writeFloat(evasion,999) else if evasion_saved then writeFloat(evasion,evasion_saved) evasion_saved=nil end end
      if ald('Increase attack speed').Active==true then if not attackSpeed_saved then attackSpeed_saved=readFloat(attackSpeed) end writeFloat(attackSpeed,999) else if attackSpeed_saved then writeFloat(attackSpeed,attackSpeed_saved) attackSpeed_saved=nil end end
      if ald('Increase crit chance').Active==true then if not critChance_saved then critChance_saved=readFloat(critChance) end writeFloat(critChance,999) else if critChance_saved then writeFloat(critChance,critChance_saved) critChance_saved=nil end end
      if ald('Increase crit damage').Active==true then if not critDamage_saved then critDamage_saved=readFloat(critDamage) end writeFloat(critDamage,999) else if critDamage_saved then writeFloat(critDamage,critDamage_saved) critDamage_saved=nil end end
      if ald('Increase max hp').Active==true then if not maxHp_saved then maxHp_saved=readFloat(maxHp) end writeFloat(maxHp,999) else if maxHp_saved then writeFloat(maxHp,maxHp_saved) maxHp_saved=nil end end
      if ald('Increase max hp regen').Active==true then if not hpRegen_saved then hpRegen_saved=readFloat(hpRegen) end writeFloat(hpRegen,999) else if hpRegen_saved then writeFloat(hpRegen,hpRegen_saved) hpRegen_saved=nil end end
      if gold and ald('Add 10k gold').Active==true and readFloat(gold) ~= nil then writeFloat(gold,readFloat(gold)+10000) ald('Add 10k gold').Active=false else ald('Add 10k gold').Active=false end
      if silver and ald('Add 10k silver').Active==true and readInteger(silver) ~= nil then writeInteger(silver,readInteger(silver)+10000) ald('Add 10k silver').Active=false else ald('Add 10k silver').Active=false end
      if xp and ald('Add 1k xp').Active==true and readInteger(xp) ~= nil then writeInteger(xp,readInteger(xp)+1000) ald('Add 1k xp').Active=false else ald('Add 1k xp').Active=false end
      if kills and ald('Add 10k kills').Active==true then writeFloat(kills,readFloat(kills)+10000) ald('Add 10k kills').Active=false else ald('Add 10k kills').Active=false end
      if ald('Increase difficulty').Active==true then if not difficulty_saved then difficulty_saved=readFloat(difficulty) end writeFloat(difficulty,999) else if difficulty_saved then writeFloat(difficulty,difficulty_saved) difficulty_saved=nil end end


      --easy death script
      if ald('Reset all - (Ez Death)').Active==true then ald('Scripts').Active=false
          writeFloat(maxHp,0) writeFloat(hpRegen,0) writeFloat(shield,0) writeFloat(thorns,0)
          writeFloat(armor,0) writeFloat(evasion,0)
          writeFloat(knockback,0) writeFloat(luck,0) writeFloat(critChance,0) writeFloat(critDamage,0)
          writeFloat(attackSpeed,0) writeFloat(projectileCount,0) writeFloat(projectileSpeed,0) writeFloat(lifeSteal,0)
          ald('Reset all - (Ez Death)').Active=false
      end

  end -- base check

end -- tmrfunction


ald('Scripts').Active=true --open scripts header

