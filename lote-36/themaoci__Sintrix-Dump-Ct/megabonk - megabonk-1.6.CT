            <CheatEntry>
              <ID>607</ID>
              <Description>"Flight"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(player_noclip,GameAssembly.dll,38 * * * * * 0F * * * * * E8 * * * * 33 * 48 * * E8)
alloc(newmemplayer_noclip,$100,player_noclip)
alloc(noclip,8,player_noclip)
label(codeplayer_noclip returnplayer_noclip)

newmemplayer_noclip:
mov [noclip],rbx
mov [rbx+00000208],1

codeplayer_noclip:
cmp [rbx+00000208],dl
jmp returnplayer_noclip
player_noclip:
jmp newmemplayer_noclip
nop 1
returnplayer_noclip:
registersymbol(player_noclip noclip)
 
 
[DISABLE]

luacall(if syntaxcheck then return end local address=getAddressSafe('[noclip]+208') if address then writeInteger(address,0) end)
//[noclip]+208:
//dd 0

player_noclip:
db 38 93 08 02 00 00
unregistersymbol(player_noclip noclip)
dealloc(newmemplayer_noclip noclip)
</AssemblerScript>
