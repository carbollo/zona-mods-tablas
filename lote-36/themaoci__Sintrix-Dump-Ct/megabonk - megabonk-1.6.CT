                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

// === MyAchievements.AreAllQuestsCompleted ===
define(MyAchievements_AreAllQuestsCompleted, Assets.Scripts.Saves___Serialization.Progression.Unlocks.MyAchievements.AreAllQuestsCompleted)
alloc(newmem_AreAllQuestsCompleted,64,MyAchievements_AreAllQuestsCompleted)
alloc(orig_AreAllQuestsCompleted,6)
orig_AreAllQuestsCompleted:
  readmem(MyAchievements_AreAllQuestsCompleted,6)
label(return_AreAllQuestsCompleted)

newmem_AreAllQuestsCompleted:
    mov al,1        // force return true (all quests completed)
    ret

MyAchievements_AreAllQuestsCompleted:
    jmp newmem_AreAllQuestsCompleted
    nop 1
return_AreAllQuestsCompleted:

registersymbol(MyAchievements_AreAllQuestsCompleted orig_AreAllQuestsCompleted)

[DISABLE]

// === Restore original bytes safely ===
MyAchievements_AreAllQuestsCompleted:
  readmem(orig_AreAllQuestsCompleted,6)

// === Cleanup ===
unregistersymbol(MyAchievements_AreAllQuestsCompleted orig_AreAllQuestsCompleted)
dealloc(newmem_AreAllQuestsCompleted orig_AreAllQuestsCompleted)


</AssemblerScript>
