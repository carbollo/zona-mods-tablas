  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Supermarket Simulator.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "_Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]

startTable{
  process = "Supermarket Simulator.exe",
  title = "Supermarket Simulator 2.0.1",
  discord = "https://discord.gg/zRBd7uBBzZ",
  AddressListPic = "https://imgur.com/4pl47YF.png",
  compact = false,
  mono = true,
  monoAddress = "PlayerManager..ctor"
}

local function asmCode()

  autoAssemble([[
  aobscanmodule(findpcords,UnityPlayer.dll,0Fxxxxxxxxxxxx0Fxxxx48xxxxF3xxxxxxxxxxxxxxF2xxxxxxxxxxxxxx)
  alloc(newmemfindpcords,$100,findpcords)
  alloc(pCords,8,findpcords)
  alloc(findpcords_savedBytes,7,findpcords)
  label(codefindpcords returnfindpcords)
  findpcords_savedBytes:
  readmem(findpcords,7)
  newmemfindpcords:
  mov [pCords],rdi
  codefindpcords:
  movups xmm0,[rdi+000001F8]
  jmp returnfindpcords
  findpcords:
  jmp newmemfindpcords
  nop 2
  returnfindpcords:
  registersymbol(findpcords pCords findpcords_savedBytes)]])

  autoAssemble([[
  aobscanmodule(FindMoney,GameAssembly.dll,F3xxxxxxxx48xxxxxx5BC3E8xxxxxxxxCCCCCCCCCC48xxxxxxxx5748xxxxxx80xxxxxxxxxxxx48xxxx75xx48xxxxxxxxxxxxE8xxxxxxxx48xxxxxxxxxxxxE8xxxxxxxxC6xxxxxxxxxxxx48xxxxxxxxxxxx48xxxxxx)
  alloc(newmemFindMoney,$100,FindMoney)
  alloc(money,8,FindMoney)
  alloc(FindMoney_savedBytes,5,FindMoney)
  label(codeFindMoney returnFindMoney)
  FindMoney_savedBytes:
  readmem(FindMoney,5)
  newmemFindMoney:
  mov [money],rax
  codeFindMoney:
  movss xmm0,[rax+20]
  jmp returnFindMoney
  FindMoney:
  jmp newmemFindMoney
  returnFindMoney:
  registersymbol(FindMoney money FindMoney_savedBytes)]])

  autoAssemble([[
  aobscanmodule(findPlayerManager_LocalPlayer,GameAssembly.dll,48xxxxxx48xxxx0Fxxxxxxxxxx48xxxxxx48xxxx74xx80xxxxxxxxxxxx74xx80xxxxxxxxxxxx)
  alloc(newmemfindPlayerManager_LocalPlayer,$100,findPlayerManager_LocalPlayer)
  alloc(LocalPlayer,8,findPlayerManager_LocalPlayer)
  alloc(findPlayerManager_LocalPlayer_savedBytes,7,findPlayerManager_LocalPlayer)
  label(codefindPlayerManager_LocalPlayer returnfindPlayerManager_LocalPlayer)
  findPlayerManager_LocalPlayer_savedBytes:
  readmem(findPlayerManager_LocalPlayer,7)
  newmemfindPlayerManager_LocalPlayer:
  mov [LocalPlayer],rax
  codefindPlayerManager_LocalPlayer:
  mov rax,[rax+20]
  test rax,rax
  jmp returnfindPlayerManager_LocalPlayer
  findPlayerManager_LocalPlayer:
  jmp newmemfindPlayerManager_LocalPlayer
  nop 2
  returnfindPlayerManager_LocalPlayer:
  registersymbol(findPlayerManager_LocalPlayer LocalPlayer findPlayerManager_LocalPlayer_savedBytes)]])

  autoAssemble([[
  aobscanmodule(FindDayCycleManager,GameAssembly.dll,F3xxxxxxxxxxxxxx33xxF3xxxxxxxxxxxxxxE8xxxxxxxxF3xxxxxxxxxxxxxxF3xxxxxxF3xxxxxxxxxxxxxx40xxxxxxxxxxxx)
  alloc(newmemFindDayCycleManager,$100,FindDayCycleManager)
  alloc(DayCycleManager,8,FindDayCycleManager)
  alloc(FindDayCycleManager_savedBytes,8,FindDayCycleManager)
  label(codeFindDayCycleManager returnFindDayCycleManager)
  FindDayCycleManager_savedBytes:
  readmem(FindDayCycleManager,8)
  newmemFindDayCycleManager:
  mov [DayCycleManager],rdx
  codeFindDayCycleManager:
  movss [rdx+000000A8],xmm7
  jmp returnFindDayCycleManager
  FindDayCycleManager:
  jmp newmemFindDayCycleManager
  nop 3
  returnFindDayCycleManager:
  registersymbol(FindDayCycleManager DayCycleManager FindDayCycleManager_savedBytes)]])

end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

  local money=getAddressSafe('[money]+20')
  if money and ald('Add 100k Cash per click').Active==true then
    if readFloat(money) ~= nil then
       writeFloat(money,readFloat(money)+100000.00)
    end
   ald('Add 100k Cash per click').active=false
  end

  local JumpHeight=getAddressSafe('[[[LocalPlayer]+20]+50]+30')
  if JumpHeight and ald('2x Jump Height').Active==true then
    if not _G.OldJumpHeight then _G.OldJumpHeight = readFloat(JumpHeight) end
    writeFloat(JumpHeight,3)
  else
    if _G.OldJumpHeight then writeFloat(JumpHeight,_G.OldJumpHeight) _G.OldJumpHeight=nil end
  end

  local mGravity=getAddressSafe('[[[LocalPlayer]+20]+50]+34')
  if mGravity and ald('Moon Gravity').Active==true then
    if not _G.OldmGravity then _G.OldmGravity = readFloat(mGravity) end
    writeFloat(mGravity,-5)
  else
    if _G.OldmGravity then writeFloat(mGravity,_G.OldmGravity) _G.OldmGravity=nil end
  end

  local MoveSpeed=getAddressSafe('[[[LocalPlayer]+20]+50]+20')
  if MoveSpeed and ald('2x Walk Speed').Active==true then
    if not _G.OldMoveSpeed then _G.OldMoveSpeed = readFloat(MoveSpeed) end
    writeFloat(MoveSpeed,8)
  else
    if _G.OldMoveSpeed then writeFloat(MoveSpeed,_G.OldMoveSpeed) _G.OldMoveSpeed=nil end
  end

  local SprintSpeed=getAddressSafe('[[[LocalPlayer]+20]+50]+24')
  if SprintSpeed and ald('2x Sprint Speed').Active==true then
    if not _G.OldSprintSpeed then _G.OldSprintSpeed = readFloat(SprintSpeed) end
    writeFloat(SprintSpeed,16)
  else
    if _G.OldSprintSpeed then writeFloat(SprintSpeed,_G.OldSprintSpeed) _G.OldSprintSpeed=nil end
  end

  local CurrentStoreLevel=getAddressSafe('[money]+D8')
  if CurrentStoreLevel and ald('Max Store Level').Active==true then
    if not _G.OldCurrentStoreLevel then _G.OldCurrentStoreLevel = readInteger(CurrentStoreLevel) end
    writeInteger(CurrentStoreLevel,100)
  else
    if _G.OldCurrentStoreLevel then writeInteger(CurrentStoreLevel,_G.OldCurrentStoreLevel) _G.OldCurrentStoreLevel=nil end
  end

  local CompletedCheckoutCount=getAddressSafe('[money]+D0')
  if CompletedCheckoutCount and ald('999999 Completed Checkouts').Active==true then
    if not _G.OldCompletedCheckoutCount then _G.OldCompletedCheckoutCount = readInteger(CompletedCheckoutCount) end
    writeInteger(CompletedCheckoutCount,999999)
  else
    if _G.OldCompletedCheckoutCount then writeInteger(CompletedCheckoutCount,_G.OldCompletedCheckoutCount) _G.OldCompletedCheckoutCount=nil end
  end

  local CurrentStorePoint=getAddressSafe('[money]+D4')
  if CurrentStorePoint and ald('999999 Current Store Points').Active==true then
    if not _G.OldCurrentStorePoint then _G.OldCurrentStorePoint = readInteger(CurrentStorePoint) end
    writeInteger(CurrentStorePoint,999999)
  else
    if _G.OldCurrentStorePoint then writeInteger(CurrentStorePoint,_G.OldCurrentStorePoint) _G.OldCurrentStorePoint=nil end
  end

  local StoreUpgradeLevel=getAddressSafe('[money]+DC')
  if StoreUpgradeLevel and ald('Max Store Upgrade Level').Active==true then
    if not _G.OldStoreUpgradeLevel then _G.OldStoreUpgradeLevel = readInteger(StoreUpgradeLevel) end
    writeInteger(StoreUpgradeLevel,9999999)
  else
    if _G.OldStoreUpgradeLevel then writeInteger(StoreUpgradeLevel,_G.OldStoreUpgradeLevel) _G.OldStoreUpgradeLevel=nil end
  end

  local mInteractionDistance=getAddressSafe('[[[LocalPlayer]+20]+70]+2C')
  if mInteractionDistance and ald('Increase Interaction Distance').Active==true then
    if not _G.OldmInteractionDistance then _G.OldmInteractionDistance = readFloat(mInteractionDistance) end
    writeFloat(mInteractionDistance,9999)
  else
    if _G.OldmInteractionDistance then writeFloat(mInteractionDistance,_G.OldmInteractionDistance) _G.OldmInteractionDistance=nil end
  end

  local mProductInteractionInterval=getAddressSafe('[[[[[LocalPlayer]+20]+50]+F0]+A0]+34')
  if mProductInteractionInterval and ald('Instant Interaction (shelving products)').Active==true then
    if not _G.OldmProductInteractionInterval then _G.OldmProductInteractionInterval = readFloat(mProductInteractionInterval) end
    writeFloat(mProductInteractionInterval,0)
  else
    if _G.OldmProductInteractionInterval then writeFloat(mProductInteractionInterval,_G.OldmProductInteractionInterval) _G.OldmProductInteractionInterval=nil end
  end

end

ald('Scripts').Active=true
--MainForm.Width=700 MainForm.Height=600 --printMainFormSize()

