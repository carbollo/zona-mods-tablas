            <CheatEntry>
              <ID>1337142760</ID>
              <Description>"Rob Customers (shortchange)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(getCheckoutData,GameAssembly.dll,F3xxxxxxxxxxxxxx45xxxxF3xxxxxxxx48xxxxF3xxxxxxxxxxxxxxE8)
alloc(newmemgetCheckoutData,$100,getCheckoutData)
define(getCheckoutData_savedBytes,newmemgetCheckoutData+50)
label(codegetCheckoutData returngetCheckoutData)

getCheckoutData_savedBytes:
readmem(getCheckoutData,8)

newmemgetCheckoutData:
mov [rdi+8c],(float)1 //self checkout move power
//mov [rdi+100],(float)1000.00 //total price
//mov [rdi+104],(float)1000.00 //received payment
mov [rdi+108],(float)0 //correct change
mov [rdi+10C],(float)1 //collected change

codegetCheckoutData:
movss xmm1,[rdi+0000010C]
jmp returngetCheckoutData

getCheckoutData:
jmp newmemgetCheckoutData
nop 3
returngetCheckoutData:
registersymbol(getCheckoutData newmemgetCheckoutData getCheckoutData_savedBytes)

[DISABLE]

getCheckoutData:
readmem(getCheckoutData_savedBytes,8)
unregistersymbol(getCheckoutData newmemgetCheckoutData getCheckoutData_savedBytes)
dealloc(newmemgetCheckoutData)
</AssemblerScript>
