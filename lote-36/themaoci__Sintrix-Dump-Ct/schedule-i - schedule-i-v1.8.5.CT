newmem_growthh:
mov [plant_base],rcx
  movss [rcx+28],xmm6 // growth progress (float)1 = instant
  mov [rcx+6C],(float)5 // base yield level
  mov [rcx+70],(float)5 // base quality level
  mov [rcx+90],(float)5 // yield level
  mov [rcx+94],(float)1 // quality level
  jmp return_growthh

