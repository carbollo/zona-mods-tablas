//aobscanmodule(freecamFunction,GameAssembly.dll,48 * * * 80 * * * * * * 75 * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 48 * * * F6 * * * * * * 75 * 48 * * E8 * * * * 48 * * * * * * 48 * * * * * * 48 * * * F6)
//aobscanmodule(clearInventoryFunction,GameAssembly.dll,40 53 48 83 EC 20 80 3D ?? ?? ?? ?? 00 75 2B 48 8D 0D ?? ?? ?? ?? E8 ?? ?? 96 ?? 48 ?? ?? ?? ?? ?? ?? e8 ?? ?? ?? ?? 48 ?? ?? ?? ?? ?? ?? e8 ?? ?? ?? ?? c6 ?? ?? ?? ?? ?? ?? 48 ?? ?? ?? ?? ?? ?? 83)
//aobscanmodule(clearWantedFunction,GameAssembly.dll,40 * 48 * * * 80 * * * * * * 75 * 48 * * * * * * E8 * * * * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 83 * * * * * * 75 * E8 * * * * 80 * * * * * * 48 * * * * * * 75 * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 83 * * * * * * 75 * E8 * * * * 45 * * 33 * 48 * * E8 * * * * 80 * * * * * * 75 * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 83 * * * * * * 75 * 48 * * E8 * * * * 48 * * * * * * 48 * * * * * * 48 * * * 48 * * 74 * 48 * * * * * * 48 * * 74 * 45)
aobscanmodule(pCords,UnityPlayer.dll,41 0F 11 86 F0 01 00 00 F2)
alloc(newmem_pcrds,$100,pCords)
alloc(xyz,8,pCords)
alloc(fc_flag,4,pCords)
alloc(s_game,4,pCords)
alloc(clrinv,4,pCords)
alloc(clrwntd,4,pCords)
alloc(additem,4,pCords)
label(code_pcrds return_pcrds savegamecheck clearinventorycheck clearwantedcheck)

fc_flag:
dd 0

s_game:
dd 0

clrinv:
dd 0

clrwntd:
dd 0

newmem_pcrds:
mov [xyz],r14
cmp [fc_flag],1
jne savegamecheck
call FreeCamCommand.Execute
mov [fc_flag],0

savegamecheck:
cmp [s_game],1
jne clearinventorycheck
call Save.Execute
mov [s_game],0

clearinventorycheck:
cmp [clrinv],1
jne clearwantedcheck
call ClearInventoryCommand.Execute
mov [clrinv],0

clearwantedcheck:
cmp [clrwntd],1
jne code_pcrds
call ClearWanted.Execute
mov [clrwntd],0

code_pcrds:
movups [r14+000001F0],xmm0
jmp return_pcrds
pCords:
jmp newmem_pcrds
nop 3
return_pcrds:
registersymbol(pCords xyz fc_flag s_game clrinv clrwntd)

aobscanmodule(gettime,GameAssembly.dll,F3 * * * * * * * 33 * E8 * * * * F3 * * * * * * * F3 * * * F3)
alloc(newmemgettime,$100,gettime)
alloc(time,8,gettime)
label(codegettime returngettime)
newmemgettime:
mov [time],rbx
// if fast time is on, jump over 4am
cmp [rbx+138],(float)100
jne codegettime
cmp [rbx+128],(float)399 // if its 4am
jne codegettime
mov [rbx+128],(float)701 // jump to 7am
codegettime:
movss xmm6,[rbx+0000012C]
jmp returngettime
gettime:
jmp newmemgettime
nop 3
returngettime:
registersymbol(gettime time)

define(ScheduleOne_UI_PickpocketScreen_Update, ScheduleOne.UI.PickpocketScreen.Update)
alloc(newmemScheduleOne_UI_PickpocketScreen_Update,$100,ScheduleOne_UI_PickpocketScreen_Update)
alloc(pickPocket,8,ScheduleOne_UI_PickpocketScreen_Update)
alloc(epp,4,ScheduleOne_UI_PickpocketScreen_Update)
label(codeScheduleOne_UI_PickpocketScreen_Update returnScheduleOne_UI_PickpocketScreen_Update)
epp:
dd 0
newmemScheduleOne_UI_PickpocketScreen_Update:
cmp [epp],1
jne @F
mov [rcx+2C],(float)950
mov [rcx+30],(float)950
mov [rcx+40],(float)999999
mov [rcx+C0],0
@@:
cmp [epp],0
jne codeScheduleOne_UI_PickpocketScreen_Update
mov [rcx+2C],(float)45
mov [rcx+30],(float)7
codeScheduleOne_UI_PickpocketScreen_Update:
push rdi
sub rsp,40
jmp returnScheduleOne_UI_PickpocketScreen_Update
ScheduleOne_UI_PickpocketScreen_Update:
jmp newmemScheduleOne_UI_PickpocketScreen_Update
nop 1
returnScheduleOne_UI_PickpocketScreen_Update:
registersymbol(ScheduleOne_UI_PickpocketScreen_Update epp)

alloc(newmemrpo,$100,ScheduleOne.ObjectScripts.Recycler.GetTrash)
registersymbol(recycle)
label(coderpo returnrpo recycle)
newmemrpo:
xorps xmm15,xmm15
movss xmm15,[recycle]
movss [rcx+1D0],xmm15
coderpo:
  mov [rsp+20],rbx
  jmp returnrpo
recycle:
dd (float)100
ScheduleOne.ObjectScripts.Recycler.GetTrash:
  jmp newmemrpo
returnrpo:

aobscanmodule(findclip,GameAssembly.dll,FF * * 4C * * * 74 * 48 * * * 48 * * * 48 * * * 48 * * * FF * 49 * * 49)
alloc(newmemfindclip,$100,findclip)
alloc(clip,8,findclip)
label(codefindclip returnfindclip)
newmemfindclip:
mov [clip],rcx
codefindclip:
dec [rcx+38]
cmp [rcx+28],r14
jmp returnfindclip
findclip:
jmp newmemfindclip
nop 2
returnfindclip:
registersymbol(findclip clip)


]]) end


iav('ScheduleOne.PlayerScripts.PlayerMovement.Update',asmCode)



cMenuTmr=createTimer() cMenuTmr.Interval=100 cMenuTmr.onTimer=function()

  local moveSpeedmultiplier=getAddressSafe('[mptr]+38')
  local health=getAddressSafe('[[[mptr]+20]+178]+11C')
  local staminaReserve=getAddressSafe('[mptr]+54')
  local currentTime=getAddressSafe('[time]+128')
  local timeSpeedmult=getAddressSafe('[time]+138')
  local cash=getAddressSafe('[cash]+38')
  local Paranoid=getAddressSafe('[[mptr]+20]+388')
  local Sneaky=getAddressSafe('[[mptr]+20]+389')
  local Disoriented=getAddressSafe('[[mptr]+20]+38a')
  local Seizure=getAddressSafe('[[mptr]+20]+38B')
  local Slippery=getAddressSafe('[[mptr]+20]+398')
  local Schizophrenic=getAddressSafe('[[mptr]+20]+399')
  local MinPunchDamage=getAddressSafe('[punch]+30')
  local MaxPunchDamage=getAddressSafe('[punch]+34')
  local MinPunchForce=getAddressSafe('[punch]+38')
  local MaxPunchForce=getAddressSafe('[punch]+3c')
  local MinStaminaCost=getAddressSafe('[punch]+40')
  local MaxStaminaCost=getAddressSafe('[punch]+44')
  local GiveUpRange=getAddressSafe('[[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+2F8]+174')
  local CurrentPursuitLevel=getAddressSafe('[[[mptr]+20]+180]+130')
  local arrestingEnabled=getAddressSafe('[[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+2F8]+248')
  local Suspicion=getAddressSafe('[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+36C')
  local CurrentArrestProgress=getAddressSafe('[[[mptr]+20]+180]+148')
  local BodySearchPending=getAddressSafe('[[[mptr]+20]+180]+168')
  local CurrentBodySearchProgress=getAddressSafe('[[[mptr]+20]+180]+14C')
  local generalCrimeResponseActive=getAddressSafe('[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+3A0')
  local Leniency=getAddressSafe('[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+370')
  local DefaultCopMovementSpeed=getAddressSafe('[[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+2F8]+180')
  local policeEnabled=getAddressSafe('[[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+2F8]+119')
  local noticeGeneralCrime=getAddressSafe('[[[[[[mptr]+20]+180]+118]+180]+28]+1C0')
  local VisionEnabled=getAddressSafe('[[[[[[mptr]+20]+180]+118]+180]+28]+129')
  local Attentiveness=getAddressSafe('[[[[[[mptr]+20]+180]+118]+180]+28]+148')
  local Memory=getAddressSafe('[[[[[[mptr]+20]+180]+118]+180]+28]+14C')
  local AwarenessActiveByDefault=getAddressSafe('[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+180]+20')
  local ArrestCircle_MaxVisibleDistance=getAddressSafe('[[[[[[[[mptr]+20]+180]+118]+180]+28]+1B8]+2F8]+228')
  local TimeSincePursuitStart=getAddressSafe('[[[mptr]+20]+180]+154')
  local CurrentPursuitLevelDuration=getAddressSafe('[[[mptr]+20]+180]+158')
  local TimeSinceSighted=getAddressSafe('[[[mptr]+20]+180]+15C')
  local epp_flag=getAddressSafe('epp')
  local fc_flag=getAddressSafe('fc_flag')
  local s_game=getAddressSafe('s_game')
  local clrinv=getAddressSafe('clrinv')
  local clrwntd=getAddressSafe('clrwntd')
  local px=getAddressSafe('[xyz]+1F4')
  local py=getAddressSafe('[xyz]+204')
  local pz=getAddressSafe('[xyz]+1FC')
  local clip=getAddressSafe('[clip]+38')
  local ImpactForce=getAddressSafe('[[[clip]+10]+60]+F8')
  local Range=getAddressSafe('[[[clip]+10]+60]+E4')
  local Damage=getAddressSafe('[[[clip]+10]+60]+F4')
  local MinSpread=getAddressSafe('[[[clip]+10]+60]+EC')
  local MaxSpread=getAddressSafe('[[[clip]+10]+60]+F0')
  local CooldownDuration=getAddressSafe('[[[[clip]+10]+60]+60]+58')

  if ald('Infinite jumps').Active==true then
    if not getAddressSafe('infjumps') then autoAssemble([[
      aobscanmodule(infjumps,GameAssembly.dll,74 10 33 D2 E8 F5 DE FB FF)
      registersymbol(infjumps)
      infjumps:
      db EB]])
    end
  else if getAddressSafe('infjumps') then autoAssemble([[
      infjumps:
      db 74
      unregistersymbol(infjumps)]]) end
  end

  if ald('Bottomless clip +').Active==true and clip then
    writeInteger(clip,99)
    writeFloat(ImpactForce,9999)
    writeFloat(Range,9999)
    writeFloat(Damage,9999)
    writeFloat(MinSpread,0)
    writeFloat(CooldownDuration,0)
  end

  if ald('Free cam').Active==true then writeInteger(fc_flag,1) ald('Free cam').Active=false end
  if ald('Save game').Active==true then writeInteger(s_game,1) ald('Save game').Active=false end
  if ald('Clear inventory').Active==true then writeInteger(clrinv,1) ald('Clear inventory').Active=false end
  if ald('Clear wanted').Active==true then writeInteger(clrwntd,1) ald('Clear wanted').Active=false end

    if GiveUpRange and ald('Police ignore everything (stealth)').Active==true then
      writeFloat(GiveUpRange,0)
      writeByte(arrestingEnabled,0)
      writeFloat(Suspicion,0)
      writeByte(generalCrimeResponseActive,0)
      writeFloat(Leniency,9999)
      writeByte(policeEnabled,0)
      writeByte(noticeGeneralCrime,0)
      writeByte(VisionEnabled,0)
      writeFloat(Attentiveness,0)
      writeFloat(Memory,0)
      writeByte(AwarenessActiveByDefault,0)
      writeFloat(ArrestCircle_MaxVisibleDistance,0)
      writeFloat(CurrentArrestProgress,0) --only when enabled
      writeByte(BodySearchPending,0) --only when enabled
      writeFloat(CurrentBodySearchProgress,0) --only when enabled
    else
      writeFloat(GiveUpRange,9999)
      writeByte(arrestingEnabled,1)
      writeFloat(Suspicion,0.5)
      writeByte(generalCrimeResponseActive,1)
      writeFloat(Leniency,0.5)
      writeByte(policeEnabled,1)
      writeByte(noticeGeneralCrime,1)
      writeByte(VisionEnabled,1)
      writeFloat(Attentiveness,1)
      writeFloat(Memory,1)
      writeByte(AwarenessActiveByDefault,1)
      writeFloat(ArrestCircle_MaxVisibleDistance,5)
    end

    if Paranoid then
        if ald('Never Paranoid/Sneaky/Disoriented/Seizure/Slippery/Schizophrenic').Active==true then
          writeByte(Paranoid,0)
          writeByte(Sneaky,0)
          writeByte(Disoriented,0)
          writeByte(Seizure,0)
          writeByte(Slippery,0)
          writeByte(Schizophrenic,0)
        end
    end

    if cash and ald('Get cash easy').Active==true then ald('Get cash easy').Active=false
        local userInput=inputQuery('Set cash amount to add (will update visually when cash changes)', 'Enter amount to add:', '9999')
        local value=tonumber(userInput) if value~=nil then
            writeFloat(cash,readFloat(cash)+value)
        end
    end

    if currentTime then
        if ald('Lock 12pm').Active==true then writeInteger(currentTime,1200) end
        if ald('Fast Time').Active==true then writeFloat(timeSpeedmult,100) else writeFloat(timeSpeedmult,1) end
    end

    if moveSpeedmultiplier and ald('Increase move speed').Active==true then writeFloat(moveSpeedmultiplier,3) else writeFloat(moveSpeedmultiplier,1) end

    if health and ald('God mode').Active==true then
      writeFloat(health,999)
      autoAssemble([[ScheduleOne.PlayerScripts.Health.PlayerHealth.get_CanTakeDamage:
      db B0 00 C3
      ScheduleOne.PlayerScripts.Health.PlayerHealth.RpcWriter___Observers_TakeDamage_3505310624:
      db C3 90 90 90 90]])
    else
      autoAssemble([[ScheduleOne.PlayerScripts.Health.PlayerHealth.get_CanTakeDamage:
      db 48 83 EC 08
      ScheduleOne.PlayerScripts.Health.PlayerHealth.RpcWriter___Observers_TakeDamage_3505310624:
      db 48 89 5C 24 10]])
    end



    if MinPunchDamage and ald('Super punch').Active==true then
      writeFloat(MinPunchDamage,9999)
      writeFloat(MaxPunchDamage,9999)
      writeFloat(MinPunchForce,9999)
      writeFloat(MaxPunchForce,9999)
      writeFloat(MinStaminaCost,0)
      writeFloat(MaxStaminaCost,0)
    else
      writeFloat(MinPunchDamage,20)
      writeFloat(MaxPunchDamage,35)
      writeFloat(MinPunchForce,60)
      writeFloat(MaxPunchForce,160)
      writeFloat(MinStaminaCost,10)
      writeFloat(MaxStaminaCost,30)
    end

    if staminaReserve and ald('Inf stamina').Active==true then
      writeFloat(staminaReserve,999)
      autoAssemble([[ScheduleOne.PlayerScripts.PlayerMovement.SetStamina:
      db C3 90 90 90 90]])
    else
      writeFloat(staminaReserve,100)
      autoAssemble([[ScheduleOne.PlayerScripts.PlayerMovement.SetStamina:
      db 48 89 5C 24 08]])
    end

    if epp_flag and ald('Easy pickpocket').Active==true then writeByte(epp_flag,1) else writeByte(epp_flag,0) end


end --cMenuTmr

if ald('scripts').Active~=true then ald('scripts').Active=true end


