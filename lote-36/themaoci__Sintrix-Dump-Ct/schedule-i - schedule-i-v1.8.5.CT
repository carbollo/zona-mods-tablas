label(codefindnpcbase returnfindnpcbase)

NPCwalkSpeed:
dd (float)1.20

NPCrunSpeed:
dd (float)7

NPCmoveSpeedMultiplier:
dd (float)1

NPCmoveSpeedScale:
//dd (float)0.07999999821
dd (float)1.5

NPCslipperyFlag:
dd 0

newmemfindnpcbase:
mov [NPC_base],rdi // pull a random npc base

push rbx
mov rbx,[NPCwalkSpeed]
mov [rdi+11C],rbx
pop rbx

push rbx
mov rbx,[NPCrunSpeed]
mov [rdi+124],rbx
pop rbx

push rbx
mov rbx,[NPCmoveSpeedMultiplier]
mov [rdi+124],rbx
pop rbx

push rbx
mov rbx,[NPCmoveSpeedScale]
mov [rdi+124],rbx
pop rbx

push rbx
mov rbx,[NPCslipperyFlag]
mov [rdi+130],rbx
pop rbx

codefindnpcbase:
cmp [rdi+00000118],al
jmp returnfindnpcbase

findnpcbase:
jmp newmemfindnpcbase
nop 1
returnfindnpcbase:
registersymbol(findnpcbase NPCmoveSpeedMultiplier NPCmoveSpeedScale NPCslipperyFlag NPCwalkSpeed NPCrunSpeed NPC_base)

[DISABLE]

NPCwalkSpeed:
dd (float)1.20

NPCrunSpeed:
dd (float)7

NPCmoveSpeedMultiplier:
dd (float)1

NPCmoveSpeedScale:
//dd (float)0.07999999821
dd (float)1.5

NPCslipperyFlag:
dd 0

findnpcbase:
db 38 87 18 01 00 00
unregistersymbol(findnpcbase NPCmoveSpeedMultiplier NPCmoveSpeedScale NPCslipperyFlag NPCwalkSpeed NPCrunSpeed NPC_base)
dealloc(newmemfindnpcbase NPCmoveSpeedMultiplier NPCmoveSpeedScale NPCslipperyFlag NPCwalkSpeed NPCrunSpeed NPC_base)

