  <CheatEntries>
    <CheatEntry>
      <ID>367359</ID>
      <Description>"Schedule | 2025"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local s=findTableFile('SintrixBytrl.lua').Stream load(readStringLocal(s.Memory,s.Size))()
startTable('Schedule I.exe','Schedule I v1.8', 'Schedule I v1.8', 'Everyone @ Sintrix', true)


local function asmCode() autoAssemble([[
aobscanmodule(GETPUNCHCONTROLLER,GameAssembly.dll,80 * * * 0F * * * * * F3 * * * * * * * 0F * * * 0F * * * * * 0F * * * * 33 * 48 * * E8)
aobscanmodule(pcjeaddress,GameAssembly.dll,4883xxxx5BC3E8xxxxxxxxxxxxxxxx0F57)
alloc(newmemGETPUNCHCONTROLLER,$100,GETPUNCHCONTROLLER)
alloc(punch,8,GETPUNCHCONTROLLER)
label(codeGETPUNCHCONTROLLER returnGETPUNCHCONTROLLER)
newmemGETPUNCHCONTROLLER:
mov [punch],rbx
codeGETPUNCHCONTROLLER:
cmp byte ptr [rbx+20],00
je pcjeaddress
jmp returnGETPUNCHCONTROLLER
GETPUNCHCONTROLLER:
jmp newmemGETPUNCHCONTROLLER
nop 5
returnGETPUNCHCONTROLLER:
registersymbol(GETPUNCHCONTROLLER punch pcjeaddress)

aobscanmodule(getcash,GameAssembly.dll,F3 * * * * 33 * 48 * * * * F3 * * * * * E8 * * * * 48)
alloc(newmemgetcash,$100,getcash)
alloc(cash,8,getcash)
label(codegetcash returngetcash)
newmemgetcash:
mov [cash],rax
codegetcash:
addss xmm6,[rax+38]
jmp returngetcash
getcash:
jmp newmemgetcash
returngetcash:
registersymbol(getcash cash)

define(ScheduleOne_PlayerScripts_PlayerMovement_Update, ScheduleOne.PlayerScripts.PlayerMovement.Update)
alloc(newmemScheduleOne_PlayerScripts_PlayerMovement_Update,$100,ScheduleOne_PlayerScripts_PlayerMovement_Update)
alloc(mptr,8,ScheduleOne_PlayerScripts_PlayerMovement_Update)
label(codeScheduleOne_PlayerScripts_PlayerMovement_Update returnScheduleOne_PlayerScripts_PlayerMovement_Update)
newmemScheduleOne_PlayerScripts_PlayerMovement_Update:
mov [mptr],rcx
codeScheduleOne_PlayerScripts_PlayerMovement_Update:
push rbx
sub rsp,50
jmp returnScheduleOne_PlayerScripts_PlayerMovement_Update
ScheduleOne_PlayerScripts_PlayerMovement_Update:
jmp newmemScheduleOne_PlayerScripts_PlayerMovement_Update
nop 1
returnScheduleOne_PlayerScripts_PlayerMovement_Update:
registersymbol(ScheduleOne_PlayerScripts_PlayerMovement_Update mptr)

