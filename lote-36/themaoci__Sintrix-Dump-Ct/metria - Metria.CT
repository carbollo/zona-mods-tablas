db 48 8B C4
EnemyScript.BeginAttackProcess:
db 40 53
EnemyScript.ChangeTarget:
db d48 89 5C 24 08
EnemyScript.Update:
db 40 53
//Send@Sintrix|FearlessRevolution
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337094686</ID>
              <Description>"Max Attack Range"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//Send@Sintrix|FearlessRevolution
aobscanmodule(attackrange,GameAssembly.dll,59 06 00 00 48 8D 0C 5B F2 0F 10 44 88 20)
alloc(newmem,$1000,attackrange)

label(code)
label(return)

newmem:

code:
  mov [rax+rcx*4+20],(float)99999
  movsd xmm0,[rax+rcx*4+20]
  jmp return

attackrange+08:
  jmp newmem
  nop
return:
registersymbol(attackrange)
//Send@Sintrix|FearlessRevolution
aobscanmodule(attackrange2,GameAssembly.dll,8B 44 88 28 EB 32 80 3D * * * * 00 75 13 48 8D 0D * * * * E8 B5)
alloc(newmem2,$1000,attackrange2)

label(code2)
label(return2)

newmem2:

code2:
  mov [rax+rcx*4+20],(float)99999
  mov eax,[rax+rcx*4+28]
  jmp GameAssembly.dll+E14E78
  jmp return2

attackrange2:
  jmp newmem2
  nop
return2:
registersymbol(attackrange2)

[DISABLE]

attackrange+08:
  db F2 0F 10 44 88 20
attackrange2:
  db 8B 44 88 28 EB 32

unregistersymbol(*)
dealloc(*)
//Send@Sintrix|FearlessRevolution
</AssemblerScript>
