              <Description>"Rapid Attack &amp; Always Critical Hit"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@FearlessRevolution|Sintrix
[ENABLE]
aobscanmodule(rapidattk,GameAssembly.dll,F3 48 0F 2A 40 10)
alloc(newmem,$1000,rapidattk)
label(code return)

newmem:
push rbx
mov rbx,[rbx+250]
mov [rbx+1D0],(float)9999
mov [rbx+E8],#999999
mov [rbx+178],(float)10000000
mov [rbx+180],#10000000
mov [rbx+188],(float)10000000

code:
  pop rbx
  cvtsi2ss xmm0,[rax+10]
  jmp return

