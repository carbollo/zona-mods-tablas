<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>104</ID>
      <Description>"Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'Metria.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end


--Set Window Title
local title = "Metria 1.2 x SINTRIX";
if not((MainForm.Caption):match("metria")) then
MainForm.Caption = title..' ~ '..MainForm.Caption
end


[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1104</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>1337094691</ID>
              <Description>"Ignore Damage"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix|FearlessRevolution
[ENABLE]
EnemyScript.AttackProcess:
db C3
EnemyScript.BeginAttackProcess:
db C3
EnemyScript.ChangeTarget:
db C3
EnemyScript.Update:
db C3
[DISABLE]
