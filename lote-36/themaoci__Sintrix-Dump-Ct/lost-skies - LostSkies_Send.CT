  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Load Scripts from lua file
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('LostSkies.exe','', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>779</ID>
              <Description>"Disable Enemy AI"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,AITargetAcquisition.SetPlayerAggro)
define(bytes,48 89 5C 24 08)

[ENABLE]
WildSkies.AI.Attacks.EnemyGrapple.Update:
db C3
WildSkies.AI.Attacks.EnemyGrapple.TryFireAtTarget:
db C3
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.HitTarget:
db C3
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.Update:
db C3
AIProjectile.FireProjectile:
db C3
AIProjectile.FireProjectile:
db C3
AIProjectile.TryDamageObject:
db C3
AIShipTracking.SetPlayerTarget:
db C3
AIShipTracking.Update:
db C3
AISkyEncounter.OnDetected:
db C3
AISkyEncounter.AssignTargetShip:
db C3
assert(address,bytes)
alloc(newmem,$1000,AITargetAcquisition.SetPlayerAggro)

label(code)
label(return)

newmem:
push rcx
mov rcx,[rcx+50]
mov [rcx+EC],0
pop rcx

code:
  mov [rsp+08],rbx
  jmp return

address:
  jmp newmem
return:

[DISABLE]
AITurretLaser.get_CanSeeTarget:
db 0F B6 41 50
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.HitTarget:
db 48 89 5C 24 20
WildSkies.AI.Attacks.EnemyGrapple.Update:
db 40 53
WildSkies.AI.Attacks.EnemyGrapple.TryFireAtTarget:
db 48 8B C4
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.Update:
db 48 89 5C 24 08
AIProjectile.FireProjectile:
db F2 0F 10 02
AIProjectile.FireProjectile:
db 48 89 5C 24 08
AIProjectile.TryDamageObject:
db 48 89 5C 24 20
AIShipTracking.SetPlayerTarget:
db 48 89 5C 24 18
AIShipTracking.Update:
db 48 89 5C 24 08
AISkyEncounter.OnDetected:
db 40 53
AISkyEncounter.AssignTargetShip:
db 48 89 91 B8 00 00 00
address:
  db bytes

dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>777</ID>
              <Description>"→ Invincible"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,WildSkies.Player.LocalPlayer.Update)
define(bytes,40 53 48 83 EC 30)

[ENABLE]
//Send@FearlessRevolution|Sintrix

assert(address,bytes)
alloc(newmem,$1000,WildSkies.Player.LocalPlayer.Update)
registersymbol(iOn)
label(code return iOn)

newmem:
push rcx
mov rcx,[rcx+30]
cmp [iOn],1
jne @f
mov [rcx+100],1

@@:
cmp [iOn],1
je code
mov [rcx+100],0
jmp code

code:
  pop rcx
  push rbx
  sub rsp,30
  jmp return

iOn:
dd 0

address:
  jmp newmem
  nop
return:

[DISABLE]
//Send@FearlessRevolution|Sintrix
address:
  db bytes

dealloc(*)

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>806</ID>
                  <Description>"Toggle On/Off"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
iOn:
dd 1

[DISABLE]
iOn:
dd 0
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>827</ID>
              <Description>"One Hit Kill"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@FearlessRevolution|Sintrix
define(address,WildSkies.AI.AIEntityHealth.Damage)
define(bytes,48 89 5C 24 10)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,WildSkies.AI.AIEntityHealth.Damage)

label(code)
label(return)

newmem:
mov [rcx+2C],(float)0
mov [rcx+F8],0
code:
  mov [rsp+10],rbx
  jmp return

address:
  jmp newmem
return:

[DISABLE]

address:
  db bytes
//Send@FearlessRevolution|Sintrix
dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>774</ID>
              <Description>"Infinite Stamina"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,PlayerStaminaController.LateUpdate)
define(bytes,40 53 48 83 EC 40)

[ENABLE]
//Send@FearlessRevolution|Sintrix

assert(address,bytes)
alloc(newmem,$1000,PlayerStaminaController.LateUpdate)

label(code)
label(return)

newmem:
mov [rcx+82],1

code:
  push rbx
  sub rsp,40
  jmp return

address:
  jmp newmem
  nop
return:
//Send@FearlessRevolution|Sintrix
[DISABLE]

address:
  db bytes


dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>805</ID>
              <Description>"Max Item Amount On Click"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//Send@FearlessRevolution|Sintrix
aobscanmodule(stackCount,GameAssembly.dll,8B 40 40 48 83 C4 28 C3 E8 E6 33)
alloc(newmem,$1000,stackCount)

label(code)
label(return)

newmem:

code:
  mov eax,#999
  add rsp,28
  jmp return

stackCount:
  jmp newmem
  nop 2
return:
registersymbol(stackCount)

[DISABLE]

stackCount:
  db 8B 40 40 48 83 C4 28

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>803</ID>
              <Description>"Free Crafting"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,CraftingService.get_FreeCrafting)
define(bytes,0F B6 41 58 C3)

