<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>766</ID>
      <Description>"Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'Ninja Rift.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end


--Set Window Title
local title = "Ninja Rift";
if not((MainForm.Caption):match("Ninja Rift")) then
MainForm.Caption = title..' - '..MainForm.Caption
end


[DISABLE]



</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Infinite Health (Take Damage)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix|FearlessRevolution
[ENABLE]

aobscan(dmg,89 46 1C 8B 46 1C 83)
alloc(newmem,$1000)
label(code return)

newmem:
cmp dword ptr [esi+34],#0
je code
mov eax,[esi+1C]
mov [esi+1C],eax
mov eax,[esi+1C]
jmp return

code:
  mov [esi+1C],eax
  mov eax,[esi+1C]
  jmp return

dmg:
  jmp newmem
  nop
return:
registersymbol(dmg)

[DISABLE]

dmg:
  db 89 46 1C 8B 46 1C

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>7</ID>
          <Description>"One Hit Kill (Take Damage)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscan(ohk,8B 58 1C 66 0F 57 C9)
alloc(newmem,$1000)
label(code return)
//Send@Sintrix|FearlessRevolution
newmem:
cmp dword ptr [eax+34],#0
jne code
mov [eax+1C],#0
mov ebx,[eax+1C]
xorpd xmm1,xmm1
jmp code

code:
  mov ebx,[eax+1C]
  xorpd xmm1,xmm1
  jmp return

ohk:
  jmp newmem
  nop 2
return:
registersymbol(ohk)

[DISABLE]

ohk:
  db 8B 58 1C 66 0F 57 C9

unregistersymbol(*)
dealloc(*)


</AssemblerScript>
        </CheatEntry>
