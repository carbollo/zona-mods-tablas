        <CheatEntry>
          <ID>773</ID>
          <Description>"→ Wallet"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(pWaller,GameAssembly.dll,F2 0F 10 40 10 48 83 C4 28 C3 E8 54)
alloc(newmem,$1000,pWaller)
registersymbol(wallet)
label(code return wallet)

newmem:
mov [wallet],rax

code:
  movsd xmm0,[rax+10]
  jmp return

wallet:
dw

pWaller:
  jmp newmem
return:
registersymbol(pWaller)

[DISABLE]

pWaller:
  db F2 0F 10 40 10

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
