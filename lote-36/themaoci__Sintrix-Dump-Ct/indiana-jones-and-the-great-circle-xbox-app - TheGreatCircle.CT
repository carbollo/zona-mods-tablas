<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>452</ID>
      <Description>"Enable"</Description>
      <Options moHideChildren="1"/>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'TheGreatCircle.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end

--Set Window Title
local title = "Indiana Jones The Great Circle 1.0 by Sintrix";
if not((MainForm.Caption):match("TheGreatCircle")) then
MainForm.Caption = title..' ~ '..MainForm.Caption
end

--Credits
if MainForm.lblSigned.Caption:match('By Sintrix') == nil then
  local Main = MainForm.lblSigned
  local MadeBy = createPanel(Main.Parent)


  MadeBy.AutoSize = true
  MadeBy.Anchors = '[akTop,akRight,akLeft]'
  MadeBy.AnchorSideTop.Control = MadeBy.Parent
  MadeBy.AnchorSideTop.Side = asrCenter
  MadeBy.AnchorSideRight.Control = MainForm.CommentButton
  MadeBy.AnchorSideRight.Side = asrLeft
  MadeBy.AnchorSideLeft.Control = MainForm.advancedbutton
  MadeBy.AnchorSideLeft.Side = asrRight

  Main.Parent = MadeBy
  Main.Visible = true
  Main.Caption = 'By Sintrix'
  Main.Font.Size = 12
  Main.Font.Style = '[fsBold]'
  Main.Font.Quality = 'fqCleartypeNatural'
  Main.AnchorSideTop.Control = MadeBy
  Main.AnchorSideTop.Side = asrCenter
  Main.AnchorSideLeft.Control = MadeBy
  Main.AnchorSideLeft.Side = asrCenter
end

[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>461</ID>
          <Description>"-&gt; [Health]"</Description>
          <Options moHideChildren="1"/>
          <Color>FFFF00</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>460</ID>
              <Description>"Infinite Health (Do not use with [Health Settings])"</Description>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>// CamoHax@sintrix.net
[ENABLE]
aobscanmodule(address,TheGreatCircle.exe,F3 0F 10 4E 44 42)
alloc(newmem,1024,TheGreatCircle.exe)
alloc(obytes_infhp, 10)
label(return originalcode)

registersymbol(obytes_infhp)

obytes_infhp:
readmem(address, 10)

newmem:

originalcode:
 mov [rsi+44],(float)200
 movss xmm1,[rsi+44]
 jmp return

address:
 jmp newmem
 return:


[DISABLE]

address:
readmem(obytes_infhp, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>8</ID>
              <Description>"-&gt; [Health Settings]"</Description>
              <Options moHideChildren="1"/>
              <Color>FFFF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>// CamoHax@sintrix.net
[ENABLE]
aobscanmodule(address,TheGreatCircle.exe,F3 0F 10 4E 44 42)
alloc(newmem,1024,TheGreatCircle.exe)
alloc(obytes_HB, 10)
label(return originalcode)

registersymbol(obytes_HB healthbase)

obytes_HB:
readmem(address, 10)

newmem:

originalcode:
 mov [healthbase],rsi
 movss xmm1,[rsi+44]
 jmp return


healthbase:
dd 0

address:
 jmp newmem
 return:


[DISABLE]

address:
readmem(obytes_HB, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
