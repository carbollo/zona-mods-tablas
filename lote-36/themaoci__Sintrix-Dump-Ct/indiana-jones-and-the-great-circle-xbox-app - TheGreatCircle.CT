        <CheatEntry>
          <ID>465</ID>
          <Description>"One Hit Kill"</Description>
          <Color>00FF00</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>// CamoHax@sintrix.net
[ENABLE]
aobscanmodule(aob_scan1, $process, 07 00 00 F3 0F 10 40 44)
aobscanmodule(aob_scan2, $process, F3 0F 10 43 44 B9)
alloc(code, 256, aob_scan1)
alloc(xyz, 256, aob_scan2)
label(r1)
label(r2)
registersymbol(aob_scan1)
registersymbol(aob_scan2)

code:
  mov [rax+44], (float)1
  movss xmm0, [rax+44]
  jmp r1
aob_scan1+03:
  jmp code
r1:

xyz:
  mov [rbx+44], (float)1
  movss xmm0, [rbx+44]
  jmp r2
aob_scan2:
  jmp xyz
r2:

[DISABLE]
dealloc(code)
dealloc(xyz)
unregistersymbol(aob_scan1)
unregistersymbol(aob_scan2)
aob_scan1+03:
  db F3 0F 10 40 44
aob_scan2:
  db F3 0F 10 43 44

</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
