        <CheatEntry>
          <ID>6</ID>
          <Description>"-&gt; [Stamina]"</Description>
          <Options moHideChildren="1"/>
          <Color>FFFF00</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>2</ID>
              <Description>"Infinite Stamina (Do not use with [Stamina Settings])"</Description>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>// CamoHax@sintrix.net
[ENABLE]
aobscanmodule(Sprintnf,TheGreatCircle.exe,03 46 0C 66 0F 6E C0 0F 5B C0 F3 0F 58 46 18 0F 2F) // should be unique
alloc(newmem,$1000,Sprintnf)

label(code)
label(return)

newmem:

code:
  mov [rsi+0c],#10
  mov [rsi+8],#10
  add eax,[rsi+0C]
  movd xmm0,eax
  jmp return

Sprintnf:
  jmp newmem
  nop 2
return:
registersymbol(Sprintnf)

[DISABLE]

Sprintnf:
  db 03 46 0C 66 0F 6E C0

unregistersymbol(Sprintnf)
dealloc(newmem)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>3</ID>
              <Description>"-&gt; [Stamina Settings]"</Description>
              <Options moHideChildren="1"/>
              <Color>FFFF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>// CamoHax@sintrix.net
[ENABLE]
aobscanmodule(SprintBase,TheGreatCircle.exe,03 46 0C 66 0F 6E C0 0F 5B C0 F3 0F 58 46 18 0F 2F) // should be unique
alloc(newmem,$1000,SprintBase)

label(code)
label(return)
registersymbol(Sprintobj)

newmem:

code:
  mov [Sprintobj],rsi
  add eax,[rsi+0C]
  movd xmm0,eax
  jmp return

Sprintobj:
dd 0

SprintBase:
  jmp newmem
  nop 2
return:
registersymbol(SprintBase)

[DISABLE]

SprintBase:
  db 03 46 0C 66 0F 6E C0

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
