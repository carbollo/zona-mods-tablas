  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('Jotunnslayer.exe','', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>996</ID>
              <Description>"Show Console (Use 'help' to show commands. Disable script to hide console.)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Shaggy&amp;Send@Sintrix|FearlessRevolution
[ENABLE]

////////////////////////  showconsole  \\\\\\\\\\\\\\\\\\\\\\\\
{$lua}
consoleinst = mono_invoker('GamesFarm.Core','GuiConsole','get_Instance','',{});

writeByte(consoleinst + 0x88, 1)

{$asm}
aobscanregion(address,GamesFarm.UI.GuiConsole.set_IsVisible+200,GamesFarm.UI.GuiConsole.set_IsVisible+400,40 88 B3 88 00 00 00 48 8B CB)
alloc(newmem,1024,GameAssembly.dll)
alloc(obytes_showconsole, 10)
label(return originalcode)

registersymbol(obytes_showconsole)

obytes_showconsole:
readmem(address, 10)

newmem:
//Shaggy&amp;Send@Sintrix|FearlessRevolution
originalcode:
 mov [rbx+00000088],1
 jmp return

address:
 jmp newmem
 nop 2
return:

//Shaggy&amp;Send@Sintrix|FearlessRevolution
[DISABLE]

address:
readmem(obytes_showconsole, 10)
//Shaggy&amp;Send@Sintrix|FearlessRevolution
dealloc(*)
unregistersymbol(*)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>998</ID>
              <Description>"→ Get Player"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>
[ENABLE]

aobscanmodule(GetNetPlayerController,GameAssembly.dll,48 * * 48 * * 0F * * 4C * * * * * * 48 * * * * * * 41 * * F3 * * * * F3)
alloc(newmemGetNetPlayerController,$100,GetNetPlayerController)
alloc(GetNPC,8,GetNetPlayerController)
label(codeGetNetPlayerController returnGetNetPlayerController)

newmemGetNetPlayerController:
mov [GetNPC],rdi

codeGetNetPlayerController:
mov rdx,[rdi]
mov rcx,rdi
jmp returnGetNetPlayerController

GetNPC:
dw

GetNetPlayerController+0:  
jmp newmemGetNetPlayerController
nop 1
returnGetNetPlayerController:
registersymbol(GetNetPlayerController GetNPC)



[DISABLE]

GetNetPlayerController+0:
db 48 8B 17 48 8B CF
unregistersymbol(GetNetPlayerController GetNPC)
dealloc(newmemGetNetPlayerController GetNPC)
</AssemblerScript>
