                <CheatEntry>
                  <ID>1027</ID>
                  <Description>"→ Attack Speed Multiplier"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(AttackSpeedMultiplier,GameAssembly.dll,C7 87 90 0E 00 00 00 00 80 3F)
alloc(newmem,$1000,AttackSpeedMultiplier)
registersymbol(AtkSpeed)
label(code return AtkSpeed)

newmem:

code:
  movss xmm15,[AtkSpeed]
  movss [rdi+00000E90],xmm15
  jmp return

AtkSpeed:
dd (float)10

AttackSpeedMultiplier:
  jmp newmem
  nop 5
return:
registersymbol(AttackSpeedMultiplier)

[DISABLE]

AttackSpeedMultiplier:
  db C7 87 90 0E 00 00 00 00 80 3F

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>1028</ID>
                      <Description>"Set Attack Speed Multiplier"</Description>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>Float</VariableType>
                      <Address>AtkSpeed</Address>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
                <CheatEntry>
                  <ID>1001</ID>
                  <Description>"Infinite Shield"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(Shield,GameAssembly.dll,F3 0F 10 80 A4 02 00 00 E8)
alloc(newmem,$1000,Shield)

label(code)
label(return)

newmem:
mov [rax+2A4],(float)10000
code:
  movss xmm0,[rax+000002A4]
  jmp return

Shield:
  jmp newmem
  nop 3
return:
registersymbol(Shield)

[DISABLE]

Shield:
  db F3 0F 10 80 A4 02 00 00

unregistersymbol(Shield)
dealloc(newmem)

</AssemblerScript>
