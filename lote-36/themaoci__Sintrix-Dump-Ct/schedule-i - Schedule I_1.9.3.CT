              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <Color>008080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(instantGrowthNew,GameAssembly.dll,F3 0F 11 49 28 48 8B)
alloc(newmem_growthh,$100,instantGrowthNew)
alloc(plant_base,8,instantGrowthNew)
label(code_growthh return_growthh)

newmem_growthh:
mov [plant_base],rcx

  movss [rcx+28],xmm6 // growth progress (float)1 = instant
  mov [rcx+2C],(float)99 // base yield level
  mov [rcx+30],(float)1 // quality level
  jmp return_growthh

code_growthh:
  movss [rcx+28],xmm1
  jmp return_growthh

instantGrowthNew:
  jmp newmem_growthh
return_growthh:
registersymbol(instantGrowthNew plant_base)


{$lua}
if syntaxcheck then return end

grwtme=createTimer() grwtme.interval=100 grwtme.ontimer=function()

  local plant_base=getAddressSafe('[plant_base]')

    if plant_base then

      local MoistureCapacity=getAddressSafe('[[plant_base]+20]+214')
      local currentMoistureAmount=getAddressSafe('[[plant_base]+20]+2FC')

      local SoilCapacity=getAddressSafe('[[plant_base]+20]+210')
      local currentSoilAmount=getAddressSafe('[[plant_base]+20]+2F8')

      local moistureDrainPerHour=getAddressSafe('[[plant_base]+20]+21C')


      local BaseYieldQuantity=getAddressSafe('[plant_base]+7C')


      writeFloat(moistureDrainPerHour,0)
      writeFloat(currentSoilAmount,readFloat(SoilCapacity))
      writeFloat(currentMoistureAmount,readFloat(MoistureCapacity))


    end

end


{$asm}

[DISABLE]

instantGrowthNew:
  db F3 0F 11 49 28
unregistersymbol(instantGrowthNew plant_base)
dealloc(newmem_growthh plant_base)

luacall(if grwtme then grwtme.destroy() grwtme=nil end)

