              <Color>008080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local base=getAddressSafe('[mptr]')

local ADDR = {
  --CurrentPursuitLevel            = { addr='[[[mptr]+20]+180]+130', type='int',   val=0 },
  BodySearchPending              = { addr='[[[mptr]+20]+180]+168', type='byte',  val=0 },
  MaxInteractionRange            = { addr='[[[[[mptr]+20]+180]+118]+160]+30', type='float', val=0 },
  Enabled                        = { addr='[[[[[mptr]+20]+180]+118]+2F0]+119', type='byte',  val=0 },
  Started                        = { addr='[[[[[mptr]+20]+180]+118]+2F0]+12C', type='byte',  val=0 },
  Active                         = { addr='[[[[[mptr]+20]+180]+118]+2F0]+12D', type='byte',  val=0 },
  GiveUpRange                    = { addr='[[[[[mptr]+20]+180]+118]+2F0]+17C', type='float', val=0 },
  DefaultMovementSpeed           = { addr='[[[[[mptr]+20]+180]+118]+2F0]+188', type='float', val=0 },
  DefaultSearchTime              = { addr='[[[[[mptr]+20]+180]+118]+2F0]+1A0', type='float', val=0 },
  ArrestCircleMaxVisibleDistance = { addr='[[[[[mptr]+20]+180]+118]+2F0]+230', type='float', val=0 },
  arrestingEnabled               = { addr='[[[[[mptr]+20]+180]+118]+2F0]+250', type='byte',  val=0 },
  CurrentArrestProgress          = { addr='[[[mptr]+20]+180]+148', type='float', val=0 },
  CurrentBodySearchProgress      = { addr='[[[mptr]+20]+180]+14C', type='float', val=0 },
  AwarenessActiveByDefault       = { addr='[[[[[mptr]+20]+180]+118]+180]+20', type='byte',  val=0 },
  RangeMultiplier                = { addr='[[[[[[mptr]+20]+180]+118]+180]+28]+134', type='float', val=0 },
  Attentiveness                  = { addr='[[[[[[mptr]+20]+180]+118]+180]+28]+140', type='float', val=0 },
  Memory                         = { addr='[[[[[[mptr]+20]+180]+118]+180]+28]+144', type='float', val=0 },
  Suspicion                      = { addr='[[[[mptr]+20]+180]+118]+364', type='float', val=0 },
  Leniency                       = { addr='[[[[mptr]+20]+180]+118]+368', type='float', val=0 },
  BodySearchChance               = { addr='[[[[mptr]+20]+180]+118]+36C', type='float', val=0 },
  BodySearchDuration             = { addr='[[[[mptr]+20]+180]+118]+370', type='float', val=0 },
  generalCrimeResponseActive     = { addr='[[[[mptr]+20]+180]+118]+3A0', type='byte',  val=0 },
  noticeGeneralCrime             = { addr='[[[[[[mptr]+20]+180]+118]+180]+28]+1B8', type='byte',  val=0 },
}

local READ = {
  byte  = readByte,
  int   = readInteger,
  float = readFloat,
}

local WRITE = {
  byte  = writeByte,
  int   = writeInteger,
  float = writeFloat,
}

local ORIGINAL = {}

local function resolveAndCache()
  for k,v in pairs(ADDR) do
    local a = getAddressSafe(v.addr)
    if a then
      v.resolved = a
      ORIGINAL[k] = READ[v.type](a)
    end
  end
end

local function applyValues()
  for _,v in pairs(ADDR) do
    if v.resolved then
      WRITE[v.type](v.resolved, v.val)
    end
  end
end

local function restoreValues()
  for k,v in pairs(ADDR) do
    if v.resolved and ORIGINAL[k] ~= nil then
      WRITE[v.type](v.resolved, ORIGINAL[k])
    end
  end
end

[ENABLE]

if base then
  resolveAndCache()
  police_tmr=createTimer() police_tmr.Interval=10 police_tmr.OnTimer=function()
    if base then
      applyValues()
      --local cpl=ADDR.CurrentPursuitLevel.resolved
      local cpl=getAddressSafe('[[[mptr]+20]+180]+130')
      if readFloat(cpl) &gt; 0 then writeFloat(cpl,5) end

    end
  end
end

[DISABLE]
if police_tmr then police_tmr.destroy() police_tmr=nil end
restoreValues()

</AssemblerScript>
