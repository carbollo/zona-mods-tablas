  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Schedule | 2026"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>008080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) local bufferSize = 4096 local buffer = createMemoryStream() while src.Position &lt; src.Size do local toRead = math.min(bufferSize, src.Size - src.Position) buffer.Size = 0 buffer.copyFrom(src, toRead) buffer.Position = 0 dst.copyFrom(buffer, buffer.Size) end buffer.destroy() dst.destroy() return outPath end local dll="Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll if not fileExists(outPath) then eTFTD(dll,outPath) loadPlugin(outPath) else loadPlugin(outPath) end
setAddressListPicture('https://imgur.com/4pl47YF.png',210,0x0000FF)
startTable('Schedule I.exe','Schedule | 2026', 'Schedule I v1.9.3', 'Bytrl | Send | Camo', true)
MainForm.Width=720 MainForm.Height=780 ald('scripts').active=true

local function asmCode()

  autoAssemble([[
  aobscanmodule(findmptr,GameAssembly.dll,F3xxxxxxxx33xx38xxxx75xxE8xxxxxxxxF3xxxxxxxxxxxxxxxx33)
  alloc(newmemfindmptr,$100,findmptr)
  alloc(mptr,8,findmptr)
  label(codefindmptr returnfindmptr)
  newmemfindmptr:
  mov [mptr],rbx
  codefindmptr:
  movss xmm6,[rbx+4C]
  jmp returnfindmptr
  findmptr:
  jmp newmemfindmptr
  returnfindmptr:
  registersymbol(findmptr mptr)]])

  autoAssemble([[
