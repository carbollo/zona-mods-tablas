                <CheatEntry>
                  <ID>65</ID>
                  <Description>"Infinite Feathers (Open Collection Menu)"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(feathers,GameAssembly.dll,8B 44 99 20 48 83 C4 20 5B C3 E8 25)
alloc(newmem,$1000,feathers)
label(code return)

newmem:

code:
  mov eax,[rcx+rbx*4+20]
  mov eax,#10000000
  add rsp,20
  jmp return

feathers:
  jmp newmem
  nop 3
return:
