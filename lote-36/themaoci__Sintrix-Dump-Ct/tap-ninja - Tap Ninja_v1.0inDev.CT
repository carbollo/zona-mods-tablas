                <CheatEntry>
                  <ID>38</ID>
                  <Description>"Infinite Samurai Frenzy "</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Send@Sintrix
[ENABLE]

aobscanmodule(skillcd,GameAssembly.dll,C1 F3 0F 11 80 F4 02 00 00)
alloc(newmem,$1000,skillcd)
label(code return)

newmem:

code:
  movss xmm0,[new]
  movss [rax+000002F4],xmm0
  jmp return

new:
dd (float)336.4549561

skillcd+01:
  jmp newmem
  nop 3
return:
registersymbol(skillcd)

[DISABLE]

skillcd+01:
  db F3 0F 11 80 F4 02 00 00

unregistersymbol(*)
dealloc(*)

