  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Mullet Mad Jack.exe"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>FFFF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local Bytrl='zRBd7uBBzZ' local Flexy='FNaAhxWkWj' local Send='NTFcdAUWxb' local Yem='WqMSVTuKt6'
--------------------------------------------------------------------------------
local imageUrl='https://i.imgur.com/iYAxPRA.jpeg'   --Background image
local game='Mullet Mad Jack.exe'                            --Target Process
local title='Mullet Mad Jack'                                   --Cheat Engine Header
local footer='MMJ | v1.13'                                  --Cheat Engine Footer
local creator='FLEXY'                            --Made By String
local isMono=true                               --true if mono else false
local monoAddress='PlayerControl.Update'                             --Any mono address if mono
local discordLink="https://discord.gg/" .. Flexy --use name as it appears in variables above
--------------------------------------------------------------------------------
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
--------------------------------------------------------------------------------
function resetClick(memrec) synchronize(createTimer,60,memrec.setActive,false) end
local function changeMemRec(oldDesc, newDesc) local al = getAddressList() local rec = al.getMemoryRecordByDescription(oldDesc) if rec then rec.Description = newDesc return true else return false end end
local function iav(targetAddress,callback) monoChkTmr=createTimer() monoChkTmr.Interval=1000 monoChkTmr.onTimer=function() local address=getAddressSafe(targetAddress) if address then callback() monoChkTmr.destroy() monoChkTmr=nil if monoChkTmr then else end else end end end
local function ald(description) local al=getAddressList() local rec=al.getMemoryRecordByDescription(description) if rec then return rec end rec=al.createMemoryRecord() rec.Description=description rec.IsGroupHeader=true rec.Options="" rec.Type=vtCustom rec.DontSave=false rec.Active=false return rec end
local function setupGlobalMemrecColorizer() local al = getAddressList() if not al then return end local originalColors = {} local cycleSpeed = 0.01 local function cycleColor(mr, elapsedTime) local r = math.floor(128 + 127 * math.sin(elapsedTime)) local g = math.floor(128 + 127 * math.sin(elapsedTime + 2)) local b = math.floor(128 + 127 * math.sin(elapsedTime + 4)) local color = (r &lt;&lt; 16) + (g &lt;&lt; 8) + b mr.Color = color mr.DescriptionColor = color end local function applyColor(mr) if mr.Active then return true else if originalColors[mr.ID] then mr.Color = originalColors[mr.ID] mr.DescriptionColor = originalColors[mr.ID] end end end local function hookRecord(mr) if not mr then return end mr.OnActivate = function(memrec, before, currentstate) if before then return true end originalColors[memrec.ID] = memrec.Color or 0x00000000 memrec.Color = 0x0000FF00 memrec.DescriptionColor = 0x0000FF00 return true end mr.OnDeactivate = function(memrec, before, currentstate) if before then return true end memrec.Color = originalColors[memrec.ID] or 0x00000000 memrec.DescriptionColor = originalColors[memrec.ID] or 0x00000000 return true end applyColor(mr) local count = mr.Count or 0 for i = 0, count - 1 do hookRecord(mr.Child[i]) end end local count = al.Count or 0 for i = 0, count - 1 do hookRecord(al[i]) end local elapsedTime = 0 local function colorCyclingTimer() elapsedTime = elapsedTime + cycleSpeed for i = 0, count - 1 do local mr = al[i] if mr.Active then cycleColor(mr, elapsedTime) end end end local colorTimer = createTimer(nil, false) colorTimer.Interval = 60 colorTimer.OnTimer = colorCyclingTimer colorTimer.Enabled = true end
local function mono_call(classname, funcname, args) local domain = '' args = args or {} local method = mono_findMethod(domain, classname, funcname) if not method then print("mono_call: Unable to find method " .. classname .. "." .. funcname) return nil end local function tryInvoke(instance) instance = instance or 0 local ok, res = pcall(mono_invoke_method, domain, method, instance, args) if ok then return true, res end return false, res end local ok, res = tryInvoke(0) if ok then return res end local cid = mono_findClass(domain, classname) if not cid then print("mono_call: Class not found: " .. classname) return nil end local instances = mono_class_findInstancesOfClassListOnly(cid) if not instances or #instances == 0 then print("mono_call: No instances found for class: " .. classname) return nil end for _, inst in ipairs(instances) do ok, res = tryInvoke(inst) if ok then return res end end print("mono_call: Invocation failed on all instances of " .. classname) return nil end
local function getImageFromUrl(url) local http = getInternet() if not http then print("Error: getInternet() failed") return nil end local data = http.getURL(url) http.destroy() if (not data) or (#data == 0) then print("Error: Failed to download:", url) return nil end local ms = createStringStream(data) ms.Position = 0 local pic = createPicture() local ok = pcall(function() pic.LoadFromStream(ms) end) ms.destroy() if not ok then print("Error: Could not load image:", url) return nil end return pic end
local function startTable(process, title, footer, creatorName, mono) local procHandle if mono then procHandle = mono_initialize(openProcess(process)) LaunchMonoDataCollector(procHandle) else procHandle = openProcess(process) end if not (MainForm.Caption:match(title)) then MainForm.Caption = title .. ' ~ ' .. MainForm.Caption end AddressList.List.Font.Style = 'fsBold' if not MainForm.lblSigned.Caption:match(footer) then local Main = MainForm.lblSigned local MadeBy = createPanel(Main.Parent) MadeBy.AutoSize = true MadeBy.Anchors = '[akTop,akRight,akLeft]' MadeBy.AnchorSideTop.Control = MadeBy.Parent MadeBy.AnchorSideTop.Side = asrCenter MadeBy.AnchorSideRight.Control = MainForm.CommentButton MadeBy.AnchorSideRight.Side = asrLeft MadeBy.AnchorSideLeft.Control = MainForm.advancedbutton MadeBy.AnchorSideLeft.Side = asrRight Main.Parent = MadeBy Main.Visible = true Main.Caption = footer Main.Font.Size = 10 Main.Font.Style = '[fsBold]' Main.Font.Quality = 'fqCleartypeNatural' Main.AnchorSideTop.Control = MadeBy Main.AnchorSideTop.Side = asrCenter Main.AnchorSideLeft.Control = MadeBy Main.AnchorSideLeft.Side = asrCenter local creatorLabel = createLabel(MadeBy) creatorLabel.Caption = "Made by: " .. creatorName creatorLabel.Font.Size = 10 creatorLabel.Font.Style = '[fsBold]' creatorLabel.Font.Quality = 'fqCleartypeNatural' creatorLabel.Anchors = '[akTop, akLeft]' creatorLabel.AnchorSideTop.Control = MadeBy creatorLabel.AnchorSideTop.Side = asrCenter creatorLabel.AnchorSideLeft.Control = MadeBy creatorLabel.AnchorSideLeft.Side = asrLeft local discordButton = createButton(MadeBy) discordButton.Caption = "Discord" discordButton.Font.Size = 10 discordButton.Font.Style = '[fsBold]' discordButton.Font.Quality = 'fqCleartypeNatural' discordButton.Anchors = '[akTop, akRight]' discordButton.AnchorSideTop.Control = MadeBy discordButton.AnchorSideTop.Side = asrCenter discordButton.AnchorSideRight.Control = MadeBy discordButton.AnchorSideRight.Side = asrRight discordButton.Width = 150 discordButton.BorderStyle = bsNone discordButton.OnClick = function() ShellExecute(discordLink) end end addCompactMenu() cycleFullCompact(nil, true) end
local function setAddressListPicture(picture, opacity, addressListFontColour) if picture == nil then error('Invalid picture to assign to the address list.') return end if opacity &lt;= 0 or opacity &gt;= 255 then opacity = 255 end image = image or createImage(MainForm.Panel1) image.Left = 0 image.Top = 0 image.Align = 'alClient' image.AutoSize = true image.Stretch = true image.Picture.Assign(getImageFromUrl(picture)) image.sendToBack() AddressList.setLayeredAttributes(0xFFFFFF, opacity, 0x2) MainForm.Panel1.setLayeredAttributes(0xFFFFFFF, 255, 0x2) AddressList.List.Font.Color = addressListFontColour or 0xFFFFF end
local function cycleFullCompact(sender,force) local state = not(compactmenuitem.Caption == 'Compact View Mode') if force~=nil then state = not force end compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode' getMainForm().Splitter1.Visible = state getMainForm().Panel5.Visible = state end;
local function addCompactMenu() if compactmenualreadyexists then return end local parent = getMainForm().Menu.Items compactmenuitem = createMenuItem(parent) parent.add(compactmenuitem) compactmenuitem.Caption = 'Compact View Mode' compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes' end;

[ENABLE]
changeMemRec('Attach &amp; Initialize', game)
setAddressListPicture(imageUrl,210,0x0000FF) startTable(game,title,footer,creator,isMono) --MainForm.Width=700 MainForm.Height=600

local function asmCode()

  autoAssemble([[define(PlayerControl_Update, PlayerControl.Update)
alloc(newmemPlayerControl_Update,$100,PlayerControl_Update)
alloc(Player,8,PlayerControl_Update)
label(codePlayerControl_Update returnPlayerControl_Update)

newmemPlayerControl_Update:
mov [Player],rcx

codePlayerControl_Update:
push rbp
push rbx
push r14
jmp returnPlayerControl_Update

PlayerControl_Update:
jmp newmemPlayerControl_Update
returnPlayerControl_Update:
registersymbol(PlayerControl_Update Player)
]])
----------------------------------------------------------------------
--  autoAssemble([[aobscanmodule(Cords,UnityPlayer.dll,F2 * * * * * * * * F2 * * * * * * * * 49 * * * * * * 66 * * * 66)
--alloc(newmemCords,$100,Cords)
--alloc(PositionPTR,8,Cords)
--label(codeCords returnCords)

--newmemCords:
--mov [PositionPTR],r14

--codeCords:
--movsd xmm1,[r14+000001F8]
--jmp returnCords

--Cords:
--jmp newmemCords
--nop 4
--returnCords:
--registersymbol(Cords PositionPTR)]])
  autoAssemble([[]])

end


if isMono==true then iav(monoAddress,asmCode) else asmCode() end --wait for mono or just execute asm code

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

local isInvincible=getAddressSafe('[[Player]+20]+50')
if ald('Godmode').Active==true then writeByte(isInvincible,1) else writeByte(isInvincible,0) end
--------------
local walkSpeed=getAddressSafe('[[Player]+20]+64')
if ald('Speed x2').Active==true then writeFloat(walkSpeed,20) else writeFloat(walkSpeed,10) end
--------------
local gravityRatio=getAddressSafe('[[Player]+20]+68')
if ald('Moon Gravity').Active==true then writeFloat(gravityRatio,0.2) else writeFloat(gravityRatio,3) end
--------------
local jumpForce=getAddressSafe('[[Player]+20]+2C4')
if ald('Jump x2').Active==true then writeFloat(jumpForce,24) else writeFloat(jumpForce,12) end
--------------
local infiniteAmmo=getAddressSafe('[[Player]+70]+7C')
if ald('Infinite Ammo').Active==true then writeByte(infiniteAmmo,1) else writeByte(infiniteAmmo,0) end
--------------
end

--if ald('scripts').Active~=true then ald('scripts').Active=true end


[DISABLE]

autoAssemble([[PlayerControl_Update:
db 40 55 53 41 56
unregistersymbol(PlayerControl_Update Player)
dealloc(newmemPlayerControl_Update Player)]])
--autoAssemble([[Cords:
--db F2 41 0F 10 8E F8 01 00 00
--unregistersymbol(Cords PositionPTR)
--dealloc(newmemCords PositionPTR)]])
autoAssemble([[]])

if _tmr then _tmr.destroy() _tmr=nil end


</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1337142594</ID>
