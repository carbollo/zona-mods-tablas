            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>1337142596</ID>
          <Description>"֍-Weapon"</Description>
          <Options moHideChildren="1"/>
          <Color>C3C3C3</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1337142618</ID>
              <Description>"Infinite Ammo"</Description>
              <Color>00BFBF</Color>
              <GroupHeader>1</GroupHeader>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142626</ID>
              <Description>"Current ammo"</Description>
              <Color>0066CC</Color>
              <VariableType>4 Bytes</VariableType>
              <Address>[player]+70</Address>
              <Offsets>
                <Offset>78</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142616</ID>
              <Description>"Current mag size"</Description>
              <Color>0066CC</Color>
              <VariableType>4 Bytes</VariableType>
              <Address>[Player]+70</Address>
              <Offsets>
                <Offset>70</Offset>
              </Offsets>
