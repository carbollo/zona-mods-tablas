                <Offset>20</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142600</ID>
              <Description>"Max health"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <Color>0066CC</Color>
