{$Lua}
if syntaxcheck then return end
local Base= getAddress("UnityPlayer.dll");
local nBase= Base + 0x01BD61c0;
local mBase = Base + 0x01C50e28;

local nspawnPointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(nBase)+0x1f0)+0x0)+0x90)+0x110)+0xc0)+0x128)+0x0;
local mbboardPointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(mBase)+0x150)+0x28)+0x8)+0x8)+0x88)+0x28)+0x0;
registerSymbol("mbboardptr2", mbboardPointer );
registerSymbol("nspawnptr",nspawnPointer);
nspawnptrstring = string.format("0x%X",nspawnPointer)
mbptrstring2 = string.format("0x%X",mbboardPointer )

{$asm}

