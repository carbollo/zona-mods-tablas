                              <AssemblerScript>[ENABLE]
usemono()
{$Lua}

if syntaxcheck then return end

if not monopipe then  error(MessageDialog('Failed to Launch Mono Data Collector', mtError, mbClose)) end

local method = mono_findMethod('', 'NetworkSpawner', 'CmdSpawnProp')

local vector = newvec
local address = nspawnptrstring
local propId = tonumber(inputQuery("Prop ID 2-5", "ID:",""))
local amount = tonumber(inputQuery("Amount 1-500 (higher number wil get laggy)", "Amount:",""))


local args={}
args[1]={}
args[1].type=vtDword
args[1].value = propId
args[2]={}
args[2].type=vtPointer
args[2].value = vector
args[3]={}
args[3].type=vtPointer
args[3].value = vector

mono_invoke_method('', method, address,args)

for x=0, amount, 1 do
  sleep(50)
  args[1].value = propId
  args[2].value = vector
  args[3].value = vector
  mono_invoke_method('', method, address,args)
end


if not syntaxcheck then
   synchronize(createTimer,60,memrec.setActive,false)
  end
 
{$asm}
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
