                      <Color>00FF00</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>//Send@FearlessRevolution
[ENABLE]

aobscanregion(super_sprint,StarterAssets.FirstPersonController:Move+9c,StarterAssets.FirstPersonController:Move+fe,11 F3 0F 10 46 38)
alloc(newmem,$1000,super_sprint)
registersymbol(sprint_flag)
label(code return sprint_flag)

newmem:
cmp [sprint_flag],1
jne @f
mov [rsi+38],(float)25
movss xmm0,[rsi+38]
jmp return

@@:
mov [rsi+38],(float)10

code:
  movss xmm0,[rsi+38]
  jmp return

sprint_flag:
dd 0

super_sprint+01:
  jmp newmem
return:
registersymbol(super_sprint)

[DISABLE]

super_sprint+01:
  db F3 0F 10 46 38

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
