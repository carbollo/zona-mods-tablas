                          <AssemblerScript>//CamoHax@Sintrix
[ENABLE]
{$lua}
if not syntaxcheck then

function mono_getInstancesWithValue(domain, classname, offset, datatype, targetamount)
  local cid = mono_findClass(domain,classname)
  local fields = mono_class_enumFields(cid)
  local instances = mono_class_findInstancesOfClassListOnly(cid)
  local retlist = {}
  for _, instance in ipairs(instances) do
      local a = string.format('0x%X', instance)
      local x = readByType(instance, offset, datatype)
      if x == targetamount then do
         retlist[#retlist + 1] = a
         end
      end
  end
  return retlist
end
local ilist = mono_getInstancesWithValue("", "DemolishDebrisControl", 0x78, "Integer", 21)

for _, address in ipairs(ilist) do
    for i = 0, 21 do
      mono_invoker('','DemolishDebrisControl', "CmdRemoveDebris", address, {{type = vtDword, value = i}})
      sleep(50)
    end
end

    synchronize(createTimer, 60, memrec.setActive, false)
end
