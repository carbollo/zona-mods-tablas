local Base = getAddress("UnityPlayer.dll");
local mBase = Base + 0x01C50e28; -- Manager Blackboard
local uBase = Base + 0x01BD61C8; -- Upgrades Manager

local gdataPointer = mono_name_getStaticFieldValue('','GameData','Instance',1)


-- Reading mbboardPointer and upgmanptr
local mbboardPointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(mBase)+0x150)+0x28)+0x8)+0x8)+0x88)+0x28)+0x0;
local UpgradePointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(uBase)+0x90)+0x158)+0x260)+0x60)+0x118)+0x128)+0x0;
registerSymbol("gdataptr", readPointer(gdataPointer));
registerSymbol("mbboardptr", mbboardPointer );
registerSymbol("upgmanptr", UpgradePointer );
gdptrstring = string.format("0x%X", readPointer(gdataPointer))
mbptrstring = string.format("0x%X",mbboardPointer )
umptrstring = string.format("0x%X",UpgradePointer )
{$asm}


