  <LuaScript>local function setAddressListPicture(picture, opacity, addressListFontColour)
      if picture == nil then error('Invalid picture to assign to the address list.') return end
      if opacity &lt;= 0 or opacity &gt;= 255 then opacity = 255 end

      image = image or createImage(MainForm.Panel1)
      image.Left = 0
      image.Top = 0
      image.Align = 'alClient'
      image.AutoSize = true
      image.Stretch = true
      image.Picture.loadFromStream(findTableFile(picture).Stream)
      image.sendToBack()
      AddressList.setLayeredAttributes(0xFFFFFF, opacity, 0x2)
      MainForm.Panel1.setLayeredAttributes(0xFFFFFFF, 255, 0x2)
      AddressList.List.Font.Color = addressListFontColour or 0xFFFFF
end
AddressList.List.Font.Style = 'fsBold'
setAddressListPicture('sintrix.jpg', 210, 0x0000FF)
function cycleFullCompact(sender,force)     local state = not(compactmenuitem.Caption == 'Compact View Mode'); if force~=nil then state = not force end; compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'; getMainForm().Splitter1.Visible = state; getMainForm().Panel4.Visible    = state; getMainForm().Panel5.Visible    = state; end; function addCompactMenu() if compactmenualreadyexists then return end; local parent = getMainForm().Menu.Items; compactmenuitem = createMenuItem(parent); parent.add(compactmenuitem); compactmenuitem.Caption = 'Compact View Mode'; compactmenuitem.OnClick = cycleFullCompact; compactmenualreadyexists = 'yes'; end; addCompactMenu(); cycleFullCompact(nil,true);



</LuaScript>
</CheatTable>
