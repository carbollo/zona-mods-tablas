local method = mono_findMethod('', 'NPC_Manager', 'SetEmployeesHats')


local hatIndex = 1
local totalHats = 70


local function changeHat()
    local args = {}
    args[1] = {}
    args[1].type = vtByte
    args[1].value = hatIndex


    mono_invoke_method('', method, npcmanptrstring, args)


    hatIndex = hatIndex + 1
    if hatIndex &gt; totalHats then
        hatIndex = 1
    end
end


local hatTimer = createTimer(nil, true)
hatTimer.Interval = 100 -- Set the interval to 100 ms
hatTimer.OnTimer = changeHat -- Set the function to call on each timer tick


hatTimer.Enabled = true


function disableHatTimer()
    hatTimer.Enabled = false
    hatTimer.destroy()
end


registerSymbol("disableHatTimer", disableHatTimer)

