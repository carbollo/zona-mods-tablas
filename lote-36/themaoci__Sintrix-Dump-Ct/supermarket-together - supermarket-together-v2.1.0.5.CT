                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>4 Bytes</VariableType>
                          <Address>npcmanptr</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>327</ID>
                          <Description>"💣 Give Employees Unicorn Hats"</Description>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$Lua}
if syntaxcheck then return end

if not monopipe then if LaunchMonoDataCollector() == 0 then  error(MessageDialog('Failed to Launch Mono Data Collector', mtError, mbClose)) end end

local method = mono_findMethod('', 'NPC_Manager', 'SetEmployeesHats')
local args={}
args[1]={}
args[1].type=vtByte
args[1].value = 5

mono_invoke_method('', method, npcmanptrstring,args)

if not syntaxcheck then
   synchronize(createTimer,60,memrec.setActive,false)
  end
 
