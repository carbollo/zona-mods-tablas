                <CheatEntry>
                  <ID>173</ID>
                  <Description>"→ [ Singleplayer ]"</Description>
                  <Options moHideChildren="1"/>
                  <Color>00FF00</Color>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>317</ID>
                      <Description>"Items marked with 🧨 must be re-enabled when joining a new lobby."</Description>
                      <Color>0080FF</Color>
                      <GroupHeader>1</GroupHeader>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>313</ID>
                      <Description>"🧨 [ Lobby Functions ] (Singleplayer)"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

--local Base = getAddress("UnityPlayer.dll");

--local mBase = Base + 0x01C50e28;

-- Reading gdataPointer with error checking
local npcmanPointer = mono_name_getStaticFieldValue('','NPC_Manager','Instance',1)


-- Reading mbboardPointer with error checking
--local mbboardPointer = readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(readPointer(mBase)+0x150)+0x28)+0x8)+0x8)+0x88)+0x28)+0x0;
registerSymbol("npcmanptr", readPointer(npcmanPointer));
--registerSymbol("mbboardptr", mbboardPointer );
npcmanptrstring = string.format("0x%X", readPointer(npcmanPointer))
--mbptrstring = string.format("0x%X",mbboardPointer )

{$asm}


[DISABLE]
</AssemblerScript>
                      <CheatEntries>
