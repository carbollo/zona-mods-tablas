  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Load Scripts from lua file
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('LostSkies.exe','', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>779</ID>
              <Description>"Disable Enemy AI"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
WildSkies.AI.Attacks.EnemyGrapple.Update:
db C3
WildSkies.AI.Attacks.EnemyGrapple.TryFireAtTarget:
db C3
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.HitTarget:
db C3
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.Update:
db C3
AIProjectile.FireProjectile:
db C3
AIProjectile.FireProjectile:
db C3
AIProjectile.TryDamageObject:
db C3
AIShipTracking.SetPlayerTarget:
db C3
AIShipTracking.Update:
db C3
AISkyEncounter.OnDetected:
db C3
AISkyEncounter.AssignTargetShip:
db C3

[DISABLE]
AITurretLaser.get_CanSeeTarget:
db 0F B6 41 50
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.HitTarget:
db 48 89 5C 24 20
WildSkies.AI.Attacks.EnemyGrapple.Update:
db 40 53
WildSkies.AI.Attacks.EnemyGrapple.TryFireAtTarget:
db 48 8B C4
WildSkies.AI.Attacks.EnemyGrapplePlayerSide.Update:
db 48 89 5C 24 08
AIProjectile.FireProjectile:
db F2 0F 10 02
AIProjectile.FireProjectile:
db 48 89 5C 24 08
AIProjectile.TryDamageObject:
db 48 89 5C 24 20
AIShipTracking.SetPlayerTarget:
db 48 89 5C 24 18
AIShipTracking.Update:
db 48 89 5C 24 08
AISkyEncounter.OnDetected:
db 40 53
AISkyEncounter.AssignTargetShip:
db 48 89 91 B8 00 00 00


</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>833</ID>
              <Description>"→ Grab Ship Data"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@FearlessRevolution|Sintrix
define(address,WildSkies.Ship.ShipCore.OnShipControlUpdate)
define(bytes,0F 10 02 8B 42 18)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,WildSkies.Ship.ShipCore.OnShipControlUpdate)
registersymbol(gShipCore)
label(code return gShipCore)

newmem:
mov [gShipCore],rcx

code:
  movups xmm0,[rdx]
  mov eax,[rdx+18]
  jmp return

gShipCore:
dw

address:
  jmp newmem
  nop
return:

[DISABLE]

address:
  db bytes

//Send@FearlessRevolution|Sintrix
dealloc(*)
unregistersymbol(*)

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>923</ID>
                  <Description>"→ Ship Core"</Description>
                  <Options moHideChildren="1"/>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>835</ID>
                      <Description>"Current Health"</Description>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>Float</VariableType>
                      <Address>[gShipCore]+0100</Address>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>834</ID>
                          <Description>"Max Health"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>[gShipCore]+50</Address>
                        </CheatEntry>
                      </CheatEntries>
                    </CheatEntry>
