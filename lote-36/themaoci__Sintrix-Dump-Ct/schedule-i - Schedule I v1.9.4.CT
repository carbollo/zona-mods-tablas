                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanmodule(findYaw,UnityPlayer.dll,)
  alloc(newmemfindYaw,$100,findYaw)
  alloc(yaw,8,findYaw)
