            <CheatEntry>
              <ID>368557</ID>
              <Description>"cash"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <Color>C0C0C0</Color>
              <VariableType>Float</VariableType>
              <Address>[cash]+30</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>368250</ID>
              <Description>"time multiplier"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <Color>C0C0C0</Color>
              <VariableType>Float</VariableType>
              <Address>time</Address>
              <Offsets>
                <Offset>13C</Offset>
              </Offsets>
            </CheatEntry>
            <CheatEntry>
              <ID>368249</ID>
              <Description>"Time"</Description>
