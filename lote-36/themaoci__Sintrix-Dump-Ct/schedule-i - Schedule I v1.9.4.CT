            <CheatEntry>
              <ID>1337142591</ID>
              <Description>"Flight"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

if _G.Bytrl_FlightSpeedxy == nil then _G.Bytrl_FlightSpeedxy = 3 end
if _G.Bytrl_FlightSpeedz == nil then _G.Bytrl_FlightSpeedz = 12 end

local MoveSpeedMultiplier = getAddressSafe('[[mptr]+68]+10')

[ENABLE]
if flightTmr then flightTmr.destroy() flightTmr = nil end

local function clamp(v,mn,mx)
  if v &lt; mn then return mn end
  if v &gt; mx then return mx end
  return v
end

flightTmr=createTimer() flightTmr.Interval=10 flightTmr.onTimer=function()

    if MoveSpeedMultiplier then writeFloat(MoveSpeedMultiplier, _G.Bytrl_FlightSpeedxy) end
    local VelocityZ = getAddressSafe('[mptr]+9C')
    if not VelocityZ then return end

    local vertSpeed = _G.Bytrl_FlightSpeedz

    local upKey   = isKeyPressed(VK_SPACE) and 1 or 0
    local downKey = isKeyPressed(VK_SHIFT) and 1 or 0

    local pad = getXBox360ControllerState(0)
    if pad then
        upKey   = pad.GAMEPAD_LEFT_SHOULDER  and 1 or upKey
        downKey = pad.GAMEPAD_RIGHT_SHOULDER and 1 or downKey
    end

    local ud = upKey - downKey
    local moveZ = ud * vertSpeed

    writeFloat(VelocityZ, moveZ)
end

[DISABLE]
if flightTmr then
    flightTmr.destroy()
    flightTmr = nil
end

if _G.Bytrl_FlightSpeedxy then _G.Bytrl_FlightSpeedxy = nil end
if _G.Bytrl_FlightSpeedz then _G.Bytrl_FlightSpeedz = nil end
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337142592</ID>
                  <Description>"Flight speed"</Description>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

_G.Bytrl_FlightSpeedxy=_G.Bytrl_FlightSpeedxy or 3
_G.Bytrl_FlightSpeedz=_G.Bytrl_FlightSpeedz or 12

local fsform = createForm(false)
fsform.Caption = "Bytrl Flight Speed Controller"
fsform.Width = 320
fsform.Height = 110
fsform.Position = "poScreenCenter"

local lblDist = createLabel(fsform)
lblDist.Caption = "Horizontal flight speed (xy axis): " .. _G.Bytrl_FlightSpeedxy
lblDist.Left = 10
lblDist.Top = 10

local sDist = createTrackBar(fsform)
sDist.Min = 1
sDist.Max = 20
sDist.Position = _G.Bytrl_FlightSpeedxy
sDist.Left = 10
sDist.Top = lblDist.Top + 15
sDist.Width = 310
sDist.OnChange = function()
  _G.Bytrl_FlightSpeedxy = sDist.Position
  lblDist.Caption = "horizontal flight speed: " .. sDist.Position
end

local lblDist2 = createLabel(fsform)
lblDist2.Caption = "Vertical flight speed (z axis): " .. _G.Bytrl_FlightSpeedz
lblDist2.Left = 10
lblDist2.Top = sDist.Top + 30

local sDist2 = createTrackBar(fsform)
sDist2.Min = 1
sDist2.Max = 50
sDist2.Position = _G.Bytrl_FlightSpeedz
sDist2.Left = 10
sDist2.Top = lblDist2.Top + 15
sDist2.Width = 310
sDist2.OnChange = function()
  _G.Bytrl_FlightSpeedz = sDist2.Position
  lblDist2.Caption = "vertical flight speed: " .. sDist2.Position
end

fsform.OnClose = function()
  fsform.destroy()
  resetClick(memrec)
end

fsform.show()

[DISABLE]

if fsform then
  fsform.close()
  fsform = nil
end

</AssemblerScript>
