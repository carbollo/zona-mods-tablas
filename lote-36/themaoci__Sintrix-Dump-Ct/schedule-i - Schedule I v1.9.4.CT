addictsTmr=createTimer() addictsTmr.Interval=100 addictsTmr.onTimer=function()
  local Unlocked=getAddressSafe('[[[_customerr]+168]+1F0]+14')
  local CanCallPolice=getAddressSafe('[[[_customerr]+168]+188]+30')
  local MinOrdersPerWeek=getAddressSafe('[[_customerr]+188]+30')
  local MaxOrdersPerWeek=getAddressSafe('[[_customerr]+188]+34')
  local BaseAddiction=getAddressSafe('[[_customerr]+188]+58')
  local CurrentAddiction=getAddressSafe('[_customerr]+11C')
  local MinWeeklySpend=getAddressSafe('[[_customerr]+188]+28')
  local MaxWeeklySpend=getAddressSafe('[[_customerr]+188]+2C')
  local DependenceMultiplier=getAddressSafe('[[_customerr]+188]+54')
  local HasBeenRecommended=getAddressSafe('[_customerr]+160')
    if Unlocked then
      writeByte(Unlocked,1)
      writeByte(CanCallPolice,0)
      writeInteger(MinOrdersPerWeek,99)
      writeInteger(MaxOrdersPerWeek,999)
      writeFloat(BaseAddiction,9999)
      writeFloat(CurrentAddiction,9999)
      writeFloat(MinWeeklySpend,9999)
      writeFloat(MaxWeeklySpend,99999)
      writeFloat(DependenceMultiplier,999)
      writeByte(HasBeenRecommended,1)
    end
end


