label(codetrashGrabberFinder returntrashGrabberFinder)

newmemtrashGrabberFinder:
mov [trashgrabber_base],rcx

codetrashGrabberFinder:
mov rcx,[rcx+000000C0]
jmp returntrashGrabberFinder

trashGrabberFinder:
jmp newmemtrashGrabberFinder
nop 2
returntrashGrabberFinder:
registersymbol(trashGrabberFinder trashgrabber_base)

{$lua}
  bintmr=createTimer() bintmr.Interval=100 bintmr.onTimer=function()
    local stacklimit=getAddressSafe('[[[[trashgrabber_base]+C0]+38]+10]+18')
    if cap then writeInteger(stacklimit,0) end
  end
{$asm}

[DISABLE]

{$lua}
  if bintmr then bintmr.destroy() bintmr=nil end
{$asm}

trashGrabberFinder:
db 48 8B 89 C0 00 00 00
unregistersymbol(trashGrabberFinder trashgrabber_base)
dealloc(newmemtrashGrabberFinder trashgrabber_base)

