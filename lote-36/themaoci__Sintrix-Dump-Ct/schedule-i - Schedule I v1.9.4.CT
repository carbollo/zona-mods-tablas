  local BasePurchasePrice=getAddressSafe('[[injCopy]+18]+80')
  writeFloat(BasePurchasePrice,0)

  local RequiresLevelToPurchase=getAddressSafe('[[injCopy]+18]+90')
  writeByte(RequiresLevelToPurchase,0)

  local RequiredRank=getAddressSafe('[[injCopy]+18]+94')
  writeInteger(RequiredRank,0)


end
