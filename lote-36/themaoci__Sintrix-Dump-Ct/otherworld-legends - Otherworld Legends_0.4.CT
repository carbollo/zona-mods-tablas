</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>796</ID>
              <Description>"No Skill Cooldown"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@FearlessRevolution/Sintrix
define(address,"GameAssembly.dll"+199AEB4) //Skill.update
define(bytes,F3 0F 10 05 04 3D 2A 02)

define(address2,"GameAssembly.dll"+199D3F9) //Skill.get_additionalSkillCooldown
define(bytes2,F3 0F 58 05 BF 17 2A 02)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,"GameAssembly.dll"+199AEB4)

label(code)
label(return)

newmem:

code:
  movss xmm0,[GameAssembly.dll+3C3EBC0]
  xorps xmm0,xmm0
  jmp return

address:
  jmp newmem
  nop 3
return:

assert(address2,bytes2)
alloc(newmem2,$1000,"GameAssembly.dll"+199D3F9)

label(code2)
label(return2)

newmem2:

code2:
  addss xmm0,[GameAssembly.dll+3C3EBC0]
  xorps xmm0,xmm0
  jmp return2

address2:
  jmp newmem2
  nop 3
return2:

[DISABLE]

address:
  db bytes

address2:
  db bytes2


dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>798</ID>
              <Description>"Coin Drop Modifier"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@FearlessRevolution|Sintrix
////CoinInScene.Update
define(address,"GameAssembly.dll"+1ABBEBD)
define(bytes,48 8B D9 E8 0B 82 8E FE)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,"GameAssembly.dll"+1ABBEBD)
registersymbol(scis)
label(code return scis)

newmem:
push r13
mov r13,[scis]
mov [rcx+30],r13

code:
  pop r13
  mov rbx,rcx
  call CoopServerSteam.AdvertiseServer
  jmp return

scis:
dd #1000

address:
  jmp newmem
  nop 3
return:

[DISABLE]

address:
  db bytes

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
