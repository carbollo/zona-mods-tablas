{$asm}
aobscanmodule(charcontroller,GameAssembly.dll,F3??????????????E8????????F3??????F3??????????????488B)
alloc(newmem,$1000,charcontroller)
registersymbol(charcontroller overlord InstantKill)
label(code return onehit overlord InstantKill)
newmem:
cmp byte ptr [rdi+002A],1
jne onehit
mov [overlord],rdi
jmp return

onehit:
cmp [InstantKill],1
jne code
cmp byte ptr [rdi+0028],1
jne code
xorps xmm0,xmm0

code:
  movss [rdi+00000124],xmm0
  jmp return

overlord:
dq 0

InstantKill:
dd 0

charcontroller:
  jmp newmem
  nop 3
return:


