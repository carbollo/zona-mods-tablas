            <CheatEntry>
              <ID>791</ID>
              <Description>"Rapid Attack Speed"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>define(address,Player.Update)
define(bytes,40 55 57 48 8D 6C 24 B1)

[ENABLE]

//Send@FearlessRevolution|Sintrix


assert(address,bytes)
alloc(newmem,$1000,Player.Update)

label(code)
label(return)

newmem:
mov [rcx+DC],#-10
mov [rcx+F4],#-10

code:
  push rbp
  push rdi
  lea rbp,[rsp-4F]
  jmp return

address:
  jmp newmem
  nop 3
return:

[DISABLE]

address:
  db bytes

dealloc(*)

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>787</ID>
              <Description>"One Hit Kill"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@FearlessRevolution|Sintrix
[ENABLE]
aobscanmodule(enemyHP2,GameAssembly.dll,0F 11 86 40 02 00 00 0F 11 8E 50 02 00 00 0F 11 96 60 02 00 00 E8)
alloc(newmem2,$1000,enemyHP2)

label(code2)
label(return2)

newmem2:

code2:
  xorps xmm0,xmm0
  movups [rsi+00000240],xmm0
  jmp return2

enemyHP2:
  jmp newmem2
  nop 2
return2:
registersymbol(enemyHP2)

[DISABLE]

enemyHP2:
  db 0F 11 86 40 02 00 00

unregistersymbol(*)
dealloc(*)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>784</ID>
