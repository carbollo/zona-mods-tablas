local visibleItems = {}

local function BuildGiveArgs(itemId, amount)
  -- Current known-bad/full raw console line mode:
  return {
    {type=vtString, value=string.format("give %s %d", itemId, amount)}
  }

  -- Next test mode: already split command args.
  -- return {
  --   {type=vtString, value=itemId},
  --   {type=vtString, value=tostring(amount)}
  -- }

  -- Third test mode: include command word too.
  -- return {
  --   {type=vtString, value="give"},
  --   {type=vtString, value=itemId},
  --   {type=vtString, value=tostring(amount)}
  -- }
end

local function SubmitGive(itemId, amount, sweepAll)
  cache_instances(consoleClass)

  local instances = InstanceCache[consoleClass]
  if not instances or #instances == 0 then
    print("[SubmitGive] No instances for " .. consoleClass)
    return false
  end

  local args = BuildGiveArgs(itemId, amount)
  print(string.format("[SubmitGive] item=%s amount=%s sweepAll=%s", itemId, tostring(amount), tostring(sweepAll)))

  local successCount = 0

  for i, inst in ipairs(instances) do
    print(string.format("[SubmitGive] Instance %d/%d 0x%X", i, #instances, inst))

    local ok = mono_call(consoleClass, consoleMethod, args, inst)

    print(string.format("[SubmitGive] Result instance=0x%X ok=%s", inst, tostring(ok)))

    if ok then
      successCount = successCount + 1

      if not sweepAll then
        print("[SubmitGive] Stopping after first CE-success because sweepAll=false")
        break
      end
    end

    sleep(100)
  end

  print(string.format("[SubmitGive] Finished. CE-success count=%d", successCount))
  return successCount &gt; 0
end

local function SpawnItem(itemId, amount, sweepAll)
  amount = math.floor(tonumber(amount) or 1)
  if amount &lt; 1 then amount = 1 end

  return SubmitGive(itemId, amount, sweepAll)
end

local f = createForm(false)
spawnItemForm = f
spawnItemCloseGuard = false

f.Caption = "Spawn Item"
f.Width = 340
f.Height = 400
f.Position = "poScreenCenter"

local padding = 16

local lblFilter = createLabel(f)
lblFilter.Caption = "Filter:"
lblFilter.Left = 8
lblFilter.Top = 8

local edFilter = createEdit(f)
edFilter.Left = 8
edFilter.Top = 24
edFilter.Width = f.ClientWidth - padding

local lbItem = createListBox(f)
lbItem.Left = 8
lbItem.Top = 50
lbItem.Width = f.ClientWidth - padding
lbItem.Height = 260
lbItem.MultiSelect = false

local lblAmount = createLabel(f)
lblAmount.Caption = "Amount:"
lblAmount.Left = 8
lblAmount.Top = lbItem.Top + lbItem.Height + 6

local edAmount = createEdit(f)
edAmount.Left = 8
edAmount.Top = lblAmount.Top + 18
edAmount.Width = 80
edAmount.Text = "1"

local cbSweep = createCheckBox(f)
cbSweep.Caption = "Sweep all instances"
cbSweep.Left = 94
cbSweep.Top = lblAmount.Top + 2
cbSweep.Width = 220
cbSweep.Checked = false

local btnSpawn = createButton(f)
btnSpawn.Caption = "Spawn highlighted"
btnSpawn.Left = 94
btnSpawn.Top = edAmount.Top
btnSpawn.Width = 220
btnSpawn.Height = 24

local function refreshList(filterText)
  filterText = (filterText or ""):lower()
  visibleItems = {}
  lbItem.Items.clear()

  for _, item in ipairs(items) do
    local searchable = (item.name .. " " .. item.id):lower()

    if filterText == "" or searchable:find(filterText, 1, true) then
      table.insert(visibleItems, item)
      lbItem.Items.add(item.name)
    end
  end

  if lbItem.Items.Count &gt; 0 then
    lbItem.ItemIndex = 0
  else
    lbItem.ItemIndex = -1
  end
end

edFilter.OnChange = function(sender)
  refreshList(sender.Text)
end

btnSpawn.OnClick = function(sender)
  local idx = lbItem.ItemIndex
  if not idx or idx &lt; 0 then
    showMessage("Please select an item.")
    return
  end

  local item = visibleItems[idx + 1]
  if not item then
    showMessage("Invalid selection.")
    return
  end

  local ok = SpawnItem(item.id, edAmount.Text, cbSweep.Checked)

  if not ok then
    showMessage("AddItemToInventoryCommand.Execute failed.")
  end
end

f.OnClose = function(sender)
  if not spawnItemCloseGuard then
    spawnItemCloseGuard = true

    local ce = ald("Spawn Item Menu")
    if ce and ce.Active then
      ce.Active = false
    end

    spawnItemCloseGuard = false
  end

  spawnItemForm = nil
  return caFree
end

refreshList("")
f.show()

[DISABLE]

if spawnItemForm then
  if not spawnItemCloseGuard then
    spawnItemCloseGuard = true
    pcall(function() spawnItemForm.close() end)
    spawnItemCloseGuard = false
  end

  spawnItemForm = nil
end

