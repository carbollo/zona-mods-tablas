                  <ID>370003</ID>
                  <Description>"Everything is free"</Description>
                  <Color>0000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

//free phone purchases
aobscanmodule(itemprice,GameAssembly.dll,80 79 20 00 74 0A F3)
alloc(newmemfpp,$100,itemprice)
label(codefpp returnfpp)
newmemfpp:
mov [rcx+20],1
mov [rcx+21],(float)0.1
codefpp:
  cmp byte ptr [rcx+20],00
  je itemprice+10
  jmp returnfpp
itemprice:
  jmp newmemfpp
  nop
returnfpp:
registersymbol(itemprice)

//free supplier purchases
aobscanmodule(SupplierPurchases,GameAssembly.dll,F3 0F 59 82 80 00 00 00)
alloc(newmemfsp,$100,SupplierPurchases)
label(codefsp returnfsp)
newmemfsp:
mov [rdx+80],(float)0.01
codefsp:
  mulss xmm0,[rdx+00000080]
  jmp returnfsp
SupplierPurchases:
  jmp newmemfsp
  nop 3
returnfsp:
registersymbol(SupplierPurchases)

//free property purchases
alloc(newmemfprp,$100,ScheduleOne.Property.Property.UpdateCulling)
label(codefprp returnfprp)
newmemfprp:
mov [rcx+158],(float)0
codefprp:
  push rbx
  sub rsp,00000080
  jmp returnfprp
ScheduleOne.Property.Property.UpdateCulling:
  jmp newmemfprp
  nop 4
returnfprp:

{
//free business purchases
aobscanmodule(businessprice,GameAssembly.dll,E0 CC CC CC CC CC CC CC 48 89 5C 24 10 48 89 7C)
alloc(newmemfbp,$100,businessprice)
label(codefbp returnfbp)
newmemfbp:
mov [rcx+158],(float)0
codefbp:
  mov [rsp+10],rbx
  jmp returnfbp
businessprice+08:
  jmp newmemfbp
returnfbp:
registersymbol(businessprice)
}

//free vehicle purchases
aobscanmodule(vehicleprice,GameAssembly.dll,F3 0F 10 80 30 01 00 00)
alloc(newmemfvp,$100,vehicleprice)
label(codefvp returnfvp)
newmemfvp:
codefvp:
  movss xmm0,[rax+00000130]
  xorps xmm0,xmm0
  jmp returnfvp
vehicleprice:
  jmp newmemfvp
  nop 3
returnfvp:
registersymbol(vehicleprice)

//free store purchases
aobscanmodule(shopprice,GameAssembly.dll,488B??488B??E8????????4C????????????8B??488B??8B)
alloc(newmemfstp,$100,shopprice)
label(codefstp returnfstp)
newmemfstp:
mov [rax+20],1
mov [rax+21],(float)0.1
codefstp:
  mov rdx,rax
  mov rcx,rsi
  jmp returnfstp
shopprice:
  jmp newmemfstp
  nop
returnfstp:
registersymbol(shopprice)

[DISABLE]

itemprice:
  db 80 79 20 00 74 0A F3

SupplierPurchases:
  db F3 0F 59 82 80 00 00 00

ScheduleOne.Property.Property.UpdateCulling:
  db 40 53 48 81 EC 80 00 00 00
{
businessprice+08:
  db 48 89 5C 24 10
 }

vehicleprice:
  db F3 0F 10 80 30 01 00 00

shopprice:
  db 48 8B D0 48 8B CE

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
