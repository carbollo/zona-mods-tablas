  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Schedule | 2026"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>408080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "_Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end


[ENABLE]

startTable{
  process = "Schedule I.exe",
  title = "Schedule I v1.9.6",
  discord = "https://discord.gg/zRBd7uBBzZ",
  AddressListPic = "https://imgur.com/4pl47YF.png",
  compact = true,
  mono = true,
  monoAddress = "ScheduleOne.PlayerScripts.PlayerMovement.Update"
}

local function asmCode()

  autoAssemble([[
  aobscanmodule(findmptr,GameAssembly.dll,F3xxxxxxxx33xx38xxxx75xxE8xxxxxxxxF3xxxxxxxxxxxxxxxx0Fxxxx41)
  alloc(newmemfindmptr,$100,findmptr)
  alloc(mptr,8,findmptr)
  alloc(myCustomMoveSpeed,8,findmptr)
  alloc(findmptr_savedBytes,5,findmptr)
  label(codefindmptr returnfindmptr)

  myCustomMoveSpeed:
  dd (float)1

  findmptr_savedBytes:
  readmem(findmptr,5)

  newmemfindmptr:
  mov [mptr],rbx

  codefindmptr:
  movss xmm6,[rbx+44]
  jmp returnfindmptr

  findmptr:
  jmp newmemfindmptr
  returnfindmptr:
  registersymbol(findmptr mptr findmptr_savedBytes myCustomMoveSpeed)]])

  autoAssemble([[
  aobscanmodule(findjumpforce,GameAssembly.dll,F3xxxxxxxxF3xxxxxxxxxxxxxxC7xxxxxxxxxxxxF3xxxxxx0F)
  alloc(newmemfindjumpforce,$100,findjumpforce)
  alloc(customjumpforce,8,findjumpforce)
  define(jumpforce,newmemfindjumpforce+50)
  define(findjumpforce_savedBytes,newmemfindjumpforce+58)
  label(codefindjumpforce returnfindjumpforce)

  customjumpforce:
  dd (float)1

  findjumpforce_savedBytes:
  readmem(findjumpforce,5)

  newmemfindjumpforce:
  mov [jumpforce],rax

  codefindjumpforce:
  movss xmm0,[rax+08]
  jmp returnfindjumpforce

  findjumpforce:
  jmp newmemfindjumpforce
  returnfindjumpforce:
  registersymbol(findjumpforce newmemfindjumpforce jumpforce findjumpforce_savedBytes customjumpforce)]])

  autoAssemble([[
  aobscanmodule(findtime,GameAssembly.dll,F3xxxxxxxxxxxxxx33xxE8xxxxxxxxF3xxxxxxxxxxxxxxF3xxxxxxF3xxxxxxxxxxxxxxF3)
  alloc(newmemfindtime,$100,findtime)
  alloc(time,8,findtime)
  label(codefindtime returnfindtime)
  newmemfindtime:
  mov [time],rcx
  codefindtime:
  movss xmm6,[rcx+0000014C]
  jmp returnfindtime
  findtime:
  jmp newmemfindtime
  nop 3
  returnfindtime:
  registersymbol(findtime time)]])

  autoAssemble([[
  aobscanmodule(getcash,GameAssembly.dll,F3xxxxxxxx33xx488DxxxxxxF3xxxxxxxxxxE8xxxxxxxx4885)
  alloc(newmemgetcash,$100,getcash)
  alloc(cash,8,getcash)
  label(codegetcash returngetcash)
  newmemgetcash:
  mov [cash],rax
  codegetcash:
  addss xmm6,[rax+38]
  jmp returngetcash
  getcash:
  jmp newmemgetcash
  returngetcash:
  registersymbol(getcash cash)]])

  autoAssemble([[
  define(ScheduleOne_UI_PickpocketScreen_Update, ScheduleOne.UI.PickpocketScreen.Update)
  alloc(newmemScheduleOne_UI_PickpocketScreen_Update,$100,ScheduleOne_UI_PickpocketScreen_Update)
  alloc(opcodeBytesSaved,8,ScheduleOne_UI_PickpocketScreen_Update)
  alloc(pickPocket,8,ScheduleOne_UI_PickpocketScreen_Update)
  alloc(epp,4,ScheduleOne_UI_PickpocketScreen_Update)
  label(codeScheduleOne_UI_PickpocketScreen_Update returnScheduleOne_UI_PickpocketScreen_Update)
  opcodeBytesSaved:
  readmem(ScheduleOne_UI_PickpocketScreen_Update,8)
  epp:
  dd 0
  newmemScheduleOne_UI_PickpocketScreen_Update:
  cmp [epp],1
  jne @F
  mov [rcx+2C],(float)950
  mov [rcx+30],(float)950
  mov [rcx+40],(float)999999
  mov [rcx+C0],0
  @@:
  cmp [epp],0
  jne codeScheduleOne_UI_PickpocketScreen_Update
  mov [rcx+2C],(float)45
  mov [rcx+30],(float)7
  codeScheduleOne_UI_PickpocketScreen_Update:
  push rdi
  sub rsp,40
  jmp returnScheduleOne_UI_PickpocketScreen_Update
  ScheduleOne_UI_PickpocketScreen_Update:
  jmp newmemScheduleOne_UI_PickpocketScreen_Update
  nop 1
  returnScheduleOne_UI_PickpocketScreen_Update:
  registersymbol(ScheduleOne_UI_PickpocketScreen_Update epp opcodeBytesSaved)]])

  autoAssemble([[
  define(ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount,ScheduleOne.Growing.GrowContainer.get_NormalizedMoistureAmount)
  alloc(newmemScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount,$100,ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount)
  define(water,newmemScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount+50)
  define(ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount_savedBytes,newmemScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount+58)
  label(codeScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount returnScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount)

  ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount_savedBytes:
  readmem(ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount,8)

  newmemScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount:
  mov [water],rcx
  //mov [rcx+000002FC],(float)5 // _currentMoistureAmount

  codeScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount:
  movss xmm0,[rcx+000002FC]
  jmp returnScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount

  ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount:
  jmp newmemScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount
  nop 3
  returnScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount:
  registersymbol(ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount newmemScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount water ScheduleOne_Growing_GrowContainer_get_NormalizedMoistureAmount_savedBytes)]])


end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end
ald('scripts').active=true
_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

  local currentMoistureAmount=getAddressSafe('[water]+2FC')
  if currentMoistureAmount and ald('Always Watered').Active==true then writeFloat(currentMoistureAmount,5) end


  local currentSoilAmount=getAddressSafe('[water]+2F8')
  if currentSoilAmount and ald('Always Full Soil (may be visual only)').Active==true then writeFloat(currentSoilAmount,20) end


  local YieldMultiplier=getAddressSafe('[water]+3A4')
  if YieldMultiplier and ald('Increase Yield Multiplier').Active==true then
    if not _G.OldYieldMultiplier then _G.OldYieldMultiplier = readFloat(YieldMultiplier) end
    writeFloat(YieldMultiplier,1)
  else
    if _G.OldYieldMultiplier then writeFloat(YieldMultiplier,_G.OldYieldMultiplier) _G.OldYieldMultiplier=nil end
  end

  local GrowSpeedMultiplier=getAddressSafe('[water]+3A8')
  if GrowSpeedMultiplier and ald('Increase Grow Speed Multiplier').Active==true then
    if not _G.OldGrowSpeedMultiplier then _G.OldGrowSpeedMultiplier = readFloat(GrowSpeedMultiplier) end
    writeFloat(GrowSpeedMultiplier,100)
  else
    if _G.OldGrowSpeedMultiplier then writeFloat(GrowSpeedMultiplier,_G.OldGrowSpeedMultiplier) _G.OldGrowSpeedMultiplier=nil end
  end

  local MoveSpeedMultiplier=getAddressSafe('[[mptr]+68]+10')
  local newSpeed=getAddressSafe('myCustomMoveSpeed')
  if MoveSpeedMultiplier and newSpeed then
     writeFloat(MoveSpeedMultiplier,readFloat(newSpeed))
  end

  local jumpforce=getAddressSafe('[jumpforce]+8')
  local newjumpforce=getAddressSafe('customjumpforce')
  if jumpforce and newjumpforce then
     writeFloat(jumpforce,readFloat(newjumpforce))
  end

  local CurrentPursuitLevel=getAddressSafe('[[[mptr]+20]+180]+130')
  if CurrentPursuitLevel and ald('End pursuit music').Active==true then writeInteger(CurrentPursuitLevel,5) ald('End pursuit music').Active=false end

    local cash=getAddressSafe('[cash]+30')
    if cash and ald('Add cash').Active==true then
        ald('Add cash').Active=false
        local userInput=inputQuery('Set cash amount to add (will update visually when cash changes)', 'Enter amount to add:', '9999')
        local value=tonumber(userInput) if value~=nil then
            writeFloat(cash,readFloat(cash)+value)
        end
    end

    local currentTime=getAddressSafe('[time]+128')
    local timeSpeedmult=getAddressSafe('[time]+13C')
    if currentTime then
        if ald('Lock 12pm').Active==true then writeInteger(currentTime,1200) end
        if ald('Fast Time').Active==true then
          writeFloat(timeSpeedmult,100)
          local curTime=readInteger(currentTime)
          if curTime==400 then writeInteger(currentTime,700) end
        else
          writeFloat(timeSpeedmult,1)
        end
    end

    local health=getAddressSafe('[[[mptr]+20]+178]+11C')
      if health and ald('Infinite Health').Active==true then
        writeFloat(health,999)
      end

    local CurrentEnergy=getAddressSafe('[[[mptr]+20]+188]+20')
      if CurrentEnergy and ald('Infinite Energy').Active==true then
        writeFloat(CurrentEnergy,100)
      end

    local epp_flag=getAddressSafe('epp')
      if epp_flag and ald('Easy pickpocket').Active==true then writeByte(epp_flag,1) else writeByte(epp_flag,0) end

end



