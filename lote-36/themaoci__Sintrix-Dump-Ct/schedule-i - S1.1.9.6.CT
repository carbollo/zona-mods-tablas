if syntaxcheck then return end

[ENABLE]

local class="ConsoleCommand"
local method="Execute"

--use cached instance
if _G.ShowFPSInstance then
  mono_call(class,method,{{ type = vtString, value = "true" }},_G.ShowFPSInstance)
  resetClick(memrec)
  return
end

--find best instance and use
cache_instances(class)
local instances=InstanceCache[class]
local success=false

  if instances then
    for i, inst in ipairs(instances) do
      local ok = mono_call(class,method,{{type=vtString,value="showfps"}},inst)
      if ok then
        _G.ShowFPSInstance=inst
        success=true
        break
      end
    end
  end

if not success then print("❌ No working instance found") end

resetClick(memrec)

