[ENABLE]

local class="ConsoleUI"
local method="Submit"

--find best instance and use
cache_instances(class)
local instances=InstanceCache[class]
local success=false

  if instances then
    for i, inst in ipairs(instances) do
      local ok = mono_call(class,method,{{type=vtString,value='setweather clear'}},inst)
      if ok then
        success=true
        break
      end
    end
  end

if not success then print("❌ No working instance found") end

resetClick(memrec)

