[ENABLE]

autoAssemble([[
aobscanmodule(findCustomers,GameAssembly.dll,488Bxxxxxxxxxx83xxxxxxxxxxxx75xxE8xxxxxxxx4533xx33xx488BxxE8xxxxxxxx84xx74xx33xx488BxxE8xxxxxxxx488Bxxxxxx4883)
alloc(newmemfindCustomers,$100,findCustomers)
alloc(_customerr,8,findCustomers)
label(codefindCustomers returnfindCustomers)
newmemfindCustomers:
mov [_customerr],rbx
codefindCustomers:
mov rdi,[rbx+00000130]
jmp returnfindCustomers
findCustomers:
jmp newmemfindCustomers
nop 2
returnfindCustomers:
registersymbol(findCustomers _customerr)]])

autoAssemble([[
aobscanmodule(findnpcdata,GameAssembly.dll,38xxxxxxxxxx0Fxxxxxxxxxx48xxxxxxxxxxxx48xxxx0Fxxxxxxxxxx33xxE8xxxxxxxx48xxxxxxxxxxxx45)
alloc(newmemfindnpcdata,$100,findnpcdata)
define(NPC_base,newmemfindnpcdata+50)
define(findnpcdata_savedBytes,newmemfindnpcdata+58)
label(codefindnpcdata returnfindnpcdata)
findnpcdata_savedBytes:
readmem(findnpcdata,6)
newmemfindnpcdata:
mov [NPC_base],rdi
codefindnpcdata:
cmp [rdi+00000118],al
jmp returnfindnpcdata
findnpcdata:
jmp newmemfindnpcdata
nop 1
returnfindnpcdata:
registersymbol(findnpcdata newmemfindnpcdata NPC_base findnpcdata_savedBytes)]])

addictsTmr=createTimer() addictsTmr.Interval=100 addictsTmr.onTimer=function()

  local GuaranteeFirstSampleSuccess=getAddressSafe('[[_customerr]+188]+45')
  if GuaranteeFirstSampleSuccess and ald('Guarantee First Sample Success').Active==true then
    writeByte(GuaranteeFirstSampleSuccess,1)
  else
    writeByte(GuaranteeFirstSampleSuccess,0)
  end

  local MinWeeklySpend=getAddressSafe('[[_customerr]+188]+28')
  local MaxWeeklySpend=getAddressSafe('[[_customerr]+188]+2C')
  if MinWeeklySpend and ald('Increase Weekly Spend').Active==true then
    writeFloat(MinWeeklySpend,99999) writeFloat(MaxWeeklySpend,99999)
  else
    writeFloat(MinWeeklySpend,400) writeFloat(MaxWeeklySpend,1200)
  end

  local MinOrdersPerWeek=getAddressSafe('[[_customerr]+188]+30')
  local MaxOrdersPerWeek=getAddressSafe('[[_customerr]+188]+34')
  if MinOrdersPerWeek and ald('Increased orders per week').Active==true then
   writeInteger(MinOrdersPerWeek,9999) writeInteger(MaxOrdersPerWeek,9999)
  else
   writeInteger(MinOrdersPerWeek,1) writeInteger(MaxOrdersPerWeek,5)
  end

  local RelationDelta=getAddressSafe('[[[NPC_base]+170]+1F0]+10')
  if RelationDelta and ald('Max Relation Delta').Active==true then
    if not _G.OldRelationDelta then _G.OldRelationDelta = readFloat(RelationDelta) end
    writeFloat(RelationDelta,5)
  else
    if _G.OldRelationDelta then writeFloat(RelationDelta,_G.OldRelationDelta) _G.OldRelationDelta=nil end
  end

  local UnlockedNPC=getAddressSafe('[[[NPC_base]+170]+1F0]+14')
  local UnlockedCustomer=getAddressSafe('[[[_customerr]+168]+1F0]+14')
  if UnlockedNPC and ald('Npc Unlocked (test.. may not work)').Active==true then
    if not _G.OldUnlockedNPC then _G.OldUnlockedNPC = readByte(UnlockedNPC) end writeByte(UnlockedNPC,1)
    if not _G.OldUnlockedCustomer then _G.OldUnlockedCustomer = readByte(UnlockedCustomer) end writeByte(UnlockedCustomer,1)
  else
    if _G.OldUnlockedNPC then writeByte(UnlockedNPC,_G.OldUnlockedNPC) _G.OldUnlockedNPC=nil end
    if _G.OldUnlockedCustomer then writeByte(UnlockedCustomer,_G.OldUnlockedCustomer) _G.OldUnlockedCustomer=nil end
  end

  local CurrentAddiction=getAddressSafe('[_customerr]+11C')
  local BaseAddiction=getAddressSafe('[[_customerr]+188]+58')
  if CurrentAddiction and ald('Max Addiction').Active==true then
    if not _G.OldCurrentAddiction then _G.OldCurrentAddiction = readFloat(CurrentAddiction) end
    writeFloat(CurrentAddiction,9999)
    if not _G.OldBaseAddiction then _G.OldBaseAddiction = readFloat(BaseAddiction) end
    writeFloat(BaseAddiction,9999)
  else
    if _G.OldCurrentAddiction then writeFloat(CurrentAddiction,_G.OldCurrentAddiction) _G.OldCurrentAddiction=nil end
    if _G.OldBaseAddiction then writeFloat(BaseAddiction,_G.OldBaseAddiction) _G.OldBaseAddiction=nil end
  end

  local DependenceMultiplier=getAddressSafe('[[_customerr]+188]+54')
  if DependenceMultiplier and ald('Increase Dependence Multiplier').Active==true then
    writeFloat(DependenceMultiplier,999)
  else
    writeFloat(DependenceMultiplier,1)
  end

  local MoveSpeedMultiplier=getAddressSafe('[[[_customerr]+168]+168]+124')
  if MoveSpeedMultiplier and ald('Increase Customer Move Speed').Active==true then
     writeFloat(MoveSpeedMultiplier,5)
  else
     writeFloat(MoveSpeedMultiplier,1)
  end


end


[DISABLE]
if addictsTmr then addictsTmr.destroy() addictsTmr=nil end

