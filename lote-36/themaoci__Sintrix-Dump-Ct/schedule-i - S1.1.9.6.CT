chemtmr=createTimer() chemtmr.Interval=100 chemtmr.onTimer=function()

  local CookTimeMins=getAddressSafe('[[Chemistry]+10]+50')
  local CookTemperature=getAddressSafe('[[Chemistry]+10]+54')
  if CookTimeMins and ald('Instant cook').Active==true then
    if not _G.OldCookTimeMins then _G.OldCookTimeMins = readInteger(CookTimeMins) end
    writeInteger(CookTimeMins,0)
    if not _G.OldCookTemperature then _G.OldCookTemperature = readFloat(CookTemperature) end
    writeFloat(CookTemperature,0)
  else
    if _G.OldCookTimeMins then writeInteger(CookTimeMins,_G.OldCookTimeMins) _G.OldCookTimeMins=nil end
    if _G.OldCookTemperature then writeFloat(CookTemperature,_G.OldCookTemperature) _G.OldCookTemperature=nil end
  end

end

