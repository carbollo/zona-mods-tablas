            <CheatEntry>
              <ID>782</ID>
              <Description>"Edit Sun Stash"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(SunCount,GameAssembly.dll,8B 50 10 48 85 F6 0F 84 38)
alloc(newmem,$1000,SunCount)
alloc(EditSun,8,SunCount)
label(code return)

newmem:
push r12
lea r12,[rax+10]
mov [EditSun],r12
pop r12

code:
  mov edx,[rax+10]
  test rsi,rsi
  jmp return

SunCount:
  jmp newmem
  nop
return:
registersymbol(SunCount EditSun)

[DISABLE]

SunCount:
  db 8B 50 10 48 85 F6

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
