if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "Flexy.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]
FlexyVars()
startTable{
  process = "The Walking Trade.exe",
  title = "The Walking Trade v1.0.10 | FLEXY",
  setOverlayLabel = setOverlayLabel, discord = discord,kofi = kofi, AddressListPic = AddressListPic,
  compact = true,
  mono = true,
  monoAddress = "Runtime.Combat.Damageable.get_Health"
}



local function asmCode()

autoAssemble([[
define(Runtime_Combat_Damageable_get_Health,Runtime.Combat.Damageable.get_Health)
alloc(newmemRuntime_Combat_Damageable_get_Health,$100,Runtime_Combat_Damageable_get_Health)
alloc(PlayerPtr,8,Runtime_Combat_Damageable_get_Health)
alloc(Runtime_Combat_Damageable_get_Health_savedBytes,5,Runtime_Combat_Damageable_get_Health)
label(codeRuntime_Combat_Damageable_get_Health returnRuntime_Combat_Damageable_get_Health)
Runtime_Combat_Damageable_get_Health_savedBytes:
readmem(Runtime_Combat_Damageable_get_Health,5)
newmemRuntime_Combat_Damageable_get_Health:
mov [PlayerPtr],rbx
codeRuntime_Combat_Damageable_get_Health:
movss xmm0,[rcx+78]
jmp returnRuntime_Combat_Damageable_get_Health
Runtime_Combat_Damageable_get_Health:
jmp newmemRuntime_Combat_Damageable_get_Health
returnRuntime_Combat_Damageable_get_Health:
registersymbol(Runtime_Combat_Damageable_get_Health PlayerPtr Runtime_Combat_Damageable_get_Health_savedBytes)
]])

autoAssemble([[
aobscanmodule(GodPoint,GameAssembly.dll,F3 0F 11 7F 78 48 8D)
alloc(GodAlloc,$1000,GodPoint)
alloc(Godmode,8)
alloc(OHK,8)
label(code return checker)
OHK:
dd 0
Godmode:
dd 0
GodAlloc:
cmp [rdi+108],0
jne checker
cmp [Godmode],1
jne code
movss xmm7,[rdi+48]
movss [rdi+78],xmm7
jmp return
checker:
cmp [OHK],1
jne code
movss xmm7,[Zero]
code:
movss [rdi+78],xmm7
jmp return
Zero:
dd (float)0
GodPoint:
jmp GodAlloc
return:
registersymbol(GodPoint Godmode OHK)
]])

autoAssemble([[
aobscanmodule(TreeEditorPoint,GameAssembly.dll,48xxxxxxxxxxxx48xxxxE8xxxxxxxx48xxxxxxxxxxxx48xxxxxxxxxxxx83xxxxxxxxxxxx75xxE8xxxxxxxx45xxxx33xx48xxxxE8xxxxxxxx84xx0Fxxxxxxxxxx48xxxxxx33xx8Bxx)
alloc(newmemTreeEditorPoint,$100,TreeEditorPoint)
alloc(TreePtr,8,TreeEditorPoint)
alloc(TreeEditorPoint_savedBytes,7,TreeEditorPoint)
label(codeTreeEditorPoint returnTreeEditorPoint)
TreeEditorPoint_savedBytes:
readmem(TreeEditorPoint,7)
newmemTreeEditorPoint:
mov [TreePtr],rsi
codeTreeEditorPoint:
mov [rsi+00000120],rax
jmp returnTreeEditorPoint
TreeEditorPoint:
jmp newmemTreeEditorPoint
nop 2
returnTreeEditorPoint:
registersymbol(TreeEditorPoint TreePtr TreeEditorPoint_savedBytes)
]])

autoAssemble([[
aobscanmodule(MoneyPoint,GameAssembly.dll,8Bxxxx48xxxxxx5FC3E8xxxxxxxxCCE8xxxxxxxxCCCCCCCCCCCCCCCCCCCCCCCC48xxxxxxxx5748xxxxxx)
alloc(newmemMoneyPoint,$100,MoneyPoint)
alloc(MoneyPtr,8,MoneyPoint)
alloc(MoneyCorrect,8)
alloc(MoneyPoint_savedBytes,7,MoneyPoint)
label(codeMoneyPoint returnMoneyPoint)
MoneyPoint_savedBytes:
readmem(MoneyPoint,7)
newmemMoneyPoint:
mov [MoneyPtr],rdx
mov [MoneyCorrect],rax
codeMoneyPoint:
mov eax,[rdx+rax*8]
add rsp,20
jmp returnMoneyPoint
MoneyPoint:
jmp newmemMoneyPoint
nop 2
returnMoneyPoint:
registersymbol(MoneyPoint MoneyCorrect MoneyPtr MoneyPoint_savedBytes)
]])
autoAssemble([[
aobscanmodule(SlotAmmoPoint,GameAssembly.dll,8Bxxxx33xx48xxxxE8xxxxxxxx48xxxx0Fxxxxxxxxxx85xx)
alloc(newmemSlotAmmoPoint,$100,SlotAmmoPoint)
alloc(SlotPtr,8,SlotAmmoPoint)
alloc(SlotAmmoPoint_savedBytes,5,SlotAmmoPoint)
label(codeSlotAmmoPoint returnSlotAmmoPoint)
SlotAmmoPoint_savedBytes:
readmem(SlotAmmoPoint,5)
newmemSlotAmmoPoint:
mov [SlotPtr],rax
codeSlotAmmoPoint:
mov edi,[rax+18]
xor edx,edx
jmp returnSlotAmmoPoint
SlotAmmoPoint:
jmp newmemSlotAmmoPoint
returnSlotAmmoPoint:
registersymbol(SlotAmmoPoint SlotPtr SlotAmmoPoint_savedBytes)]])

autoAssemble([[
aobscanmodule(INJECT,UnityPlayer.dll,0F 10 49 20 41 0F 54 CB)
alloc(newmem,$1000,INJECT)
alloc(pCords,8)
label(code return)
newmem:
cmp [rcx+15C],0
je code
mov [pCords],rcx
code:
movups xmm1,[rcx+20]
andps xmm1,xmm11
jmp return
INJECT:
jmp newmem
nop 3
return:
registersymbol(INJECT)]])

end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end


_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()
----------------------------------------------------------
local GodFlag=getAddressSafe('Godmode')
if GodFlag and ald('Godmode').Active==true then
  if not _G.OldGodFlag then _G.OldGodFlag = readByte(GodFlag) end
  writeByte(GodFlag,1)
else
  if _G.OldGodFlag then writeByte(GodFlag,_G.OldGodFlag) _G.OldGodFlag=nil end
end
----------------------------------------------------------
local Damage=getAddressSafe('[[[[[[[PlayerPtr]+20]+28]+38]+38]+28]+D8]+104')
if Damage and ald('Hammer One Hit KIll').Active==true then
  if not _G.OldDamage then _G.OldDamage = readFloat(Damage) end
  writeFloat(Damage,1000)
else
  if _G.OldDamage then writeFloat(Damage,_G.OldDamage) _G.OldDamage=nil end
end
----------------------------------------------------------
local Knockback=getAddressSafe('[[[[[[[PlayerPtr]+20]+28]+38]+38]+28]+D8]+108')
if Knockback and ald('Hammer One Hit KIll').Active==true then
  if not _G.OldKnockback then _G.OldKnockback = readFloat(Knockback) end
  writeFloat(Knockback,1000)
else
  if _G.OldKnockback then writeFloat(Knockback,_G.OldKnockback) _G.OldKnockback=nil end
end

----------------------------------------------------------
local sprintMultiplier=getAddressSafe('[[[[[[[PlayerPtr]+20]+28]+38]+38]+28]+60]+48')
if sprintMultiplier and ald('The Flash\'s Sprint').Active==true then
  if not _G.OldsprintMultiplier then _G.OldsprintMultiplier = readFloat(sprintMultiplier) end
  writeFloat(sprintMultiplier,1.399999976*5)
else
  if _G.OldsprintMultiplier then writeFloat(sprintMultiplier,_G.OldsprintMultiplier) _G.OldsprintMultiplier=nil end
end

local OHKFlag=getAddressSafe('OHK')
if OHKFlag and ald('One hit kill').Active==true then
  if not _G.OldOHKFlag then _G.OldOHKFlag = readByte(OHKFlag) end
  writeByte(OHKFlag,1)
else
  if _G.OldOHKFlag then writeByte(OHKFlag,_G.OldOHKFlag) _G.OldOHKFlag=nil end
end
----------------------------------------------------------
local Currenthealth=getAddressSafe('[[PlayerPtr]+38]+78')
if Currenthealth and ald('Godmode 2').Active==true then
  if not _G.OldCurrenthealth then _G.OldCurrenthealth = readFloat(Currenthealth) end
  writeFloat(Currenthealth,10000)
else
  if _G.OldCurrenthealth then writeFloat(Currenthealth,_G.OldCurrenthealth) _G.OldCurrenthealth=nil end
end
----------------------------------------------------------
local SlotPtr=getAddressSafe('[SlotPtr]+18')
if SlotPtr and ald('Infinite ammo').Active==true then
  if not _G.OldSlotPtr then _G.OldSlotPtr = readInteger(SlotPtr) end
  writeInteger(SlotPtr,999)
else
  if _G.OldSlotPtr then writeInteger(SlotPtr,_G.OldSlotPtr) _G.OldSlotPtr=nil end
end
----------------------------------------------------------
end

