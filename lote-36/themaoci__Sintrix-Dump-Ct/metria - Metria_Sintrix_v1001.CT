<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>104</ID>
      <Description>"Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$Lua}
if syntaxcheck then return end

local process = 'Metria.exe'
OpenProcess(process);
if process ~= process or (readInteger(process) == nil) then
   error(ShowMessage("Failed To Attach To Process"))
end


--Set Window Title
local title = "Metria 1.0.0.1 by Sintrix";
if not((MainForm.Caption):match("metria")) then
MainForm.Caption = title..' ~ '..MainForm.Caption
end


[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1337094691</ID>
          <Description>"Ignore Damage"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>//Send@Sintrix|FearlessRevolution
//EnemyScript.AttackProcess
[ENABLE]
GameAssembly.dll+9CA0B0:
db C3
GameAssembly.dll+9CA440: //EnemyScript.BeginAttackProcess
db C3
[DISABLE]
GameAssembly.dll+9CA0B0: //EnemyScript.AttackProcess
db 48 8B C4
GameAssembly.dll+9CA440:
db 40 53
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1337094686</ID>
          <Description>"Max Attack Range"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>define(address,"GameAssembly.dll"+E1DF00)
define(bytes,F2 0F 10 44 88 20)

define(address2,"GameAssembly.dll"+E1DF06)
define(bytes2,8B 44 88 28 EB 32)

[ENABLE]

//Send@Sintrix (Credits to LittleLight for finding the instruction.)
//CharaAttack.GetCharaAttackParams

assert(address,bytes)
alloc(newmem,$1000,"GameAssembly.dll"+E1DF00)

label(code)
label(return)

newmem:
  mov [rax+rcx*4+20],(float)5000
code:

  movsd xmm0,[rax+rcx*4+20]
  jmp return

address:
  jmp newmem
  nop
return:

assert(address2,bytes2)
alloc(newmem2,$1000,"GameAssembly.dll"+E1DF06)

label(code2)
label(return2)

newmem2:
  mov [rax+rcx*4+20],(float)5000
code2:

  mov eax,[rax+rcx*4+28]
  jmp GameAssembly.dll+E1DF3E
  jmp return2

address2:
  jmp newmem2
  nop
return2:

[DISABLE]

address:
  db bytes
address2:
  db bytes2

dealloc(*)
</AssemblerScript>
        </CheatEntry>
