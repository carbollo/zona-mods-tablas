aobscanmodule(findpBase,$process,F3 * * * * * * * EB * F3 * * * * * * * EB * F3 * * * * * * * 41 * * E8)
alloc(newmemfindpBase,$100,findpBase)
alloc(pBase,8,findpBase)
alloc(infStamFlag,8,findpBase)
alloc(infHealthFlag,8,findpBase)
alloc(infMagikaFlag,8,findpBase)
label(codefindpBase returnfindpBase check1 check2)

infStamFlag:
dd 0

infHealthFlag:
dd 0

infMagikaFlag:
dd 0

newmemfindpBase:
mov [pBase],rcx
cmp [infStamFlag],1
jne check1
mov [rcx+6AC],(float)0

check1:
cmp [infHealthFlag],1
jne check2
mov [rcx+6A4],(float)0

check2:
cmp [infMagikaFlag],1
jne codefindpBase
mov [rcx+6A8],(float)0

codefindpBase:
movss xmm6,[rcx+000006AC]
jmp returnfindpBase

findpBase:
jmp newmemfindpBase
nop 3
returnfindpBase:
registersymbol(findpBase pBase infStamFlag infHealthFlag infMagikaFlag)

////////////////////////////////////////////////////////////////////////////////

aobscanmodule(getGold,$process,83 * * * 7E * 48 * * 03 * * 48 * * * 48 * * 75 * 48)
define(jleAddress,getGold+C)
alloc(newmemgetGold,$100,getGold)
alloc(gold_,8,getGold)
label(codegetGold returngetGold)
newmemgetGold:
mov [gold_],rax
codegetGold:
cmp dword ptr [rax+08],00
//jle 7FF65D4BD3A8 // OblivionRemastered-WinGDK-Shipping.exe.text+5FAC3A0
jle jleAddress
jmp returngetGold
getGold:
jmp newmemgetGold
nop 1
returngetGold:
registersymbol(getGold gold_)

////////////////////////////////////////////////////////////////////////////////

aobscanmodule(FindpCords,$process,0F * * * * * * 0F * * * 0F * * * * * * F2 * * * * EB * 0F * * * F2 * * * * 48 * * * 0F * * 0F * * * 48)
alloc(newmemFindpCords,$100,FindpCords)
alloc(pCords,8,FindpCords)
alloc(freezeOppsFlag,8,FindpCords)
label(codeFindpCords returnFindpCords freezeOps)

freezeOppsFlag:
dd 0

newmemFindpCords:
cmp [rcx+C8],#11
jne freezeOps
mov [pCords],rcx
movups xmm0,[rcx+00000260]
jmp returnFindpCords

freezeOps:
cmp [freezeOppsFlag],1
jne codeFindpCords
push rbx
mov rbx,[rcx+00000264]
mov [rcx+00000264],rbx
mov rbx,[rcx+0000026C]
mov [rcx+0000026C],rbx
mov rbx,[rcx+00000274]
mov [rcx+00000274],rbx
pop rbx


codeFindpCords:
movups xmm0,[rcx+00000260]
jmp returnFindpCords

FindpCords:
jmp newmemFindpCords
nop 2
returnFindpCords:
registersymbol(FindpCords pCords freezeOppsFlag)

////////////////////////////////////////////////////////////////////////////////

aobscanmodule(getHighlightedItem,$process,41 * * * 41 * * 85 * 0F * * * * * 8D * * E8 * * * * 48)
alloc(newmemgetHighlightedItem,$100,getHighlightedItem)
alloc(highlighted_Item,8,getHighlightedItem)
label(codegetHighlightedItem returngetHighlightedItem)

newmemgetHighlightedItem:
mov [highlighted_Item],r15

codegetHighlightedItem:
mov eax,[r15+08]
sub eax,r13d
jmp returngetHighlightedItem

getHighlightedItem:
jmp newmemgetHighlightedItem
nop 2
returngetHighlightedItem:
registersymbol(getHighlightedItem highlighted_Item)

