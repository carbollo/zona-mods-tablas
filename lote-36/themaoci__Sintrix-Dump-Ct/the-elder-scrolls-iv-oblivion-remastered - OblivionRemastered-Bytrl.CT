aobscanmodule(findVirtues,$process,8B * * * * * 84 * 74 * 8B * 41 * * EB * 42 * * * 3B * 74)
alloc(newmemfindVirtues,$100,findVirtues)
alloc(virtues,8,findVirtues)
label(codefindVirtues returnfindVirtues)

