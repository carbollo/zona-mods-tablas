        <CheatEntry>
          <ID>36</ID>
          <Description>"→ Scripts"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>367383</ID>
              <Description>"Teleport menu"</Description>
              <Color>80FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

tpm_s = getAddressList().getMemoryRecordByDescription('Teleport menu')

[ENABLE]

-- Main form setup
tpFRM = createForm(false)
tpFRM.Caption = "Teleport Menu"
tpFRM.Width = 300
tpFRM.Height = 45
tpFRM.Position = 'poScreenCenter'
tpFRM.Color = 0x000000 tpFRM.AlphaBlend = true tpFRM.AlphaBlendValue = 200
--tpFRM.FormStyle = 'fsSystemStayOnTop'
tpFRM.BorderStyle = 'bsDialog'

local filePath = getCheatEngineDir() .. "Oblivion_locations.txt"

local defaultLocations = [[

]]

local function createLocationsFile() if not fileExists(filePath) then local file = io.open(filePath, "w") if file then file:write(defaultLocations) file:close() end end end createLocationsFile()
local function readLocationsFromFile() local locations = {} if fileExists(filePath) then for line in io.lines(filePath) do local name, x, y, z = line:match("([^,]+),([^,]+),([^,]+),([^,]+)") if name and x and y and z then table.insert(locations, {name = name, x = tonumber(x), y = tonumber(y), z = tonumber(z)}) end end end return locations end
local function saveLocation(name, x, y, z) local file = io.open(filePath, "a") if file then file:write(string.format("%s,%.3f,%.3f,%.3f\n", name, x, y, z)) file:close() else print("Failed to open file: " .. filePath) end end

--Init vals
local coordx = 0 local coordy = 0 local coordz = 0

--Location Dropdown
local locations = readLocationsFromFile()
local TeleportSelectiondropdown = createComboBox(tpFRM)
TeleportSelectiondropdown.Left = 1
TeleportSelectiondropdown.Top = 20
TeleportSelectiondropdown.Width = 150
TeleportSelectiondropdown.Height = 25
for _, loc in ipairs(locations) do TeleportSelectiondropdown.Items.add(loc.name) end

local TeleportSelectionEditor = createCheckBox(tpFRM)
TeleportSelectionEditor.Caption = 'Edit Dropdown Menu'
TeleportSelectionEditor.Left = 5
TeleportSelectionEditor.Top = TeleportSelectiondropdown.Top - 20
TeleportSelectionEditor.Width = 150
TeleportSelectionEditor.Height = 20
TeleportSelectionEditor.onClick=function()
  shellExecute(filePath)
  TeleportSelectionEditor.Checked=false
end


-- Teleport button
local TeleportButton = createButton(tpFRM)
TeleportButton.Caption = "Teleport"
TeleportButton.Left = TeleportSelectiondropdown.Left + TeleportSelectiondropdown.Width
TeleportButton.Top = TeleportSelectiondropdown.Top - 1
TeleportButton.Width = 75
TeleportButton.Height = 25
TeleportButton.OnClick = function()
    local selectedIndex = TeleportSelectiondropdown.ItemIndex
    if selectedIndex &gt;= 0 then
        locations = readLocationsFromFile()
        local loc = locations[selectedIndex + 1]
        if loc then
            writeFloat('[pCords]+264', loc.x)
            writeFloat('[pCords]+26C', loc.y)
            writeFloat('[pCords]+274', loc.z)
        end
    end
end

-- Save location button
local TeleportSaveButton = createButton(tpFRM)
TeleportSaveButton.Caption = "Save"
TeleportSaveButton.Left = TeleportButton.Left + TeleportButton.Width - 1
TeleportSaveButton.Top = TeleportButton.Top
TeleportSaveButton.Width = TeleportButton.Width
TeleportSaveButton.Height = 25
TeleportSaveButton.OnClick = function()
    local name = inputQuery("Save Location", "Enter location name:", "")
    if name then
        coordx = readFloat('[pCords]+264') or 0
        coordy = readFloat('[pCords]+26C') or 0
        coordz = readFloat('[pCords]+274') or 0
        saveLocation(name, coordx, coordy, coordz)
        TeleportSelectiondropdown.Items.add(name)
    end
end

tpFRM.OnClose = function()
    tpFRM.hide()
    tpm_s.Active = false
    return caFree
end

tpFRM.show()

[DISABLE]

tpFRM.hide()
tpm_s=nil

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
