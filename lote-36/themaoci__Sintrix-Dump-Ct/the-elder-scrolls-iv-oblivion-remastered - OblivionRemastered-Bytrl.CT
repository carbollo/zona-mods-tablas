              <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

shiftClickTmr=createTimer() shiftClickTmr.Interval=100 shiftClickTmr.onTimer=function()
local highlightedItem=getAddressSafe('[highlighted_Item]+08')
  if highlightedItem and isKeyPressed(VK_RBUTTON) then
    writeInteger(highlightedItem,readInteger(highlightedItem) + 1)
  end
end

[DISABLE]
if shiftClickTmr then shiftClickTmr.destroy() shiftClickTmr=nil end
