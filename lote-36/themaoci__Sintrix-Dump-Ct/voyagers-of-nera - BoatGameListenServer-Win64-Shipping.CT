          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1337144031</ID>
              <Description>"Teleport menu"</Description>
              <Color>408080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

tpm_s = getAddressList().getMemoryRecordByDescription('Teleport menu')

local filePath = getCheatEngineDir() .. "VON_locations.txt" --adjust this each title
local xCord=getAddressSafe('[pCords]+1F4')
local yCord=getAddressSafe('[pCords]+1FC')
local zCord=getAddressSafe('[pCords]+204')

[ENABLE]

-- Main form setup
tpFRM = createForm(false)
tpFRM.Caption = "Teleport Menu"
tpFRM.Width = 300
tpFRM.Height = 45
tpFRM.Position = 'poScreenCenter'
tpFRM.Color = 0x000000 tpFRM.AlphaBlend = true tpFRM.AlphaBlendValue = 200
tpFRM.BorderStyle = 'bsDialog'

local defaultLocations = [[
--add default locations here
]]

local function createLocationsFile() if not fileExists(filePath) then local file = io.open(filePath, "w") if file then file:write(defaultLocations) file:close() end end end createLocationsFile()
local function readLocationsFromFile() local locations = {} if fileExists(filePath) then for line in io.lines(filePath) do local name, x, y, z = line:match("([^,]+),([^,]+),([^,]+),([^,]+)") if name and x and y and z then table.insert(locations, {name = name, x = tonumber(x), y = tonumber(y), z = tonumber(z)}) end end end return locations end
local function saveLocation(name, x, y, z) local file = io.open(filePath, "a") if file then file:write(string.format("%s,%.3f,%.3f,%.3f\n", name, x, y, z)) file:close() else print("Failed to open file: " .. filePath) end end

local coordx = 0 local coordy = 0 local coordz = 0

local locations = readLocationsFromFile()
local TeleportSelectiondropdown = createComboBox(tpFRM)
TeleportSelectiondropdown.Left = 1
TeleportSelectiondropdown.Top = 20
TeleportSelectiondropdown.Width = 150
TeleportSelectiondropdown.Height = 25
for _, loc in ipairs(locations) do TeleportSelectiondropdown.Items.add(loc.name) end

local TeleportSelectionEditor = createCheckBox(tpFRM)
TeleportSelectionEditor.Caption = 'Edit Dropdown Menu'
TeleportSelectionEditor.Left = 5
TeleportSelectionEditor.Top = TeleportSelectiondropdown.Top - 20
TeleportSelectionEditor.Width = 150
TeleportSelectionEditor.Height = 20
TeleportSelectionEditor.onClick=function()
  shellExecute(filePath)
  TeleportSelectionEditor.Checked=false
end

local TeleportButton = createButton(tpFRM)
TeleportButton.Caption = "Teleport"
TeleportButton.Left = TeleportSelectiondropdown.Left + TeleportSelectiondropdown.Width
TeleportButton.Top = TeleportSelectiondropdown.Top - 1
TeleportButton.Width = 75
TeleportButton.Height = 25
TeleportButton.OnClick = function()
    local selectedIndex = TeleportSelectiondropdown.ItemIndex
    if selectedIndex &gt;= 0 then
        locations = readLocationsFromFile()
        local loc = locations[selectedIndex + 1]
        if loc then
            writeFloat(xCord, loc.x)
            writeFloat(yCord, loc.y)
            writeFloat(zCord, loc.z)
        end
    end
end

-- Save location button
local TeleportSaveButton = createButton(tpFRM)
TeleportSaveButton.Caption = "Save"
TeleportSaveButton.Left = TeleportButton.Left + TeleportButton.Width - 1
TeleportSaveButton.Top = TeleportButton.Top
TeleportSaveButton.Width = TeleportButton.Width
TeleportSaveButton.Height = 25
TeleportSaveButton.OnClick = function()
    local name = inputQuery("Save Location", "Enter location name:", "")
    if name then
        coordx = readFloat(xCord) or 0
        coordy = readFloat(yCord) or 0
        coordz = readFloat(zCord) or 0
        saveLocation(name, coordx, coordy, coordz)
        TeleportSelectiondropdown.Items.add(name)
    end
end

tpFRM.OnClose = function()
    tpFRM.hide()
    tpm_s.Active = false
    return caFree
end

tpFRM.show()

[DISABLE]

tpFRM.hide() tpm_s=nil

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142745</ID>
              <Description>"Flight + Controller"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

if _G.Bytrl_FlightSpeedxy == nil then _G.Bytrl_FlightSpeedxy = 4000 end
if _G.Bytrl_FlightSpeedz == nil then _G.Bytrl_FlightSpeedz = 4000 end
if _G.Bytrl_NoClipEnabled == nil then _G.Bytrl_NoClipEnabled = false end

local VelocityY=getAddressSafe('[CharacterMovementComponent]+C0')
local VelocityZ=getAddressSafe('[CharacterMovementComponent]+C8')
local VelocityX=getAddressSafe('[CharacterMovementComponent]+B8')
local ControlRotationYaw=getAddressSafe('[[[CharacterMovementComponent]+168]+958]+B0')
local MovementMode=getAddressSafe('[CharacterMovementComponent]+201')
local BodyInstanceCollisionEnabled=getAddressSafe('[pCords]+368')
local AirControlBoostMultiplier=getAddressSafe('[CharacterMovementComponent]+284')
local MaxAcceleration=getAddressSafe('[CharacterMovementComponent]+25C')
local AirControl=getAddressSafe('[CharacterMovementComponent]+280')
local MaxFlySpeed=getAddressSafe('[CharacterMovementComponent]+254')

[ENABLE]

if flightTmr then flightTmr.destroy() flightTmr=nil end

local function toRadIfDeg(a)
  if a == nil then return 0 end
  if math.abs(a) &gt; (2*math.pi + 0.5) then
    return math.rad(a)
  end
  return a
end

local function clamp(v, mn, mx)
  if v &lt; mn then return mn end
  if v &gt; mx then return mx end
  return v
end

flightTmr=createTimer() flightTmr.Interval=10 flightTmr.onTimer=function()

  if MovementMode then writeByte(MovementMode, 5) end --3=falling | 5=flying
  if AirControlBoostMultiplier then writeFloat(AirControlBoostMultiplier, 3) end
  if MaxAcceleration then writeFloat(MaxAcceleration, 10000) end
  if AirControl then writeFloat(AirControl, 5) end
  if MaxFlySpeed then writeFloat(MaxFlySpeed, 3000) end

  if BodyInstanceCollisionEnabled then
    if _G.Bytrl_NoClipEnabled then
      writeByte(BodyInstanceCollisionEnabled, 0)
    else
      writeByte(BodyInstanceCollisionEnabled, 3)
    end
  end

  if not (VelocityX and VelocityY and VelocityZ and ControlRotationYaw) then return end

  local yaw = toRadIfDeg(readDouble(ControlRotationYaw) or 0)

  local speed = _G.Bytrl_FlightSpeedxy
  local vertSpeed = _G.Bytrl_FlightSpeedz

  local forward  = isKeyPressed(0x57) and 1 or 0 -- W
  local backward = isKeyPressed(0x53) and 1 or 0 -- S
  local left     = isKeyPressed(0x41) and 1 or 0 -- A
  local right    = isKeyPressed(0x44) and 1 or 0 -- D
  local upKey    = isKeyPressed(VK_SPACE) and 1 or 0
  local downKey  = isKeyPressed(VK_SHIFT) and 1 or 0

  local pad = getXBox360ControllerState(0)
  if pad then
    local deadzone = 8000
    local lx = (math.abs(pad.ThumbLeftX) &gt; deadzone) and (pad.ThumbLeftX / 32767.0) or 0
    local ly = (math.abs(pad.ThumbLeftY) &gt; deadzone) and (pad.ThumbLeftY / 32767.0) or 0

    if ly &gt; 0 then forward  = clamp(ly, 0, 1) end
    if ly &lt; 0 then backward = clamp(-ly, 0, 1) end
    if lx &gt; 0 then right    = clamp(lx, 0, 1) end
    if lx &lt; 0 then left     = clamp(-lx, 0, 1) end

    upKey   = pad.GAMEPAD_LEFT_SHOULDER and 1 or upKey
    downKey = pad.GAMEPAD_RIGHT_SHOULDER and 1 or downKey
  end

  local fb = forward - backward
  local lr = right - left
  local ud = upKey - downKey
  local fwdX, fwdY = math.cos(yaw), math.sin(yaw)
  local rgtX, rgtY = -math.sin(yaw), math.cos(yaw)

  local moveX = (fwdX * fb + rgtX * lr) * speed
  local moveY = (fwdY * fb + rgtY * lr) * speed
  local moveZ = ud * vertSpeed

  writeDouble(VelocityX, moveX)
  writeDouble(VelocityY, moveY)
  writeDouble(VelocityZ, moveZ)
end

[DISABLE]
if flightTmr then flightTmr.destroy() flightTmr=nil end

if MovementMode then writeByte(MovementMode,1) end
if BodyInstanceCollisionEnabled then writeByte(BodyInstanceCollisionEnabled,3) end
if AirControlBoostMultiplier then writeFloat(AirControlBoostMultiplier, 2) end
if MaxAcceleration then writeFloat(MaxAcceleration, 1200) end
if AirControl then writeFloat(AirControl, 1) end
if MaxFlySpeed then writeFloat(MaxFlySpeed, 600) end

if _G.Bytrl_FlightSpeedxy then _G.Bytrl_FlightSpeedxy = nil end
if _G.Bytrl_FlightSpeedz then _G.Bytrl_FlightSpeedz = nil end
if _G.Bytrl_NoClipEnabled ~= nil then _G.Bytrl_NoClipEnabled = nil end
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337142746</ID>
                  <Description>"Flight Controller"</Description>
                  <Color>408080</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

_G.Bytrl_FlightSpeedxy=_G.Bytrl_FlightSpeedxy or 4000
_G.Bytrl_FlightSpeedz=_G.Bytrl_FlightSpeedz or 4000
_G.Bytrl_NoClipEnabled=_G.Bytrl_NoClipEnabled or false

local fsform = createForm(false)
fsform.Caption = "Bytrl Flight Speed Controller"
fsform.Width = 320
fsform.Height = 110
fsform.Position = "poScreenCenter"

-- Shared flight speed
local lblSpeed = createLabel(fsform)
lblSpeed.Caption = "Flight speed: " .. _G.Bytrl_FlightSpeedxy
lblSpeed.Left = 10
lblSpeed.Top = 10

local sSpeed = createTrackBar(fsform)
sSpeed.Min = 500
sSpeed.Max = 10000
sSpeed.Position = _G.Bytrl_FlightSpeedxy
sSpeed.Left = 10
sSpeed.Top = lblSpeed.Top + 15
sSpeed.Width = 310
sSpeed.OnChange = function()
  _G.Bytrl_FlightSpeedxy = sSpeed.Position
  _G.Bytrl_FlightSpeedz = sSpeed.Position
  lblSpeed.Caption = "Flight speed (xy + z): " .. sSpeed.Position
end

-- No clip checkbox
local cbNoClip = createCheckBox(fsform)
cbNoClip.Caption = "Enable No Clip"
cbNoClip.Left = 10
cbNoClip.Top = sSpeed.Top + 35
cbNoClip.Checked = _G.Bytrl_NoClipEnabled
cbNoClip.OnClick = function()
  _G.Bytrl_NoClipEnabled = cbNoClip.Checked
end

fsform.OnClose = function()
  fsform.destroy()
  resetClick(memrec)
end

fsform.show()

[DISABLE]

if fsform then
  fsform.close()
  fsform = nil
end
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142855</ID>
              <Description>"Edit Jump Height"</Description>
              <Options moAlwaysHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local myRec = getAddressList().getMemoryRecordByDescription("Edit Jump Height")
local JumpZVelocity=getAddressSafe('[CharacterMovementComponent]+178')
[ENABLE]

if JumpZVelocity then
  createSliderForm{
    title   = "Edit Jump Height (normal is 980)",
    address = JumpZVelocity,
    min     = 100,
    center  = 980,
    max     = 3000,
    decimals = 1,
    memrec  = myRec
  }
end

[DISABLE]

if myRec and myRec._sliderForm then
  myRec._sliderForm.close()
  myRec._sliderForm = nil
end






</AssemblerScript>
