  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Voyagers of Nera"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>80FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local function eTFTD(filename, outPath) local tf = findTableFile(filename) if not tf then error("Table file not found: " .. filename) end local src = tf.Stream src.Position = 0 local dst = createFileStream(outPath, fmCreate) if not dst then error("Failed to create output file: " .. outPath) end dst.copyFrom(src, src.Size) dst.destroy() return outPath end if not _G.BytrlDllLoaded then local dll = "_Bytrl.dll" local outPath = getCheatEngineDir() .. "autorun\\dlls\\" .. dll eTFTD(dll, outPath) loadPlugin(outPath) _G.BytrlDllLoaded = true end

[ENABLE]

startTable{
  process = "BoatGameListenServer-Win64-Shipping.exe",
  title = "Voyagers of Nera 1.0.1",
  discord = "Voyagers of Nera 1.0.1",
  AddressListPic = "https://imgur.com/4pl47YF.png",
  compact = true
}

local function asmCode()

autoAssemble([[
aobscanmodule(findplayercords,BoatGameListenServer-Win64-Shipping.exe,0FxxxxxxxxxxxxF2xxxxxxxxxxxxxxEBxx0FxxxxxxxxxxxxF2xxxxxxxxxxxxxxF6xxxxxx0Fxxxxxxxx)
alloc(newmemfindplayercords,$100,findplayercords)
alloc(pCords,8,findplayercords)
alloc(findplayercords_savedBytes,7,findplayercords)
label(codefindplayercords returnfindplayercords)

findplayercords_savedBytes:
readmem(findplayercords,7)

newmemfindplayercords:
mov [pCords],rax

codefindplayercords:
movups xmm1,[rax+000001F0]
jmp returnfindplayercords

findplayercords:
jmp newmemfindplayercords
nop 2
returnfindplayercords:
registersymbol(findplayercords pCords findplayercords_savedBytes)]])

autoAssemble([[
aobscanmodule(findMovComponent,BoatGameListenServer-Win64-Shipping.exe,48xxxxFFxxxxxxxxxx88xx48xxxxxx5BC3CC48xxxxxx45xxxx48xxxx41xxxxxx4Cxxxx4CxxxxxxF2xxxxxxxxxxxxxx)
alloc(newmemfindMovComponent,$100,findMovComponent)
alloc(CharacterMovementComponent,8,findMovComponent)
alloc(findMovComponent_savedBytes,9,findMovComponent)
label(codefindMovComponent returnfindMovComponent)

findMovComponent_savedBytes:
readmem(findMovComponent,9)

newmemfindMovComponent:
mov [CharacterMovementComponent],rcx

codefindMovComponent:
mov rax,[rcx]
call qword ptr [rax+00000600]
jmp returnfindMovComponent

findMovComponent:
jmp newmemfindMovComponent
nop 4
returnfindMovComponent:
registersymbol(findMovComponent CharacterMovementComponent findMovComponent_savedBytes)]])

autoAssemble([[
aobscanmodule(findHeldItem,BoatGameListenServer-Win64-Shipping.exe,83xxxx7Exx48xxxxxxxx48xxxxxx5FC3)
alloc(newmemfindHeldItem,$100,findHeldItem)
alloc(held_item,8,findHeldItem)
alloc(findHeldItem_savedBytes,5,findHeldItem)
label(codefindHeldItem returnfindHeldItem)

findHeldItem_savedBytes:
readmem(findHeldItem,5)

newmemfindHeldItem:
cmp [rax+84],0
je codefindHeldItem
mov [held_item],rax

codefindHeldItem:
cmp dword ptr [rax],00
jle BoatGameListenServer-Win64-Shipping.exe+5651FE4
jmp returnfindHeldItem

findHeldItem:
jmp newmemfindHeldItem
returnfindHeldItem:
registersymbol(findHeldItem held_item findHeldItem_savedBytes)]])


end

if TABLE_CONFIG and TABLE_CONFIG.mono == true and TABLE_CONFIG.monoAddress and TABLE_CONFIG.monoAddress ~= "" then iav(TABLE_CONFIG.monoAddress,asmCode) else asmCode() end

_tmr=createTimer() _tmr.Interval=100 _tmr.onTimer=function()

  local WateringRateCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+90]+4C')
  if WateringRateCurrentValue and ald('Increase Watering Rate').Active==true then
    if not _G.OldWateringRateCurrentValue then _G.OldWateringRateCurrentValue = readFloat(WateringRateCurrentValue) end
    writeFloat(WateringRateCurrentValue,999)
  else
    if _G.OldWateringRateCurrentValue then writeFloat(WateringRateCurrentValue,_G.OldWateringRateCurrentValue) _G.OldWateringRateCurrentValue=nil end
  end

  local WateringRadiusCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+90]+3C')
  if WateringRadiusCurrentValue and ald('Increase Watering Radius').Active==true then
    if not _G.OldWateringRadiusCurrentValue then _G.OldWateringRadiusCurrentValue = readFloat(WateringRadiusCurrentValue) end
    writeFloat(WateringRadiusCurrentValue,999)
  else
    if _G.OldWateringRadiusCurrentValue then writeFloat(WateringRadiusCurrentValue,_G.OldWateringRadiusCurrentValue) _G.OldWateringRadiusCurrentValue=nil end
  end

  local WaterAffinityCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+78]+5C')
  if WaterAffinityCurrentValue and ald('Increase Water Affinity').Active==true then
    if not _G.OldWaterAffinityCurrentValue then _G.OldWaterAffinityCurrentValue = readFloat(WaterAffinityCurrentValue) end
    writeFloat(WaterAffinityCurrentValue,999)
  else
    if _G.OldWaterAffinityCurrentValue then writeFloat(WaterAffinityCurrentValue,_G.OldWaterAffinityCurrentValue) _G.OldWaterAffinityCurrentValue=nil end
  end

  local WaterAffinityHealAmountCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+78]+6C')
  if WaterAffinityHealAmountCurrentValue and ald('Increase Water Affinity Heal Amount').Active==true then
    if not _G.OldWaterAffinityHealAmountCurrentValue then _G.OldWaterAffinityHealAmountCurrentValue = readFloat(WaterAffinityHealAmountCurrentValue) end
    writeFloat(WaterAffinityHealAmountCurrentValue,999)
  else
    if _G.OldWaterAffinityHealAmountCurrentValue then writeFloat(WaterAffinityHealAmountCurrentValue,_G.OldWaterAffinityHealAmountCurrentValue) _G.OldWaterAffinityHealAmountCurrentValue=nil end
  end

  local WaterAffinityHealRateCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+78]+7C')
  if WaterAffinityHealRateCurrentValue and ald('Increase Water Affinity Heal Rate').Active==true then
    if not _G.OldWaterAffinityHealRateCurrentValue then _G.OldWaterAffinityHealRateCurrentValue = readFloat(WaterAffinityHealRateCurrentValue) end
    writeFloat(WaterAffinityHealRateCurrentValue,999)
  else
    if _G.OldWaterAffinityHealRateCurrentValue then writeFloat(WaterAffinityHealRateCurrentValue,_G.OldWaterAffinityHealRateCurrentValue) _G.OldWaterAffinityHealRateCurrentValue=nil end
  end

  local WindAffinityCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+78]+8C')
  if WindAffinityCurrentValue and ald('Increase Wind Affinity').Active==true then
    if not _G.OldWindAffinityCurrentValue then _G.OldWindAffinityCurrentValue = readFloat(WindAffinityCurrentValue) end
    writeFloat(WindAffinityCurrentValue,999)
  else
    if _G.OldWindAffinityCurrentValue then writeFloat(WindAffinityCurrentValue,_G.OldWindAffinityCurrentValue) _G.OldWindAffinityCurrentValue=nil end
  end

  local FireAffinityHitChanceCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+78]+9C')
  if FireAffinityHitChanceCurrentValue and ald('Increase Fire Affinity Hit Chance').Active==true then
    if not _G.OldFireAffinityHitChanceCurrentValue then _G.OldFireAffinityHitChanceCurrentValue = readFloat(FireAffinityHitChanceCurrentValue) end
    writeFloat(FireAffinityHitChanceCurrentValue,100)
  else
    if _G.OldFireAffinityHitChanceCurrentValue then writeFloat(FireAffinityHitChanceCurrentValue,_G.OldFireAffinityHitChanceCurrentValue) _G.OldFireAffinityHitChanceCurrentValue=nil end
  end

  local FireAffinityDamageMultiplierCurrentValue=getAddressSafe('[[[[[CharacterMovementComponent]+150]+758]+1090]+78]+AC')
  if FireAffinityDamageMultiplierCurrentValue and ald('Increase Fire Affinity Damage Multiplier').Active==true then
    if not _G.OldFireAffinityDamageMultiplierCurrentValue then _G.OldFireAffinityDamageMultiplierCurrentValue = readFloat(FireAffinityDamageMultiplierCurrentValue) end
    writeFloat(FireAffinityDamageMultiplierCurrentValue,999)
