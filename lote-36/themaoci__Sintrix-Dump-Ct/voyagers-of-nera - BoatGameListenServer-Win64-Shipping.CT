              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local myRec = getAddressList().getMemoryRecordByDescription("Edit Gravity Scale")
local GravityScale=getAddressSafe('[CharacterMovementComponent]+170')

[ENABLE]

if GravityScale then
  createSliderForm{
    title   = "Edit Gravity Scale (normal is 2.8)",
    address = GravityScale,
    min     = 0,
    center  = 1,
    max     = 2.8,
    decimals = 1,
    memrec  = myRec
  }
end

[DISABLE]

if myRec and myRec._sliderForm then
  myRec._sliderForm.close()
  myRec._sliderForm = nil
end






</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142856</ID>
              <Description>"Edit Time Dilation"</Description>
              <Options moAlwaysHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local myRec = getAddressList().getMemoryRecordByDescription("Edit Time Dilation")
local CustomTimeDilation=getAddressSafe('[[CharacterMovementComponent]+168]+68')

[ENABLE]

if CustomTimeDilation then
  createSliderForm{
    title   = "Edit Time Dilation (1 is normal)",
    address = CustomTimeDilation,
    min     = .3,
    center  = 1,
    max     = 5,
    decimals = 1,
    memrec  = myRec
  }
end

[DISABLE]

if myRec and myRec._sliderForm then
  myRec._sliderForm.close()
  myRec._sliderForm = nil
end






</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337142599</ID>
              <Description>"Player scale modifier"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end

local RelativeScaleDX = getAddressSafe('[pCords]+158')
local RelativeScaleDY = getAddressSafe('[pCords]+160')
local RelativeScaleDZ = getAddressSafe('[pCords]+168')

[ENABLE]
local form = createForm(false)
form.Caption = "Player Scale Controller"
form.Width = 340
form.Height = 130
form.Position = "poScreenCenter"
form.BorderStyle = bsSingle

local lbl = createLabel(form)
lbl.Caption = "Player Scale: 1.00"
lbl.Left = 15
lbl.Top = 12
lbl.Font.Size = 10

local tb = createTrackBar(form)
tb.Min = 0
tb.Max = 475
tb.Position = 75
tb.Left = 15
tb.Top = lbl.Top + 25
tb.Width = 310

local function getScale()
    return 0.25 + (tb.Position * 0.01)
end

local function updateScale()
    local scale = getScale()
    writeDouble(RelativeScaleDX, scale)
    writeDouble(RelativeScaleDY, scale)
    writeDouble(RelativeScaleDZ, scale)

    lbl.Caption = string.format("Player Scale: %.2f", scale)
end

tb.OnChange = updateScale

local btn = createButton(form)
btn.Caption = "Restore Original Scale (1.00)"
btn.Width = 200
btn.Left = form.Width/2 - btn.Width/2
btn.Top = tb.Top + 45
btn.OnClick = function()
    tb.Position = 75
    updateScale()
end

updateScale()

form.OnClose = function(sender, closeAction)
    form.destroy()
    resetClick(memrec)
    return caFree
end

form.show()

[DISABLE]

if form then
    form.close()
    form = nil
end
</AssemblerScript>
            </CheatEntry>
