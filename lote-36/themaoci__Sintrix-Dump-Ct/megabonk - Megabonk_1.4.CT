  </Files>
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"MegaBonk.exe"</Description>
      <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local function ald(description) local al=getAddressList() local rec=al.getMemoryRecordByDescription(description) if rec then return rec end rec=al.createMemoryRecord() rec.Description=description rec.IsGroupHeader=true rec.Options="" rec.Type=vtCustom rec.DontSave=false rec.Active=false return rec end
local function tmr(name, interval, onTimerFunc) if _G[name] then _G[name].destroy() end _G[name]=createTimer() _G[name].Interval=interval _G[name].OnTimer=onTimerFunc function xtmr(name) if _G[name] then _G[name].destroy() _G[name]=nil end end end
local s=findTableFile('SintrixLua.lua').Stream load(readStringLocal(s.Memory,s.Size))() setAddressListPicture('Bytrl.png', 210, 0x0000FF) startTable('MegaBonk.exe','MegaBonk.exe Table v1.3', 'MegaBonk.exe v1.3', 'Bytrl - Yem')

autoAssemble([[
aobscanmodule(getcoins,GameAssembly.dll,F3 0F 11 77 68 76 07)
alloc(newmem8,$100,getcoins)
alloc(coins_base,8,getcoins)
label(code8 return8)
newmem8:
mov [coins_base],rdi
code8:
  movss [rdi+68],xmm6
  jmp return8
getcoins:
  jmp newmem8
return8:
registersymbol(getcoins coins_base)

aobscanmodule(getsilver,GameAssembly.dll,01 7B 14 EB 07)
define(jumptoaddress,getsilver+c)
alloc(newmem67,$100,getsilver)
alloc(silver,8,getsilver)
label(code67 return67)
newmem67:
mov [silver],rbx
code67:
  add [rbx+14],edi
  jmp jumptoaddress
  jmp return67
getsilver:
  jmp newmem67
return67:
registersymbol(getsilver jumptoaddress silver)

aobscanmodule(questsss,GameAssembly.dll,F3 * * * * 48 * * * 5B C3 0F * * 48 * * * 5B C3 E8)
alloc(newmemquestsss,$100,questsss)
alloc(quest_flag,8,questsss)
label(codequestsss returnquestsss)
quest_flag:
dd 0
newmemquestsss:
cmp [quest_flag],1
jne codequestsss
mov [rax+18],(float)999999
codequestsss:
movss xmm0,[rax+18]
jmp returnquestsss
questsss:
jmp newmemquestsss
returnquestsss:
registersymbol(questsss quest_flag)

aobscanmodule(findlevel,GameAssembly.dll,01 * * 48 * * * * * * 83 * * * * * * 75 * 48 * * E8 * * * * 48 * * * * * * 48 * * * * * * 4C * * * 4D * * 74 * 4D * * * 44 * * 49 * * * 48 * * 41 * * * 48 * * * * * * 8B * * 83)
alloc(newmemfindlevel,$100,findlevel)
alloc(level,8,findlevel)
label(codefindlevel returnfindlevel)
newmemfindlevel:
mov [level],rbx
codefindlevel:
add [rbx+10],edi
mov rax,[GameAssembly.dll+303F838]
jmp returnfindlevel
findlevel:
jmp newmemfindlevel
nop 5
returnfindlevel:
registersymbol(findlevel level)

aobscanmodule(player_noclip,GameAssembly.dll,38 * * * * * 0F * * * * * E8 * * * * 33 * 48 * * E8)
alloc(newmemplayer_noclip,$100,player_noclip)
alloc(noclip,8,player_noclip)
label(codeplayer_noclip returnplayer_noclip)

newmemplayer_noclip:
mov [noclip],rbx
//mov [rbx+00000208],1

codeplayer_noclip:
cmp [rbx+00000208],dl
jmp returnplayer_noclip

player_noclip:
jmp newmemplayer_noclip
nop 1
returnplayer_noclip:
registersymbol(player_noclip noclip)

{
aobscanmodule(maxweaponstatsonlvl,GameAssembly.dll,F3 * * * * * B0 * 48 * * * * * * * 0F * * * * 48 * * * 41 * 41 * 41 * 41 * 5F 5E 5B C3 4C * * * * * * * 32 * 41 * * * * 7F * 41 * * * 3B * * 75 * 49 * * * 49 * * 48 * * * * * * 48 * * * * * * E8 * * * * B1 * 49 * * * 8D * * 41 * * * 32 * 84 * 74 * 49 * * * 48 * * 74 * 41 * * 99 F7 * * 3B * * 73 * 4C * * 49 * * * 32 * 4E * * * EB * 41 * * * B2 * 41 * * * 4C * * * * 48 * * 74 * 3B * * 73 * 48 * * 48 * * * 48 * * * 48 * * 84 * 74 * 8B * * 41 * * * 44 * * 41 * * FF * 89 * * 8B * * * 89 * * 8D * * F3 * * * * 41 * * E9 * * * * E8 * * * * CC E8 * * * * CC CC 48 * * * * 48)
alloc(newmemmaxweaponstatsonlvl,$100,maxweaponstatsonlvl)
alloc(nvfw,8,maxweaponstatsonlvl)
alloc(mwsf,8,maxweaponstatsonlvl)
label(codemaxweaponstatsonlvl returnmaxweaponstatsonlvl)
nvfw:
dd (float)999
mwsf:
dd 0
newmemmaxweaponstatsonlvl:
cmp [mwsf],1
jne codemaxweaponstatsonlvl
movss xmm6,[nvfw]
codemaxweaponstatsonlvl:
movss [rbx+rax*8+2C],xmm6
jmp returnmaxweaponstatsonlvl
maxweaponstatsonlvl:
jmp newmemmaxweaponstatsonlvl
nop 1
returnmaxweaponstatsonlvl:
registersymbol(maxweaponstatsonlvl nvfw mwsf)
}

]])


local tmrfunction=function()

local base=getAddressSafe("[[[[[[GameAssembly.dll+02FEAE58]+B8]+00]+40]+18]+78]+00") -- old [[[[[[GameAssembly.dll+030383E0]+B8]+00]+20]+10]+18]+00
  if base then
    local maxHp=base+0x2c
    local hpRegen=base+0x3c
    local shield=base+0x4c
    local thorns=base+0x5c
    local armor=base+0x6c
    local evasion=base+0x7c
    local projectileSize=base+0xbC
    local projectileSpeed=base+0xdc
    local damage=base+0xEC
    local attackSpeed=base+0x11c
    local projectileCount=base+0x12C
    local lifeSteal=base+0x13C
    local critChance=base+0x14c
    local critDamage=base+0x15c
    local knockback=base+0x1aC
    local jumpHeight=base+0x1CC
    local moveSpeed=base+0x1BC
    local pickupRange=base+0x1FC
    local damageToElites=base+0x19c
    local goldGain=base+0x21c
    local xpGain=base+0x22c
    local luck=base+0x20c
    local eliteSpawnChance=base+0x29c
    local powerMultiplier=base+0x2ac
    local powerUpDropChance=base+0x2bc
    local extraJumps=base+0x30c
    local silverGain=base+0x33c
    local gold=getAddressSafe('[coins_base]+68')
    local silver=getAddressSafe('[silver]+14')
    local xp=getAddressSafe('[level]+10')
    local level=getAddressSafe('[level]+14')
    local kills=getAddressSafe('[[[[GameAssembly.dll+0301DEA8]+318]+C0]+18]+48')
    local noclip=getAddressSafe('[noclip]+208')

      if ald('Increase knockback').Active==true then writeFloat(knockback,999) end
      if ald('Increase power multiplier').Active==true then writeFloat(powerMultiplier,999) end
      if ald('Increase power up drop chance').Active==true then writeFloat(powerUpDropChance,999) end
      if ald('Increase elite spawn chance').Active==true then writeFloat(eliteSpawnChance,999) end
      if ald('Increase damage to elites').Active==true then writeFloat(damageToElites,999) end
      if ald('Increase xp gain').Active==true then writeFloat(xpGain,999) end
      if ald('Increase duration').Active==true then writeFloat(duration,999) end
      if ald('Increase extra jumps').Active==true then writeFloat(extraJumps,999) end
      if ald('Increase projectile size').Active==true then writeFloat(projectileSize,10) end
      if ald('Increase projectile speed').Active==true then writeFloat(projectileSpeed,10) end
      if ald('Increase projectile count').Active==true then writeFloat(projectileCount,99) end
      if ald('Increase lifesteal').Active==true then writeFloat(lifeSteal,999) end
      if ald('Increase thorns').Active==true then writeFloat(thorns,999) end
      if ald('Increase pickup range').Active==true then writeFloat(pickupRange,999) end
      if ald('Increase gold gain').Active==true then writeFloat(goldGain,999) end
      if ald('Increase silver gain').Active==true then writeFloat(silverGain,999) end
      if ald('Increase run speed').Active==true then writeFloat(moveSpeed,25) end
      if ald('Increase jump height').Active==true then writeFloat(jumpHeight,25) end
      if ald('Increase luck').Active==true then writeFloat(luck,999) end
      if ald('Increase shield').Active==true then writeFloat(shield,999) end
      if ald('Increase armor').Active==true then writeFloat(armor,999) end
      if ald('Increase damage').Active==true then writeFloat(damage,999) end
      if ald('Increase evasion').Active==true then writeFloat(evasion,999) end
      if ald('Increase attack speed').Active==true then writeFloat(attackSpeed,999) end
      if ald('Increase crit chance').Active==true then writeFloat(critChance,99) end
      if ald('Increase crit damage').Active==true then writeFloat(critDamage,999) end
      if ald('Increase max hp').Active==true then writeFloat(maxHp,999) end
      if ald('Increase max hp regen').Active==true then writeFloat(hpRegen,999) end
      if ald('Complete quests').Active==true then if getAddressSafe(quest_flag) then writeInteger(quest_flag,1) else writeInteger(quest_flag,0) end end
      if gold and ald('Add 10k gold').Active==true and readFloat(gold) ~= nil then writeFloat(gold,readFloat(gold)+10000) ald('Add 10k gold').Active=false else ald('Add 10k gold').Active=false end
      if silver and ald('Add 10k silver').Active==true and readInteger(silver) ~= nil then writeInteger(silver,readInteger(silver)+10000) ald('Add 10k silver').Active=false else ald('Add 10k silver').Active=false end
      if xp and ald('Add 1k xp').Active==true and readInteger(xp) ~= nil then writeInteger(xp,readInteger(xp)+1000) ald('Add 1k xp').Active=false else ald('Add 1k xp').Active=false end
      if kills and ald('Add 10k kills').Active==true then writeFloat(kills,readFloat(kills)+10000) ald('Add 10k kills').Active=false else ald('Add 10k kills').Active=false end
      if ald('Max weapon stats on upgrade').Active==true then if getAddressSafe(mwsf) then writeInteger(mwsf,1) else writeInteger(mwsf,0) end end
      if ald('Noclip').Active==true then if getAddressSafe(noclip) then writeInteger(noclip,1) else writeInteger(noclip,0) end end

      --easy death script
      if ald('Reset all - (Ez Death)').Active==true then ald('Scripts').Active=false
          writeFloat(maxHp,0) writeFloat(hpRegen,0) writeFloat(shield,0) writeFloat(thorns,0)
          writeFloat(armor,0) writeFloat(evasion,0) writeFloat(damage,0) writeFloat(duration,0)
          writeFloat(knockback,0) writeFloat(luck,0) writeFloat(critChance,0) writeFloat(critDamage,0)
          writeFloat(attackSpeed,0) writeFloat(projectileCount,0) writeFloat(projectileSpeed,0) writeFloat(lifeSteal,0)
          ald('Reset all - (Ez Death)').Active=false
      end

  end -- base check

end -- tmrfunction

tmr('mbtmr',100,tmrfunction) --start timer
ald('Scripts').Active=true --open scripts header

