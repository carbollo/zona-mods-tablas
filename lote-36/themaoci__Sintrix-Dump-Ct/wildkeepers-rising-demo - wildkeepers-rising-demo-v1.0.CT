        <CheatEntry>
          <ID>1337317186</ID>
          <Description>"Grab Character Data"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>// Game Executable   : Dungeon-Win64-Shipping.exe
// Author            : rhark
// Executable Version: 5.4.4.0
// Module Version    : 
// Script Date       : 2025-04-19
{

RBX contains "Pawn"

This affects all characters on the map (not enemies)

}
[ENABLE]
aobscanmodule(health_AOB,$process,F3xxxxxx488BxxFFxxxxxxxxxxF3xxxxxx0F28) // should be unique
registersymbol(health_AOB)
alloc(healthHook,0x1000)
registersymbol(healthHook)

label(code_health)
label(return_health)
label(exit_health)
label(hpflag)
label(speedflag)

registersymbol(code_health)
registersymbol(hpflag)
registersymbol(speedflag)

healthHook:
  cmp [hpflag],1
  jne @f
  mov [rax],0

@@:
  cmp [speedflag],1
  jne @f
  mov [rbx+68],(float)5 // CustomTimeDilation

@@:
  cmp [speedflag],2
  jne @f
  mov [rbx+68],(float)1
  mov [speedflag],0

exit_health:

code_health:
  readmem(health_AOB,7)
{
  movss xmm6,[rax]
  mov rax,[rbx]
}
  jmp return_health
  
align 10 CC
  
healthHook+200:
hpflag:
  dd 0
speedflag:
  dd 0

midjumpmem+20:
 jmp healthHook

health_AOB:
  jmp midjumpmem+20
  nop 2
return_health:

[DISABLE]
health_AOB:
  readmem(code_health,7) // db F3 0F 10 30 48 8B 03

unregistersymbol(health_AOB)
unregistersymbol(healthHook)
unregistersymbol(code_health)
unregistersymbol(hpflag)
unregistersymbol(speedflag)
dealloc(healthHook)

