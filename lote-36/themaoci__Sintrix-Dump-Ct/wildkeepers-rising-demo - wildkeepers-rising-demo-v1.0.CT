          <AssemblerScript>// Game Executable   : Dungeon-Win64-Shipping.exe
// Author            : rhark
// Executable Version: 5.4.4.0
// Module Version    : 
// Script Date       : 2025-04-19
{



}
[ENABLE]
aobscanmodule(dungeonRun_AOB,$process,F2xxxxxxxxxxxxxxxx66xxxxxxxxF3xxxxxx66xxxxxx72) // should be unique
registersymbol(dungeonRun_AOB)
alloc(dungeonRunHook,0x1000)
registersymbol(dungeonRunHook)

label(code_dungeonRun)
label(return_dungeonRun)
label(exit_dungeonRun)
label(dungeonPtr)

registersymbol(code_dungeonRun)
registersymbol(dungeonPtr)

dungeonRunHook:
  mov [dungeonPtr],r8

exit_dungeonRun:

code_dungeonRun:
  readmem(dungeonRun_AOB,9)
{
  movsd xmm1,[r8+000003D8]
}
  jmp return_dungeonRun
  
align 10 CC
  
dungeonRunHook+200:
dungeonPtr:
  dq 0

midjumpmem+10:
 jmp dungeonRunHook

dungeonRun_AOB:
  jmp midjumpmem+10
  nop 4
return_dungeonRun:

[DISABLE]
dungeonRun_AOB:
  readmem(code_dungeonRun,9) // db F2 41 0F 10 88 D8 03 00 00

unregistersymbol(dungeonRun_AOB)
unregistersymbol(dungeonRunHook)
unregistersymbol(code_dungeonRun)
unregistersymbol(dungeonPtr)
unregistersymbol(midjumpmem)
dealloc(dungeonRunHook)

