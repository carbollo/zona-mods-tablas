        <CheatEntry>
          <ID>1337317189</ID>
          <Description>"Enable XP Multiplier"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>
[ENABLE]
//Send@FearlessRevolution|Sintrix
aobscanmodule(xpMulti,Dungeon-Win64-Shipping.exe,F2 0F 11 80 D8 03 00 00)
alloc(newmem,$1000,xpMulti)
registersymbol(setxp)
label(code return setxp)

newmem:
xorps xmm15,xmm15
movsd xmm15,xmm0
mulsd xmm15,[setxp]
movsd xmm0,xmm15
movsd [rax+3D8],xmm0

code:
  movsd [rax+000003D8],xmm0
  jmp return

setxp:
dq (double)2

xpMulti:
  jmp newmem
  nop 3
return:
registersymbol(xpMulti)

[DISABLE]

xpMulti:
  db F2 0F 11 80 D8 03 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
