local s=findTableFile('Sintrix_BytrlEdit.lua').Stream load(readStringLocal(s.Memory,s.Size))() setAddressListPicture('sintrix.jpg', 210, 0x0000FF)
-- target process, header, footer, made by, initialize mono (true/false)
startTable('Schedule I.exe','Schedule I v1.6', 'Schedule I v1.6', 'Everyone @ Sintrix', true)


local function iav(targetAddress,callback)
    --print("Starting address validation for: " .. targetAddress)
    monoChkTmr=createTimer() monoChkTmr.Interval=1000 monoChkTmr.onTimer=function()
        --print("Timer running, checking address: " .. targetAddress)
        local address=getAddressSafe(targetAddress)
        if address then
            --printf("Address found: 0x%X", address)
            callback()
            --print("Destroying timer..")
            monoChkTmr.destroy()
            monoChkTmr=nil
            if monoChkTmr then --print("Timer still running for some reason..")
            else
            --print("Timer destroyed")
            end
        else
            --print("Address not found: " .. targetAddress)
        end
    end
end



local function asmCode() autoAssemble([[
aobscanmodule(GETPUNCHCONTROLLER,GameAssembly.dll,80 * * * 0F * * * * * F3 * * * * * * * 0F * * * 0F * * * * * 0F * * * * 33 * 48 * * E8)
alloc(newmemGETPUNCHCONTROLLER,$100,GETPUNCHCONTROLLER)
alloc(punch,8,GETPUNCHCONTROLLER)
label(codeGETPUNCHCONTROLLER returnGETPUNCHCONTROLLER)
newmemGETPUNCHCONTROLLER:
mov [punch],rbx
codeGETPUNCHCONTROLLER:
cmp byte ptr [rbx+20],00
je GameAssembly.dll+7C1E91
jmp returnGETPUNCHCONTROLLER
GETPUNCHCONTROLLER:
jmp newmemGETPUNCHCONTROLLER
nop 5
returnGETPUNCHCONTROLLER:
registersymbol(GETPUNCHCONTROLLER punch)

aobscanmodule(getcash,GameAssembly.dll,F3 * * * * 33 * 48 * * * * F3 * * * * * E8 * * * * 48)
alloc(newmemgetcash,$100,getcash)
alloc(cash,8,getcash)
label(codegetcash returngetcash)
newmemgetcash:
mov [cash],rax
codegetcash:
addss xmm6,[rax+38]
jmp returngetcash
getcash:
jmp newmemgetcash
returngetcash:
registersymbol(getcash cash)

define(ScheduleOne_PlayerScripts_PlayerMovement_Update, ScheduleOne.PlayerScripts.PlayerMovement.Update)
alloc(newmemScheduleOne_PlayerScripts_PlayerMovement_Update,$100,ScheduleOne_PlayerScripts_PlayerMovement_Update)
alloc(mptr,8,ScheduleOne_PlayerScripts_PlayerMovement_Update)
label(codeScheduleOne_PlayerScripts_PlayerMovement_Update returnScheduleOne_PlayerScripts_PlayerMovement_Update)
newmemScheduleOne_PlayerScripts_PlayerMovement_Update:
mov [mptr],rcx
codeScheduleOne_PlayerScripts_PlayerMovement_Update:
push rbx
sub rsp,50
jmp returnScheduleOne_PlayerScripts_PlayerMovement_Update
ScheduleOne_PlayerScripts_PlayerMovement_Update:
jmp newmemScheduleOne_PlayerScripts_PlayerMovement_Update
nop 1
returnScheduleOne_PlayerScripts_PlayerMovement_Update:
registersymbol(ScheduleOne_PlayerScripts_PlayerMovement_Update mptr)

//Save.Execute aobscanmodule(Save_game,GameAssembly.dll,)
//aobscanmodule(freecamFunction,GameAssembly.dll,48 * * * 80 * * * * * * 75 * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 48 * * * F6 * * * * * * 75 * 48 * * E8 * * * * 48 * * * * * * 48 * * * * * * 48 * * * F6)
//aobscanmodule(clearInventoryFunction,GameAssembly.dll,40 53 48 83 EC 20 80 3D ?? ?? ?? ?? 00 75 2B 48 8D 0D ?? ?? ?? ?? E8 ?? ?? 96 ?? 48 ?? ?? ?? ?? ?? ?? e8 ?? ?? ?? ?? 48 ?? ?? ?? ?? ?? ?? e8 ?? ?? ?? ?? c6 ?? ?? ?? ?? ?? ?? 48 ?? ?? ?? ?? ?? ?? 83)
//aobscanmodule(clearWantedFunction,GameAssembly.dll,40 * 48 * * * 80 * * * * * * 75 * 48 * * * * * * E8 * * * * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 83 * * * * * * 75 * E8 * * * * 80 * * * * * * 48 * * * * * * 75 * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 83 * * * * * * 75 * E8 * * * * 45 * * 33 * 48 * * E8 * * * * 80 * * * * * * 75 * 48 * * * * * * E8 * * * * C6 * * * * * * 48 * * * * * * 83 * * * * * * 75 * 48 * * E8 * * * * 48 * * * * * * 48 * * * * * * 48 * * * 48 * * 74 * 48 * * * * * * 48 * * 74 * 45)
aobscanmodule(pCords,UnityPlayer.dll,41 0F 11 86 F0 01 00 00 F2)
alloc(newmem_pcrds,$100,pCords)
alloc(xyz,8,pCords)
alloc(fc_flag,4,pCords)
alloc(s_game,4,pCords)
alloc(clrinv,4,pCords)
alloc(clrwntd,4,pCords)
alloc(additem,4,pCords)
label(code_pcrds return_pcrds savegamecheck clearinventorycheck clearwantedcheck)

fc_flag:
dd 0

s_game:
dd 0

clrinv:
dd 0

clrwntd:
dd 0

newmem_pcrds:
mov [xyz],r14
cmp [fc_flag],1
jne savegamecheck
call FreeCamCommand.Execute
mov [fc_flag],0

savegamecheck:
cmp [s_game],1
jne clearinventorycheck
call Save.Execute
mov [s_game],0

clearinventorycheck:
cmp [clrinv],1
jne clearwantedcheck
call ClearInventoryCommand.Execute
mov [clrinv],0

clearwantedcheck:
cmp [clrwntd],1
jne code_pcrds
call ClearWanted.Execute
mov [clrwntd],0

code_pcrds:
movups [r14+000001F0],xmm0
jmp return_pcrds
pCords:
jmp newmem_pcrds
nop 3
return_pcrds:
registersymbol(pCords xyz fc_flag s_game clrinv clrwntd)

aobscanmodule(gettime,GameAssembly.dll,F3 * * * * * * * 33 * E8 * * * * F3 * * * * * * * F3 * * * F3)
alloc(newmemgettime,$100,gettime)
alloc(time,8,gettime)
label(codegettime returngettime)
newmemgettime:
mov [time],rbx
// if fast time is on, jump over 4am
cmp [rbx+138],(float)100
jne codegettime
cmp [rbx+128],(float)399 // if its 4am
jne codegettime
mov [rbx+128],(float)701 // jump to 7am
codegettime:
movss xmm6,[rbx+0000012C]
jmp returngettime
gettime:
jmp newmemgettime
nop 3
returngettime:
registersymbol(gettime time)

define(ScheduleOne_UI_PickpocketScreen_Update, ScheduleOne.UI.PickpocketScreen.Update)
alloc(newmemScheduleOne_UI_PickpocketScreen_Update,$100,ScheduleOne_UI_PickpocketScreen_Update)
alloc(pickPocket,8,ScheduleOne_UI_PickpocketScreen_Update)
alloc(epp,4,ScheduleOne_UI_PickpocketScreen_Update)
label(codeScheduleOne_UI_PickpocketScreen_Update returnScheduleOne_UI_PickpocketScreen_Update)
epp:
dd 0
newmemScheduleOne_UI_PickpocketScreen_Update:
cmp [epp],1
jne @F
mov [rcx+2C],(float)950
mov [rcx+30],(float)950
mov [rcx+40],(float)999999
mov [rcx+C0],0
@@:
cmp [epp],0
jne codeScheduleOne_UI_PickpocketScreen_Update
mov [rcx+2C],(float)45
mov [rcx+30],(float)7
codeScheduleOne_UI_PickpocketScreen_Update:
push rdi
sub rsp,40
jmp returnScheduleOne_UI_PickpocketScreen_Update
ScheduleOne_UI_PickpocketScreen_Update:
jmp newmemScheduleOne_UI_PickpocketScreen_Update
nop 1
returnScheduleOne_UI_PickpocketScreen_Update:
registersymbol(ScheduleOne_UI_PickpocketScreen_Update epp)

alloc(newmemrpo,$100,ScheduleOne.ObjectScripts.Recycler.GetTrash)
registersymbol(recycle)
label(coderpo returnrpo recycle)
newmemrpo:
xorps xmm15,xmm15
movss xmm15,[recycle]
movss [rcx+1D0],xmm15
coderpo:
  mov [rsp+20],rbx
  jmp returnrpo
recycle:
dd (float)100
ScheduleOne.ObjectScripts.Recycler.GetTrash:
  jmp newmemrpo
returnrpo:

aobscanmodule(findclip,GameAssembly.dll,FF * * 4C * * * 74 * 48 * * * 48 * * * 48 * * * 48 * * * FF * 49 * * 49)
alloc(newmemfindclip,$100,findclip)
alloc(clip,8,findclip)
label(codefindclip returnfindclip)
newmemfindclip:
mov [clip],rcx
codefindclip:
dec [rcx+38]
cmp [rcx+28],r14
jmp returnfindclip
findclip:
jmp newmemfindclip
nop 2
returnfindclip:
registersymbol(findclip clip)


]]) end


iav('ScheduleOne.PlayerScripts.PlayerMovement.Update',asmCode)



cMenuTmr=createTimer() cMenuTmr.Interval=100 cMenuTmr.onTimer=function()

  local moveSpeedmultiplier=getAddressSafe('[mptr]+38')
