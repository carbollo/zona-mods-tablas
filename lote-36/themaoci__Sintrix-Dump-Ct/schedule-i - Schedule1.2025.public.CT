{$lua}
rel_tmr=createTimer() rel_tmr.Interval=100 rel_tmr.onTimer=function()

  if getAddressSafe('[_customerr]') then


    local relationshipDelta=getAddressSafe('[[[_customerr]+158]+1F0]+10') writeFloat(relationshipDelta,5)
    local npcSlotCount=getAddressSafe('[[[_customerr]+158]+1A8]+120') writeInteger(npcSlotCount,10)
    local npcCanBePickpocketed=getAddressSafe('[[[_customerr]+158]+1A8]+124') writeByte(npcCanBePickpocketed,1)
    local npcRandomCashMin=getAddressSafe('[[[_customerr]+158]+1A8]+134') writeInteger(npcRandomCashMin,3294785)
    local npcRandomCashMax=getAddressSafe('[[[_customerr]+158]+1A8]+138') writeInteger(npcRandomCashMax,999999999)
    local npcRandomItemMax=getAddressSafe('[[[_customerr]+158]+1A8]+14C') writeInteger(npcRandomItemMax,999999999)
    local relationshipUnlocked=getAddressSafe('[[[_customerr]+158]+1F0]+14') writeByte(relationshipUnlocked,1)
    local canbeSummoned=getAddressSafe('[[_customerr]+158]+1e8') writeByte(canbeSummoned,1)
    local npcAddiction=getAddressSafe('[_customerr]+11c') writeFloat(npcAddiction,100)
    local defaultDeliveryLocation=getAddressSafe('[_customerr]+180') writePointer(defaultDeliveryLocation,readPointer(defaultDeliveryLocation))
    --local npcRegion=getAddressSafe('[[_customerr]+158]+150') writeInteger(npcRegion,1)
    local npcWalkSpeed=getAddressSafe('[[[_customerr]+158]+168]+11C') writeFloat(npcWalkSpeed,2)
    local npcRunSpeed=getAddressSafe('[[[_customerr]+158]+168]+120') writeFloat(npcRunSpeed,7)
    local npcMoveMultiplier=getAddressSafe('[[[_customerr]+158]+168]+124') writeFloat(npcMoveMultiplier,3) --float 1 is normal
    local npcSpeedMultiplierController=getAddressSafe('[[[[_customerr]+158]+168]+140]+24') writeFloat(npcSpeedMultiplierController,2) --float 1 is normal
    local npcAggression=getAddressSafe('[[[[_customerr]+158]+168]+148]+158') writeFloat(npcAggression,1) --float 0.13 is normal
    local hasBeenRecommended=getAddressSafe('[_customerr]+154') writeByte(hasBeenRecommended,1)
    local sampleOfferedToday=getAddressSafe('[_customerr]+1D4') writeByte(sampleOfferedToday,0)
    local minWeeklySpend=getAddressSafe('[[_customerr]+178]+28') writeFloat(minWeeklySpend,345666)
    local maxWeeklySpend=getAddressSafe('[[_customerr]+178]+2C') writeFloat(maxWeeklySpend,9999999)
    local minOrdersPerWeek=getAddressSafe('[[_customerr]+178]+30') writeInteger(minOrdersPerWeek,678)
    local maxOrdersPerWeek=getAddressSafe('[[_customerr]+178]+34') writeInteger(maxOrdersPerWeek,99969)
    local orderTime=getAddressSafe('[[_customerr]+178]+38') writeInteger(orderTime,1200)
    local npcStandards=getAddressSafe('[[_customerr]+178]+40') writeInteger(npcStandards,1)
    local canBeDirectlyApproached=getAddressSafe('[[_customerr]+178]+44') writeByte(canBeDirectlyApproached,1)
    local guaranteeFirstSampleSuccess=getAddressSafe('[[_customerr]+178]+45') writeByte(guaranteeFirstSampleSuccess,1)
    local minMutualRelationRequirement=getAddressSafe('[[_customerr]+178]+48') writeFloat(minMutualRelationRequirement,0)
    local maxMutualRelationRequirement=getAddressSafe('[[_customerr]+178]+4C') writeFloat(maxMutualRelationRequirement,0)
    local callPoliceChance=getAddressSafe('[[_customerr]+178]+50') writeFloat(callPoliceChance,0)
    local dependenceMultiplier=getAddressSafe('[[_customerr]+178]+54') writeFloat(dependenceMultiplier,100)
    local baseAddiction=getAddressSafe('[[_customerr]+178]+58') writeFloat(baseAddiction,100)


  end

end
{$asm}


