  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('Sunkenland.exe','Sunkenland Version 1.1', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>769</ID>
          <Description>"→ Initialize Mono"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

{$lua}
mono_initialize()
LaunchMonoDataCollector()
{$asm}


[DISABLE]


</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>796</ID>
              <Description>"→ Enable Player Functions"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">//Send@Sintrix|FearlessRevolution
[ENABLE]

aobscanregion(PlayerCharacterBase,PlayerCharacter:Update,PlayerCharacter:Update+33,55 48 8B EC 48 81 EC E0 00 00 00 48 89 75 F8 48 8B F1 48 B8)
alloc(newmem,$1000,PlayerCharacterBase)
registersymbol(p_ptr phealth pstamina phunger pthirst penergy pradiation pbodytemp)
label(code return p_ptr phealth pstamina phunger pthirst penergy pradiation pbodytemp)

newmem:
mov [p_ptr],rcx
cmp [phealth],1
jne @f
mov [rcx+320],(float)9999
jmp @f

@@:
cmp [pstamina],1
jne @@2
mov [rcx+338],(float)400
jmp @@2

@@2:
cmp [penergy],1
jne @@3
mov [rcx+33C],(float)400
jmp @@3

@@3:
cmp [phunger],1
jne @@4
mov [rcx+328],(float)100
jmp @@4

@@4:
cmp [pthirst],1
jne @@6
mov [rcx+32C],(float)100
jmp @@6

@@6:
cmp [pradiation],1
jne @@7
mov [rcx+3EC],(float)10
jmp @@7

@@7:
cmp [pbodytemp],1
jne code
mov [rcx+330],(float)70
jmp code

code:
  push rbp
  mov rbp,rsp
  sub rsp,000000E0
  jmp return

p_ptr:
dq 0

phealth:
dd 0

pstamina:
dd 0

penergy:
dd 0

phunger:
dd 0

pthirst:
dd 0

pradiation:
dd 0

pbodytemp:
dq 0

PlayerCharacterBase:
  jmp newmem
  nop 6
return:
registersymbol(PlayerCharacterBase)

[DISABLE]

PlayerCharacterBase:
  db 55 48 8B EC 48 81 EC E0 00 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>799</ID>
                  <Description>"Infinite Health"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
PlayerDummy:TakeDamage:
db C3

aobscanregion(PlayerHealth,PlayerCharacter:AddHealth,PlayerCharacter:AddHealth+15c5,F3 0F 11 AB 20 03 00 00 F3 0F 10 83 20)
alloc(newmem,$1000,PlayerHealth)

label(code)
label(return)

newmem:

code:
  movss xmm5,[nhp]
  movss [rbx+0000031C],xmm5
  movss [rbx+00000320],xmm5
  jmp return

nhp:
dd (float)99999

PlayerHealth:
  jmp newmem
  nop 3
return:
registersymbol(PlayerHealth)

[DISABLE]
PlayerDummy:TakeDamage:
db 55
PlayerHealth:
  db F3 0F 11 AB 20 03 00 00

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
                </CheatEntry>
