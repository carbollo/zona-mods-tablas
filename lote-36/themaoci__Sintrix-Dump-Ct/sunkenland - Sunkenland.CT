                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

//Send@Sintrix|FearlessRevolution

aobscanregion(oxygen,PlayerCharacter:UpdateSurvival,PlayerCharacter:UpdateSurvival+1680,F3??????????????F3??????F2??????F3??????????????F3??????????????F3??????66??????4833??66??????400F????85??400F????480F????85??0F84????????F3)
alloc(newmem,$1000,oxygen)
label(code return)

newmem:
mov [rsi+344],(float)120

code:
  movss xmm0,[rsi+00000344]
  jmp return

oxygen+08:
