  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"➜  Enable (Auto-Attach Game Process)"</Description>
      <Options moActivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
startTable('WWE2K26_x64.exe','WWE 2K26 x SEND', '')

{$asm}
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>776</ID>
          <Description>"MyRise: Unlimited Attribute Points"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// Send @ Sintrix | FearlessRevolution
aobscanmodule(AttributePoints,WWE2K26_x64.exe,44 29 81 38 06 00 00 44 01 81 3C 06 00 00)
alloc(newmem,$1000,AttributePoints)

label(code)
label(return)

newmem:

code:
  mov [rcx+00000638],#999
  add [rcx+0000063C],r8d
  jmp return

AttributePoints:
  jmp far newmem
return:
registersymbol(AttributePoints)
// Send @ Sintrix | FearlessRevolution
[DISABLE]
// Send @ Sintrix | FearlessRevolution
AttributePoints:
  db 44 29 81 38 06 00 00 44 01 81 3C 06 00 00
// Send @ Sintrix | FearlessRevolution
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>459</ID>
      <Description>"--------------------------------"</Description>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
