              <Options moHideChildren="1"/>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(speed,ReadyOrNot-Win64-Shipping.exe,F3 0F 11 80 48 02 00 00 41 80)
alloc(newmem,$1000,speed)
registersymbol(setspeed)
label(code return)

newmem:

code:
  movss xmm0,[setspeed]
  movss [rax+00000248],xmm0
  jmp return

setspeed:
dd (float)306.23

speed:
  jmp newmem
  nop 3
return:
registersymbol(speed)

[DISABLE]

speed:
  db F3 0F 11 80 48 02 00 00

unregistersymbol(*)
