  <CheatEntries>
    <CheatEntry>
      <ID>770</ID>
      <Description>"→ Enable (Auto-Attach Game Process)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
local s = findTableFile('SintrixLua.lua').Stream
load(readStringLocal(s.Memory,s.Size))()
setAddressListPicture('sintrix.jpg', 210, 0x0000FF)
startTable('ReadyOrNot-Win64-Shipping.exe','', 'Sintrix | Game Build: 16535856 | Table Version: 1.0')
autoAssembler:AutoAssemble("PlayerArrayHook.CEA", memrec)
[ENABLE]
[DISABLE]

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1337208720</ID>
          <Description>"==== Character ===="</Description>
          <Options moHideChildren="1"/>
          <Color>FFFF00</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>26542</ID>
              <Description>"Infinite Health"</Description>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscanmodule(health,ReadyOrNot-Win64-Shipping.exe,F3 0F 58 96 F0 16 00 00)
alloc(newmem,$1000,health)

label(code)
label(return)

newmem:
push rbx
mov rbx,[rbx+908] //characterhealth
test rbx,rbx
je @f
mov [rbx+F4],1 //isUnlimited

@@:
pop rbx

code:
  addss xmm2,[rsi+000016F0]
  jmp return

health:
  jmp newmem
  nop 3
return:
registersymbol(health)

[DISABLE]

health:
  db F3 0F 58 96 F0 16 00 00

unregistersymbol(*)
dealloc(*)

//ReadyOrNot-Win64-Shipping.exe+4165512: F3 0F 58 96 F0 16 00 00  - addss xmm2,[rsi+000016F0]

</AssemblerScript>
            </CheatEntry>
