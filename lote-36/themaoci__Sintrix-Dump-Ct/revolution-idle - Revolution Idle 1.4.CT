          <CheatEntries>
            <CheatEntry>
              <ID>536</ID>
              <Description>"Infinite Souls (Open Shop)"</Description>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Target:  Revolution Idle.exe
//Author:  Salis
//Credit to METHOS for custom Template LUA

[ENABLE]

////////////////////////  infsoul  \\\\\\\\\\\\\\\\\\\\\\\\

define(address, DisplayShop:Update+33)

alloc(newmem,1024)
alloc(obytes_infsoul, 10)
label(return code)

registersymbol(obytes_infsoul)

obytes_infsoul:
readmem(address, 10)

newmem:

code:
 mov [rax+2C],#2147000000
 movsxd  rax,dword ptr [rax+2C]
 cvtsi2sd xmm0,eax
 jmp return

address:
 jmp newmem
 nop 3
return:


[DISABLE]

address:
readmem(obytes_infsoul, 10)

dealloc(*)
unregistersymbol(*)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>514</ID>
              <Description>"Instant Complete Infinity Challenge 1-8"</Description>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Send@Sintrix
define(address,DisplayInfinityChallengeItem:Update+61)
define(bytes,0F B6 40 15 85 C0)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,DisplayInfinityChallengeItem:Update+61)
label(code return)

newmem:
mov [rax+15],1

code:
  movzx eax,byte ptr [rax+15]
  test eax,eax
  jmp return

address:
  jmp newmem
  nop
return:

[DISABLE]

address:
  db bytes


dealloc(*)

</AssemblerScript>
