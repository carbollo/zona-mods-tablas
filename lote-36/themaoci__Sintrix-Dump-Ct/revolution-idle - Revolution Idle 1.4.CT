            <CheatEntry>
              <ID>548</ID>
              <Description>"-&gt; Get GameData"</Description>
              <Options moHideChildren="1"/>
              <Color>00FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : Revolution Idle.exe
  Version: 
  Date   : 2024-11-13
  Author : User

  This script does blah blah blah
}

define(address,InventoryData:get_BoostMult+26)


[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,InventoryData:get_BoostMult+26)
alloc(obytes_getgcont, 10)
label(code)
label(return)

registersymbol(obytes_getgcont gamecontroller)

obytes_getgcont:
readmem(address,10)

newmem:

code:
  mov [gamecontroller], rcx
  cmp dword ptr [rcx],00
  movzx eax,byte ptr [rax+000001D4]
  jmp return

gamecontroller:
dd #0

address:
  jmp newmem
  nop 5
return:


[DISABLE]

address:
readmem(obytes_getgcont, 10)
  // cmp dword ptr [rcx],00
  // movzx eax,byte ptr [rax+000001D4]

dealloc(*)
unregistersymbol(*)

{
// ORIGINAL CODE - INJECTION POINT: InventoryData:get_BoostMult+26

1E87A204E5C: 00 00                          - add [rax],al
1E87A204E5E: 00 00                          - add [rax],al
InventoryData:get_BoostMult: 55                             - push rbp
InventoryData:get_BoostMult+1: 48 8B EC                       - mov rbp,rsp
InventoryData:get_BoostMult+4: 48 83 EC 30                    - sub rsp,30
InventoryData:get_BoostMult+8: 49 BA 40 6B B3 6C E8 01 00 00  - mov r10,000001E86CB36B40
InventoryData:get_BoostMult+12: 48 8D 6D 00                    - lea rbp,[rbp+00]
InventoryData:get_BoostMult+16: 49 BB 40 DE F9 6E E8 01 00 00  - mov r11,SingleBehaviour`1[T_REF]:get_Instance
InventoryData:get_BoostMult+20: 41 FF D3                       - call r11
InventoryData:get_BoostMult+23: 48 8B C8                       - mov rcx,rax
// ---------- INJECTING HERE ----------
InventoryData:get_BoostMult+26: 83 39 00                       - cmp dword ptr [rcx],00
// ---------- DONE INJECTING  ----------
InventoryData:get_BoostMult+29: 0F B6 80 D4 01 00 00           - movzx eax,byte ptr [rax+000001D4]
InventoryData:get_BoostMult+30: 85 C0                          - test eax,eax
InventoryData:get_BoostMult+32: 75 0D                          - jne InventoryData:get_BoostMult+41
InventoryData:get_BoostMult+34: F2 0F 10 05 74 00 00 00        - movsd xmm0,[InventoryData:get_BoostMult+b0]
InventoryData:get_BoostMult+3c: E9 4E 00 00 00                 - jmp InventoryData:get_BoostMult+8f
InventoryData:get_BoostMult+41: 48 B8 D0 27 1D 74 E8 01 00 00  - mov rax,000001E8741D27D0
InventoryData:get_BoostMult+4b: 48 8B 00                       - mov rax,[rax]
InventoryData:get_BoostMult+4e: 48 8B C8                       - mov rcx,rax
InventoryData:get_BoostMult+51: BA 04 00 00 00                 - mov edx,MonoDataCollector64._Init_thread_epoch
InventoryData:get_BoostMult+56: 83 38 00                       - cmp dword ptr [rax],00
}
</AssemblerScript>
