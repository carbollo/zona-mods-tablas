[ENABLE]

aobscanmodule(INJECT,sh4.exe,F3 0F 10 05 BC C5 59 00 0F) // should be unique
alloc(newmem,$1000)

label(code)
label(return)
label(execution_ping)
label(execution_attaque)
label(execution_avion)
label(execution_grenade)
label(execution_tanks)
label(execution_dive_planes)
label(execution_rudder)
label(execution_rudder_breaking_up)
label(restauration)
label(restauration_tanks)
label(restauration_dive_planes)
label(restauration_rudder)
label(restauration_rudder_breaking_up)
label(dialogue_ping)
label(dialogue_attaque)
label(dialogue_avion)
label(dialogue_grenade)
label(verif_evenements)
label(suivant_attaque)
label(suivant_grenade)
label(suivant_avion)
label(post_tanks)
label(post_dive_planes)
label(post_rudder)
label(registre_tanks)
label(registre_dive_planes)
label(registre_gouvernail)
label(registre_pdv)


alloc(flag_event_ping,1)
alloc(flag_event_attaque,1)
alloc(flag_event_avion,1)
alloc(flag_event_grenade,1)
alloc(flag_ping,1)
alloc(flag_attaque,1)
alloc(flag_avion,1)
alloc(flag_grenade,1)
alloc(flag_tanks,1)
alloc(flag_dive_planes,1)
alloc(flag_rudder,1)
alloc(flag_rudder_breaking_up,1)

alloc(delai,4)
alloc(mort_joueur,4)

mort_joueur:
dd (float)0

delai:
dd (float)29


newmem:
//Si le joueur est pingué (déclencheur)
cmp esp,0019F0E0
je execution_ping

//Si le destroyer attaque (déclencheur)
cmp esp,0019F008
je execution_attaque

//Si l'avion attaque (déclencheur)
cmp esp,0019F090
je execution_avion

//Si grenades sous-marines déployées (déclencheur)
cmp esp,0019F030
je execution_grenade
cmp esp,0019F060
je execution_grenade



//Pointeur du réservoir de carburant
push edi
mov edi,[sh4.exe+001F57F4]
cmp edi,0 //Évite les plantages pendant les chargements
je registre_tanks
mov edi,[edi+14]
mov edi,[edi+4]
cmp edi,0 //Évite les plantages pendant les parties
je registre_tanks
mov edi,[edi+590]
cmp edi,(float)0
je restauration_tanks
cmp edi,(float)1
je execution_tanks

registre_tanks:
pop edi


post_tanks:
//pointeur des points de vie du joueur
push edx
mov edx, [EffectManagers.act+0000A180]
cmp edx,0 //Évite les plantages pendant les chargements
je registre_pdv
movss xmm2, [edx+D4]
comiss xmm2, [mort_joueur]
xorps xmm2,xmm2
pop edx
ja restauration_dive_planes
//Zone arrière
push edi
mov edi,[EffectManagers.act+0000A1C0]
mov edi,[edi+34]
mov edi,[edi+3C]
mov edi,[edi+27C]
cmp edi,(float)0 //0 = zone détruite, 1 = zone intacte
je execution_dive_planes

registre_dive_planes:
pop edi
jmp post_dive_planes

registre_pdv:
pop edx


post_dive_planes:
//Pointeur du gouvernail
push edx
mov edx,[sh4.exe+001F524C]
cmp edx,0 //Évite les plantages pendant les chargements
je registre_gouvernail
mov edx,[edx]
mov edx,[edx+30]
mov edx,[edx+20]
mov edx,[edx+8]
cmp edx,0 //Évite les plantages si changement de MODS
je registre_gouvernail
mov edx,[edx+44]
mov edx,[edx+4C]
cmp edx,0 //Évite les plantages pendant les parties
je registre_gouvernail
mov edx,[edx]
cmp edx,(float)0
je restauration_rudder
cmp edx,(float)1
je execution_rudder_breaking_up
cmp edx,(float)1
jb execution_rudder


registre_gouvernail:
pop edx


post_rudder:
//Si musiques de tension
push eax
mov eax,[sh4.exe+001F2E28]
mov eax,[eax+8]
mov eax,[eax+38]
mov eax,[eax+1B8]
cmp eax,3
pop eax
jne restauration

//Si l'événement est en cours, jouer le dialogue
cmp byte ptr [flag_event_ping],1
je dialogue_ping


verif_evenements:
//30 secondes de délai avant nouvelle exécution
movss xmm2,[delai]
comiss xmm2,[sh4.exe+1E5004]
xorps xmm2,xmm2
ja suivant_attaque

mov byte ptr [flag_attaque],0
mov byte ptr [flag_event_attaque],0
mov byte ptr [flag_avion],0
mov byte ptr [flag_event_avion],0
mov byte ptr [flag_grenade],0
mov byte ptr [flag_event_grenade],0


suivant_attaque:
//Si l'événement est en cours, jouer le dialogue
cmp byte ptr [flag_event_attaque],1
je dialogue_attaque

suivant_grenade:
//Si l'événement est en cours, jouer le dialogue
cmp byte ptr [flag_event_grenade],1
je dialogue_grenade

suivant_avion:
//Si l'événement est en cours, jouer le dialogue
cmp byte ptr [flag_event_avion],1
je dialogue_avion


jmp code


/////////////////// Voix "Ennemy ship is pinging us sir" ///////////////////

execution_ping:
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_event_ping],1
jmp SHSound.act+3915


dialogue_ping:
//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_ping],1
je verif_evenements

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_ping],1

mov edi,[sh4.exe+19785C]
mov ebp,00000004        //Poste du sonar

//Message "Le sonar ennemi nous a repérés !"
push 00000256
mov ecx,sh4.exe+1F20C8

//Voix "Enemy is pinging us sir"
mov esi,sh4.exe+1C5824
call sh4.exe+16700
push eax

//État des dégâts
push 00001EE0    //valeur nulle
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174



/////////////////// Voix "Destroyer in attack run" ///////////////////

execution_attaque:
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_event_attaque],1
jmp SHSim.act+27F95


dialogue_attaque:
//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_attaque],1
je suivant_grenade

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_attaque],1

mov edi,[sh4.exe+19785C]
mov ebp,00000004        //Poste du sonar

//Message "Le destroyer nous engage !"
push 0000025F
mov ecx,sh4.exe+1F20C8

//Voix "Destroyer in attack run"
mov esi,sh4.exe+1C5758
call sh4.exe+16700
push eax

//État des dégâts
push 00001EE0    //valeur nulle
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174



/////////////////// Voix "Depth charges in the water sir" ///////////////////

execution_grenade:
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_event_grenade],1
jmp SHSim.act+3C64C


dialogue_grenade:
//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_grenade],1
je suivant_avion

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_grenade],1

mov edi,[sh4.exe+19785C]
mov ebp,00000004        //Poste du sonar

//Message "Grenades sous-marines !"
push 0000025B
mov ecx,sh4.exe+1F20C8

//Voix "Depth charges in the water sir"
mov esi,sh4.exe+1D8500
call sh4.exe+16700
push eax

//État des dégâts
push 00001EE0    //valeur nulle
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174



/////////////////// Voix "Enemy aircraft engaging us sir" ///////////////////

execution_avion:
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_event_avion],1
jmp SHSim.act+2B9C3


dialogue_avion:
//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_avion],1
je code

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_avion],1

mov edi,[sh4.exe+19785C]
mov ebp,00000005        //Poste du pont

//Message "L'avion ennemi nous attaque !"
push 00000258
mov ecx,sh4.exe+1F20C8

//Voix "Enemy aircraft engaging us sir"
mov esi,sh4.exe+1C57B4
call sh4.exe+16700
push eax

//État des dégâts
push 00001EE0    //valeur nulle
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174



/////////////////// Voix "Fuel tanks heavily damaged" ///////////////////

execution_tanks:
pop edi

//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_tanks],1
je post_tanks

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_tanks],1

mov edi,[sh4.exe+19785C]
mov ebp,00000000        //Poste du commandant

//Message "Réservoir"
push 000001CB
mov ecx,sh4.exe+1F20C8

//Voix "Fuel tanks heavily damaged"
mov esi,sh4.exe+1D85A0
call sh4.exe+16700
push eax

//État des dégâts
push 0000027A    //hors service
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174

restauration_tanks:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_tanks],0
pop edi

jmp post_tanks



/////////////////// Voix "Dive planes destroyed" ///////////////////

execution_dive_planes:
pop edi

//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_dive_planes],1
je post_dive_planes

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_dive_planes],1

mov edi,[sh4.exe+19785C]
mov ebp,00000000        //Poste du commandant

//Message "Barres de plongée"
push 000016F4
mov ecx,sh4.exe+1F20C8

//Voix "Dive planes destroyed"
mov esi,sh4.exe+1C8DE0
call sh4.exe+16700
push eax

//État des dégâts
push 0000027A    //hors service
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174

restauration_dive_planes:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_dive_planes],0

jmp post_dive_planes



/////////////////// Voix "Rudder damaged" ///////////////////

execution_rudder:
pop edx

//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_rudder],1
je post_rudder

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_rudder],1

mov edi,[sh4.exe+19785C]
mov ebp,00000000        //Poste du commandant

//Message "Barre"
push 000008AC
mov ecx,sh4.exe+1F20C8

//Voix "Rudder damaged"
mov esi,sh4.exe+1C8D50
call sh4.exe+16700
push eax

//État des dégâts
push 00000279    //avarie
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174

restauration_rudder:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_rudder],0
mov byte ptr [flag_rudder_breaking_up],0
pop edx

jmp post_rudder



/////////////////// Voix "Rudder breaking up" ///////////////////

execution_rudder_breaking_up:
pop edx

//Si le dialogue s'est exécuté, ne pas le rejouer
cmp byte ptr [flag_rudder_breaking_up],1
je post_rudder

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_rudder_breaking_up],1

mov edi,[sh4.exe+19785C]
mov ebp,00000004        //Poste du sonar

//Message "Rupture"
push 00001EE7
mov ecx,sh4.exe+1F20C8

//Voix "Rudder breaking up"
mov esi,sh4.exe+1D8540
call sh4.exe+16700
push eax

//État des dégâts
push 00001EE3   //du gouvernail
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push eax
lea edx,[esp+20]
push edx
call edi
add esp,0C

//Zone d'exécution du dialogue
jmp sh4.exe+17B174

restauration_rudder_breaking_up:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_rudder_breaking_up],0
pop edx

jmp post_rudder



restauration:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_event_ping],0
mov byte ptr [flag_ping],0
mov byte ptr [flag_event_attaque],0
mov byte ptr [flag_attaque],0
mov byte ptr [flag_event_avion],0
mov byte ptr [flag_avion],0
mov byte ptr [flag_event_grenade],0
mov byte ptr [flag_grenade],0

