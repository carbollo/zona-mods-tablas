//Salle de contrôle (caché)
addss xmm3,[edx+6DC]
//Salle de contrôle
addss xmm3,[edx+670]
pop edx

comiss xmm3,[inondations_critiques_avant]
xorps xmm3,xmm3
ja SHCollisions.act+443D //Détruit l'unité

//////////Partie arrière//////////
//Salles des machines (caché)
push edx
mov edx,["EffectManagers.act"+0000A1C0]
mov edx,[edx+34]
mov edx,[edx+3C]
movd xmm3,[edx+4C0]
//Salles des machines
addss xmm3,[edx+454]
//Salle de torpilles AR (caché)
addss xmm3,[edx+238]
//Salle de torpilles AR
addss xmm3,[edx+1CC]
pop edx

comiss xmm3,[inondations_critiques_arriere]
xorps xmm3,xmm3
ja SHCollisions.act+443D //Détruit l'unité



