[ENABLE]

aobscanmodule(INJECT,SHSim.act,BA F3 0F 10 02 0F 2E C2 9F F6 C4 44) // should be unique
alloc(newmem,$1000)

label(code)
label(return)
label(suivant)
label(restauration)

alloc(coef_un,4)
alloc(coef_deux,4)
alloc(saturation,4)

saturation:
dd (float)0

coef_un:
dd (float)1

coef_deux:
dd (float)2


newmem:
//Pointeur des cloisons
push ebx
mov ebx,[EffectManagers.act+0000A1C0]
mov ebx,[ebx+34]
mov ebx,[ebx+3C]

//Moteur diesel gauche
cmp [edx+D0],2
jne suivant

movd xmm6,[ebx+1C4] //Compartiment torpilles AR
addss xmm6,[ebx+44C] //Salles des machines
movss xmm5,[coef_deux]
divss xmm6,xmm5
movss xmm5,[coef_un]
subss xmm5, xmm6
//Saturation pour garantir k &gt;= 0
maxss xmm5,[saturation]
mulss xmm7, xmm5

jmp restauration


suivant:
//Moteur diesel gauche
cmp [edx+D0],0
jne restauration

movd xmm6,[ebx+EC] //Compartiment torpilles AV
addss xmm6,[ebx+668] //Salles de contrôle
movss xmm5,[coef_deux]
divss xmm6,xmm5
movss xmm5,[coef_un]
subss xmm5, xmm6
//Saturation pour garantir k &gt;= 0
maxss xmm5,[saturation]
mulss xmm7, xmm5


restauration:
xorps xmm5,xmm5
xorps xmm6,xmm6
pop ebx


code:
  ucomiss xmm0,xmm2
  lahf 
  test ah,44
  jmp return

INJECT+05:
  jmp newmem
  nop 2
return:
registersymbol(INJECT)

[DISABLE]

INJECT+05:
  db 0F 2E C2 9F F6 C4 44

unregistersymbol(INJECT)
dealloc(newmem)
dealloc(saturation)
dealloc(coef_un)
dealloc(coef_deux)

{
// ORIGINAL CODE - INJECTION POINT: SHSim.act+10357

SHSim.act+10332: F6 C4 44           - test ah,44
SHSim.act+10335: 7B 0D              - jnp SHSim.act+10344
SHSim.act+10337: F3 0F 10 7B 08     - movss xmm7,[ebx+08]
