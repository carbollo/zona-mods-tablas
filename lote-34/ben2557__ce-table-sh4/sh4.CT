          <AssemblerScript>{ Game   : sh4.exe
  Version: 
  Date   : 2025-03-16
  Author : benja

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(INJECT,sh4.exe,84 C0 88 44 24 10 74 3E) // should be unique
alloc(newmem,$1000)

label(code)
label(return)
label(drapeau_spotted)
label(drapeau_detected)
label(drapeaux_batteries)
label(drapeau_abandon)
label(drapeau_engaging)
label(drapeau_ramming)
label(drapeau_surface)
label(execution_detected)
label(execution_batteries)
label(execution_abandon)
label(execution_spotted)
label(execution_engaging)
label(execution_ramming_et_collision)
label(execution_surface)
label(restauration_detected)
label(restauration_batteries)
label(restauration_abandon)
label(restauration_spotted)
label(restauration_ramming_et_collision)
label(restauration_surface)
label(restauration_engaging)
label(suite)
label(suite2)
label(suite3)
label(message_suivant)
label(voix_suivante)
label(continue)
label(suivant_batteries)
label(batteries_dechargees)
label(message_batteries)
label(registre_batteries)
label(registre_abandon)
label(verif_distance)
label(suite_batteries)
label(message_batterie_50)

alloc(flag_detected,1)
alloc(flag_spotted,1)
alloc(flag_engaging,1)
alloc(flag_ramming,1)
alloc(flag_collision,1)
alloc(flag_surface,1)
alloc(flag_batteries_50,1)
alloc(flag_batteries_0,1)
alloc(flag_abandon,1)
alloc(flag_vitesse_max,1)

alloc(eax_engaging,4)
alloc(eax_ramming,4)
alloc(eax_surface,4)
alloc(ecx_engaging,4)
alloc(ecx_ramming,4)
alloc(ecx_surface,4)
alloc(edx_engaging,4)
alloc(edx_ramming,4)
alloc(edx_surface,4)

alloc(distance_ramming,4)
alloc(distance_collision,4)
alloc(vitesse_max,4)
alloc(ref_profondeur,4)
alloc(mort_joueur,4)
alloc(inondations_max,4)
alloc(delai,4)

delai:
dd (float)29

mort_joueur:
dd (float)0

inondations_max:
dd (float)1.5

distance_ramming:
dd (float)300

distance_collision:
dd (float)500

vitesse_max:
dd (float)1

ref_profondeur:
dd (float)12



newmem:
//Si le joueur est détecté (déclencheur)
cmp eax,1
je execution_detected

//Si le joueur est attaqué (déclencheur)
cmp esp,0019EFF0
je execution_engaging

//Si le joueur est éperonné (déclencheur)
cmp esp,0019EFE0
je execution_ramming_et_collision
cmp esp,0019F020 //Entités terrestres
je SHSim.act+24A69

//Si le joueur est en plongé (déclencheur)
cmp esp,0019F0A4
je execution_surface



/////////////////// Voix "We've been spotted sir" ///////////////////

execution_spotted:
//Si musiques de tension
push eax
mov eax,[sh4.exe+001F2E28]
mov eax,[eax+8]
mov eax,[eax+38]
mov eax,[eax+1B8]
cmp eax,3
pop eax
jne restauration_spotted

drapeau_spotted:
// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_spotted],1
je execution_batteries //Suite des événements

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_spotted],1

//Message "Nous sommes repérés !"
push 00000254
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

//Voix "We've been spotted sir"
push sh4.exe+1C57F0
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

jmp execution_batteries //Suite des événements


restauration_spotted:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_spotted],0
//Nécessaire car zone de mémoire peu dynamique
mov byte ptr [flag_engaging],0


jmp execution_batteries //Suite des événements



/////////////////// Voix "We have to surface sir" ///////////////////

execution_surface:
//Si le joueur est en surface
push edi
mov edi,["sh4.exe"+0020A39C]
mov edi,[edi+4]
mov edi,[edi+58]
movd xmm3,edi
pop edi
comiss xmm3,[ref_profondeur]
xorps xmm3,xmm3
jb restauration_surface

//Pointeur de base des inondations
push eax
mov eax,[EffectManagers.act+0000A1C0]
mov eax,[eax+34]
mov eax,[eax+3C]
//Inondations des compartiments
movd xmm2,[eax+1CC]
addss xmm2,[eax+454]
addss xmm2,[eax+670]
addss xmm2,[eax+598]
addss xmm2,[eax+F4]
pop eax
comiss xmm2,[inondations_max]
xorps xmm2,xmm2
ja drapeau_surface

//pointeur des points de vie du joueur
push edx
mov edx, [EffectManagers.act+0000A180]
movss xmm3, [edx+D4]
pop edx
comiss xmm3, [mort_joueur]
xorps xmm3,xmm3
ja restauration_surface


drapeau_surface:
// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_surface],1
je EffectManagers.act+3FB3

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_surface],1

mov [eax_surface],eax
mov [ecx_surface],ecx
mov [edx_surface],edx

//Message "Nous devons faire surface !"
push 00001138
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

//Voix "We have to surface sir"
push sh4.exe+1C568C
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

mov eax,[eax_surface]
mov ecx,[ecx_surface]
mov edx,[edx_surface]

jmp EffectManagers.act+3FB3


restauration_surface:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_surface],0

jmp EffectManagers.act+3FB3



/////////////////// Voix "Enemy ship is ramming us sir" ///////////////////
//////////////// Voix "Enemy ship on collision course sir" ////////////////

execution_ramming_et_collision:
//Si musiques de tension
push eax
mov eax,[sh4.exe+001F2E28]
mov eax,[eax+8]
mov eax,[eax+38]
mov eax,[eax+1B8]
cmp eax,3
pop eax
jne restauration_ramming_et_collision

//Si le joueur est en surface
push edi
mov edi,["sh4.exe"+0020A39C]
mov edi,[edi+4]
mov edi,[edi+58]
movd xmm6,edi
pop edi
comiss xmm6,[ref_profondeur]
xorps xmm6,xmm6
ja SHSim.act+24A69

//30 secondes de délai (exclut les avions)
movss xmm6,[delai]
comiss xmm6,[sh4.exe+1E5004]
xorps xmm6,xmm6
ja verif_distance
mov byte ptr [flag_vitesse_max],0

verif_distance:
//Exécuter si distance à l'unité inférieure à &lt;distance_collision&gt;
comiss xmm0,[distance_collision]
ja SHSim.act+24A69

//Si l'unité se déplace rapidement (avions)
movss xmm6,[edi+0000009C] //Distance initiale
subss xmm6,xmm0 //xmm0 = Distance finale
comiss xmm6,[mort_joueur] //Si l'unité s'éloigne
jbe SHSim.act+24A69
comiss xmm6,[vitesse_max] //Si trop rapide
jb drapeau_ramming

//Avions passés
mov byte ptr [flag_vitesse_max],1


drapeau_ramming:
//Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_vitesse_max],1
je SHSim.act+24A69

//Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_ramming],1
je SHSim.act+24A69
//Si distance est entre [distance_ramming] et [distance_collision]
comiss xmm0,[distance_ramming]
jbe continue
cmp byte ptr [flag_collision],1
je SHSim.act+24A69


continue:
//Drapeau suivant si distance à l'unité inférieure à &lt;distance_ramming&gt;
comiss xmm0,[distance_ramming]
ja drapeau_suivant
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_ramming],1
jmp suite

drapeau_suivant:
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_collision],1

suite:
mov [eax_ramming],eax
mov [ecx_ramming],ecx
mov [edx_ramming],edx

comiss xmm0,[distance_ramming]
ja message_suivant
//Message "Le navire ennemi nous éperonne !"
push 0000025E
jmp suite2

message_suivant:
//Message "Il arrive droit sur nous !"
push 0000025D

suite2:
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

comiss xmm0,[distance_ramming]
ja voix_suivante
//Voix "Enemy ship is ramming us sir"
push sh4.exe+1C5794
jmp suite3

voix_suivante:
//Voix "Enemy ship on collision course sir"
push sh4.exe+1C5770

suite3:
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

mov eax,[eax_ramming]
mov ecx,[ecx_ramming]
mov edx,[edx_ramming]

jmp SHSim.act+24A69


restauration_ramming_et_collision:
xorps xmm6,xmm6
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_ramming],0
mov byte ptr [flag_collision],0

jmp SHSim.act+24A69



/////////////////// Voix "Enemy ship engaging us sir" ///////////////////

execution_engaging:
//Si musiques de tension
push eax
mov eax,[sh4.exe+001F2E28]
mov eax,[eax+8]
mov eax,[eax+38]
mov eax,[eax+1B8]
cmp eax,3
pop eax
jne restauration_engaging

drapeau_engaging:
// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_engaging],1
je SHCollisions.act+1651

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_engaging],1

mov [eax_engaging],eax
mov [ecx_engaging],ecx
mov [edx_engaging],edx


//Message "Le navire ennemi nous attaque !"
push 00000257
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

//Voix "Enemy ship engaging us sir"
push sh4.exe+1C57D4
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

mov eax,[eax_engaging]
mov ecx,[ecx_engaging]
mov edx,[edx_engaging]

jmp SHCollisions.act+1651


restauration_engaging:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_engaging],0

jmp SHCollisions.act+1651


/////////////////// Voix "We have been detected sir" ///////////////////

execution_detected:
//Si musiques de bataille
push eax
mov eax,[sh4.exe+001F2E28]
mov eax,[eax+8]
mov eax,[eax+38]
mov eax,[eax+1B8]
cmp eax,2
pop eax
jne restauration_detected

drapeau_detected:
// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_detected],1
je SHSim.act+2ECBE

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_detected],1

push eax
push ecx
push edx
mov edi,edx

//Message "Nous avons été détectés !"
push 00001EDF
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

//Voix "We have been detected sir"
push sh4.exe+1C5808
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

pop eax
pop ecx
pop edx


mov edx,edi
mov eax,1
jmp SHSim.act+2ECBE

restauration_detected:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_detected],0


jmp SHSim.act+2ECBE


/////////////////// Voix "Batteries down to 50" ///////////////////
///////////////// Voix "Batteries discharged sir" /////////////////

execution_batteries:
//Restaurer si les batteries &gt; 50%
push edx
mov edx,[sh4.exe+001F417C]
cmp edx,0 //Évite les plantages pendant les chargements
je registre_batteries
mov edx,[edx+A4]
cmp byte ptr [flag_abandon],1   //Si les PDV &lt;= 0
je drapeaux_batteries
cmp edx,0 //Évite le dialogue en tout début de mission
je registre_batteries
cmp edx,(float)0.5
ja restauration_batteries


drapeaux_batteries:
pop edx
// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_batteries_0],1
je execution_abandon //Suite des événements


//Continuer si les batteries &lt; 5%
push edx
mov edx,[sh4.exe+001F417C]
mov edx,[edx+A4]
cmp edx,(float)0.05
pop edx
jbe message_batteries

// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_batteries_50],1
je execution_abandon //Suite des événements


message_batteries:
//Si les batteries &gt; 5%
push edx
mov edx,[sh4.exe+001F417C]
mov edx,[edx+A4]
cmp edx,(float)0.05
pop edx
ja message_batterie_50

//Message du fichier audio
push 00001EE6 //batteries déchargées
jmp suite_batteries

message_batterie_50:
push 00001EE5 //Batteries à moins de 50%

suite_batteries:
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

//Voix "Batteries down to 50"
//Voix "Batteries discharged"
push edx
mov edx,[sh4.exe+001F417C]
mov edx,[edx+A4]
cmp edx,(float)0.05 //Autre voix si les batteries sont déchargées
pop edx
jbe batteries_dechargees


//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_batteries_50],1
push sh4.exe+1D8520 //Voix pour "50%"
jmp suivant_batteries

batteries_dechargees:
//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_batteries_0],1
push sh4.exe+1D8580 //Voix pour "déchargés"


suivant_batteries:
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

jmp execution_abandon //Suite des événements



restauration_batteries:
pop edx
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_batteries_0],0
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_batteries_50],0

jmp execution_abandon //Suite des événements


registre_batteries:
pop edx




/////////////////// Voix "Abandon ship" ///////////////////

execution_abandon:
//Ne pas restaurer si les points de vie du joueur &lt;= 0
push edx
mov edx,[EffectManagers.act+0000A180]
cmp edx,0 //Évite les plantages pendant les chargements
je registre_abandon
movss xmm3,[edx+D4]
comiss xmm3,[mort_joueur]
xorps xmm3,xmm3
pop edx
ja restauration_abandon

//Zone arrière
push ebx
mov ebx,[EffectManagers.act+0000A1C0]
mov ebx,[ebx+34]
mov ebx,[ebx+3C]
mov ebx,[ebx+27C]
cmp ebx,(float)0 //0 = zone détruite, 1 = zone intacte
pop ebx

jne code

//Zone avant
push ebx
mov ebx,[EffectManagers.act+0000A1C0]
mov ebx,[ebx+34]
mov ebx,[ebx+3C]
mov ebx,[ebx+1A4]
cmp ebx,(float)0 //0 = zone détruite, 1 = zone intacte
pop ebx

jne code



drapeau_abandon:
// Vérifier si le drapeau est déjà défini
cmp byte ptr [flag_abandon],1
je code

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag_abandon],1


//Message "Abandonner le navire"
push 00001EE4
mov ecx,sh4.exe+1F20C8
call sh4.exe+16700
push 00
push 01
push eax

//Voix "Abandon ship"
push sh4.exe+1D85C0
push 00
call sh4.exe+DE4F0
push eax
call sh4.exe+150F30
add esp,18

jmp code


restauration_abandon:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag_abandon],0

jmp code


registre_abandon:
pop edx



