[ENABLE]

aobscanmodule(INJECT,SHSim.act,F3 0F 59 41 0C) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

label(multiplicateur)
label(annulation)

alloc(ref_profondeur_min,4)
alloc(ref_profondeur_max,4)
alloc(ecart,4)
alloc(fltcomroom,4)
alloc(fltcomroom2,4)
alloc(flttorprmfront,4)
alloc(flttorprmfront2,4)
alloc(flttorprmstern,4)
alloc(flttorprmstern2,4)
alloc(fltengineroom,4)
alloc(fltengineroom2,4)
alloc(mort_joueur,4)

mort_joueur:
dd (float)0

ref_profondeur_max:
dd (float)15

ref_profondeur_min:
dd (float)7

//Ecart est lié à la différence ref_profondeur_max - ref_profondeur_min
ecart:
dd (float)8

fltcomroom:
dd (float)0.086
//dd (float)0.0856

fltcomroom2:
dd (float)0.3144

flttorprmfront:
dd (float)0.1024

flttorprmfront2:
dd (float)0.3976

flttorprmstern:
dd (float)0.0414

flttorprmstern2:
dd (float)0.1586

fltengineroom:
dd (float)0.2164

fltengineroom2:
dd (float)0.1336

Attackcenter:
dd (float)0.065


newmem:

//Profondeur actuelle
push edi
mov edi,["sh4.exe"+0020A39C]
mov edi,[edi+4]
mov edi,[edi+58]

movd xmm3,edi


//Registre de base pour la flotabilité
push ebx
mov ebx,["sh4.exe"+001F521C]
cmp ebx,0 //Empêche le plantage à chaque chargement
je restauration
mov ebx,[ebx+124]
mov ebx,[ebx+20]
mov ebx,[ebx+168]


//pointeur des points de vie du joueur
push edx
mov edx, [EffectManagers.act+0000A180]
movss xmm6, [edx+D4]
comiss xmm6, [mort_joueur]
pop edx
jbe mort


//Annulation de flotabilité des compartiments cachés
cmp [ecx+C],(float)0.1585999876
je annulation
cmp [ecx+C],(float)0.3975999653
je annulation
cmp [ecx+C],(float)0.1335999966
je annulation
cmp [ecx+C],(float)0.3143999875
je annulation
cmp [ecx+C],(float)0.3999999762
je annulation


//Flotabilité salle de torpilles AR
comiss xmm3,[ref_profondeur_max]
jb multiplicateur
movss xmm6,[flttorprmstern]
movss [ebx+34],xmm6

//Flotabilité salles des machines
comiss xmm3,[ref_profondeur_max]
jb multiplicateur
movss xmm6,[fltengineroom]
movss [ebx+5C],xmm6

//Flotabilité salle de contrôle
comiss xmm3,[ref_profondeur_max]
jb multiplicateur
movss xmm6,[fltcomroom]
movss [ebx+84],xmm6

//Flotabilité du kiosque
comiss xmm3,[ref_profondeur_max]
jb multiplicateur
movss xmm6,[Attackcenter]
movss [ebx+AC],xmm6

//Flotabilité salle de torpilles AV
comiss xmm3,[ref_profondeur_max]
jb multiplicateur
movss xmm6,[flttorprmfront]
movss [ebx+C],xmm6

jmp restauration


mort:
movss xmm6,[flttorprmstern]
addss xmm6,[flttorprmstern2]
movss [ebx+34],xmm6

movss xmm6,[fltengineroom]
addss xmm6,[fltengineroom2]
movss [ebx+5C],xmm6

movss xmm6,[fltcomroom]
addss xmm6,[fltcomroom2]
movss [ebx+84],xmm6

movss xmm6,[Attackcenter]
addss xmm6,[Attackcenter]
movss [ebx+AC],xmm6

movss xmm6,[flttorprmfront]
addss xmm6,[flttorprmfront2]
movss [ebx+C],xmm6

jmp restauration


multiplicateur:

//Salle de torpilles AR
movss xmm6,[flttorprmstern]
comiss xmm3,[ref_profondeur_min]
ja coef1

addss xmm6,[flttorprmstern2]
jmp stockage1

coef1:
movss xmm2,[ref_profondeur_max]
subss xmm2,xmm3
movss xmm4,[ecart]
divss xmm2,xmm4
mulss xmm2,[flttorprmstern2]
addss xmm6,xmm2

stockage1:
movss [ebx+34],xmm6


//Salles des machines
movss xmm6,[fltengineroom]
comiss xmm3,[ref_profondeur_min]
ja coef2

addss xmm6,[fltengineroom2]
jmp stockage2

coef2:
movss xmm2,[ref_profondeur_max]
subss xmm2,xmm3
movss xmm4,[ecart]
divss xmm2,xmm4
mulss xmm2,[fltengineroom2]
addss xmm6,xmm2

stockage2:
movss [ebx+5C],xmm6


//Salle de contrôle
movss xmm6,[fltcomroom]
comiss xmm3,[ref_profondeur_min]
ja coef3

addss xmm6,[fltcomroom2]
jmp stockage3

coef3:
movss xmm2,[ref_profondeur_max]
subss xmm2,xmm3
movss xmm4,[ecart]
divss xmm2,xmm4
mulss xmm2,[fltcomroom2]
addss xmm6,xmm2

stockage3:
movss [ebx+84],xmm6


//Kiosque
movss xmm6,[Attackcenter]
comiss xmm3,[ref_profondeur_min]
ja coef4

addss xmm6,[Attackcenter]
jmp stockage4

coef4:
movss xmm2,[ref_profondeur_max]
subss xmm2,xmm3
movss xmm4,[ecart]
divss xmm2,xmm4
mulss xmm2,[Attackcenter]
addss xmm6,xmm2

stockage4:
movss [ebx+AC],xmm6


//Salle de torpilles AV
movss xmm6,[flttorprmfront]
comiss xmm3,[ref_profondeur_min]
ja coef5

addss xmm6,[flttorprmfront2]
jmp stockage5

coef5:
movss xmm2,[ref_profondeur_max]
subss xmm2,xmm3
movss xmm4,[ecart]
divss xmm2,xmm4
mulss xmm2,[flttorprmfront2]
addss xmm6,xmm2

stockage5:
movss [ebx+C],xmm6


jmp restauration


annulation:
mov [ecx+C],(float)0


restauration:
pop ebx
pop edi



code:
  mulss xmm0,[ecx+0C]
  jmp return

INJECT:
  jmp newmem
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db F3 0F 59 41 0C

unregistersymbol(INJECT)
dealloc(newmem)
dealloc(ref_profondeur_min)
dealloc(ref_profondeur_max)
dealloc(ecart)
dealloc(fltcomroom)
dealloc(fltcomroom2)
dealloc(flttorprmfront)
dealloc(flttorprmfront2)
dealloc(flttorprmstern)
dealloc(flttorprmstern2)
dealloc(fltengineroom)
dealloc(fltengineroom2)
dealloc(mort_joueur)

{
// ORIGINAL CODE - INJECTION POINT: SHSim.act+AA20

SHSim.act+A9EE: 0F 2E 05 80 F8 FB 0A     - ucomiss xmm0,[SHSim.act+5F880]
