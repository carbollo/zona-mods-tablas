aobscanmodule(INJECT,SHCollisions.act,F3 0F 59 46 20 F3 0F 59) // should be unique
alloc(newmem,$1000)

label(code)
label(return)
label(suivant)

alloc(mort_joueur,4)
alloc(temps_inondations,4)
alloc(restauration,4)

mort_joueur:
dd (float)0

temps_inondations:
dd (float)0.008333340287

restauration:
dd (float)0.002777777845


newmem:

cmp [edi+18],(float)-1
jne code

cmp [edi+C],(float)0.008333340287
jne suivant
movss xmm0,[restauration]
movss [edi+C],xmm0


suivant:

//pointeur des points de vie du joueur
push edx
mov edx, [EffectManagers.act+0000A180]
movss xmm7, [edx+D4]
comiss xmm7, [mort_joueur]
pop edx
ja code

cmp [edi+C],(float)0.002777777845
jne code
movss xmm0,[temps_inondations]
movss [edi+C],xmm0



code:
  mulss xmm0,[esi+20]
  jmp return

INJECT:
  jmp newmem
return:
