[ENABLE]

aobscanmodule(INJECT,EffectManagers.act,F3 0F 10 4C 24 08) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

alloc(limite,4)
alloc(pdv_init,4)
alloc(pdv,4)

limite:
dd (float)2

newmem:

//Compartiment torpilles AR
push ebx
mov ebx,["EffectManagers.act"+0000A1C0]
mov ebx,[ebx+34]
mov ebx,[ebx+3C]
mov ebx,[ebx+1C4]
movd xmm5,ebx
pop ebx

//Salles des machines
push ecx
mov ecx,["EffectManagers.act"+0000A1C0]
mov ecx,[ecx+34]
mov ecx,[ecx+3C]
mov ecx,[ecx+44C]
movd xmm7,ecx
addss xmm5,xmm7
pop ecx

//Salle de contrôle
push edx
mov edx,["EffectManagers.act"+0000A1C0]
mov edx,[edx+34]
mov edx,[edx+3C]
mov edx,[edx+668]
movd xmm7,edx
addss xmm5,xmm7
pop edx

//Compartiment torpilles AV
push edi
mov edi,["EffectManagers.act"+0000A1C0]
mov edi,[edi+34]
mov edi,[edi+3C]
mov edi,[edi+EC]
movd xmm7,edi
addss xmm5,xmm7
pop edi

//Chargement des valeurs
movss xmm3,[eax+000000D4]
movss [pdv],xmm3
movss xmm3,[eax+000000D0]
movss [pdv_init],xmm3

divss xmm3,[limite]
mulss xmm3,xmm5
movss xmm5,[eax+000000D0]
subss xmm5,xmm3

movss [eax+000000D4],xmm5


//Restauration
xorps xmm5,xmm5
xorps xmm7,xmm7
xorps xmm3,xmm3


code:
  movss xmm1,[esp+08]
  jmp return

INJECT:
  jmp newmem
  nop
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db F3 0F 10 4C 24 08

unregistersymbol(INJECT)
dealloc(newmem)
dealloc(limite)
dealloc(pdv_init)
dealloc(pdv)

