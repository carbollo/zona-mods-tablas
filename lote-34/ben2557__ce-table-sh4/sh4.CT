[ENABLE]

aobscanmodule(INJECT,SHSim.act,55 56 8B E9 57 8B BD) // should be unique
alloc(newmem,$1000)

label(code)
label(return)
label(comptage)
label(restauration)

alloc(mort_joueur,4)
alloc(temps_depart,4)
alloc(attente,4)
alloc(flag,1)

attente:
dd (float)5

mort_joueur:
dd (float)0

newmem:

//pointeur des points de vie du joueur
push edx
mov edx,[EffectManagers.act+0000A180]
movss xmm5,[edx+D4]
comiss xmm5, [mort_joueur]
xorps xmm5,xmm5
pop edx

ja restauration


//Pointeur de base des zones
push ebx
push edx
mov ebx,[EffectManagers.act+0000A1C0]
mov ebx,[ebx+34]
mov ebx,[ebx+3C]
//Zone arrière dans edx
mov edx,[ebx+27C]
//Zone avant dans ebx
mov ebx,[ebx+1A4]
//Combine les 2 zones
or ebx,edx
cmp ebx,(float)0 //0 = zone détruite, 1 = zone intacte
pop edx
pop ebx
jne code


//Temps avant affichage
push edi
mov edi,[SHControllers.act+00039388]
mov edi,[edi+0]
movss xmm5,[edi+1A4]
//Ne compte qu'une seule fois
cmp byte ptr [flag],1
je comptage

//Définir le drapeau à 1 (exécuté)
mov byte ptr [flag],1
movss [temps_depart],xmm5

comptage:
movss xmm6,[temps_depart]
addss xmm6,[attente]
comiss xmm5,xmm6
pop edi
xorps xmm5,xmm5
xorps xmm6,xmm6
jb code


// Contrôleur IA
jmp SHSim.act+2A210


restauration:
//Définir le drapeau à 0 (non exécuté)
mov byte ptr [flag],0

code:
  push ebp
  push esi
  mov ebp,ecx
  push edi
  jmp return

INJECT:
  jmp newmem
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 55 56 8B E9 57

unregistersymbol(INJECT)
dealloc(newmem)
dealloc(mort_joueur)
dealloc(temps_depart)
dealloc(attente)
dealloc(flag)

