push 00001EDC
jmp return


suivant3:
push edi
mov edi,[EffectManagers.act+0000A180]
mov edi,[edi+1C4]
cmp edi,2
pop edi
jne code

//Détruit suite à dégâts critiques.
push 00001EDE
jmp return


