[ENABLE]

aobscanmodule(INJECT,SHCollisions.act,0F 82 87 00 00 00) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

alloc(inondations_critiques_avant,4)
alloc(inondations_critiques_arriere,4)

inondations_critiques_avant:
dd (float)2.5

inondations_critiques_arriere:
dd (float)3.99


newmem:

//Ne concerne que le joueur
cmp [ebx+E0],(float)2
jne code

//////////Partie avant//////////
//Salle de torpilles AV
push edx
mov edx,["EffectManagers.act"+0000A184]
mov edx,[edx+54]
mov edx,[edx+3C]
