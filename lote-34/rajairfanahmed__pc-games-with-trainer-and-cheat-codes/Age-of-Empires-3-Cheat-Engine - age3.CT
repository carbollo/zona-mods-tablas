<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Age of Empires 3  Script AOB"</Description>
      <LastState Activated="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{
===========================================
 Age of Empires III
 Game Version  : 1.00 - 1.13
 Script Version: 1.0
 CE Version    : 5.6
 GodMode, Resources
 24-Jul-2008 V1.0
 06-Oct-2010 AOB Version
===========================================
}

[ENABLE]
//=========================================
alloc(MyCode,1024)
//=========================================

aobscan(aobGodMode,8b 97 a8 00 00 00 89 4f 64)  // ok
aobscan(aobMonResource,33 04 8a 89 44 24 14 d9 44 24 14) // ok
aobscan(aobMonPlayer,8b 11 8b 4c 24 20 52 8b 90 c0 00 00 00) //ok

//=========================================
// Declaration section
label(pGodMode)
label(pMonResource)
label(pMonPlayer)
label(_GodMode)
label(_GodM1)
label(_BackGM)
label(_ExitGM)
label(_MonResource)
label(_MonR1)
label(_BackMR)
label(_ExitMR)
label(_MonPlayer)
label(_BackMP)
label(_ExitMP)
label(iPlayerID)
label(pResource)
label(pPlayer)
label(pLastOne)
label(iEnableGM)
label(iEnableMR)

registersymbol(MyCode)
registersymbol(pLastOne)
registersymbol(pResource)
registersymbol(pPlayer)
registersymbol(iPlayerID)
registersymbol(iEnableGM)
registersymbol(iEnableMR)
registersymbol(pGodMode)
registersymbol(pMonResource)
registersymbol(pMonPlayer)

//=========================================
MyCode:
//=========================================
_GodMode:
 mov [pLastOne],edi             // Save structure address for debugging

 cmp dword ptr [iEnableGM],0
 je _ExitGM                     // Jump if feature is disabled

 mov edx,[edi+44]               // Read ptr to Player ID 
 or edx,edx                     // Valid Ptr?
 jz _ExitGM                     // Jump if false

 mov edx,[edx]                  // Read Player ID
 cmp edx,[iPlayerID]            // Player�s? 
 jne _ExitGM                    // Jump if false

 mov eax,[edi+64]               // Read current HP
 cmp eax,[esp+14]               // Current HP &lt;= New HP?
 jle _GodM1                     // Jump if true

 mov [esp+14],eax               // Update stack with current HP

_GodM1:
 mov ecx,[esp+14]               // Read new HP

_ExitGM:
 mov edx,[edi+000000a8]         // Original code
 jmp _BackGM                    // Back to main code

//=========================================
// Minimum Resource = 15000
_MonResource:
 push ebx                       // Save EBX

 cmp dword ptr [iEnableMR],0
 je _ExitMR                     // Jump if feature is disabled

 cmp edx,[pResource]            // Is it the player�s?
 jne _MonR1                     // Jump if false

 cmp ecx,3                      // Is it coin, wood or food? 
 jge _MonR1                     // Jump if false

 mov ebx,eax                    // Save encription
 xor eax,[edx+ecx*4]            // Decript resource

 cmp eax,466a6000               // Greater than 15000?
 jge _ExitMR                    // Jump if true

 mov eax,466a6000               // Make eax = 15000
 xor eax,ebx                    // Encript resource
 mov [edx+ecx*4],eax            // Update resource

 mov eax,ebx                    // Restore encription

_MonR1:
 xor eax,[edx+ecx*4]            // Decript resource

_ExitMR:
 pop ebx                        // Restore EBX
 mov [esp+14],eax               // Original code
 jmp _BackMR                    // Back to main code

//=========================================
// Monitor player structure address
_MonPlayer:
 mov edx,[ecx]                  // Read ID
 cmp edx,[iPlayerID]            // Is it the player�s?
 jne _ExitMP                    // Jump if false

 mov edx,[ecx+00000210]         // Read ptr to resource

 mov [pResource],edx            // Save ptr to further use
 mov [pPlayer],ecx              // Save player struct address for debugging

 mov edx,[ecx]                  // Read ID

_ExitMP:
 mov ecx,[esp+20]               // Original code
 jmp _BackMP                    // Back to main code

//=========================================
// Variables
pLastOne:
 dd 0
pResource:
 dd 0
pPlayer:
 dd 0
iEnableGM:
 dd 1
iEnableMR:
 dd 1
iPlayerID:
 dd 1

//=========================================
// Hacking Points
//age3.exe+33C2E:
aobGodMode:
pGodMode:
 jmp _GodMode
 nop
_BackGM:

//age3.exe+5E51:
aobMonResource:
pMonResource:
 jmp _MonResource
 nop
 nop
_BackMR:

//age3.exe+39e5c:
aobMonPlayer:
pMonPlayer:
 jmp _MonPlayer
 nop
_BackMP:

//=========================================
// Original Codes
[DISABLE]
//age3.exe+33C2E:
pGodMode:
 mov edx,[edi+000000a8]
  
//age3.exe+5E51:
pMonResource:
 xor eax,[edx+ecx*4]
 mov [esp+14],eax
 
//age3.exe+39e5c:
pMonPlayer:
 mov edx,[ecx]
 mov ecx,[esp+20]
 
unregistersymbol(MyCode)
unregistersymbol(pLastOne)
unregistersymbol(iPlayerID)
unregistersymbol(pResource)
unregistersymbol(pPlayer)
unregistersymbol(iEnableGM)
unregistersymbol(iEnableMR)
unregistersymbol(pGodMode)
unregistersymbol(pMonResource)
unregistersymbol(pMonPlayer)

dealloc(MyCode)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Enable/Disable God Mode"</Description>
      <LastState Value="0" RealAddress="064500CF"/>
      <VariableType>4 Bytes</VariableType>
      <Address>iEnableGM</Address>
    </CheatEntry>
    <CheatEntry>
      <ID>2</ID>
      <Description>"Enable/Disable Unlimited Resources"</Description>
      <LastState Value="1" RealAddress="064500D3"/>
      <VariableType>4 Bytes</VariableType>
      <Address>iEnableMR</Address>
    </CheatEntry>
    <CheatEntry>
      <ID>6</ID>
      <Description>"Infinite Population"</Description>
      <LastState Activated="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// 1. DYNAMIC SIGNATURE SCAN
// We scan the age3.exe module for the exact byte signature of our target math.
aobscanmodule(PopulationHook,age3.exe,89 46 50 5E 83 C4 08)
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

// 2. REGISTER THE SYMBOL
// This allows the Disable section to know exactly where the hook was placed.
registersymbol(PopulationHook)

newmem:
// 3. THE ZERO-SUM OVERRIDE
// Wipe the population count to 0.
mov eax, 0

originalcode:
// 4. ENGINE RESTORATION
mov [esi+50],eax
pop esi
add esp,08

exit:
jmp returnhere

// 5. THE DYNAMIC HOOK
PopulationHook:
jmp newmem
nop 2
returnhere:


[DISABLE]
dealloc(newmem)
// 6. CLEAN UNINJECTION
// We use the registered symbol to cleanly restore the exact bytes.
PopulationHook:
db 89 46 50 5E 83 C4 08
// mov [esi+50],eax
// pop esi
// add esp,08

unregistersymbol(PopulationHook)
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
</CheatTable>
