  mov eax,[rcx+rbp+12f034]
  jmp return
_pBase:
  jmp newmem
  nop 2
return:
[DISABLE]
dealloc(*)
unregistersymbol(*)
_pBase:
  db 8B 84 29 34 F0 12 00
</AssemblerScript>
