<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>13</ID>
      <Description>"Infinite Ammo (Rifle and Pistol)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)

newmem:
// 1. We completely bypass the instruction that writes the reduced reserve ammo to memory.
// The processor calculates the deduction natively, but we discard the result.
// Your reserve ammunition remains untouched at its engine default.
// mov [eax+edi*4+00000134],edx

jmp returnhere

iw3sp.exe+1BFB34:
jmp newmem
nop 2
returnhere:


[DISABLE]
dealloc(newmem)
iw3sp.exe+1BFB34:
db 89 94 B8 34 01 00 00
//mov [eax+edi*4+00000134],edx
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>14</ID>
      <Description>"Infinite (Flashbang, Grenade)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)

newmem:
// 1. DYNAMIC EXECUTION FILTER
// We compare the EBP register to the EDI register (Player Base).
// If they do not match, this is a Primary Weapon (like the Javelin).
// We skip the cheat completely to protect the weapon's internal mechanics.
cmp ebp,edi
jne originalcode

// 2. OFFHAND VERIFICATION
// If we reach this line, the registers matched perfectly.
// It is mathematically verified as an Offhand Throwable (Frag, Flash, C4).
// We allow the grenade count (EAX) to drop natively until it attempts to hit 0.
cmp eax,00
jg originalcode

// 3. RESTOCK TRIGGER
// Intercept the 0 and forcefully restock the throwable to 4.
mov eax,(int)4

originalcode:
// 4. Global Engine Write Command
mov [edi+ecx*4+00000334],eax
jmp returnhere

iw3sp.exe+1BFCB9:
jmp newmem
nop 2
returnhere:


[DISABLE]
dealloc(newmem)
iw3sp.exe+1BFCB9:
db 89 84 8F 34 03 00 00
//mov [edi+ecx*4+00000334],eax
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>22</ID>
      <Description>"Infinite Health"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem,2048)
label(returnhere)
label(originalcode)

newmem:
// 1. FLAWLESS ENTITY FILTER
// EBP is confirmed to statically be 00C81418 for your player entity.
// If it is an enemy, we skip to originalcode and let them die normally.
cmp ebp,00C81418
jne originalcode

// 2. THE "BLOOD BUT NO DEATH" LOGIC
// EDX contains your new health after taking bullet, grenade, or car damage.
// We check if this damage brings your health down to 1 or higher.
cmp edx,01
jge originalcode // If your health is 1+, let it save. This gives you blood and flinch!

// 3. THE LETHAL DAMAGE INTERCEPTOR
// If a grenade, car explosion, or bullet drops your health to 0 or negative,
// we intercept the death and instantly restock your health to 100.
mov edx,(int)100

originalcode:
// 4. Save the final health value to memory
mov [ebp+00000144],edx

// 5. THE CRASH FIX: CPU FLAG RECONSTRUCTION
// We must manually execute the engine's test command right before we leave.
// This perfectly restores the EFLAGS register so the game's next 'je' jump succeeds.
test edi,edi

jmp returnhere

iw3sp.exe+AE8DE:
jmp newmem
nop
returnhere:


[DISABLE]
dealloc(newmem)
iw3sp.exe+AE8DE:
db 89 95 44 01 00 00
//mov [ebp+00000144],edx
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
