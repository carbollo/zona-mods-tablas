fX:
dd (float)2.0
fZ:
dd (float)4.0
fDouble:
dd (float)2.0

align 10 CC

ACOrigins.exe+2BD3879: // patch Bayek input controller
db EB

ACOrigins.exe+15BD314: // detach camera
db 90 90 90 90

ACOrigins.exe+1480853: // render to camera A
jmp RenderToCamera_A
db 90 90
back_A:

ACOrigins.exe+1480873: // render to camera B
jmp RenderToCamera_B
db 90 90
back_B:

