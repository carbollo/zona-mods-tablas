          <AssemblerScript>[ENABLE]
aobscanmodule(EStoreGetItem, ACOrigins.exe, 48 89 5C 24 08 57 48 83 EC 20 48 8B D9 E8 ?? ?? ?? FF 41 B9)
registersymbol(EStoreGetItem)
label(EStoreGetItem_ret)

aobscanmodule(EStoreResync, ACOrigins.exe, 44 8B 8B 08 03 00 00 48 8D 8F C8 04 00 00 48 8B 53 40)
registersymbol(EStoreResync)
label(EStoreResync_ret)

label(inject_EStoreGetItem)
label(code_EStoreGetItem)
registersymbol(code_EStoreGetItem)

label(inject_EStoreResync)
label(code_EStoreResync)
registersymbol(code_EStoreResync)

alloc(newmem,0x1000,EStoreGetItem)

label(dqNewItemHash)
registersymbol(dqNewItemHash)

newmem:
  inject_EStoreGetItem:
    push rax
      mov rax, [dqNewItemHash]
      mov [rcx+40], rax  //inline hash replacement
    pop rax
  code_EStoreGetItem: //original code
      mov [rsp+08],rbx
      push rdi
      sub rsp,20
      mov rbx,rcx
      reassemble(EStoreGetItem+0x0D) //call 14212CC10
    jmp EStoreGetItem+0x12//EStoreGetItem_ret

  inject_EStoreResync:
    push rax
    push rcx
      mov rax,[rdi+0x4C8]    //[[[rdi+4c8]+70]+8]  &lt;- [dqNewItemHash] // pEStoreItemsList
      mov rax,[rax+0x70]
      mov rax,[rax+0x8]
      mov rcx,[dqNewItemHash]
      mov [rax],rcx
      mov dword ptr [rax+0C],1
    pop rcx
    pop rax
  code_EStoreResync: //original code
    mov r9d,[rbx+00000308]
    lea rcx,[rdi+000004C8]
  jmp EStoreResync+0x0E //EStoreResync_ret

dqNewItemHash:
    dq 0

EStoreResync:
    jmp inject_EStoreResync
EStoreResync_ret:

EStoreGetItem:
    jmp inject_EStoreGetItem
EStoreGetItem_ret:

[DISABLE]
EStoreGetItem: {0x12 bytes}
    mov [rsp+08],rbx
    push rdi
    sub rsp,20
    mov rbx,rcx
    reassemble(code_EStoreGetItem+0x0D) //call 14212CC10 //1.21
EStoreResync: {0x0E bytes}
     mov r9d,[rbx+00000308]
     lea rcx,[rdi+000004C8]

unregistersymbol(EStoreGetItem)
unregistersymbol(EStoreGetItem)
unregistersymbol(dqNewItemHash)
unregistersymbol(code1)
dealloc(inject)
</AssemblerScript>
