                <CheatEntry>
                  <ID>435</ID>
                  <Description>"Unlimited Chariot Boost"</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>define( Hook, GameModule+8E0 )

[ENABLE]

aobscanmodule( ChariotBoost_AOB, ACOrigins.exe, F682????????4074??B001EB )
label( ChariotBoost )
registersymbol( ChariotBoost )

Hook:
push rax
push rcx
push rdx
push r8
mov rax,[rdx+30] // rax here is the WheeledVehicleActor structure (the structure with the Boost)
lea rcx,[rdx+30]
call qword ptr [rax+30]
test rax,rax // result here is Entity (our player entity attached to the vehicle)
je short @f
  mov eax,[rax+15C] // get player_id
  and al,7
  cmp al,1 // oponent entity has 0x2
  jne short @f
    /* &lt; add your shit here &gt; */
    mov rdx,[rsp+8]
    mov byte ptr [rdx+AD],2 // unlimited boost
@@:
pop r8
pop rdx
pop rcx
pop rax
@@:
test byte ptr [rdx+AC],40 // original
jmp ChariotBoost+7

align 10 CC

ChariotBoost_AOB:
ChariotBoost:
jmp Hook
db 90 90

[DISABLE]

ChariotBoost:
db F6 82 AC 00 00 00 40

unregistersymbol( ChariotBoost )

