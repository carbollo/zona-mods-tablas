mov rsi,[rsi+C0]
lea rdx,[rsi+1438]
mov rsi,[rsi+13C8]
lea rsi,[rsi+58]
//lea rsi,[15BA8CCE8]
cmp rsi,rdi
jne short @f
  pop rdx
  pop rsi
  pop rdi
  movss xmm1,[fModifier]
  movss [rdi+18],xmm1
  jmp back
@@:
cmp rdi,rdx
jne short @f
  pop rdx
  pop rsi
  pop rdi
  movss xmm1,[fModifier]
  movss [rdi+18],xmm1
  jmp back
@@:
