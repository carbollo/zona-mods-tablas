            <CheatEntry>
              <ID>22321</ID>
              <Description>"Free Fly Camera"</Description>
              <Options moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <Color>000000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>globalalloc(speedmult,4)
speedmult:
dd 0

{$lua}

[ENABLE]

function checkKeys(timer)

-- add local variables related to actual addresses
local camx = readFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60") -- Camera X
local camy = readFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64") -- Camera Y
local camz = readFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68") -- Camera Z
local radh = readFloat("[[[[ACOrigins.exe+4B18798]+A8]+0]+340]+C4") -- Horiz Rad
local radv = readFloat("[[[[ACOrigins.exe+4B18798]+A8]+0]+340]+CC") -- Vertical Rad
----local SunBeam = readFloat("[pWorld] + 1458") -- SunBeam Cheat
local mult = readFloat("speedmult") -- add multipleir

-- check for NULL
if radh == nil then -- check if radh or radv value is NULL
  timer_setEnabled(t, false) -- if yes, then stop timer
end

if radv == nil then -- check if radh or radv value is NULL
  timer_setEnabled(t, false) -- if yes, then stop timer
end

----if SunBeam == nil then -- check if SunBeam cheat run
----  print("Run Main Cheat first")
----  timer_setEnabled(t, false) -- if yes, then stop timer
----end

-- calculate sin and cos value of rotations
local sinh = math.sin(radh) -- calculate horizontal rotation sinus
local cosh = math.cos(radh) -- calculate horizontal rotation cosinus
local sinv = math.sin(radv) -- calculate vertical rotation sinus
local cosv = math.cos(radv) -- calculate vertical rotation cosinus

-- World Freeze
----local freeze = readBytes("[pWorld] + 1458")

----  if isKeyPressed(VK_T) then
----    sleep(200) -- small delay for avoid multiple 1-0-1-0-1...
----    if freeze == 0 then -- check if 0, than send 1
----      writeBytes("[pWorld] + 1458", 1) -- Freeze World
----    elseif freeze == 1 then -- check if 1, than send 0
----      writeBytes("[pWorld] + 1458", 0) -- unFreeze World
----    end
----  end

-- Movements Block

  if isKeyPressed(VK_LBUTTON) then  -- move Forward with Left Mouse Button
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx - ((sinh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy - ((cosh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz - (sinv * mult))
  elseif isKeyPressed(VK_W) then  -- or move Forward with W
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx - ((sinh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy - ((cosh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz - (sinv * mult))
  end

  if isKeyPressed(VK_RBUTTON) then  -- move Back with Right Mouse Button
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx + ((sinh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy + ((cosh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz + (sinv * mult))
  elseif isKeyPressed(VK_S) then  -- or move Back with S
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx + ((sinh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy + ((cosh * cosv) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz + (sinv * mult))
  end

  if isKeyPressed(VK_A) then  -- Move Left with A
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx + (cosh * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy - (sinh * mult))
  elseif isKeyPressed(VK_D) then  -- Move Right with D
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx - (cosh * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy + (sinh * mult))
  end

  if isKeyPressed(VK_W) and isKeyPressed(VK_D) then  -- move Forward-Right
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx - ((sinh + cosh) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy - ((cosh - sinh) * mult))
  end
  if isKeyPressed(VK_W) and isKeyPressed(VK_A) then  -- move Forward-Left
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx - ((sinh - cosh) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy - ((cosh + sinh) * mult))
  end
  if isKeyPressed(VK_S) and isKeyPressed(VK_D) then  -- move Back-Right
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx + ((sinh - cosh) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy + ((cosh + sinh) * mult))
  end
  if isKeyPressed(VK_S) and isKeyPressed(VK_A) then  -- move Back-Left
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+60", camx + ((sinh + cosh) * mult))
    writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+64", camy + ((cosh - sinh) * mult))
  end

  if isKeyPressed(VK_R) then  -- Move Up
   writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz + (mult * 0.5))
  elseif isKeyPressed(VK_SPACE) then  -- Move Up
   writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz + (mult * 0.5))
  elseif isKeyPressed(VK_F) then  -- Move Down
   writeFloat("[[[ACOrigins.exe+4B18798]+A8]+0]+68", camz - (mult * 0.5))
  end

  -- multiplier setup
  if isKeyPressed(VK_SHIFT) then
   writeFloat("speedmult", readFloat("speedmult") + 0.01) -- hold Shift for feep incresing speed
  elseif isKeyPressed(VK_CONTROL) then
   writeFloat("speedmult", 0.01) -- Hold Ctrl for slow speed move
  else
   writeFloat("speedmult", 0.15) -- if Shift or Ctrl doesn't pressed, than normal speed
  end

end

-- creating timer for check key press
t=createTimer(nil)
timer_setInterval(t, 10) -- how often keys will be checked
timer_onTimer(t, checkKeys)
timer_setEnabled(t, true)

[DISABLE]

timer_setEnabled(t, false) -- disabling timer
</AssemblerScript>
