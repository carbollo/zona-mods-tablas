<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="27">
  <CheatEntries>
    <CheatEntry>
      <ID>23930</ID>
      <Description>"Compact Mode"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

{$lua}

if not syntaxcheck then

  function cycleFullCompact( sender, force )
    local state = not( compactmenuitem.Caption == 'Compact View Mode' )
    if force ~= nil then
      state = not force
    end
    compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
    getMainForm().Splitter1.Visible = state
    getMainForm().Panel4.Visible = state
    getMainForm().Panel5.Visible = state
  end

  function addCompactMenu()
    if compactmenualreadyexists then return end
      local parent = getMainForm().Menu.Items
      compactmenuitem = createMenuItem( parent )
      parent.add( compactmenuitem )
      compactmenuitem.Caption = 'Compact View Mode'
      compactmenuitem.OnClick = cycleFullCompact
      compactmenualreadyexists = 'yes'
  end

  addCompactMenu()
  cycleFullCompact( nil, true )

end

[DISABLE]

{$lua}

if not syntaxcheck then
  cycleFullCompact( nil, false )
end
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>1</ID>
      <Description>"[ Enable ]"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

{$lua}

if not syntaxcheck then

  function _readInteger( Input )
    -- thanks, Pox!
    local Value = readInteger( Input )
    if Value &lt; 0x80000000 then return Value
    else return Value - 0x100000000 end
  end

  local function AOBScanEx( aob, p, a, n, s, e, pb )
  local p, a, n, s, e = p or '*X*W', a or fsmNotAligned, n or '0', s or 0x0, e or 0xffffffffffffffff
  local ms = pb and createMemScan( pb ) or createMemScan()
  local fl = createFoundList( ms )
  ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
  ms.waitTillDone()
  fl.initialize()
  local result = nil
  if fl ~= nil and fl.getCount() &gt; 0 then
    result = createStringlist()
    for i = 1, fl.getCount() do result.add( fl.getAddress( i-1 ) ) end
  end
  fl.destroy()
  ms.destroy()
  return result
  end

  unregisterSymbol( "szVersion_AOB" )

  autoAssemble([[
    aobscanmodule( szVersion_AOB, ACOrigins.exe, E8????????4533E44C89A5????????E8????????488BD04C )
    registersymbol( szVersion_AOB )
  ]])

  local szTableVersion = "1.51"

  local t = getAddress( "szVersion_AOB" )
  unregisterSymbol( "szVersion_AOB" )
  -- get to the next CALL, calculate the CALL destination and read the pointer address
  t = t + 0xF
  t = t + _readInteger( t + 0x1 ) + 0x5
  t = t + _readInteger( t + 0x3 ) + 0x7
  local szGameVersion = readString( t )

  if szTableVersion == szGameVersion then

    unregisterSymbol( "GetWorld" )

    autoAssemble([[
      aobscanmodule( GetWorld, ACOrigins.exe, 488B05????????4885C07408488B80C0000000C3C3 )
      registersymbol( GetWorld )
    ]])

    if getAddressSafe( "GetWorld" ) == nil then
      showMessage( "GetWorld not found; aborting. Check your game version?")
      return "assert(true)"
    else
      local EnableScript = addresslist_getMemoryRecordByID( getAddressList(), 1 )
      memoryrecord_setDescription( EnableScript, "▪[ Enable ]▪" )
      memoryrecord_setColor( EnableScript, 0x008000 )
      local gameModule = getAddress( "ACOrigins.exe" )
      unregisterSymbol( "GameModule" )
      registerSymbol( "GameModule", gameModule, true )
      fullAccess( gameModule, 0x1000 )
      local caption = control_getCaption( getMainForm() )
      writeString( gameModule + 0x500, caption )
      writeBytes( gameModule + 0x500 + string.len( caption ), 0 )
      local handlerBase = gameModule + 0x500 + string.len( caption ) + 0x10
      unregisterSymbol( "KeyHandlerThread" )
      registerSymbol( "KeyHandlerThread", handlerBase, true )
      local hkCave = AOBScanEx( "488D????????FFFF488D0D????????48C7C2", nil, nil, nil, getAddress( "ACOrigins.exe" ), getAddress( "ACOrigins.exe" ) + getModuleSize( "ACOrigins.exe" ) )
      local temp = tonumber( hkCave[0], 16 )
      --print( string.format( "0x%X", temp ) )
      local hkCaveA = AOBScanEx( "41445641504933322E646C6C", nil, nil, nil, temp, temp + 0x10000 ) --ADVAPI32.dll
      temp = tonumber( hkCaveA[0], 16 ) + 0x16
      --print( string.format( "0x%X", tonumber( hkCaveA[0], 16 ) ) )
      fullAccess( temp, 0x1000 )
      unregisterSymbol( "HookCave" )
      registerSymbol( "HookCave", temp, true )
      control_setCaption( getMainForm(), "Table for Assassin's Creed: Origins 1.51" )
    end
  else
    showMessage( "This table is designed for version " .. szTableVersion .. " of the game; yours is " .. szGameVersion .. "." )
    return "assert(true)"
  end

end

[DISABLE]

{$lua}

if not syntaxcheck then

  unregisterSymbol( "GetWorld" )

  local EnableScript = addresslist_getMemoryRecordByID( getAddressList(), 1 )
  memoryrecord_setDescription( EnableScript, "[ Enable ]" )
  memoryrecord_setColor( EnableScript, 0x0000FF )
  control_setCaption( getMainForm(), readString( getAddress( "gameModule" ) + 0x500, 6000 ) )

  for i=0,2816-1,1 do
    writeBytes( getAddress( "GameModule" ) + 0x500 + i, 0 )
  end
  for i=0,2191-1,1 do
    writeBytes( getAddress( "HookCave" ) + i, 0 )
  end
  unregisterSymbol( "HookCave" )
  unregisterSymbol( "KeyHandlerThread" )
  unregisterSymbol( "GameModule" )

end
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"[ Cheat Handler ]"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <Color>0000FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

CreateThread( KeyHandlerThread )
label( KeyHandlerOff )
registersymbol( KeyHandlerOff )
label( KeyHandlerThread_loop )

// pointers
label( pWorld )
registersymbol( pWorld )
label( pEntity )
registersymbol( pEntity )
label( pBhvAssassin )
registersymbol( pBhvAssassin )
label( pCharacterAI )
registersymbol( pCharacterAI )
label( pImmunityDataItem )
registersymbol( pImmunityDataItem )
label( pBipedComponent )
registersymbol( pBipedComponent )
label( pCSrvPlayerHealth )
registersymbol( pCSrvPlayerHealth )
label( pCSrvPlayerFightStamina )
registersymbol( pCSrvPlayerFightStamina )
label( pPlayerProgressionManager )
registersymbol( pPlayerProgressionManager )
label( pProgressionPlayerData )
registersymbol( pProgressionPlayerData )

label( lbl_0 )
label( lbl_1 )
label( lbl_2 )

// functions
label( GetPointers_do )
label( GetImmunityDataItem )
label( GetCSrvPlayerHealth )
label( GetCSrvPlayerFightStamina )

KeyHandlerThread:
sub rsp,28

KeyHandlerThread_loop:
mov rcx,A
call Sleep

cmp [KeyHandlerOff],1
jne short @f
  add rsp,28
  mov [KeyHandlerOff],2
  ret
@@:

  // VK_NUMPAD0
  mov rcx,60
  call GetAsyncKeyState
  test ax,ax
  je short @f

    call short GetPointers_do
    mov rcx,C8
    call Sleep

  @@:
  jmp short KeyHandlerThread_loop

//*******************************
//*                             *
//*          Functions          *
//*                             *
//*******************************

align 4 CC

GetPointers_do:
sub rsp,28
// Object::MangedObject::BaseWorld-&gt;World
call GetWorld
mov [pWorld],rax
// Object::ManagedObject::BaseEntity-&gt;Entity
mov rcx,[rax+98]
mov [pEntity],rcx
// ::Entity::GetBhvAssassin
call ACOrigins.exe+1146530
// Object::ManagedObject::BaseComponent::Component::AIComponent::CharacterBehavior-&gt;BhvAssassin
mov [pBhvAssassin],rax
// Object::Statechart::AbstractEntityAI::AbstractCharacterAI-&gt;CharacterAI
mov rbx,[rax+30]
mov [pCharacterAI],rbx
mov rcx,[pEntity]
// BipedComponent::GetName
call ACOrigins.exe+1603F30
mov rdx,rax
// GetBipedComponent
call ACOrigins.exe+1363730
mov [pBipedComponent],rax
call short GetImmunityDataItem
mov [pImmunityDataItem],rax
call short GetCSrvPlayerHealth
mov [pCSrvPlayerHealth],rax
call short GetCSrvPlayerFightStamina
mov [pCSrvPlayerFightStamina],rax
call short GetProgressionPlayerData
add rsp,28
ret

align 1 CC

GetImmunityDataItem:
sub rsp,28
mov rax,[pBhvAssassin]
test rax,rax
je short lbl_0
  // CharacterAI
  mov rax,[rax+30]
  test rax,rax
  je short lbl_0
    mov r9,rax
    mov r8d,[r9+BC]
	xor eax,eax
	mov rcx,[r9+B4]
	shr r8d,11
	shl r8d,2
	add r8,rcx
	cmp rcx,r8
	je short @f
	  lbl_2:
	  cmp [rcx],5EB03CEC
	  je short lbl_1
	    inc eax
		add rcx,4
		cmp rcx,r8
		jne short lbl_2
	lbl_0:
	xor eax,eax
	add rsp,28
	ret
lbl_1:
lea ecx,[rax*8]
mov rax,[r9+A8]
mov rax,[rcx+rax]
add rsp,28
ret

align 1 CC

GetCSrvPlayerHealth:
sub rsp,28
mov rcx,[pCharacterAI]
test rcx,rcx
je short @f
  mov rcx,[rcx+40]
  mov [rsp+20],rbx
  mov rbx,[ACOrigins.exe+4BF8790]
  mov rax,[rcx]
  call qword ptr [rax+98]
  movzx ecx,byte ptr [rbx+49]
  mov rbx,[rsp+20]
  mov rax,[rax]
  mov rcx,[rax+rcx*8]
  test rcx,rcx
  je short @f
    mov rax,rcx
    add rax,-210
    add rsp,28
    ret
@@:
xor eax,rax
add rsp,28
ret

align 1 CC

GetCSrvPlayerFightStamina:
sub rsp,28
mov rcx,[pCharacterAI]
test rcx,rcx
je short @f
  mov rcx,[rcx+40]
  mov [rsp+20],rbx
  mov rbx,[ACOrigins.exe+4BF8718]
  mov rax,[rcx]
  call qword ptr [rax+98]
  movzx ecx,byte ptr [rbx+49]
  mov rbx,[rsp+20]
  mov rax,[rax]
  mov rcx,[rax+rcx*8]
  test rcx,rcx
  je short @f
    mov rax,rcx
    add rax,-0F8
    add rsp,28
    ret
@@:
xor eax,rax
add rsp,28
ret

align 1 CC

GetProgressionPlayerData:
sub rsp,28
mov rcx,[ACOrigins.exe+4C14F38]
mov [pPlayerProgressionManager],rcx
// pointer to ProgressionCharacter
lea rdx,[rcx+A8]
lea rbx,[rcx+168]
mov r8,rbx
call ACOrigins.exe+17435F0
mov rax,[rax]
mov [pProgressionPlayerData],rax
add rsp,28
ret

align 4 CC

KeyHandlerOff:
dd 0
pWorld:
dq 0
pEntity:
dq 0
pBhvAssassin:
dq 0
pCharacterAI:
dq 0
pImmunityDataItem:
dq 0
pBipedComponent:
dq 0
pCSrvPlayerHealth:
dq 0
pCSrvPlayerFightStamina:
dq 0
pPlayerProgressionManager:
dq 0
pProgressionPlayerData:
dq 0

align 8 CC

{$lua}

if not syntaxcheck then
  local EnableScript = addresslist_getMemoryRecordByID( getAddressList(), 2 )
  memoryrecord_setDescription( EnableScript, "▪[ Cheat Handler ]▪ (press Numpad 0 to retrieve data)" )
  memoryrecord_setColor( EnableScript, 0x008000 )
end

[DISABLE]

{$lua}

if not syntaxcheck then
  local starttime = getTickCount()

  if readInteger( "KeyHandlerOff" ) == 0 then --could be 2 already
    writeInteger( "KeyHandlerOff", 1 ) --tell the thread to kill itself
    local EnableScript = addresslist_getMemoryRecordByID( getAddressList(), 2 )
    memoryrecord_setDescription( EnableScript, "[ Cheat Handler ]" )
    memoryrecord_setColor( EnableScript, 0x0000FF )
  end

  while( getTickCount() &lt; starttime + 1000 ) and ( readInteger( "KeyHandlerOff" ) ~= 2 ) do --wait till it has finished
    sleep( 20 )
  end

  if( getTickCount() &gt; starttime + 1000 ) then --could happen when the window is shown
    showMessage( 'Disabling the thread failed!' )
    error( 'Thread disabling failed!' )
  end
    sleep( 1 )
  end

{$asm}

unregistersymbol( pProgressionPlayerData )
unregistersymbol( pPlayerProgressionManager )
unregistersymbol( pCSrvPlayerFightStamina )
unregistersymbol( pCSrvPlayerHealth )
unregistersymbol( pBipedComponent )
unregistersymbol( pImmunityDataItem )
unregistersymbol( pCharacterAI )
unregistersymbol( pBhvAssassin )
unregistersymbol( pEntity )
unregistersymbol( pWorld )
