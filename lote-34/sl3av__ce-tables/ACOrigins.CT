   writeBytes( pBipedComponent + 0x4A, 1 ) -- stop Bayek's movement

end

{$asm}

aobscanmodule( CameraDetach, ACOrigins.exe, 0F 29 47 60 E8 63 CE FF FF ) // should be unique
registersymbol( CameraDetach )

CameraDetach:
db 90 90 90 90 E8 63 CE FF FF

[DISABLE]

{$lua}

if not syntaxcheck then

  function _readInteger( Input )
    -- thanks, Pox!
    local Value = readInteger( Input )
    if Value &lt; 0x80000000 then return Value
    else return Value - 0x100000000 end
  end

  local pEntity = getAddress("pEntity")
  pEntity = readQword( pEntity )

  local pCamera = readQword( 0x144B139F0 ) -- lazy to aob this
  pCamera = readQword( readQword( pCamera + 0xA8 ) )

  x = readInteger( pCamera + 0x90 )
  y = readInteger( pCamera + 0x94 )
  z = readInteger( pCamera + 0x98 )
  myX = pEntity + 0x50
  myY = pEntity + 0x54
  myZ = pEntity + 0x58
  writeInteger( myX, x )
  writeInteger( myY, y )
  writeInteger( myZ, z )

  local pBipedComponent = getAddress( "pBipedComponent" )
  pBipedComponent = readQword( pBipedComponent )
  writeBytes( pBipedComponent + 0x4A, 0 ) -- restore Bayek's movement

end

{$asm}

CameraDetach:
db 0F 29 47 60 E8 63 CE FF FF

unregistersymbol( CameraDetach )

