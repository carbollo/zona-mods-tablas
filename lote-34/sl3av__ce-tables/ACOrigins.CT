        <CheatEntry>
          <ID>5072</ID>
          <Description>"Hook + Call Lua Function"</Description>
          <Options moHideChildren="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}

function PrintString()
  local x = getAddress( "pStore" )
  x = readQword( x )
  x = readQword( x + 0x8 )
  x = readString( x + 0xC, 6000, true )
  --print( "&gt; " .. x )
  outputDebugString( "&gt; " .. x )
  local y = readInteger( getAddress( "bClick" ) )
  if y == 1 then
    local addr = getAddress( "pEquippedGear" )
    addr = readQword( readQword( addr ) + 0x8 )
    local hash = readQword( addr + 0x10 )
    --print( string.format( "&gt; id: 0x%X", hash ) )
    outputDebugString( string.format( "&gt; id: 0x%X", hash ) )
    writeBytes( getAddress( "bClick" ), 0 )
  end
end

{$asm}

loadlibrary( luaclient-x86_64.dll )
luacall( openLuaServer( 'CELUASERVER' ) )

CELUA_ServerName:
db 'CELUASERVER',0

alloc( functionid, 4 )
alloc( functionname, 16 )

functionid:
dd 0

functionname:
db 'PrintString',0

fullaccess( ACOrigins.exe+A8EF4F0, 0x1000 )
define( Hook, ACOrigins.exe+A8EF4F0 )

[ENABLE]

label( Hook_exit )
label( back )

label( PrintStr )
label( pStore )
registersymbol( pStore )

Hook:
cmp r13,84
jne Hook_exit
  cmp [rsp+20],7
  jne short @f
    call PrintStr
  @@:
  cmp [rsp+20],C
  jne short @f
    call PrintStr
  @@:
  cmp [rsp+20],35
  jne short @f
    call PrintStr
  @@:
  jmp Hook_exit

// -- start CELUA call

PrintStr:
mov [pStore],rax
//sub rsp,60
sub rsp,68 // cuz of CALL
mov [rsp+20],rcx
mov [rsp+28],rdx
mov [rsp+30],r8
mov [rsp+38],r9
mov [rsp+40],r10
mov [rsp+48],r11
mov [rsp+50],rax
mov ecx,[functionid]
test ecx,ecx
jne short @f
  mov rcx,functionname
  call CELUA_GetFunctionReferenceFromName
  mov [functionid],eax
  mov ecx,eax
@@:
mov edx,0
mov r9,0
call CELUA_ExecuteFunctionByReference
mov rcx,[rsp+20]
mov rdx,[rsp+28]
mov r8,[rsp+30]
mov r9,[rsp+38]
mov r10,[rsp+40]
mov r11,[rsp+48]
mov rax,[rsp+50]
//add rsp,60
add rsp,68
ret

// -- end

Hook_exit:
mov byte ptr [rbp+27E],2
jmp back

pStore:
dq 0

ACOrigins.exe+8C53BA:
jmp Hook
db 90 90
back:

[DISABLE]

ACOrigins.exe+8C53BA:
db C6 85 7E 02 00 00 02

unregistersymbol( pStore )

