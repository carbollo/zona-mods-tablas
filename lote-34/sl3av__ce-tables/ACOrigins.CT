          <AssemblerScript>fullaccess( ACOrigins.exe, 0x1000 )
define( MyHook, ACOrigins.exe+500 )

[ENABLE]

//alloc( KeyHandlerThread, 0x1000, ACOrigins.exe )
label( KeyHandlerThread )
registersymbol( KeyHandlerThread )
CreateThread( KeyHandlerThread )
label( KeyHandlerOff )
registersymbol( KeyHandlerOff )
label( ExitKeyHandler )
label( KeyHandlerThread_loop )

// pointers

label( pWorld )
registersymbol( pWorld )
label( pEntity )
registersymbol( pEntity )
label( pBhvAssassin )
registersymbol( pBhvAssassin )
label( pStore )
label( pCharacterAI )
registersymbol( pCharacterAI )
label( pImmunityDataItem )
registersymbol( pImmunityDataItem )
label( pBipedComponent )
registersymbol( pBipedComponent )
label( pCSrvPlayerHealth )
registersymbol( pCSrvPlayerHealth )
label( pCSrvPlayerFightStamina )
registersymbol( pCSrvPlayerFightStamina )
label( pPlayerProgressionManager )
registersymbol( pPlayerProgressionManager )
label( pProgressionPlayerData )
registersymbol( pProgressionPlayerData )

label( lbl_0 )
label( lbl_1 )
label( lbl_2 )
label( lbl_3 )

// functions

label( GetPointers_do )
label( GetPlayer )
label( GetImmunityDataItem )
label( GetCSrvPlayerHealth )
label( GetCSrvPlayerFightStamina )

MyHook:
KeyHandlerThread:
sub rsp,28

KeyHandlerThread_loop:
mov rcx,A
call Sleep

cmp [KeyHandlerOff],1
je ExitKeyHandler

  mov rcx,60 // VK_NUMPAD0
  call GetAsyncKeyState
  test ax,ax
  jne GetPointers_do

jmp KeyHandlerThread_loop

//*******************************
//*                             *
//*          Functions          *
//*                             *
//*******************************

GetPointers_do:
sub rsp,28
call GetWorld
mov [pWorld],rax // Object::MangedObject::BaseWorld-&gt;World
/*
mov rdx,[rax+98]
mov [pEntity],rdx
lea rcx,[pStore]
call GetPlayer
*/
mov rcx,[rax+98]
mov [pEntity],rcx // Object::ManagedObject::BaseEntity-&gt;Entity
call ACOrigins.exe+11381E0 // ::Entity::GetBhvAssassin
mov [pBhvAssassin],rax // Object::ManagedObject::BaseComponent::Component::AIComponent::CharacterBehavior-&gt;BhvAssassin
mov rbx,[rax+30]
mov [pCharacterAI],rbx // Object::Statechart::AbstractEntityAI::AbstractCharacterAI-&gt;CharacterAI
/*
mov rdx,[pEntity]
lea rcx,[pStore]
call ACOrigins.exe+C82710 // ::CharacterController
*/
mov rcx,[pEntity]
call ACOrigins.exe+15EBA50 // BipedComponent::GetName
mov rdx,rax
call ACOrigins.exe+134DF30 // GetBipedComponent
mov [pBipedComponent],rax
call GetImmunityDataItem
mov [pImmunityDataItem],rax
call GetCSrvPlayerHealth
mov [pCSrvPlayerHealth],rax
call GetCSrvPlayerFightStamina
mov [pCSrvPlayerFightStamina],rax
call GetProgressionPlayerData
add rsp,28
mov rcx,C8
call Sleep
jmp KeyHandlerThread_loop

ExitKeyHandler:
add rsp,28
mov [KeyHandlerOff],2
ret

GetPlayer:
mov [rsp+10],rbx
push rdi
sub rsp,20
cmp byte ptr [rcx+1],-2
mov rdi,rdx
mov rbx,rcx
jne short @f
  call ACOrigins.exe+E73D20 // GetCharacterController
  jmp short lbl_0
@@:
//movzx eax,byte ptr [rdx+22E] // this would need to be adjusted
movzx eax,byte ptr [rdx+236]
cmp al,[rcx]
je short lbl_0
  mov [rcx],al
  call ACOrigins.exe+178DCC0 // BhvAssassin::GetName
  mov rdx,rax
  lea r8,[rsp+30]
  mov rcx,rdi
  call ACOrigins.exe+134E000 // first function after GetBipedComponent
  mov eax,[rdi+E8]
  mov rcx,[rsp+30]
  shr eax,11
  shl eax,3
  add rax,[rdi+E0]
  cmp rcx,rax
  je short @f
    mov eax,ecx
    sub eax,[rdi+E0]
	sar rax,3
	mov [rbx+1],al
	jmp short lbl_0
  @@:
  mov byte ptr [rbx+1],-1
lbl_0:
movzx eax,byte ptr [rbx+1]
cmp al,-1
je short @f
  movzx ecx,al
  mov rax,[rdi+E0]
  mov rax,[rax+rcx*8]
  mov rbx,[rsp+38]
  add rsp,20
  pop rdi
  ret
@@:
xor eax,eax
mov rbx,[rsp+38]
add rsp,20
pop rdi
ret

GetImmunityDataItem:
sub rsp,28
mov rax,[pBhvAssassin]
test rax,rax
je lbl_1
  mov rax,[rax+30] // CharacterAI
  test rax,rax
  je lbl_1
    mov r9,rax
    mov r8d,[r9+BC]
	xor eax,eax
	mov rcx,[r9+B4]
	shr r8d,11
	shl r8d,2
	add r8,rcx
	cmp rcx,r8
	je short @f
	  lbl_3:
	  cmp [rcx],5EB03CEC
	  je short lbl_2
	    inc eax
		add rcx,4
		cmp rcx,r8
		jne short lbl_3
	lbl_1:
	xor eax,eax
	add rsp,28
	ret
lbl_2:
lea ecx,[rax*8]
mov rax,[r9+A8]
mov rax,[rcx+rax]
add rsp,28
ret

GetCSrvPlayerHealth:
sub rsp,28
mov rcx,[pCharacterAI]
test rcx,rcx
je short @f
  mov rcx,[rcx+40]
  mov [rsp+20],rbx
  mov rbx,[ACOrigins.exe+4B6B270] // these are different (270 vs 720)
  mov rax,[rcx]
  call qword ptr [rax+98]
  movzx ecx,byte ptr [rbx+49]
  mov rbx,[rsp+20]
  mov rax,[rax]
  mov rcx,[rax+rcx*8]
  test rcx,rcx
  je short @f
    mov rax,rcx
    //add rax,FFFFFDF8 // watch this
    add rax,FFFFFDF0
    add rsp,28
    ret
@@:
xor eax,rax
add rsp,28
ret

GetCSrvPlayerFightStamina:
sub rsp,28
mov rcx,[pCharacterAI]
test rcx,rcx
je short @f
  mov rcx,[rcx+40]
  mov [rsp+20],rbx
  mov rbx,[ACOrigins.exe+4B6B720] // these are different (270 vs 720)
  mov rax,[rcx]
  call qword ptr [rax+98]
  movzx ecx,byte ptr [rbx+49]
  mov rbx,[rsp+20]
  mov rax,[rax]
  mov rcx,[rax+rcx*8]
  test rcx,rcx
  je short @f
    mov rax,rcx
    add rax,FFFFFF08 // watch this
    add rsp,28
    ret
@@:
xor eax,rax
add rsp,28
ret

GetProgressionPlayerData:
sub rsp,28
mov rcx,[ACOrigins.exe+4B87318]
mov [pPlayerProgressionManager],rcx
lea rdx,[rcx+A8] // pointer to ProgressionCharacter
lea rbx,[rcx+168]
mov r8,rbx
call ACOrigins.exe+1725BC0
mov rax,[rax]
mov [pProgressionPlayerData],rax
add rsp,28
ret

KeyHandlerOff:
dd 0
pWorld:
dq 0
pEntity:
dq 0
pBhvAssassin:
dq 0
pCharacterAI:
dq 0
pImmunityDataItem:
dq 0
pBipedComponent:
dq 0
pCSrvPlayerHealth:
dq 0
pCSrvPlayerFightStamina:
dq 0
pPlayerProgressionManager:
dq 0
pProgressionPlayerData:
dq 0
pStore:
dd 0

[DISABLE]

{$lua}

if( syntaxcheck == false ) then --actual execution
  local starttime = getTickCount()

if readInteger( "KeyHandlerOff" ) == 0 then --could be 2 already
  writeInteger( "KeyHandlerOff", 1 ) --tell the thread to kill itself
end

while( getTickCount() &lt; starttime + 1000 ) and ( readInteger( "KeyHandlerOff" ) ~= 2 ) do --wait till it has finished
  sleep( 20 )
end

if( getTickCount() &gt; starttime + 1000 ) then --could happen when the window is shown
  showMessage( 'Disabling the thread failed!' )
  error( 'Thread disabling failed!' )
end
  sleep( 1 )
end

{$asm}

unregistersymbol( pProgressionPlayerData )
unregistersymbol( pPlayerProgressionManager )
unregistersymbol( pCSrvPlayerFightStamina )
unregistersymbol( pCSrvPlayerHealth )
unregistersymbol( pBipedComponent )
unregistersymbol( pImmunityDataItem )
unregistersymbol( pCharacterAI )
unregistersymbol( pBhvAssassin )
unregistersymbol( pEntity )
unregistersymbol( pWorld )

unregistersymbol( KeyHandlerOff )
unregistersymbol( KeyHandlerThread )
dealloc( KeyHandlerThread )
