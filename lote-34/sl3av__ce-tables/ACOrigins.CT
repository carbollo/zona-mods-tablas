                <CheatEntry>
                  <ID>24994</ID>
                  <Description>"Free Camera + Teleport To Camera"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{

  This script is entirely based on pigeon's work, started here:

      http://fearlessrevolution.com/viewtopic.php?p=32144#p32144

  Ported the code to ASM, with several improvements. Full credit
  for the idea flies out to him.

}

define( MyHook, GameModule+990 )

[ENABLE]

label( CameraKeyHandlerThread )
registersymbol( CameraKeyHandlerThread )
CreateThread( CameraKeyHandlerThread )
label( CameraKeyHandlerThread_loop )
label( CameraKeyHandlerOff )
registersymbol( CameraKeyHandlerOff )

label( flyEnabled )
registersymbol( flyEnabled )

label( moveForward )
label( moveLeft )
label( moveRight )
label( moveBackward )
label( incZ )
label( decZ )
label( incSpeed )
label( resetSpeed )

label(fSpeed)
registersymbol( fSpeed )
label( fSpeedMult )
label( fSpeedBase )

label( pStore )

label( RenderToCamera_A )
label( RenderToCamera_B )
label( back_A )
label( back_B )

label( checkShift )
label( bShiftPressed )

label( Teleport_do )

label( get_Camera )
label( fDouble )

MyHook:
CameraKeyHandlerThread:
sub rsp,28

CameraKeyHandlerThread_loop:
mov rcx,5 // you may adjust this as you please
call Sleep
cmp [flyEnabled],1
je short @f
  add rsp,28
  ret
@@:
mov rdi,[ACOrigins.exe+4B975B0] // get our camera
mov rdi,[rdi+A8]
mov rdi,[rdi]
test rdi,rdi
jne short @f
  mov rcx,C8
  call Sleep
  jmp short CameraKeyHandlerThread_loop
@@:

cmp byte ptr [ACOrigins.exe+46D6611],0 // if alt-tab
je short CameraKeyHandlerThread_loop

  mov rax,[ACOrigins.exe+4BA6738]
  cmp byte ptr [rax+4BA],1 // if at menu
  je short CameraKeyHandlerThread_loop

    mov rcx,57 // W
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
	  call short moveForward
    @@:
    mov rcx,41 // A
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
      call short moveLeft
    @@:
    mov rcx,44 // D
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
	  call short moveRight
    @@:
    mov rcx,53 // S
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
	  call short moveBackward
    @@:
    mov rcx,20 // VK_SPACE
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
	  call short incZ
    @@:
    mov rcx,46 // F
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
      call short decZ
    @@:
    call short checkShift
    mov rcx,51 // Q
    call GetAsyncKeyState
    shr ax,#15
    cmp ax,1
    jne short @f
      call short Teleport_do
    @@:
    // clear registers
    xorps xmm0,xmm0
    xorps xmm1,xmm1
    xorps xmm2,xmm2
    xorps xmm3,xmm3
    xorps xmm4,xmm4
    xorps xmm5,xmm5
    jmp CameraKeyHandlerThread_loop

align 4 CC

checkShift:
sub rsp,28
mov rcx,10 // VK_SHIFT
call GetAsyncKeyState
shr ax,#15
cmp ax,1
jne short @f
  call short incSpeed
  mov [bShiftPressed],1
  add rsp,28
  ret
@@:
cmp [bShiftPressed],1
jne short @f
  call short resetSpeed
  mov [bShiftPressed],0
@@:
add rsp,28
ret

align 4 CC

moveForward:
call short get_SineCosine
movss xmm0,[rax+4] // Cosine Value
movss xmm1,[rax] // Sine Value
mulss xmm0,[fSpeed] // Multiply Cosine by Speed
mulss xmm1,[fSpeed] // Multiply Sine by Speed
//Load XYZ
movss xmm2,[rdi+60]
movss xmm3,[rdi+64]
movss xmm4,[rdi+68]
subss xmm3,xmm0
subss xmm2,xmm1
call short get_CameraRot
movss xmm5,[rax+CC] // Load Z Pitch (Camera Rot V)
mulss xmm5,[fSpeed] // Multiply pitch by modifier
subss xmm4,xmm5 // Add result to Z
//Store XYZ
movss [rdi+60],xmm2
movss [rdi+64],xmm3
movss [rdi+68],xmm4
ret

align 4 CC

moveLeft:
call short get_SineCosine
movss xmm0,[rax+4] // Cosine Value
movss xmm1,[rax] // Sine Value
mulss xmm0,[fSpeed] // Multiply Cosine by Speed
mulss xmm1,[fSpeed] // Multiply Sine by Speed
//Load XY
movss xmm2,[rdi+60]
movss xmm3,[rdi+64]
addss xmm2,xmm0
subss xmm3,xmm1
//Store XY
movss [rdi+60],xmm2
movss [rdi+64],xmm3
ret

align 4 CC

moveRight:
call short get_SineCosine
movss xmm0,[rax+4] // Cosine Value
movss xmm1,[rax] // Sine Value
mulss xmm0,[fSpeed] // Multiply Cosine by Speed
mulss xmm1,[fSpeed] // Multiply Sine by Speed
//Load XY
movss xmm2,[rdi+60] // Load X
movss xmm3,[rdi+64] // Load Y
subss xmm2,xmm0
addss xmm3,xmm1
//Store XY
movss [edi+60],xmm2
movss [edi+64],xmm3
ret

align 4 CC

moveBackward:
call short get_SineCosine
movss xmm0,[rax+4] // Cosine Value
movss xmm1,[rax] // Sine Value
mulss xmm0,[fSpeed] // Multiply Cosine by Speed
mulss xmm1,[fSpeed] // Multiply Sine by Speed
//Load XYZ
movss xmm2,[rdi+60]
movss xmm3,[rdi+64]
movss xmm4,[rdi+68]
addss xmm3,xmm0
addss xmm2,xmm1
call short get_CameraRot
movss xmm5,[rax+CC] // Load Z Pitch (Camera Rot V)
mulss xmm5,[fSpeed] // Multiply pitch by modifier
addss xmm4,xmm5 // Add result to Z
//Store XYZ
movss [rdi+60],xmm2
movss [rdi+64],xmm3
movss [rdi+68],xmm4
ret

align 4 CC

incZ:
fld dword ptr [rdi+68] // Load Z
fadd dword ptr [fSpeed] // Add Modifier
fstp dword ptr [rdi+68] // Store Z
ret

align 4 CC

decZ:
fld dword ptr [rdi+68] // Load Z
fsub dword ptr [fSpeed] // Subtract Modifier
fstp dword ptr [rdi+68] // Store Z
ret

align 4 CC

incSpeed:
fld [fSpeed]
fadd [fSpeedMult]
fstp [fSpeed]
ret

align 4 CC

resetSpeed:
fld [fSpeedBase]
fstp [fSpeed]
ret

align 4 CC

Teleport_do:
sub rsp,28
call short get_Camera
xorps xmm0,xmm0
xorps xmm1,xmm1
xorps xmm2,xmm2
movss xmm0,[rax+60] // X
movss xmm1,[rax+64] // Y
movss xmm2,[rax+68] // Z
subss xmm2,[fDouble] // Z - 2.0
call short get_SineCosine
movss xmm3,[rax] // sin
mulss xmm3,[fDouble] // sin * 2.0
movss xmm4,[rax+4] // cos
mulss xmm4,[fDouble] // cos * 2.0
subss xmm0,xmm3 // X + sinh * 2.0
subss xmm1,xmm4 // Y + cosh * 2.0
shufps xmm1,xmm5,1 // puts Y as 2nd DWORD of xmm1
shufpd xmm2,xmm2,1 // puts Z as 3rd DWORD of xmm2
paddb xmm2,xmm0
paddb xmm2,xmm1
//mov rbx,[pEntity]
call GetWorld
mov rbx,[rax+98] // Entity
//mov rcx,[pBipedComponent]
mov rcx,rbx
call ACOrigins.exe+1603F30 // BipedComponent::GetName
mov rdx,rax
call ACOrigins.exe+1363730 // GetBipedComponent
mov rcx,rax
movups [rbx+50],xmm2 // set Entity XYZ to camera's
movups [rcx+270],xmm2 // set BipedComponent XYZ to camera's
mov rcx,[rcx+9C0]
movups [rcx+50],xmm2 // set Entity components sync to camera's XYZ
add rsp,28
ret

align 4 CC

get_SineCosine:
call short get_CameraRot
fld [rax+C4] // get Camera Rot H
fsin
fstp [pStore]
fld [rax+C4] // get Camera Rot H
fcos
fstp [pStore+4]
lea rax,[pStore]
ret

align 4 CC

get_CameraRot:
mov rax,[ACOrigins.exe+4B975B0] // get our camera
mov rax,[rax+A8]
mov rax,[rax]
mov rax,[rax+340]
ret

align 4 CC

get_Camera:
mov rax,[ACOrigins.exe+4B975B0] // get our camera
mov rax,[rax+A8]
mov rax,[rax]
ret

align 4 CC

RenderToCamera_A:
push rax
mov rax,[ACOrigins.exe+4B975B0] // path to camera
mov rax,[rax+A8]
mov rax,[rax]
movups xmm0,[rax+90] // get XYZ in xmm0
pop rax
movaps [rbx+200],xmm0
jmp back_A

align 4 CC

RenderToCamera_B:
push rax
mov rax,[ACOrigins.exe+4B975B0] // path to camera
mov rax,[rax+A8]
mov rax,[rax]
movups xmm0,[rax+90] // get XYZ in xmm0
pop rax
movaps [rbx+220],xmm0
jmp back_B

align 4 CC

CameraKeyHandlerOff:
dd 0
flyEnabled:
