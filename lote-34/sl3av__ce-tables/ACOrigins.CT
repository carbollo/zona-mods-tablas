                  <CheatEntries>
                    <CheatEntry>
                      <ID>468</ID>
                      <Description>"bTeleport"</Description>
                      <VariableType>4 Bytes</VariableType>
                      <Address>bTeleport</Address>
                      <Hotkeys>
                        <Hotkey>
                          <Action>Set Value</Action>
                          <Keys>
                            <Key>105</Key>
