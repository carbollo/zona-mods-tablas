      <AssemblerScript>{$lua}

function PrintData()
  local j = readInteger( getAddress( "bCounter" ) )
  local p = getAddress( "pStore" )
  for i = 0,j-1 do
    local str = readQword( readQword( p + i * 8 ) + 0x8 ) + 0xC
    str = readString( str, 6000, true )
    if str ~= nil then
      outputDebugString( "str_" .. i + 1 .. " :: " .. str )
    end
  end
  local r = getAddress( "pHash" )
  outputDebugString( string.format( "hash_id :: 0x%X", readQword( r ) ) )
  outputDebugString( "- - - -" )
end

{$asm}

loadlibrary( luaclient-x86_64.dll )
luacall( openLuaServer( 'CELUASERVER' ) )

define( Hook, HookCave )

[ENABLE]

label( PrintIt )

label( hook_1 )
label( back_1 )
