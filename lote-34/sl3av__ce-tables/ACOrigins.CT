          <AssemblerScript>{$lua}

function PrintData()

  local x = getAddress( "bHeader" )
  local y = readInteger( x )

  if y == 0 then
    outputDebugString( "\"&amp;\",\"ItemHash\",\"ItemCategory\",\"ItemSubCategory\",\"ItemRarity\",\"ItemName\",ItemDescription\"" )
    writeBytes( x, 1 )
  end

  local hashid = getAddress( "pHashId" )
  hashid = readQword( hashid )

  local name = getAddress( "pName" )
  name = readString( readQword( name ), 6000 )

  local desc = getAddress( "pDescription" )
  desc = readString( readQword( desc ), 6000 )

  local cat = getAddress( "pCategory" )
  cat = readString( readQword( cat ), 6000 )

  local subcat = getAddress( "pSubCategory" )
  subcat = readString( readQword( subcat ), 6000 )

  local rarity = getAddress( "pRarity" )
  rarity = readInteger( rarity )

  if rarity == 0 then
    rarity = "Normal"
  elseif rarity == 1 then
    rarity = "Rare"
  elseif rarity == 2 then
    rarity = "Legendary"
  end

  outputDebugString( string.format( "\"&amp;\",\"0x%X\",\"%s\",\"%s\",\"%s\",\"%s\",\"%s\"", hashid, cat, subcat, rarity, name, desc ) )

end

{$asm}

loadlibrary( luaclient-x86_64.dll )
luacall( openLuaServer( 'CELUASERVER' ) )

fullaccess( ACOrigins.exe+B0A05E0, 0x1000 )
define( Hook, ACOrigins.exe+B0A05E0 )
fullaccess( ACOrigins.exe+ADE3020, 0x1000 )
define( Storage, ACOrigins.exe+ADE3020 )

[ENABLE]

label( DebugHandlerThread )
registersymbol( DebugHandlerThread )
CreateThread( DebugHandlerThread )
label( DebugHandlerOff )
registersymbol( DebugHandlerOff )
label( DebugHandlerThread_loop )

label( GetInformation )
label( GetInformation_loop )
label( GetInformation_exit )

label( GetStringFromIndex )
label( GetStringFromIndex_exit )

label( CopyBufferToStatic )
label( CopyBufferToStatic_loop )
label( CopyBufferToStatic_space )
label( CopyBufferToStatic_continue )
label( CopyBufferToStatic_end )

label( GetItemHashId )
label( GetItemName )
label( GetItemDescription )
label( GetItemCategory )
label( GetItemSubCategory )
label( GetItemRarity )

label( pHashId )
registersymbol( pHashId )
label( pBuffer )
registersymbol( pBuffer )
label( pName )
registersymbol( pName )
label( pDescription )
registersymbol( pDescription )
label( pCategory )
registersymbol( pCategory )
label( pSubCategory )
registersymbol( pSubCategory )
label( pRarity )
registersymbol( pRarity )

label( szNull )

label( FetchTableBoundaries )
label( pStart )
registersymbol( pStart )
label( pEnd )
registersymbol( pEnd )

label( PrintMe )

label( bHeader )
registersymbol( bHeader )

Hook:
DebugHandlerThread:
sub rsp,28

DebugHandlerThread_loop:
mov rcx,A
call Sleep

cmp [DebugHandlerOff],1
jne short @f
  add rsp,28
  mov [DebugHandlerOff],2
  ret
@@:

  // VK_NUMPAD0
  mov rcx,60
  call GetAsyncKeyState
  test ax,ax
  je short @f
    call GetInformation
    mov rcx,C8
    call Sleep
  @@:
  jmp DebugHandlerThread_loop

GetInformation:
sub rsp,28
mov rsi,[pStart] // table start
mov rbp,[pEnd] // table end
cmp rsi,rbp
je GetInformation_exit
  GetInformation_loop:
  // get hash_id
  call GetItemHashId
  // get name
  mov r14d,1
  call GetItemName
  // get description
  mov r14d,2
  call GetItemDescription
  // get category
  call GetItemCategory
  // get sub-category
  call GetItemSubCategory
  // get rarity
  call GetItemRarity
  call PrintMe
  add rsi,8
  cmp rsi,rbp
  jne GetInformation_loop
GetInformation_exit:
add rsp,28
ret

GetItemHashId:
mov rax,[rsi]
mov rax,[rax]
mov rax,[rax+10]
mov rax,[rax+10]
mov [pHashId],rax
ret

GetItemName:
mov rax,[rsi]
mov rax,[rax]
mov ebx,[rax+68] // name_index
call GetStringFromIndex
mov [pName],rax
ret

GetItemDescription:
mov rax,[rsi]
mov rax,[rax]
mov ebx,[rax+98] // description_index
call GetStringFromIndex
mov [pDescription],rax
ret

GetStringFromIndex:
sub rsp,28
call ACOrigins.exe+146D200
test rax,rax
je short GetStringFromIndex_exit
  mov edx,ebx
  mov r9d,1
  mov r8,pBuffer
  mov rcx,rax
  call ACOrigins.exe+146DC40
  mov rax,[pBuffer]
  test rax,rax // if there's no pointer to a decrypted string
  jne short @f
    mov rax,szNull // use a 'null' reference
    jmp GetStringFromIndex_exit
  @@:
  call CopyBufferToStatic
GetStringFromIndex_exit:
add rsp,28
ret

CopyBufferToStatic:
// wchar to char
push rsi
push rdi
push rcx
mov rsi,[pBuffer]
mov rdi,Storage
cmp r14d,1
je short @f
  add rdi,100
@@:
mov rax,rdi
CopyBufferToStatic_loop:
mov cx,word ptr [rsi]
test cx,cx
je short CopyBufferToStatic_end
  cmp cx,0A
  je short CopyBufferToStatic_space
    cmp cx,0D
    je short CopyBufferToStatic_space
      mov byte ptr [rdi],cl
      CopyBufferToStatic_continue:
      add rsi,2
      add rdi,1
      jmp short CopyBufferToStatic_loop
CopyBufferToStatic_end:
mov byte ptr [rdi],0   // forcing null-terminator for overwrite
mov byte ptr [rdi+1],0 // forcing null-terminator for overwrite (just to be safe)
pop rcx
pop rdi
pop rsi
ret
CopyBufferToStatic_space:
mov byte ptr [rdi],20
jmp short CopyBufferToStatic_continue

GetItemCategory:
mov rax,[rsi]
mov rax,[rax]
mov rax,[rax+10]
mov rax,[rax]
test rax,rax
je short @f
  mov rax,[rax+58]
  test rax,rax
  je short @f
    mov rax,[rax]
    mov rax,[rax+20]
    mov [pCategory],rax
    ret
@@:
mov rax,szNull
mov [pCategory],rax
ret

GetItemSubCategory:
mov rax,[rsi]
mov rax,[rax]
mov rax,[rax+10]
mov rax,[rax]
test rax,rax
je short @f
  mov rax,[rax+60]
  test rax,rax
  je short @f
    mov rax,[rax]
    mov rax,[rax]
    mov rax,[rax+10]
    mov [pSubCategory],rax
    ret
@@:
mov rax,szNull
mov [pSubCategory],rax
ret

GetItemRarity:
mov rax,[rsi]
mov rax,[rax]
mov rax,[rax+10]
mov rax,[rax]
test rax,rax
je short @f
  mov eax,[rax+10]
@@:
mov [pRarity],eax
ret

PrintMe:
sub rsp,68
mov [rsp+20],rcx
mov [rsp+28],rdx
mov [rsp+30],r8
mov [rsp+38],r9
mov [rsp+40],r10
mov [rsp+48],r11
mov [rsp+50],rax
mov ecx,[functionid]
test ecx,ecx
jne short @f
  mov rcx,functionname
  call CELUA_GetFunctionReferenceFromName
  mov [functionid],eax
  mov ecx,eax
@@:
mov edx,0
mov r9,0
call CELUA_ExecuteFunctionByReference
mov rcx,[rsp+20]
mov rdx,[rsp+28]
mov r8,[rsp+30]
mov r9,[rsp+38]
mov r10,[rsp+40]
mov r11,[rsp+48]
mov rax,[rsp+50]
add rsp,68
ret

functionid:
dd 0
functionname:
db 'PrintData',0
bHeader:
dd 0

DebugHandlerOff:
dd 0
szNull:
db 'Null',0
pHashId:
dq 0
pBuffer:
dq 0
pName:
dq 0
pDescription:
dq 0
pCategory:
dq 0
pSubCategory:
dq 0
pRarity:
dd 0

dq 0

FetchTableBoundaries:
add rbp,rdi
mov [pStart],rdi
mov [pEnd],rbp
cmp rdi,rbp
jmp back

pStart:
dq 0
pEnd:
dq 0

ACOrigins.exe+2241F14:
jmp FetchTableBoundaries
db 90
back:

[DISABLE]

ACOrigins.exe+2241F14:
db 48 03 EF 48 3B FD

{$lua}

if not syntaxcheck then
  local starttime = getTickCount()

  if readInteger( "DebugHandlerOff" ) == 0 then --could be 2 already
    writeInteger( "DebugHandlerOff", 1 ) --tell the thread to kill itself
    local EnableScript = addresslist_getMemoryRecordByID( getAddressList(), 2 )
    memoryrecord_setDescription( EnableScript, "[ Cheat Handler ]" )
    memoryrecord_setColor( EnableScript, 0x0000FF )
  end

  while( getTickCount() &lt; starttime + 1000 ) and ( readInteger( "DebugHandlerOff" ) ~= 2 ) do --wait till it has finished
    sleep( 20 )
  end

  if( getTickCount() &gt; starttime + 1000 ) then --could happen when the window is shown
    showMessage( 'Disabling the thread failed!' )
    error( 'Thread disabling failed!' )
  end
    sleep( 1 )
  end

{$asm}

unregistersymbol( bHeader )

unregistersymbol( pEnd )
unregistersymbol( pStart )

unregistersymbol( pRarity )
unregistersymbol( pSubCategory )
unregistersymbol( pCategory )
unregistersymbol( pDescription )
unregistersymbol( pName )
unregistersymbol( pBuffer )
unregistersymbol( pHashId )

unregistersymbol( DebugHandlerOff )
unregistersymbol( DebugHandlerThread )

