                <CheatEntry>
                  <ID>467</ID>
                  <Description>"Teleport To Waypoint"</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>define( Hook, GameModule+930 )

[ENABLE]

aobscanmodule( MapWP_AOB, ACOrigins.exe, 488B4508488B480848C1E12048C1F93F482308488B4130488B780848C1E72048C1FF3F482338 )
label( MapWP )
registersymbol( MapWP )
label( bTeleport )
registersymbol( bTeleport )
label( TeleportToWaypoint )
registersymbol( TeleportToWaypoint )

Hook:
cmp [bTeleport],0
je short @f
  call short TeleportToWaypoint
  mov [bTeleport],0
@@:
mov rax,[rbp+08]
mov rcx,[rax+08]
jmp MapWP+8

TeleportToWaypoint:
sub rsp,28
push rax
push rcx
call GetWorld
mov rcx,[rax+98] // Entity
movups xmm0,[rbp+60] // load waypoint's XYZT in xmm0
movups [rcx+50],xmm0 // set player coordinates to waypoint's XYZT
pop rcx
pop rax
add rsp,28
ret

align 4 CC

bTeleport:
dd 0

align 10 CC

MapWP_AOB:
MapWP:
jmp Hook
db 90 90 90

[DISABLE]

MapWP:
db 48 8B 45 08 48 8B 48 08

unregistersymbol( TeleportToWaypoint )
unregistersymbol( bTeleport )
unregistersymbol( MapWP )

