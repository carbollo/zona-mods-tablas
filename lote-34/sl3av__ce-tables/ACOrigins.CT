jne short @f
  call short GetInventorySlotByWeaponSettingsPtr
@@:
mov rcx,[rax+8]
shl rcx,20
jmp back_1

align 4 CC

hook_2:
mov [bClick],1
mov [bCounter],0
@@:
sar rcx,3F
and rcx,[rax]
jmp back_2

align 4 CC

hook_3:
cmp [bClick],1
jne short @f
  push rbx
  push rcx
  push rdx
  xor rbx,rbx
  xor rcx,rcx
  xor rdx,rdx
  lea rbx,[pStore]
  mov ecx,[bCounter]
  mov [rbx+rcx*8],rax
  mov [rbx+rcx*8+8],rdx
  add [bCounter],1
  pop rdx
  pop rcx
  pop rbx
@@:
mov byte ptr [rbp+27E],2
jmp back_3

align 4 CC

hook_4:
call short PrintIt
mov [bClick],0
mov [bCounter],0
@@:
mov rsi,[rsp+B8]
jmp back_4

align 4 CC

PrintIt:
sub rsp,68
mov [rsp+20],rcx
mov [rsp+28],rdx
mov [rsp+30],r8
mov [rsp+38],r9
mov [rsp+40],r10
mov [rsp+48],r11
mov [rsp+50],rax
mov ecx,[functionid]
test ecx,ecx
jne short @f
  mov rcx,functionname
  call CELUA_GetFunctionReferenceFromName
  mov [functionid],eax
  mov ecx,eax
@@:
mov edx,0
mov r9,0
call CELUA_ExecuteFunctionByReference
mov rcx,[rsp+20]
mov rdx,[rsp+28]
mov r8,[rsp+30]
mov r9,[rsp+38]
mov r10,[rsp+40]
mov r11,[rsp+48]
mov rax,[rsp+50]
add rsp,68
ret

align 4 CC

GetInventorySlotByWeaponSettingsPtr:
sub rsp,28
push rax
push rbx
push rcx
push rdx
push rsi
push r8
call ACOrigins.exe+1599BA0    // GetWorld
mov rcx,[rax+98]              // Entity
call ACOrigins.exe+1146530    // GetBhvAssassin
mov rcx,[rax+30]              // CharacterAI
mov rcx,[rcx+40]
mov rbx,[ACOrigins.exe+4BF8688]
lea rax,[rcx+160]
movzx ecx,byte ptr [rbx+49]
mov rax,[rax]
mov rcx,[rax+rcx*8]
add rcx,-50                   // Inventory
mov rsi,rcx
mov rcx,[rsi+2C]              // inventory_start
mov edx,[rsi+34]
shr edx,11
shl edx,5
add rdx,rcx                   // inventory_end
cmp rcx,rdx
je short GetInventorySlotByWeaponSettingsPtr_exit
  mov r8,[pWeaponSettings]
  GetInventorySlotByWeaponSettingsPtr_loop:
  cmp r8,[rcx+8]
  jne short @f
    mov [pEqItemSlot],rcx
    jmp short GetInventorySlotByWeaponSettingsPtr_exit
  @@:
  add rcx,20
  cmp rcx,rdx
  jne short GetInventorySlotByWeaponSettingsPtr_loop
GetInventorySlotByWeaponSettingsPtr_exit:
pop r8
pop rsi
pop rdx
pop rcx
pop rbx
pop rax
add rsp,28
ret

