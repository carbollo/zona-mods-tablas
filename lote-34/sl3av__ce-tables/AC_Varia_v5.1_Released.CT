  // esi+F10: 1 = Peasant - 2~5 = enemies ~ Tempar = 5
aobscanmodule(HealthEnemy,$process,00 CC CC CC CC CC CC CC CC CC CC CC 56 8B F1 8B 06 8B 90 B0 00 00 00)
registersymbol(HealthEnemy)
alloc(newmem,$100,$process)

