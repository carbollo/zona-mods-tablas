              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : AssassinsCreed_Dx10.exe
  Version: 
  Date   : 2020-07-05
  Author : Paul44

  Collects appropriate checks for the 'Build Icon List'...
}

[ENABLE]

aobscanmodule(Collectables,$process,8B 06 8B 50 28 57 FF D2 57 8D 4E)
registersymbol(Collectables)
alloc(newmem,$100,$process)


alloc(chkTemplarVFT,0x14,$process)            // BhvTemplar ~ Flag: VFT+114
chkTemplarVFT:
db 'BhvTargetEnticerData',0

alloc(chkCollectVFT,0x12,$process)            // BhvCollectable ~ Flag: VFT+E4
chkCollectVFT:
db 'CanBlendBypassType',0

alloc(chkEntityVFT,0x13,$process)            // Entity: VFT+DC
chkEntityVFT:
db 'AISerializedManager',0


globalalloc(nChoice,1,$process)
globalalloc(pIconAddr,4,$process)

nChoice:
db 0


label(code)
label(code2)
label(code3)
label(return)

// source: google "Cheat Engine Compare Strings rep cmpsb"
newmem:
{$try}
  mov eax,[esi]
  mov edx,[eax+28]
@@:
  push ebx
  push ecx
  push edi
  push esi
  mov ecx,[pChkBhvTemplar]
  test ecx,ecx
  jne code2
  mov ecx,0x14                             // string length...
  mov esi,[eax+114]
  test esi,esi
  je code2
  lea esi,[eax+114]                        // esi pts to vft+114 string...
  mov edi,chkTemplarVFT                    // edi pts to label string...
  rep cmpsb
  jne code2
  mov [pChkBhvTemplar],eax
code2:
  mov ecx,[pChkBhvCollectable]
  test ecx,ecx
  jne code3
  mov ecx,0x12
  mov esi,[eax+E4]
  test esi,esi
  je code3
  lea esi,[eax+E4]
  mov edi,chkCollectVFT
  rep cmpsb
  jne code3
  mov [pChkBhvCollectable],eax
code3:
  jmp code                                 // crashes w/ pre-v7.x...
  mov ecx,[pChkEntity]
  test ecx,ecx
  jne code
  mov ebx,[esi+08]
  test ebx,ebx
  je code
  mov ebx,[ebx]
  mov ecx,0x13
  lea esi,[ebx+DC]
  mov edi,chkEntityVFT
  rep cmpsb
  jne code
  mov [pChkEntity],ebx
  jmp code
{$except}
  inc [nCrash1]
code:
  pop esi
  pop edi
  pop ecx
  pop ebx

  jmp return

Collectables:
  jmp newmem
return:


[DISABLE]

nChoice:
db 0

Collectables:
  db 8B 06 8B 50 28

unregistersymbol(Collectables)
dealloc(newmem)

dealloc(chkTemplarVFT)
dealloc(chkCollectVFT)
dealloc(chkEntityVFT)

{
// ORIGINAL CODE - INJECTION POINT: "AssassinsCreed_Dx10.exe"+153129

"AssassinsCreed_Dx10.exe"+153112: 8D 4E 0C                 -  lea ecx,[esi+0C]
