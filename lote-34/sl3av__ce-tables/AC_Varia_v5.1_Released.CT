{$asm}
// based on research by #mgr.inz.Player
// also google: "cheat engine How to freeze a countdown timer assassin"
// Struct: AssassinMenuManager
aobscanmodule(MissionTimer,$process,89 74 24 04 25 FF FF FF 7F)
registersymbol(MissionTimer)
alloc(newmem,$100,$process)


bMissionTimer:
db 0

label(code)
label(code2)
label(return)

newmem:
  push ebx
  push edx
  mov ebx,[pMissionTimer]
  cmp ebx,edi
  jne code
  cmp [bMissionTimer],1
  jne code2
  mov ebx,[pMissionChrono]
  mov ebx,[ebx]
  cmp [edi+70],0
  jne code
  mov [edi+70],ebx
  jmp code
code2:
  cmp [edi+70],0
  je code
  // flag sets when [ESC ~ Tab ~ Alt+Tab]...
  cmp byte ptr [edi+10],1
  je code
  mov ebx,[edi+70]
  mov edx,[pMissionChrono]
  mov edx,[edx]
  sub edx,ebx
  add [edi+68],edx
  mov [edi+70],0
code:
  pop edx
  pop ebx
@@:
  mov [esp+04],esi
  and eax,7FFFFFFF
  jmp return

MissionTimer:
  jmp newmem
  db 90 90 90 90
return:


