            <CheatEntry>
              <ID>781</ID>
              <Description>"MapWaypoint..."</Description>
              <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : AssassinsCreed_DxXX.exe
  Version:
  Date   : 2018-06-10
  Author : Paul44

  Collects current map waypoint xy coordinates shown on map...
}

[ENABLE]

// [pMapWayp] .. +8 .. +0 =&gt; Entity 'Icon'
// [pMapWayp] .. +C .. +0 =&gt; World
// [pMapWayp] .. +4C .. +0 .. +0 =&gt; World
// [pMapWayp] .. +50 .. +0 =&gt; Entity 'Player'
aobscanmodule(MapWaypoint,$process,D9 41 10 D9 18 8B)
registersymbol(MapWaypoint)
alloc(newmem,$100,$process)

globalalloc(pMapWayp,4,$process)


label(code)
label(return)

newmem:
  fld dword ptr [ecx+10]
  fstp dword ptr [eax]
code:
  cmp [ecx],1A
  jne short @f
  mov [pMapWayp],ecx
@@:
  jmp return

MapWaypoint:
  jmp newmem
return:


[DISABLE]

MapWaypoint:
  db D9 41 10 D9 18

unregistersymbol(MapWaypoint)
dealloc(newmem)

