mr.Active = true

-- redirect all prints for export to file...
-- makes use of global 'fContent' variable...!
default_print = print
function redirectPrint(bRedirect)
     if ( bRedirect == 1) then
        print = function(str)
              fContent = fContent .. str .. '\n'
        end
     else
        print = default_print
     end
end

