  Allows one to change Cam Distance to Player (FOV)...
}

[ENABLE]

// LowHighProfileCamera +10 ..
aobscanmodule(pFreeCam,$process,8B 06 8B 90 A0 00 00 00 FF D2 85 C0 0F 84 45)
