        <CheatEntry>
          <ID>805</ID>
          <Description>"Teleport &amp; Coordinates..."</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : AssassinsCreed_DxXX.exe
  Version:
  Date   : 2018-06-10
  Author : Paul44

  Collects player's location/camera specific info...
}

[ENABLE]
// Entity offset -10: struct +10 .. +20
// +94 ~= Entity ptr
// +74 ~= GameStateData
aobscanmodule(Entity,$process,0F 28 40 30 8B 45 08 8B 48 04)
registersymbol(Entity)
alloc(newmem,$100,"$process")

// Free roam routine...
aobscanmodule(FreeRoam,$process,8B F8 F3 A5 5F 5E 5B C2)
registersymbol(FreeRoam)
alloc(newmem2,$100,"$process")

// gets yaw &amp; pitch...
aobscanmodule(Camera,$process,D8 20 D9 5C 24 04)
registersymbol(Camera)
alloc(newmem3,$100,Camera)


// see Free Roam routine...
pEntity:
dd 00

globalalloc(pEntity,4,"$process")

// Free cam routine...
// ID of freecam script in CE table...
globalalloc(AddrListID,4,"$process")
AddrListID:
dd (int)1479

// save current location x,y,z coordinates...
globalalloc(OrigCoord,12,"$process")
// init script variables
globalalloc(XYstepVal,4,"$process")
globalalloc(ZstepVal,4,"$process")
globalalloc(ZstepdropHeight,4,"$process")
globalalloc(nDropHeight,4,$process)

// set minimum drop height...
nDropHeight:
dd 42200000                  // (float)40.0

XYstepVal:
dd 3F800000                                  // (float)1.0
ZstepVal:
dd 3F800000                                  // (float)1.0
ZstepdropHeight:
dd 3DCCCCCD                                  // (float)0.1

globalalloc(Xval,4,"$process")
globalalloc(Yval,4,"$process")
globalalloc(Zval,4,"$process")
globalalloc(bFreeRoam,1,"$process")
globalalloc(bCoordSave,1,"$process")

bFreeRoam:
db 00

// save_restore coordinates...
bCoordSave:
db 0

// fill in offset here ~ see table coordinates...
pStructCrdOffset:
dd 30

// variables for Cam Distance/FOV routine...
globalalloc(pStructCam,4,$process)
globalalloc(pFOVCam,4,$process)

pStructCam:
dd 0

pFOVCam:
dd (float)0.8000000119                    // default value AC

// yaw &amp; pitch...
globalalloc(pCamera,4,$process)


// gets entity struct...
label(code)
label(return)

newmem:
  mov [pEntity],eax
code:
  movaps xmm0,[eax+30]
  mov eax,[ebp+08]
  jmp return

Entity:
  jmp newmem
  db 90 90
return:


// Free Roam routine...
label(code2)
label(return2)

// subroutines...
alloc(updateCrd,$100,$process)

updateCrd:
  // updated coordinates...
  mov ebx,[pStructCrdBase]
  add ebx,[pStructCrdOffset]
  mov edx,[XVal]
  mov [ebx],edx
  add ebx,4
  mov edx,[YVal]
  mov [ebx],edx
  add ebx,4
  mov edx,[ZVal]
  mov [ebx],edx
  ret

newmem2:
  cmp [pEntity],0
  je code2
  cmp [pEntity],ebx
  jne code2
  mov [pStructCrdBase],ebx
  // freecam routines... x32: 4-byte ptrs &amp; e?x registers...
  cmp byte ptr [bFreeRoam],1
  jne code2
  push ebx
  //push ecx
  push edx
  // updated coordinates...
  call updateCrd
  pop edx
  //pop ecx
  pop ebx
code2:
  pop edi
  pop esi
  pop ebx
  ret 0008
  // jmp return2 - no longer needed since 'return-ing' anyway...

FreeRoam+04:
  jmp newmem2
  db 90
return2:

// yaw &amp; pitch...
label(code3)
label(return3)

newmem3:
  mov [pCamera],eax
code3:
  fsub dword ptr [eax]
  fstp dword ptr [esp+04]
  jmp return3

Camera:
  jmp newmem3
  nop
return3:


[DISABLE]

Entity:
  db 0F 28 40 30 8B 45 08

unregistersymbol(Entity)
dealloc(newmem)

// Free roam...
FreeRoam+04:
  db 5F 5E 5B C2 08 00

unregistersymbol(FreeRoam)
dealloc(newmem2)

Camera:
  db D8 20 D9 5C 24 04

unregistersymbol(Camera)
dealloc(newmem3)

