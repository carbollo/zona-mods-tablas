              <Description>"Defense / Damage Multiplier (Higher = Stronger, do not check them, just change value)"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//By Kutila

[ENABLE]

alloc(newmem,2048,"Cyberpunk2077.exe"+91D429) 
label(returnhere)
label(originalcode)
label(exit)

alloc(DamageMultiplier,4,"Cyberpunk2077.exe"+91D429)
registersymbol(DamageMultiplier)
DamageMultiplier:

dd (float)3

alloc(DefenseMultiplier,4,"Cyberpunk2077.exe"+91D429)
registersymbol(DefenseMultiplier)
DefenseMultiplier:

dd (float)2

newmem:

movss xmm1,[rax+000001A0]

//
                            //structure compare
cmp [rax+B8],1             //  B8   BC    C8    CC   D8   DC

jne originalcode

//

cmp [rbp+0],1

jne originalcode

//

divss xmm6,[DefenseMultiplier]

jmp exit

//

originalcode:

mulss xmm6,[DamageMultiplier]


exit:
jmp returnhere

"Cyberpunk2077.exe"+91D429:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
dealloc(DamageMultiplier)
unregistersymbol(DamageMultiplier)
unregistersymbol(DefenseMultiplier)
