  <LuaScript>function SpeedHack1()
boost = 1.2
if (readBytes('[_speed]') ~= nil) then
writeFloat('[_speed]+54',readFloat('[_speed]+54')*boost)
writeFloat('[_speed]+50',readFloat('[_speed]+50')*boost)
end
end
createHotkey(SpeedHack1, VK_LMENU)

function SpeedHack2()
boost = 0.5
if (readBytes('[_speed]') ~= nil) then
writeFloat('[_speed]+54',readFloat('[_speed]+54')*boost)
writeFloat('[_speed]+50',readFloat('[_speed]+50')*boost)
end
end
createHotkey(SpeedHack2, VK_MBUTTON)
</LuaScript>
