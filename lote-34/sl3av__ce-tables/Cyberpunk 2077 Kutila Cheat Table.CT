      <Options moManualExpandCollapse="1"/>
      <Color>9D009D</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

alloc(newmem,2048,"PhysX3_x64.dll"+101E8B) 
label(returnhere)
label(originalcode)
label(exit)
alloc(_speed,8)
registersymbol(_speed)

newmem:

push rax
mov rax,_speed
mov [rax],rbx
pop rax


originalcode:
mov [rbx+50],r14
mov [rbx+58],r14d

exit:
jmp returnhere

"PhysX3_x64.dll"+101E8B:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]

dealloc(newmem)
"PhysX3_x64.dll"+101E8B:
db 4C 89 73 50 44 89 73 58
//mov [rbx+50],r14
//mov [rbx+58],r14d
