alloc(newmem2,$100,$process)


// gets structaddress for verification...
label(code)
label(return)

newmem:
  mov [pStructCam],esi
code:
  mov eax,[esi]
  mov edx,[eax+000000A0]
  jmp return

pFreeCam:
  jmp newmem
  db 90 90 90
return:


// routine writes FOV value...
// see also Teleport script
label(code2)
label(return2)

newmem2:
  cmp eax,[pStructCam]
  jne code2
  push ebx
  mov ebx,[pFOVCam]
  mov [eax+70],ebx
  pop ebx
code2:
  movss xmm0,[eax+70]
  jmp return2

pSetCam:
  jmp newmem2
return2:

[DISABLE]

pFreeCam:
  db 8B 06 8B 90 A0 00 00 00

unregistersymbol(pFreeCam)
dealloc(newmem)

// routine 2...
pSetCam:
