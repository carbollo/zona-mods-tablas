          <AssemblerScript>{ Game   : AssassinsCreed_Dx10.exe
  Version:
  Date   : 2018-09-20
  Author : Paul44

  Freezes the Countdown timer for Challenge objectives...
}

[ENABLE]
{$lua}
  getStaticAddr("8B 56 74 F3 0F 11 46 48",-10,"pMissionTimer",2)
  getStaticAddr("89 5D 0C 88 5F 54",-8,"pMissionChrono",0)

{$asm}
// based on research by #mgr.inz.Player
// also google: "cheat engine How to freeze a countdown timer assassin"
// Struct: AssassinMenuManager
aobscanmodule(MissionTimer,$process,89 74 24 04 25 FF FF FF 7F)
registersymbol(MissionTimer)
alloc(newmem,$100,$process)


bMissionTimer:
db 0

label(code)
label(code2)
label(return)

newmem:
  push ebx
  push edx
  mov ebx,[pMissionTimer]
  cmp ebx,edi
  jne code
  cmp [bMissionTimer],1
  jne code2
  mov ebx,[pMissionChrono]
  mov ebx,[ebx]
  cmp [edi+70],0
  jne code
  mov [edi+70],ebx
  jmp code
code2:
  cmp [edi+70],0
  je code
  // flag sets when [ESC ~ Tab ~ Alt+Tab]...
  cmp byte ptr [edi+10],1
  je code
  mov ebx,[edi+70]
  mov edx,[pMissionChrono]
  mov edx,[edx]
  sub edx,ebx
  add [edi+68],edx
  mov [edi+70],0
code:
  pop edx
  pop ebx
@@:
  mov [esp+04],esi
  and eax,7FFFFFFF
  jmp return

MissionTimer:
  jmp newmem
  db 90 90 90 90
return:


[DISABLE]

