// ---------- INJECTING HERE ----------
"AssassinsCreed_Dx10.exe"+153129: 8B 06                    -  mov eax,[esi]
"AssassinsCreed_Dx10.exe"+15312B: 8B 50 28                 -  mov edx,[eax+28]
// ---------- DONE INJECTING  ----------
"AssassinsCreed_Dx10.exe"+15312E: 57                       -  push edi
"AssassinsCreed_Dx10.exe"+15312F: FF D2                    -  call edx
"AssassinsCreed_Dx10.exe"+153131: 57                       -  push edi
"AssassinsCreed_Dx10.exe"+153132: 8D 4E 0C                 -  lea ecx,[esi+0C]
"AssassinsCreed_Dx10.exe"+153135: E8 B6 4C F0 FF           -  call AssassinsCreed_Dx10.exe+57DF0
"AssassinsCreed_Dx10.exe"+15313A: 5F                       -  pop edi
"AssassinsCreed_Dx10.exe"+15313B: 5E                       -  pop esi
"AssassinsCreed_Dx10.exe"+15313C: C2 08 00                 -  ret 0008
"AssassinsCreed_Dx10.exe"+15313F: CC                       -  int 3 
"AssassinsCreed_Dx10.exe"+153140: 6A FF                    -  push -01
}
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>14694</ID>
                  <Description>"(it can take some time to build the list...)"</Description>
                  <LastState Value="" RealAddress="00000000"/>
                  <Color>FF0000</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>26134</ID>
                  <Description>"Build Icon Lists..."</Description>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">{ Game   : AssassinsCreed_DxXX.exe
  Version: 
  Date   : 2020-06-19
  Author : Paul44

  Lets you teleport to selected 'icon/item'...
}

[ENABLE]
{$lua}
local f

function onSelectIcon(sender)
    if (sender.ItemIndex &lt; 0) then return end
    local sCoord = sender.Items[sender.ItemIndex]
    sCoord = sCoord:match("%|(.-)%|")
    local aCoord = SplitStr(sCoord,'~')

    local xCoord = f.CoordX
    xCoord.Caption = string.format('%9.3f',aCoord[1])
    local yCoord = f.CoordY
    yCoord.Caption = string.format('%9.3f',aCoord[2])
    local zCoord = f.CoordZ
    zCoord.Caption = string.format('%9.3f',aCoord[3])

    f.PlayerX.Caption = ''
    f.PlayerY.Caption = ''
    f.PlayerZ.Caption = ''
    --print(string.format('[%f] \t [%f] \t [%f]',tonumber(aCoord[1]),tonumber(aCoord[2]),tonumber(aCoord[3])))
end

function TeleportToIcon()
  local fHeight = 3.0

  local xCoord = f.CoordX
  local yCoord = f.CoordY
  local zCoord = f.CoordZ
  if (xCoord.Caption == '' or yCoord.Caption == '' or zCoord.Caption == '') then return end

  local addrEntity = getAddress("[pEntity]")
  local chkEntity = readPointer(addrEntity)
  local CrdOffset = readInteger(getAddress("pStructCrdOffset"))
  addrEntity = addrEntity + CrdOffset
  local addrHeight = getAddress("nDropHeight")
  --print(string.format('%X ~ %X',chkEntity,addrMapIcon))

  local zVal = tonumber(zCoord.Caption)+fHeight
  if (readFloat(addrHeight) ~= 0) then zVal = math.max(zVal,readFloat(addrHeight)) end

  writeFloat(addrEntity+0x8,zVal)
  writeFloat(addrEntity,tonumber(xCoord.Caption))
  writeFloat(addrEntity+0x4,tonumber(yCoord.Caption))

  local xPlayer = f.PlayerX
  xPlayer.Caption = xCoord.Caption
  local yPlayer = f.PlayerY
  yPlayer.Caption = yCoord.Caption
  local zPlayer = f.PlayerZ
  zPlayer.Caption = zCoord.Caption
end

function setGodmode(sender,nFocus)
    if (f == nil) then return end
    local nFocus = nFocus or 0
    local cbGodmode = f.GodMode
    local al = getAddressList()
    local mr = al.getMemoryRecordByID(857)
    if (nFocus == 0) then mr.Active = cbGodmode.Checked else cbGodmode.Checked = mr.Active end
end


-- main routine...
local nChoice = readBytes(getAddress("nChoice"),1)
if not (nChoice == 1 or nChoice == 2 or nChoice == 11 or nChoice == 21) then return end

  local chkEntity = readPointer(getAddress("pChkEntity"))
  local chkBhvCollectable = readPointer(getAddress("pChkBhvCollectable"))
  local chkBhvTemplar =   readPointer(getAddress("pChkBhvTemplar"))
  if ( chkBhvCollectable == 0 or chkBhvTemplar == 0  or chkEntity == 0 ) then
    local sText = "The 'check_Pointers' are not collected yet ! \n\n" ..
                  'Swap back ingame, open/close your map and then return here...'
    local nType = mtInformation
    local nButton = mbOK
    messageDialog(sText, nType, nButton)
    return
  end

  local sMsg,sIcon,sAOB = ''
  local nCollect = 0

  -- get list of records...
  local scan = createMemScan(false)

  if (nChoice == 1 or nChoice == 11) then
    sMsg = 'still to collect...'
    sIcon = 'Flags'
    sAOB = string.format('%X',chkBhvCollectable)
     -- flag collected...
    nCollect = 0x00000000
  end
  if (nChoice == 2 or nChoice == 21) then
    sMsg = 'still to collect...'
    sIcon = "Templars"
    sAOB = string.format('%X',chkBhvTemplar)
     -- templar killed...
    nCollect = 0x00000000
  end
  if (nChoice == 11 or nChoice == 21) then sMsg = '(All)' end
  if (sAOB == '0' or sAOB == '') then return end

  synchronize(function()
      -- painting form...
      f = IconList
      f.show()
      f.Caption = 'AC - Icon Teleport...'
      local lBox = f.ListBox
      lBox.Clear()
      local lbTitle = f.IconTitle
      lbTitle.Caption = 'One moment please... processing...'
      local lbInfo = f.IconInfo
      lbInfo.Caption = ''
      local lbHead = f.IconHead
      lbHead.Caption = '   #    {addrIcon}   Category     X-coord       Y-coord       Z-coord    techInfo    Flags'
      local lbMsg = f.IconMessage
      lbMsg.Caption = "Best teleport while 'Map' is selected!\n" .. "(also make sure 'God Mode' is enabled)"
      local cbGod = f.GodMode
      cbGod.Checked = true
      -- enable 'God Mode' script...
      local al = getAddressList()
      local mr = al.getMemoryRecordByID(817)
      mr.Active = true
      mr = al.getMemoryRecordByID(857)
      mr.Active = true

      -- reset coordinates...
      local xCoord = f.CoordX
      xCoord.Caption = ''
      local yCoord = f.CoordY
      yCoord.Caption = ''
      local zCoord = f.CoordZ
      zCoord.Caption = ''
      f.PlayerX.Caption = ''
      f.PlayerY.Caption = ''
      f.PlayerZ.Caption = ''
  end)

  --scan.setOnlyOneResult(false)
  scan.firstScan(soExactValue,vtDword,rtRounded,sAOB,nil,0,0xffffffffffffffff,"-X-C+W",
                                      fsmNotAligned,nil,true,false,false,false)
  scan.waitTillDone()
  --scan.getOnlyResult()

  local scanList = createFoundList(scan)
  scanList.initialize()
  --print(string.format('- %d -',scanList.Count))

  synchronize(function()
    f.IconTitle.Caption = string.format('List of: %s %s',sIcon,sMsg)
    f.IconInfo.Caption = string.format('[Total: %d] - VFT: {%X} -',scanList.Count,readPointer(scanList.Address[0]))
  end)

  local offsCoord=0x40                                  -- MapIcon
  local nCount = 0
  for i=0,scanList.Count-1 do
      local bPrint = false
      local addrSelect = tonumber(scanList.Address[i],16)
      local addrIcon = readPointer(addrSelect+0x8)

      if (readPointer(addrIcon) == chkEntity) then
      --print(string.format('- %X -',addrSelect))

      local xVal = readFloat(addrIcon+offsCoord)
      local yVal = readFloat(addrIcon+offsCoord+0x4)
      local zVal = readFloat(addrIcon+offsCoord+0x8)
      --print(string.format('- %f  -  %f  -  %f -',xVal,yVal,zVal))
      local iconCat1,iconCollect,iconShown = 0

      local iconCat1 = readBytes(addrIcon+0xA8)
      local iconCat2 = readInteger(readPointer(addrIcon+0xD0)+0x04)
      local iconFlag0 = readPointer(addrIcon+0xA8)
      iconCollect = 0
      iconShown = 0
      local iconChk1 = readPointer(addrSelect+0x04)
      -- ptr +34 +36 +38 are set to '0'...
      local iconChk2 = readPointer(addrSelect+0x34)

      if (nChoice == 1 and iconChk1 ~= nCollect) then bPrint = true end
      if (nChoice == 11) then bPrint = true end
      if (nChoice == 2 and iconChk2 ~= nCollect and iconCat1 == 0x32) then bPrint = true end
      if (nChoice == 21 and iconChk2 ~= 0) then bPrint = true end

      -- only print non-collected icons...
      if (bPrint) then
          nCount = nCount + 1
          sName = string.format('[%03d]: {%08X} ~ [%02d/%03d] | %9.3f  ~  %9.3f  ~  %9.3f  | %08X - {%08X}'
                                      ,nCount,addrIcon,iconCat1,iconCat2,xVal,yVal,zVal,addrSelect,readPointer(addrIcon))
          synchronize(function()
              f.ListBox.Items.add(sName)
          end)
      end
      end -- if (readPointer(addrIcon)
  end -- for i...

  scanList.destroy()
  scan.destroy()


{$asm}

