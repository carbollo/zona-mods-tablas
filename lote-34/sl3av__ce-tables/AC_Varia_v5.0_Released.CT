nHealthEnemy:
dd 5

label(code)
label(return)

newmem:
  mov edx,[eax+000000B0]
@@:
  mov [pHealthEnemy],esi
  cmp [esi+F10],1
  jle code
  cmp [esi+F10],5
  jg code
  push eax
  mov eax,[esi+F10]
  mov eax,[nHealthEnemy]
  cmp [esi+EC0],eax
  jle short @f
  mov [esi+EC0],eax
@@:
  pop eax
code:
  jmp return

HealthEnemy+11:
  jmp newmem
  nop
return:


