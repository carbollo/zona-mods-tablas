label(code)
label(return)

newmem:
  // ptrs change constantly...
  // need research to see if 0x142EE4040 changes in time...
  // (now collected via main script 'enable cheats')
  push rbx
  push r15
  mov r15,pUIMapCheck1
  mov rbx,[r15]
  cmp rbx,[rax]
  jne code
  mov r15,pMapWayp
  mov [r15],rax
