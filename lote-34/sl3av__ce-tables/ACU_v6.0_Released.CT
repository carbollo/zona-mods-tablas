                  <CheatEntries>
                    <CheatEntry>
                      <ID>89414</ID>
                      <Description>"Build Gear List..."</Description>
                      <LastState/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{ Game   : ACU.exe
  Version: 
  Date   : 2020-05-29
  Author : Paul44

  Buiild list all (inventory) items...
}

[ENABLE]

{$lua}
local f = nil
local nChoice = 0
local sMsg = ''
local sInfo = ''
local sListItems
addrStruct = ''
strStruct = ''

  -- collect base_chain to ecoset struct...
  --getStaticAddr("48 8B F9 48 8B 9B 80 01 00 00",4,"pEcoSet")


local function revString(str)
    local sTmp = ''
    for k = #str, 2, -2 do sTmp = sTmp .. string.sub(str,k-1,k) end
    str = tonumber(sTmp,16)
    return str
end


--main routines...
function listItems()

  -- +150 +90 +2D8 +0 .. +20
  -- +208 +0 +3B8 +314 .. +500
  local addrGear = getAddressSafe("[pAvatarGear]")
  if ( addrGear == 0 or addrGear == nil ) then
     local sText = "The 'check_Pointers' are not collected yet ! \n\n" ..
                   "Return ingame, press [Esc] twice, and then return here..."
     local nType = mtInformation
     local nButton = mbOK
     messageDialog(sText, nType, nButton)
     return
  end


  local nRecord = readSmallInteger(addrGear+0x1A) + readSmallInteger(addrGear+0x26)
  --print(string.format('%X - %d',addrEcoSet,nRecord))

  local sMsg = "List Active Gear Items"
  if (nChoice == 2) then sMsg = "List Unlock Gear Items" end
  if (nChoice == 3) then sMsg = "Special: Non-Active Gear Items" end
  if (nChoice == 9) then sMsg = "Special: Full Gear List" end

  synchronize(function()
      -- painting form...
      f = IconList
      f.Show()
      f.Width = 800
      f.Height = 600
      f.Caption = 'ACS - Item list...'
      local lBox = f.ListBox
      lBox.Clear()
      local lbTitle = f.IconTitle
      lbTitle.Caption = 'One moment please... processing...'
      local lbInfo = f.IconInfo
      lbInfo.Caption = ''
      local lbHead = f.IconHead
      lbHead.Caption = '    #   Offs     addrItem        UniqueID |    Buy Upgrade | Category |  Descriptive'
      local lbMsg = f.IconMessage
      lbMsg.Caption = "Best teleport while 'Map' is selected!\n" .. "(also make sure 'God Mode' is enabled)"
      local cbGod = f.GodMode
      f.GodMode.Caption  = 'God Mode:'
      f.pCoord.Visible = false
      f.Structure.Visible = false
      f.RecycleBin.Visible = false

      lbTitle.Caption = sMsg
      lbInfo.Caption = string.format('[%d] Inventory Items: {%X ~ %X}',nRecord,addrGear,readPointer(addrGear+0x10))
  end)

    local bContinue = true
    local nCount = 0

    sListItems = createStringlist()
    sListItems.beginUpdate()

    -- equipment +0x10 ~ weapons +0x1C
    for i=0,1 do
        local xOffs = 0x10 + i * 0x0C
        addrGear = getAddress("[pAvatarGear]")
        nRecord = readSmallInteger(addrGear+xOffs+0x0A)
        addrGear = readPointer(addrGear+xOffs)            -- list of AvatarGear ptrs...
        --print(string.format('%X - %d',addrGear,nRecord))

        for j=0,nRecord-1 do
            local addrItem = readPointer(addrGear + j * 8)
            local xID1 = readQword(addrItem + 0x68)
            xID1 = revString(string.format('%016X',xID1))
            local xID2 = readInteger(addrItem + 0x70)
            xID2 = revString(string.format('%08X',xID2))

            local nBuy = readInteger(addrItem + 0x54)
            local nUpgrade = readInteger(addrItem + 0x60)

            local addrSet = readPointer(addrItem + 0x10)
            xID3 = readQword(addrSet + 0x10)
            addrSet = readPointer(addrSet)

            local nCat1 = readInteger(addrSet+0x18)                  -- category
            local nCat2 = readInteger(addrSet+0x1C)

            --local xFlag1 = readInteger(itemDetail+0x28)
            --local xFlag2 = readInteger(itemDetail+0x2C)
             --if (xFlag1 == 0xFFFFFFFF or xFlag2 == 0xFFFFFFFF) then nCat2 = nCat4; nCat3 = nCat5 end

             local sDescr = ''
             -- details: check out [Tools ~ Errors &amp; Settings ~ Maintenance scripts ~ Scripts to run...]
             if not pcall(function() sDescr = getChallengeDescr(xID3) end) then sDescr = '' end

             local bPrint = false
             if (nChoice == 1 and sDescr ~= '') then bPrint = true end
             if (nChoice == 2 and sDescr ~= '') then bPrint = true end
             if (nChoice == 3 and sDescr == '') then bPrint = true end
             if (nChoice == 9) then bPrint = true end

             if (bPrint) then
                local sGear = "[" .. nRecord .. "] Equipment"
                if (i == 1) then sGear = "[" .. nRecord .. "] Weapons" end
                if (j == 0) then sListItems.Text = sListItems.Text .. sGear end

                local sName = ''
                if (nChoice == 2) then
                   -- unlock("16AA070017AA0700A2550700")
                   sName = string.format('unlock("%016X%08X")     -- %s',xID1, xID2 ,sDescr)
                else
                   sName = string.format('[%04d/%04X] {%12X} | %08X | %6d  %6d |  %2d  %2d  | &lt;%s&gt;',
                                             nCount+1,j*8, addrItem, xID3, nBuy, nUpgrade, nCat1, nCat2 ,sDescr)
                end

                sListItems.Text = sListItems.Text .. sName
                if (nCount % 500 == 0) then
                   synchronize(function()
                      f.ListBox.Items.Text = sListItems.Text
                   end)
                end
                nCount = nCount + 1
             end
        --break
        end  -- j loop
    end  -- i loop

    synchronize(function()
        f.ListBox.Items.Text = sListItems.Text
    end)
    sListItems.endUpdate()

    sListItems.destroy()
end -- list mapicons...

nChoice = readBytes(getAddress("bGearChoice"))
if (nChoice &gt; 0 and nChoice &lt; 4 or nChoice == 9) then listItems() end

{$asm}
test al,al

[DISABLE]

</AssemblerScript>
