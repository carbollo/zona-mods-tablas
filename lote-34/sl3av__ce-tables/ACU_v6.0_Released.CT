                    <CheatEntry>
                      <ID>26080</ID>
                      <Description>"(Always make a backup of your game saves first !)"</Description>
                      <LastState Value="" RealAddress="00000000"/>
                      <Color>0000FF</Color>
                      <GroupHeader>1</GroupHeader>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>26081</ID>
                      <Description>"(it can take some time to build the list...)"</Description>
                      <LastState Value="" RealAddress="00000000"/>
                      <Color>FF0000</Color>
                      <GroupHeader>1</GroupHeader>
