                <CheatEntry>
                  <ID>13894</ID>
                  <Description>"Eagle Vision..."</Description>
                  <Options moHideChildren="1"/>
                  <LastState/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game   : ACU.exe
  Version: 
  Date   : 2020-05-28
  Author : Paul44

  Allows you to instantly charge/freeze Eagle Vision
}

[ENABLE]

{$lua}
  -- GamePlaySettings
  -- +14b4: diam EagleVision zone
  -- +14B8: speed to build circle zone ~ lower is faster
  -- +14C8: diam EV zone 2...
  getStaticAddr("48 8B 88 D8 18 00 00 3B",7,"pGamePlay")

  local addrGamePlay = getAddress("[pGamePlay]")
  writeFloat(addrGamePlay+0x14B4,100)
  writeFloat(addrGamePlay+0x14C8,100)

{$asm}

// uses 2 routines - one to builds EagleVision zone ~ one to delay rebuild...
// EagleVisionManager ~ rdi
// +80: World ~ gets Entity (surely to 'build' EV-circle zone...)
// +20~24: current player coordinates...
// correlation +3C &amp; 60 (diameter EV-zone = 20 units ~ GamePlaySettings parameters ?)
// icon detection distance max: 45 units... (~ field of vision; same for enenmies, etc ?)
aobscanmodule(EagleVision,$process,80 B8 C0 00 00 00 00 75 19)
registersymbol(EagleVision)
alloc(newmem2,$100)

globalalloc(pEagleVision,8)


label(code2)
label(return)
label(return2)
label(memCave)

// memCave1...
$process+500:
memCave:
  jmp far newmem2
return2:
  jmp return
  align 10 CC

// original opcode...
newmem2:
  push r15
  mov r15,pEagleVision
  mov [r15],rax
  mov byte ptr [rax+000000C0],00
  pop r15
code2:
  cmp byte ptr [rax+000000C0],00
  jmp return2

EagleVision:
  jmp memCave
  db 90 90
return:


[DISABLE]

{$lua}
  local addrGamePlay = getAddress("[pGamePlay]")
  writeFloat(addrGamePlay+0x14B4,20)
  writeFloat(addrGamePlay+0x14C8,30)

{$asm}
EagleVision:
  db 80 B8 C0 00 00 00 00

unregistersymbol(EagleVision)
dealloc(newmem)


