[ENABLE]
// PermanentIconManager: rbp
// +2C: build icon list
// Gets ptr to IconList of Chests, Cockades, etc...
aobscanmodule(IconList,$process,0F 46 CA 89 8C 24 88 00 00 00 44 8D 2C 0E)
