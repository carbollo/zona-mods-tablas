              <AssemblerScript>{ Game   : ACU.exe
  Version:
  Date   : 2020-05-15
  Author : Paul44

  Free Roaming...
  (using 'write coordinates' routine)
}

[ENABLE]
{$lua}
  -- use fall damage vs godmode...
  nFallmr = readInteger(getAddress('nFallId'))
  local nId = readBytes(getAddress('bUseGodmode'))
  if nId == 1 then nFallmr = readInteger(getAddress('nGodId')) end

  -- pCamera: yaw &amp; pitch...
  getStaticAddr("0F C6 C2 4E 0F 58 D0 0F 28 F2 0F C6 F2 11 0F 58 F2 E8 10",10,"pCamera",0,startAddr,endAddr)

{$asm}
// Entity ~ see main script...
// code writes coordinates... rax+30 = x-coordinate...
aobscanmodule(Coord,$process,0F 28 42 20 0F 29 41 40 0F 28 4A 30 0F 29 49 50 C3)
registersymbol(Coord)
alloc(newmem,$100)


// Map waypoint...
globalalloc(pMapWayp,8)
globalalloc(nDropHeight,4)
globalalloc(bDropHigh,1)

// save current location x,y,z coordinates (float)...
globalalloc(OrigCoord,12)
// init script variables
globalalloc(XYstepVal,4)
globalalloc(ZstepVal,4)
globalalloc(ZstepdropHeight,4)

globalalloc(Xval,4)
globalalloc(Yval,4)
globalalloc(Zval,4)
globalalloc(bFreeRoam,1)
globalalloc(bCoordSave,1)
globalalloc(nFrameSpeed,4)
globalalloc(bCoordRestore,1)

nDropHeight:
dd 42200000                            // = 40.0
// dd 0x41A00000                         // = 20.0
XYstepVal:
dd 3F800000                            // = 1.0
ZstepVal:
dd 3F800000
ZstepdropHeight:
dd 3F800000                            // = 1.0

bFreeRoam:
db 0
// save_restore coordinates...
bCoordSave:
db 1
bCoordRestore:
db 0
bDropHigh:
db 01

// fill in offset here ~ see table coordinates...
pStructCrdOffset:
dd 50

// freeroam timer interval (smoother/faster = 50 - smoothest/fast = 20)
// choose between player or camera
nFrameSpeed:
dd #20


label(code)
label(return)

// subroutines...
alloc(updateCrd,$100)

updateCrd:
  // updated coordinates...
  mov r15,pStructCrdBase
  mov rbx,[r15]
  mov r15,pStructCrdOffset
  add rbx,[r15]
  mov r15,XVal
  mov edx,dword ptr [r15]
  mov [rbx],edx
  add rbx,4
  mov r15,YVal
  mov edx,dword ptr [r15]
  mov [rbx],edx
  add rbx,4
  mov r15,ZVal
  mov edx,dword ptr [r15]
  mov [rbx],edx
  ret

// Player roaming...
newmem:
{$try}
  movaps xmm0,[rdx+20]
  movaps [rcx+40],xmm0
  movaps xmm1,[rdx+30]
  movaps [rcx+50],xmm1
@@:
  push rbx
  push rdx
  push r15
  mov r15,pEntity
  mov rbx,[r15]
  //sub rbx,0x20
  cmp rbx,rcx
  jne code
  // freecam routines... x64: 8-byte ptrs &amp; r?x registers...
  mov r15,bFreeRoam
  cmp byte ptr [r15],1
  jne code
  mov r15,pEntity
  mov rbx,[r15]
  mov r15,pStructCrdBase
  mov [r15],rbx
  // updated coordinates...
  mov r15,updateCrd
  call r15
  mov r15,pStructCrdBase
  mov rbx,[r15]
  movaps xmm1,[rbx+50]
  jmp code
{$except}
  mov r15,nCrash2
  inc [r15]
code:
  pop r15
  pop rdx
  pop rbx
  jmp return

Coord:
  jmp far newmem
  nop 2
return:

