          <Description>"(FastTravel &amp; Cutscenes cause values to 'reload'... !)"</Description>
          <LastState Value="" RealAddress="00000000"/>
          <Color>FF0080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>1424</ID>
          <Description>"(it can take a few seconds to collect the values...)"</Description>
          <LastState Value="" RealAddress="00000000"/>
          <Color>FF0000</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>13831</ID>
          <Description>"(Enabling the Anti-debug script can take 5-15s...)"</Description>
          <LastState Value="" RealAddress="00000000"/>
          <Color>0000FF</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>1993</ID>
      <Description>"Enable Cheats... (after save has fully loaded)"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <Color>808000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">{ Game   : &lt;game&gt;.exe
  Version:
  Date   : 2020-05-04
  Author : &lt;author&gt;


}

[ENABLE]

{$lua}
local f = nil


unregisterSymbol("pUIMapCheck1")
if not getAddressSafe("pUIMapCheck1") then registerSymbol("pUIMapCheck1", allocateMemory(8)) end
unregisterSymbol("pUIMapMgr")
if not getAddressSafe("pUIMapMgr") then registerSymbol("pUIMapMgr", allocateMemory(8)) end
unregisterSymbol("pUIMapCheck2")
if not getAddressSafe("pUIMapCheck2") then registerSymbol("pUIMapCheck2", allocateMemory(8)) end
unregisterSymbol("pUIMinimapMgr")
if not getAddressSafe("pUIMinimapMgr") then registerSymbol("pUIMinimapMgr", allocateMemory(8)) end

-- icon teleport: VFT checks are normally collected below...
writeQword(getAddress("pUIMapCheck1"),0x142EE4040)
writeQword(getAddress("pUIMapCheck2"),0x142EE3F10)

-- collecting main ptrs...
local bKillAD = nil
if getAddressSafe("bKillAntiDebug") then bKillAD = readBytes(getAddress("bKillAntiDebug"),1) end
-- print(tostring(bKillAD))

if not getAddressSafe("bKillAntiDebug") or bKillAD == nil or bKillAD ~= 9 then
    unregisterSymbol("bKillAntiDebug")
    if not getAddressSafe("bKillAntiDebug") then registerSymbol("bKillAntiDebug", allocateMemory(1)) end
    unregisterSymbol("GameProtect")
    if not getAddressSafe("GameProtect") then registerSymbol("GameProtect", allocateMemory(8)) end
    unregisterSymbol("pGameProtect1")
    if not getAddressSafe("pGameProtect1") then registerSymbol("pGameProtect1", allocateMemory(8)) end
    unregisterSymbol("pGameProtect2")
    if not getAddressSafe("pGameProtect2") then registerSymbol("pGameProtect2", allocateMemory(8)) end
end

  local startAddr = getAddress(myGame)
  local endAddr = startAddr + getModuleSize(process)

  local bKillAntiDebug = readBytes(getAddress("bKillAntiDebug"))
  local offsCheck = 0xB0
  if bKillAntiDebug == 0 then
       -- google: cheat engine Async exec Form invalid window handle
     synchronize(function()
         -- painting form...
         f = IconList
         f.Width = 600
         f.Height = 500
         f.Show()
         f.Caption = 'ACU - Removing Antidebug Thread...'
         local lBox = f.ListBox
         lBox.Clear()
         local lbTitle = f.IconTitle
         lbTitle.Caption = 'One moment please... processing...'
         local lbInfo = f.IconInfo
         lbInfo.Caption = ''
         local lbHead = f.IconHead
         lbHead.Caption = ' '
         local lbMsg = f.IconMessage
         lbMsg.Caption = "See Readme on how to manage \n and use this info..."
         --lbMsg.Visible = true
         local cbGod = f.GodMode
         f.GodMode.Caption  = 'God Mode:'
         -- hide info...
         f.pCoord.Visible = false
         f.Structure.Visible = false
         f.RecycleBin.Visible = false
     end)

     -- ACU v1.5.0
     -- Standard Edition...
     -- getStaticAddr("E9 1F 81 3F 05",0,"pGameProtect1",1)
     -- Gold Edition...
     getStaticAddr("E9 E5 F1 18 03",0,"pGameProtect2",1,startAddr,endAddr)

     local addrGameProtect = getAddress("[pGameProtect1]")
     if (addrGameProtect == 0) then
        addrGameProtect = getAddress("[pGameProtect2]")
        offsCheck = 0x10
     end
     writeQword(getAddress("GameProtect"),addrGameProtect)

     -- antiDebug routine...
     -- kill anti-debug thread...
     -- see [Settings - Maintenance scripts - Scripts to run per Timer interval] for details...
     KillAntiDebug(f)

     local nLines = f.ListBox.Items.Count-1
     f.ListBox.ItemIndex = nLines

     -- ensures routine is run only once...
     writeBytes(getAddress("bKillAntiDebug"),0x9)
  end

  -- checks used in Map Waypoint..., Teleport to Waypoint... &amp; Build Icon List...
  -- (see also "opening" script)
  -- gets ptr for 'Build Icon List...'...
  getStaticAddr("4C 8D 4C 24 78 4C 8B C6 48 8B CB",7,"pUIMinimapMgr",2,startAddr,endAddr)
  -- assume at least one iocn record with correct VFT ref within 1st 10...
  local addrUIicon = readPointer(getAddress("[pUIMinimapMgr]")+0x58)
  for i=0,10
    do
      local addrVFT = readPointer(readPointer(addrUIicon+8*i))
      local sCheck = readString(addrVFT+offsCheck,5)
      if (sCheck == "Alpha") then
          writeQword(getAddress("pUIMapCheck1"),addrVFT)
          break
      end
      --print(i,' - ',string.format('%X',addrVFT))
    end
  -- gets ptrCheck MapIcon mgmt...
  getStaticAddr("48 8B 54 24 40 84 C0 0F 94",17,"pUIMapMgr",2,startAddr,endAddr)
  -- assume at least one iocn record with correct VFT ref within 1st 10...

  local addrCheck = getStaticAddr("48 8B 41 10 48 8B 50 50",0,"pMapIconCheck2",3)
  local addrUIicon = readPointer(getAddress("[pUIMapMgr]")+0x58)
  for i=0,10 do
      local addrVFT = readPointer(readPointer(addrUIicon+8*i))
      local pCheck = readPointer(addrVFT+0x40)
      --print(i,' - ',string.format('%X - %X =&gt; %X',pCheck,addrVFT,addrCheck))
      if (pCheck == addrCheck) then
          writeQword(getAddress("pUIMapCheck2"),addrVFT)
          break
      end
  end

    -- Enable cheats...
  local al = getAddressList()
  local mr = al.getMemoryRecordByID(87951)
  mr.Active = true


{$asm}

// yaw &amp; pitch...
globalalloc(pCamera,8)

// create memCave for jump_far's...
fullAccess($process+500,$200)

// see [Maintenance scripts ~ 'special' scripts] (x3)..
globalalloc(bInverseXY,1)

bInverseXY:
db 0

[DISABLE]

{$lua}
-- in case of crashing during freeroam...
if ( tmerFly ~= nil ) then tmerFly.destroy() end


{$asm}

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>87951</ID>
          <Description>"Enable Cheats..."</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <Color>808000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

// structs: +28 .. +18
// BhvAssassin: +B8: CharacterAI
//              +C8: Human +1C0: HumanData

// collect ptrs: occasianally Health values misses...
// CameraManager... gets to ACUPlayerCameraComponent...  gets to Entity... gets to BhvAssassin...
//  +40 .. +0:ACUPlayerCameraComponent ..+10: Entity Player !
//                                              :+60 .. +218 .. +0: BhvAssassin
// aobscanmodule(INJECT,ACU.exe,44 0F 29 AC 24 C0 02 00 00 48)
aobscanmodule(CameraMgr,$process,44 0F 29 AC 24 C0 02 00 00 48 89 B5 90 02 00 00)
registersymbol(CameraMgr)
alloc(newmem,$100)


// needed for 'Enable cheats...' script
globalalloc(pCameraMgr,8)
globalalloc(pEntity,8)
globalalloc(pBhvAssassin,8)
globalalloc(pHealth,8)
globalalloc(pInventory,8)
globalalloc(pSyncPt,8)
globalalloc(pGamePlay,8)
globalalloc(bGodmode,1)
globalalloc(bInvisible,1)

// used in teleporting routiens ~ mr_id...
globalalloc(nFallId,4)
globalalloc(nGodId,4)
globalalloc(bUseGodmode,1)


bGodmode:
db 0
bInvisible:
db 0
bUseGodmode:
db 0

nFallId:
dd #92015                           // # = (int)
nGodId:
dd #106

// Error stats...
globalalloc(nCrash1,4)
globalalloc(nCrash2,4)
globalalloc(nCrash3,4)

nCrash1:
dd 0
nCrash2:
dd 0
nCrash3:
dd 0


// 'Player Coordinates' script
// x64 pointers are 8-bytes long
globalalloc(pStructCrdBase,8)
globalalloc(pStructCrdOffset,8)

// Accomplishments...
globalalloc(pAccomplishm,8)
globalalloc(pAccomplVFT,8)


label(code)
label(return)

newmem:
{$try}
  push rax
  push rbx
  push r15
  mov rax,CameraMgr
  sub rax,0x4
  xor rbx,rbx
  mov ebx,[eax]
  add rax,ebx
  add rax,0x4
  mov rax,[rax]
  mov r15,pCameraMgr
  mov [r15],rax
  test rax,rax
  je code
  // Entity...
  mov rbx,[rax+0x40]
  mov rbx,[rbx+0x0]
  mov rbx,[rbx+0x010]
  test rbx,rbx
  je code
  mov r15,pEntity
  mov [r15],rbx
  // BhvAssassin...
  mov rbx,[rbx+0x60]
  mov rbx,[rbx+0x218]
  mov rbx,[rbx+0x0]
  test rbx,rbx
  je code
  mov r15,pBhvAssassin
  mov [r15],rbx
  // dis-enable invisibility...
  mov r15,bInvisible
  mov al,byte ptr [r15]
  mov byte ptr [rbx+D0],al
  // Health...
  mov rbx,[rbx+0xB8]
  mov rbx,[rbx+0x60]
  mov rbx,[rbx+0x90]
  test rbx,rbx
  je code
  mov r15,pHealth
  mov [r15],rbx
  // dis-enable godmode + maxing health...
  mov r15,bGodmode
  mov al,byte ptr [r15]
  mov byte ptr [rbx+EE],al
  cmp al,1
  jne short @f
  // avoid desync during FreeRoam...?
  //mov byte ptr [rbx+EC],0
  //mov ax,word ptr [rbx+228]
  //mov [rbx+224],ax
  mov ax,word ptr [rbx+29A]
  mov [rbx+298],ax
@@:
  // Inventory...
  mov r15,pBhvAssassin
  mov rbx,[r15]
  mov rbx,[rbx+0xB8]
  mov rbx,[rbx+0xA8]
  mov rbx,[rbx+0x08]
  mov rbx,[rbx+0x28]
  mov r15,pInventory
  mov [r15],rbx
  jmp code
{$except}
  mov r15,nCrash1
  inc [r15]
code:
  pop r15
  pop rbx
  pop rax
@@:
  movaps [rsp+000002C0],xmm13
  mov [rbp+00000290],rsi
  jmp return

CameraMgr:
  jmp far newmem
  nop 2
return:


[DISABLE]

CameraMgr:
  db 44 0F 29 AC 24 C0 02 00 00 48 89 B5 90 02 00 00

unregistersymbol(CameraMgr)
dealloc(newmem)


