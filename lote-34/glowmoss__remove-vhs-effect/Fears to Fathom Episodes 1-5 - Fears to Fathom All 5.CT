[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()~=getProcessIDFromProcessName('Fears to Fathom - Woodbury Getaway.exe') then error('Wrong game') end
{$asm}
define(player,FirstPersonController:Update)
alloc(newmem,128)

registersymbol(player player_Orig bas13)
label(return player_Orig bas13)

newmem:
  mov [bas13],rcx
player_Orig:
  readmem(player,15)
  jmp far return

bas13:
  dq 0

player:
  jmp far newmem
  nop
return:

[DISABLE]

player:
  readmem(player_Orig,15)

unregistersymbol(*)
dealloc(*)

