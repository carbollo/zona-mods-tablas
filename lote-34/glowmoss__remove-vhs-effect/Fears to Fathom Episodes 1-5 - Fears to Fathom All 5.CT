[ENABLE]
{$lua}
if syntaxcheck then return end
if getOpenedProcessID()~=getProcessIDFromProcessName('Fears to Fathom - Scratch Creek.exe') then error('Wrong game') end
{$asm}
define(player,FirstPersonController:Update)
alloc(newmem,128)

registersymbol(player player_Orig bas14)
label(return player_Orig bas14)

newmem:
  cmp rcx,0
  je @f
  cmp byte ptr [rcx+5C],1
  jne @f
  mov [bas14],rcx

player_Orig:
  readmem(player,15)
  jmp far return

bas14:
  dq 0

player:
  jmp far newmem
  nop
return:

[DISABLE]

player:
  readmem(player_Orig,15)

unregistersymbol(*)
dealloc(*)

</AssemblerScript>
