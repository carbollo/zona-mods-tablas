              <CheatEntries>
                <CheatEntry>
                  <ID>694</ID>
                  <Description>"Fly"</Description>
                  <LastState/>
                  <Color>008000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  Author : Glowmoss
}

{$lua}
if syntaxcheck then return end

[ENABLE]

Coords = getAddressSafe("[p_coord]+150")
local s=AllocateMemory(0x8)
RegisterSymbol('FS',s)
FT=getAddressSafe("FS")
writeFloat(FT,0.2)
AddressList.getMemoryRecordByID(10).Value=0
FT=readFloat('FS')

function checkKeys()

  if isKeyPressed(VK_NUMPAD8) then writeFloat(Coords+0x8, readFloat(Coords+0x8)+FT) end

  if isKeyPressed(VK_NUMPAD5) then writeFloat(Coords+0x8, readFloat(Coords+0x8)-FT) end

  if isKeyPressed(VK_NUMPAD7) then writeFloat(Coords+0x10, readFloat(Coords+0x10)+FT) end

  if isKeyPressed(VK_NUMPAD9) then writeFloat(Coords+0x10, readFloat(Coords+0x10)-FT) end

  if isKeyPressed(VK_NUMPAD6) then writeFloat(Coords, readFloat(Coords)+FT) end

  if isKeyPressed(VK_NUMPAD4) then writeFloat(Coords, readFloat(Coords)-FT) end
end

function PCL()
  while PCLR == true
  do
    checkKeys()
    sleep(1)
  end
end

PCLR = true
PCLThr = createThread(PCL)

[DISABLE]
AddressList.getMemoryRecordByID(10).Value=1
PCLR = false
PCLThr = nil


</AssemblerScript>
