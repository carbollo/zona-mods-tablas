alloc(newmem,128,PlayerCoord)

registersymbol(PlayerCoord PlayerCoordOrig p_coord)
label(return PlayerCoordOrig p_coord)


newmem:
  mov [p_coord],rax
PlayerCoordOrig:
  readmem(PlayerCoord,9)
  jmp return

p_coord:
  dq 0

PlayerCoord:
  jmp newmem
  db 90 90 90 90
return:


[DISABLE]

PlayerCoord:
  readmem(PlayerCoordOrig,9)

unregistersymbol(*)
dealloc(*)

