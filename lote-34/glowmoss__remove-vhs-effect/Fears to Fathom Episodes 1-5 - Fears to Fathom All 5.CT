                      <AssemblerScript>{
  Author : Glowmoss
}

{$lua}
if syntaxcheck then return end

[ENABLE]

Coords = getAddressSafe("[coor]")
local s=AllocateMemory(0x8)
RegisterSymbol('FS',s)
FT=getAddressSafe("FS")
writeFloat(FT,0.1)
FT=readFloat('FS')

function checkKeys()

  if isKeyPressed(VK_NUMPAD8) then writeFloat(Coords+0x8, readFloat(Coords+0x8)+FT) end

  if isKeyPressed(VK_NUMPAD5) then writeFloat(Coords+0x8, readFloat(Coords+0x8)-FT) end

  if isKeyPressed(VK_NUMPAD7) then writeFloat(Coords+0x4, readFloat(Coords+0x4)+FT) end

  if isKeyPressed(VK_NUMPAD9) then writeFloat(Coords+0x4, readFloat(Coords+0x4)-FT) end

  if isKeyPressed(VK_NUMPAD6) then writeFloat(Coords, readFloat(Coords)+FT) end

  if isKeyPressed(VK_NUMPAD4) then writeFloat(Coords, readFloat(Coords)-FT) end
end

function PCL()
  while PCLR == true
  do
    checkKeys()
    sleep(1)
  end
end

PCLR = true
PCLThr = createThread(PCL)

[DISABLE]

PCLR = false
PCLThr = nil


