define(cart,CarControllerNetworked:Update)
alloc(newmem,128)

registersymbol(cart cart_Orig C1bas)
label(return cart_Orig C1bas)

newmem:
  mov [C1bas],rcx
cart_Orig:
  readmem(cart,15)
  jmp far return

C1bas:
  dq 0

cart:
  jmp far newmem
  nop 1
return:

[DISABLE]

cart:
  readmem(cart_Orig,15)

unregistersymbol(*)
