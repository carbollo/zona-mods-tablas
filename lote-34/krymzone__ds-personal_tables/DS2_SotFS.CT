                    <CheatEntry>
                      <ID>1337089438</ID>
                      <Description>"ChrNetworkPhantomParam Struct"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
globalalloc(newmem10,32)
label(ChrNetworkPhantomAddressToUse)
registersymbol(ChrNetworkPhantomAddressToUse)
newmem10:
ChrNetworkPhantomAddressToUse:
[DISABLE]
dealloc(newmem10)
unregistersymbol(ChrNetworkPhantomAddressToUse)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>1337089439</ID>
                          <Description>"Get ChrNetworkPhantomParam Address"</Description>
                          <Options moHideChildren="1"/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
alloc(GetChrNetworkPhantomParam, $100, DarkSoulsII.exe)
alloc(ChrNetworkPhantomParamId, 4)
label(return)
registersymbol(GetChrNetworkPhantomParam)
registersymbol(ChrNetworkPhantomParamId)

ChrNetworkPhantomParamId:
dd 0

GetChrNetworkPhantomParam:
sub rsp, 20
mov edx, [ChrNetworkPhantomParamId]
vortmov(rcx, [[[GameManagerImp]+18]+7B0])
add rcx, C8
test rcx, rcx
jz return
call DarkSoulsII.exe+3E8F0
mov [ChrNetworkPhantomAddressToUse], rax

return:
add rsp, 20
ret

[DISABLE]
dealloc(GetChrNetworkPhantomParam)
dealloc(ChrNetworkPhantomParamId)
unregistersymbol(GetChrNetworkPhantomParam)
unregistersymbol(ChrNetworkPhantomParamId)
</AssemblerScript>
