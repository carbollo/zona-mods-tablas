ParamLookup:
sub rsp, 20
mov edx, [RowId]
mov rcx, [ParamAddr]
add rcx, C8
test rcx, rcx
jz return
call DarkSoulsII.exe+3E8F0
mov [RowAddr], rax

return:
add rsp, 20
ret
 
[DISABLE]
dealloc(ParamLookup)
dealloc(ParamAddr)
dealloc(RowId)
dealloc(RowAddr)
unregistersymbol(ParamLookup)
unregistersymbol(ParamAddr)
unregistersymbol(RowId)
unregistersymbol(RowAddr)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>1337275588</ID>
                          <Description>"Input"</Description>
                          <GroupHeader>1</GroupHeader>
                          <CheatEntries>
                            <CheatEntry>
                              <ID>1337275589</ID>
                              <Description>"Param Address"</Description>
                              <ShowAsHex>1</ShowAsHex>
                              <ShowAsSigned>0</ShowAsSigned>
                              <VariableType>8 Bytes</VariableType>
                              <Address>ParamAddr</Address>
                            </CheatEntry>
                            <CheatEntry>
