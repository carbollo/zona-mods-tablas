                    <CheatEntry>
                      <ID>1337090272</ID>
                      <Description>"WeaponTypeParam Struct"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
globalalloc(newmem19,32)
label(WepTypeParamAddr)
registersymbol(WepTypeParamAddr)
newmem19:
WepTypeParamAddr:
[DISABLE]
dealloc(newmem19)
unregistersymbol(WepTypeParamAddr)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>1337090273</ID>
                          <Description>"Get WeaponTypeParam Address"</Description>
                          <Options moHideChildren="1"/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
alloc(GetWeaponTypeParamAddr, $100, DarkSoulsII.exe)
alloc(WeaponTypeParamId, 4)
label(return)
registersymbol(GetWeaponTypeParamAddr)
registersymbol(WeaponTypeParamId)

WeaponTypeParamId:
dd #140

GetWeaponTypeParamAddr:
sub rsp, 20
mov edx, [WeaponTypeParamId]
vortmov(rcx, [[[GameManagerImp]+18]+450])
add rcx, C8
test rcx, rcx
jz return
call DarkSoulsII.exe+3E8F0
mov [WepTypeParamAddr], rax

return:
add rsp, 20
ret

[DISABLE]
dealloc(GetWeaponTypeParamAddr)
dealloc(WeaponTypeParamId)
unregistersymbol(GetWeaponTypeParamAddr)
unregistersymbol(WeaponTypeParamId)
</AssemblerScript>
                          <CheatEntries>
                            <CheatEntry>
                              <ID>1337090274</ID>
                              <Description>"Entry Name"</Description>
                              <DropDownListLink>WeaponTypeParam_names</DropDownListLink>
                              <ShowAsSigned>0</ShowAsSigned>
                              <VariableType>4 Bytes</VariableType>
                              <Address>WeaponTypeParamId</Address>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337090275</ID>
                              <Description>"Entry ID"</Description>
                              <ShowAsSigned>0</ShowAsSigned>
                              <VariableType>4 Bytes</VariableType>
                              <Address>WeaponTypeParamId</Address>
                            </CheatEntry>
                            <CheatEntry>
                              <ID>1337090277</ID>
                              <Description>"&lt;- Run"</Description>
                              <Color>808000</Color>
                              <VariableType>Auto Assembler Script</VariableType>
                              <AssemblerScript>[ENABLE]
createthread(GetWeaponTypeParamAddr)

{$lua}
if syntaxcheck then return end

local t=createTimer()
t.Interval=50
t.OnTimer=function()
  memrec.Active=false
  t.destroy()
end
{$asm}
[DISABLE]
</AssemblerScript>
