ItemParamId:
dd #10

GetItemParamAddr:
sub rsp, 20
mov edx, [ItemParamId]
vortmov(rcx, [[[GameManagerImp]+A8]+20])
add rcx, C8
test rcx, rcx
jz return
call DarkSoulsII.exe+3E8F0
mov [GoodsAddressToUse], rax

return:
