                    <CheatEntry>
                      <ID>1337097841</ID>
                      <Description>"BulletParam Structure"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
globalalloc(newmem2,32)
label(BulletAddressToUse)
registersymbol(BulletAddressToUse)
newmem2:
BulletAddressToUse:
[DISABLE]
dealloc(newmem2)
unregistersymbol(BulletAddressToUse)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>1337097842</ID>
                          <Description>"Get BulletParam Address"</Description>
                          <Options moHideChildren="1"/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
alloc(GetBulletParamAddr, $100, DarkSoulsII.exe)
alloc(BulletParamId, 4)
label(return)
registersymbol(GetBulletParamAddr)
registersymbol(BulletParamId)

BulletParamId:
dd #10

GetBulletParamAddr:
sub rsp, 20
mov edx, [BulletParamId]
vortmov(rcx, [[[GameManagerImp]+60]+20])
add rcx, C8
test rcx, rcx
jz return
call DarkSoulsII.exe+3E8F0
mov [BulletAddressToUse], rax

return:
add rsp, 20
ret

[DISABLE]
dealloc(GetBulletParamAddr)
dealloc(BulletParamId)
unregistersymbol(GetBulletParamAddr)
unregistersymbol(BulletParamId)
</AssemblerScript>
