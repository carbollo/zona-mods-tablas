                    <CheatEntry>
                      <ID>1337089763</ID>
                      <Description>"GrabParam Structure"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
globalalloc(newmem5,32)
label(GrabParamAddressToUse)
registersymbol(GrabParamAddressToUse)
newmem5:
GrabParamAddressToUse:
[DISABLE]
dealloc(newmem5)
unregistersymbol(GrabParamAddressToUse)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>1337089764</ID>
                          <Description>"Get GrabParam Address"</Description>
                          <Options moHideChildren="1"/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
alloc(GetGrabParamId, $100, DarkSoulsII.exe)
alloc(GrabParamId, 4)
registersymbol(GetGrabParamId)
registersymbol(GrabParamId)
label(return)

GrabParamId:
dd #10300

GetGrabParamId:
sub rsp, 50
mov edx, [GrabParamId]
vortmov(rcx, [[[GameManagerImp]+18]+6A0])
add rcx, C8
test rcx, rcx
jz return
call DarkSoulsII.exe+3E8F0
mov [GrabParamAddressToUse], rax

return:
add rsp, 50
ret

[DISABLE]
dealloc(GetGrabParamId)
dealloc(GrabParamId)
unregistersymbol(GetGrabParamId)
unregistersymbol(GrabParamId)
</AssemblerScript>
