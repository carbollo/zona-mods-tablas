                          <Description>"Base Attunement"</Description>
                          <VariableType>Byte</VariableType>
                          <Address>pAttune2</Address>
                          <Offsets>
                            <Offset>2E</Offset>
                          </Offsets>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>6</ID>
                          <Description>"Bonus Attunement"</Description>
                          <VariableType>Byte</VariableType>
                          <Address>pAttune1</Address>
                          <Offsets>
                            <Offset>259ED</Offset>
                          </Offsets>
                        </CheatEntry>
                      </CheatEntries>
                    </CheatEntry>
