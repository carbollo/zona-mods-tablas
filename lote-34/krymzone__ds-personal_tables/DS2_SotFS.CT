                              <Description>"&lt;- Run"</Description>
                              <Color>808000</Color>
                              <VariableType>Auto Assembler Script</VariableType>
                              <AssemblerScript>[ENABLE]
createthread(GetWeaponReinforceParamAddr)

{$lua}
if syntaxcheck then return end

local t=createTimer()
t.Interval=50
t.OnTimer=function()
  memrec.Active=false
  t.destroy()
end
{$asm}
[DISABLE]
