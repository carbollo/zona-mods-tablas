                    <Offset>0</Offset>
                    <Offset>D8</Offset>
                    <Offset>450</Offset>
                    <Offset>18</Offset>
                  </Offsets>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>1337256326</ID>
              <Description>"Param Scripting"</Description>
