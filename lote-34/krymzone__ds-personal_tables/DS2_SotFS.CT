                      <CheatEntries>
                        <CheatEntry>
                          <ID>1337081250</ID>
                          <Description>"AreaParam"</Description>
                          <Options moHideChildren="1"/>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

--[[START AreaParam class]]--
AreaParam = BaseParamClass:new()

function AreaParam:new(uuid, id, address)
	local o = {}
	self.__index = self
	setmetatable(o, self)

	o:init("AreaParam", uuid, id, address)
	return o
end

function AreaParam:unk00(value)
	self:patch4Byte(0x0, value)
end


function AreaParam:unk04(value)
	self:patch4Byte(0x4, value)
end


function AreaParam:unk08(value)
	self:patch4Byte(0x8, value)
end


