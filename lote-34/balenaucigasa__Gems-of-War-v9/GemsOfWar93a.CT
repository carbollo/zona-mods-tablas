    <CheatEntry>
      <ID>56</ID>
      <Description>"GitHub BOOM [aob] v9.3 with Zero Init Health"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
//PuzzleTroop.Init
 
aobscanmodule(INJEhealth,GameAssembly.dll,89 47 10 8B 97 8C 00 00 00) // should be unique
alloc(newmem,$1000)
alloc(execCount,4)

label(skipZeroing)
label(return)

newmem:
  inc dword ptr [execCount]         // crește contorul
  cmp dword ptr [execCount], 5      // dacă execuția e &gt;=5, setează eax = 0
  jl skipZeroing
  xor eax, eax                      // setează eax = 0


skipZeroing:
  mov [edi+10],eax
  mov edx,[edi+0000008C]
  jmp return

INJEhealth:
  jmp newmem
  nop 4
return:
registersymbol(INJEhealth)

[DISABLE]
INJEhealth:
  db 89 47 10 8B 97 8C 00 00 00

unregistersymbol(INJEhealth)
dealloc(newmem)
dealloc(execCount)
