    <CheatEntry>
      <ID>63</ID>
      <Description>"Boom for Explore [With Cedric] v9.3"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(all_health,GameAssembly.dll,89 47 10 8B 97 8C 00 00 00) // should be unique
alloc(newmem,$1000)

label(code)
label(is_friendly)
label(return)

newmem:

code:
  // Pasul 1: Verificăm dacă ID-ul trupei de la [edi+50] este 6498 (zecimal)
  cmp dword ptr [edi+50], #6498
  // #6498 Cedric 1962
  // #7813 Moonveil
  // #1481 underspire

  // Pasul 2: Dacă este egal (adică e trupa ta), sărim direct la codul original (nu modificăm nimic)
  je is_friendly

  // Pasul 3: Dacă NU este egal (e inamicul), suprascriem registrul EAX cu 0 înainte de a-l muta în viață
  mov eax, 0

is_friendly:
  mov [edi+10],eax                // Executăm instrucțiunea originală (cu EAX intact sau modificat în 0)
  mov edx,[edi+0000008C]          // Cealaltă instrucțiune originală din AOB
  jmp return

all_health:
  jmp newmem
  nop 4
return:
registersymbol(all_health)

[DISABLE]
all_health:
  db 89 47 10 8B 97 8C 00 00 00

unregistersymbol(all_health)
dealloc(newmem)

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>57</ID>
      <Description>"Boom Arena v9.3"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
 
aobscanmodule(INJarena,GameAssembly.dll,89 47 10 8B 97 8C 00 00 00) // should be unique
