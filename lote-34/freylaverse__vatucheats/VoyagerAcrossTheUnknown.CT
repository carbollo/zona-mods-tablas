aobscanmodule(NoDeuteriumDrain,STVoyager-Win64-Shipping.exe,44 89 78 10 8B 43 08) // should be unique
alloc(newmem,$1000,NoDeuteriumDrain)

label(code)
label(return)

newmem:

code:
//  mov [rax+10],r15d
  mov r15d,#9999    // Force the value to 999,999
  mov [rax+10],r15d   // Now it writes 999,999 instead of the real amount
  mov eax,[rbx+08]
  jmp return

NoDeuteriumDrain:
  jmp newmem
  nop 2
return:
registersymbol(NoDeuteriumDrain)

