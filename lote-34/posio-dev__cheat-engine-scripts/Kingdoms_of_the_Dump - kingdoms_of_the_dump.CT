  [3] = "Cerulean",
  [4] = "Jacket",
  [5] = "Musk",
  [6] = "Lute",
  [7] = "Garbamesh",
}

local WEAR_SLOT_LABELS = {
  "slot0 weapon",
  "slot1 head",
  "slot2 armor",
  "slot3 trinket A",
  "slot4 trinket B",
}

local function memoryRecordDelete(mr)
  if mr == nil then return end
  if type(mr.delete) == "function" then
    mr.delete(mr)
  elseif type(mr.destroy) == "function" then
    mr.destroy(mr)
  end
end

local function isPtr(v)
  return v and v &gt; 0x10000 and v &lt; 0x00007FFFFFFFFFFF
end

local function readStringName(fieldAddr)
  if not isPtr(fieldAddr) then return nil end
  local dataPtr = readQword(fieldAddr)
  if not isPtr(dataPtr) then return nil end

  local cnamePtr = readQword(dataPtr + 0x08)
  if isPtr(cnamePtr) then
    local bytes = readBytes(cnamePtr, 256, true)
    if bytes then
      local t = {}
      for _, b in ipairs(bytes) do
        if b == 0 then break end
        t[#t + 1] = string.char(b)
      end
      local s = table.concat(t)
      if #s &gt; 0 then return s end
    end
  end

  local wptr = readQword(dataPtr + 0x10)
  if isPtr(wptr) then
    local bytes = readBytes(wptr, 512, true)
    if bytes then
      local t = {}
      for i = 1, #bytes - 1, 2 do
        local lo, hi = bytes[i], bytes[i + 1]
        if lo == 0 and hi == 0 then break end
        t[#t + 1] = (hi == 0 and lo &gt;= 32 and lo &lt; 127) and string.char(lo)
          or "?"
      end
      local s = table.concat(t)
      if #s &gt; 0 then return s end
    end
  end
  return nil
end

local function getPlayerDataMembers()
  local base = getAddress(MODULE)
  if not base or base == 0 then
    return nil, "Module '" .. MODULE .. "' not found"
  end

  local osPtr = readQword(base + OS_SINGLETON_RVA)
  if not isPtr(osPtr) then
    return nil, string.format("OS* null at 0x%X", base + OS_SINGLETON_RVA)
  end

  local treePtr = readQword(osPtr + OS_MAIN_LOOP)
  if not isPtr(treePtr) then return nil, "SceneTree* null (game loading?)" end

  local rootPtr = readQword(treePtr + TREE_ROOT)
  if not isPtr(rootPtr) then return nil, "Root Viewport* null" end

  local childrenPtr = readQword(rootPtr + NODE_CHILDREN_PTR)
  if not isPtr(childrenPtr) then return nil, "Root has no children" end

  local childCount = readInteger(childrenPtr - 4) or 0
  if childCount &lt;= 0 or childCount &gt; 2000 then
    return nil, "Invalid child count: " .. childCount
  end

  local nodePtr = nil
  for i = 0, childCount - 1 do
    local c = readQword(childrenPtr + i * 8)
    if isPtr(c) and readStringName(c + NODE_NAME) == "player_data" then
      nodePtr = c
      break
    end
  end
  if not nodePtr then
    return nil, "'player_data' not found in " .. childCount .. " root children"
  end

  local si = readQword(nodePtr + NODE_SCRIPT_INST)
  if not isPtr(si) then return nil, "player_data has no GDInstance" end

  local mp = readQword(si + GDI_MEMBERS_PTR)
  if not isPtr(mp) then return nil, "GDInstance members null" end

  return {
    base = base,
    rootPtr = rootPtr,
    nodePtr = nodePtr,
    scriptInst = si,
    membersPtr = mp,
  }
end

local function varDataAddr(membersPtr, idx)
  return membersPtr + idx * VARIANT_SIZE + VARIANT_DATA_OFF
end

local function varType(membersPtr, idx)
  return readInteger(membersPtr + idx * VARIANT_SIZE + VARIANT_TYPE_OFF) or 0
end

local function getGDIMembers(nodePtr)
  if not isPtr(nodePtr) then return nil end
  local si = readQword(nodePtr + NODE_SCRIPT_INST)
  if not isPtr(si) then return nil end
  local mp = readQword(si + GDI_MEMBERS_PTR)
  return isPtr(mp) and mp or nil
end

local function getChildMembers(membersPtr, idx)
  if varType(membersPtr, idx) ~= VTYPE_OBJECT then return nil end
  local objPtr = readQword(varDataAddr(membersPtr, idx))
  if not isPtr(objPtr) then return nil end
  return getGDIMembers(objPtr)
end

local function getPoolIntArrayElemPtr(membersPtr, memberIdx, dbgName)
  local v = membersPtr + memberIdx * VARIANT_SIZE
  local vt = readInteger(v + VARIANT_TYPE_OFF) or 0
  if vt ~= VTYPE_INTARRAY then
    kotd_error(string.format(
      "KOTD.lua: %s: need VTYPE_INTARRAY (%d), got %d @ members[%d]",
      dbgName or "PoolIntArray", VTYPE_INTARRAY, vt, memberIdx))
    return nil
  end
  local cow = readQword(v + VARIANT_DATA_OFF)
  if not isPtr(cow) then
    kotd_error("KOTD.lua: " .. (dbgName or "PoolIntArray") .. " CowData ptr bad")
    return nil
  end
  local elem = readQword(cow + 0x08)
  if not isPtr(elem) then
    kotd_error(string.format(
      "KOTD.lua: %s: elem ptr bad (cow=0x%X)",
      dbgName or "PoolIntArray", cow))
    return nil
  end
  readInteger(elem - 4) -- count; validate layout exists
  return elem
end

-- characters[0] null; [1..7] PCs (_default_characters in player_data.gd)
local function getCharMembers(pdMembers, charIdx)
  local arrPtr = readQword(varDataAddr(pdMembers, PD_CHARACTERS_IDX))
  if not isPtr(arrPtr) then return nil end
  local bufPtr = readQword(arrPtr + 0x08)
  if not isPtr(bufPtr) then return nil end
  local elemBase = bufPtr + charIdx * VARIANT_SIZE
  local vt = readInteger(elemBase + VARIANT_TYPE_OFF) or 0
  if vt ~= VTYPE_OBJECT then return nil end
  local objPtr = readQword(elemBase + VARIANT_DATA_OFF)
  if not isPtr(objPtr) then return nil end
  local si = readQword(objPtr + NODE_SCRIPT_INST)
  if not isPtr(si) then return nil end
  local mp = readQword(si + GDI_MEMBERS_PTR)
  return isPtr(mp) and mp or nil
end

local function addRecord(desc, addr, ceType, parent)
  local al = getAddressList()
  local r = al.createMemoryRecord()
  r.Description = desc
  r.Address = string.format("%X", addr)
  r.Type = ceType
  if parent then r.appendToEntry(parent) end
  return r
end

local function addHeader(desc, parent)
  local al = getAddressList()
  local h = al.createMemoryRecord()
  h.Description = desc
  h.IsGroupHeader = true
  h.Options = HEADER_OPTS
  if parent then h.appendToEntry(parent) end
  return h
end

local function findOrCreateTopRecord(desc, addr)
  local al = getAddressList()
  local mr = al.getMemoryRecordByDescription(desc)
  if mr then
    mr.Address = string.format("%X", addr)
    mr.ShowAsHex = true
    local g = 0
    while mr.Count &gt; 0 and g &lt; 5000 do
      g = g + 1
      memoryRecordDelete(mr.Child[0])
    end
    return mr
  end
  local r = al.createMemoryRecord()
  r.Description = desc
  r.Address = string.format("%X", addr)
  r.Type = vtQword
  r.ShowAsHex = true
  return r
end

local function ensureDebugBuildAutoAssemblerRecord()
  local al = getAddressList()
  local mr = al.getMemoryRecordByDescription(AA_DEBUG_BUILD_DESC)
  if not mr then
    mr = al.createMemoryRecord()
    mr.Description = AA_DEBUG_BUILD_DESC
    mr.Type = vtAutoAssembler
    mr.Script = AA_DEBUG_BUILD_SCRIPT
    mr.Active = false
    return mr
  end
  if mr.Type ~= vtAutoAssembler then
    mr.Type = vtAutoAssembler
  end
  if not mr.Active then
    mr.Script = AA_DEBUG_BUILD_SCRIPT
  end
  return mr
end

-- PD tree
local function readPlayerDataScalars(pdMembers, topRecord)
  local h = addHeader("player_data scalars (INT)", topRecord)
  addRecord("field_chars_unlocked",
    varDataAddr(pdMembers, PD_FIELD_CHARS_UNLOCK), vtDword, h)
  addRecord("field_char", varDataAddr(pdMembers, PD_FIELD_CHAR), vtDword, h)
  addRecord("clips (player_data.money)",
    varDataAddr(pdMembers, PD_MONEY_IDX), vtDword, h)

  local metalsElem = getPoolIntArrayElemPtr(
    pdMembers, PD_METALS_IDX, "metals")
  if metalsElem then
    addRecord("metals[0] copper (MP)", metalsElem + 0, vtDword, h)
    addRecord("metals[1] steel", metalsElem + 4, vtDword, h)
    addRecord("metals[2] platinum", metalsElem + 8, vtDword, h)
  end

  addRecord("_playtime_frame_offset",
    varDataAddr(pdMembers, PD_PLAYTIME_FRAME_OFF), vtDword, h)
  addRecord("playtime_seconds",
    varDataAddr(pdMembers, PD_PLAYTIME_SEC), vtDword, h)
  addRecord("playtime_hours",
    varDataAddr(pdMembers, PD_PLAYTIME_HOURS), vtDword, h)
  addRecord("_non_menu_playtime_frame_off",
    varDataAddr(pdMembers, PD_NM_PT_FRAME_OFF), vtDword, h)
  addRecord("non_menu_playtime_seconds",
    varDataAddr(pdMembers, PD_NM_PT_SEC), vtDword, h)
  addRecord("non_menu_playtime_hours",
    varDataAddr(pdMembers, PD_NM_PT_HOURS), vtDword, h)
end

local function addCharacterBattleAndEquipment(pdMembers, topRecord, charIdx)
  local cm = getCharMembers(pdMembers, charIdx)
  local nm = CHAR_DISPLAY_NAME[charIdx] or "?"
  local tag = string.format("[%d] ", charIdx)
  if not cm then
    addHeader(tag .. nm .. " — missing", topRecord)
    return
  end
  local ch = addHeader(tag .. nm, topRecord)

  addRecord(
    "char_idx (should equal " .. charIdx .. ")",
    varDataAddr(cm, PC_CHAR_IDX),
    vtDword,
    ch
  )
  addRecord("HP", varDataAddr(cm, PC_HP_IDX), vtDword, ch)
  local maxHpMT = getChildMembers(cm, PC_MAX_HP_IDX)
  if maxHpMT then
    addRecord("Max HP (base)", varDataAddr(maxHpMT, MT_BASE_IDX), vtDword, ch)
  end
  addRecord("BP", varDataAddr(cm, PC_BP_IDX), vtDword, ch)
  addRecord("Invincible", varDataAddr(cm, PC_INVINCIBLE_IDX), vtDword, ch)
  addRecord("Level", varDataAddr(cm, PC_LEVEL_IDX), vtDword, ch)
  addRecord("Experience", varDataAddr(cm, PC_EXPERIENCE_IDX), vtDword, ch)

  local statDefs = {
    { "Attack (base)", PC_ATTACK_IDX },
    { "Defense (base)", PC_DEFENSE_IDX },
    { "Magic (base)", PC_MAGIC_IDX },
    { "Agility (base)", PC_AGILITY_IDX },
    { "Luck (base)", PC_LUCK_IDX },
    { "Honor (base)", PC_HONOR_IDX },
  }
  for _, sd in ipairs(statDefs) do
    local label, idx = sd[1], sd[2]
    local mt = getChildMembers(cm, idx)
    if mt then
      addRecord(label, varDataAddr(mt, MT_BASE_IDX), vtDword, ch)
    end
  end
  addRecord("Unlocked Boilpoints",
    varDataAddr(cm, PC_UNL_BOILPTS_IDX), vtDword, ch)

  local equipVar = cm + PC_EQUIPMENT_IDX * VARIANT_SIZE
  local eqt = readInteger(equipVar + VARIANT_TYPE_OFF) or 0
  if eqt ~= VTYPE_ARRAY then
    addHeader("equipped — members[22] not ARRAY", ch)
    return
  end
  local eqH = addHeader("equipped (members[22] → EquipmentPiece)", ch)
  local arrPriv = readQword(equipVar + VARIANT_DATA_OFF)
  if not isPtr(arrPriv) then return end
  local elemPtr = readQword(arrPriv + 0x08)
  if not isPtr(elemPtr) then return end

  for slot = 0, 4 do
    local slotVar = elemPtr + slot * VARIANT_SIZE
    local st = readInteger(slotVar + VARIANT_TYPE_OFF) or 0
    local slotLabel = WEAR_SLOT_LABELS[slot + 1] or ("slot" .. slot)
    if st == VTYPE_NIL then
      addHeader(slotLabel .. " (empty)", eqH)
    elseif st == VTYPE_OBJECT then
      local sh = addHeader(slotLabel, eqH)
      local objPtr = readQword(slotVar + VARIANT_DATA_OFF)
      local eqSI = isPtr(objPtr) and readQword(objPtr + NODE_SCRIPT_INST)
      local eqMems = isPtr(eqSI) and readQword(eqSI + GDI_MEMBERS_PTR)
      if isPtr(eqMems) then
        local dType = "EquipmentPiece.type_id (0=wpn,1=head,2=arm,3=trnk)"
        local dItem = "EquipmentPiece.item_id (swap)"
        addRecord(dType, varDataAddr(eqMems, EQ_TYPE_ID_IDX), vtDword, sh)
        addRecord(dItem, varDataAddr(eqMems, EQ_ITEM_ID_IDX), vtDword, sh)
        addRecord("EquipmentPiece.wielder (char_idx)",
          varDataAddr(eqMems, EQ_WIELDER_IDX), vtDword, sh)
        addRecord("EquipmentPiece.slot",
          varDataAddr(eqMems, EQ_SLOT_IDX), vtDword, sh)
      else
        addHeader(slotLabel .. " — bad EquipmentPiece GDI", eqH)
      end
    else
      addHeader(slotLabel .. " — unexpected VTYPE " .. st, eqH)
    end
  end
end

local function run_main_layout()
  kotd_print("=== KOTD.lua — Player Data ===")

  local pd, err = getPlayerDataMembers()
  if not pd then
    kotd_error("ERROR: " .. err)
    return false
  end
  kotd_print(string.format(
    "player_data @ 0x%X  GDInstance @ 0x%X  members @ 0x%X",
    pd.nodePtr, pd.scriptInst, pd.membersPtr))

  local topRecord = findOrCreateTopRecord(TOP_RECORD_DESC, pd.nodePtr)

  readPlayerDataScalars(pd.membersPtr, topRecord)
  for charIdx = 1, 7 do
    addCharacterBattleAndEquipment(pd.membersPtr, topRecord, charIdx)
  end

  kotd_print("KOTD.lua: Player Data tree done.")
  return true
end

function KOTD_refresh_all()
  local ok = run_main_layout()
  ensureDebugBuildAutoAssemblerRecord()
  return ok
end

KOTD_refresh_all()
</LuaScript>
</CheatTable>
