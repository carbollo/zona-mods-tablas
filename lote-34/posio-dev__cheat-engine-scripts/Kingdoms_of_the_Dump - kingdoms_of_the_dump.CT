    <CheatEntry>
      <ID>602</ID>
      <Description>"[KOTD] OS.is_debug_build (A870)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

kingdoms_of_the_dump.exe+A870:
  db B0 01 C3

[DISABLE]

kingdoms_of_the_dump.exe+A870:
  db 32 C0 C3
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
  <LuaScript>--[[
-- Kingdoms of the Dump
-- Steam AppID: 2159270
-- Build ID: 21594250
--
-- Tested: Proton Experimental, 2026-04-03
--
-- Load into a game before loading the table.
-- Change "base" stats then save and load the save to modify stats
-- Debug AA is not intended for gameplay use, deactivate as necessary
-- Press the "`" [backtick] key to open dev console after activating AA script
--
-- This script debugger: turn KOTD_PRINT to true to see verbose output
--]]
local KOTD_PRINT = false

local function kotd_verbose()
  local g = rawget(_G, "KOTD_PRINT")
  if g ~= nil then
    return g and true or false
  end
  return KOTD_PRINT
end

local function kotd_print(...)
  if kotd_verbose() then
    print(...)
  end
end

local function kotd_error(...)
  print(...)
end

-- shit from ghidra
local MODULE = "kingdoms_of_the_dump.exe"
local OS_SINGLETON_RVA = 0x106cfe0
